@prefix verba: <http://w3id.org/airiskkg/example/verba-goldenverba#> .
@prefix beam:  <http://w3id.org/beam/core#> .
@prefix pair:    <http://w3id.org/airiskkg/pair-ai#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix vann:  <http://purl.org/vocab/vann/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

<http://w3id.org/airiskkg/example/verba-goldenverba#> a owl:Ontology ;
    dct:title "Verba Goldenverba RAG Application Use Case"@en ;
    dct:description "Architecture graph for the goldenverba package in Weaviate Verba, modeled as a public document Q&A RAG workflow with ingestion, chunking, embedding, Weaviate retrieval, prompt construction, and answer generation."@en ;
    dct:source <https://github.com/weaviate/Verba/tree/main/goldenverba> ;
    dct:source <https://github.com/weaviate/Verba/blob/main/README.md> ;
    dct:source <https://github.com/weaviate/Verba/blob/main/goldenverba/verba_manager.py> ;
    dct:source <https://github.com/weaviate/Verba/blob/main/goldenverba/components/retriever/WindowRetriever.py> ;
    vann:preferredNamespacePrefix "verba" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/example/verba-goldenverba#" ;
    owl:imports <http://w3id.org/beam/core#> ,
        <http://w3id.org/airiskkg/pair-ai#> .

verba:UploadedKnowledgeBaseContent
    a pair:DataCategory ;
    rdfs:label "Uploaded knowledge base content"@en ;
    pair:subDataCategoryOf pair:Information .

verba:UploadedSensitiveKnowledgeBaseContent
    a pair:DataCategory ;
    rdfs:label "Uploaded sensitive knowledge base content"@en ;
    pair:subDataCategoryOf verba:UploadedKnowledgeBaseContent ;
    pair:subDataCategoryOf pair:SensitiveInformation .

verba:ProviderCredential
    a pair:DataCategory ;
    rdfs:label "Provider credential"@en ;
    pair:subDataCategoryOf pair:ConfidentialInformation .

verba:VerbaSystem
    a beam:System ;
    rdfs:label "Verba goldenverba public RAG chatbot"@en ;
    beam:context "Open-source RAG application that ingests user supplied documents, stores chunks and vectors in Weaviate, retrieves relevant context for a public user query, and generates an answer with a selected LLM provider."@en ;
    beam:hasResource
        verba:UploadedDocument ,
        verba:ParsedDocument ,
        verba:DocumentChunks ,
        verba:ChunkEmbeddings ,
        verba:WeaviateVectorStore ,
        verba:RAGConfiguration ,
        verba:ProviderCredentials ,
        verba:PublicQuestion ,
        verba:EmbeddedQuestion ,
        verba:RetrievedChunks ,
        verba:RAGPrompt ,
        verba:GeneratorModel ,
        verba:Answer ;
    beam:hasProcess
        verba:ReadDocument ,
        verba:ChunkDocument ,
        verba:EmbedChunks ,
        verba:IndexChunksInWeaviate ,
        verba:EmbedQuestion ,
        verba:RetrieveRelevantChunks ,
        verba:BuildRAGPrompt ,
        verba:GenerateAnswer .

verba:UploadedDocument
    a beam:Data ;
    rdfs:label "Uploaded document"@en ;
    pair:containsDataCategory verba:UploadedKnowledgeBaseContent ;
    pair:containsDataCategory verba:UploadedSensitiveKnowledgeBaseContent ;
    pair:containsDataCategory pair:UntrustedContent ;
    beam:usedBy verba:ReadDocument .

verba:ParsedDocument
    a beam:Data ;
    rdfs:label "Parsed document"@en ;
    pair:containsDataCategory verba:UploadedKnowledgeBaseContent ;
    pair:containsDataCategory verba:UploadedSensitiveKnowledgeBaseContent ;
    pair:containsDataCategory pair:UntrustedContent ;
    beam:usedBy verba:ChunkDocument .

verba:DocumentChunks
    a beam:Data ;
    rdfs:label "Document chunks"@en ;
    pair:containsDataCategory verba:UploadedKnowledgeBaseContent ;
    pair:containsDataCategory verba:UploadedSensitiveKnowledgeBaseContent ;
    pair:containsDataCategory pair:UntrustedContent ;
    beam:usedBy verba:EmbedChunks ,
        verba:IndexChunksInWeaviate .

verba:ChunkEmbeddings
    a beam:Data ;
    rdfs:label "Chunk embeddings"@en ;
    pair:containsDataCategory verba:UploadedKnowledgeBaseContent ;
    beam:usedBy verba:IndexChunksInWeaviate .

verba:WeaviateVectorStore
    a beam:Data ;
    rdfs:label "Weaviate document and chunk vector store"@en ;
    pair:playsRole pair:VectorStore ;
    pair:containsDataCategory verba:UploadedKnowledgeBaseContent ;
    pair:containsDataCategory verba:UploadedSensitiveKnowledgeBaseContent ;
    pair:containsDataCategory pair:UntrustedContent ;
    beam:usedBy verba:RetrieveRelevantChunks .

verba:RAGConfiguration
    a beam:Data ;
    rdfs:label "RAG configuration"@en ;
    pair:containsDataCategory pair:PromptInstruction ;
    beam:usedBy verba:ReadDocument ,
        verba:ChunkDocument ,
        verba:EmbedChunks ,
        verba:EmbedQuestion ,
        verba:RetrieveRelevantChunks ,
        verba:BuildRAGPrompt ,
        verba:GenerateAnswer .

verba:ProviderCredentials
    a beam:Data ;
    rdfs:label "Provider API credentials"@en ;
    pair:playsRole pair:ExternalProviderCredential ;
    pair:containsDataCategory verba:ProviderCredential ;
    beam:usedBy verba:EmbedChunks ,
        verba:EmbedQuestion ,
        verba:GenerateAnswer .

verba:PublicQuestion
    a beam:Data ;
    rdfs:label "Public chat question"@en ;
    pair:playsRole pair:PublicUserInput ;
    pair:containsDataCategory pair:ExternalUserContent ;
    beam:usedBy verba:EmbedQuestion ,
        verba:BuildRAGPrompt ,
        verba:GenerateAnswer .

verba:EmbeddedQuestion
    a beam:Data ;
    rdfs:label "Embedded chat question"@en ;
    pair:playsRole pair:PublicUserInput ;
    pair:containsDataCategory pair:ExternalUserContent ;
    beam:usedBy verba:RetrieveRelevantChunks .

verba:RetrievedChunks
    a beam:Data ;
    rdfs:label "Retrieved context chunks"@en ;
    pair:playsRole pair:RetrievedContext ;
    pair:containsDataCategory verba:UploadedKnowledgeBaseContent ;
    pair:containsDataCategory verba:UploadedSensitiveKnowledgeBaseContent ;
    pair:containsDataCategory pair:UntrustedContent ;
    beam:usedBy verba:BuildRAGPrompt ,
        verba:GenerateAnswer .

verba:RAGPrompt
    a beam:Data ;
    rdfs:label "RAG prompt with retrieved context"@en ;
    pair:playsRole pair:PromptTemplate ;
    pair:containsDataCategory pair:PromptInstruction ;
    pair:containsDataCategory pair:ExternalUserContent ;
    pair:containsDataCategory verba:UploadedKnowledgeBaseContent ;
    pair:containsDataCategory verba:UploadedSensitiveKnowledgeBaseContent ;
    pair:containsDataCategory pair:UntrustedContent ;
    beam:usedBy verba:GenerateAnswer .

verba:GeneratorModel
    a beam:StatisticalModel ;
    rdfs:label "Selected generator model"@en ;
    pair:playsRole pair:GenerativeModel ;
    pair:playsRole pair:ExternalModel ;
    pair:playsRole pair:PretrainedModel ;
    beam:usedBy verba:GenerateAnswer .

verba:Answer
    a beam:Data ;
    rdfs:label "Generated chat answer"@en ;
    pair:playsRole pair:PublicUserFacingOutput ;
    pair:containsDataCategory pair:GeneratedContent ;
    pair:containsDataCategory verba:UploadedKnowledgeBaseContent .

verba:ReadDocument
    a beam:Transform ;
    rdfs:label "Read uploaded document"@en ;
    beam:use verba:UploadedDocument ,
        verba:RAGConfiguration ;
    beam:produce verba:ParsedDocument ;
    beam:inform verba:ChunkDocument .

verba:ChunkDocument
    a beam:Transform ;
    rdfs:label "Chunk document"@en ;
    beam:use verba:ParsedDocument ,
        verba:RAGConfiguration ;
    beam:produce verba:DocumentChunks ;
    beam:inform verba:EmbedChunks .

verba:EmbedChunks
    a beam:Transform ;
    rdfs:label "Embed document chunks"@en ;
    pair:playsRole pair:EmbeddingStep ;
    beam:use verba:DocumentChunks ,
        verba:RAGConfiguration ,
        verba:ProviderCredentials ;
    beam:produce verba:ChunkEmbeddings ;
    beam:inform verba:IndexChunksInWeaviate .

verba:IndexChunksInWeaviate
    a beam:Transform ;
    rdfs:label "Index chunks in Weaviate"@en ;
    beam:use verba:DocumentChunks ,
        verba:ChunkEmbeddings ;
    beam:produce verba:WeaviateVectorStore .

verba:EmbedQuestion
    a beam:Transform ;
    rdfs:label "Embed chat question"@en ;
    pair:playsRole pair:EmbeddingStep ;
    beam:use verba:PublicQuestion ,
        verba:RAGConfiguration ,
        verba:ProviderCredentials ;
    beam:produce verba:EmbeddedQuestion ;
    beam:inform verba:RetrieveRelevantChunks .

verba:RetrieveRelevantChunks
    a beam:Infer ;
    rdfs:label "Retrieve relevant chunks from Weaviate"@en ;
    pair:playsRole pair:RetrievalStep ;
    beam:use verba:EmbeddedQuestion ,
        verba:WeaviateVectorStore ,
        verba:RAGConfiguration ;
    beam:produce verba:RetrievedChunks ;
    beam:inform verba:BuildRAGPrompt .

verba:BuildRAGPrompt
    a beam:Transform ;
    rdfs:label "Build RAG prompt"@en ;
    pair:playsRole pair:PromptConstructionStep ;
    beam:use verba:PublicQuestion ,
        verba:RetrievedChunks ,
        verba:RAGConfiguration ;
    beam:produce verba:RAGPrompt ;
    beam:inform verba:GenerateAnswer .

verba:GenerateAnswer
    a beam:Transform ;
    rdfs:label "Generate grounded answer"@en ;
    pair:playsRole pair:GenerationStep ;
    beam:use verba:PublicQuestion ,
        verba:RetrievedChunks ,
        verba:RAGPrompt ,
        verba:GeneratorModel ,
        verba:RAGConfiguration ,
        verba:ProviderCredentials ;
    beam:produce verba:Answer .
