@prefix pat:   <http://w3id.org/airiskkg/patterns#> .
@prefix pair:    <http://w3id.org/airiskkg/pair-ai#> .
@prefix beam:  <http://w3id.org/beam/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/airiskkg/patterns/motif-library#>
    a owl:Ontology ;
    dct:title "Architecuture Motif's Library"@en ;
    dct:description """
    Reusable architecture motifs for PAIR-AI assessment.
    """@en ;
    dct:source
        <https://mercari.github.io/ml-system-design-pattern/> ,
        <https://martinfowler.com/articles/gen-ai-patterns/> ;
    owl:imports <http://w3id.org/beam/core#> ,
                <http://w3id.org/airiskkg/pair-ai#> .


