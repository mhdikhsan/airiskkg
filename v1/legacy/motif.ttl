        pat:BatchTrain_ModelArtifactNode ,
        pat:BatchTrain_EvaluationStepNode ,
        pat:BatchTrain_EvaluationResultNode ;
    pair:hasPatternEdge
        pat:BatchTrain_SchedulerInformsPreprocessEdge ,
        pat:BatchTrain_PreprocessUsesDatasetEdge ,
        pat:BatchTrain_PreprocessProducesTrainingDataEdge ,
        pat:BatchTrain_PreprocessInformsTrainingEdge ,
        pat:BatchTrain_TrainingUsesDataEdge ,
        pat:BatchTrain_TrainingProducesModelEdge ,
        pat:BatchTrain_TrainingInformsEvaluationEdge ,
        pat:BatchTrain_EvaluationUsesModelEdge ,
        pat:BatchTrain_EvaluationProducesResultEdge .

