pat:TrainServe_TrainingInformsEvaluationEdge
    a pair:PatternEdge ;
    rdfs:label "training informs evaluation"@en ;
    pair:sourcePatternNode pat:TrainServe_TrainingStepNode ;
    pair:patternPredicate beam:inform ;
    pair:targetPatternNode pat:TrainServe_EvaluationStepNode .

pat:TrainServe_EvaluationUsesCandidateEdge
    a pair:PatternEdge ;
    rdfs:label "evaluation uses candidate model"@en ;
    pair:sourcePatternNode pat:TrainServe_EvaluationStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:TrainServe_CandidateModelNode .

pat:TrainServe_EvaluationProducesApprovalEdge
    a pair:PatternEdge ;
    rdfs:label "evaluation produces release approval"@en ;
    pair:sourcePatternNode pat:TrainServe_EvaluationStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:TrainServe_ApprovalNode .

pat:TrainServe_ReleaseUsesApprovalEdge
    a pair:PatternEdge ;
    rdfs:label "release uses approval"@en ;
