pat:FineTuningMotif
    a pair:GraphMotif ;
    rdfs:label "Fine Tuning Motif"@en ;
    dct:description "GenAI motif in which a pre-trained LLM is further trained with a task- or domain-specific dataset to produce a fine-tuned model."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternNode
        pat:FineTune_BaseModelNode ,
        pat:FineTune_DatasetNode ,
