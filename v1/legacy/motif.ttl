#Embedding Motif
pat:EmbeddingMotif a pair:GraphMotif ;
    rdfs:label "Embedding Motif"@en ;
    dct:description """
    Architectural motif in which an embedding step produces vector embeddings from an input query, often for use in retrieval or similarity search.
    """@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternNode
        pat:Embedding_SourceNode ,
        pat:Embedding_ModelNode ,
        pat:Embedding_StepNode ,
        pat:Embedding_VectorNode ;
    pair:hasPatternEdge
        pat:Embedding_UsesSourceEdge ,
        pat:Embedding_UsesModelEdge ,
        pat:Embedding_ProducesVectorEdge ;
    pair:implementedBy pat:Embedding_MatchingOQP .

pat:Embedding_SourceNode
    a pair:PatternNode ;
    rdfs:label "Embedding source node"@en ;
    rdfs:comment "Text/image/data block to be embedded."@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:Embedding_ModelNode
    a pair:PatternNode ;
    rdfs:label "Embedding model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:EmbeddingModel .

pat:Embedding_StepNode
    a pair:PatternNode ;
    rdfs:label "Embedding step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:EmbeddingStep .

pat:Embedding_VectorNode
    a pair:PatternNode ;
    rdfs:label "Embedding vector node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:VectorRepresentation .

pat:Embedding_UsesSourceEdge
    a pair:PatternEdge ;
    rdfs:label "embedding uses source"@en ;
    pair:sourcePatternNode pat:Embedding_StepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Embedding_SourceNode .

pat:Embedding_UsesModelEdge
    a pair:PatternEdge ;
    rdfs:label "embedding uses model"@en ;
    pair:sourcePatternNode pat:Embedding_StepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Embedding_ModelNode .

pat:Embedding_ProducesVectorEdge
    a pair:PatternEdge ;
    rdfs:label "embedding produces vector"@en ;
    pair:sourcePatternNode pat:Embedding_StepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:Embedding_VectorNode .

#EvalsMotif

pat:EvalsMotif a pair:GraphMotif ;
    rdfs:label "Evals Motif"@en ;
    dct:description """
    Architectural motif in which an evaluation step produces an evaluation result from a model and evaluation dataset, often for use in model validation or monitoring.
    """@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternNode
        pat:Evals_ModelOutputNode ,
        pat:Evals_ExpectedOutputNode ,
        pat:Evals_ScorerStepNode ,
        pat:Evals_JudgeModelNode ,
        pat:Evals_ScoreNode ;
    pair:hasPatternEdge
        pat:Evals_ModelOutputEdge ,
        pat:Evals_ExpectedOutputEdge ,
        pat:Evals_ScoresEdge ,
        pat:Evals_JudgeModelEdge ;
    pair:implementedBy pat:Evals_MatchingOQP .

pat:Evals_ModelOutputNode
    a pair:PatternNode ;
    rdfs:label "Model output node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:EvaluatedOutputRole .

pat:Evals_ExpectedOutputNode
    a pair:PatternNode ;
    rdfs:label "Expected output node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:ExpectedOutputRole .

pat:Evals_ScorerStepNode
    a pair:PatternNode ;
    rdfs:label "Scorer step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:ScoringStepRole .

pat:Evals_JudgeModelNode
    a pair:PatternNode ;
    rdfs:label "Judge model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:JudgeModelRole .

pat:Evals_ScoreNode
    a pair:PatternNode ;
    rdfs:label "Score node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:EvaluationResultRole .

pat:Evals_ModelOutputEdge
    a pair:PatternEdge ;
    rdfs:label "model output edge"@en ;
    pair:sourcePatternNode pat:Evals_ScorerStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Evals_ModelOutputNode .

pat:Evals_ExpectedOutputEdge
    a pair:PatternEdge ;
    rdfs:label "expected output edge"@en ;
    pair:sourcePatternNode pat:Evals_ScorerStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Evals_ExpectedOutputNode .

pat:Evals_ScoresEdge
    a pair:PatternEdge ;
    rdfs:label "scores edge"@en ;
    pair:sourcePatternNode pat:Evals_ScorerStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:Evals_ScoreNode .

pat:Evals_JudgeModelEdge
    a pair:PatternEdge ;
    rdfs:label "judge model edge"@en ;
    pair:sourcePatternNode pat:Evals_ScorerStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Evals_JudgeModelNode .



# Role vocabulary for ML system design motifs

pat:PredictionRequestRole
    a pair:PatternRole ;
    skos:prefLabel "Prediction Request"@en .

pat:PredictionResultRole
    a pair:PatternRole ;
    skos:prefLabel "Prediction Result"@en .

pat:PredictionStepRole
    a pair:PatternRole ;
    skos:prefLabel "Prediction Step"@en .

pat:PredictionQueueRole
    a pair:PatternRole ;
    skos:prefLabel "Prediction Queue"@en .

pat:BatchDatasetRole
    a pair:PatternRole ;
    skos:prefLabel "Batch Dataset"@en .

pat:JobSchedulerRole
    a pair:PatternRole ;
    skos:prefLabel "Job Scheduler"@en .

pat:PreprocessingStepRole
    a pair:PatternRole ;
    skos:prefLabel "Preprocessing Step"@en .

pat:PreprocessedDataRole
    a pair:PatternRole ;
    skos:prefLabel "Preprocessed Data"@en .

pat:FastPredictionStepRole
    a pair:PatternRole ;
    skos:prefLabel "Fast Prediction Step"@en ;
    pair:subRoleOf pat:PredictionStepRole .

pat:SlowPredictionStepRole
    a pair:PatternRole ;
    skos:prefLabel "Slow Prediction Step"@en ;
    pair:subRoleOf pat:PredictionStepRole .

pat:TrainingDatasetRole
    a pair:PatternRole ;
    skos:prefLabel "Training Dataset"@en .

pat:TrainingStepRole
    a pair:PatternRole ;
    skos:prefLabel "Training Step"@en .

pat:TrainingPipelineRole
    a pair:PatternRole ;
    skos:prefLabel "Training Pipeline"@en .

pat:EvaluationStepRole
    a pair:PatternRole ;
    skos:prefLabel "Evaluation Step"@en .

pat:EvaluationResultRole
    a pair:PatternRole ;
    skos:prefLabel "Evaluation Result"@en .

pat:ModelArtifactRole
    a pair:PatternRole ;
    skos:prefLabel "Model Artifact"@en ;
    pair:subRoleOf pair:Model .

pat:ModelRegistryRole
    a pair:PatternRole ;
    skos:prefLabel "Model Registry"@en .

pat:ReleaseApprovalRole
    a pair:PatternRole ;
    skos:prefLabel "Release Approval"@en .

pat:DeploymentStepRole
    a pair:PatternRole ;
    skos:prefLabel "Deployment Step"@en .

pat:ServingImageRole
    a pair:PatternRole ;
    skos:prefLabel "Serving Image"@en .

pat:PredictionLogRole
    a pair:PatternRole ;
    skos:prefLabel "Prediction Log"@en .

pat:LoggingStepRole
    a pair:PatternRole ;
    skos:prefLabel "Logging Step"@en .

pat:MonitoringStepRole
    a pair:PatternRole ;
    skos:prefLabel "Monitoring Step"@en .

pat:MonitoringBaselineRole
    a pair:PatternRole ;
    skos:prefLabel "Monitoring Baseline"@en .

pat:AlertRole
    a pair:PatternRole ;
    skos:prefLabel "Alert"@en .

pat:ModelLoadStepRole
    a pair:PatternRole ;
    skos:prefLabel "Model Load Step"@en .

pat:LoadedModelRole
    a pair:PatternRole ;
    skos:prefLabel "Loaded Model"@en ;
    pair:subRoleOf pair:Model .

pat:ImageBuildStepRole
    a pair:PatternRole ;
    skos:prefLabel "Image Build Step"@en .


# ML system design motifs: serving patterns
#
pat:SynchronousPredictionMotif
    a pair:GraphMotif ;
    rdfs:label "Synchronous Prediction Motif"@en ;
    dct:description "Architectural motif in which a prediction step runs inline with a request workflow and produces a result before the workflow proceeds."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Synchronous-pattern/design_en.html> ;
    pair:hasPatternNode
        pat:SyncPred_RequestNode ,
        pat:SyncPred_ModelNode ,
        pat:SyncPred_PredictionStepNode ,
        pat:SyncPred_ResultNode ,
        pat:SyncPred_DownstreamStepNode ;
    pair:hasPatternEdge
        pat:SyncPred_PredictionUsesRequestEdge ,
        pat:SyncPred_PredictionUsesModelEdge ,
        pat:SyncPred_PredictionProducesResultEdge ,
        pat:SyncPred_PredictionInformsDownstreamEdge .

pat:SyncPred_RequestNode
    a pair:PatternNode ;
    rdfs:label "Synchronous prediction request node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PredictionRequestRole .

pat:SyncPred_ModelNode
    a pair:PatternNode ;
    rdfs:label "Synchronous prediction model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:Model .

pat:SyncPred_PredictionStepNode
    a pair:PatternNode ;
    rdfs:label "Synchronous prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pat:PredictionStepRole .

pat:SyncPred_ResultNode
    a pair:PatternNode ;
    rdfs:label "Synchronous prediction result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PredictionResultRole .

pat:SyncPred_DownstreamStepNode
    a pair:PatternNode ;
    rdfs:label "Downstream workflow step node"@en ;
    pair:expectedClass beam:Process .

pat:SyncPred_PredictionUsesRequestEdge
    a pair:PatternEdge ;
    rdfs:label "synchronous prediction uses request"@en ;
    pair:sourcePatternNode pat:SyncPred_PredictionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:SyncPred_RequestNode .

pat:SyncPred_PredictionUsesModelEdge
    a pair:PatternEdge ;
    rdfs:label "synchronous prediction uses model"@en ;
    pair:sourcePatternNode pat:SyncPred_PredictionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:SyncPred_ModelNode .

pat:SyncPred_PredictionProducesResultEdge
    a pair:PatternEdge ;
    rdfs:label "synchronous prediction produces result"@en ;
    pair:sourcePatternNode pat:SyncPred_PredictionStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:SyncPred_ResultNode .

pat:SyncPred_PredictionInformsDownstreamEdge
    a pair:PatternEdge ;
    rdfs:label "synchronous prediction informs downstream step"@en ;
    pair:sourcePatternNode pat:SyncPred_PredictionStepNode ;
    pair:patternPredicate beam:inform ;
    pair:targetPatternNode pat:SyncPred_DownstreamStepNode .

pat:AsynchronousPredictionMotif
    a pair:GraphMotif ;
    rdfs:label "Asynchronous Prediction Motif"@en ;
    dct:description "Architectural motif in which prediction requests are decoupled from prediction execution through a queue, cache, or similar intermediary resource."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Asynchronous-pattern/design_en.html> ;
    pair:hasPatternNode
        pat:AsyncPred_RequestNode ,
        pat:AsyncPred_EnqueueStepNode ,
        pat:AsyncPred_QueueNode ,
        pat:AsyncPred_PredictionStepNode ,
        pat:AsyncPred_ResultNode ;
    pair:hasPatternEdge
        pat:AsyncPred_EnqueueUsesRequestEdge ,
        pat:AsyncPred_EnqueueProducesQueueEdge ,
        pat:AsyncPred_PredictionUsesQueueEdge ,
        pat:AsyncPred_PredictionProducesResultEdge .

pat:AsyncPred_RequestNode
    a pair:PatternNode ;
    rdfs:label "Asynchronous prediction request node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PredictionRequestRole .

pat:AsyncPred_EnqueueStepNode
    a pair:PatternNode ;
    rdfs:label "Prediction request enqueue step node"@en ;
    pair:expectedClass beam:Process .

pat:AsyncPred_QueueNode
    a pair:PatternNode ;
    rdfs:label "Prediction queue node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PredictionQueueRole .

pat:AsyncPred_PredictionStepNode
    a pair:PatternNode ;
    rdfs:label "Asynchronous prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pat:PredictionStepRole .

pat:AsyncPred_ResultNode
    a pair:PatternNode ;
    rdfs:label "Asynchronous prediction result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PredictionResultRole .

pat:AsyncPred_EnqueueUsesRequestEdge
    a pair:PatternEdge ;
    rdfs:label "enqueue step uses prediction request"@en ;
    pair:sourcePatternNode pat:AsyncPred_EnqueueStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:AsyncPred_RequestNode .

pat:AsyncPred_EnqueueProducesQueueEdge
    a pair:PatternEdge ;
    rdfs:label "enqueue step produces queued prediction request"@en ;
    pair:sourcePatternNode pat:AsyncPred_EnqueueStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:AsyncPred_QueueNode .

pat:AsyncPred_PredictionUsesQueueEdge
    a pair:PatternEdge ;
    rdfs:label "asynchronous prediction uses queue"@en ;
    pair:sourcePatternNode pat:AsyncPred_PredictionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:AsyncPred_QueueNode .

pat:AsyncPred_PredictionProducesResultEdge
    a pair:PatternEdge ;
    rdfs:label "asynchronous prediction produces result"@en ;
    pair:sourcePatternNode pat:AsyncPred_PredictionStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:AsyncPred_ResultNode .

pat:BatchPredictionMotif
    a pair:GraphMotif ;
    rdfs:label "Batch Prediction Motif"@en ;
    dct:description "Architectural motif in which a scheduled job runs prediction over a batch dataset and stores batch prediction results."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Batch-pattern/design_en.html> ;
    pair:hasPatternNode
        pat:BatchPred_SchedulerNode ,
        pat:BatchPred_DatasetNode ,
        pat:BatchPred_ModelNode ,
        pat:BatchPred_JobNode ,
        pat:BatchPred_ResultNode ;
    pair:hasPatternEdge
        pat:BatchPred_SchedulerInformsJobEdge ,
        pat:BatchPred_JobUsesDatasetEdge ,
        pat:BatchPred_JobUsesModelEdge ,
        pat:BatchPred_JobProducesResultEdge .

pat:BatchPred_SchedulerNode
    a pair:PatternNode ;
    rdfs:label "Batch prediction scheduler node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pat:JobSchedulerRole .

pat:BatchPred_DatasetNode
    a pair:PatternNode ;
    rdfs:label "Batch prediction dataset node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:BatchDatasetRole .

pat:BatchPred_ModelNode
    a pair:PatternNode ;
    rdfs:label "Batch prediction model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:Model .

pat:BatchPred_JobNode
    a pair:PatternNode ;
    rdfs:label "Batch prediction job node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pat:PredictionStepRole .

pat:BatchPred_ResultNode
    a pair:PatternNode ;
    rdfs:label "Batch prediction result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PredictionResultRole .

pat:BatchPred_SchedulerInformsJobEdge
    a pair:PatternEdge ;
    rdfs:label "batch scheduler informs prediction job"@en ;
    pair:sourcePatternNode pat:BatchPred_SchedulerNode ;
    pair:patternPredicate beam:inform ;
    pair:targetPatternNode pat:BatchPred_JobNode .

pat:BatchPred_JobUsesDatasetEdge
    a pair:PatternEdge ;
    rdfs:label "batch prediction job uses dataset"@en ;
    pair:sourcePatternNode pat:BatchPred_JobNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:BatchPred_DatasetNode .

pat:BatchPred_JobUsesModelEdge
    a pair:PatternEdge ;
    rdfs:label "batch prediction job uses model"@en ;
    pair:sourcePatternNode pat:BatchPred_JobNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:BatchPred_ModelNode .

pat:BatchPred_JobProducesResultEdge
    a pair:PatternEdge ;
    rdfs:label "batch prediction job produces result"@en ;
    pair:sourcePatternNode pat:BatchPred_JobNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:BatchPred_ResultNode .

pat:PreprocessPredictionMotif
    a pair:GraphMotif ;
    rdfs:label "Prep-Pred / Preprocess-Prediction Motif"@en ;
    dct:description "Architectural motif in which preprocessing and prediction are represented as separate steps connected by preprocessed data."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Prep-pred-pattern/design_en.html> ;
    pair:hasPatternNode
        pat:PrepPred_InputNode ,
        pat:PrepPred_PreprocessStepNode ,
        pat:PrepPred_PreprocessedDataNode ,
        pat:PrepPred_ModelNode ,
        pat:PrepPred_PredictionStepNode ,
        pat:PrepPred_ResultNode ;
    pair:hasPatternEdge
        pat:PrepPred_PreprocessUsesInputEdge ,
        pat:PrepPred_PreprocessProducesDataEdge ,
        pat:PrepPred_PreprocessInformsPredictionEdge ,
        pat:PrepPred_PredictionUsesDataEdge ,
        pat:PrepPred_PredictionUsesModelEdge ,
        pat:PrepPred_PredictionProducesResultEdge .

pat:PrepPred_InputNode
    a pair:PatternNode ;
    rdfs:label "Raw prediction input node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PredictionRequestRole .

pat:PrepPred_PreprocessStepNode
    a pair:PatternNode ;
    rdfs:label "Preprocessing step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pat:PreprocessingStepRole .

pat:PrepPred_PreprocessedDataNode
    a pair:PatternNode ;
    rdfs:label "Preprocessed data node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PreprocessedDataRole .

pat:PrepPred_ModelNode
    a pair:PatternNode ;
    rdfs:label "Prep-pred model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:Model .

pat:PrepPred_PredictionStepNode
    a pair:PatternNode ;
    rdfs:label "Prep-pred prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pat:PredictionStepRole .

pat:PrepPred_ResultNode
    a pair:PatternNode ;
    rdfs:label "Prep-pred prediction result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PredictionResultRole .

pat:PrepPred_PreprocessUsesInputEdge
    a pair:PatternEdge ;
    rdfs:label "preprocess uses raw input"@en ;
    pair:sourcePatternNode pat:PrepPred_PreprocessStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:PrepPred_InputNode .

pat:PrepPred_PreprocessProducesDataEdge
    a pair:PatternEdge ;
    rdfs:label "preprocess produces preprocessed data"@en ;
    pair:sourcePatternNode pat:PrepPred_PreprocessStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:PrepPred_PreprocessedDataNode .

pat:PrepPred_PreprocessInformsPredictionEdge
    a pair:PatternEdge ;
    rdfs:label "preprocess informs prediction"@en ;
    pair:sourcePatternNode pat:PrepPred_PreprocessStepNode ;
    pair:patternPredicate beam:inform ;
    pair:targetPatternNode pat:PrepPred_PredictionStepNode .

pat:PrepPred_PredictionUsesDataEdge
    a pair:PatternEdge ;
    rdfs:label "prediction uses preprocessed data"@en ;
    pair:sourcePatternNode pat:PrepPred_PredictionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:PrepPred_PreprocessedDataNode .

pat:PrepPred_PredictionUsesModelEdge
    a pair:PatternEdge ;
    rdfs:label "prediction uses model"@en ;
    pair:sourcePatternNode pat:PrepPred_PredictionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:PrepPred_ModelNode .

pat:PrepPred_PredictionProducesResultEdge
    a pair:PatternEdge ;
    rdfs:label "prediction produces result"@en ;
    pair:sourcePatternNode pat:PrepPred_PredictionStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:PrepPred_ResultNode .

pat:MultiStagePredictionMotif
    a pair:GraphMotif ;
    rdfs:label "Multi-stage Prediction Motif"@en ;
    dct:description "Architectural motif in which one prediction path returns a quick result while another prediction path produces a slower or richer result."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Multiple-stage-prediction-pattern/design_en.html> ;
    pair:hasPatternNode
        pat:MultiStage_RequestNode ,
        pat:MultiStage_FastModelNode ,
        pat:MultiStage_FastPredictionStepNode ,
        pat:MultiStage_QuickResultNode ,
        pat:MultiStage_SlowModelNode ,
        pat:MultiStage_SlowPredictionStepNode ,
        pat:MultiStage_ImprovedResultNode ;
    pair:hasPatternEdge
        pat:MultiStage_FastUsesRequestEdge ,
        pat:MultiStage_FastUsesModelEdge ,
        pat:MultiStage_FastProducesResultEdge ,
        pat:MultiStage_FastInformsSlowEdge ,
        pat:MultiStage_SlowUsesRequestEdge ,
        pat:MultiStage_SlowUsesModelEdge ,
        pat:MultiStage_SlowProducesResultEdge .

pat:MultiStage_RequestNode
    a pair:PatternNode ;
    rdfs:label "Multi-stage prediction request node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PredictionRequestRole .

pat:MultiStage_FastModelNode
    a pair:PatternNode ;
    rdfs:label "Fast prediction model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:Model .

pat:MultiStage_FastPredictionStepNode
    a pair:PatternNode ;
    rdfs:label "Fast prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pat:FastPredictionStepRole .

pat:MultiStage_QuickResultNode
    a pair:PatternNode ;
    rdfs:label "Quick prediction result node"@en ;
    pair:expectedClass beam:Data ;
