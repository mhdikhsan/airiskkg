pat:QueryRewritingMotif
    a pair:GraphMotif ;
    rdfs:label "Query Rewriting Motif"@en ;
    dct:description "GenAI motif in which an LLM reformulates a user query into alternative queries that are then used for retrieval."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternNode
        pat:QueryRewrite_OriginalQueryNode ,
        pat:QueryRewrite_LLMNode ,
        pat:QueryRewrite_RewriteStepNode ,
        pat:QueryRewrite_RewrittenQueryNode ,
        pat:QueryRewrite_RetrievalStepNode ,
        pat:QueryRewrite_RetrievedContextNode ;
    pair:hasPatternEdge
        pat:QueryRewrite_RewriteUsesQueryEdge ,
        pat:QueryRewrite_RewriteUsesLLMEdge ,
        pat:QueryRewrite_RewriteProducesQueryEdge ,
        pat:QueryRewrite_RewriteInformsRetrievalEdge ,
        pat:QueryRewrite_RetrievalUsesRewrittenQueryEdge ,
        pat:QueryRewrite_RetrievalProducesContextEdge ;
    pair:implementedBy pat:QueryRewriting_MatchingOQP .

