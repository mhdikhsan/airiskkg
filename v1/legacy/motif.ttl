# Role vocabulary for GenAI product motifs

pat:FoundationLLMRole
    a pair:PatternRole ;
    skos:prefLabel "Foundation LLM"@en ;
    pair:subRoleOf pair:GenerativeModel .

pat:LLMResponseRole
    a pair:PatternRole ;
    skos:prefLabel "LLM Response"@en ;
    pair:subRoleOf pair:UserFacingOutput .

pat:EvalDatasetRole
    a pair:PatternRole ;
    skos:prefLabel "Evaluation Dataset"@en .

pat:ExpectedOutputRole
    a pair:PatternRole ;
    skos:prefLabel "Expected Output"@en .

pat:ScoringStepRole
    a pair:PatternRole ;
    skos:prefLabel "Scoring Step"@en .

pat:JudgeModelRole
    a pair:PatternRole ;
    skos:prefLabel "Judge Model"@en ;
    pair:subRoleOf pair:GenerativeModel .

pat:EvaluationScoreRole
    a pair:PatternRole ;
    skos:prefLabel "Evaluation Score"@en .

pat:SourceDocumentRole
    a pair:PatternRole ;
    skos:prefLabel "Source Document"@en ;
    pair:subRoleOf pair:KnowledgeSource .

pat:ChunkingStepRole
    a pair:PatternRole ;
    skos:prefLabel "Chunking Step"@en .

pat:DocumentChunkRole
    a pair:PatternRole ;
    skos:prefLabel "Document Chunk"@en ;
    pair:subRoleOf pair:KnowledgeSource .

pat:EmbeddingModelRole
    a pair:PatternRole ;
    skos:prefLabel "Embedding Model"@en ;
    pair:subRoleOf pair:Model .

pat:EmbeddingVectorRole
    a pair:PatternRole ;
    skos:prefLabel "Embedding Vector"@en .

pat:VectorIndexRole
    a pair:PatternRole ;
    skos:prefLabel "Vector Index"@en ;
    pair:subRoleOf pair:VectorStore .

pat:VectorSearchStepRole
    a pair:PatternRole ;
    skos:prefLabel "Vector Search Step"@en ;
    pair:subRoleOf pair:RetrievalStep .

pat:KeywordIndexRole
    a pair:PatternRole ;
    skos:prefLabel "Keyword Index"@en ;
    pair:subRoleOf pair:KnowledgeSource .

pat:KeywordSearchStepRole
    a pair:PatternRole ;
    skos:prefLabel "Keyword Search Step"@en ;
    pair:subRoleOf pair:RetrievalStep .

pat:RetrievedCandidateSetRole
    a pair:PatternRole ;
    skos:prefLabel "Retrieved Candidate Set"@en ;
    pair:subRoleOf pair:RetrievedContext .

pat:AggregationStepRole
    a pair:PatternRole ;
    skos:prefLabel "Aggregation Step"@en .

pat:RewrittenQueryRole
    a pair:PatternRole ;
    skos:prefLabel "Rewritten Query"@en ;
    pair:subRoleOf pair:UserInput .

pat:RerankedContextRole
    a pair:PatternRole ;
    skos:prefLabel "Reranked Context"@en ;
    pair:subRoleOf pair:RetrievedContext .

pat:GuardrailStepRole
    a pair:PatternRole ;
    skos:prefLabel "Guardrail Step"@en .

pat:InputGuardrailStepRole
    a pair:PatternRole ;
    skos:prefLabel "Input Guardrail Step"@en ;
    pair:subRoleOf pat:GuardrailStepRole .

pat:OutputGuardrailStepRole
    a pair:PatternRole ;
    skos:prefLabel "Output Guardrail Step"@en ;
    pair:subRoleOf pat:GuardrailStepRole .

pat:GuardrailDecisionRole
    a pair:PatternRole ;
    skos:prefLabel "Guardrail Decision"@en .

pat:SanitizedOutputRole
    a pair:PatternRole ;
    skos:prefLabel "Sanitized Output"@en ;
    pair:subRoleOf pair:UserFacingOutput .

pat:FineTuningDatasetRole
    a pair:PatternRole ;
    skos:prefLabel "Fine-Tuning Dataset"@en ;
    pair:subRoleOf pat:TrainingDatasetRole .

pat:FineTuningStepRole
    a pair:PatternRole ;
    skos:prefLabel "Fine-Tuning Step"@en ;
    pair:subRoleOf pat:TrainingStepRole .

pat:FineTunedModelRole
    a pair:PatternRole ;
    skos:prefLabel "Fine-Tuned Model"@en ;
    pair:subRoleOf pair:GenerativeModel .


# GenAI product motifs 

pat:DirectPromptingMotif
    a pair:GraphMotif ;
    rdfs:label "Direct Prompting Motif"@en ;   
    dct:description """
    Architectural motif in which a user query is handled directly by a
    generative model step and produces a user-facing answer. 
    """@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternNode
        pat:DP_QueryNode ,
        pat:DP_ModelNode ,
        pat:DP_GenerationStepNode ,
        pat:DP_AnswerNode ;
    pair:hasPatternEdge
        pat:DP_GenerationUsesQueryEdge ,
        pat:DP_GenerationUsesModelEdge ,
        pat:DP_GenerationProducesAnswerEdge ;
    pair:implementedBy pat:DP_MatchingOQP .

pat:DP_QueryNode
    a pair:PatternNode ;
    rdfs:label "Query node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:DP_ModelNode
    a pair:PatternNode ;
    rdfs:label "LLM node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:GenerativeModel .

pat:DP_GenerationStepNode
    a pair:PatternNode ;
    rdfs:label "Direct LLM generation step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:GenerationStep .

pat:DP_AnswerNode
    a pair:PatternNode ;
    rdfs:label "Answer node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserFacingOutput .

pat:DP_GenerationUsesQueryEdge
    a pair:PatternEdge ;
    rdfs:label "direct LLM generation uses query"@en ;
    pair:sourcePatternNode pat:DP_GenerationStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:DP_QueryNode .

pat:DP_GenerationUsesModelEdge
    a pair:PatternEdge ;
    rdfs:label "direct LLM generation uses generative model"@en ;
    pair:sourcePatternNode pat:DP_GenerationStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:DP_ModelNode .

pat:DP_GenerationProducesAnswerEdge
    a pair:PatternEdge ;
    rdfs:label "direct LLM generation produces answer"@en ;
    pair:sourcePatternNode pat:DP_GenerationStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:DP_AnswerNode .

pat:EvalsMotif
    a pair:GraphMotif ;
    rdfs:label "Evals Motif"@en ;
    dct:description "GenAI motif in which model input, generated output, expected output, and optional retrieval context are scored or judged to produce evaluation results for a task."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternNode
        pat:Evals_InputNode ,
        pat:Evals_ModelOutputNode ,
        pat:Evals_ExpectedOutputNode ,
        pat:Evals_ContextNode ,
        pat:Evals_ScorerNode ,
        pat:Evals_JudgeModelNode ,
        pat:Evals_ScoreNode ;
    pair:hasPatternEdge
        pat:Evals_ScorerUsesInputEdge ,
        pat:Evals_ScorerUsesModelOutputEdge ,
        pat:Evals_ScorerUsesExpectedOutputEdge ,
        pat:Evals_ScorerUsesContextEdge ,
        pat:Evals_ScorerUsesJudgeModelEdge ,
        pat:Evals_ScorerProducesScoreEdge .

pat:Evals_InputNode
    a pair:PatternNode ;
    rdfs:label "Evaluation input node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:Evals_ModelOutputNode
    a pair:PatternNode ;
    rdfs:label "Evaluation model output node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:LLMResponseRole .

pat:Evals_ExpectedOutputNode
    a pair:PatternNode ;
    rdfs:label "Expected output node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:ExpectedOutputRole .

pat:Evals_ContextNode
    a pair:PatternNode ;
    rdfs:label "Evaluation retrieval context node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:RetrievedContext .

pat:Evals_ScorerNode
    a pair:PatternNode ;
    rdfs:label "Evaluation scorer node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pat:ScoringStepRole .

pat:Evals_JudgeModelNode
    a pair:PatternNode ;
    rdfs:label "Judge model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pat:JudgeModelRole .

pat:Evals_ScoreNode
    a pair:PatternNode ;
    rdfs:label "Evaluation score node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:EvaluationScoreRole .

pat:Evals_ScorerUsesInputEdge
    a pair:PatternEdge ;
    rdfs:label "scorer uses input"@en ;
    pair:sourcePatternNode pat:Evals_ScorerNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Evals_InputNode .

pat:Evals_ScorerUsesModelOutputEdge
    a pair:PatternEdge ;
    rdfs:label "scorer uses model output"@en ;
    pair:sourcePatternNode pat:Evals_ScorerNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Evals_ModelOutputNode .

pat:Evals_ScorerUsesExpectedOutputEdge
    a pair:PatternEdge ;
    rdfs:label "scorer uses expected output"@en ;
    pair:sourcePatternNode pat:Evals_ScorerNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Evals_ExpectedOutputNode .

pat:Evals_ScorerUsesContextEdge
    a pair:PatternEdge ;
    rdfs:label "scorer uses retrieval context"@en ;
    pair:sourcePatternNode pat:Evals_ScorerNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Evals_ContextNode .

pat:Evals_ScorerUsesJudgeModelEdge
    a pair:PatternEdge ;
    rdfs:label "scorer uses judge model"@en ;
    pair:sourcePatternNode pat:Evals_ScorerNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Evals_JudgeModelNode .

pat:Evals_ScorerProducesScoreEdge
    a pair:PatternEdge ;
    rdfs:label "scorer produces evaluation score"@en ;
    pair:sourcePatternNode pat:Evals_ScorerNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:Evals_ScoreNode .

pat:EmbeddingsMotif
    a pair:GraphMotif ;
    rdfs:label "Embeddings Motif"@en ;
    dct:description "GenAI motif in which source documents or data blocks are chunked and transformed by an embedding model into vectors stored in a vector index."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternNode
        pat:Embedding_SourceDocumentNode ,
        pat:Embedding_ChunkingStepNode ,
        pat:Embedding_DocumentChunkNode ,
        pat:Embedding_ModelNode ,
        pat:Embedding_GenerationStepNode ,
        pat:Embedding_VectorNode ,
        pat:Embedding_VectorIndexNode ;
    pair:hasPatternEdge
        pat:Embedding_ChunkingUsesSourceEdge ,
        pat:Embedding_ChunkingProducesChunkEdge ,
        pat:Embedding_GenerationUsesChunkEdge ,
        pat:Embedding_GenerationUsesModelEdge ,
        pat:Embedding_GenerationProducesVectorEdge ,
        pat:Embedding_VectorIndexUsesVectorEdge ;
    pair:implementedBy pat:Embeddings_MatchingOQP .

pat:Embedding_SourceDocumentNode
    a pair:PatternNode ;
    rdfs:label "Embedding source document node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:SourceDocumentRole .

pat:Embedding_ChunkingStepNode
    a pair:PatternNode ;
    rdfs:label "Document chunking step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pat:ChunkingStepRole .

pat:Embedding_DocumentChunkNode
    a pair:PatternNode ;
    rdfs:label "Document chunk node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:DocumentChunkRole .

pat:Embedding_ModelNode
    a pair:PatternNode ;
    rdfs:label "Embedding model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pat:EmbeddingModelRole .

pat:Embedding_GenerationStepNode
    a pair:PatternNode ;
    rdfs:label "Embedding generation step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:EmbeddingStep .

pat:Embedding_VectorNode
    a pair:PatternNode ;
    rdfs:label "Embedding vector node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:EmbeddingVectorRole .

pat:Embedding_VectorIndexNode
    a pair:PatternNode ;
    rdfs:label "Vector index node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:VectorIndexRole .

pat:Embedding_ChunkingUsesSourceEdge
    a pair:PatternEdge ;
    rdfs:label "chunking uses source document"@en ;
    pair:sourcePatternNode pat:Embedding_ChunkingStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Embedding_SourceDocumentNode .

pat:Embedding_ChunkingProducesChunkEdge
    a pair:PatternEdge ;
    rdfs:label "chunking produces document chunk"@en ;
    pair:sourcePatternNode pat:Embedding_ChunkingStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:Embedding_DocumentChunkNode .

pat:Embedding_GenerationUsesChunkEdge
    a pair:PatternEdge ;
    rdfs:label "embedding generation uses document chunk"@en ;
    pair:sourcePatternNode pat:Embedding_GenerationStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Embedding_DocumentChunkNode .

pat:Embedding_GenerationUsesModelEdge
    a pair:PatternEdge ;
    rdfs:label "embedding generation uses embedding model"@en ;
    pair:sourcePatternNode pat:Embedding_GenerationStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Embedding_ModelNode .

pat:Embedding_GenerationProducesVectorEdge
    a pair:PatternEdge ;
    rdfs:label "embedding generation produces vector"@en ;
    pair:sourcePatternNode pat:Embedding_GenerationStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:Embedding_VectorNode .

pat:Embedding_VectorIndexUsesVectorEdge
    a pair:PatternEdge ;
    rdfs:label "vector index uses embedding vector"@en ;
    pair:sourcePatternNode pat:Embedding_VectorIndexNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Embedding_VectorNode .

pat:RetrievalAugmentedGenerationMotif
    a pair:GraphMotif ;
    rdfs:label "Retrieval Augmented Generation (RAG) Motif"@en ;
    dct:description "GenAI motif in which a user query is embedded, used to retrieve relevant context from a vector index, combined with a prompt template, and sent to an LLM to produce an answer."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternNode
        pat:RAG_QueryNode ,
        pat:RAG_EmbeddingModelNode ,
        pat:RAG_QueryEmbeddingStepNode ,
        pat:RAG_QueryVectorNode ,
        pat:RAG_VectorIndexNode ,
        pat:RAG_RetrievalStepNode ,
        pat:RAG_RetrievedContextNode ,
        pat:RAG_PromptTemplateNode ,
        pat:RAG_PromptConstructionStepNode ,
        pat:RAG_PromptNode ,
        pat:RAG_LLMNode ,
        pat:RAG_GenerationStepNode ,
        pat:RAG_ResponseNode ;
    pair:hasPatternEdge
        pat:RAG_QueryEmbeddingUsesQueryEdge ,
        pat:RAG_QueryEmbeddingUsesModelEdge ,
        pat:RAG_QueryEmbeddingProducesVectorEdge ,
        pat:RAG_RetrievalUsesQueryVectorEdge ,
        pat:RAG_RetrievalUsesVectorIndexEdge ,
        pat:RAG_RetrievalProducesContextEdge ,
        pat:RAG_PromptConstructionUsesQueryEdge ,
        pat:RAG_PromptConstructionUsesContextEdge ,
        pat:RAG_PromptConstructionUsesTemplateEdge ,
        pat:RAG_PromptConstructionProducesPromptEdge ,
        pat:RAG_GenerationUsesPromptEdge ,
        pat:RAG_GenerationUsesLLMEdge ,
        pat:RAG_GenerationProducesResponseEdge ;
    pair:implementedBy pat:RAG_MatchingOQP .

pat:RAG_QueryNode
    a pair:PatternNode ;
    rdfs:label "RAG query node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:RAG_EmbeddingModelNode
    a pair:PatternNode ;
    rdfs:label "RAG embedding model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pat:EmbeddingModelRole .

pat:RAG_QueryEmbeddingStepNode
    a pair:PatternNode ;
    rdfs:label "RAG query embedding step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:EmbeddingStep .

pat:RAG_QueryVectorNode
    a pair:PatternNode ;
    rdfs:label "RAG query vector node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:EmbeddingVectorRole .

pat:RAG_VectorIndexNode
    a pair:PatternNode ;
    rdfs:label "RAG vector index node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:VectorIndexRole .

pat:RAG_RetrievalStepNode
    a pair:PatternNode ;
    rdfs:label "RAG retrieval step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:RetrievalStep .

pat:RAG_RetrievedContextNode
    a pair:PatternNode ;
    rdfs:label "RAG retrieved context node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:RetrievedContext .

pat:RAG_PromptTemplateNode
    a pair:PatternNode ;
    rdfs:label "RAG prompt template node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PromptTemplate .

pat:RAG_PromptConstructionStepNode
    a pair:PatternNode ;
    rdfs:label "RAG prompt construction step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:PromptConstructionStep .

