tc260:3.1.1b-3.3.2a skos:prefLabel "§3.1.1(b) Model and algorithm risks (bias/discrimination) + §3.3.2(a) Ethical risks (systemic social discrimination)"@en .

tc260:3.1.2a-3.1.2d skos:prefLabel "§3.1.2(a) Data risks — collection without consent + §3.1.2(d) Data risks — PII leaks"@en .

tc260:3.2.2a skos:prefLabel "§3.2.2(a) Information content risks — malicious manipulation generating illegal/harmful content"@en .

tc260:3.3.1b skos:prefLabel "§3.3.1(b) Social and Environmental Risks — energy, electricity, land, and water consumption from AI computing"@en .

eticas:ai-interaction-disclosure a skos:Concept ;
    dcterms:source "HRA" ;
    skos:broader eticas:transparency-communication ;
    skos:closeMatch aiuc1:E.16 ;
    skos:definition "Failure to disclose that a person is interacting with an AI system, or that content was generated or manipulated by AI — depriving people of the information needed to calibrate trust, detect deception, or trace content provenance."@en ;
    skos:exactMatch eu-ai-act:article-50 ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Disclosure of AI interaction and synthetic content"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:automation-bias a skos:Concept ;
    skos:broader eticas:autonomy-human-agency ;
    skos:closeMatch mit:subdomain-5.1,
        nist-600:7 ;
    skos:definition "Over-reliance on automated outputs, accepting AI recommendations without sufficient scrutiny, leading to missed errors and reduced human judgment."@en ;
    skos:exactMatch dpv-ai:AutomationBias ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Automation bias"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:behavioural-manipulation a skos:Concept ;
    skos:broader eticas:security-harmful-misuse ;
    skos:closeMatch mit:subdomain-4.2,
        air-2024:L2-Manipulation,
        eu-ai-act:article-5-1b ;
    skos:definition "Subliminal influence, dark patterns, or exploitation of cognitive biases to steer user behaviour without informed consent."@en ;
    skos:exactMatch eu-ai-act:article-5-1a ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Behavioural manipulation"@en ;
    skos:relatedMatch aiuc1:C.3 ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:construct-validity a skos:Concept ;
    dcterms:source "Eticas (Wiselook engagement, 2026-06)" ;
    skos:broader eticas:measurement-validity ;
    skos:definition "The risk that an evaluation does not truly measure the construct it purports to measure — that it fails to capture all and only the components the construct requires. Manifests as failure to register construct-relevant evidence present in the input (under-sensitivity), or as the score moving on signals relevant only to a different construct (contamination)."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Construct validity of evaluative outputs"@en ;
    eticas-ont:lifecycleStage "in-processing",
        "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:csam-ncii-generation a skos:Concept ;
    skos:broader eticas:security-harmful-misuse ;
    skos:definition "Generation by the AI system of child sexual abuse material (CSAM) or non-consensual intimate imagery (NCII). Previously covered only implicitly under synthetic media abuse; made explicit here as a distinct content-safety risk."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "CSAM and NCII generation"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:data-governance a skos:Concept ;
    dcterms:source "HRA" ;
    skos:broader eticas:governance-compliance ;
    skos:closeMatch iso-42001:A.7,
        nist-rmf:map-2.3,
        eu-ai-act:article-10 ;
    skos:definition "Inadequate labelling, tagging, approval, or appropriateness assessment of data, leading to downstream issues with fitness for purpose, bias, and compliance."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Data governance"@en ;
    eticas-ont:lifecycleStage "pre-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:data-poisoning a skos:Concept ;
    skos:altLabel "Backdoor attacks"@en,
        "Training data poisoning"@en ;
    skos:broader eticas:security-ai-attacks ;
    skos:closeMatch aiuc1:B.1 ;
    skos:definition "Adversarial manipulation of training or fine-tuning data to introduce backdoors, bias, or systematic errors into the model. Includes both broad-spectrum poisoning (degrading overall performance) and targeted poisoning (creating exploitable triggers or specific failure modes)."@en ;
    skos:exactMatch ibm-atlas:data-poisoning,
        dpv-ai:DataPoisoning,
        eu-ai-act:recital-76 ;
    skos:inScheme eticas:scheme ;
    skos:narrowMatch mit:subdomain-2.2,
        nist-600:information-security,
        nist-rmf:secure-resilient ;
    skos:prefLabel "Data poisoning"@en ;
    eticas-ont:lifecycleStage "in-processing",
        "pre-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:deployment-sustainability a skos:Concept ;
    skos:broader eticas:organisational-readiness ;
    skos:closeMatch ibm-atlas:vendor-lock-in,
        iso-42001:A.10,
        nist-600:value-chain ;
    skos:definition "The organisation lacks the capacity for ongoing operation, maintenance, monitoring, and improvement of the AI system after initial deployment. Includes vendor lock-in risk, dependency on external expertise, and unclear cost-effectiveness or value proposition."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Deployment sustainability"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:deskilling a skos:Concept ;
    skos:broader eticas:autonomy-human-agency ;
    skos:closeMatch mit:subdomain-6.3 ;
    skos:definition "Erosion of human skills, expertise, or professional judgment through prolonged delegation of tasks to AI systems."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Deskilling"@en ;
    skos:relatedMatch oecd:recommendation-2.4 ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:disparate-impact-protected-groups a skos:Concept ;
    skos:altLabel "Accessibility barriers"@en,
        "Allocation of opportunity"@en,
        "Disparate impact"@en,
        "Intersectional unfairness"@en,
        "Quality of service disparity"@en ;
    skos:broadMatch nist-600:harmful-bias ;
    skos:broader eticas:bias-outcome-disparities ;
    skos:closeMatch mit:subdomain-1.1,
        mit:subdomain-1.3,
        air-2024:L2-DiscriminationBias-protected,
        ibm-atlas:output-fairness,
        iso-42001:A.5.2,
        nist-rmf:harmful-bias,
        dpv-ai:Discrimination,
        eu-ai-act:article-10,
        eu-ai-act:article-5-1c ;
    skos:definition "The system produces systematically different — typically worse — outcomes for individuals belonging to protected groups, including across multiple intersecting attributes (race, gender, age, disability, etc.). Encompasses unequal allocation of opportunity, quality of service disparities, intersectional unfairness, and accessibility barriers."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Disparate impact on protected groups"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:emergent-behaviour a skos:Concept ;
    skos:broader eticas:autonomy-system-autonomy ;
    skos:closeMatch mit:subdomain-7.1,
        mit:subdomain-7.6 ;
    skos:definition "Unexpected capabilities or behaviours arising from agent interactions, multi-model coordination, or complex system dynamics that were not anticipated during design."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Emergent behaviour"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "LLM" .

eticas:evasion-attacks a skos:Concept ;
    skos:altLabel "Adversarial evasion"@en,
        "Evasion attacks"@en,
        "Guardrail robustness"@en ;
    skos:broader eticas:security-ai-attacks ;
    skos:closeMatch aiuc1:B.2,
        ibm-atlas:robustness-adversarial ;
    skos:definition "Inputs crafted so that a deployed system acts on a request its safeguards should have blocked. For LLM deployments, the robustness of the guardrail or filter layer to input transformations that keep the request readable to the model while defeating the guardrail; for classifier-based systems, adversarial perturbations that force misclassification at inference time. Poisoning of training or fine-tuning data is data-poisoning."@en ;
    skos:exactMatch dpv-ai:AdversarialAttack ;
    skos:inScheme eticas:scheme ;
    skos:narrowMatch mit:subdomain-2.2 ;
    skos:prefLabel "Guardrail evasion"@en ;
    eticas-ont:lifecycleStage "in-processing",
        "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:excessive-agency a skos:Concept ;
    skos:broader eticas:agentic-actions-tool-use ;
    skos:definition "A configuration risk rather than an action risk: the agent has been granted more permissions, capabilities, or access rights than necessary for its defined task, expanding the potential damage of any failure or attack."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Excessive agency"@en ;
    eticas-ont:lifecycleStage "post-processing",
        "pre-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "LLM" .

eticas:failure-remediation-gaps a skos:Concept ;
    dcterms:source "HRA" ;
    skos:altLabel "Failures and remediations"@en,
        "Unclear remediation procedures"@en ;
    skos:broader eticas:governance-compliance ;
    skos:closeMatch aiuc1:E.3,
        iso-42001:clause-10,
        nist-rmf:manage-4 ;
    skos:definition "Absence of remediation plans for predictable or unknown failure modes, leaving critical services unable to recover or degrade gracefully."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Failure and remediation gaps"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:feedback-loops a skos:Concept ;
    skos:broader eticas:bias-dynamic-systemic-bias ;
    skos:closeMatch ibm-atlas:societal-impact-drift,
        iso-42001:A.6.2.6 ;
    skos:definition "System outputs that, when fed back into the system or its operational context, amplify existing biases over time."@en ;
    skos:inScheme eticas:scheme ;
    skos:narrowMatch nist-rmf:systemic-bias ;
    skos:prefLabel "Feedback loops reinforcing inequality"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:fitness-for-purpose a skos:Concept ;
    dcterms:source "HRA" ;
    skos:altLabel "Fitness for purpose"@en,
        "Task success"@en ;
    skos:broader eticas:governance-compliance ;
    skos:closeMatch iso-42001:A.6.2.2,
        iso-42001:A.6.2.4,
        nist-rmf:map-3 ;
    skos:definition "The system has not been validated against the problem it is intended to solve, or is deployed for a task or context beyond the one it was validated for. Covers the ex ante question (was this designed and validated for this problem?) and its enforcement in deployment; whether the system actually succeeds at the task in operation is task-performance (Reliability)."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Fitness for purpose and task effectiveness"@en ;
    eticas-ont:lifecycleStage "in-processing",
        "pre-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:function-calling-hallucination a skos:Concept ;
    skos:broader eticas:agentic-actions-tool-use ;
    skos:definition "The agent generates incorrect or malformed function calls — for example, by specifying wrong parameters, calling non-existent tools, or misinterpreting tool schemas — causing downstream failures or unintended system interactions."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Function calling hallucination"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "LLM" .

eticas:geographic-cultural-language-skew a skos:Concept ;
    skos:broader eticas:bias-representational-harm ;
    skos:closeMatch dpv-ai:NonRepresentativeSamplingBias ;
    skos:definition "Systematic performance differences across geographies, cultures, or languages, often resulting from training data that overrepresents certain regions or linguistic traditions."@en ;
    skos:inScheme eticas:scheme ;
    skos:narrowMatch mit:subdomain-1.1,
        nist-600:harmful-bias ;
    skos:prefLabel "Geographic, cultural, or language skew"@en ;
    eticas-ont:lifecycleStage "in-processing",
        "post-processing",
        "pre-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:graceful-degradation a skos:Concept ;
    skos:broader eticas:reliability-resilience ;
    skos:definition "Absence of defined degradation pathways that allow the system to maintain partial function when components fail, connectivity is lost, or resources are constrained."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Graceful degradation"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:hallucination a skos:Concept ;
    dcterms:source "HRA" ;
    skos:altLabel "Confabulation"@en,
        "Hallucination prevention"@en ;
    skos:broader eticas:reliability-output-quality ;
    skos:closeMatch mit:subdomain-3.1 ;
    skos:definition "Generation of false, fabricated, or misleading information that appears credible, including invented facts, statistics, citations, or events."@en ;
    skos:exactMatch aiuc1:D.1,
        aiuc1:D.2,
        ibm-atlas:hallucination,
        nist-600:confabulation ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Hallucination and fabricated outputs"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "LLM" .

eticas:hardware-efficiency a skos:Concept ;
    dcterms:source "HRA" ;
    skos:broader eticas:environmental-impact ;
    skos:definition "Poor hardware utilisation increasing costs, environmental footprint, and limiting the feasibility of equitable access to AI capabilities."@en ;
    skos:inScheme eticas:scheme ;
    skos:narrowMatch nist-600:environmental ;
    skos:prefLabel "Hardware efficiency"@en ;
    eticas-ont:lifecycleStage "in-processing",
        "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:harmful-content-toxicity a skos:Concept ;
    dcterms:source "HRA" ;
    skos:altLabel "Harmful content prevention"@en,
        "Toxicity"@en ;
    skos:broadMatch air-2024:L1-ContentSafety ;
    skos:broader eticas:bias-representational-harm ;
    skos:closeMatch mit:subdomain-1.2,
        aiuc1:C.3,
        nist-600:dangerous-content ;
    skos:definition "Offensive, hateful, or otherwise harmful outputs that damage user well-being and erode trust."@en ;
    skos:exactMatch ibm-atlas:toxicity-harmful-output ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Harmful content and toxicity"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "LLM" .

eticas:homogenization-output-across-groups a skos:Concept ;
    skos:broader eticas:bias-representational-harm ;
    skos:closeMatch ibm-atlas:output-diversity-mode-collapse ;
    skos:definition "The system produces outputs that flatten cultural, linguistic, or stylistic diversity, defaulting to dominant patterns and erasing distinctive characteristics of underrepresented groups. Particularly relevant for generative AI, where homogenization in text, image, or speech outputs can reinforce hegemonic norms."@en ;
    skos:exactMatch nist-600:harmful-bias-homogenization ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Homogenization of output across groups"@en ;
    skos:relatedMatch mit:subdomain-6.3 ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "LLM" .

eticas:human-oversight-control a skos:Concept ;
    dcterms:source "HRA" ;
    skos:broader eticas:governance-accountability ;
    skos:closeMatch aiuc1:C.7,
        iso-42001:A.6.2.7,
        nist-rmf:govern-3 ;
    skos:definition "Lack of defined intervention points, override capabilities, or human review mechanisms, allowing issues and threats to persist unchecked."@en ;
    skos:exactMatch eu-ai-act:article-14 ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Human oversight and control"@en ;
    skos:relatedMatch mit:subdomain-5.2 ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:incident-response-gaps a skos:Concept ;
    skos:broader eticas:governance-compliance ;
    skos:closeMatch aiuc1:E.1,
        iso-42001:clause-10,
        nist-rmf:manage-4,
        dpv-ai:IncidentManagement ;
    skos:definition "Insufficient detection, logging, escalation, or response capabilities for security incidents and misuse events."@en ;
    skos:exactMatch eu-ai-act:article-73 ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Incident response gaps"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:inference-energy-consumption a skos:Concept ;
    dcterms:source "HRA" ;
    skos:broader eticas:environmental-impact ;
    skos:definition "High energy use during deployment and inference, increasing environmental impact and infrastructure costs."@en ;
    skos:inScheme eticas:scheme ;
    skos:narrowMatch mit:subdomain-6.6,
        nist-600:environmental ;
    skos:prefLabel "Inference-time energy consumption"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:infrastructure-dependency a skos:Concept ;
    skos:broader eticas:reliability-resilience ;
    skos:definition "Unmapped or unmitigated dependencies on external infrastructure (power, connectivity, cloud services, third-party APIs) whose failure would disable the system."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Infrastructure dependency"@en ;
    eticas-ont:lifecycleStage "post-processing",
        "pre-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:institutional-capacity a skos:Concept ;
    skos:broader eticas:organisational-readiness ;
    skos:closeMatch oecd:recommendation-2.4 ;
    skos:definition "The broader institutional or societal context lacks foundational capabilities (digital infrastructure, data literacy, regulatory frameworks) needed before AI deployment is viable. Premature deployment may reallocate scarce resources, exacerbate inequality, or create technological dependency."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Institutional absorptive capacity"@en ;
    skos:relatedMatch mit:subdomain-6.2 ;
    eticas-ont:lifecycleStage "pre-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:jailbreaking a skos:Concept ;
    dcterms:source "HRA" ;
    skos:altLabel "Jailbreakability"@en ;
    skos:broader eticas:security-ai-attacks ;
    skos:closeMatch aiuc1:C.1 ;
    skos:definition "Techniques used to bypass safety controls, content filters, or usage restrictions to trigger prohibited behaviours or outputs."@en ;
    skos:inScheme eticas:scheme ;
    skos:narrowMatch mit:subdomain-2.2 ;
    skos:prefLabel "Jailbreaking"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "LLM" .

eticas:lack-of-change-management a skos:Concept ;
    skos:broader eticas:governance-compliance ;
    skos:closeMatch iso-42001:A.6.2.6,
        nist-rmf:manage-4 ;
    skos:definition "Absence of controlled processes for system modifications, including uncontrolled changes to production systems."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Lack of change management"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:limited-auditability a skos:Concept ;
    skos:broader eticas:governance-documentation ;
    skos:closeMatch aiuc1:E.15,
        iso-42001:A.6.2.8,
        nist-rmf:measure-2.8 ;
    skos:definition "Insufficient logging, versioning, or traceability for meaningful external review or internal audit."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Limited auditability"@en ;
    eticas-ont:lifecycleStage "in-processing",
        "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:loss-of-human-control a skos:Concept ;
    skos:broader eticas:autonomy-system-autonomy ;
    skos:closeMatch aiuc1:C.7,
        eu-ai-act:article-14 ;
    skos:definition "AI systems operating at speeds or complexity levels that make meaningful human oversight impractical, including inability to understand, interrupt, or reverse autonomous decisions."@en ;
    skos:exactMatch mit:subdomain-5.2 ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Loss of meaningful human control"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:monitoring-evaluation-gaps a skos:Concept ;
    dcterms:source "HRA" ;
    skos:altLabel "Monitoring, feedback, evaluation"@en ;
    skos:broader eticas:governance-compliance ;
    skos:closeMatch aiuc1:C.8,
        iso-42001:A.6.2.6,
        nist-rmf:manage-4,
        dpv-ai:MonitoringControl,
        eu-ai-act:article-72 ;
    skos:definition "Lack of ongoing monitoring that renders datasets obsolete and system outputs unreliable, including absence of feedback mechanisms and periodic evaluation."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Monitoring and evaluation gaps"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:multi-step-actions a skos:Concept ;
    skos:broader eticas:autonomy-system-autonomy ;
    skos:closeMatch aiuc1:B.6 ;
    skos:definition "AI systems that plan and execute sequences of actions, where errors in early steps cascade unpredictably through later steps."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Multi-step autonomous actions"@en ;
    skos:relatedMatch mit:subdomain-7.6 ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "LLM" .

eticas:org-preparedness a skos:Concept ;
    skos:broader eticas:organisational-readiness ;
    skos:closeMatch iso-42001:A.4.2,
        nist-rmf:govern-4,
        eu-ai-act:article-4 ;
    skos:definition "The deploying organisation lacks the governance maturity, leadership engagement, change management capacity, staff competency, or cultural receptivity needed to absorb an AI system into its operations."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Organisational preparedness"@en ;
    eticas-ont:lifecycleStage "pre-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:out-of-distribution-robustness a skos:Concept ;
    dcterms:source "HRA" ;
    skos:broader eticas:reliability-output-quality ;
    skos:definition "Unpredictable behaviour or failure when the system is exposed to inputs outside the distribution of its training data."@en ;
    skos:inScheme eticas:scheme ;
    skos:narrowMatch mit:subdomain-7.3,
        nist-rmf:valid-reliable ;
    skos:prefLabel "Out-of-distribution robustness"@en ;
    eticas-ont:lifecycleStage "in-processing",
        "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:output-drift a skos:Concept ;
    skos:broader eticas:reliability-output-quality ;
    skos:closeMatch ibm-atlas:output-drift,
        iso-42001:A.6.2.6 ;
    skos:definition "Degradation of output quality or accuracy as data distributions, user behaviour, or operating conditions change after deployment."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Output drift over time"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:output-inconsistency a skos:Concept ;
    skos:broader eticas:reliability-output-quality ;
    skos:definition "Inconsistent results across similar inputs and contexts, undermining reproducibility and user trust."@en ;
    skos:inScheme eticas:scheme ;
    skos:narrowMatch aiuc1:D.1,
        nist-rmf:valid-reliable ;
    skos:prefLabel "Output inconsistency"@en ;
    eticas-ont:lifecycleStage "in-processing",
        "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:over-reliance a skos:Concept ;
    skos:broader eticas:autonomy-human-agency ;
    skos:closeMatch ibm-atlas:anthropomorphisation,
        nist-600:7 ;
    skos:definition "Systemic dependence on AI systems that leaves individuals or organisations unable to function when the system is unavailable or produces incorrect outputs."@en ;
    skos:exactMatch mit:subdomain-5.1 ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Over-reliance on AI"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:oversight-of-adverse-impacts a skos:Concept ;
    dcterms:source "HRA" ;
    skos:broader eticas:governance-accountability ;
    skos:closeMatch iso-42001:A.5.2,
        nist-rmf:manage-4 ;
    skos:definition "Missing processes for identifying, escalating, and responding to harmful outcomes, including psychological or physical harm and threats to human life."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Oversight of significant adverse impacts"@en ;
    eticas-ont:lifecycleStage "post-processing",
        "pre-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:performance-equity a skos:Concept ;
    dcterms:source "HRA" ;
    skos:altLabel "Group-wise error rate"@en,
        "Performance equity across populations"@en ;
    skos:broader eticas:bias-outcome-disparities ;
    skos:closeMatch mit:subdomain-1.3,
        nist-rmf:harmful-bias-disparate-performance ;
    skos:definition "The AI system performs systematically worse for some demographic groups than others — through higher error rates, lower accuracy, or reduced reliability — leading to unequal quality of service even when access is the same."@en ;
    skos:exactMatch ibm-atlas:output-bias ;
    skos:inScheme eticas:scheme ;
    skos:narrowMatch aiuc1:C.5 ;
    skos:prefLabel "Differential performance across populations"@en ;
    eticas-ont:lifecycleStage "in-processing",
        "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:poor-documentation a skos:Concept ;
    skos:broader eticas:governance-documentation ;
    skos:closeMatch aiuc1:E.17,
        iso-42001:A.6.2.8,
        eu-ai-act:article-11 ;
    skos:definition "Incomplete, outdated, or absent documentation of system purpose, architecture, data sources, known limitations, and operational procedures."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Poor documentation"@en ;
    eticas-ont:lifecycleStage "in-processing",
        "post-processing",
        "pre-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:prompt-injection a skos:Concept ;
    dcterms:source "HRA" ;
    skos:altLabel "Prompt injection protection"@en ;
    skos:broader eticas:security-ai-attacks ;
    skos:closeMatch aiuc1:B.2 ;
    skos:definition "Malicious inputs designed to subvert system intent by injecting instructions that override the system prompt, leading to harmful, deceptive, or unauthorized outputs."@en ;
    skos:exactMatch dpv-ai:PromptInjection ;
    skos:inScheme eticas:scheme ;
    skos:narrowMatch nist-600:information-security ;
    skos:prefLabel "Prompt injection"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "LLM" .

eticas:re-identification a skos:Concept ;
    skos:broader eticas:privacy-data-protection ;
    skos:closeMatch mit:subdomain-2.1 ;
    skos:definition "The possibility that anonymised or pseudonymised data can be linked back to specific individuals through inference, combination with other datasets, or model outputs."@en ;
    skos:exactMatch dpv-ai:Reidentification ;
    skos:inScheme eticas:scheme ;
    skos:narrowMatch nist-600:data-privacy ;
    skos:prefLabel "Re-identification of anonymised data"@en ;
    eticas-ont:lifecycleStage "post-processing",
        "pre-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:regulatory-non-compliance a skos:Concept ;
    skos:broader eticas:governance-compliance ;
    skos:closeMatch aiuc1:E.10,
        iso-42001:A.2,
        eu-ai-act:chapter-iii ;
    skos:definition "Failure to align with applicable legal, ethical, or organisational standards, including sector-specific regulations."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Regulatory non-compliance"@en ;
    eticas-ont:lifecycleStage "post-processing",
        "pre-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:right-to-explanation-contestation a skos:Concept ;
    skos:altLabel "Absence of appeal mechanisms"@en,
        "Ineffective communication with affected parties"@en,
        "Right to contest"@en,
        "Right to explanation"@en ;
    skos:broader eticas:transparency-explainability-group ;
    skos:closeMatch air-2024:L2-FundamentalRights,
        aiuc1:E.16,
        iso-42001:A.8.3,
        oecd:principle-1.3 ;
    skos:definition "The risk that affected individuals are not informed about decisions taken with AI assistance, do not receive a meaningful explanation of those decisions, or have no effective channel to challenge or appeal them. Includes obligations under GDPR Article 22 (rights regarding automated individual decision-making) and EU AI Act Article 13 (transparency and provision of information to deployers and affected persons)."@en ;
    skos:exactMatch dpv-ai:RightToExplanation,
        eu-ai-act:article-86 ;
    skos:inScheme eticas:scheme ;
    skos:narrowMatch nist-rmf:accountable-transparent ;
    skos:prefLabel "Right to explanation and contestation"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:scope-creep-goal-misalignment a skos:Concept ;
    skos:broader eticas:agentic-actions-tool-use ;
    skos:definition "The agent pursues its objective in ways that exceed intended boundaries, develop unintended sub-goals, or conflict with user intent — driven by ambiguous instructions, reward misspecification, or emergent planning behaviour across multiple steps."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Scope creep and goal misalignment"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "LLM" .

eticas:security-system a skos:Concept ;
    skos:broader eticas:security-misuse ;
    skos:closeMatch aiuc1:B,
        ibm-atlas:security-non-technical,
        iso-42001:A.6.2.5,
        nist-600:9 ;
    skos:definition "The risks that arise from unauthorised access, vulnerable third-party components, or over-disclosure of technical details that enable targeting. Unlike Governance risks, this includes whether the system and its environment can be technically compromised."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Infrastructure & System security"@en .

eticas:sensitive-information-leakage a skos:Concept ;
    dcterms:source "HRA" ;
    skos:altLabel "PII leakage rate"@en,
        "Privacy leakage"@en ;
    skos:broader eticas:privacy-model-level ;
    skos:closeMatch nist-600:data-privacy,
        dpv-ai:UnauthorisedDataDisclosure ;
    skos:definition "Personal or confidential/proprietary information present in training data, inference-time context, or connected systems, surfacing in model outputs through memorisation, context disclosure, cross-tenant contamination, or system-prompt extraction. Covers personal data and organisational or commercial confidentiality alike."@en ;
    skos:exactMatch mit:subdomain-2.1,
        air-2024:L3-PrivacyViolations-PII,
        aiuc1:A.6,
        ibm-atlas:personal-information-output ;
    skos:inScheme eticas:scheme ;
    skos:narrowMatch eu-ai-act:article-15-5 ;
    skos:prefLabel "Sensitive information leakage through model outputs"@en ;
    eticas-ont:lifecycleStage "in-processing",
        "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:sentiment-fairness a skos:Concept ;
    dcterms:source "HRA" ;
    skos:altLabel "Sentiment fairness across groups"@en ;
    skos:broader eticas:bias-representational-harm ;
    skos:definition "The system produces outputs of systematically different tone, sentiment, or quality when describing or addressing different demographic groups — for example, more negative, more dismissive, or less detailed responses for certain populations."@en ;
    skos:inScheme eticas:scheme ;
    skos:narrowMatch mit:subdomain-1.1,
        ibm-atlas:output-fairness-sentiment ;
    skos:prefLabel "Sentiment and quality disparity across groups"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "LLM" .

eticas:stakeholder-communication a skos:Concept ;
    dcterms:source "HRA" ;
    skos:altLabel "Communication to relevant interested parties"@en,
        "Communication to stakeholders"@en ;
    skos:broader eticas:transparency-communication ;
    skos:closeMatch aiuc1:E.17,
        iso-42001:A.8.2,
        eu-ai-act:article-13 ;
    skos:definition "The AI system's capabilities, limitations, intended use cases, and known failure modes are not communicated clearly to deployers, users, or affected parties, leading to misuse, over-reliance, or under-reliance on the system."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Inadequate disclosure of system capabilities and limitations"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:stereotyping-demeaning-content a skos:Concept ;
    dcterms:source "HRA" ;
    skos:altLabel "Minimization of stereotyping"@en ;
    skos:broader eticas:bias-representational-harm ;
    skos:closeMatch mit:subdomain-1.1,
        air-2024:L3-Stereotyping,
        ibm-atlas:toxicity-stereotyping ;
    skos:definition "AI system outputs that reinforce, perpetuate, erase, or demean demographic groups through stereotypical representations or language."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Stereotyping and demeaning content"@en ;
    eticas-ont:lifecycleStage "in-processing",
        "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:supply-chain-vulnerabilities a skos:Concept ;
    skos:broader eticas:governance-accountability ;
    skos:closeMatch iso-42001:A.10,
        nist-600:value-chain,
        eu-ai-act:article-25 ;
    skos:definition "Risks introduced through third-party components, pre-trained models, data sources, or other dependencies not fully under the deployer's control."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Supply-chain vulnerabilities"@en ;
    eticas-ont:lifecycleStage "in-processing",
        "pre-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:synthetic-media-abuse a skos:Concept ;
    skos:broader eticas:security-harmful-misuse ;
    skos:closeMatch mit:subdomain-4.1,
        air-2024:L2-Deception,
        ibm-atlas:misinformation,
        nist-600:information-integrity,
        eu-ai-act:article-50 ;
    skos:definition "Generation of deepfakes, fake voices, or undisclosed AI-generated content used to deceive or harm."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Synthetic media abuse"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "LLM" .

eticas:system-explainability a skos:Concept ;
    dcterms:source "HRA" ;
    skos:broader eticas:transparency-explainability-group ;
    skos:closeMatch ibm-atlas:unexplainable-output,
        nist-rmf:explainable,
        dpv-ai:ExplainabilityRisk ;
    skos:definition "Stakeholders misinterpret or misunderstand the intended purpose or use of an AI system based on its outputs, due to insufficient explanation of how outputs are produced."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "AI system explainability"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:task-performance a skos:Concept ;
    skos:altLabel "Inadequate task performance"@en,
        "Task effectiveness"@en ;
    skos:broader eticas:reliability-output-quality ;
    skos:definition "The system does not succeed at its intended task in operation, or succeeds unevenly across subpopulations and input types, falling short of what the use requires. Measured ex post against the task the system was deployed for. Whether the system was validated for that task in the first place is fitness-for-purpose (Governance); for systems whose output is an evaluative score, whether the score measures what it claims is measurement-validity."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Task performance"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:technical-interoperability a skos:Concept ;
    skos:broader eticas:organisational-readiness ;
    skos:closeMatch iso-42001:A.4.3 ;
    skos:definition "The AI system cannot integrate with existing infrastructure, legacy systems, data pipelines, or standards (e.g., HL7 FHIR in healthcare) required for it to function in the deployment environment."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Technical interoperability"@en ;
    eticas-ont:lifecycleStage "post-processing",
        "pre-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:tool-use-risks a skos:Concept ;
    skos:broader eticas:autonomy-system-autonomy ;
    skos:closeMatch aiuc1:B.6 ;
    skos:definition "AI systems that interact with external tools, APIs, or services, creating unintended side effects or security exposures."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Tool use risks"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "LLM" .

eticas:training-resource-consumption a skos:Concept ;
    dcterms:source "HRA" ;
    skos:broader eticas:environmental-impact ;
    skos:definition "Significant carbon emissions, energy use, and water consumption associated with model training, particularly for large-scale foundation models."@en ;
    skos:inScheme eticas:scheme ;
    skos:narrowMatch mit:subdomain-6.6,
        nist-600:environmental ;
    skos:prefLabel "Training resource consumption"@en ;
    eticas-ont:lifecycleStage "in-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:trust-calibration a skos:Concept ;
    skos:broader eticas:autonomy-human-agency ;
    skos:closeMatch nist-600:7 ;
    skos:definition "Inappropriate levels of trust in AI outputs — either excessive trust leading to uncritical acceptance, or insufficient trust leading to underuse of valuable AI capabilities."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Trust calibration"@en ;
    skos:relatedMatch mit:subdomain-5.1 ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

eticas:trust-exploitation-between-agents a skos:Concept ;
    skos:broader eticas:agentic-multi-agent-integrity ;
    skos:definition "A compromised or malicious agent manipulates other agents in a pipeline by exploiting implicit trust in inter-agent communication, passing false instructions, forged outputs, or poisoned context to downstream agents."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Trust exploitation between agents"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "LLM" .

eticas:unclear-responsibilities a skos:Concept ;
    skos:broader eticas:governance-accountability ;
    skos:closeMatch aiuc1:E.4,
        iso-42001:A.3.2,
        nist-rmf:govern-1 ;
    skos:definition "Missing or ambiguous assignment of roles and responsibilities for AI system design, deployment, monitoring, and incident response."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Unclear responsibilities and accountability gaps"@en ;
    eticas-ont:lifecycleStage "post-processing",
        "pre-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:unlawful-data-processing a skos:Concept ;
    skos:broader eticas:privacy-collection-use ;
    skos:closeMatch air-2024:L3-UnauthorizedPrivacyViolations,
        dpv-ai:PersonalDataHandling,
        eu-ai-act:article-10 ;
    skos:definition "Collection, storage, or processing of personal data without adequate legal basis, consent, or compliance with applicable data protection regulations."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Unlawful collection or processing of personal data"@en ;
    eticas-ont:lifecycleStage "pre-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:unsafe-tool-calls a skos:Concept ;
    skos:broader eticas:agentic-actions-tool-use ;
    skos:definition "The agent invokes tools, APIs, or services beyond its intended scope — for example, calling the wrong tool, calling a tool with incorrect parameters, or accessing systems it was not designed to interact with."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Unsafe or unauthorised tool calls"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "LLM" .

eticas:untraceable-agent-actions a skos:Concept ;
    skos:broader eticas:agentic-multi-agent-integrity ;
    skos:definition "Agent actions across multi-step pipelines cannot be reconstructed, explained, or attributed, making it impossible to audit what the agent did, in what order, and why. Includes loss of data provenance — for example, the agent loses track of the origin and reliability of retrieved data, making factual claims unverifiable."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Unexplainable and untraceable actions"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "LLM" .

eticas:weak-data-controls a skos:Concept ;
    skos:broader eticas:privacy-data-protection ;
    skos:closeMatch aiuc1:A.5,
        iso-42001:A.7.5 ;
    skos:definition "Insufficient policies or technical measures for data retention limits, secure deletion, and access restrictions, increasing the risk of unauthorized access or indefinite data persistence."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Weak data retention, erasure, and access controls"@en ;
    eticas-ont:lifecycleStage "post-processing",
        "pre-processing" ;
    eticas-ont:maturity "established" ;
    eticas-ont:scope "ALL" .

eticas:workflow-compatibility a skos:Concept ;
    skos:broader eticas:organisational-readiness ;
    skos:closeMatch iso-42001:A.6.2.5,
        nist-rmf:map-3 ;
    skos:definition "The system's outputs, alerts, or interfaces do not fit existing human workflows, leading to alert fatigue, workarounds, or abandonment. Includes inadequate end-user involvement in design and testing, and poor context transferability from development to deployment environment."@en ;
    skos:inScheme eticas:scheme ;
    skos:prefLabel "Workflow compatibility"@en ;
    eticas-ont:lifecycleStage "post-processing" ;
    eticas-ont:maturity "emerging" ;
    eticas-ont:scope "ALL" .

