ibm-atlas:governance-skill-gaps skos:prefLabel "Non-technical → Governance + Skill gaps + Vendor risk"@en .

ibm-atlas:hallucination skos:prefLabel "Output → Robustness → Hallucination"@en .

ibm-atlas:harmful-output-misuse skos:prefLabel "Output → Harmful output + Non-technical → Misuse"@en .

ibm-atlas:input-output-privacy skos:prefLabel "Input → Data privacy + Output → Privacy violations"@en .

ibm-atlas:misinformation skos:prefLabel "Output → Misinformation"@en .

ibm-atlas:output-diversity-mode-collapse skos:prefLabel "Output diversity / mode collapse"@en .

ibm-atlas:output-drift skos:prefLabel "Output → Drift"@en .

ibm-atlas:output-explainability skos:prefLabel "Output → Explainability"@en .

ibm-atlas:output-fairness skos:prefLabel "Output → Fairness dimension"@en .

ibm-atlas:output-fairness-and-training-data skos:prefLabel "Output → Fairness + Training data → Accuracy + Fairness"@en .

ibm-atlas:output-fairness-sentiment skos:prefLabel "Output → Fairness (sentiment quality across groups)"@en .

ibm-atlas:personal-information-output skos:prefLabel "Output → Revealing personal information in output"@en .

ibm-atlas:security-misuse skos:prefLabel "Inference → Adversarial robustness + Non-technical → Misuse"@en .

ibm-atlas:security-non-technical skos:prefLabel "Non-technical → Misuse + Inference → Security"@en .

ibm-atlas:toxicity-stereotyping skos:prefLabel "Output → Toxicity / Harmful output (stereotyping)"@en .

ibm-atlas:unexplainable-output skos:prefLabel "Output → Explainability → Unexplainable output"@en .

