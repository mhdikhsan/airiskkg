# CQ12: Which risk patterns name no motif, and are therefore evaluated over any
# motif match whose conditions hold?
# Scope: library
# Note: two of them, and the library browser must keep saying so rather than
# showing an empty heading.

PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?patternName ?label
WHERE {
    ?pattern a pair:RiskPattern .
    OPTIONAL { ?pattern rdfs:label ?label }
    FILTER NOT EXISTS { ?pattern pair:hasMotif ?motif }
    BIND(REPLACE(STR(?pattern), "^.*[#/]", "") AS ?patternName)
}
ORDER BY ?patternName
