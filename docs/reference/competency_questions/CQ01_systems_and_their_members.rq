# CQ01: Which AI systems does a submitted architecture graph describe, and how
# many processes, resources and agents does each hold?
# Scope: architecture
# Note: beam:hasProcess / hasResource / hasAgent is what a system boundary is
# made of - there is no stored scope, so membership is the traversal.

PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?system ?name
       (COUNT(DISTINCT ?process) AS ?processes)
       (COUNT(DISTINCT ?resource) AS ?resources)
       (COUNT(DISTINCT ?agent) AS ?agents)
WHERE {
    ?system a beam:System .
    OPTIONAL { ?system rdfs:label ?label }
    OPTIONAL { ?system beam:hasProcess ?process }
    OPTIONAL { ?system beam:hasResource ?resource }
    OPTIONAL { ?system beam:hasAgent ?agent }
    BIND(COALESCE(?label, REPLACE(STR(?system), "^.*[#/]", "")) AS ?name)
}
GROUP BY ?system ?name
ORDER BY ?name
