# CQ20: Which motifs matched this architecture, and which element bound to which
# pattern node?
# Scope: assessment
# Note: matches are pair:MotifMatch instances, not distinct motifs. Motifs nest
# by design, so the count is structural coverage - never report it as how many
# different things the system does.

PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>

SELECT ?motifName ?patternNode ?elementName
WHERE {
    ?match a pair:MotifMatch ;
        pair:matchesMotif ?motif ;
        pair:hasNodeBinding ?binding .
    ?binding pair:bindsPatternNode ?node ;
        pair:matchedElement ?element .
    BIND(REPLACE(STR(?motif), "^.*[#/]", "") AS ?motifName)
    BIND(REPLACE(STR(?node), "^.*[#/]", "") AS ?patternNode)
    BIND(REPLACE(STR(?element), "^.*[#/]", "") AS ?elementName)
}
ORDER BY ?motifName ?patternNode ?elementName
