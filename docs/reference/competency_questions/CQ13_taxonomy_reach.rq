# CQ13: Which external catalogues does the library reach, and how many entries
# of each can a finding cite?
# Scope: library
# Note: reach is not coverage of the catalogue - see CQ14 for what is left out.

PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>

SELECT ?catalogue
       (COUNT(DISTINCT ?entry) AS ?entries)
       (COUNT(DISTINCT ?pattern) AS ?riskPatterns)
WHERE {
    ?pattern a pair:RiskPattern ;
        pair:mayIndicateRisk ?entry .
    BIND(REPLACE(STR(?entry), "^(.*)[#/][^#/]*$", "$1") AS ?catalogue)
}
GROUP BY ?catalogue
ORDER BY DESC(?entries)
