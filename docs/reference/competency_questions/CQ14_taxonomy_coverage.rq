# CQ14: For each risk taxonomy the knowledge base carries, how many entries can
# a risk pattern flag, and how many can it not?
# Scope: library
# Note: coverage is a fact about the library, not about a system. An entry goes
# unflagged when it has no design-time structural signature: the agentic layer
# models only the four ASI entries with one (goal hijack, tool misuse, memory
# and context poisoning, insecure inter-agent communication), because an entry
# defined by runtime behaviour would fire on every agent and break candidate
# framing. Atlas, MIT and NIST entries are reached through mappings rather than
# anchored on, so low coverage there is the design, not a gap.

PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX nexus: <http://w3id.org/airiskkg/taxonomy/nexus#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>

SELECT ?taxonomy
       (COUNT(DISTINCT ?entry) AS ?entries)
       (COUNT(DISTINCT ?flagged) AS ?flaggedByARiskPattern)
WHERE {
    ?entry a nexus:Risk ;
        skos:inScheme ?scheme .
    OPTIONAL { ?scheme skos:prefLabel ?schemeLabel }
    OPTIONAL {
        ?pattern a pair:RiskPattern ;
            pair:mayIndicateRisk ?entry .
        BIND(?entry AS ?flagged)
    }
    BIND(COALESCE(?schemeLabel, REPLACE(STR(?scheme), "^.*[#/]", "")) AS ?taxonomy)
}
GROUP BY ?taxonomy
ORDER BY ?taxonomy
