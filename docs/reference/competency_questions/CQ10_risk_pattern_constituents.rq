# CQ10: What is a risk pattern made of - which motifs, applicability conditions,
# mechanism, taxonomy links and controls?
# Scope: library
# Note: this is glossary term 7, the constituent equation:
# Risk Pattern = Motif + Applicability Conditions + Mechanism + Taxonomy Links
# + Controls. The library browser lays its detail panel out in this order.

PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>

SELECT ?patternName
       (GROUP_CONCAT(DISTINCT ?motifName; separator=", ") AS ?motifs)
       (GROUP_CONCAT(DISTINCT ?conditionName; separator=", ") AS ?conditions)
       (GROUP_CONCAT(DISTINCT ?mechanismName; separator=", ") AS ?mechanism)
       (COUNT(DISTINCT ?entry) AS ?taxonomyEntries)
       (COUNT(DISTINCT ?control) AS ?controls)
WHERE {
    ?pattern a pair:RiskPattern .
    OPTIONAL { ?pattern pair:hasMotif ?motif }
    OPTIONAL { ?pattern pair:hasApplicabilityCondition ?condition }
    OPTIONAL { ?pattern pair:hasMechanism ?mechanism }
    OPTIONAL { ?pattern pair:mayIndicateRisk ?entry }
    OPTIONAL { ?pattern pair:suggestedControl ?control }
    BIND(REPLACE(STR(?pattern), "^.*[#/]", "") AS ?patternName)
    BIND(COALESCE(REPLACE(STR(?motif), "^.*[#/]", ""), "") AS ?motifName)
    BIND(COALESCE(REPLACE(STR(?condition), "^.*[#/]", ""), "") AS ?conditionName)
    BIND(COALESCE(REPLACE(STR(?mechanism), "^.*[#/]", ""), "") AS ?mechanismName)
}
GROUP BY ?patternName
ORDER BY ?patternName
