# CQ25: Which business activity is carried out by which AI system, and who owns
# that activity in the process?
# Scope: business
# Note: the layers join by refinement, never subsumption. A bpmn:activity is not
# a beam:Process and must never be aligned to one - every match query types its
# step node as ?step a/rdfs:subClassOf* beam:Process, so subsuming activities
# would make every business activity a candidate motif node.

PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX bp:   <https://sBPMN.github.io/2.0/properties#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?activityName ?laneName ?poolName ?systemName
WHERE {
    ?activity pair:refinedBy ?system .
    OPTIONAL { ?activity bp:name ?activityName }
    OPTIONAL { ?lane bp:flowNodeRef ?activity ; bp:name ?laneName }
    OPTIONAL {
        ?process bp:contains ?activity .
        ?pool bp:processRef ?process ; bp:name ?poolName .
    }
    OPTIONAL { ?system rdfs:label ?systemLabel }
    BIND(COALESCE(?systemLabel, REPLACE(STR(?system), "^.*[#/]", "")) AS ?systemName)
}
ORDER BY ?poolName ?activityName
