# CQ15: Which controls does each risk pattern suggest, of what nature, and which
# motif could structurally realize each?
# Scope: library
# Note: pair:realizedByMotif marks a CANDIDATE structural mitigation, not proof
# that inserting the motif removes the risk - several realizing motifs are
# themselves risk-bearing.

PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?patternName ?controlLabel ?nature
       (GROUP_CONCAT(DISTINCT ?motifName; separator=", ") AS ?realizingMotifs)
WHERE {
    ?pattern a pair:RiskPattern ;
        pair:suggestedControl ?control .
    ?control skos:prefLabel ?controlLabel .
    OPTIONAL { ?control pair:controlNature ?natureConcept }
    OPTIONAL { ?control pair:realizedByMotif ?motif }
    BIND(REPLACE(STR(?pattern), "^.*[#/]", "") AS ?patternName)
    BIND(REPLACE(STR(?natureConcept), "^.*[#/]", "") AS ?nature)
    BIND(COALESCE(REPLACE(STR(?motif), "^.*[#/]", ""), "") AS ?motifName)
}
GROUP BY ?patternName ?controlLabel ?nature
ORDER BY ?patternName ?controlLabel
