# CQ18: How does each pattern role state where it came from?
# Scope: library
# Note: R6 allows three ways - an own dct:source, a SKOS mapping into an
# external vocabulary, or inheritance through pair:subRoleOf from a parent that
# has either. The third is deliberate: a role introduced to refine another is
# grounded by the role it specializes, and subRoleOf already says which, so the
# chain is followed rather than restated in prose. This query walks the chain
# the same way test_every_pattern_role_states_its_provenance does; a row in the
# last bucket is a role with no source, no mapping, and no parent that has
# either, which is a defect rather than a style.

PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>

SELECT ?provenance (COUNT(DISTINCT ?role) AS ?roles)
WHERE {
    {
        SELECT ?role
               (SAMPLE(?own) AS ?ownSource)
               (SAMPLE(?external) AS ?mapping)
               (SAMPLE(?ancestorOrigin) AS ?inherited)
        WHERE {
            ?role a pair:PatternRole .
            OPTIONAL { ?role dct:source ?own }
            OPTIONAL {
                VALUES ?mappingPredicate {
                    skos:exactMatch skos:closeMatch skos:broadMatch
                    skos:narrowMatch skos:relatedMatch
                }
                ?role ?mappingPredicate ?external
            }
            OPTIONAL {
                ?role pair:subRoleOf+ ?ancestor .
                {
                    ?ancestor dct:source ?ancestorOrigin
                }
                UNION
                {
                    VALUES ?ancestorPredicate {
                        skos:exactMatch skos:closeMatch skos:broadMatch
                        skos:narrowMatch skos:relatedMatch
                    }
                    ?ancestor ?ancestorPredicate ?ancestorOrigin
                }
            }
        }
        GROUP BY ?role
    }
    BIND(IF(BOUND(?ownSource), "1 own dct:source",
         IF(BOUND(?mapping), "2 SKOS mapping into an external vocabulary",
         IF(BOUND(?inherited), "3 inherited through pair:subRoleOf",
            "4 none - this is a defect"))) AS ?provenance)
}
GROUP BY ?provenance
ORDER BY ?provenance
