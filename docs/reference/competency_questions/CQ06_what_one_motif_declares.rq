# CQ06: What structure does one motif declare - which pattern nodes, of which
# expected class and role, connected by which flow relations?
# Scope: library
# Note: this is the ODP. The registered SPARQL CONSTRUCT is its OQP (CQ07) and
# may differ topologically, but not semantically. The workbench draws its motif
# templates from exactly these triples.

PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX pat:  <http://w3id.org/airiskkg/patterns#>

SELECT ?sourceRole ?relation ?targetRole ?sourceClass ?targetClass
WHERE {
    VALUES ?motif { pat:RetrievalAugmentedGenerationMotif }

    ?motif pair:hasPatternEdge ?edge .
    ?edge pair:sourcePatternNode ?source ;
        pair:patternPredicate ?predicate ;
        pair:targetPatternNode ?target .
    ?source pair:expectedRole ?sourceRoleIri ;
        pair:expectedClass ?sourceClassIri .
    ?target pair:expectedRole ?targetRoleIri ;
        pair:expectedClass ?targetClassIri .

    BIND(REPLACE(STR(?sourceRoleIri), "^.*[#/]", "") AS ?sourceRole)
    BIND(REPLACE(STR(?targetRoleIri), "^.*[#/]", "") AS ?targetRole)
    BIND(REPLACE(STR(?sourceClassIri), "^.*[#/]", "") AS ?sourceClass)
    BIND(REPLACE(STR(?targetClassIri), "^.*[#/]", "") AS ?targetClass)
    BIND(REPLACE(STR(?predicate), "^.*[#/]", "") AS ?relation)
}
ORDER BY ?sourceRole ?relation ?targetRole
