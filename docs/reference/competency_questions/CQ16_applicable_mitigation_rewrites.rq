# CQ16: Which control can actually be applied to a graph, for which risk
# pattern, by which registered rewrite?
# Scope: library
# Note: rewrites are keyed on (control, risk pattern), never on the control
# alone - the same control answers several patterns while a rewrite is written
# against one vulnerable shape. A control with no rewrite for that finding's
# pattern must report applicable: false rather than offer a button that does
# nothing.

PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?controlLabel ?patternName ?realizedMotif ?implementationPath
WHERE {
    ?implementation pair:producesOutputType pair:MitigationApplication ;
        pair:implementsControl ?control ;
        pair:mitigatesRiskPattern ?pattern ;
        pair:implementationPath ?implementationPath .
    ?control skos:prefLabel ?controlLabel .
    OPTIONAL { ?implementation pair:realizesMotif ?motif }
    BIND(REPLACE(STR(?pattern), "^.*[#/]", "") AS ?patternName)
    BIND(REPLACE(STR(?motif), "^.*[#/]", "") AS ?realizedMotif)
}
ORDER BY ?controlLabel ?patternName
