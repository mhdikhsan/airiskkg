# CQ23: Which data categories reached an element, and did they get there by
# annotation or by derivation?
# Scope: assessment
# Note: Data Category is the one facet that is also DERIVED, by registered
# propagation queries the runner re-runs to a fixed point (R8). Every other
# facet is an annotated base fact and is never propagated as a facet - an
# element derived from observed data is derived data, not observed data, so
# copying the label downstream would assert something false. What a derived
# category does carry is the prov:Derivation naming what it came from, which is
# the column on the right.

PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?elementName ?category ?how ?derivedFrom ?throughStep
WHERE {
    ?element pair:containsDataCategory ?categoryIri .
    OPTIONAL {
        ?element prov:qualifiedDerivation ?derivation .
        ?derivation pair:derivedCategory ?categoryIri ;
            prov:entity ?upstream .
        OPTIONAL { ?derivation prov:hadActivity ?step }
        OPTIONAL { ?derivation rdfs:label ?derivationLabel }
    }
    BIND(REPLACE(STR(?element), "^.*[#/]", "") AS ?elementName)
    BIND(REPLACE(STR(?categoryIri), "^.*[#/]", "") AS ?category)
    BIND(REPLACE(STR(?upstream), "^.*[#/]", "") AS ?derivedFrom)
    BIND(REPLACE(STR(?step), "^.*[#/]", "") AS ?throughStep)
    BIND(IF(BOUND(?derivation),
            COALESCE(?derivationLabel, "derived along the flow"),
            "annotated on the element") AS ?how)
}
ORDER BY ?elementName ?category ?how
