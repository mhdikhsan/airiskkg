# CQ17: Starting from an entry the library flags, which entries in other
# catalogues are reachable, and by which SKOS predicate?
# Scope: library
# Note: predicates and directions are reproduced from upstream SSSOM sets where
# one exists. A hand-asserted broadMatch was once found to be the inverse of
# upstream's curated narrowMatch, which is why direction is shown here.

PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?entryName ?predicate ?targetName ?targetCatalogue
WHERE {
    VALUES ?mappingPredicate {
        skos:exactMatch skos:closeMatch skos:broadMatch
        skos:narrowMatch skos:relatedMatch
    }
    ?pattern a pair:RiskPattern ;
        pair:mayIndicateRisk ?entry .
    ?entry ?mappingPredicate ?target .
    BIND(REPLACE(STR(?entry), "^.*[#/]", "") AS ?entryName)
    BIND(REPLACE(STR(?target), "^.*[#/]", "") AS ?targetName)
    BIND(REPLACE(STR(?target), "^(.*)[#/][^#/]*$", "$1") AS ?targetCatalogue)
    BIND(REPLACE(STR(?mappingPredicate), "^.*[#/]", "") AS ?predicate)
}
ORDER BY ?entryName ?predicate ?targetName
