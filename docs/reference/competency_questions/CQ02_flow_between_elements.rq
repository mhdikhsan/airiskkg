# CQ02: What flows through a system - which process uses or produces which
# resource, and which process informs which other process?
# Scope: architecture
# Note: beam:inform is process-to-process ordering with no resource transfer,
# not data flow. It is load-bearing: the Guardrails motif is constituted by a
# guardrail step informing a generation step.

PREFIX beam: <http://w3id.org/beam/core#>

SELECT ?sourceName ?relation ?targetName
WHERE {
    VALUES ?predicate { beam:use beam:produce beam:inform }
    ?source ?predicate ?target .
    FILTER EXISTS { ?system a beam:System ; beam:hasProcess ?source }
    BIND(REPLACE(STR(?source), "^.*[#/]", "") AS ?sourceName)
    BIND(REPLACE(STR(?target), "^.*[#/]", "") AS ?targetName)
    BIND(REPLACE(STR(?predicate), "^.*[#/]", "") AS ?relation)
}
ORDER BY ?sourceName ?relation ?targetName
