# CQ07: Which executable query implements each motif, and where does that file
# live?
# Scope: library
# Note: pair:implementationPath is a literal string, so moving a .rq means
# editing its declaration. test_library_consistency.py fails when the two drift.

PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>

SELECT ?motifName ?implementationPath
WHERE {
    ?motif a pair:GraphMotif ;
        pair:implementedBy ?oqp .
    ?oqp pair:implementationPath ?implementationPath .
    BIND(REPLACE(STR(?motif), "^.*[#/]", "") AS ?motifName)
}
ORDER BY ?motifName
