PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dpv:  <https://w3id.org/dpv#>
PREFIX bpmn: <https://sBPMN.github.io/2.0/classes#>
PREFIX bp:   <https://sBPMN.github.io/2.0/properties#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT {
    ?input pair:containsDataCategory pair:SensitiveInformation .

    ?derivation
        a prov:Derivation ;
        rdfs:label ?how ;
        prov:entity ?dataObject ;
        prov:hadActivity ?activity ;
        pair:derivedCategory pair:SensitiveInformation ;
        pair:targetInferred ?inferred .
    ?input prov:qualifiedDerivation ?derivation .
}
WHERE {
    ?activity pair:refinedBy ?system .

    {
        ?activity bp:dataInputAssociation ?association .
        ?association bp:targetRef ?activity ; bp:sourceRef ?dataReference .
        BIND(true AS ?reads)
    }
    UNION
    {
        ?activity bp:dataOutputAssociation ?association .
        ?association bp:sourceRef ?activity ; bp:targetRef ?dataReference .
    }

    # A store as well as an object.
    ?dataReference bp:dataObjectRef|bp:dataStoreRef ?dataObject .
    ?dataObject bp:itemSubjectRef ?item .
    ?item bp:structureRef ?personalDataKind .

    OPTIONAL {
        ?option pair:classifiesAs ?personalDataKind ;
                pair:meansPersonalData ?meansPersonal .
    }
   
    FILTER (COALESCE(?meansPersonal, true))

    OPTIONAL { ?dataObject pair:realisedBy ?named }
    ?system beam:hasResource ?input .
    ?input a/rdfs:subClassOf* beam:Data .

    BIND(EXISTS {
        ?system beam:hasProcess ?maker .
        ?maker beam:produce ?input .
    } AS ?madeHere)
    BIND(EXISTS {
        ?system beam:hasProcess ?consumer .
        ?consumer beam:use ?input .
    } AS ?readHere)

    FILTER (IF(BOUND(?named), ?input = ?named,
               IF(BOUND(?reads), !?madeHere, !?readHere)))

    BIND(!BOUND(?named) AS ?inferred)
    BIND(IF(BOUND(?named),
            STRLANG("Personal data declared on the business process, on the named element", "en"),
            STRLANG("Personal data declared on the business process, matched to this element by flow", "en"))
         AS ?how)

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/derivation/business-data/",
        ENCODE_FOR_URI(STR(?input)), "/",
        ENCODE_FOR_URI(STR(?dataObject))
    )) AS ?derivation)
}
