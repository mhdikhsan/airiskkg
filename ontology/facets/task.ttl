@prefix task: <http://w3id.org/airiskkg/facets/task#> .
@prefix ai:   <https://w3id.org/dpv/ai#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .

<http://w3id.org/airiskkg/facets/task>
    a owl:Ontology ;
    dct:title "PAIR-AI Characterization Facet: AI Task"@en ;
    dct:description "SKOS concept scheme implementing the PAIR-AI unified task taxonomy: the functional input-to-output relation performed by a functional unit (Rule R1). Assigned via facet:hasTaskCategory. Rule R7: Task, Capability (VAIR), and Application Type (OECD) are three separate axes, SKOS-mapped, never merged. NOTE: no mapping to the TUEV AI.ST taxonomy is included; its license/citability is unverified (on hold)."@en ;
    dct:source "PAIR-AI unified task taxonomy (expert curation); OECD (2022). OECD Framework for the Classification of AI Systems (Task & Output dimension)." ;
    dct:source <https://w3id.org/dpv/ai> ;
    vann:preferredNamespacePrefix "task" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/facets/task#" .

task:AITask
    a skos:ConceptScheme ;
    skos:prefLabel "AI Task"@en ;
    skos:definition "Unified taxonomy of AI tasks: the functional input-to-output relation of a functional unit within the system (compositional; distinct from capability and application type, Rule R7). Concepts are SKOS-mapped to DPV AI extension Capability concepts (https://w3id.org/dpv/ai#, verified against DPV v2.3, 2026-07-15) where a counterpart exists - mapped, never merged (Rule R7: DPV ai:Capability is a neighboring axis, the mappings are interoperability links, not identity)."@en ;
    skos:relatedMatch ai:Capability ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." .

# --- Top level ------------------------------------------------------------
# Second-level concepts below are curated placeholders: the authoritative
# second level of the unified task taxonomy is not yet in this repository.
# TODO: reconcile with the paper's task taxonomy table before freeze.
# TODO: skos:broadMatch / skos:relatedMatch toward OECD task categories
# (recognition, event detection, forecasting, personalisation, interaction
# support, goal-driven optimisation, reasoning with knowledge structures)
# once resolvable OECD URIs exist.
# DPV AI extension mappings added where verified (2026-07-15). No DPV AI
# counterpart exists for: Recommendation, Forecasting, Anomaly Detection,
# Code Generation, Embedding Computation - left unmapped, do not force.

task:PerceptionAndRecognition
    a skos:Concept ;
    skos:inScheme task:AITask ;
    skos:topConceptOf task:AITask ;
    skos:prefLabel "Perception and Recognition"@en ;
    skos:definition "Recognizing patterns, objects, or structure in unstructured input signals (images, audio, text, sensor data)."@en ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:relatedMatch ai:PatternRecognition ;
    skos:narrower task:ImageClassification , task:ObjectDetection , task:SpeechRecognition , task:NamedEntityRecognition .
    # TODO: skos:broadMatch toward OECD "Recognition" task category.

task:ImageClassification a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:PerceptionAndRecognition ;
    skos:prefLabel "Image Classification"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:closeMatch ai:ImageClassification .
task:ObjectDetection a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:PerceptionAndRecognition ;
    skos:prefLabel "Object Detection"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:closeMatch ai:ObjectDetection .
task:SpeechRecognition a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:PerceptionAndRecognition ;
    skos:prefLabel "Speech Recognition"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:closeMatch ai:SpeechRecognition .
task:NamedEntityRecognition a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:PerceptionAndRecognition ;
    skos:prefLabel "Named Entity Recognition"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:closeMatch ai:NamedEntityRecognition .

task:RetrievalAndRanking
    a skos:Concept ;
    skos:inScheme task:AITask ;
    skos:topConceptOf task:AITask ;
    skos:prefLabel "Retrieval and Ranking"@en ;
    skos:definition "Finding and ordering relevant items from a collection given an information need (search, retrieval, reranking)."@en ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:closeMatch ai:InformationRetrieval ;
    skos:narrower task:DocumentRetrieval , task:VectorSimilaritySearch , task:Reranking , task:QueryReformulation .

task:DocumentRetrieval a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:RetrievalAndRanking ;
    skos:prefLabel "Document Retrieval"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .
task:VectorSimilaritySearch a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:RetrievalAndRanking ;
    skos:prefLabel "Vector Similarity Search"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .
task:Reranking a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:RetrievalAndRanking ;
    skos:prefLabel "Reranking"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .
task:QueryReformulation a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:RetrievalAndRanking ;
    skos:prefLabel "Query Reformulation"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .

task:PredictionAndForecasting
    a skos:Concept ;
    skos:inScheme task:AITask ;
    skos:topConceptOf task:AITask ;
    skos:prefLabel "Prediction and Forecasting"@en ;
    skos:definition "Estimating unknown values or future states from historical or contextual data."@en ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:narrower task:Regression , task:Classification , task:TimeSeriesForecasting .
    # TODO: skos:broadMatch toward OECD "Forecasting" task category.

task:Regression a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:PredictionAndForecasting ;
    skos:prefLabel "Regression"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .
task:Classification a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:PredictionAndForecasting ;
    skos:prefLabel "Classification"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .
task:TimeSeriesForecasting a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:PredictionAndForecasting ;
    skos:prefLabel "Time Series Forecasting"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .

task:AnomalyAndEventDetection
    a skos:Concept ;
    skos:inScheme task:AITask ;
    skos:topConceptOf task:AITask ;
    skos:prefLabel "Anomaly and Event Detection"@en ;
    skos:definition "Detecting deviations, events, or state changes in data streams or collections."@en ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:narrower task:OutlierDetection , task:DriftDetection , task:FraudDetection .
    # TODO: skos:broadMatch toward OECD "Event detection" task category.

task:OutlierDetection a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:AnomalyAndEventDetection ;
    skos:prefLabel "Outlier Detection"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .
task:DriftDetection a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:AnomalyAndEventDetection ;
    skos:prefLabel "Drift Detection"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .
task:FraudDetection a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:AnomalyAndEventDetection ;
    skos:prefLabel "Fraud Detection"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .

task:GenerationAndTransformation
    a skos:Concept ;
    skos:inScheme task:AITask ;
    skos:topConceptOf task:AITask ;
    skos:prefLabel "Generation and Transformation"@en ;
    skos:definition "Producing new content or transforming content between forms (text, code, images, audio, translations, summaries)."@en ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:relatedMatch ai:ContentGeneration ;
    skos:narrower task:TextGeneration , task:Summarization , task:Translation , task:CodeGeneration , task:ImageGeneration , task:EmbeddingComputation .

task:TextGeneration a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:GenerationAndTransformation ;
    skos:prefLabel "Text Generation"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:closeMatch ai:NaturalLanguageGeneration .
task:Summarization a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:GenerationAndTransformation ;
    skos:prefLabel "Summarization"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:closeMatch ai:AutomaticSummarisation .
task:Translation a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:GenerationAndTransformation ;
    skos:prefLabel "Translation"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:closeMatch ai:MachineTranslation .
task:CodeGeneration a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:GenerationAndTransformation ;
    skos:prefLabel "Code Generation"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .
task:ImageGeneration a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:GenerationAndTransformation ;
    skos:prefLabel "Image Generation"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:closeMatch ai:ImageGeneration .
task:EmbeddingComputation a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:GenerationAndTransformation ;
    skos:prefLabel "Embedding Computation"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .

task:DecisionOptimizationControl
    a skos:Concept ;
    skos:inScheme task:AITask ;
    skos:topConceptOf task:AITask ;
    skos:prefLabel "Decision, Optimization, and Control"@en ;
    skos:definition "Selecting actions, allocating resources, or controlling processes toward goals under constraints."@en ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:narrower task:DecisionSupport , task:ResourceOptimization , task:ProcessControl .
    # TODO: skos:broadMatch toward OECD "Goal-driven optimisation" task category.

task:DecisionSupport a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:DecisionOptimizationControl ;
    skos:prefLabel "Decision Support"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .
task:ResourceOptimization a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:DecisionOptimizationControl ;
    skos:prefLabel "Resource Optimization"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .
task:ProcessControl a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:DecisionOptimizationControl ;
    skos:prefLabel "Process Control"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .

task:ReasoningOverKnowledge
    a skos:Concept ;
    skos:inScheme task:AITask ;
    skos:topConceptOf task:AITask ;
    skos:prefLabel "Reasoning over Knowledge"@en ;
    skos:definition "Deriving conclusions from structured knowledge (ontologies, knowledge graphs, rules) or combining knowledge with learned models."@en ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:narrower task:DeductiveReasoning , task:KnowledgeGraphCompletion , task:QuestionAnsweringOverKnowledge .
    # TODO: skos:broadMatch toward OECD "Reasoning with knowledge structures" task category.

task:DeductiveReasoning a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:ReasoningOverKnowledge ;
    skos:prefLabel "Deductive Reasoning"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .
task:KnowledgeGraphCompletion a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:ReasoningOverKnowledge ;
    skos:prefLabel "Knowledge Graph Completion"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .
task:QuestionAnsweringOverKnowledge a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:ReasoningOverKnowledge ;
    skos:prefLabel "Question Answering over Knowledge"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:broadMatch ai:QuestionAnswering .

task:InteractionAndDialogue
    a skos:Concept ;
    skos:inScheme task:AITask ;
    skos:topConceptOf task:AITask ;
    skos:prefLabel "Interaction and Dialogue"@en ;
    skos:definition "Conducting multi-turn interaction with users or other agents in natural language or other modalities."@en ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:relatedMatch ai:DialogueManagement ;
    skos:narrower task:ConversationalAssistance , task:TaskOrientedDialogue , task:AgentToolUse .
    # TODO: skos:broadMatch toward OECD "Interaction support" task category.

task:ConversationalAssistance a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:InteractionAndDialogue ;
    skos:prefLabel "Conversational Assistance"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:closeMatch ai:ChatbotCapability .
task:TaskOrientedDialogue a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:InteractionAndDialogue ;
    skos:prefLabel "Task-Oriented Dialogue"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .
task:AgentToolUse a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:InteractionAndDialogue ;
    skos:prefLabel "Agent Tool Use"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .

task:PersonalizationAndProfiling
    a skos:Concept ;
    skos:inScheme task:AITask ;
    skos:topConceptOf task:AITask ;
    skos:prefLabel "Personalization and Profiling"@en ;
    skos:definition "Adapting outputs to individuals or groups based on inferred characteristics, preferences, or behavior."@en ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:relatedMatch ai:Profiling ;
    skos:narrower task:Recommendation , task:UserProfiling , task:ContentPersonalization .
    # TODO: skos:broadMatch toward OECD "Personalisation" task category.

task:Recommendation a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:PersonalizationAndProfiling ;
    skos:prefLabel "Recommendation"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .
task:UserProfiling a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:PersonalizationAndProfiling ;
    skos:closeMatch ai:Profiling ;
    skos:prefLabel "User Profiling"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .
task:ContentPersonalization a skos:Concept ; skos:inScheme task:AITask ; skos:broader task:PersonalizationAndProfiling ;
    skos:prefLabel "Content Personalization"@en ; dct:source "PAIR-AI unified task taxonomy (expert curation)." .
