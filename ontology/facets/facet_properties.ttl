@prefix facet: <http://w3id.org/airiskkg/facets#> .
@prefix beam:  <http://w3id.org/beam/core#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann:  <http://purl.org/vocab/vann/> .

<http://w3id.org/airiskkg/facets>
    a owl:Ontology ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:title "PAIR-AI Characterization Facet Attachment Properties"@en ;
    dct:description "Object properties attaching characterization facet values (SKOS concepts) to BEAM architecture elements."@en ;
    vann:preferredNamespacePrefix "facet" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/facets#" ;
    owl:imports <http://w3id.org/beam/core#> .

facet:hasAutonomyLevel a owl:ObjectProperty ;
    rdfs:label "has autonomy level"@en ;
    rdfs:comment "Intended values: concepts of the aut:AutonomyLevel scheme."@en ;
    rdfs:domain beam:System ;
    rdfs:range skos:Concept .

facet:hasDataProvenance a owl:ObjectProperty ;
    rdfs:label "has data provenance"@en ;
    rdfs:comment "Intended values: concepts of the dataf:DataProvenance scheme."@en ;
    rdfs:domain beam:Data ;
    rdfs:range skos:Concept .

facet:hasDataDynamism a owl:ObjectProperty ;
    rdfs:label "has data dynamism"@en ;
    rdfs:comment "Intended values: concepts of the dataf:DataDynamism scheme."@en ;
    rdfs:domain beam:Data ;
    rdfs:range skos:Concept .

facet:hasPersonalDataCategory a owl:ObjectProperty ;
    rdfs:label "has personal data category"@en ;
    rdfs:comment "Kind of (non-)personal data an element contains, expressed directly as DPV concepts."@en ;
    rdfs:domain beam:Data ;
    rdfs:range skos:Concept ;
    dct:source <https://w3id.org/dpv/2.3/modules/personal_data> .

facet:hasIdentifiabilityLevel a owl:ObjectProperty ;
    rdfs:subPropertyOf facet:hasPersonalDataCategory ;
    rdfs:label "has identifiability level"@en ;
    rdfs:comment "Degree of identifiability of the data with respect to natural persons."@en ;
    rdfs:domain beam:Data ;
    rdfs:range skos:Concept ;
    dct:source <https://w3id.org/dpv/2.3/modules/personal_data> .

facet:hasDataRights a owl:ObjectProperty ;
    rdfs:label "has data rights"@en ;
    rdfs:comment "Intended values: concepts of the dataf:DataRights scheme."@en ;
    rdfs:domain beam:Data ;
    rdfs:range skos:Concept .

facet:hasImplementationType a owl:ObjectProperty ;
    rdfs:label "has implementation type"@en ;
    rdfs:comment "Intended values: concepts of the impl:ImplementationType scheme."@en ;
    rdfs:domain beam:Model ;
    rdfs:range skos:Concept .

facet:hasTaskCategory a owl:ObjectProperty ;
    rdfs:label "has task category"@en ;
    rdfs:comment "Intended values: concepts of the task:AITask scheme."@en ;
    rdfs:domain beam:Task ;
    rdfs:range skos:Concept .

facet:hasDomain a owl:ObjectProperty ;
    rdfs:label "has domain"@en ;
    rdfs:comment "Intended values: DPV sector concepts, assigned directly."@en ;
    rdfs:domain beam:System ;
    rdfs:range skos:Concept ;
    dct:source <https://w3id.org/dpv/sector> .

facet:hasPurpose a owl:ObjectProperty ;
    rdfs:label "has purpose"@en ;
    rdfs:comment "Intended values: DPV purpose concepts or concepts of the ctx:Purpose scheme."@en ;
    rdfs:domain beam:System ;
    rdfs:range skos:Concept .
