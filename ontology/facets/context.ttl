@prefix ctx:  <http://w3id.org/airiskkg/facets/context#> .
@prefix dpv:  <https://w3id.org/dpv#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .

<http://w3id.org/airiskkg/facets/context>
    a owl:Ontology ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:title "PAIR-AI Characterization Facets: Context (Domain, Purpose)"@en ;
    dct:description "SKOS concept schemes for the situational context of an AI system. Both are deliberately empty extension points anchored to DPV: concrete values are DPV URIs used directly, not local concepts (Rule R3)."@en ;
    dct:source <https://w3id.org/dpv> ;
    vann:preferredNamespacePrefix "ctx" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/facets/context#" .

# Scheme 1: Domain (extension point, anchored to DPV sectors)

ctx:Domain
    a skos:ConceptScheme ;
    skos:prefLabel "Domain"@en ;
    skos:definition "Application domain / economic sector in which the AI system operates (e.g. healthcare, finance, education). Assign DPV sector concepts directly."@en ;
    skos:relatedMatch dpv:Sector ;
    rdfs:seeAlso <https://w3id.org/dpv/sector> ;
    dct:source <https://w3id.org/dpv> .

# Scheme 2: Purpose (extension point, anchored to DPV)

ctx:Purpose
    a skos:ConceptScheme ;
    skos:prefLabel "Purpose"@en ;
    skos:definition "Purpose for which the AI system (or a processing step) is operated. Assign DPV purpose concepts directly."@en ;
    skos:exactMatch dpv:Purpose ;
    dct:source <https://w3id.org/dpv> .
