@prefix impl: <http://w3id.org/airiskkg/facets/implementation-type#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .

<http://w3id.org/airiskkg/facets/implementation-type>
    a owl:Ontology ;
    dct:title "PAIR-AI Characterization Facet: Implementation Type"@en ;
    dct:description "SKOS concept scheme (extension point) classifying HOW a model is implemented (e.g. architecture family, hosting form). This is the facet counterpart to the deliberate absence of beam:Model subclasses beyond Semantic/Statistical (Rule R1 + Task 4 decision: implementation types are classification values, not query-traversed structure). Assigned via facet:hasImplementationType; read by applicability conditions only (Rule R2)."@en ;
    dct:source "PAIR-AI glossary v1.1, Section A.3 (Implementation Type listed as characterization facet)" ;
    vann:preferredNamespacePrefix "impl" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/facets/implementation-type#" .

impl:ImplementationType
    a skos:ConceptScheme ;
    skos:prefLabel "Implementation Type"@en ;
    skos:definition "Classification of a model's implementation: architecture family, technique, or hosting form. Extension point: concrete values are added per use case or when the paper's implementation-type taxonomy is settled."@en ;
    dct:source "PAIR-AI glossary v1.1, Section A.3" .
    # TODO: populate with the agreed implementation-type taxonomy (e.g.
    # architecture families such as transformer/diffusion/rule-based, or
    # hosting forms such as provider-hosted/self-hosted) once decided.
    # Candidate external anchors: Tool4Boxology model subclasses
    # (t4b:NeuralNetwork, t4b:Transformer, ...) via skos:exactMatch - do not
    # copy them as BEAM classes (Rule R5 / Task 4 decision).
