@prefix impl: <http://w3id.org/airiskkg/facets/implementation-type#> .
@prefix ai:   <https://w3id.org/dpv/ai#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .

<http://w3id.org/airiskkg/facets/implementation-type>
    a owl:Ontology ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:title "PAIR-AI Characterization Facet: Implementation Type"@en ;
    dct:description "SKOS concept scheme classifying HOW a model is implemented: architecture family or learning technique. Assigned to beam:Model via facet:hasImplementationType. Values are DPV AI extension technique concepts, used directly."@en ;
    dct:source <https://w3id.org/dpv/ai> ;
    vann:preferredNamespacePrefix "impl" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/facets/implementation-type#" .

impl:ImplementationType
    a skos:ConceptScheme , skos:Collection ;
    skos:prefLabel "Implementation Type"@en ;
    skos:definition "Classification of a model's implementation: architecture family or learning technique. Values are DPV AI extension concepts assigned directly; this scheme is the anchor and the value list, not a source of local terms."@en ;
    skos:relatedMatch ai:Technique ;
    dct:source <https://w3id.org/dpv/ai> ;
    # Architecture families
    skos:member ai:NeuralNetwork ,
                ai:ConvolutionalNeuralNetwork ,
                ai:RecurrentNeuralNetwork ,
                ai:BayesianNetwork ,
                ai:SupportVectorMachine ,
                ai:DecisionTree ,
                ai:LLM ;
    # Learning techniques
    skos:member ai:MachineLearning ,
                ai:DeepLearning ,
                ai:SupervisedLearning ,
                ai:UnsupervisedLearning ,
                ai:SelfSupervisedLearning ,
                ai:ReinforcementLearning ,
                ai:TransferLearning ;
    # Symbolic / non-learned
    skos:member ai:RuleBasedTechnique ,
                ai:SymbolicReasoning .
