@prefix dataf: <http://w3id.org/airiskkg/facets/data#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann:  <http://purl.org/vocab/vann/> .

<http://w3id.org/airiskkg/facets/data>
    a owl:Ontology ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:title "PAIR-AI Characterization Facets: Data Provenance, Dynamism, Rights"@en ;
    dct:description "SKOS concept schemes classifying data resources of an AI system. Assigned to beam:Data via facet:hasDataProvenance / hasDataDynamism / hasDataRights."@en ;
    dct:source <https://w3id.org/dpv> ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems. OECD Digital Economy Papers, No. 323. https://doi.org/10.1787/cb6d9eca-en" ;
    vann:preferredNamespacePrefix "dataf" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/facets/data#" .

# Scheme 1: Data Provenance

dataf:DataProvenance
    a skos:ConceptScheme ;
    skos:prefLabel "Data Provenance"@en ;
    skos:definition "Origin of the data used or produced by the system: how the data came into existence relative to the system and its stakeholders."@en ;
    rdfs:seeAlso <https://w3id.org/dpv#Data> ;
    dct:source <https://w3id.org/dpv> .

dataf:ProvidedData
    a skos:Concept ;
    skos:inScheme dataf:DataProvenance ;
    skos:topConceptOf dataf:DataProvenance ;
    skos:prefLabel "Provided Data"@en ;
    skos:definition "Data deliberately provided by data subjects or users (e.g. form input, uploads, user prompts)."@en ;
    skos:closeMatch dpv:ProvidedData ;
    dct:source <https://w3id.org/dpv> .

dataf:ObservedData
    a skos:Concept ;
    skos:inScheme dataf:DataProvenance ;
    skos:topConceptOf dataf:DataProvenance ;
    skos:prefLabel "Observed Data"@en ;
    skos:definition "Data captured by observing behavior or the environment (e.g. logs, sensor readings, click streams), not deliberately provided."@en ;
    skos:closeMatch dpv:ObservedData ;
    dct:source <https://w3id.org/dpv> .

dataf:SyntheticData
    a skos:Concept ;
    skos:inScheme dataf:DataProvenance ;
    skos:topConceptOf dataf:DataProvenance ;
    skos:prefLabel "Synthetic Data"@en ;
    skos:definition "Artificially generated data (e.g. simulation output, generative-model output used as data)."@en ;
    skos:closeMatch dpv:SyntheticData ;
    dct:source <https://w3id.org/dpv> .

dataf:DerivedData
    a skos:Concept ;
    skos:inScheme dataf:DataProvenance ;
    skos:topConceptOf dataf:DataProvenance ;
    skos:prefLabel "Derived Data"@en ;
    skos:definition "Data produced from other data by processing, aggregation, or inference (e.g. embeddings, features, profiles)."@en ;
    skos:closeMatch dpv:DerivedData ;
    dct:source <https://w3id.org/dpv> .

dataf:ExpertInput
    a skos:Concept ;
    skos:inScheme dataf:DataProvenance ;
    skos:topConceptOf dataf:DataProvenance ;
    skos:prefLabel "Expert Input"@en ;
    skos:definition "Data encoding human expert knowledge (e.g. rules, labels, curated knowledge) provided by domain experts."@en .

dataf:DataDynamism
    a skos:ConceptScheme ;
    skos:prefLabel "Data Dynamism"@en ;
    skos:definition "Update behavior of a data resource: whether and how it changes after system deployment."@en .

dataf:Static
    a skos:Concept ;
    skos:inScheme dataf:DataDynamism ;
    skos:topConceptOf dataf:DataDynamism ;
    skos:prefLabel "Static"@en ;
    skos:definition "The data resource is fixed after creation; it does not change during operation."@en.

dataf:PeriodicallyUpdated
    a skos:Concept ;
    skos:inScheme dataf:DataDynamism ;
    skos:topConceptOf dataf:DataDynamism ;
    skos:prefLabel "Periodically Updated"@en ;
    skos:definition "The data resource is refreshed at discrete intervals (e.g. nightly re-indexing, scheduled retraining data pulls)."@en .

dataf:RealTimeUpdated
    a skos:Concept ;
    skos:inScheme dataf:DataDynamism ;
    skos:topConceptOf dataf:DataDynamism ;
    skos:prefLabel "Real-Time Updated"@en ;
    skos:definition "The data resource changes continuously during operation"@en .

dataf:DataRights
    a skos:ConceptScheme ;
    skos:prefLabel "Data Rights"@en ;
    skos:definition "Rights and ownership status of a data resource, constraining how it may be used."@en .

dataf:Personal
    a skos:Concept ;
    skos:inScheme dataf:DataRights ;
    skos:topConceptOf dataf:DataRights ;
    skos:prefLabel "Personal"@en ;
    skos:definition "Data relating to identified or identifiable natural persons, subject to data-protection law."@en ;
    skos:relatedMatch dpv:PersonalData  .

dataf:Proprietary
    a skos:Concept ;
    skos:inScheme dataf:DataRights ;
    skos:topConceptOf dataf:DataRights ;
    skos:prefLabel "Proprietary"@en ;
    skos:definition "Data owned or licensed by an organization with restricted use rights."@en .

dataf:Public
    a skos:Concept ;
    skos:inScheme dataf:DataRights ;
    skos:topConceptOf dataf:DataRights ;
    skos:prefLabel "Public"@en ;
    skos:definition "Data available for public use, subject to its license terms."@en .
