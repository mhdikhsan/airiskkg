@prefix t4b:  <http://tool4boxology.org/> .
@prefix beam: <http://w3id.org/beam/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .

<http://w3id.org/airiskkg/alignments/tool4boxology>
    a owl:Ontology ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:title "Tool4Boxology to BEAM Alignment Adapter"@en ;
    dct:description """
    Alignment adapter normalizing Tool4Boxology architecture exports into BEAM,
    the canonical internal model of PAIR-AI.
    """@en ;
    dct:source <https://github.com/SDM-TIB/Tool4Boxology> ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-032-25159-6_11> ;
    vann:preferredNamespacePrefix "t4b" ;
    owl:imports <http://w3id.org/beam/core#> .


t4b:inputRoleParticipatesInProcess
    rdfs:subPropertyOf beam:usedBy ;
    rdfs:comment "An input artifact participates in (is used by) a process."@en .

t4b:outputRoleParticipatesInProcess
    rdfs:subPropertyOf beam:produce ;
    rdfs:comment "A process produces an output artifact."@en .

# Class alignments

t4b:Data rdfs:subClassOf beam:Data ;
    rdfs:comment "Tool4Boxology data artifact aligned to BEAM Data."@en .

t4b:Symbol rdfs:subClassOf beam:Symbol ;
    rdfs:comment "Tool4Boxology symbol artifact aligned to BEAM Symbol."@en .

t4b:Model rdfs:subClassOf beam:Model ;
    rdfs:comment "Tool4Boxology model aligned to BEAM Model."@en .

t4b:SemanticModel rdfs:subClassOf beam:SemanticModel ;
    rdfs:comment "Tool4Boxology semantic model aligned to BEAM SemanticModel."@en .

t4b:Actor rdfs:subClassOf beam:Agent ;
    rdfs:comment "Tool4Boxology actor aligned to BEAM Agent (both anchor to easy-ai Actor)."@en .

t4b:Train rdfs:subClassOf beam:Train ;
    rdfs:comment "Tool4Boxology training process aligned to BEAM Train."@en .

t4b:Transform rdfs:subClassOf beam:Transform ;
    rdfs:comment "Tool4Boxology transform process aligned to BEAM Transform."@en .

t4b:Infer rdfs:subClassOf beam:Infer ;
    rdfs:comment "Tool4Boxology inference process aligned to BEAM Infer."@en .

t4b:Generate rdfs:subClassOf beam:Generate ;
    rdfs:comment "Tool4Boxology generation process aligned to BEAM Generate."@en .

t4b:Deduce rdfs:subClassOf beam:Infer ;
    rdfs:comment "Notes: t4b:Deduce has no direct BEAM equivalent; mapped to beam:Infer as the closest process type"@en .

t4b:Embed rdfs:subClassOf beam:Transform ;
    rdfs:comment "Notes: t4b:Embed has no direct BEAM equivalent; mapped to beam:Transform."@en .

t4b:StatisticalModel rdfs:subClassOf beam:StatisticalModel ;
    rdfs:comment "Notes: not in the originally agreed alignment list, but a verified t4b ontology class with an exact BEAM counterpart; added so statistical models normalize to a BEAM leaf type."@en .

