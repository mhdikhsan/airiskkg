@prefix dpv:  <https://w3id.org/dpv#> .
@prefix beam: <http://w3id.org/beam/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .

<http://w3id.org/airiskkg/alignments/dpv>
    a owl:Ontology ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:title "DPV to BEAM Entity Alignment"@en ;
    dct:description """
    Alignment anchoring beam:Agent to DPV's entity vocabulary via
    rdfs:subClassOf. """@en ;
    dct:source <https://w3id.org/dpv> ;
    rdfs:seeAlso <https://w3c-cg.github.io/dpv/2.3/dpv/> ;
    vann:preferredNamespacePrefix "dpv" ;
    owl:imports <http://w3id.org/beam/core#> .

# -Class alignment (verified against DPV v2.3) 

beam:Agent rdfs:subClassOf dpv:Entity ;
    rdfs:comment "BEAM Agent aligned to DPV's Entity class "@en .
