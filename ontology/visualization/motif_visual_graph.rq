PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX pair:   <http://w3id.org/airiskkg/pair-ai#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
  ?motif a pair:GraphMotif ;
         rdfs:label ?motifLabel ;
         pair:hasPatternNode ?node ;
         pair:hasPatternEdge ?edge ;
         pair:implementedBy ?motifImplementation ;
         pair:hasRiskPattern ?riskPattern .

  ?node rdfs:label ?nodeLabel ;
        pair:expectedClass ?expectedClass ;
        pair:expectedRole ?expectedRole .

  ?edge rdfs:label ?edgeLabel ;
        pair:sourcePatternNode ?sourceNode ;
        pair:patternPredicate ?predicate ;
        pair:targetPatternNode ?targetNode .

  ?motifImplementation rdfs:label ?motifImplementationLabel ;
                       pair:implementationPath ?motifImplementationPath ;
                       pair:producesOutputType ?motifOutputType .

  ?riskPattern rdfs:label ?riskPatternLabel ;
                  pair:implementedBy ?riskPatternImplementation ;
                  pair:hasMechanism ?mechanism ;
                  pair:mayIndicateRisk ?risk ;
                  pair:suggestedControl ?control ;
                  pair:hasApplicabilityCondition ?condition .

  ?riskPatternImplementation rdfs:label ?riskPatternImplementationLabel ;
                                pair:implementationPath ?riskPatternImplementationPath ;
                                pair:producesOutputType ?riskPatternOutputType ;
                                pair:implementsRiskPattern ?riskPattern .

  ?mechanism rdfs:label ?mechanismLabel .
  ?risk skos:prefLabel ?riskLabel .
  ?control skos:prefLabel ?controlLabel .
  ?condition rdfs:label ?conditionLabel .
}
WHERE {
  ?motif a pair:GraphMotif .
  OPTIONAL { ?motif rdfs:label ?motifLabel . }

  OPTIONAL {
    ?motif pair:hasPatternNode ?node .
    OPTIONAL { ?node rdfs:label ?nodeLabel . }
    OPTIONAL { ?node pair:expectedClass ?expectedClass . }
    OPTIONAL { ?node pair:expectedRole ?expectedRole . }
  }

  OPTIONAL {
    ?motif pair:hasPatternEdge ?edge .
    OPTIONAL { ?edge rdfs:label ?edgeLabel . }
    OPTIONAL { ?edge pair:sourcePatternNode ?sourceNode . }
    OPTIONAL { ?edge pair:patternPredicate ?predicate . }
    OPTIONAL { ?edge pair:targetPatternNode ?targetNode . }
  }

  OPTIONAL {
    ?motif pair:implementedBy ?motifImplementation .
    OPTIONAL { ?motifImplementation rdfs:label ?motifImplementationLabel . }
    OPTIONAL { ?motifImplementation pair:implementationPath ?motifImplementationPath . }
    OPTIONAL { ?motifImplementation pair:producesOutputType ?motifOutputType . }
  }

  OPTIONAL {
    ?motif pair:hasRiskPattern ?riskPattern .
    OPTIONAL { ?riskPattern rdfs:label ?riskPatternLabel . }
    OPTIONAL {
      ?riskPattern pair:hasMechanism ?mechanism .
      OPTIONAL { ?mechanism rdfs:label ?mechanismLabel . }
    }
    OPTIONAL {
      ?riskPattern pair:mayIndicateRisk ?risk .
      OPTIONAL { ?risk skos:prefLabel ?riskLabel . }
    }
    OPTIONAL {
      ?riskPattern pair:suggestedControl ?control .
      OPTIONAL { ?control skos:prefLabel ?controlLabel . }
    }
    OPTIONAL {
      ?riskPattern pair:hasApplicabilityCondition ?condition .
      OPTIONAL { ?condition rdfs:label ?conditionLabel . }
    }
    OPTIONAL {
      ?riskPattern pair:implementedBy ?riskPatternImplementation .
      OPTIONAL { ?riskPatternImplementation rdfs:label ?riskPatternImplementationLabel . }
      OPTIONAL { ?riskPatternImplementation pair:implementationPath ?riskPatternImplementationPath . }
      OPTIONAL { ?riskPatternImplementation pair:producesOutputType ?riskPatternOutputType . }
    }
  }
}
