# ML system design motifs derived from the training design patterns



















pat:PipelineTrainingMotif
    a pair:GraphMotif ;
    pair:implementedBy pat:PipeTrain_MatchingOQP ;
    rdfs:label "Pipeline Training Motif"@en ;
    dct:description "Preprocessing, training and evaluation run as separate steps, each reading what the previous one produced: prepared data, then a model artifact."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Training-patterns/Pipeline-training-pattern/design_en.html> ;
    pair:derivedFrom pat:Cite_PipelineTraining ,
        pat:Cite_BatchTraining ;
    pair:hasPatternNode
        pat:PipeTrain_SourceDataNode ,
        pat:PipeTrain_PreprocessJobNode ,
        pat:PipeTrain_IntermediateDataNode ,
        pat:PipeTrain_TrainingJobNode ,
        pat:PipeTrain_ModelArtifactNode ,
        pat:PipeTrain_EvaluationJobNode ,
        pat:PipeTrain_EvaluationResultNode ;
    pair:hasPatternEdge
        pat:PipeTrain_PreprocessUsesSourceEdge ,
        pat:PipeTrain_PreprocessProducesIntermediateEdge ,
        pat:PipeTrain_TrainingUsesIntermediateEdge ,
        pat:PipeTrain_TrainingProducesModelEdge ,
        pat:PipeTrain_EvaluationUsesModelEdge ,
        pat:PipeTrain_EvaluationProducesResultEdge .

pat:PipeTrain_SourceDataNode
    a pair:PatternNode ;
    rdfs:label "Pipeline training source data"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:TrainingDataset .

pat:PipeTrain_PreprocessJobNode
    a pair:PatternNode ;
    rdfs:label "Pipeline preprocessing job"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:PreprocessingStep .

pat:PipeTrain_IntermediateDataNode
    a pair:PatternNode ;
    rdfs:label "Pipeline intermediate data"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PreprocessedData .

pat:PipeTrain_TrainingJobNode
    a pair:PatternNode ;
    rdfs:label "Pipeline training job"@en ;
    pair:expectedClass beam:Train ;
    pair:expectedRole pair:TrainingStep .

pat:PipeTrain_ModelArtifactNode
    a pair:PatternNode ;
    rdfs:label "Pipeline model artifact"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:ModelArtifact .

pat:PipeTrain_EvaluationJobNode
    a pair:PatternNode ;
    rdfs:label "Pipeline evaluation job"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:EvaluationStep .

pat:PipeTrain_EvaluationResultNode
    a pair:PatternNode ;
    rdfs:label "Pipeline evaluation result"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:EvaluationResult .

pat:PipeTrain_PreprocessUsesSourceEdge
    a pair:PatternEdge ;
    rdfs:label "pipeline preprocess uses source data"@en ;
