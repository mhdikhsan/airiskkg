pat:RetrievalAugmentedGenerationMotif
    a pair:GraphMotif ;
    rdfs:label "Retrieval Augmented Generation (RAG) Motif"@en ;
    dct:description "A retrieval step reads the user's query and a knowledge source, a prompt is built from the query and what was retrieved, and a foundation model answers it."@en ;
    rdfs:comment "Query-time RAG faithful to Martin Fowler's gen-AI patterns: the retrieval step is DRIVEN BY the user query (it beam:use-s the query) and reads a vector store (a resource under pair:VectorStore or pair:VectorIndex); retrieved context may pass through intermediate steps (reranking, aggregation) before prompt construction - RAG_PromptConstructionUsesContextEdge is path-tolerant, requiring only that the consumed context plays a role under pair:RetrievedContext. Because retrieval is query-driven over a vector store, a RAG graph also satisfies the Vector-based Information Retrieval motif. Offline document embedding/indexing is modelled separately by the Embeddings motif and is intentionally not part of this query-time motif (an earlier version wired a stand-alone query-embedding step whose output dead-ended and left retrieval disconnected from the query - removed)."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:derivedFrom pat:Cite_RetrievalAugmentedGeneration ,
        pat:Cite_AgentRetrievalAugmentedGeneration ,
        pat:Cite_NaiveRAG ;
    pair:hasPatternNode
        pat:RAG_QueryNode ,
        pat:RAG_KnowledgeSourceNode ,
        pat:RAG_RetrievalStepNode ,
        pat:RAG_RetrievedContextNode ,
        pat:RAG_PromptConstructionStepNode ,
        pat:RAG_PromptNode ,
        pat:RAG_LLMNode ,
        pat:RAG_GenerationStepNode ,
        pat:RAG_ResponseNode ;
    pair:hasPatternEdge
        pat:RAG_RetrievalUsesQueryEdge ,
        pat:RAG_RetrievalUsesVectorStoreEdge ,
        pat:RAG_RetrievalProducesContextEdge ,
        pat:RAG_PromptConstructionUsesQueryEdge ,
        pat:RAG_PromptConstructionUsesContextEdge ,
        pat:RAG_PromptConstructionProducesPromptEdge ,
        pat:RAG_GenerationUsesPromptEdge ,
        pat:RAG_GenerationUsesLLMEdge ,
        pat:RAG_GenerationProducesResponseEdge ;
    pair:implementedBy pat:RAG_MatchingOQP .

