pat:EmbeddingsMotif
    a pair:GraphMotif ;
    rdfs:label "Embeddings Motif"@en ;
    dct:description "Source documents are chunked, the chunks are embedded, and an indexing step writes the embeddings into a vector store."@en ;
    rdfs:comment "ODP reconciled to OQP behavior:the earlier declaration included an embedding-model node (pat:Embedding_ModelNode) the OQP never bound - removed. The OQP additionally matches an indexing step (uses chunk + vector, produces the index) that it does not bind as a node."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:derivedFrom pat:Cite_Embeddings ,
        pat:Cite_AgentRetrievalAugmentedGeneration ,
        pat:Cite_NaiveRAG ;
    pair:hasPatternNode
        pat:Embedding_SourceDocumentNode ,
        pat:Embedding_ChunkingStepNode ,
        pat:Embedding_DocumentChunkNode ,
        pat:Embedding_GenerationStepNode ,
        pat:Embedding_VectorNode ,
        pat:Embedding_IndexingStepNode ,
        pat:Embedding_VectorIndexNode ;
    pair:hasPatternEdge
        pat:Embedding_ChunkingUsesSourceEdge ,
        pat:Embedding_ChunkingProducesChunkEdge ,
        pat:Embedding_GenerationUsesChunkEdge ,
        pat:Embedding_GenerationProducesVectorEdge ,
        pat:Embedding_IndexingUsesChunkEdge ,
        pat:Embedding_IndexingProducesIndexEdge ,
        pat:Embedding_IndexingUsesVectorEdge ;
    pair:implementedBy pat:Embeddings_MatchingOQP .

