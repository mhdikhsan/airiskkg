pat:FineTuningMotif
    a pair:GraphMotif ;
    pair:implementedBy pat:FineTune_MatchingOQP ;
    rdfs:label "Fine Tuning Motif"@en ;
    dct:description "A fine-tuning step trains a foundation model further on a fine-tuning dataset, and an evaluation step scores the fine-tuned model."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:derivedFrom pat:Cite_FineTuning ,
        pat:Cite_PretrainFinetune ,
        pat:Cite_InstructionTuning ;
    pair:hasPatternNode
        pat:FineTune_BaseModelNode ,
        pat:FineTune_DatasetNode ,
        pat:FineTune_TrainingStepNode ,
        pat:FineTune_EvaluationStepNode ,
        pat:FineTune_EvaluationScoreNode ,
        pat:FineTune_FineTunedModelNode ;
    pair:hasPatternEdge
        pat:FineTune_TrainingUsesBaseModelEdge ,
        pat:FineTune_TrainingUsesDatasetEdge ,
        pat:FineTune_TrainingProducesModelEdge ,
        pat:FineTune_EvaluationUsesModelEdge ,
        pat:FineTune_EvaluationProducesScoreEdge .

pat:FineTune_BaseModelNode
    a pair:PatternNode ;
    rdfs:label "Fine tuning base model"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:FoundationLLM .

pat:FineTune_DatasetNode
    a pair:PatternNode ;
    rdfs:label "Fine tuning dataset"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:FineTuningDataset .

pat:FineTune_TrainingStepNode
    a pair:PatternNode ;
    rdfs:label "Fine tuning training step"@en ;
    pair:expectedClass beam:Train ;
    pair:expectedRole pair:FineTuningStep .

pat:FineTune_EvaluationStepNode
    a pair:PatternNode ;
    rdfs:label "Fine tuning evaluation step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:EvaluationStep .

pat:FineTune_EvaluationScoreNode
    a pair:PatternNode ;
    rdfs:label "Fine tuning evaluation score"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:EvaluationScore .

pat:FineTune_FineTunedModelNode
    a pair:PatternNode ;
    rdfs:label "Fine-tuned model"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:FineTunedModel .

pat:FineTune_TrainingUsesBaseModelEdge
    a pair:PatternEdge ;
    rdfs:label "fine tuning uses base model"@en ;
    pair:sourcePatternNode pat:FineTune_TrainingStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:FineTune_BaseModelNode .

pat:FineTune_TrainingUsesDatasetEdge
    a pair:PatternEdge ;
    rdfs:label "fine tuning uses dataset"@en ;
