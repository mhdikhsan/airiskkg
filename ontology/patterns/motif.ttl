pat:EmbeddingsMotif
    a pair:GraphMotif ;
    rdfs:label "Embeddings Motif"@en ;
    dct:description "GenAI motif in which source documents or data blocks are chunked and transformed into vectors stored in a vector index."@en ;
    rdfs:comment "ODP reconciled to OQP behavior:the earlier declaration included an embedding-model node (pat:Embedding_ModelNode) the OQP never bound - removed. The OQP additionally matches an indexing step (uses chunk + vector, produces the index) that it does not bind as a node."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:derivedFrom <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternNode
        pat:Embedding_SourceDocumentNode ,
        pat:Embedding_ChunkingStepNode ,
        pat:Embedding_DocumentChunkNode ,
        pat:Embedding_GenerationStepNode ,
        pat:Embedding_VectorNode ,
        pat:Embedding_VectorIndexNode ;
    pair:hasPatternEdge
        pat:Embedding_ChunkingUsesSourceEdge ,
        pat:Embedding_ChunkingProducesChunkEdge ,
        pat:Embedding_GenerationUsesChunkEdge ,
        pat:Embedding_GenerationProducesVectorEdge ,
        pat:Embedding_VectorIndexUsesVectorEdge ;
    pair:implementedBy pat:Embeddings_MatchingOQP .

pat:Embedding_SourceDocumentNode
    a pair:PatternNode ;
    rdfs:label "Embedding source document node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:SourceDocument .

pat:Embedding_ChunkingStepNode
    a pair:PatternNode ;
    rdfs:label "Document chunking step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:ChunkingStep .

pat:Embedding_DocumentChunkNode
    a pair:PatternNode ;
    rdfs:label "Document chunk node"@en ;
    rdfs:comment "The OQP identifies the chunk positionally (produced by the chunking step, used by the embedding step) without checking a role; pair:DocumentChunk is the typical annotation."@en ;
    pair:expectedClass beam:Data .

pat:Embedding_GenerationStepNode
    a pair:PatternNode ;
    rdfs:label "Embedding generation step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:EmbeddingStep .

pat:Embedding_VectorNode
    a pair:PatternNode ;
    rdfs:label "Embedding vector node"@en ;
    rdfs:comment "The OQP identifies the vector positionally (produced by the embedding step, used by the indexing step) without checking a role; pair:EmbeddingVector is the typical annotation."@en ;
    pair:expectedClass beam:Data .

pat:Embedding_VectorIndexNode
    a pair:PatternNode ;
    rdfs:label "Vector index node"@en ;
    rdfs:comment "The OQP accepts a role under pair:VectorStore OR pair:VectorIndex (a disjunction the ODP vocabulary cannot express)."@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:VectorStore .

pat:Embedding_ChunkingUsesSourceEdge
    a pair:PatternEdge ;
    rdfs:label "chunking uses source document"@en ;
    pair:sourcePatternNode pat:Embedding_ChunkingStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Embedding_SourceDocumentNode .

pat:Embedding_ChunkingProducesChunkEdge
    a pair:PatternEdge ;
    rdfs:label "chunking produces document chunk"@en ;
    pair:sourcePatternNode pat:Embedding_ChunkingStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:Embedding_DocumentChunkNode .

pat:Embedding_GenerationUsesChunkEdge
    a pair:PatternEdge ;
    rdfs:label "embedding generation uses document chunk"@en ;
    pair:sourcePatternNode pat:Embedding_GenerationStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Embedding_DocumentChunkNode .

pat:Embedding_GenerationProducesVectorEdge
    a pair:PatternEdge ;
    rdfs:label "embedding generation produces vector"@en ;
    pair:sourcePatternNode pat:Embedding_GenerationStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:Embedding_VectorNode .

pat:Embedding_VectorIndexUsesVectorEdge
    a pair:PatternEdge ;
    rdfs:label "vector index uses embedding vector"@en ;
    pair:sourcePatternNode pat:Embedding_VectorIndexNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Embedding_VectorNode .

pat:RetrievalAugmentedGenerationMotif
    a pair:GraphMotif ;
    rdfs:label "Retrieval Augmented Generation (RAG) Motif"@en ;
    dct:description "GenAI motif in which a user query is used to retrieve relevant context from a vector index (optionally via a query-embedding step), combined with the query into a prompt, and sent to an LLM to produce an answer."@en ;
    rdfs:comment "Relaxed: the query-embedding leg (RAG_QueryEmbeddingStepNode/RAG_QueryVectorNode + their edges) is OPTIONAL in the OQP, and retrieved context may pass through intermediate steps (reranking, aggregation) between the retrieval step and prompt construction - RAG_PromptConstructionUsesContextEdge is path-tolerant, requiring only that the consumed context plays a role under pair:RetrievedContext. The earlier declaration also included an embedding-model node and a phantom prompt-template INPUT node the OQP never bound - removed (the PromptTemplate role belongs to the produced prompt, pat:RAG_PromptNode)."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:derivedFrom <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternNode
        pat:RAG_QueryNode ,
        pat:RAG_QueryEmbeddingStepNode ,
        pat:RAG_QueryVectorNode ,
        pat:RAG_VectorIndexNode ,
        pat:RAG_RetrievalStepNode ,
        pat:RAG_RetrievedContextNode ,
        pat:RAG_PromptConstructionStepNode ,
        pat:RAG_PromptNode ,
        pat:RAG_LLMNode ,
        pat:RAG_GenerationStepNode ,
        pat:RAG_ResponseNode ;
    pair:hasPatternEdge
        pat:RAG_QueryEmbeddingUsesQueryEdge ,
        pat:RAG_QueryEmbeddingProducesVectorEdge ,
        pat:RAG_RetrievalUsesVectorIndexEdge ,
        pat:RAG_RetrievalProducesContextEdge ,
        pat:RAG_PromptConstructionUsesQueryEdge ,
        pat:RAG_PromptConstructionUsesContextEdge ,
        pat:RAG_PromptConstructionProducesPromptEdge ,
        pat:RAG_GenerationUsesPromptEdge ,
        pat:RAG_GenerationUsesLLMEdge ,
        pat:RAG_GenerationProducesResponseEdge ;
    pair:implementedBy pat:RAG_MatchingOQP .

pat:RAG_QueryNode
    a pair:PatternNode ;
    rdfs:label "RAG query node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

