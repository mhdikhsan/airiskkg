pat:QueryRewritingMotif
    a pair:GraphMotif ;
    rdfs:label "Query Rewriting Motif"@en ;
    dct:description "GenAI motif in which an LLM reformulates a user query into alternative queries that are then used for retrieval."@en ;
    rdfs:comment "ODP reconciled to OQP behavior:the earlier declaration included an original-query node and a rewrite-informs-retrieval edge the OQP never bound or checked - removed; the LLM node expected pair:FoundationLLM while the OQP accepts any pair:GenerativeModel."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:derivedFrom <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternNode
        pat:QueryRewrite_LLMNode ,
        pat:QueryRewrite_RewriteStepNode ,
        pat:QueryRewrite_RewrittenQueryNode ,
        pat:QueryRewrite_RetrievalStepNode ,
        pat:QueryRewrite_RetrievedContextNode ;
    pair:hasPatternEdge
        pat:QueryRewrite_RewriteUsesLLMEdge ,
        pat:QueryRewrite_RewriteProducesQueryEdge ,
        pat:QueryRewrite_RetrievalUsesRewrittenQueryEdge ,
        pat:QueryRewrite_RetrievalProducesContextEdge ;
    pair:implementedBy pat:QueryRewriting_MatchingOQP .

pat:QueryRewrite_LLMNode
    a pair:PatternNode ;
    rdfs:label "Query rewriting LLM node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:GenerativeModel .

pat:QueryRewrite_RewriteStepNode
    a pair:PatternNode ;
    rdfs:label "Query rewriting step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:QueryReformulationStep .

pat:QueryRewrite_RewrittenQueryNode
    a pair:PatternNode ;
    rdfs:label "Rewritten query node"@en ;
    rdfs:comment "The OQP checks a role under pair:UserInput (the rewritten query re-enters retrieval as a query); modelers typically ALSO tag pair:RewrittenQuery (onyx does both)."@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:QueryRewrite_RetrievalStepNode
    a pair:PatternNode ;
    rdfs:label "Retrieval using rewritten query node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:RetrievalStep .

pat:QueryRewrite_RetrievedContextNode
    a pair:PatternNode ;
    rdfs:label "Retrieved context from rewritten query node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:RetrievedContext .

pat:QueryRewrite_RewriteUsesLLMEdge
    a pair:PatternEdge ;
    rdfs:label "query rewrite uses LLM"@en ;
    pair:sourcePatternNode pat:QueryRewrite_RewriteStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:QueryRewrite_LLMNode .

pat:QueryRewrite_RewriteProducesQueryEdge
    a pair:PatternEdge ;
    rdfs:label "query rewrite produces rewritten query"@en ;
    pair:sourcePatternNode pat:QueryRewrite_RewriteStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:QueryRewrite_RewrittenQueryNode .

pat:QueryRewrite_RetrievalUsesRewrittenQueryEdge
    a pair:PatternEdge ;
    rdfs:label "retrieval uses rewritten query"@en ;
    pair:sourcePatternNode pat:QueryRewrite_RetrievalStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:QueryRewrite_RewrittenQueryNode .

pat:QueryRewrite_RetrievalProducesContextEdge
    a pair:PatternEdge ;
    rdfs:label "retrieval produces context from rewritten query"@en ;
    pair:sourcePatternNode pat:QueryRewrite_RetrievalStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:QueryRewrite_RetrievedContextNode .

pat:RerankerMotif
    a pair:GraphMotif ;
    rdfs:label "Reranker Motif"@en ;
    dct:description "GenAI motif in which a candidate set of retrieved fragments is reranked by a model so that the most useful context is passed on for generation."@en ;
    rdfs:comment "ODP reconciled to OQP behavior:the earlier declaration included a query node the OQP never bound (removed) and expected pair:RetrievedCandidateSet / pair:RerankedContext where the OQP checks pair:RetrievedContext for both candidate set and output (modelers typically ALSO tag the specific roles; onyx does both)."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:derivedFrom <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternNode
        pat:Reranker_CandidateSetNode ,
        pat:Reranker_ModelNode ,
        pat:Reranker_RerankingStepNode ,
        pat:Reranker_RankedContextNode ;
    pair:hasPatternEdge
        pat:Reranker_RerankingUsesCandidateSetEdge ,
        pat:Reranker_RerankingUsesModelEdge ,
        pat:Reranker_RerankingProducesContextEdge ;
    pair:implementedBy pat:Reranker_MatchingOQP .

pat:Reranker_CandidateSetNode
    a pair:PatternNode ;
    rdfs:label "Reranker candidate context set node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:RetrievedContext .

pat:Reranker_ModelNode
    a pair:PatternNode ;
    rdfs:label "Reranker model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:Model .

pat:Reranker_RerankingStepNode
    a pair:PatternNode ;
    rdfs:label "Reranking step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:RerankingStep .

pat:Reranker_RankedContextNode
    a pair:PatternNode ;
    rdfs:label "Reranked context node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:RetrievedContext .

pat:Reranker_RerankingUsesCandidateSetEdge
    a pair:PatternEdge ;
    rdfs:label "reranking uses candidate set"@en ;
    pair:sourcePatternNode pat:Reranker_RerankingStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Reranker_CandidateSetNode .

pat:Reranker_RerankingUsesModelEdge
    a pair:PatternEdge ;
    rdfs:label "reranking uses reranker model"@en ;
    pair:sourcePatternNode pat:Reranker_RerankingStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Reranker_ModelNode .

pat:Reranker_RerankingProducesContextEdge
    a pair:PatternEdge ;
    rdfs:label "reranking produces selected context"@en ;
    pair:sourcePatternNode pat:Reranker_RerankingStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:Reranker_RankedContextNode .

pat:GuardrailsMotif
    a pair:GraphMotif ;
    rdfs:label "Guardrails Motif"@en ;
    dct:description "GenAI motif in which input and output guardrail steps screen or sanitize user prompts and generated responses around the primary LLM generation step."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:derivedFrom <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternNode
        pat:Guardrails_UserPromptNode ,
        pat:Guardrails_InputGuardrailStepNode ,
        pat:Guardrails_InputDecisionNode ,
        pat:Guardrails_LLMNode ,
        pat:Guardrails_GenerationStepNode ,
        pat:Guardrails_RawResponseNode ,
        pat:Guardrails_OutputGuardrailStepNode ,
        pat:Guardrails_SanitizedResponseNode ;
    pair:hasPatternEdge
        pat:Guardrails_InputGuardrailUsesPromptEdge ,
        pat:Guardrails_InputGuardrailProducesDecisionEdge ,
        pat:Guardrails_InputGuardrailInformsGenerationEdge ,
        pat:Guardrails_GenerationUsesPromptEdge ,
        pat:Guardrails_GenerationUsesLLMEdge ,
        pat:Guardrails_GenerationProducesRawResponseEdge ,
        pat:Guardrails_GenerationInformsOutputGuardrailEdge ,
        pat:Guardrails_OutputGuardrailUsesRawResponseEdge ,
        pat:Guardrails_OutputGuardrailProducesSanitizedResponseEdge .

pat:Guardrails_UserPromptNode
    a pair:PatternNode ;
