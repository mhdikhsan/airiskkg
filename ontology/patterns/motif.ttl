# GenAI product motifs 

pat:DirectPromptingMotif
    a pair:GraphMotif ;
    rdfs:label "Direct Prompting Motif"@en ;   
    dct:description "A generation step puts the user's input to a generative model and produces output the user sees."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:derivedFrom pat:Cite_DirectPrompting ,
        pat:Cite_Prompting ;
    pair:hasPatternNode
        pat:DP_QueryNode ,
        pat:DP_ModelNode ,
        pat:DP_GenerationStepNode ,
        pat:DP_AnswerNode ;
    pair:hasPatternEdge
        pat:DP_GenerationUsesQueryEdge ,
        pat:DP_GenerationUsesModelEdge ,
        pat:DP_GenerationProducesAnswerEdge ;
    pair:implementedBy pat:DirectPrompting_MatchingOQP .

pat:DP_QueryNode
    a pair:PatternNode ;
    rdfs:label "Query"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:DP_ModelNode
    a pair:PatternNode ;
    rdfs:label "LLM"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:GenerativeModel .

pat:DP_GenerationStepNode
    a pair:PatternNode ;
    rdfs:label "Direct LLM generation step"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:GenerationStep .

pat:DP_AnswerNode
    a pair:PatternNode ;
    rdfs:label "Answer"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserFacingOutput .

pat:DP_GenerationUsesQueryEdge
    a pair:PatternEdge ;
    rdfs:label "direct LLM generation uses query"@en ;
    pair:sourcePatternNode pat:DP_GenerationStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:DP_QueryNode .

pat:DP_GenerationUsesModelEdge
    a pair:PatternEdge ;
    rdfs:label "direct LLM generation uses generative model"@en ;
    pair:sourcePatternNode pat:DP_GenerationStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:DP_ModelNode .

pat:DP_GenerationProducesAnswerEdge
    a pair:PatternEdge ;
    rdfs:label "direct LLM generation produces answer"@en ;
    pair:sourcePatternNode pat:DP_GenerationStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:DP_AnswerNode .

pat:PromptResponseOptimiserMotif
    a pair:GraphMotif ;
    rdfs:label "Prompt/Response Optimiser Motif"@en ;
    dct:description "An optimisation step rewrites the user's input into a prompt from a template before generation, and reworks the generated response afterwards."@en ;
    pair:derivedFrom pat:Cite_PromptResponseOptimiser ;
    pair:hasPatternNode
        pat:PromptOpt_InputNode ,
        pat:PromptOpt_TemplateNode ,
        pat:PromptOpt_OptimiserStepNode ,
        pat:PromptOpt_OptimisedPromptNode ,
        pat:PromptOpt_GenerationStepNode ,
        pat:PromptOpt_ResultNode ,
        pat:PromptOpt_ResponseNode ;
    pair:hasPatternEdge
        pat:PromptOpt_OptimiserUsesInputEdge ,
        pat:PromptOpt_OptimiserUsesTemplateEdge ,
        pat:PromptOpt_OptimiserProducesPromptEdge ,
        pat:PromptOpt_GenerationUsesPromptEdge ,
        pat:PromptOpt_GenerationProducesResultEdge ,
        pat:PromptOpt_OptimiserUsesResultEdge ,
        pat:PromptOpt_OptimiserProducesResponseEdge ;
    pair:implementedBy pat:PromptOpt_MatchingOQP .

pat:PromptOpt_InputNode
    a pair:PatternNode ;
    rdfs:label "Incoming prompt"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:PromptOpt_TemplateNode
    a pair:PatternNode ;
    rdfs:label "Prompt template"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PromptTemplate .

pat:PromptOpt_OptimiserStepNode
    a pair:PatternNode ;
    rdfs:label "Prompt/response optimiser step"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:PromptOptimisationStep .

pat:PromptOpt_OptimisedPromptNode
    a pair:PatternNode ;
    rdfs:label "Optimised prompt"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PromptTemplate .

pat:PromptOpt_GenerationStepNode
    a pair:PatternNode ;
    rdfs:label "Generation step"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:GenerationStep .

pat:PromptOpt_ResultNode
    a pair:PatternNode ;
    rdfs:label "Generated result"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:LLMResponse .

pat:PromptOpt_ResponseNode
    a pair:PatternNode ;
    rdfs:label "Optimised response"@en ;
    pair:expectedClass beam:Data .

pat:PromptOpt_OptimiserUsesInputEdge
    a pair:PatternEdge ;
    rdfs:label "optimiser uses the incoming prompt"@en ;
    pair:sourcePatternNode pat:PromptOpt_OptimiserStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:PromptOpt_InputNode .

pat:PromptOpt_OptimiserUsesTemplateEdge
    a pair:PatternEdge ;
    rdfs:label "optimiser uses the prompt template"@en ;
    pair:sourcePatternNode pat:PromptOpt_OptimiserStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:PromptOpt_TemplateNode .

pat:PromptOpt_OptimiserProducesPromptEdge
    a pair:PatternEdge ;
    rdfs:label "optimiser produces the optimised prompt"@en ;
    pair:sourcePatternNode pat:PromptOpt_OptimiserStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:PromptOpt_OptimisedPromptNode .

pat:PromptOpt_GenerationUsesPromptEdge
    a pair:PatternEdge ;
    rdfs:label "generation uses the optimised prompt"@en ;
    pair:sourcePatternNode pat:PromptOpt_GenerationStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:PromptOpt_OptimisedPromptNode .

pat:PromptOpt_GenerationProducesResultEdge
    a pair:PatternEdge ;
