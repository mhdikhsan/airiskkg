pat:ModelInImageMotif
    a pair:GraphMotif ;
    pair:implementedBy pat:ModelImage_MatchingOQP ;
    rdfs:label "Model-in-Image Motif"@en ;
    dct:description "A trained model artifact is built into a serving image, which a deployment step turns into the model a prediction step uses."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Model-in-image-pattern/design_en.html> ;
    pair:derivedFrom pat:Cite_ModelInImage ;
