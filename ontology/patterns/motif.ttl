@prefix pat:   <http://w3id.org/airiskkg/patterns#> .
@prefix pair:    <http://w3id.org/airiskkg/pair-ai#> .
@prefix beam:  <http://w3id.org/beam/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/airiskkg/patterns/motif-library#>
    a owl:Ontology ;
    dct:title "Architecture Motif Library"@en ;
    dct:description """
    Reusable architecture motifs for PAIR-AI assessment.

    Provenance: every motif cites the published design pattern it was distilled
    from (Mercari ML system design pattern catalog
    or the martinfowler.com GenAI patterns article; ExternalDependencyMotif
    derives from OWASP LLM03 scope). All cited pages were verified to
    resolve and to document the named pattern. Motif node/edge graphs are
    PAIR-AI distillations of those pattern descriptions into Boxology-style
    role and flow structure, not verbatim reproductions; role-level
    provenance is declared in pair_ai_pattern.ttl.
    """@en ;
    dct:source
        <https://mercari.github.io/ml-system-design-pattern/> ,
        <https://martinfowler.com/articles/gen-ai-patterns/> ;
    owl:imports <http://w3id.org/beam/core#> ,
                <http://w3id.org/airiskkg/pair-ai#> .


# Motif 1: Vector-based Information Retrieval
pat:VectorBasedInformationRetrievalMotif
    a pair:GraphMotif ;
    rdfs:label "Vector-based Information Retrieval Motif"@en ;
    dct:description """
    Architectural motif in which a retrieval process uses a vector store or
    knowledge source and produces a retrieved result or retrieved context.
    This is the retrieval stage of the Retrieval Augmented Generation /
    Retriever pattern, factored out as its own motif because it recurs
    without the generation leg and is the structural subject of OWASP LLM08
    (vector and embedding weaknesses).
    """@en ;
    dct:source "retrieval stage of the RAG/Retriever pattern (https://martinfowler.com/articles/gen-ai-patterns/); OWASP Top 10 for LLM Applications 2025, LLM08 (2026-07-17 audit; formerly unattributed)" ;
    pair:derivedFrom <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternNode
        pat:VectorIR_QueryNode ,
        pat:VectorIR_VectorStoreNode ,
        pat:VectorIR_RetrievalStepNode ,
        pat:VectorIR_RetrievedResultNode ;
    pair:hasPatternEdge
        pat:VectorIR_RetrievalUsesQueryEdge ,
        pat:VectorIR_RetrievalUsesVectorStoreEdge ,
        pat:VectorIR_RetrievalProducesResultEdge ;
    pair:implementedBy pat:VectorIR_MatchingOQP .

pat:VectorIR_QueryNode
    a pair:PatternNode ;
    rdfs:label "Query node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:VectorIR_VectorStoreNode
    a pair:PatternNode ;
    rdfs:label "Vector store node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:VectorStore .

pat:VectorIR_RetrievalStepNode
    a pair:PatternNode ;
    rdfs:label "Vector-based retrieval step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:RetrievalStep .

pat:VectorIR_RetrievedResultNode
    a pair:PatternNode ;
    rdfs:label "Retrieved result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:RetrievedContext .

pat:VectorIR_RetrievalUsesQueryEdge
    a pair:PatternEdge ;
    rdfs:label "retrieval uses query"@en ;
    pair:sourcePatternNode pat:VectorIR_RetrievalStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:VectorIR_QueryNode .

pat:VectorIR_RetrievalUsesVectorStoreEdge
    a pair:PatternEdge ;
    rdfs:label "retrieval uses vector store"@en ;
    pair:sourcePatternNode pat:VectorIR_RetrievalStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:VectorIR_VectorStoreNode .

pat:VectorIR_RetrievalProducesResultEdge
    a pair:PatternEdge ;
    rdfs:label "retrieval produces retrieved result"@en ;
    pair:sourcePatternNode pat:VectorIR_RetrievalStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:VectorIR_RetrievedResultNode .

# ML system design motifs: serving patterns

pat:SynchronousPredictionMotif
    a pair:GraphMotif ;
    rdfs:label "Synchronous Prediction Motif"@en ;
    dct:description "Architectural motif in which a prediction step runs inline with a request workflow and produces a result before the workflow proceeds."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Synchronous-pattern/design_en.html> ;
    pair:derivedFrom <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Synchronous-pattern/design_en.html> ;
    pair:hasPatternNode
        pat:SyncPred_RequestNode ,
        pat:SyncPred_ModelNode ,
        pat:SyncPred_PredictionStepNode ,
        pat:SyncPred_ResultNode ,
        pat:SyncPred_DownstreamStepNode ;
    pair:hasPatternEdge
        pat:SyncPred_PredictionUsesRequestEdge ,
        pat:SyncPred_PredictionUsesModelEdge ,
        pat:SyncPred_PredictionProducesResultEdge ,
        pat:SyncPred_PredictionInformsDownstreamEdge .

pat:SyncPred_RequestNode
    a pair:PatternNode ;
    rdfs:label "Synchronous prediction request node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionRequest .

pat:SyncPred_ModelNode
    a pair:PatternNode ;
    rdfs:label "Synchronous prediction model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:Model .

pat:SyncPred_PredictionStepNode
    a pair:PatternNode ;
    rdfs:label "Synchronous prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:PredictionStep .

pat:SyncPred_ResultNode
    a pair:PatternNode ;
    rdfs:label "Synchronous prediction result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionResult .

pat:SyncPred_DownstreamStepNode
    a pair:PatternNode ;
    rdfs:label "Downstream workflow step node"@en ;
    pair:expectedClass beam:Process .

pat:SyncPred_PredictionUsesRequestEdge
    a pair:PatternEdge ;
    rdfs:label "synchronous prediction uses request"@en ;
    pair:sourcePatternNode pat:SyncPred_PredictionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:SyncPred_RequestNode .

pat:SyncPred_PredictionUsesModelEdge
    a pair:PatternEdge ;
    rdfs:label "synchronous prediction uses model"@en ;
    pair:sourcePatternNode pat:SyncPred_PredictionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:SyncPred_ModelNode .

pat:SyncPred_PredictionProducesResultEdge
    a pair:PatternEdge ;
    rdfs:label "synchronous prediction produces result"@en ;
    pair:sourcePatternNode pat:SyncPred_PredictionStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:SyncPred_ResultNode .

pat:SyncPred_PredictionInformsDownstreamEdge
    a pair:PatternEdge ;
    rdfs:label "synchronous prediction informs downstream step"@en ;
    pair:sourcePatternNode pat:SyncPred_PredictionStepNode ;
    pair:patternPredicate beam:inform ;
    pair:targetPatternNode pat:SyncPred_DownstreamStepNode .

pat:AsynchronousPredictionMotif
    a pair:GraphMotif ;
    rdfs:label "Asynchronous Prediction Motif"@en ;
    dct:description "Architectural motif in which prediction requests are decoupled from prediction execution through a queue, cache, or similar intermediary resource."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Asynchronous-pattern/design_en.html> ;
    pair:derivedFrom <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Asynchronous-pattern/design_en.html> ;
    pair:hasPatternNode
        pat:AsyncPred_RequestNode ,
        pat:AsyncPred_EnqueueStepNode ,
        pat:AsyncPred_QueueNode ,
        pat:AsyncPred_PredictionStepNode ,
        pat:AsyncPred_ResultNode ;
    pair:hasPatternEdge
        pat:AsyncPred_EnqueueUsesRequestEdge ,
        pat:AsyncPred_EnqueueProducesQueueEdge ,
        pat:AsyncPred_PredictionUsesQueueEdge ,
        pat:AsyncPred_PredictionProducesResultEdge .

pat:AsyncPred_RequestNode
    a pair:PatternNode ;
    rdfs:label "Asynchronous prediction request node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionRequest .

pat:AsyncPred_EnqueueStepNode
    a pair:PatternNode ;
    rdfs:label "Prediction request enqueue step node"@en ;
    pair:expectedClass beam:Process .

pat:AsyncPred_QueueNode
    a pair:PatternNode ;
    rdfs:label "Prediction queue node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionQueue .

pat:AsyncPred_PredictionStepNode
    a pair:PatternNode ;
    rdfs:label "Asynchronous prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:PredictionStep .

pat:AsyncPred_ResultNode
    a pair:PatternNode ;
    rdfs:label "Asynchronous prediction result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionResult .

pat:AsyncPred_EnqueueUsesRequestEdge
    a pair:PatternEdge ;
    rdfs:label "enqueue step uses prediction request"@en ;
    pair:sourcePatternNode pat:AsyncPred_EnqueueStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:AsyncPred_RequestNode .

pat:AsyncPred_EnqueueProducesQueueEdge
    a pair:PatternEdge ;
    rdfs:label "enqueue step produces queued prediction request"@en ;
    pair:sourcePatternNode pat:AsyncPred_EnqueueStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:AsyncPred_QueueNode .

pat:AsyncPred_PredictionUsesQueueEdge
    a pair:PatternEdge ;
    rdfs:label "asynchronous prediction uses queue"@en ;
    pair:sourcePatternNode pat:AsyncPred_PredictionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:AsyncPred_QueueNode .

pat:AsyncPred_PredictionProducesResultEdge
    a pair:PatternEdge ;
    rdfs:label "asynchronous prediction produces result"@en ;
    pair:sourcePatternNode pat:AsyncPred_PredictionStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:AsyncPred_ResultNode .

pat:BatchPredictionMotif
    a pair:GraphMotif ;
    rdfs:label "Batch Prediction Motif"@en ;
    dct:description "Architectural motif in which a scheduled job runs prediction over a batch dataset and stores batch prediction results."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Batch-pattern/design_en.html> ;
    pair:derivedFrom <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Batch-pattern/design_en.html> ;
    pair:hasPatternNode
        pat:BatchPred_SchedulerNode ,
        pat:BatchPred_DatasetNode ,
        pat:BatchPred_ModelNode ,
        pat:BatchPred_JobNode ,
        pat:BatchPred_ResultNode ;
    pair:hasPatternEdge
        pat:BatchPred_SchedulerInformsJobEdge ,
        pat:BatchPred_JobUsesDatasetEdge ,
        pat:BatchPred_JobUsesModelEdge ,
        pat:BatchPred_JobProducesResultEdge .

pat:BatchPred_SchedulerNode
    a pair:PatternNode ;
    rdfs:label "Batch prediction scheduler node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:JobScheduler .

pat:BatchPred_DatasetNode
    a pair:PatternNode ;
    rdfs:label "Batch prediction dataset node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:BatchDataset .

pat:BatchPred_ModelNode
    a pair:PatternNode ;
    rdfs:label "Batch prediction model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:Model .

pat:BatchPred_JobNode
    a pair:PatternNode ;
    rdfs:label "Batch prediction job node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:PredictionStep .

pat:BatchPred_ResultNode
    a pair:PatternNode ;
    rdfs:label "Batch prediction result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionResult .

pat:BatchPred_SchedulerInformsJobEdge
    a pair:PatternEdge ;
    rdfs:label "batch scheduler informs prediction job"@en ;
    pair:sourcePatternNode pat:BatchPred_SchedulerNode ;
    pair:patternPredicate beam:inform ;
    pair:targetPatternNode pat:BatchPred_JobNode .

pat:BatchPred_JobUsesDatasetEdge
    a pair:PatternEdge ;
    rdfs:label "batch prediction job uses dataset"@en ;
    pair:sourcePatternNode pat:BatchPred_JobNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:BatchPred_DatasetNode .

pat:BatchPred_JobUsesModelEdge
    a pair:PatternEdge ;
    rdfs:label "batch prediction job uses model"@en ;
    pair:sourcePatternNode pat:BatchPred_JobNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:BatchPred_ModelNode .

pat:BatchPred_JobProducesResultEdge
    a pair:PatternEdge ;
    rdfs:label "batch prediction job produces result"@en ;
    pair:sourcePatternNode pat:BatchPred_JobNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:BatchPred_ResultNode .

pat:PreprocessPredictionMotif
    a pair:GraphMotif ;
    rdfs:label "Prep-Pred / Preprocess-Prediction Motif"@en ;
    dct:description "Architectural motif in which preprocessing and prediction are represented as separate steps connected by preprocessed data."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Prep-pred-pattern/design_en.html> ;
    pair:derivedFrom <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Prep-pred-pattern/design_en.html> ;
    pair:hasPatternNode
        pat:PrepPred_InputNode ,
        pat:PrepPred_PreprocessStepNode ,
        pat:PrepPred_PreprocessedDataNode ,
        pat:PrepPred_ModelNode ,
        pat:PrepPred_PredictionStepNode ,
        pat:PrepPred_ResultNode ;
    pair:hasPatternEdge
        pat:PrepPred_PreprocessUsesInputEdge ,
        pat:PrepPred_PreprocessProducesDataEdge ,
        pat:PrepPred_PreprocessInformsPredictionEdge ,
        pat:PrepPred_PredictionUsesDataEdge ,
        pat:PrepPred_PredictionUsesModelEdge ,
        pat:PrepPred_PredictionProducesResultEdge .

pat:PrepPred_InputNode
    a pair:PatternNode ;
    rdfs:label "Raw prediction input node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionRequest .

pat:PrepPred_PreprocessStepNode
    a pair:PatternNode ;
    rdfs:label "Preprocessing step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:PreprocessingStep .

pat:PrepPred_PreprocessedDataNode
    a pair:PatternNode ;
    rdfs:label "Preprocessed data node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PreprocessedData .

pat:PrepPred_ModelNode
    a pair:PatternNode ;
    rdfs:label "Prep-pred model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:Model .

pat:PrepPred_PredictionStepNode
    a pair:PatternNode ;
    rdfs:label "Prep-pred prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:PredictionStep .

pat:PrepPred_ResultNode
    a pair:PatternNode ;
    rdfs:label "Prep-pred prediction result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionResult .

pat:PrepPred_PreprocessUsesInputEdge
    a pair:PatternEdge ;
    rdfs:label "preprocess uses raw input"@en ;
    pair:sourcePatternNode pat:PrepPred_PreprocessStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:PrepPred_InputNode .

pat:PrepPred_PreprocessProducesDataEdge
    a pair:PatternEdge ;
    rdfs:label "preprocess produces preprocessed data"@en ;
    pair:sourcePatternNode pat:PrepPred_PreprocessStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:PrepPred_PreprocessedDataNode .

pat:PrepPred_PreprocessInformsPredictionEdge
    a pair:PatternEdge ;
    rdfs:label "preprocess informs prediction"@en ;
    pair:sourcePatternNode pat:PrepPred_PreprocessStepNode ;
    pair:patternPredicate beam:inform ;
    pair:targetPatternNode pat:PrepPred_PredictionStepNode .

pat:PrepPred_PredictionUsesDataEdge
    a pair:PatternEdge ;
    rdfs:label "prediction uses preprocessed data"@en ;
    pair:sourcePatternNode pat:PrepPred_PredictionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:PrepPred_PreprocessedDataNode .

pat:PrepPred_PredictionUsesModelEdge
    a pair:PatternEdge ;
    rdfs:label "prediction uses model"@en ;
    pair:sourcePatternNode pat:PrepPred_PredictionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:PrepPred_ModelNode .

pat:PrepPred_PredictionProducesResultEdge
    a pair:PatternEdge ;
    rdfs:label "prediction produces result"@en ;
    pair:sourcePatternNode pat:PrepPred_PredictionStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:PrepPred_ResultNode .

pat:MultiStagePredictionMotif
    a pair:GraphMotif ;
    rdfs:label "Multi-stage Prediction Motif"@en ;
    dct:description "Architectural motif in which one prediction path returns a quick result while another prediction path produces a slower or richer result."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Multiple-stage-prediction-pattern/design_en.html> ;
    pair:derivedFrom <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Multiple-stage-prediction-pattern/design_en.html> ;
    pair:hasPatternNode
        pat:MultiStage_RequestNode ,
        pat:MultiStage_FastModelNode ,
        pat:MultiStage_FastPredictionStepNode ,
        pat:MultiStage_QuickResultNode ,
        pat:MultiStage_SlowModelNode ,
        pat:MultiStage_SlowPredictionStepNode ,
        pat:MultiStage_ImprovedResultNode ;
    pair:hasPatternEdge
        pat:MultiStage_FastUsesRequestEdge ,
        pat:MultiStage_FastUsesModelEdge ,
        pat:MultiStage_FastProducesResultEdge ,
        pat:MultiStage_FastInformsSlowEdge ,
        pat:MultiStage_SlowUsesRequestEdge ,
        pat:MultiStage_SlowUsesModelEdge ,
        pat:MultiStage_SlowProducesResultEdge .

pat:MultiStage_RequestNode
    a pair:PatternNode ;
    rdfs:label "Multi-stage prediction request node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionRequest .

pat:MultiStage_FastModelNode
    a pair:PatternNode ;
    rdfs:label "Fast prediction model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:Model .

pat:MultiStage_FastPredictionStepNode
    a pair:PatternNode ;
    rdfs:label "Fast prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:FastPredictionStep .

pat:MultiStage_QuickResultNode
    a pair:PatternNode ;
    rdfs:label "Quick prediction result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionResult .

pat:MultiStage_SlowModelNode
    a pair:PatternNode ;
    rdfs:label "Slow prediction model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:Model .

pat:MultiStage_SlowPredictionStepNode
    a pair:PatternNode ;
    rdfs:label "Slow prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:SlowPredictionStep .

pat:MultiStage_ImprovedResultNode
    a pair:PatternNode ;
    rdfs:label "Improved prediction result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionResult .

pat:MultiStage_FastUsesRequestEdge
    a pair:PatternEdge ;
    rdfs:label "fast prediction uses request"@en ;
    pair:sourcePatternNode pat:MultiStage_FastPredictionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:MultiStage_RequestNode .

pat:MultiStage_FastUsesModelEdge
    a pair:PatternEdge ;
    rdfs:label "fast prediction uses model"@en ;
    pair:sourcePatternNode pat:MultiStage_FastPredictionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:MultiStage_FastModelNode .

pat:MultiStage_FastProducesResultEdge
    a pair:PatternEdge ;
    rdfs:label "fast prediction produces quick result"@en ;
    pair:sourcePatternNode pat:MultiStage_FastPredictionStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:MultiStage_QuickResultNode .

pat:MultiStage_FastInformsSlowEdge
    a pair:PatternEdge ;
    rdfs:label "fast prediction informs slow prediction"@en ;
    pair:sourcePatternNode pat:MultiStage_FastPredictionStepNode ;
    pair:patternPredicate beam:inform ;
    pair:targetPatternNode pat:MultiStage_SlowPredictionStepNode .

pat:MultiStage_SlowUsesRequestEdge
    a pair:PatternEdge ;
    rdfs:label "slow prediction uses request"@en ;
    pair:sourcePatternNode pat:MultiStage_SlowPredictionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:MultiStage_RequestNode .

pat:MultiStage_SlowUsesModelEdge
    a pair:PatternEdge ;
    rdfs:label "slow prediction uses model"@en ;
    pair:sourcePatternNode pat:MultiStage_SlowPredictionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:MultiStage_SlowModelNode .

pat:MultiStage_SlowProducesResultEdge
    a pair:PatternEdge ;
    rdfs:label "slow prediction produces improved result"@en ;
    pair:sourcePatternNode pat:MultiStage_SlowPredictionStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:MultiStage_ImprovedResultNode .


# ML system design motifs: training patterns

pat:BatchTrainingMotif
    a pair:GraphMotif ;
    rdfs:label "Batch Training Motif"@en ;
    dct:description "Architectural motif in which a scheduled training job prepares data, trains a model, evaluates it, and records the resulting model artifact and evaluation result."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Training-patterns/Batch-training-pattern/design_en.html> ;
    pair:derivedFrom <https://mercari.github.io/ml-system-design-pattern/Training-patterns/Batch-training-pattern/design_en.html> ;
    pair:hasPatternNode
        pat:BatchTrain_SchedulerNode ,
        pat:BatchTrain_DatasetNode ,
        pat:BatchTrain_PreprocessStepNode ,
        pat:BatchTrain_TrainingDataNode ,
        pat:BatchTrain_TrainingStepNode ,
        pat:BatchTrain_ModelArtifactNode ,
        pat:BatchTrain_EvaluationStepNode ,
        pat:BatchTrain_EvaluationResultNode ;
    pair:hasPatternEdge
        pat:BatchTrain_SchedulerInformsPreprocessEdge ,
        pat:BatchTrain_PreprocessUsesDatasetEdge ,
        pat:BatchTrain_PreprocessProducesTrainingDataEdge ,
        pat:BatchTrain_PreprocessInformsTrainingEdge ,
        pat:BatchTrain_TrainingUsesDataEdge ,
        pat:BatchTrain_TrainingProducesModelEdge ,
        pat:BatchTrain_TrainingInformsEvaluationEdge ,
        pat:BatchTrain_EvaluationUsesModelEdge ,
        pat:BatchTrain_EvaluationProducesResultEdge .

pat:BatchTrain_SchedulerNode
    a pair:PatternNode ;
    rdfs:label "Batch training scheduler node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:JobScheduler .

pat:BatchTrain_DatasetNode
    a pair:PatternNode ;
    rdfs:label "Batch training dataset node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:TrainingDataset .

pat:BatchTrain_PreprocessStepNode
    a pair:PatternNode ;
    rdfs:label "Batch training preprocessing step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:PreprocessingStep .

pat:BatchTrain_TrainingDataNode
    a pair:PatternNode ;
    rdfs:label "Prepared training data node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PreprocessedData .

pat:BatchTrain_TrainingStepNode
    a pair:PatternNode ;
    rdfs:label "Batch training step node"@en ;
    pair:expectedClass beam:Train ;
    pair:expectedRole pair:TrainingStep .

pat:BatchTrain_ModelArtifactNode
    a pair:PatternNode ;
    rdfs:label "Trained model artifact node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:ModelArtifact .

pat:BatchTrain_EvaluationStepNode
    a pair:PatternNode ;
    rdfs:label "Model evaluation step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:EvaluationStep .

pat:BatchTrain_EvaluationResultNode
    a pair:PatternNode ;
    rdfs:label "Model evaluation result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:EvaluationResult .

pat:BatchTrain_SchedulerInformsPreprocessEdge
    a pair:PatternEdge ;
    rdfs:label "batch training scheduler informs preprocessing"@en ;
    pair:sourcePatternNode pat:BatchTrain_SchedulerNode ;
    pair:patternPredicate beam:inform ;
    pair:targetPatternNode pat:BatchTrain_PreprocessStepNode .

pat:BatchTrain_PreprocessUsesDatasetEdge
    a pair:PatternEdge ;
    rdfs:label "training preprocess uses dataset"@en ;
    pair:sourcePatternNode pat:BatchTrain_PreprocessStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:BatchTrain_DatasetNode .

pat:BatchTrain_PreprocessProducesTrainingDataEdge
    a pair:PatternEdge ;
    rdfs:label "training preprocess produces prepared data"@en ;
    pair:sourcePatternNode pat:BatchTrain_PreprocessStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:BatchTrain_TrainingDataNode .

pat:BatchTrain_PreprocessInformsTrainingEdge
    a pair:PatternEdge ;
    rdfs:label "training preprocess informs training"@en ;
    pair:sourcePatternNode pat:BatchTrain_PreprocessStepNode ;
    pair:patternPredicate beam:inform ;
    pair:targetPatternNode pat:BatchTrain_TrainingStepNode .

pat:BatchTrain_TrainingUsesDataEdge
    a pair:PatternEdge ;
    rdfs:label "training uses prepared data"@en ;
