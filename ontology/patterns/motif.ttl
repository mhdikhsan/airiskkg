    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:PredMon_AlertNode .

pat:ModelLoadMotif
    a pair:GraphMotif ;
    pair:implementedBy pat:ModelLoad_MatchingOQP ;
    rdfs:label "Model Load Motif"@en ;
    dct:description "A model load step reads a serving image and a separately kept model artifact and produces the model a prediction step uses."@en ;
