# Motif 2: LLM-based Information Retrieval
pat:LLMBasedInformationRetrievalMotif
    a pair:GraphMotif ;
    rdfs:label "LLM-based Information Retrieval Motif"@en ;
    dct:description "A retrieval step uses a generative model to find what is relevant to a query and produces retrieved context."@en ;
    rdfs:comment "No knowledge source node: a generative retriever answers from what the model learned, with no index. When a source is also read, the Information Retrieval motif co-matches."@en ;
    pair:derivedFrom pat:Cite_LLMEnhancedIR ,
        pat:Cite_GenerativeRetriever ;
    pair:hasPatternNode
        pat:LLMIR_QueryNode ,
        pat:LLMIR_LLMNode ,
        pat:LLMIR_RetrievalStepNode ,
        pat:LLMIR_RetrievedResultNode ;
    pair:hasPatternEdge
        pat:LLMIR_RetrievalUsesQueryEdge ,
        pat:LLMIR_RetrievalUsesLLMEdge ,
        pat:LLMIR_RetrievalProducesResultEdge ;
    pair:implementedBy pat:LLMIR_MatchingOQP .

pat:LLMIR_QueryNode
    a pair:PatternNode ;
    rdfs:label "Query"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:LLMIR_LLMNode
    a pair:PatternNode ;
    rdfs:label "Retrieval language model"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:GenerativeModel .

pat:LLMIR_RetrievalStepNode
    a pair:PatternNode ;
    rdfs:label "LLM-based retrieval step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:RetrievalStep .

pat:LLMIR_RetrievedResultNode
    a pair:PatternNode ;
    rdfs:label "Retrieved result"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:RetrievedContext .

pat:LLMIR_RetrievalUsesQueryEdge
    a pair:PatternEdge ;
    rdfs:label "retrieval uses query"@en ;
    pair:sourcePatternNode pat:LLMIR_RetrievalStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:LLMIR_QueryNode .

pat:LLMIR_RetrievalUsesLLMEdge
    a pair:PatternEdge ;
    rdfs:label "retrieval uses the language model"@en ;
    pair:sourcePatternNode pat:LLMIR_RetrievalStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:LLMIR_LLMNode .

pat:LLMIR_RetrievalProducesResultEdge
    a pair:PatternEdge ;
    rdfs:label "retrieval produces retrieved result"@en ;
    pair:sourcePatternNode pat:LLMIR_RetrievalStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:LLMIR_RetrievedResultNode .

# ML system design motifs derived from the serving design patterns

pat:SynchronousPredictionMotif
    a pair:GraphMotif ;
    pair:implementedBy pat:SyncPred_MatchingOQP ;
    rdfs:label "Synchronous Prediction Motif"@en ;
    dct:description "A prediction step answers a request with a model, and a downstream step uses the result in the same workflow."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Synchronous-pattern/design_en.html> ;
    pair:derivedFrom pat:Cite_SynchronousPrediction ;
    pair:hasPatternNode
        pat:SyncPred_RequestNode ,
        pat:SyncPred_ModelNode ,
        pat:SyncPred_PredictionStepNode ,
        pat:SyncPred_ResultNode ,
        pat:SyncPred_DownstreamStepNode ;
    pair:hasPatternEdge
        pat:SyncPred_PredictionUsesRequestEdge ,
        pat:SyncPred_PredictionUsesModelEdge ,
        pat:SyncPred_PredictionProducesResultEdge ,
        pat:SyncPred_DownstreamUsesResultEdge .

pat:SyncPred_RequestNode
    a pair:PatternNode ;
    rdfs:label "Synchronous prediction request"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionRequest .

pat:SyncPred_ModelNode
    a pair:PatternNode ;
    rdfs:label "Synchronous prediction model"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:Model .

pat:SyncPred_PredictionStepNode
