pat:FineTune_EvaluationProducesScoreEdge
    a pair:PatternEdge ;
    rdfs:label "fine tuning evaluation produces score"@en ;
    pair:sourcePatternNode pat:FineTune_EvaluationStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:FineTune_EvaluationScoreNode .

pat:ExternalDependencyMotif
    a pair:GraphMotif ;
    rdfs:label "External Dependency Motif"@en ;
    dct:description "A step uses a supply chain resource: an external dependency, a pre-trained model, a model artifact or a serving image."@en ;
    rdfs:comment "Project curation: no catalogue defines this shape, so derivedFrom names the LLM03 entry that scopes it rather than a design pattern citation."@en ;
    dct:source <https://genai.owasp.org/resource/owasp-top-10-for-llm-applications-2025/> ;
    pair:derivedFrom owasp:llm03-supply-chain ;
    pair:hasPatternNode
        pat:ExtDep_ExternalResourceNode ,
        pat:ExtDep_UsingStepNode ;
    pair:hasPatternEdge
        pat:ExtDep_StepUsesResourceEdge ;
    pair:implementedBy pat:ExternalDependency_MatchingOQP .

pat:ExtDep_ExternalResourceNode
    a pair:PatternNode ;
    rdfs:label "External resource"@en ;
    rdfs:comment "Expected role is a disjunction the ODP vocabulary cannot express: subRoleOf* of pair:ExternalDependency, pair:PretrainedModel, pair:ModelArtifact, or pair:ServingImage (see match_external_dependency.rq)."@en ;
    pair:expectedClass beam:Resource ;
    pair:expectedRole pair:ExternalDependency .

pat:ExtDep_UsingStepNode
    a pair:PatternNode ;
    rdfs:label "Using step"@en ;
    pair:expectedClass beam:Process .

pat:ExtDep_StepUsesResourceEdge
    a pair:PatternEdge ;
    rdfs:label "step uses external resource"@en ;
    pair:sourcePatternNode pat:ExtDep_UsingStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:ExtDep_ExternalResourceNode .

# Agentic motifs
pat:ToolUsingAgentMotif
    a pair:GraphMotif ;
    rdfs:label "Tool-Using Agent Motif"@en ;
    dct:description "A planning step produces an action that a tool invocation step carries out, producing a result."@en ;
    dct:source <https://genai.owasp.org/> ,
        <https://doi.org/10.1016/j.jss.2024.112278> ;
    pair:derivedFrom asi:asi02-tool-misuse ,
        pat:Cite_AgentAdapter ,
        pat:Cite_SinglePathPlanGenerator ,
        pat:Cite_MultiPathPlanGenerator ,
        pat:Cite_ToolAgentRegistry ;
    pair:hasPatternNode
        pat:ToolAgent_PlanningStepNode ,
        pat:ToolAgent_ActionStepNode ,
        pat:ToolAgent_PlanNode ,
        pat:ToolAgent_ActionResultNode ;
    pair:hasPatternEdge
        pat:ToolAgent_PlanningProducesPlanEdge ,
        pat:ToolAgent_ActionUsesPlanEdge ,
        pat:ToolAgent_ActionProducesResultEdge ;
    pair:hasRiskPattern pat:ToolMisuseRiskPattern ,
                        pat:GoalHijackRiskPattern ;
    pair:implementedBy pat:ToolUsingAgent_MatchingOQP .

pat:ToolAgent_PlanningStepNode
    a pair:PatternNode ;
    rdfs:label "Agent planning step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:PlanningStep .

pat:ToolAgent_ActionStepNode
    a pair:PatternNode ;
    rdfs:label "Agent action step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:ToolInvocationStep .

pat:ToolAgent_ActionResultNode
    a pair:PatternNode ;
    rdfs:label "Agent action result"@en ;
    pair:expectedClass beam:Data .

pat:ToolAgent_PlanNode
    a pair:PatternNode ;
    rdfs:label "Agent action plan"@en ;
    pair:expectedClass beam:Data .


pat:ToolAgent_ActionProducesResultEdge
    a pair:PatternEdge ;
    rdfs:label "action produces result"@en ;
    pair:sourcePatternNode pat:ToolAgent_ActionStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:ToolAgent_ActionResultNode .

pat:ToolAgent_PlanningProducesPlanEdge
    a pair:PatternEdge ;
    rdfs:label "planning step produces the action plan"@en ;
    pair:sourcePatternNode pat:ToolAgent_PlanningStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:ToolAgent_PlanNode .

pat:ToolAgent_ActionUsesPlanEdge
    a pair:PatternEdge ;
    rdfs:label "action step uses the action plan"@en ;
    pair:sourcePatternNode pat:ToolAgent_ActionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:ToolAgent_PlanNode .

pat:AgentMemoryLoopMotif
    a pair:GraphMotif ;
    rdfs:label "Agent Memory Loop Motif"@en ;
    dct:description "One step writes to an agent's memory and another step reads that memory back into the context a later step works from."@en ;
    dct:source <https://genai.owasp.org/> ;
    pair:derivedFrom asi:asi06-memory-and-context-poisoning ;
    pair:hasPatternNode
        pat:AgentMemory_WriteStepNode ,
        pat:AgentMemory_StoreNode ,
        pat:AgentMemory_ReadStepNode ,
        pat:AgentMemory_RecalledContextNode ;
    pair:hasPatternEdge
        pat:AgentMemory_WriteProducesStoreEdge ,
        pat:AgentMemory_ReadUsesStoreEdge ,
        pat:AgentMemory_ReadProducesContextEdge ;
    pair:hasRiskPattern pat:MemoryPoisoningRiskPattern ;
    pair:implementedBy pat:AgentMemoryLoop_MatchingOQP .

pat:AgentMemory_WriteStepNode
    a pair:PatternNode ;
    rdfs:label "Memory write step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:MemoryWriteStep .

pat:AgentMemory_StoreNode
    a pair:PatternNode ;
    rdfs:label "Agent memory store"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:AgentMemory .

pat:AgentMemory_ReadStepNode
    a pair:PatternNode ;
    rdfs:label "Memory read step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:MemoryReadStep .

pat:AgentMemory_RecalledContextNode
    a pair:PatternNode ;
    rdfs:label "Recalled context"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:RetrievedContext .

pat:AgentMemory_WriteProducesStoreEdge
    a pair:PatternEdge ;
    rdfs:label "memory write produces store"@en ;
    pair:sourcePatternNode pat:AgentMemory_WriteStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:AgentMemory_StoreNode .

pat:AgentMemory_ReadUsesStoreEdge
    a pair:PatternEdge ;
    rdfs:label "memory read uses store"@en ;
    pair:sourcePatternNode pat:AgentMemory_ReadStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:AgentMemory_StoreNode .

pat:AgentMemory_ReadProducesContextEdge
    a pair:PatternEdge ;
    rdfs:label "memory read produces recalled context"@en ;
    pair:sourcePatternNode pat:AgentMemory_ReadStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:AgentMemory_RecalledContextNode .

# Agentic motifs, second tranche

pat:AgentDelegationMotif
    a pair:GraphMotif ;
    rdfs:label "Agent Delegation Motif"@en ;
    dct:description "One agent's planning step produces a message that another agent's handoff step takes up, so work passes from one agent to the next."@en ;
    dct:source <https://genai.owasp.org/> ,
        <https://doi.org/10.1016/j.jss.2024.112278> ;
    pair:derivedFrom asi:asi07-insecure-inter-agent-communication ,
        pat:Cite_RoleBasedCooperation ,
        pat:Cite_SinglePathPlanGenerator ,
        pat:Cite_MultiPathPlanGenerator ;
    pair:hasPatternNode
        pat:AgentDelegation_DelegatingStepNode ,
        pat:AgentDelegation_MessageNode ,
        pat:AgentDelegation_ReceivingStepNode ;
    pair:hasPatternEdge
        pat:AgentDelegation_DelegatingProducesMessageEdge ,
        pat:AgentDelegation_ReceivingUsesMessageEdge ;
    pair:hasRiskPattern pat:InsecureAgentCommunicationRiskPattern ,
        pat:GoalHijackRiskPattern ;
    pair:implementedBy pat:AgentDelegation_MatchingOQP .

pat:AgentDelegation_DelegatingStepNode
    a pair:PatternNode ;
    rdfs:label "Delegating agent planning step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:PlanningStep .

pat:AgentDelegation_MessageNode
    a pair:PatternNode ;
    rdfs:label "Inter-agent message"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:AgentMessage .

pat:AgentDelegation_ReceivingStepNode
    a pair:PatternNode ;
    rdfs:label "Receiving agent handoff step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:AgentHandoffStep .

pat:AgentDelegation_DelegatingProducesMessageEdge
    a pair:PatternEdge ;
    rdfs:label "delegating step produces message"@en ;
    pair:sourcePatternNode pat:AgentDelegation_DelegatingStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:AgentDelegation_MessageNode .

pat:AgentDelegation_ReceivingUsesMessageEdge
    a pair:PatternEdge ;
    rdfs:label "receiving step uses message"@en ;
    pair:sourcePatternNode pat:AgentDelegation_ReceivingStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:AgentDelegation_MessageNode .

# Control motif: matching it suppresses the tool-misuse finding on the mediated path.

pat:HumanOversightMotif
    a pair:GraphMotif ;
    rdfs:label "Human Oversight Motif"@en ;
    dct:description "A human approval step produces a decision that a tool invocation step reads before it produces its result."@en ;
    dct:source <https://genai.owasp.org/> ,
        <https://doi.org/10.1016/j.jss.2024.112278> ;
    pair:derivedFrom asi:asi02-tool-misuse ,
        pat:Cite_HumanReflection ;
    pair:hasPatternNode
        pat:HumanOversight_ApprovalStepNode ,
        pat:HumanOversight_ActionStepNode ,
        pat:HumanOversight_ApprovalNode ,
        pat:HumanOversight_ActionResultNode ;
    pair:hasPatternEdge
        pat:HumanOversight_ApprovalProducesDecisionEdge ,
        pat:HumanOversight_ActionUsesApprovalEdge ,
        pat:HumanOversight_ActionProducesResultEdge ;
    pair:implementedBy pat:HumanOversight_MatchingOQP .

pat:HumanOversight_ApprovalStepNode
    a pair:PatternNode ;
    rdfs:label "Human approval step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:HumanApprovalStep .

pat:HumanOversight_ActionStepNode
    a pair:PatternNode ;
    rdfs:label "Mediated action step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:ToolInvocationStep .

pat:HumanOversight_ActionResultNode
    a pair:PatternNode ;
    rdfs:label "Action result"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:ResourceRole .

pat:HumanOversight_ApprovalNode
    a pair:PatternNode ;
    rdfs:label "Human approval"@en ;
    pair:expectedClass beam:Data .


pat:HumanOversight_ActionProducesResultEdge
    a pair:PatternEdge ;
    rdfs:label "action produces result"@en ;
    pair:sourcePatternNode pat:HumanOversight_ActionStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:HumanOversight_ActionResultNode .

pat:HumanOversight_ApprovalProducesDecisionEdge
    a pair:PatternEdge ;
    rdfs:label "approval step produces the approval"@en ;
    pair:sourcePatternNode pat:HumanOversight_ApprovalStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:HumanOversight_ApprovalNode .

pat:HumanOversight_ActionUsesApprovalEdge
    a pair:PatternEdge ;
    rdfs:label "action step uses the approval"@en ;
    pair:sourcePatternNode pat:HumanOversight_ActionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:HumanOversight_ApprovalNode .

# Control motif: the execution guardrail of Liu et al.'s multimodal guardrails,
# and the shape the tool mediation rewrite builds.

pat:ExecutionScreeningMotif
    a pair:GraphMotif ;
    rdfs:label "Execution Screening Motif"@en ;
    dct:description "A policy enforcement step produces a decision that a tool invocation step reads before it acts."@en ;
    pair:derivedFrom pat:Cite_MultimodalGuardrails ;
    pair:hasPatternNode
        pat:ExecScreening_PolicyStepNode ,
        pat:ExecScreening_VerdictNode ,
        pat:ExecScreening_ToolStepNode ,
        pat:ExecScreening_ResultNode ;
    pair:hasPatternEdge
        pat:ExecScreening_PolicyProducesVerdictEdge ,
        pat:ExecScreening_ToolUsesVerdictEdge ,
        pat:ExecScreening_ToolProducesResultEdge ;
    pair:implementedBy pat:ExecScreening_MatchingOQP .

pat:ExecScreening_PolicyStepNode
    a pair:PatternNode ;
    rdfs:label "Execution guardrail step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:PolicyEnforcementStep .

pat:ExecScreening_VerdictNode
    a pair:PatternNode ;
    rdfs:label "Policy verdict"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:GuardrailDecision .

pat:ExecScreening_ToolStepNode
    a pair:PatternNode ;
    rdfs:label "Screened tool invocation step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:ToolInvocationStep .

pat:ExecScreening_ResultNode
    a pair:PatternNode ;
    rdfs:label "Tool result"@en ;
    pair:expectedClass beam:Data .

pat:ExecScreening_PolicyProducesVerdictEdge
    a pair:PatternEdge ;
    rdfs:label "policy step produces a verdict"@en ;
    pair:sourcePatternNode pat:ExecScreening_PolicyStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:ExecScreening_VerdictNode .

pat:ExecScreening_ToolUsesVerdictEdge
    a pair:PatternEdge ;
    rdfs:label "tool step uses the verdict"@en ;
    pair:sourcePatternNode pat:ExecScreening_ToolStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:ExecScreening_VerdictNode .

pat:ExecScreening_ToolProducesResultEdge
    a pair:PatternEdge ;
    rdfs:label "tool step produces its result"@en ;
    pair:sourcePatternNode pat:ExecScreening_ToolStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:ExecScreening_ResultNode .

# Agentic motifs from Liu et al.'s agent design pattern catalogue. Each agent
# component is a step, what passes between components is data, and a model or a
# store is a resource the step uses.

pat:GoalCreationMotif
    a pair:GraphMotif ;
    rdfs:label "Goal Creation Motif"@en ;
    dct:description "A goal creation step reads the user's input and the agent's memory and states the goal the agent works toward."@en ;
    rdfs:comment "Named for the step rather than for being passive: a proactive goal creator reads the prompt and memory as well and matches this too. Passive would claim that no detector is present, which a motif cannot say."@en ;
    pair:derivedFrom pat:Cite_PassiveGoalCreator ,
        pat:Cite_ProactiveGoalCreator ;
    pair:hasPatternNode
        pat:GoalCreation_PromptNode ,
        pat:GoalCreation_MemoryNode ,
        pat:GoalCreation_GoalCreatorNode ,
        pat:GoalCreation_GoalNode ;
    pair:hasPatternEdge
        pat:GoalCreation_CreatorUsesPromptEdge ,
        pat:GoalCreation_CreatorUsesMemoryEdge ,
        pat:GoalCreation_CreatorProducesGoalEdge ;
    pair:implementedBy pat:GoalCreation_MatchingOQP .

pat:GoalCreation_PromptNode
    a pair:PatternNode ;
    rdfs:label "User prompt"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:GoalCreation_MemoryNode
    a pair:PatternNode ;
    rdfs:label "Agent memory"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:AgentMemory .

pat:GoalCreation_GoalCreatorNode
    a pair:PatternNode ;
    rdfs:label "Goal creator step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:GoalCreationStep .

pat:GoalCreation_GoalNode
    a pair:PatternNode ;
    rdfs:label "Agent goal"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:AgentGoal .

pat:GoalCreation_CreatorUsesPromptEdge
    a pair:PatternEdge ;
    rdfs:label "goal creator uses the user prompt"@en ;
    pair:sourcePatternNode pat:GoalCreation_GoalCreatorNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:GoalCreation_PromptNode .

pat:GoalCreation_CreatorUsesMemoryEdge
    a pair:PatternEdge ;
    rdfs:label "goal creator uses the agent memory"@en ;
    pair:sourcePatternNode pat:GoalCreation_GoalCreatorNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:GoalCreation_MemoryNode .

pat:GoalCreation_CreatorProducesGoalEdge
    a pair:PatternEdge ;
    rdfs:label "goal creator produces the goal"@en ;
    pair:sourcePatternNode pat:GoalCreation_GoalCreatorNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:GoalCreation_GoalNode .













pat:ModelQueryingMotif
    a pair:GraphMotif ;
    rdfs:label "Model Querying Motif"@en ;
    dct:description "A planning step puts the user's input to a generative model and produces the plan the agent works from."@en ;
    rdfs:comment "How many times the planning step queries the model is runtime behaviour a graph cannot show, so this is the shape one-shot and incremental model querying share. One-shot is not a structural claim and is not in the name."@en ;
    pair:derivedFrom pat:Cite_OneShotModelQuerying ,
        pat:Cite_IncrementalModelQuerying ;
    pair:hasPatternNode
        pat:ModelQuery_PromptNode ,
        pat:ModelQuery_ModelNode ,
        pat:ModelQuery_PlanningStepNode ,
        pat:ModelQuery_PlanNode ;
    pair:hasPatternEdge
        pat:ModelQuery_PlanningUsesPromptEdge ,
        pat:ModelQuery_PlanningUsesModelEdge ,
        pat:ModelQuery_PlanningProducesPlanEdge ;
    pair:implementedBy pat:ModelQuery_MatchingOQP .

pat:ModelQuery_PromptNode
    a pair:PatternNode ;
    rdfs:label "User prompt"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:ModelQuery_ModelNode
    a pair:PatternNode ;
    rdfs:label "Foundation model"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:GenerativeModel .

pat:ModelQuery_PlanningStepNode
    a pair:PatternNode ;
    rdfs:label "Plan generation step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:PlanningStep .

pat:ModelQuery_PlanNode
    a pair:PatternNode ;
    rdfs:label "Plan"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:AgentPlan .

pat:ModelQuery_PlanningUsesPromptEdge
    a pair:PatternEdge ;
    rdfs:label "planning uses the user prompt"@en ;
    pair:sourcePatternNode pat:ModelQuery_PlanningStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:ModelQuery_PromptNode .

pat:ModelQuery_PlanningUsesModelEdge
    a pair:PatternEdge ;
    rdfs:label "planning queries the foundation model"@en ;
    pair:sourcePatternNode pat:ModelQuery_PlanningStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:ModelQuery_ModelNode .

pat:ModelQuery_PlanningProducesPlanEdge
    a pair:PatternEdge ;
    rdfs:label "planning produces the plan"@en ;
    pair:sourcePatternNode pat:ModelQuery_PlanningStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:ModelQuery_PlanNode .











pat:PlanReflectionMotif
    a pair:GraphMotif ;
    rdfs:label "Plan Reflection Motif"@en ;
    dct:description "A reflection step reviews the plan a planning step produced and returns feedback that the planning step reads to revise it."@en ;
    pair:derivedFrom pat:Cite_SelfReflection ,
        pat:Cite_CrossReflection ,
        pat:Cite_HumanReflection ;
    pair:hasPatternNode
        pat:PlanReflection_PlanningStepNode ,
        pat:PlanReflection_PlanNode ,
        pat:PlanReflection_ReflectionStepNode ,
        pat:PlanReflection_FeedbackNode ;
    pair:hasPatternEdge
        pat:PlanReflection_PlanningProducesPlanEdge ,
        pat:PlanReflection_ReflectionUsesPlanEdge ,
        pat:PlanReflection_ReflectionProducesFeedbackEdge ,
        pat:PlanReflection_PlanningUsesFeedbackEdge ;
    pair:implementedBy pat:PlanReflection_MatchingOQP .

pat:PlanReflection_PlanningStepNode
    a pair:PatternNode ;
    rdfs:label "Plan generation step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:PlanningStep .

pat:PlanReflection_PlanNode
    a pair:PatternNode ;
    rdfs:label "Plan under review"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:AgentPlan .

pat:PlanReflection_ReflectionStepNode
    a pair:PatternNode ;
    rdfs:label "Plan reflection step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:PlanReflectionStep .

pat:PlanReflection_FeedbackNode
    a pair:PatternNode ;
    rdfs:label "Reflection feedback"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:ReflectionFeedback .

pat:PlanReflection_PlanningProducesPlanEdge
    a pair:PatternEdge ;
    rdfs:label "planning produces the plan"@en ;
    pair:sourcePatternNode pat:PlanReflection_PlanningStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:PlanReflection_PlanNode .

pat:PlanReflection_ReflectionUsesPlanEdge
    a pair:PatternEdge ;
    rdfs:label "reflection uses the plan"@en ;
    pair:sourcePatternNode pat:PlanReflection_ReflectionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:PlanReflection_PlanNode .

pat:PlanReflection_ReflectionProducesFeedbackEdge
    a pair:PatternEdge ;
    rdfs:label "reflection produces feedback"@en ;
    pair:sourcePatternNode pat:PlanReflection_ReflectionStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:PlanReflection_FeedbackNode .

pat:PlanReflection_PlanningUsesFeedbackEdge
    a pair:PatternEdge ;
    rdfs:label "planning uses the feedback"@en ;
    pair:sourcePatternNode pat:PlanReflection_PlanningStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:PlanReflection_FeedbackNode .

pat:VotingBasedCooperationMotif
    a pair:GraphMotif ;
    rdfs:label "Voting-based Cooperation Motif"@en ;
    dct:description "Two agent steps each produce a vote as a message, and a vote aggregation step combines the votes into one decision."@en ;
    pair:derivedFrom pat:Cite_VotingBasedCooperation ;
    pair:hasPatternNode
        pat:Voting_FirstVoterNode ,
        pat:Voting_FirstVoteNode ,
        pat:Voting_SecondVoterNode ,
        pat:Voting_SecondVoteNode ,
        pat:Voting_AggregationStepNode ,
        pat:Voting_DecisionNode ;
    pair:hasPatternEdge
        pat:Voting_FirstVoterProducesVoteEdge ,
        pat:Voting_SecondVoterProducesVoteEdge ,
        pat:Voting_AggregationUsesFirstVoteEdge ,
        pat:Voting_AggregationUsesSecondVoteEdge ,
        pat:Voting_AggregationProducesDecisionEdge ;
    pair:implementedBy pat:Voting_MatchingOQP .

pat:Voting_FirstVoterNode
    a pair:PatternNode ;
    rdfs:label "Voting agent step"@en ;
    pair:expectedClass beam:Process .

pat:Voting_FirstVoteNode
    a pair:PatternNode ;
    rdfs:label "Vote"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:AgentMessage .

pat:Voting_SecondVoterNode
    a pair:PatternNode ;
    rdfs:label "Second voting agent step"@en ;
    pair:expectedClass beam:Process .

pat:Voting_SecondVoteNode
    a pair:PatternNode ;
    rdfs:label "Second vote"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:AgentMessage .

pat:Voting_AggregationStepNode
    a pair:PatternNode ;
    rdfs:label "Vote aggregation step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:VoteAggregationStep .

pat:Voting_DecisionNode
    a pair:PatternNode ;
    rdfs:label "Collective decision"@en ;
    pair:expectedClass beam:Data .

pat:Voting_FirstVoterProducesVoteEdge
    a pair:PatternEdge ;
    rdfs:label "a voting agent produces its vote"@en ;
    pair:sourcePatternNode pat:Voting_FirstVoterNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:Voting_FirstVoteNode .

pat:Voting_SecondVoterProducesVoteEdge
    a pair:PatternEdge ;
    rdfs:label "another voting agent produces its vote"@en ;
    pair:sourcePatternNode pat:Voting_SecondVoterNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:Voting_SecondVoteNode .

pat:Voting_AggregationUsesFirstVoteEdge
    a pair:PatternEdge ;
    rdfs:label "aggregation uses the first vote"@en ;
    pair:sourcePatternNode pat:Voting_AggregationStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Voting_FirstVoteNode .

pat:Voting_AggregationUsesSecondVoteEdge
    a pair:PatternEdge ;
    rdfs:label "aggregation uses the second vote"@en ;
    pair:sourcePatternNode pat:Voting_AggregationStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Voting_SecondVoteNode .

pat:Voting_AggregationProducesDecisionEdge
    a pair:PatternEdge ;
    rdfs:label "aggregation produces the decision"@en ;
    pair:sourcePatternNode pat:Voting_AggregationStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:Voting_DecisionNode .

pat:DebateBasedCooperationMotif
    a pair:GraphMotif ;
    rdfs:label "Debate-based Cooperation Motif"@en ;
    dct:description "Two agent steps each produce an argument that the other reads and answers, so the exchange runs in both directions."@en ;
    rdfs:comment "The argument role is the discriminator: a request answered by a reply is also a two-way exchange between agents, and is not a debate."@en ;
    pair:derivedFrom pat:Cite_DebateBasedCooperation ;
    pair:hasPatternNode
        pat:Debate_FirstAgentNode ,
        pat:Debate_FirstArgumentNode ,
        pat:Debate_SecondAgentNode ,
        pat:Debate_SecondArgumentNode ;
    pair:hasPatternEdge
        pat:Debate_FirstAgentProducesArgumentEdge ,
        pat:Debate_SecondAgentUsesArgumentEdge ,
        pat:Debate_SecondAgentProducesArgumentEdge ,
        pat:Debate_FirstAgentUsesArgumentEdge ;
    pair:implementedBy pat:Debate_MatchingOQP .

pat:Debate_FirstAgentNode
    a pair:PatternNode ;
    rdfs:label "Debating agent step"@en ;
    pair:expectedClass beam:Process .

pat:Debate_FirstArgumentNode
    a pair:PatternNode ;
    rdfs:label "Argument"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:DebateArgument .

pat:Debate_SecondAgentNode
    a pair:PatternNode ;
    rdfs:label "Opposing agent step"@en ;
    pair:expectedClass beam:Process .

pat:Debate_SecondArgumentNode
    a pair:PatternNode ;
    rdfs:label "Counter-argument"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:DebateArgument .

pat:Debate_FirstAgentProducesArgumentEdge
    a pair:PatternEdge ;
    rdfs:label "an agent produces its argument"@en ;
    pair:sourcePatternNode pat:Debate_FirstAgentNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:Debate_FirstArgumentNode .

pat:Debate_SecondAgentUsesArgumentEdge
    a pair:PatternEdge ;
    rdfs:label "the other agent reads the argument"@en ;
    pair:sourcePatternNode pat:Debate_SecondAgentNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Debate_FirstArgumentNode .

pat:Debate_SecondAgentProducesArgumentEdge
    a pair:PatternEdge ;
    rdfs:label "the other agent produces a counter-argument"@en ;
    pair:sourcePatternNode pat:Debate_SecondAgentNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:Debate_SecondArgumentNode .

pat:Debate_FirstAgentUsesArgumentEdge
    a pair:PatternEdge ;
    rdfs:label "the first agent reads the counter-argument"@en ;
    pair:sourcePatternNode pat:Debate_FirstAgentNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:Debate_SecondArgumentNode .











#################################################################
# Motif families and groups
#################################################################

pair:MotifFamilyScheme
    a skos:ConceptScheme ;
    skos:prefLabel "Motif family scheme"@en ;
    skos:definition """
    The families of AI system this motif library covers: GenAI, ML serving and
    training, agentic, and supply chain.
    """@en .

pat:GenAIMotifFamily
    a skos:Concept ;
    skos:inScheme pair:MotifFamilyScheme ;
    skos:prefLabel "GenAI"@en ;
    skos:definition """
    Shapes of a generative AI application
    """@en ;
    dct:source <https://doi.org/10.48550/arXiv.2312.10997> ,
        <https://martinfowler.com/articles/gen-ai-patterns/> .

pat:AgenticMotifFamily
    a skos:Concept ;
    skos:inScheme pair:MotifFamilyScheme ;
    skos:prefLabel "Agentic"@en ;
    skos:definition """
    Shapes of a foundation-model agent
    """@en ;
    dct:source <https://doi.org/10.1016/j.jss.2024.112278> ,
        <https://genai.owasp.org/> .

pat:MLSystemMotifFamily
    a skos:Concept ;
    skos:inScheme pair:MotifFamilyScheme ;
    skos:prefLabel "ML serving and training"@en ;
    skos:definition """
    Shapes of a machine learning system in operation
    """@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/> .

pat:SupplyChainMotifFamily
    a skos:Concept ;
    skos:inScheme pair:MotifFamilyScheme ;
    skos:prefLabel "Supply chain"@en ;
    skos:definition """
    Shapes in which something the system depends on comes from outside it
    """@en ;
    dct:source <https://genai.owasp.org/resource/owasp-top-10-for-llm-applications-2025/> .

# A group sits under one family (skos:broader), so the library files a motif as
# family, then group, and keeps the variants of one shape side by side.

pair:MotifGroupScheme
    a skos:ConceptScheme ;
    skos:prefLabel "Motif group scheme"@en ;
    skos:definition """
    Groups of related motifs within one family: variants of one shape, or
    shapes that are used together.
    """@en .

pat:PromptingMotifGroup
    a skos:Concept ;
    skos:inScheme pair:MotifGroupScheme ;
    skos:broader pat:GenAIMotifFamily ;
    skos:prefLabel "Prompting"@en ;
    skos:definition """
    A prompt put to a generative model, directly or after an optimiser has
    reworked it against a template.
    """@en ;
    dct:source <https://doi.org/10.48550/arXiv.2109.01652> ,
        <https://doi.org/10.1016/j.jss.2024.112278> .

pat:InformationRetrievalMotifGroup
    a skos:Concept ;
    skos:inScheme pair:MotifGroupScheme ;
    skos:broader pat:GenAIMotifFamily ;
    skos:prefLabel "Information retrieval"@en ;
    skos:definition """
    Finding what to put in front of a model: retrieval over a knowledge source
    by vectors, keywords or a language model, and the query rewriting,
    reranking, indexing and training data around it.
    """@en ;
    dct:source <https://doi.org/10.1145/3748304> ,
        <https://doi.org/10.48550/arXiv.2312.10997> .

pat:RetrievalAugmentedGenerationMotifGroup
    a skos:Concept ;
    skos:inScheme pair:MotifGroupScheme ;
    skos:broader pat:GenAIMotifFamily ;
    skos:prefLabel "Retrieval augmented generation"@en ;
    skos:definition """
    Retrieved context grounding a generation step: once, or in the iterative,
    recursive and adaptive loops a judge step drives.
    """@en ;
    dct:source <https://doi.org/10.48550/arXiv.2312.10997> .

pat:GuardrailsMotifGroup
    a skos:Concept ;
    skos:inScheme pair:MotifGroupScheme ;
    skos:broader pat:GenAIMotifFamily ;
    skos:prefLabel "Guardrails"@en ;
    skos:definition """
    Control shapes that screen what reaches a generation step or what leaves
    it: user input, retrieved content and generated responses.
    """@en ;
    dct:source <https://doi.org/10.1016/j.jss.2024.112278> ,
        <https://martinfowler.com/articles/gen-ai-patterns/> .

pat:TuningAndEvaluationMotifGroup
    a skos:Concept ;
    skos:inScheme pair:MotifGroupScheme ;
    skos:broader pat:GenAIMotifFamily ;
    skos:prefLabel "Tuning and evaluation"@en ;
    skos:definition """
    Shapes that change or check a model rather than serve it: fine-tuning a
    pre-trained model, and scoring what a model produced.
    """@en ;
    dct:source <https://doi.org/10.48550/arXiv.2109.01652> ,
        <https://martinfowler.com/articles/gen-ai-patterns/> .

pat:GoalSettingMotifGroup
    a skos:Concept ;
    skos:inScheme pair:MotifGroupScheme ;
    skos:broader pat:AgenticMotifFamily ;
    skos:prefLabel "Goal setting"@en ;
    skos:definition """
    How an agent works out the goal it pursues: from the user's prompt and its
    memory, or also from context it captures itself.
    """@en ;
    dct:source <https://doi.org/10.1016/j.jss.2024.112278> .

pat:PlanningMotifGroup
    a skos:Concept ;
    skos:inScheme pair:MotifGroupScheme ;
    skos:broader pat:AgenticMotifFamily ;
    skos:prefLabel "Planning and reflection"@en ;
    skos:definition """
    How an agent gets its plan from a foundation model, and revises it on
    feedback from the user, itself, another agent or a person.
    """@en ;
    dct:source <https://doi.org/10.1016/j.jss.2024.112278> .

pat:AgentMemoryMotifGroup
    a skos:Concept ;
    skos:inScheme pair:MotifGroupScheme ;
    skos:broader pat:AgenticMotifFamily ;
    skos:prefLabel "Memory"@en ;
    skos:definition """
    What an agent keeps and reads back later: content written to a memory store
    and recalled into a later turn.
    """@en ;
    dct:source <https://genai.owasp.org/> .

pat:ToolUseMotifGroup
    a skos:Concept ;
    skos:inScheme pair:MotifGroupScheme ;
    skos:broader pat:AgenticMotifFamily ;
    skos:prefLabel "Tool use"@en ;
    skos:definition """
    An agent acting through tools: a planned action carried out by a tool,
    which a registry may have been consulted to choose.
    """@en ;
    dct:source <https://doi.org/10.1016/j.jss.2024.112278> .

pat:MultiAgentCooperationMotifGroup
    a skos:Concept ;
    skos:inScheme pair:MotifGroupScheme ;
    skos:broader pat:AgenticMotifFamily ;
    skos:prefLabel "Multi-agent cooperation"@en ;
    skos:definition """
    Agents passing work, votes or arguments to one another.
    """@en ;
    dct:source <https://doi.org/10.1016/j.jss.2024.112278> .

pat:AgentOversightMotifGroup
    a skos:Concept ;
    skos:inScheme pair:MotifGroupScheme ;
    skos:broader pat:AgenticMotifFamily ;
    skos:prefLabel "Oversight"@en ;
    skos:definition """
    Control shapes that stand between an agent's decision and its action: a
    person approving it, or a policy step screening it.
    """@en ;
    dct:source <https://doi.org/10.1016/j.jss.2024.112278> ,
        <https://genai.owasp.org/> .

pat:ServingMotifGroup
    a skos:Concept ;
    skos:inScheme pair:MotifGroupScheme ;
    skos:broader pat:MLSystemMotifFamily ;
    skos:prefLabel "Serving"@en ;
    skos:definition """
    How predictions are served: inline, queued, in batches, after
    preprocessing, or in stages.
    """@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/> .

pat:TrainingMotifGroup
    a skos:Concept ;
    skos:inScheme pair:MotifGroupScheme ;
    skos:broader pat:MLSystemMotifFamily ;
    skos:prefLabel "Training"@en ;
    skos:definition """
    How models are trained: as one scheduled job, or as a pipeline of jobs.
    """@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/> .

pat:LifecycleMotifGroup
    a skos:Concept ;
    skos:inScheme pair:MotifGroupScheme ;
    skos:broader pat:MLSystemMotifFamily ;
    skos:prefLabel "Lifecycle"@en ;
    skos:definition """
    How a trained model reaches serving: through a release step, or
    automatically.
    """@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/> .

pat:OperationMotifGroup
    a skos:Concept ;
    skos:inScheme pair:MotifGroupScheme ;
    skos:broader pat:MLSystemMotifFamily ;
    skos:prefLabel "Operation"@en ;
    skos:definition """
    How a model in service is packaged, loaded, logged and monitored.
    """@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/> .

pat:ExternalDependencyMotifGroup
    a skos:Concept ;
    skos:inScheme pair:MotifGroupScheme ;
    skos:broader pat:SupplyChainMotifFamily ;
    skos:prefLabel "External dependencies"@en ;
    skos:definition """
    A step that uses a resource from outside the system.
    """@en ;
    dct:source <https://genai.owasp.org/resource/owasp-top-10-for-llm-applications-2025/> .

# GenAIMotifFamily
pat:DirectPromptingMotif                  pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:PromptingMotifGroup .
pat:PromptResponseOptimiserMotif          pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:PromptingMotifGroup .
pat:InformationRetrievalMotif             pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:InformationRetrievalMotifGroup .
pat:VectorBasedInformationRetrievalMotif  pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:InformationRetrievalMotifGroup .
pat:LLMBasedInformationRetrievalMotif     pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:InformationRetrievalMotifGroup .
pat:HybridRetrieverMotif                  pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:InformationRetrievalMotifGroup .
pat:QueryRewritingMotif                   pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:InformationRetrievalMotifGroup .
pat:RerankerMotif                         pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:InformationRetrievalMotifGroup .
pat:EmbeddingsMotif                       pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:InformationRetrievalMotifGroup .
pat:RetrievalDataAugmentationMotif        pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:InformationRetrievalMotifGroup .
pat:RetrievalAugmentedGenerationMotif     pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:RetrievalAugmentedGenerationMotifGroup .
pat:IterativeRAGMotif                     pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:RetrievalAugmentedGenerationMotifGroup .

pat:AdaptiveRAGMotif                      pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:RetrievalAugmentedGenerationMotifGroup .
pat:GuardrailsMotif                       pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:GuardrailsMotifGroup .
pat:InputScreeningMotif                   pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:GuardrailsMotifGroup .
pat:OutputScreeningMotif                  pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:GuardrailsMotifGroup .
pat:RetrievalScreeningMotif               pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:GuardrailsMotifGroup .
pat:FineTuningMotif                       pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:TuningAndEvaluationMotifGroup .
pat:EvalsMotif                            pair:motifFamily pat:GenAIMotifFamily ; pair:motifGroup pat:TuningAndEvaluationMotifGroup .

# AgenticMotifFamily
pat:GoalCreationMotif              pair:motifFamily pat:AgenticMotifFamily ; pair:motifGroup pat:GoalSettingMotifGroup .

pat:ModelQueryingMotif             pair:motifFamily pat:AgenticMotifFamily ; pair:motifGroup pat:PlanningMotifGroup .

pat:PlanReflectionMotif            pair:motifFamily pat:AgenticMotifFamily ; pair:motifGroup pat:PlanningMotifGroup .
pat:AgentMemoryLoopMotif           pair:motifFamily pat:AgenticMotifFamily ; pair:motifGroup pat:AgentMemoryMotifGroup .
pat:ToolUsingAgentMotif            pair:motifFamily pat:AgenticMotifFamily ; pair:motifGroup pat:ToolUseMotifGroup .

pat:AgentDelegationMotif           pair:motifFamily pat:AgenticMotifFamily ; pair:motifGroup pat:MultiAgentCooperationMotifGroup .
pat:VotingBasedCooperationMotif    pair:motifFamily pat:AgenticMotifFamily ; pair:motifGroup pat:MultiAgentCooperationMotifGroup .
pat:DebateBasedCooperationMotif    pair:motifFamily pat:AgenticMotifFamily ; pair:motifGroup pat:MultiAgentCooperationMotifGroup .
pat:HumanOversightMotif            pair:motifFamily pat:AgenticMotifFamily ; pair:motifGroup pat:AgentOversightMotifGroup .
pat:ExecutionScreeningMotif        pair:motifFamily pat:AgenticMotifFamily ; pair:motifGroup pat:AgentOversightMotifGroup .

# MLSystemMotifFamily
pat:AsynchronousPredictionMotif  pair:motifFamily pat:MLSystemMotifFamily ; pair:motifGroup pat:ServingMotifGroup .
pat:BatchPredictionMotif         pair:motifFamily pat:MLSystemMotifFamily ; pair:motifGroup pat:ServingMotifGroup .
pat:MultiStagePredictionMotif    pair:motifFamily pat:MLSystemMotifFamily ; pair:motifGroup pat:ServingMotifGroup .
pat:PreprocessPredictionMotif    pair:motifFamily pat:MLSystemMotifFamily ; pair:motifGroup pat:ServingMotifGroup .
pat:SynchronousPredictionMotif   pair:motifFamily pat:MLSystemMotifFamily ; pair:motifGroup pat:ServingMotifGroup .

pat:PipelineTrainingMotif        pair:motifFamily pat:MLSystemMotifFamily ; pair:motifGroup pat:TrainingMotifGroup .
pat:TrainThenServeMotif          pair:motifFamily pat:MLSystemMotifFamily ; pair:motifGroup pat:LifecycleMotifGroup .
pat:TrainingToServingMotif       pair:motifFamily pat:MLSystemMotifFamily ; pair:motifGroup pat:LifecycleMotifGroup .
pat:ModelInImageMotif            pair:motifFamily pat:MLSystemMotifFamily ; pair:motifGroup pat:OperationMotifGroup .
pat:ModelLoadMotif               pair:motifFamily pat:MLSystemMotifFamily ; pair:motifGroup pat:OperationMotifGroup .
pat:PredictionLoggingMotif       pair:motifFamily pat:MLSystemMotifFamily ; pair:motifGroup pat:OperationMotifGroup .
pat:PredictionMonitoringMotif    pair:motifFamily pat:MLSystemMotifFamily ; pair:motifGroup pat:OperationMotifGroup .

# SupplyChainMotifFamily
pat:ExternalDependencyMotif  pair:motifFamily pat:SupplyChainMotifFamily ; pair:motifGroup pat:ExternalDependencyMotifGroup .

