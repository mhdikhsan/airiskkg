# ML system design motifs derived from the operation design patterns

pat:PredictionLoggingMotif
    a pair:GraphMotif ;
    pair:implementedBy pat:PredLog_MatchingOQP ;
    rdfs:label "Prediction Logging Motif"@en ;
    dct:description "A logging step reads a prediction step's request and result and writes them to a prediction log."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Prediction-log-pattern/design_en.html> ;
    pair:derivedFrom pat:Cite_PredictionLog ;
    pair:hasPatternNode
        pat:PredLog_RequestNode ,
        pat:PredLog_ResultNode ,
        pat:PredLog_PredictionStepNode ,
        pat:PredLog_LoggingStepNode ,
        pat:PredLog_LogRecordNode ;
    pair:hasPatternEdge
        pat:PredLog_PredictionUsesRequestEdge ,
        pat:PredLog_PredictionProducesResultEdge ,
        pat:PredLog_LoggingUsesRequestEdge ,
        pat:PredLog_LoggingUsesResultEdge ,
        pat:PredLog_LoggingProducesLogEdge .

pat:PredLog_RequestNode
    a pair:PatternNode ;
    rdfs:label "Logged prediction request"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionRequest .

pat:PredLog_ResultNode
    a pair:PatternNode ;
    rdfs:label "Logged prediction result"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionResult .

pat:PredLog_PredictionStepNode
    a pair:PatternNode ;
    rdfs:label "Logged prediction step"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:PredictionStep .

pat:PredLog_LoggingStepNode
    a pair:PatternNode ;
    rdfs:label "Prediction logging step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:LoggingStep .

pat:PredLog_LogRecordNode
    a pair:PatternNode ;
    rdfs:label "Prediction log record"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionLog .

pat:PredLog_PredictionUsesRequestEdge
    a pair:PatternEdge ;
    rdfs:label "logged prediction uses request"@en ;
    pair:sourcePatternNode pat:PredLog_PredictionStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:PredLog_RequestNode .

pat:PredLog_PredictionProducesResultEdge
    a pair:PatternEdge ;
    rdfs:label "logged prediction produces result"@en ;
    pair:sourcePatternNode pat:PredLog_PredictionStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:PredLog_ResultNode .


pat:PredLog_LoggingUsesRequestEdge
    a pair:PatternEdge ;
    rdfs:label "logging uses prediction request"@en ;
    pair:sourcePatternNode pat:PredLog_LoggingStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:PredLog_RequestNode .

pat:PredLog_LoggingUsesResultEdge
    a pair:PatternEdge ;
    rdfs:label "logging uses prediction result"@en ;
    pair:sourcePatternNode pat:PredLog_LoggingStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:PredLog_ResultNode .

pat:PredLog_LoggingProducesLogEdge
    a pair:PatternEdge ;
    rdfs:label "logging produces prediction log"@en ;
    pair:sourcePatternNode pat:PredLog_LoggingStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:PredLog_LogRecordNode .

pat:PredictionMonitoringMotif
    a pair:GraphMotif ;
    pair:implementedBy pat:PredMon_MatchingOQP ;
    rdfs:label "Prediction Monitoring Motif"@en ;
    dct:description "A monitoring step compares a prediction log with a baseline and produces alerts."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Prediction-monitoring-pattern/design_en.html> ;
    pair:derivedFrom pat:Cite_PredictionMonitoring ;
    pair:hasPatternNode
        pat:PredMon_LogNode ,
        pat:PredMon_BaselineNode ,
        pat:PredMon_MonitoringStepNode ,
        pat:PredMon_AlertNode ;
    pair:hasPatternEdge
        pat:PredMon_MonitoringUsesLogEdge ,
        pat:PredMon_MonitoringUsesBaselineEdge ,
        pat:PredMon_MonitoringProducesAlertEdge .

pat:PredMon_LogNode
