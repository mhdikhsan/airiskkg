# RAG variants from Gao et al.'s Figure 5. Retrieval feeds generation as in the
# RAG motif; what tells them apart is what the retrieval step reads back. The
# context may pass intermediate steps on its way to generation, as in RAG.

pat:IterativeRAGMotif
    a pair:GraphMotif ;
    rdfs:label "Iterative RAG Motif"@en ;
    dct:description "Retrieval and generation alternate: a judge step reads each answer, and the retrieval step retrieves again from its decision, directly or through a sub-query a reformulation step makes of it."@en ;
    rdfs:comment "The generation step may read the retrieved context through intermediate steps (reranking, aggregation), as in the RAG motif; the template draws the direct edge."@en ;
    pair:derivedFrom pat:Cite_IterativeRetrieval ,
        pat:Cite_RecursiveRetrieval ;
    pair:hasPatternNode
        pat:IterRAG_QueryNode ,
        pat:IterRAG_KnowledgeSourceNode ,
        pat:IterRAG_RetrievalStepNode ,
        pat:IterRAG_RetrievedContextNode ,
        pat:IterRAG_LLMNode ,
        pat:IterRAG_GenerationStepNode ,
        pat:IterRAG_AnswerNode ,
        pat:IterRAG_JudgeStepNode ,
        pat:IterRAG_DecisionNode ;
    pair:hasPatternEdge
        pat:IterRAG_RetrievalUsesQueryEdge ,
        pat:IterRAG_RetrievalUsesKnowledgeSourceEdge ,
        pat:IterRAG_RetrievalProducesContextEdge ,
        pat:IterRAG_GenerationUsesContextEdge ,
        pat:IterRAG_GenerationUsesLLMEdge ,
        pat:IterRAG_GenerationProducesAnswerEdge ,
        pat:IterRAG_JudgeUsesAnswerEdge ,
        pat:IterRAG_JudgeProducesDecisionEdge ,
        pat:IterRAG_RetrievalUsesDecisionEdge ;
    pair:implementedBy pat:IterRAG_MatchingOQP .

