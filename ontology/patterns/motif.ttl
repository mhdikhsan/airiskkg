    pair:expectedRole pair:RetrievedContext .

pat:Reranker_RerankingUsesCandidateSetEdge
    a pair:PatternEdge ;
    rdfs:label "reranking uses candidate set"@en ;
    pair:sourcePatternNode pat:Reranker_RerankingStepNode ;
    pair:patternPredicate beam:use ;
