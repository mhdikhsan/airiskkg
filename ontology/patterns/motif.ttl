pat:AdaptiveRAGMotif
    a pair:GraphMotif ;
    rdfs:label "Adaptive RAG Motif"@en ;
    dct:description "A judge step reads the query and decides whether to retrieve, a retrieval step acts on that decision, and a generation step answers from what it retrieved."@en ;
    rdfs:comment "The generation step may read the retrieved context through intermediate steps, as in the RAG motif; the template draws the direct edge. The figure's later judge-and-transform loop is the Recursive RAG motif, which co-matches when it is drawn."@en ;
    pair:derivedFrom pat:Cite_AdaptiveRetrieval ;
    pair:hasPatternNode
        pat:AdaRAG_QueryNode ,
        pat:AdaRAG_JudgeStepNode ,
        pat:AdaRAG_DecisionNode ,
        pat:AdaRAG_KnowledgeSourceNode ,
        pat:AdaRAG_RetrievalStepNode ,
        pat:AdaRAG_RetrievedContextNode ,
        pat:AdaRAG_LLMNode ,
        pat:AdaRAG_GenerationStepNode ,
        pat:AdaRAG_AnswerNode ;
    pair:hasPatternEdge
        pat:AdaRAG_JudgeUsesQueryEdge ,
        pat:AdaRAG_JudgeProducesDecisionEdge ,
        pat:AdaRAG_RetrievalUsesDecisionEdge ,
        pat:AdaRAG_RetrievalUsesKnowledgeSourceEdge ,
        pat:AdaRAG_RetrievalProducesContextEdge ,
        pat:AdaRAG_GenerationUsesContextEdge ,
        pat:AdaRAG_GenerationUsesLLMEdge ,
        pat:AdaRAG_GenerationProducesAnswerEdge ;
    pair:implementedBy pat:AdaRAG_MatchingOQP .

