    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:Reranker_RankedContextNode .

# Input screening, and output screening, as motifs in their own right.
#
# GuardrailsMotif is 8 nodes and 8 edges: the whole guarded-generation
# topology. Most systems screen on one side only, and most risks are addressed
# by one side only - prompt injection needs something between the untrusted
# content and the prompt, and nothing about that requires an output guardrail
# or a sanitized-response node. Asking a modeler for 16 constraints to say
# "we filter the input" was why the control layer had nothing insertable to
# point at.
#
# These are 3 nodes and 2 edges each, and they nest inside GuardrailsMotif:
# a fully guarded system matches all three.
pat:InputScreeningMotif
    a pair:GraphMotif ;
    rdfs:label "Input Screening Motif"@en ;
    dct:description "An input guardrail screens the user's input and produces a decision that the generation step reads."@en ;
    pair:derivedFrom pat:Cite_Guardrails ,
        pat:Cite_MultimodalGuardrails ;
    pair:hasPatternNode
        pat:InputScreening_UserInputNode ,
        pat:InputScreening_ScreeningStepNode ,
        pat:InputScreening_DecisionNode ,
        pat:InputScreening_GenerationStepNode ;
    pair:hasPatternEdge
        pat:InputScreening_ScreeningUsesInputEdge ,
        pat:InputScreening_ScreeningProducesDecisionEdge ,
        pat:InputScreening_GenerationUsesDecisionEdge ;
    pair:implementedBy pat:InputScreening_MatchingOQP .

pat:InputScreening_UserInputNode
    a pair:PatternNode ;
    rdfs:label "Screened user input"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:InputScreening_ScreeningStepNode
    a pair:PatternNode ;
    rdfs:label "Input screening step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:InputGuardrailStep .

pat:InputScreening_DecisionNode
    a pair:PatternNode ;
    rdfs:label "Input screening decision"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:GuardrailDecision .

pat:InputScreening_GenerationStepNode
    a pair:PatternNode ;
    rdfs:label "Protected generation step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:GenerationStep .

pat:InputScreening_ScreeningUsesInputEdge
    a pair:PatternEdge ;
    rdfs:label "screening step uses the user input"@en ;
    pair:sourcePatternNode pat:InputScreening_ScreeningStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:InputScreening_UserInputNode .


pat:InputScreening_ScreeningProducesDecisionEdge
    a pair:PatternEdge ;
    rdfs:label "input screening step produces a decision"@en ;
    pair:sourcePatternNode pat:InputScreening_ScreeningStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:InputScreening_DecisionNode .

pat:InputScreening_GenerationUsesDecisionEdge
    a pair:PatternEdge ;
    rdfs:label "generation uses the input screening decision"@en ;
    pair:sourcePatternNode pat:InputScreening_GenerationStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:InputScreening_DecisionNode .


pat:OutputScreeningMotif
    a pair:GraphMotif ;
    rdfs:label "Output Screening Motif"@en ;
    dct:description "An output guardrail reads the response a generation step produces."@en ;
    pair:derivedFrom pat:Cite_Guardrails ,
        pat:Cite_MultimodalGuardrails ;
    pair:hasPatternNode
        pat:OutputScreening_GenerationStepNode ,
        pat:OutputScreening_ResponseNode ,
        pat:OutputScreening_ScreeningStepNode ;
    pair:hasPatternEdge
        pat:OutputScreening_GenerationProducesResponseEdge ,
        pat:OutputScreening_ScreeningUsesResponseEdge ;
    pair:implementedBy pat:OutputScreening_MatchingOQP .

pat:OutputScreening_GenerationStepNode
    a pair:PatternNode ;
    rdfs:label "Generation step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:GenerationStep .

pat:OutputScreening_ResponseNode
    a pair:PatternNode ;
    rdfs:label "Screened response"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:LLMResponse .

pat:OutputScreening_ScreeningStepNode
    a pair:PatternNode ;
    rdfs:label "Output screening step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:OutputGuardrailStep .

pat:OutputScreening_GenerationProducesResponseEdge
    a pair:PatternEdge ;
    rdfs:label "generation produces the response"@en ;
    pair:sourcePatternNode pat:OutputScreening_GenerationStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:OutputScreening_ResponseNode .

pat:OutputScreening_ScreeningUsesResponseEdge
    a pair:PatternEdge ;
    rdfs:label "screening step uses the response"@en ;
    pair:sourcePatternNode pat:OutputScreening_ScreeningStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:OutputScreening_ResponseNode .


# The RAG guardrail of Liu et al.'s multimodal guardrails: Input Screening's
# shape with retrieved content where the user input was. It is what the input
# screening rewrite builds when the untrusted content it screens was retrieved.
pat:RetrievalScreeningMotif
    a pair:GraphMotif ;
    rdfs:label "Retrieval Screening Motif"@en ;
    dct:description "An input guardrail screens retrieved context and produces a decision that the generation step reads."@en ;
    pair:derivedFrom pat:Cite_MultimodalGuardrails ;
    pair:hasPatternNode
        pat:RetrievalScreening_RetrievedContextNode ,
        pat:RetrievalScreening_ScreeningStepNode ,
        pat:RetrievalScreening_DecisionNode ,
        pat:RetrievalScreening_GenerationStepNode ;
    pair:hasPatternEdge
        pat:RetrievalScreening_ScreeningUsesContextEdge ,
        pat:RetrievalScreening_ScreeningProducesDecisionEdge ,
        pat:RetrievalScreening_GenerationUsesDecisionEdge ;
    pair:implementedBy pat:RetrievalScreening_MatchingOQP .

pat:RetrievalScreening_RetrievedContextNode
    a pair:PatternNode ;
    rdfs:label "Screened retrieved context"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:RetrievedContext .

pat:RetrievalScreening_ScreeningStepNode
    a pair:PatternNode ;
    rdfs:label "Retrieval guardrail step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:InputGuardrailStep .

pat:RetrievalScreening_DecisionNode
    a pair:PatternNode ;
    rdfs:label "Retrieval screening decision"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:GuardrailDecision .

pat:RetrievalScreening_GenerationStepNode
    a pair:PatternNode ;
    rdfs:label "Protected generation step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:GenerationStep .

pat:RetrievalScreening_ScreeningUsesContextEdge
    a pair:PatternEdge ;
    rdfs:label "screening step uses the retrieved context"@en ;
    pair:sourcePatternNode pat:RetrievalScreening_ScreeningStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:RetrievalScreening_RetrievedContextNode .

pat:RetrievalScreening_ScreeningProducesDecisionEdge
    a pair:PatternEdge ;
    rdfs:label "screening step produces a decision"@en ;
    pair:sourcePatternNode pat:RetrievalScreening_ScreeningStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:RetrievalScreening_DecisionNode .

pat:RetrievalScreening_GenerationUsesDecisionEdge
    a pair:PatternEdge ;
    rdfs:label "generation uses the screening decision"@en ;
    pair:sourcePatternNode pat:RetrievalScreening_GenerationStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:RetrievalScreening_DecisionNode .


pat:GuardrailsMotif
    a pair:GraphMotif ;
    pair:implementedBy pat:Guardrails_MatchingOQP ;
    rdfs:label "Guardrails Motif"@en ;
    dct:description "An input guardrail screens the user's input before a generation step uses it, and an output guardrail screens the response it produces."@en ;
    rdfs:comment "Flow-agnostic: the guarded generation is anchored by the guardrail decision it consumes rather than by the user prompt, so it matches whether generation reads the prompt directly or a prompt built from it."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:derivedFrom pat:Cite_Guardrails ,
        pat:Cite_MultimodalGuardrails ;
    pair:hasPatternNode
        pat:Guardrails_UserPromptNode ,
        pat:Guardrails_InputGuardrailStepNode ,
        pat:Guardrails_InputDecisionNode ,
        pat:Guardrails_LLMNode ,
        pat:Guardrails_GenerationStepNode ,
        pat:Guardrails_RawResponseNode ,
        pat:Guardrails_OutputGuardrailStepNode ,
        pat:Guardrails_SanitizedResponseNode ;
    pair:hasPatternEdge
        pat:Guardrails_InputGuardrailUsesPromptEdge ,
        pat:Guardrails_InputGuardrailProducesDecisionEdge ,
        pat:Guardrails_GenerationUsesInputDecisionEdge ,
