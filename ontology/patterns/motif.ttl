    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:PipeTrain_SourceDataNode .

pat:PipeTrain_PreprocessProducesIntermediateEdge
    a pair:PatternEdge ;
    rdfs:label "pipeline preprocess produces intermediate data"@en ;
    pair:sourcePatternNode pat:PipeTrain_PreprocessJobNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:PipeTrain_IntermediateDataNode .


pat:PipeTrain_TrainingUsesIntermediateEdge
    a pair:PatternEdge ;
    rdfs:label "pipeline training uses intermediate data"@en ;
    pair:sourcePatternNode pat:PipeTrain_TrainingJobNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:PipeTrain_IntermediateDataNode .

pat:PipeTrain_TrainingProducesModelEdge
    a pair:PatternEdge ;
    rdfs:label "pipeline training produces model artifact"@en ;
