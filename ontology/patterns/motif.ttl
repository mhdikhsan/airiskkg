    skos:prefLabel "Prompting"@en ;
    dct:bibliographicCitation "Wei, J., Bosma, M., Zhao, V. Y., Guu, K., Yu, A. W., Lester, B., Du, N., Dai, A. M., & Le, Q. V. (2021). Finetuned language models are zero-shot learners (arXiv:2109.01652). arXiv."@en ;
    dct:source <https://doi.org/10.48550/arXiv.2109.01652> .

pat:Cite_PretrainFinetune a pair:DesignPatternCitation ;
    skos:prefLabel "Pretrain-finetune"@en ;
    dct:bibliographicCitation "Wei, J., Bosma, M., Zhao, V. Y., Guu, K., Yu, A. W., Lester, B., Du, N., Dai, A. M., & Le, Q. V. (2021). Finetuned language models are zero-shot learners (arXiv:2109.01652). arXiv."@en ;
    dct:source <https://doi.org/10.48550/arXiv.2109.01652> .

pat:Cite_InstructionTuning a pair:DesignPatternCitation ;
    skos:prefLabel "Instruction tuning"@en ;
    dct:bibliographicCitation "Wei, J., Bosma, M., Zhao, V. Y., Guu, K., Yu, A. W., Lester, B., Du, N., Dai, A. M., & Le, Q. V. (2021). Finetuned language models are zero-shot learners (arXiv:2109.01652). arXiv."@en ;
    dct:source <https://doi.org/10.48550/arXiv.2109.01652> .


# Motif 0: Information Retrieval

pat:InformationRetrievalMotif
    a pair:GraphMotif ;
    rdfs:label "Information Retrieval Motif"@en ;
    dct:description "A retrieval step reads a query and a knowledge source and produces retrieved context."@en ;
    pair:derivedFrom pat:Cite_RetrievalAugmentedGeneration ,
        pat:Cite_AgentRetrievalAugmentedGeneration ,
        pat:Cite_NaiveRAG ;
    pair:hasPatternNode
        pat:IR_QueryNode ,
        pat:IR_KnowledgeSourceNode ,
        pat:IR_RetrievalStepNode ,
        pat:IR_RetrievedContextNode ;
    pair:hasPatternEdge
        pat:IR_RetrievalUsesQueryEdge ,
        pat:IR_RetrievalUsesKnowledgeSourceEdge ,
        pat:IR_RetrievalProducesContextEdge ;
    pair:implementedBy pat:IR_MatchingOQP .

pat:IR_QueryNode
    a pair:PatternNode ;
    rdfs:label "Query"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:IR_KnowledgeSourceNode
    a pair:PatternNode ;
    rdfs:label "Knowledge source"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:KnowledgeSource .

pat:IR_RetrievalStepNode
    a pair:PatternNode ;
    rdfs:label "Retrieval step"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:RetrievalStep .

pat:IR_RetrievedContextNode
    a pair:PatternNode ;
    rdfs:label "Retrieved context"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:RetrievedContext .

pat:IR_RetrievalUsesQueryEdge
    a pair:PatternEdge ;
    rdfs:label "retrieval uses query"@en ;
    pair:sourcePatternNode pat:IR_RetrievalStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:IR_QueryNode .

pat:IR_RetrievalUsesKnowledgeSourceEdge
    a pair:PatternEdge ;
    rdfs:label "retrieval uses knowledge source"@en ;
    pair:sourcePatternNode pat:IR_RetrievalStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:IR_KnowledgeSourceNode .

pat:IR_RetrievalProducesContextEdge
    a pair:PatternEdge ;
    rdfs:label "retrieval produces retrieved context"@en ;
    pair:sourcePatternNode pat:IR_RetrievalStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:IR_RetrievedContextNode .


# Motif 1: Vector-based Information Retrieval
pat:VectorBasedInformationRetrievalMotif
    a pair:GraphMotif ;
    rdfs:label "Vector-based Information Retrieval Motif"@en ;
    dct:description "A retrieval step reads a query and a vector store and produces retrieved context."@en ;
    pair:derivedFrom pat:Cite_RetrievalAugmentedGeneration ,
        pat:Cite_AgentRetrievalAugmentedGeneration ,
        pat:Cite_NaiveRAG ;
    pair:hasPatternNode
        pat:VectorIR_QueryNode ,
        pat:VectorIR_VectorStoreNode ,
        pat:VectorIR_RetrievalStepNode ,
        pat:VectorIR_RetrievedResultNode ;
    pair:hasPatternEdge
        pat:VectorIR_RetrievalUsesQueryEdge ,
        pat:VectorIR_RetrievalUsesVectorStoreEdge ,
        pat:VectorIR_RetrievalProducesResultEdge ;
    pair:implementedBy pat:VectorIR_MatchingOQP .

pat:VectorIR_QueryNode
    a pair:PatternNode ;
    rdfs:label "Query"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:VectorIR_VectorStoreNode
    a pair:PatternNode ;
