# GenAI product motifs 

pat:DirectPromptingMotif
    a pair:GraphMotif ;
    rdfs:label "Direct Prompting Motif"@en ;   
    dct:description """
    Architectural motif in which a user query is handled directly by a
    generative model step and produces a user-facing answer. 
    """@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:derivedFrom <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternNode
        pat:DP_QueryNode ,
        pat:DP_ModelNode ,
        pat:DP_GenerationStepNode ,
        pat:DP_AnswerNode ;
    pair:hasPatternEdge
        pat:DP_GenerationUsesQueryEdge ,
        pat:DP_GenerationUsesModelEdge ,
        pat:DP_GenerationProducesAnswerEdge ;
    pair:implementedBy pat:DP_MatchingOQP .

pat:DP_QueryNode
    a pair:PatternNode ;
    rdfs:label "Query node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:DP_ModelNode
    a pair:PatternNode ;
    rdfs:label "LLM node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:GenerativeModel .

pat:DP_GenerationStepNode
    a pair:PatternNode ;
    rdfs:label "Direct LLM generation step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:GenerationStep .

pat:DP_AnswerNode
    a pair:PatternNode ;
    rdfs:label "Answer node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserFacingOutput .

pat:DP_GenerationUsesQueryEdge
    a pair:PatternEdge ;
    rdfs:label "direct LLM generation uses query"@en ;
    pair:sourcePatternNode pat:DP_GenerationStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:DP_QueryNode .

pat:DP_GenerationUsesModelEdge
    a pair:PatternEdge ;
    rdfs:label "direct LLM generation uses generative model"@en ;
    pair:sourcePatternNode pat:DP_GenerationStepNode ;
    pair:patternPredicate beam:use ;
    pair:targetPatternNode pat:DP_ModelNode .

pat:DP_GenerationProducesAnswerEdge
    a pair:PatternEdge ;
    rdfs:label "direct LLM generation produces answer"@en ;
    pair:sourcePatternNode pat:DP_GenerationStepNode ;
    pair:patternPredicate beam:produce ;
    pair:targetPatternNode pat:DP_AnswerNode .

