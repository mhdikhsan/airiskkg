# ML system design motifs derived from the lifecycle design patterns

pat:TrainThenServeMotif
    a pair:GraphMotif ;
    pair:implementedBy pat:TrainServe_MatchingOQP ;
    rdfs:label "Train-Then-Serve Motif"@en ;
    dct:description "An evaluation step reads a trained model artifact and produces a release approval, which a deployment step reads before serving the model to a prediction step."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Lifecycle-patterns/Train-then-serve-pattern/design_en.html> ;
    pair:derivedFrom pat:Cite_TrainThenServe ;
    pair:hasPatternNode
        pat:TrainServe_TrainingStepNode ,
        pat:TrainServe_CandidateModelNode ,
        pat:TrainServe_EvaluationStepNode ,
        pat:TrainServe_ApprovalNode ,
