        pat:TrainToServe_TrainingProducesModelEdge ,
        pat:TrainToServe_TrainingInformsDeploymentEdge ,
        pat:TrainToServe_DeploymentUsesModelEdge ,
        pat:TrainToServe_DeploymentProducesDeployedModelEdge ,
        pat:TrainToServe_DeploymentInformsPredictionEdge ,
        pat:TrainToServe_PredictionUsesModelEdge .

