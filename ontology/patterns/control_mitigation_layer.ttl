@prefix pat:     <http://w3id.org/airiskkg/patterns#> .
@prefix pair:    <http://w3id.org/airiskkg/pair-ai#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix mitctrl: <http://w3id.org/airiskkg/taxonomy/mit-ai-risk-control#> .

<http://w3id.org/airiskkg/patterns/control-mitigation-layer#>
    a owl:Ontology ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:title "PAIR-AI Control Mitigation Layer"@en ;
    dct:description """
    Classifies PAIR-AI's own actionable controls , as technical or
    non-technical , and links the architecturally detectable
    technical controls to the motif(s) that can structurally realize them. 
    """@en ;
    dct:source "PAIR-AI risk-to-mitigation connection reference (technical vs non-technical criterion; architectural-detectability axis)." ;
    owl:imports <http://w3id.org/airiskkg/pair-ai#> ,
                <http://w3id.org/airiskkg/patterns/motif-library#> ,
                <http://w3id.org/airiskkg/patterns/risk-pattern-library#> .



# Technical controls


pat:Control_GroundingAndVerification
    pair:controlNature pair:TechnicalControl ;
    rdfs:comment "Realizing motifs split along the control's own name. The retrieval motifs (RAG, Vector IR, Hybrid Retriever, Reranker) realize GROUNDING, and are themselves risk-bearing here - adding them mitigates ungrounded generation but introduces retrieval-side candidate risks (LLM01/02/08). EvalsMotif realizes VERIFICATION, and that is the half which answers misinformation-from-weak-grounding: the pattern only fires on a RAG match, so grounding is already present by construction and more retrieval cannot clear it. Listing only the retrieval motifs left the control looking applicable while none of its realizations could change the finding. Re-assess the amended architecture either way."@en ;
    pair:realizedByMotif pat:RetrievalAugmentedGenerationMotif ,
                         pat:VectorBasedInformationRetrievalMotif ,
                         pat:HybridRetrieverMotif ,
                         pat:RerankerMotif ,
                         pat:EvalsMotif .

pat:Control_Guardrails
    pair:controlNature pair:TechnicalControl ;
    rdfs:comment "Realized by GuardrailsMotif, which is itself risk-bearing (improper-output-handling, system-prompt-leakage); adding it constrains I/O but is not risk-free. Re-assess the amended architecture."@en ;
    pair:realizedByMotif pat:GuardrailsMotif ,
                         pat:InputScreeningMotif ,
                         pat:OutputScreeningMotif .

# One side each, not the whole guarded-generation topology. Pointing these at
# GuardrailsMotif asked for 16 constraints to express a control that needs 5,
# and the risk each addresses lives on one side: nothing about prompt injection
# requires an output guardrail.
pat:Control_InputValidationAndPromptIsolation
    pair:controlNature pair:TechnicalControl ;
    pair:realizedByMotif pat:InputScreeningMotif .

pat:Control_OutputValidationAndSanitization
    pair:controlNature pair:TechnicalControl ;
    pair:realizedByMotif pat:OutputScreeningMotif .

pat:Control_LoggingMonitoringAndEvals
    pair:controlNature pair:TechnicalControl ;
    pair:realizedByMotif pat:PredictionLoggingMotif ,
                         pat:PredictionMonitoringMotif ,
                         pat:EvalsMotif .


# Executable rewrites: how a control is applied to a graph.
#
# A control says what should be true; these say which triples make it so. They
# are to a control what a match query is to a motif, and they are registered the
# same way - except that pair:MitigationApplication is a distinct output type,
# so the assessment pipeline (which asks only for MotifMatch and RiskFinding)
# never runs them. A mitigation query inside an assessment would mitigate every
# finding it could see, and nothing would ever be reported.
#
# Each is bound to the risk pattern it answers, because it reads that finding's
# evidence to know where the control belongs.

pat:InputScreening_MitigationOQP
    a pair:PatternImplementation ;
    rdfs:label "Insert input screening on the path a prompt-injection finding cites"@en ;
    pair:implementsControl pat:Control_InputValidationAndPromptIsolation ;
    pair:realizesMotif pat:InputScreeningMotif ;
    pair:mitigatesRiskPattern pat:PromptInjectionRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/mitigation/input_screening.rq" ;
    pair:producesOutputType pair:MitigationApplication .

pat:OutputScreening_MitigationOQP
    a pair:PatternImplementation ;
    rdfs:label "Insert output screening between a generation step and its response"@en ;
    pair:implementsControl pat:Control_OutputValidationAndSanitization ;
    pair:realizesMotif pat:OutputScreeningMotif ;
    pair:mitigatesRiskPattern pat:ImproperOutputHandlingRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/mitigation/output_screening.rq" ;
    pair:producesOutputType pair:MitigationApplication .


pat:SensitiveOutputScreening_MitigationOQP
    a pair:PatternImplementation ;
    rdfs:label "Screen a user-facing sink that carries protected content"@en ;
    pair:implementsControl pat:Control_OutputValidationAndSanitization ;
    pair:realizesMotif pat:OutputScreeningMotif ;
    pair:mitigatesRiskPattern pat:SensitiveInformationDisclosureRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/mitigation/sensitive_output_screening.rq" ;
    pair:producesOutputType pair:MitigationApplication .

pat:MemoryValidation_MitigationOQP
    a pair:PatternImplementation ;
    rdfs:label "Validate what is written to agent memory"@en ;
    pair:implementsControl pat:Control_InputValidationAndPromptIsolation ;
    pair:mitigatesRiskPattern pat:MemoryPoisoningRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/mitigation/memory_validation.rq" ;
    pair:producesOutputType pair:MitigationApplication .

pat:ToolMediation_MitigationOQP
    a pair:PatternImplementation ;
    rdfs:label "Mediate an agent tool action with policy enforcement"@en ;
    pair:implementsControl pat:Control_ToolPermissionBoundaries ;
    pair:mitigatesRiskPattern pat:ToolMisuseRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/mitigation/tool_mediation.rq" ;
    pair:producesOutputType pair:MitigationApplication .


pat:OutputRedaction_MitigationOQP
    a pair:PatternImplementation ;
    rdfs:label "Redact protected content before a user-facing sink"@en ;
    pair:implementsControl pat:Control_DataMinimizationAndRedaction ;
    pair:mitigatesRiskPattern pat:SensitiveInformationDisclosureRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/mitigation/output_redaction.rq" ;
    pair:producesOutputType pair:MitigationApplication .

pat:ResponseVerification_MitigationOQP
    a pair:PatternImplementation ;
    rdfs:label "Verify a generated response against its evidence"@en ;
    pair:implementsControl pat:Control_LoggingMonitoringAndEvals ;
    pair:realizesMotif pat:EvalsMotif ;
    pair:mitigatesRiskPattern pat:MisinformationFromWeakGroundingRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/mitigation/response_verification.rq" ;
    pair:producesOutputType pair:MitigationApplication .

pat:GroundingVerification_MitigationOQP
    a pair:PatternImplementation ;
    rdfs:label "Verify a generated response, the verification half of grounding and verification"@en ;
    pair:implementsControl pat:Control_GroundingAndVerification ;
    pair:realizesMotif pat:EvalsMotif ;
    pair:mitigatesRiskPattern pat:MisinformationFromWeakGroundingRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/mitigation/response_verification.rq" ;
    pair:producesOutputType pair:MitigationApplication .

pat:RateLimiting_MitigationOQP
    a pair:PatternImplementation ;
    rdfs:label "Bound an unbounded loop or call path"@en ;
    pair:implementsControl pat:Control_RateLimitBudgetAndLoopControl ;
    pair:mitigatesRiskPattern pat:UnboundedConsumptionRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/mitigation/rate_limiting.rq" ;
    pair:producesOutputType pair:MitigationApplication .


# --- technical (architectural footprint) but no motif in the library yet ---

pat:Control_DataMinimizationAndRedaction  pair:controlNature pair:TechnicalControl .
pat:Control_RetrievalAccessControl        pair:controlNature pair:TechnicalControl .
pat:Control_ToolPermissionBoundaries      pair:controlNature pair:TechnicalControl .
pat:Control_SystemPromptSecrecy           pair:controlNature pair:TechnicalControl .
pat:Control_RateLimitBudgetAndLoopControl pair:controlNature pair:TechnicalControl .



# Non-technical controls (governance / process / documentation / disclosure)


pat:Control_ModelAndDependencyProvenance   pair:controlNature pair:NonTechnicalControl .
pat:Control_TrustedTrainingAndIndexingData pair:controlNature pair:NonTechnicalControl .

# --- technical: acts on data, prompt, retrieval, or runtime -----------------

mitctrl:data-minimization                   pair:controlNature pair:TechnicalControl .
mitctrl:input-output-filtering              pair:controlNature pair:TechnicalControl .
mitctrl:post-deployment-behavior-monitoring pair:controlNature pair:TechnicalControl .
mitctrl:privacy-control-for-user-data       pair:controlNature pair:TechnicalControl .
mitctrl:retrieval-quality-evaluation        pair:controlNature pair:TechnicalControl .


mitctrl:prompt-context-limiting             pair:controlNature pair:TechnicalControl .
mitctrl:redaction                           pair:controlNature pair:TechnicalControl .
mitctrl:retrieval-source-filtering          pair:controlNature pair:TechnicalControl .

# --- non-technical: process, governance, documentation ---------------------

mitctrl:data-curation-process               pair:controlNature pair:NonTechnicalControl .
mitctrl:human-oversight-protocol            pair:controlNature pair:NonTechnicalControl .
mitctrl:incident-response-plan              pair:controlNature pair:NonTechnicalControl .
mitctrl:pre-deployment-risk-assessment      pair:controlNature pair:NonTechnicalControl .
mitctrl:risk-register                       pair:controlNature pair:NonTechnicalControl .
mitctrl:system-architecture-documentation   pair:controlNature pair:NonTechnicalControl .


mitctrl:red-teaming                         pair:controlNature pair:NonTechnicalControl .
mitctrl:threat-modelling                    pair:controlNature pair:NonTechnicalControl .
