# Agentic risk patterns 

pat:ToolMisuse_UnmediatedActionCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "A planned action reaches a tool or state change with no mediating control"@en ;
    pair:operationalizesRiskCondition asi:condition-tool-invocation-without-mediation .

pat:MemoryPoisoning_UnvalidatedWriteCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "Content is committed to agent memory without a represented validation step"@en ;
    pair:operationalizesRiskCondition asi:condition-untrusted-content-written-to-agent-memory .

pat:MemoryPoisoning_RecalledIntoGenerationCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "Recalled agent memory reaches a later generation context"@en ;
    pair:operationalizesRiskCondition asi:condition-agent-memory-reread-into-generation .

pat:ToolMisuseRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom asi:asi02-tool-misuse ;
    dct:source <https://genai.owasp.org/> ;
    rdfs:label "Tool misuse risk pattern"@en ;
    dct:description """
    Applies to a Tool-Using Agent or Tool/Agent Registry match where the planning
    step's decision reaches a tool invocation or state change without any
    represented policy enforcement, human approval, or rate/budget control in
    between.
    """@en ;
    pair:hasMotif pat:ToolUsingAgentMotif ,
        pat:ToolAgentRegistryMotif ;
    pair:hasMechanism asi:mechanism-unconstrained-tool-execution ;
    pair:hasApplicabilityCondition pat:ToolMisuse_UnmediatedActionCondition ;
    pair:mayIndicateRisk
        asi:asi02-tool-misuse ,
        owasp:llm06-excessive-agency ,
        mit:subdomain-2-2 ,
        mit:subdomain-5-2 ,
        eticas:unsafe-tool-calls ;
    pair:suggestedControl
        pat:Control_ToolPermissionBoundaries ,
        pat:Control_RateLimitBudgetAndLoopControl ,
        pat:Control_LoggingMonitoringAndEvals ;
    pair:implementedBy pat:ToolMisuseOQP .

pat:MemoryPoisoningRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom asi:asi06-memory-and-context-poisoning ;
    dct:source <https://genai.owasp.org/> ;
    rdfs:label "Memory and context poisoning risk pattern"@en ;
    dct:description """
    Applies to an Agent Memory Loop match where content is committed to the store
    without a represented validation step and the recalled context later reaches a
    generation step. 
    """@en ;
    pair:hasMotif pat:AgentMemoryLoopMotif ;
    pair:hasMechanism asi:mechanism-persisted-context-corruption ;
    pair:hasApplicabilityCondition
        pat:MemoryPoisoning_UnvalidatedWriteCondition ,
        pat:MemoryPoisoning_RecalledIntoGenerationCondition ;
    pair:mayIndicateRisk
        asi:asi06-memory-and-context-poisoning ,
        owasp:llm04-data-and-model-poisoning ,
        mit:subdomain-2-2 ,
        mit:subdomain-3-1 ;
    pair:suggestedControl
        pat:Control_TrustedTrainingAndIndexingData ,
        pat:Control_InputValidationAndPromptIsolation ,
        pat:Control_LoggingMonitoringAndEvals ;
    pair:implementedBy pat:MemoryPoisoningOQP .

# Agentic pattern implementations

pat:ToolUsingAgent_MatchingOQP
    a pair:PatternImplementation ;
    rdfs:label "Tool-Using Agent Motif matching OQP"@en ;
    pair:implementsMotif pat:ToolUsingAgentMotif ;
    pair:implementationPath "ontology/patterns/implementation/match/tool_using_agent.rq" ;
    pair:producesOutputType pair:MotifMatch .

pat:AgentMemoryLoop_MatchingOQP
    a pair:PatternImplementation ;
    rdfs:label "Agent Memory Loop Motif matching OQP"@en ;
    pair:implementsMotif pat:AgentMemoryLoopMotif ;
    pair:implementationPath "ontology/patterns/implementation/match/agent_memory_loop.rq" ;
    pair:producesOutputType pair:MotifMatch .

pat:ToolMisuseOQP
    a pair:PatternImplementation ;
    rdfs:label "Tool misuse risk pattern OQP"@en ;
    pair:implementsRiskPattern pat:ToolMisuseRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/risk/tool_misuse.rq" ;
    pair:producesOutputType pair:RiskFinding .

pat:MemoryPoisoningOQP
    a pair:PatternImplementation ;
    rdfs:label "Memory and context poisoning risk pattern OQP"@en ;
    pair:implementsRiskPattern pat:MemoryPoisoningRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/risk/memory_poisoning.rq" ;
    pair:producesOutputType pair:RiskFinding .

pat:GoalHijack_UntrustedPlanningInputCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "Untrusted content reaches the step that decides the agent's next action"@en ;
    pair:operationalizesRiskCondition asi:condition-untrusted-content-reaches-planning .

pat:InsecureAgentCommunication_UnvalidatedHandoffCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "An inter-agent message is acted on with no represented validation step"@en ;
    pair:operationalizesRiskCondition asi:condition-agent-handoff-without-validation .

pat:GoalHijackRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom asi:asi01-agent-goal-hijack ;
    dct:source <https://genai.owasp.org/> ;
    rdfs:label "Agent goal hijack risk pattern"@en ;
    dct:description """
    Applies to an agentic match whose planning or goal creation step consumes
    content of untrusted provenance with nothing screening it on the way.
    """@en ;
    pair:hasMotif pat:ToolUsingAgentMotif ,
        pat:AgentDelegationMotif ,
        pat:GoalCreationMotif ,
        pat:ProactiveGoalCreationMotif ,
        pat:ModelQueryingMotif ,
        pat:IncrementalModelQueryingMotif ,
        pat:PlanReflectionMotif ,
        pat:ToolAgentRegistryMotif ;
    pair:hasMechanism asi:mechanism-goal-redirection-through-consumed-content ;
    pair:hasApplicabilityCondition pat:GoalHijack_UntrustedPlanningInputCondition ;
    pair:mayIndicateRisk
        asi:asi01-agent-goal-hijack ,
        owasp:llm01-prompt-injection ,
        owasp:llm06-excessive-agency ;
    pair:suggestedControl
        pat:Control_InputValidationAndPromptIsolation ,
        pat:Control_ToolPermissionBoundaries ,
        pat:Control_LoggingMonitoringAndEvals ;
    pair:implementedBy pat:GoalHijackOQP .

pat:InsecureAgentCommunicationRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom asi:asi07-insecure-inter-agent-communication ;
    dct:source <https://genai.owasp.org/> ;
    rdfs:label "Insecure inter-agent communication risk pattern"@en ;
    dct:description """
    Applies to an Agent Delegation, Voting-based or Debate-based Cooperation
    match where a message crossing between agents passes no represented
    validation, guardrail, or policy step. The receiving agent applies its own
    permissions to instructions whose origin the architecture never establishes,
    so trust intended for the sending agent extends to anything that can write
    to the channel.
    """@en ;
    pair:hasMotif pat:AgentDelegationMotif ,
        pat:VotingBasedCooperationMotif ,
        pat:DebateBasedCooperationMotif ;
    pair:hasMechanism asi:mechanism-unauthenticated-agent-handoff ;
    pair:hasApplicabilityCondition pat:InsecureAgentCommunication_UnvalidatedHandoffCondition ;
    pair:mayIndicateRisk
        asi:asi07-insecure-inter-agent-communication ,
        owasp:llm02-sensitive-information-disclosure ,
        owasp:llm06-excessive-agency ,
        eticas:trust-exploitation-between-agents ;
    pair:suggestedControl
        pat:Control_InputValidationAndPromptIsolation ,
        pat:Control_ToolPermissionBoundaries ,
        pat:Control_LoggingMonitoringAndEvals ;
    pair:implementedBy pat:InsecureAgentCommunicationOQP .

pat:AgentDelegation_MatchingOQP
    a pair:PatternImplementation ;
    rdfs:label "Agent Delegation Motif matching OQP"@en ;
    pair:implementsMotif pat:AgentDelegationMotif ;
    pair:implementationPath "ontology/patterns/implementation/match/agent_delegation.rq" ;
    pair:producesOutputType pair:MotifMatch .

pat:HumanOversight_MatchingOQP
    a pair:PatternImplementation ;
    rdfs:label "Human Oversight Motif matching OQP"@en ;
    pair:implementsMotif pat:HumanOversightMotif ;
    pair:implementationPath "ontology/patterns/implementation/match/human_oversight.rq" ;
    pair:producesOutputType pair:MotifMatch .

pat:ExecScreening_MatchingOQP
    a pair:PatternImplementation ;
    rdfs:label "Execution Screening Motif matching OQP"@en ;
    pair:implementsMotif pat:ExecutionScreeningMotif ;
    pair:implementationPath "ontology/patterns/implementation/match/execution_screening.rq" ;
    pair:producesOutputType pair:MotifMatch .

pat:GoalCreation_MatchingOQP
    a pair:PatternImplementation ;
