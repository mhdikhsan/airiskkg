    pair:implementationPath "ontology/patterns/implementation/risk/insecure_agent_communication.rq" ;
    pair:producesOutputType pair:RiskFinding .


# Sensitive information reaching a user-facing sink, by any route

pat:SensitiveInformationDisclosureRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom owasp:llm02-sensitive-information-disclosure ;
    dct:source <https://genai.owasp.org/resource/owasp-top-10-for-llm-applications-2025/> ;
    rdfs:label "Sensitive information disclosure risk pattern"@en ;
    dct:description """
    Applies wherever content carrying a protected category reaches an element
    exposed to a user, with no represented control on the way out.
    """@en ;
    pair:hasMechanism owasp:mechanism-sensitive-data-propagation ;
    pair:hasApplicabilityCondition
        pat:SensitiveInfo_SensitiveContextCondition ,
        pat:SensitiveInfo_OutputExposureCondition ,
        pat:VectorEmbeddingWeakness_RetrievalCondition ;
    pair:mayIndicateRisk
        owasp:llm02-sensitive-information-disclosure ,
        atlas:exposing-personal-information ,
        mit:subdomain-2-1 ,
        atlas:personal-information-in-prompt ,
        atlas:personal-information-in-data ,
        atlas:confidential-data-in-prompt ,
        atlas:revealing-confidential-information ,
        atlas:confidential-information-in-data ,
        atlas:ip-information-in-prompt ,
        atlas:reidentification ,
        atlas:attribute-inference-attack ,
        eticas:sensitive-information-leakage ;
    pair:suggestedControl
        pat:Control_DataMinimizationAndRedaction ,
        pat:Control_RetrievalAccessControl ,
        pat:Control_OutputValidationAndSanitization ,
        pat:Control_Guardrails ;
    pair:implementedBy pat:SensitiveInformationDisclosureOQP .

pat:SensitiveInformationDisclosureOQP
    a pair:PatternImplementation ;
    rdfs:label "Sensitive output exposure risk pattern OQP"@en ;
    pair:implementsRiskPattern pat:SensitiveInformationDisclosureRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/risk/sensitive_information_disclosure.rq" ;
    pair:producesOutputType pair:RiskFinding .

# ML serving and training risk patterns (Zhang et al., 2022), agentic risk
# patterns for ASI03/04/05/08/09, and three IBM Atlas entries with a shape of
# their own. Added 2026-10-09.

# Controls

pat:Control_DistributionShiftMonitoring
    a beamr:RiskControl ;
    skos:prefLabel "Distribution shift monitoring"@en ;
    dct:description "Log what a deployed model receives and returns, and compare it against a baseline from training so a drift in inputs, outcomes or their relationship raises an alert."@en ;
    skos:relatedMatch mitctrl:post-deployment-monitoring ,
                      mitctrl:post-deployment-behavior-monitoring ,
                      mitctrl:testing-auditing .

pat:Control_InputDomainValidation
    a beamr:RiskControl ;
    skos:prefLabel "Input domain validation"@en ;
    dct:description "Check each input against the domain the model was built for, and reject, route or flag those outside it instead of answering them."@en ;
    skos:relatedMatch mitctrl:input-output-filtering ,
                      mitctrl:testing-auditing .

pat:Control_AdversarialRobustness
    a beamr:RiskControl ;
    skos:prefLabel "Adversarial robustness"@en ;
    dct:description "Screen inputs that outsiders can shape before they reach a model, and test the model against perturbed inputs before release and after."@en ;
    skos:relatedMatch mitctrl:red-teaming ,
                      mitctrl:model-safety-engineering ,
                      mitctrl:input-output-filtering .

pat:Control_PreReleaseModelEvaluation
    a beamr:RiskControl ;
    skos:prefLabel "Pre-release model evaluation"@en ;
    dct:description "Evaluate a trained model on held-out data against the task it will serve, and release it only on the outcome of that evaluation."@en ;
    skos:relatedMatch mitctrl:testing-auditing ,
                      mitctrl:pre-deployment-risk-assessment ,
                      mitctrl:staged-deployment .

pat:Control_FairnessEvaluation
    a beamr:RiskControl ;
    skos:prefLabel "Fairness evaluation"@en ;
    dct:description "Compare a model's errors and outcomes across the groups it affects before it is used, and keep comparing them in operation."@en ;
    skos:relatedMatch mitctrl:societal-impact-assessment ,
                      mitctrl:testing-auditing ,
                      mitctrl:data-governance .

pat:Control_UncertaintyReportingAndReview
    a beamr:RiskControl ;
    skos:prefLabel "Uncertainty reporting and review"@en ;
    dct:description "Report a confidence or uncertainty measure with every prediction to whatever acts on it, and route uncertain or high-impact cases to a person."@en ;
    skos:relatedMatch mitctrl:human-oversight-protocol ,
                      mitctrl:safety-decision-frameworks .

pat:Control_RetrainingDataValidation
    a beamr:RiskControl ;
    skos:prefLabel "Retraining data validation"@en ;
    dct:description "Vet model outputs, user content and feedback before they are reused as training data."@en ;
    skos:relatedMatch mitctrl:data-curation-process ,
                      mitctrl:data-governance .

pat:Control_HeldOutEvaluationData
    a beamr:RiskControl ;
    skos:prefLabel "Held-out evaluation data"@en ;
    dct:description "Keep the data a model is evaluated on separate from everything it is trained on, split before training begins."@en ;
    skos:relatedMatch mitctrl:testing-auditing ,
                      mitctrl:data-governance .

pat:Control_TrainingDataPrivacy
    a beamr:RiskControl ;
    skos:prefLabel "Training data privacy"@en ;
    dct:description "Train models on personal data with privacy-preserving methods such as differential privacy, and minimise the personal data a model learns from."@en ;
    skos:relatedMatch mitctrl:privacy-control-for-user-data ,
                      mitctrl:data-minimization .

pat:Control_ScopedAgentCredentials
    a beamr:RiskControl ;
    skos:prefLabel "Scoped agent credentials"@en ;
    dct:description "Give each agent its own short-lived credentials scoped to its task, never pass a delegating agent's credentials on, keep them out of memory, and re-authorise each privileged action."@en ;
    skos:relatedMatch mitctrl:access-management .

pat:Control_AgentComponentVerification
    a beamr:RiskControl ;
    skos:prefLabel "Agent component verification"@en ;
    dct:description "Verify the origin and integrity of tools, tool descriptions, prompt templates, registries and peer agents before an agent loads them, and pin what was verified."@en ;
    skos:relatedMatch mitctrl:model-infrastructure-security ,
                      mitctrl:system-architecture-documentation .

pat:Control_SandboxedCodeExecution
    a beamr:RiskControl ;
    skos:prefLabel "Sandboxed code execution"@en ;
    dct:description "Separate code generation from execution: validate or approve what an agent wants to run, and run it in a sandbox with the least privilege it needs."@en ;
    skos:relatedMatch mitctrl:model-infrastructure-security ,
                      mitctrl:technical-security-controls .

pat:Control_CascadeContainment
    a beamr:RiskControl ;
    skos:prefLabel "Cascade containment"@en ;
    dct:description "Bound how far one agent's decision can travel: checkpoints, rate limits or approvals between agents before work handed on becomes an action."@en ;
    skos:relatedMatch mitctrl:post-deployment-behavior-monitoring ,
                      mitctrl:human-oversight-protocol ,
                      mitctrl:incident-response-plan .

pat:Control_IndependentEvidenceForApproval
    a beamr:RiskControl ;
    skos:prefLabel "Independent evidence for approval"@en ;
    dct:description "Show the person approving an agent's action the source records or an independent check, not only the agent's own plan or rationale."@en ;
    skos:relatedMatch mitctrl:human-oversight-protocol ,
                      mitctrl:transparency-accountability-controls .

# Applicability conditions

pat:DatasetShift_UnmonitoredServingCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "A deployed model serves requests with no monitoring against a baseline"@en ;
    pair:operationalizesRiskCondition mlr:condition-served-model-without-shift-monitoring .

pat:OutOfDomainInput_UncheckedInputCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "An input reaches the model with no domain check"@en ;
    pair:operationalizesRiskCondition mlr:condition-input-reaches-model-without-domain-check .

pat:AdversarialEvasion_UntrustedInputCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "Content an outsider can shape reaches the model unscreened"@en ;
    pair:operationalizesRiskCondition mlr:condition-untrusted-input-reaches-model .

pat:ModelBias_PersonalTrainingDataCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "A model is trained on data about people with no fairness evaluation"@en ;
    pair:operationalizesRiskCondition mlr:condition-personal-training-data-without-fairness-evaluation .

pat:UnevaluatedModel_NoEvaluationCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "A trained model is served with no evaluation in between"@en ;
    pair:operationalizesRiskCondition mlr:condition-trained-model-served-without-evaluation .

pat:UnqualifiedPrediction_ActedOnCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "A prediction is acted on with neither its uncertainty nor a review"@en ;
    pair:operationalizesRiskCondition mlr:condition-prediction-acted-on-without-uncertainty .

pat:ImproperRetraining_FeedbackLoopCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "What the model produces flows back into its own training data unvetted"@en ;
    pair:operationalizesRiskCondition atlas:condition-model-output-feeds-own-training-data .

pat:MembershipInference_PublicQueryCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "A model trained on personal data answers public queries"@en ;
    pair:operationalizesRiskCondition atlas:condition-public-queries-reach-model-trained-on-personal-data .

pat:DataContamination_SharedDataCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "The evaluation reads data the model was trained from"@en ;
    pair:operationalizesRiskCondition atlas:condition-evaluation-reads-training-data .

pat:IdentityPrivilegeAbuse_SharedCredentialCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "A credential crosses an agent hand-off or is written to memory"@en ;
    pair:operationalizesRiskCondition asi:condition-credential-crosses-agent-boundary .

pat:AgenticSupplyChain_ExternalComponentCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "An external component reaches the agent's planning unverified"@en ;
    pair:operationalizesRiskCondition asi:condition-external-component-reaches-planning .

pat:UnexpectedCodeExecution_UngatedExecutionCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "An agent's plan is executed as code with no gate in between"@en ;
    pair:operationalizesRiskCondition asi:condition-agent-plan-executed-as-code .

pat:CascadingFailures_UncheckedRelayCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "A decision is handed on twice and acted on with no checkpoint"@en ;
    pair:operationalizesRiskCondition asi:condition-agent-decision-propagates-without-checkpoint .

pat:HumanAgentTrust_AgentOnlyEvidenceCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "The approver sees only what the agent produced"@en ;
    pair:operationalizesRiskCondition asi:condition-approval-sees-only-agent-output .

# Motif side of the binding (pair:hasRiskPattern mirrors pair:hasMotif)

pat:SynchronousPredictionMotif
    pair:hasRiskPattern
        pat:DatasetShiftRiskPattern ,
        pat:OutOfDomainInputRiskPattern ,
        pat:AdversarialEvasionRiskPattern ,
        pat:UnevaluatedModelRiskPattern ,
        pat:UnqualifiedPredictionRiskPattern ,
        pat:TrainingDataMembershipInferenceRiskPattern .

pat:AsynchronousPredictionMotif
    pair:hasRiskPattern
        pat:DatasetShiftRiskPattern ,
        pat:OutOfDomainInputRiskPattern ,
        pat:AdversarialEvasionRiskPattern ,
        pat:UnevaluatedModelRiskPattern ,
        pat:UnqualifiedPredictionRiskPattern ,
        pat:TrainingDataMembershipInferenceRiskPattern .

pat:BatchPredictionMotif
    pair:hasRiskPattern
        pat:DatasetShiftRiskPattern ,
        pat:OutOfDomainInputRiskPattern ,
        pat:AdversarialEvasionRiskPattern ,
        pat:UnevaluatedModelRiskPattern ,
        pat:UnqualifiedPredictionRiskPattern ,
        pat:TrainingDataMembershipInferenceRiskPattern .

pat:PreprocessPredictionMotif
    pair:hasRiskPattern
        pat:DatasetShiftRiskPattern ,
        pat:OutOfDomainInputRiskPattern ,
        pat:AdversarialEvasionRiskPattern ,
        pat:UnevaluatedModelRiskPattern ,
        pat:UnqualifiedPredictionRiskPattern ,
        pat:TrainingDataMembershipInferenceRiskPattern .

pat:MultiStagePredictionMotif
    pair:hasRiskPattern
        pat:DatasetShiftRiskPattern ,
        pat:OutOfDomainInputRiskPattern ,
        pat:AdversarialEvasionRiskPattern ,
        pat:UnevaluatedModelRiskPattern ,
        pat:UnqualifiedPredictionRiskPattern ,
        pat:TrainingDataMembershipInferenceRiskPattern .

pat:TrainThenServeMotif
    pair:hasRiskPattern
        pat:DatasetShiftRiskPattern ,
        pat:OutOfDomainInputRiskPattern ,
        pat:AdversarialEvasionRiskPattern ,
        pat:UnqualifiedPredictionRiskPattern ,
        pat:TrainingDataMembershipInferenceRiskPattern ,
        pat:ModelBiasRiskPattern ,
        pat:ImproperRetrainingRiskPattern ,
        pat:EvaluationDataContaminationRiskPattern .

pat:TrainingToServingMotif
    pair:hasRiskPattern
        pat:DatasetShiftRiskPattern ,
        pat:OutOfDomainInputRiskPattern ,
        pat:AdversarialEvasionRiskPattern ,
        pat:UnevaluatedModelRiskPattern ,
        pat:UnqualifiedPredictionRiskPattern ,
        pat:TrainingDataMembershipInferenceRiskPattern ,
        pat:ModelBiasRiskPattern ,
        pat:ImproperRetrainingRiskPattern .

pat:BatchTrainingMotif
    pair:hasRiskPattern
        pat:ModelBiasRiskPattern ,
        pat:ImproperRetrainingRiskPattern ,
        pat:EvaluationDataContaminationRiskPattern .

pat:PipelineTrainingMotif
    pair:hasRiskPattern
        pat:ModelBiasRiskPattern ,
        pat:ImproperRetrainingRiskPattern ,
        pat:EvaluationDataContaminationRiskPattern .

pat:FineTuningMotif
    pair:hasRiskPattern
        pat:ImproperRetrainingRiskPattern ,
        pat:EvaluationDataContaminationRiskPattern .

pat:ToolUsingAgentMotif
    pair:hasRiskPattern
        pat:AgenticSupplyChainRiskPattern ,
        pat:UnexpectedCodeExecutionRiskPattern ,
        pat:HumanAgentTrustExploitationRiskPattern .

pat:ToolAgentRegistryMotif
    pair:hasRiskPattern
        pat:AgenticSupplyChainRiskPattern ,
        pat:UnexpectedCodeExecutionRiskPattern ,
        pat:HumanAgentTrustExploitationRiskPattern .

pat:AgentDelegationMotif
    pair:hasRiskPattern
        pat:IdentityPrivilegeAbuseRiskPattern ,
        pat:AgenticSupplyChainRiskPattern ,
        pat:CascadingFailuresRiskPattern .

pat:AgentMemoryLoopMotif
    pair:hasRiskPattern pat:IdentityPrivilegeAbuseRiskPattern .

# ML risk patterns

pat:DatasetShiftRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom mlr:dataset-shift ;
    dct:source <https://doi.org/10.1016/j.dss.2022.113800> ;
    rdfs:label "Dataset shift risk pattern"@en ;
    dct:description """
    Applies where a deployed model serves incoming requests and no represented
    monitoring step compares what it serves against a baseline from training.
    """@en ;
    pair:hasMotif pat:SynchronousPredictionMotif ,
        pat:AsynchronousPredictionMotif ,
        pat:BatchPredictionMotif ,
        pat:PreprocessPredictionMotif ,
        pat:MultiStagePredictionMotif ,
        pat:TrainThenServeMotif ,
        pat:TrainingToServingMotif ;
    pair:hasMechanism mlr:mechanism-unobserved-distribution-shift ;
    pair:hasApplicabilityCondition pat:DatasetShift_UnmonitoredServingCondition ;
    pair:mayIndicateRisk
        mlr:dataset-shift ,
        atlas:poor-model-accuracy ,
        atlas:unrepresentative-data ,
        eticas:output-drift ,
        mit:subdomain-7-3 ;
    pair:suggestedControl
        pat:Control_DistributionShiftMonitoring ,
        pat:Control_LoggingMonitoringAndEvals ;
    pair:implementedBy pat:DatasetShiftOQP .

pat:OutOfDomainInputRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom mlr:out-of-domain-data ;
    dct:source <https://doi.org/10.1016/j.dss.2022.113800> ;
    rdfs:label "Out-of-domain input risk pattern"@en ;
    dct:description """
    Applies where an input reaches a prediction step with no represented step
    that checks it lies within the domain the model was built for.
    """@en ;
    pair:hasMotif pat:SynchronousPredictionMotif ,
        pat:AsynchronousPredictionMotif ,
        pat:BatchPredictionMotif ,
        pat:PreprocessPredictionMotif ,
        pat:MultiStagePredictionMotif ,
        pat:TrainThenServeMotif ,
        pat:TrainingToServingMotif ;
    pair:hasMechanism mlr:mechanism-unchecked-input-domain ;
    pair:hasApplicabilityCondition pat:OutOfDomainInput_UncheckedInputCondition ;
    pair:mayIndicateRisk
        mlr:out-of-domain-data ,
        atlas:poor-model-accuracy ,
        eticas:out-of-distribution-robustness ,
        mit:subdomain-7-3 ;
    pair:suggestedControl
        pat:Control_InputDomainValidation ,
        pat:Control_DistributionShiftMonitoring ;
    pair:implementedBy pat:OutOfDomainInputOQP .

pat:AdversarialEvasionRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom mlr:adversarial-attack ;
    dct:source <https://doi.org/10.1016/j.dss.2022.113800> ;
    rdfs:label "Adversarial evasion risk pattern"@en ;
    dct:description """
    Applies where content an outsider can shape reaches a prediction step with no
    represented input screening on the way.
    """@en ;
    pair:hasMotif pat:SynchronousPredictionMotif ,
        pat:AsynchronousPredictionMotif ,
        pat:BatchPredictionMotif ,
        pat:PreprocessPredictionMotif ,
        pat:MultiStagePredictionMotif ,
        pat:TrainThenServeMotif ,
        pat:TrainingToServingMotif ;
    pair:hasMechanism mlr:mechanism-unscreened-adversarial-input ;
    pair:hasApplicabilityCondition pat:AdversarialEvasion_UntrustedInputCondition ;
    pair:mayIndicateRisk
        mlr:adversarial-attack ,
        atlas:evasion-attack ,
        eticas:evasion-attacks ,
        mit:subdomain-2-2 ;
    pair:suggestedControl
        pat:Control_AdversarialRobustness ,
        pat:Control_Guardrails ;
    pair:implementedBy pat:AdversarialEvasionOQP .

pat:ModelBiasRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom mlr:model-bias ;
    dct:source <https://doi.org/10.1016/j.dss.2022.113800> ;
    rdfs:label "Model bias risk pattern"@en ;
    dct:description """
    Applies where a model is trained on data carrying a personal-data
    classification and no represented fairness evaluation reads the trained model
    or anything it produces.
    """@en ;
    pair:hasMotif pat:BatchTrainingMotif ,
        pat:PipelineTrainingMotif ,
        pat:TrainThenServeMotif ,
        pat:TrainingToServingMotif ;
    pair:hasMechanism mlr:mechanism-unexamined-learned-bias ;
    pair:hasApplicabilityCondition pat:ModelBias_PersonalTrainingDataCondition ;
    pair:mayIndicateRisk
        mlr:model-bias ,
        atlas:decision-bias ,
        atlas:data-bias ,
        eticas:performance-equity ,
        eticas:disparate-impact-protected-groups ,
        mit:subdomain-1-1 ,
        mit:subdomain-1-3 ;
    pair:suggestedControl
        pat:Control_FairnessEvaluation ,
        pat:Control_TrustedTrainingAndIndexingData ;
    pair:implementedBy pat:ModelBiasOQP .

pat:UnevaluatedModelRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom mlr:model-misspecification ;
    dct:source <https://doi.org/10.1016/j.dss.2022.113800> ;
    rdfs:label "Unevaluated model risk pattern"@en ;
    dct:description """
    Applies where a model produced by a training step reaches a prediction step
    and no represented evaluation step reads the model on the way.
    """@en ;
    pair:hasMotif pat:SynchronousPredictionMotif ,
        pat:AsynchronousPredictionMotif ,
        pat:BatchPredictionMotif ,
        pat:PreprocessPredictionMotif ,
        pat:MultiStagePredictionMotif ,
        pat:TrainingToServingMotif ;
    pair:hasMechanism mlr:mechanism-unvalidated-model-fit ;
    pair:hasApplicabilityCondition pat:UnevaluatedModel_NoEvaluationCondition ;
    pair:mayIndicateRisk
        mlr:model-misspecification ,
        atlas:poor-model-accuracy ,
        eticas:fitness-for-purpose ,
        mit:subdomain-7-3 ;
    pair:suggestedControl
        pat:Control_PreReleaseModelEvaluation ,
        pat:Control_LoggingMonitoringAndEvals ;
    pair:implementedBy pat:UnevaluatedModelOQP .

pat:UnqualifiedPredictionRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom mlr:model-uncertainty ;
    dct:source <https://doi.org/10.1016/j.dss.2022.113800> ;
    rdfs:label "Unqualified prediction risk pattern"@en ;
    dct:description """
    Applies where a prediction reaches a step that acts on it, or a user, and
    neither an uncertainty estimate from the prediction step nor a represented
    human review reaches the same place.
    """@en ;
    pair:hasMotif pat:SynchronousPredictionMotif ,
        pat:AsynchronousPredictionMotif ,
        pat:BatchPredictionMotif ,
        pat:PreprocessPredictionMotif ,
        pat:MultiStagePredictionMotif ,
        pat:TrainThenServeMotif ,
        pat:TrainingToServingMotif ;
    pair:hasMechanism mlr:mechanism-unreported-prediction-uncertainty ;
    pair:hasApplicabilityCondition pat:UnqualifiedPrediction_ActedOnCondition ;
    pair:mayIndicateRisk
        mlr:model-uncertainty ,
        atlas:over-or-under-reliance ,
        eticas:automation-bias ,
        mit:subdomain-5-1 ,
        mit:subdomain-7-3 ;
    pair:suggestedControl
        pat:Control_UncertaintyReportingAndReview ,
        pat:Control_ToolPermissionBoundaries ;
    pair:implementedBy pat:UnqualifiedPredictionOQP .

# Risk patterns derived from IBM AI Risk Atlas entries with a shape of their own

pat:ImproperRetrainingRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom atlas:improper-retraining ;
    dct:source <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/knowledge_graph/risk_atlas_data.yaml> ;
    rdfs:label "Improper retraining risk pattern"@en ;
    dct:description """
    Applies where data downstream of the model a training step produces flows
    back into that step's training input, closing a loop, with no represented
    data validation, output validation or human approval on it.
    """@en ;
    pair:hasMotif pat:BatchTrainingMotif ,
        pat:PipelineTrainingMotif ,
        pat:TrainThenServeMotif ,
        pat:TrainingToServingMotif ,
        pat:FineTuningMotif ;
    pair:hasMechanism atlas:mechanism-unvetted-feedback-into-training ;
    pair:hasApplicabilityCondition pat:ImproperRetraining_FeedbackLoopCondition ;
    pair:mayIndicateRisk
        atlas:improper-retraining ,
        owasp:llm03-supply-chain ,
        eticas:feedback-loops ,
        mit:subdomain-7-3 ;
    pair:suggestedControl
        pat:Control_RetrainingDataValidation ,
        pat:Control_TrustedTrainingAndIndexingData ;
    pair:implementedBy pat:ImproperRetrainingOQP .

pat:TrainingDataMembershipInferenceRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom atlas:membership-inference-attack ;
    dct:source <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/knowledge_graph/risk_atlas_data.yaml> ;
    rdfs:label "Training data membership inference risk pattern"@en ;
    dct:description """
    Applies where a model trained on data carrying a personal-data classification
    answers requests that originate from public user input. It has no structural
    escape: what reduces it is how the model is trained, which the architecture
    does not show, so a finding is settled by triage.
    """@en ;
    pair:hasMotif pat:SynchronousPredictionMotif ,
        pat:AsynchronousPredictionMotif ,
        pat:BatchPredictionMotif ,
        pat:PreprocessPredictionMotif ,
        pat:MultiStagePredictionMotif ,
        pat:TrainThenServeMotif ,
        pat:TrainingToServingMotif ;
    pair:hasMechanism atlas:mechanism-training-membership-exposed-by-queries ;
    pair:hasApplicabilityCondition pat:MembershipInference_PublicQueryCondition ;
    pair:mayIndicateRisk
        atlas:membership-inference-attack ,
        owasp:llm02-sensitive-information-disclosure ,
        eticas:sensitive-information-leakage ,
        mit:subdomain-2-2 ;
    pair:suggestedControl
        pat:Control_TrainingDataPrivacy ,
        pat:Control_RateLimitBudgetAndLoopControl ;
    pair:implementedBy pat:TrainingDataMembershipInferenceOQP .

pat:EvaluationDataContaminationRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom atlas:data-contamination ;
    dct:source <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/knowledge_graph/risk_atlas_data.yaml> ;
    rdfs:label "Evaluation data contamination risk pattern"@en ;
    dct:description """
    Applies where an evaluation step reads data that the evaluated model's
    training input was taken from: the training data itself, or a set it was
    drawn from.
    """@en ;
    pair:hasMotif pat:BatchTrainingMotif ,
        pat:PipelineTrainingMotif ,
        pat:TrainThenServeMotif ,
        pat:FineTuningMotif ;
    pair:hasMechanism atlas:mechanism-evaluation-on-training-data ;
    pair:hasApplicabilityCondition pat:DataContamination_SharedDataCondition ;
    pair:mayIndicateRisk
        atlas:data-contamination ,
        owasp:llm03-supply-chain ,
        mit:subdomain-7-3 ;
    pair:suggestedControl
        pat:Control_HeldOutEvaluationData ,
        pat:Control_PreReleaseModelEvaluation ;
    pair:implementedBy pat:EvaluationDataContaminationOQP .

# Agentic risk patterns for ASI03, ASI04, ASI05, ASI08 and ASI09

pat:IdentityPrivilegeAbuseRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom asi:asi03-identity-and-privilege-abuse ;
    dct:source <https://genai.owasp.org/> ;
    rdfs:label "Identity and privilege abuse risk pattern"@en ;
    dct:description """
    Applies to an Agent Delegation match where the same credential is used by the
    delegating step and by a step on the receiving side with no represented
    per-action authorisation there, or to an Agent Memory Loop match whose write
    step commits a credential to memory.
    """@en ;
    pair:hasMotif pat:AgentDelegationMotif ,
        pat:AgentMemoryLoopMotif ;
    pair:hasMechanism asi:mechanism-authority-inherited-across-handoff ;
    pair:hasApplicabilityCondition pat:IdentityPrivilegeAbuse_SharedCredentialCondition ;
    pair:mayIndicateRisk
        asi:asi03-identity-and-privilege-abuse ,
        owasp:llm06-excessive-agency ,
        owasp:llm02-sensitive-information-disclosure ,
        owasp:llm01-prompt-injection ,
        mit:subdomain-2-2 ;
    pair:suggestedControl
        pat:Control_ScopedAgentCredentials ,
        pat:Control_ToolPermissionBoundaries ;
    pair:implementedBy pat:IdentityPrivilegeAbuseOQP .

pat:AgenticSupplyChainRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom asi:asi04-agentic-supply-chain ;
    dct:source <https://genai.owasp.org/> ;
    rdfs:label "Agentic supply chain risk pattern"@en ;
    dct:description """
    Applies to an agentic match whose planning step reads a component marked as
    an external dependency, other than a model or a credential, with no
    represented verification step producing it or screening the planning step.
    """@en ;
    pair:hasMotif pat:ToolUsingAgentMotif ,
        pat:ToolAgentRegistryMotif ,
        pat:AgentDelegationMotif ;
    pair:hasMechanism asi:mechanism-external-component-steers-agent ;
    pair:hasApplicabilityCondition pat:AgenticSupplyChain_ExternalComponentCondition ;
    pair:mayIndicateRisk
        asi:asi04-agentic-supply-chain ,
        owasp:llm03-supply-chain ,
        mit:subdomain-2-2 ;
    pair:suggestedControl
        pat:Control_AgentComponentVerification ,
        pat:Control_ModelAndDependencyProvenance ;
    pair:implementedBy pat:AgenticSupplyChainOQP .

pat:UnexpectedCodeExecutionRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom asi:asi05-unexpected-code-execution ;
    dct:source <https://genai.owasp.org/> ;
    rdfs:label "Unexpected code execution risk pattern"@en ;
    dct:description """
    Applies to a Tool-Using Agent or Tool/Agent Registry match whose tool step
    executes code, where no represented policy enforcement, output validation or
    human approval feeds that step.
    """@en ;
    pair:hasMotif pat:ToolUsingAgentMotif ,
        pat:ToolAgentRegistryMotif ;
    pair:hasMechanism asi:mechanism-agent-output-run-as-code ;
    pair:hasApplicabilityCondition pat:UnexpectedCodeExecution_UngatedExecutionCondition ;
    pair:mayIndicateRisk
        asi:asi05-unexpected-code-execution ,
        owasp:llm05-improper-output-handling ,
        owasp:llm01-prompt-injection ,
        mit:subdomain-2-2 ;
    pair:suggestedControl
        pat:Control_SandboxedCodeExecution ,
        pat:Control_OutputValidationAndSanitization ;
    pair:implementedBy pat:UnexpectedCodeExecutionOQP .

pat:CascadingFailuresRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom asi:asi08-cascading-failures ;
    dct:source <https://genai.owasp.org/> ;
    rdfs:label "Cascading failures risk pattern"@en ;
    dct:description """
    Applies to an Agent Delegation match whose receiving agent hands work on to a
    further agent that acts on it, with no represented checkpoint between the
    first hand-off and the action.
    """@en ;
    pair:hasMotif pat:AgentDelegationMotif ;
    pair:hasMechanism asi:mechanism-fault-propagation-across-agents ;
    pair:hasApplicabilityCondition pat:CascadingFailures_UncheckedRelayCondition ;
    pair:mayIndicateRisk
        asi:asi08-cascading-failures ,
        owasp:llm06-excessive-agency ,
        owasp:llm01-prompt-injection ,
        eticas:multi-step-actions ,
        mit:subdomain-7-6 ;
    pair:suggestedControl
        pat:Control_CascadeContainment ,
        pat:Control_RateLimitBudgetAndLoopControl ;
    pair:implementedBy pat:CascadingFailuresOQP .

pat:HumanAgentTrustExploitationRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom asi:asi09-human-agent-trust-exploitation ;
    dct:source <https://genai.owasp.org/> ;
    rdfs:label "Human-agent trust exploitation risk pattern"@en ;
    dct:description """
    Applies where a human approval step gates an agent's action and every input
    it reads was produced by a planning or generation step. It only arises once
    an approval is represented, so it can follow a tool misuse finding cleared by
    human oversight.
    """@en ;
    pair:hasMotif pat:ToolUsingAgentMotif ,
        pat:ToolAgentRegistryMotif ;
    pair:hasMechanism asi:mechanism-approval-on-the-agents-account ;
    pair:hasApplicabilityCondition pat:HumanAgentTrust_AgentOnlyEvidenceCondition ;
    pair:mayIndicateRisk
        asi:asi09-human-agent-trust-exploitation ,
        owasp:llm09-misinformation ,
        owasp:llm05-improper-output-handling ,
        owasp:llm06-excessive-agency ,
        atlas:over-or-under-reliance ,
        eticas:automation-bias ,
        mit:subdomain-5-1 ;
    pair:suggestedControl
        pat:Control_IndependentEvidenceForApproval ,
        pat:Control_ToolPermissionBoundaries ;
    pair:implementedBy pat:HumanAgentTrustExploitationOQP .

