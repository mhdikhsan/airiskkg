    pair:producesOutputType pair:DataCategoryPropagation .


# --- Risk-pattern OQP for MisinformationFromWeakGroundingRiskPattern ---
# The RAG counterpart of the direct-prompting-without-grounding pattern (both
# OWASP LLM09); its OQP fires on RAG matches whose response has no represented
# verification step.

pat:MisinformationFromWeakGroundingOQP
    a pair:PatternImplementation ;
    rdfs:label "Misinformation from weak grounding risk pattern OQP"@en ;
    pair:implementsRiskPattern pat:MisinformationFromWeakGroundingRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/risk_misinformation_weak_grounding.rq" ;
    pair:producesOutputType pair:RiskFinding .


# --- Motif-matching OQPs ---
# One matching OQP per motif (faithful structural projections of each motif's
# declared PatternNode/PatternEdge blueprint). These produce pair:MotifMatch
# outputs; risk semantics stay in the risk OQPs. GenAI motifs (Guardrails,
# Hybrid Retriever, Evals, Fine Tuning) are consumed by match-anchored risk
# patterns; the Mercari MLOps motifs are detected for completeness and workbench
# reporting even where no risk pattern yet consumes them.

pat:SyncPred_MatchingOQP
    a pair:PatternImplementation ;
    rdfs:label "Synchronous Prediction Motif matching OQP"@en ;
