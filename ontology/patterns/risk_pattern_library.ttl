pat:UntrustedContentPropagationOQP
    a pair:PatternImplementation ;
    rdfs:label "Untrusted content propagation OQP"@en ;
    dct:description "Infers pair:containsDataCategory pair:UntrustedContent from public-input, retrieved-context and environment-context roles and propagates it along beam:use/beam:produce edges, so risk patterns don't depend on every element being hand-tagged."@en ;
    pair:implementationPath "ontology/patterns/implementation/propagation/untrusted_content.rq" ;
    pair:producesOutputType pair:DataCategoryPropagation .

pat:ContentCategoryPropagationOQP
    a pair:PatternImplementation ;
    rdfs:label "Content category propagation OQP"@en ;
    dct:source "OWASP Top 10 for LLM Applications 2025, LLM02 Sensitive Information Disclosure" ;
    pair:implementationPath "ontology/patterns/implementation/propagation/content_categories.rq" ;
    pair:producesOutputType pair:DataCategoryPropagation .

pat:GeneratedContentPropagationOQP
    a pair:PatternImplementation ;
    rdfs:label "Generated content derivation OQP"@en ;
    dct:description "Derives pair:containsDataCategory pair:GeneratedContent for every beam:Data element a pair:GenerationStep produces. Definitional rather than interpretive: the role already says the step generates, so the category needs no human judgement (Rule R8, derived fact)."@en ;
    dct:source "PAIR-AI glossary v1.3, Section A.3 (Data Category is derived along data flow by registered queries) and Rule R8." ;
    pair:implementationPath "ontology/patterns/implementation/propagation/generated_content.rq" ;
    pair:producesOutputType pair:DataCategoryPropagation .

pat:PersonalDataCategoryBridgeOQP
    a pair:PatternImplementation ;
    rdfs:label "Personal data category to content category bridge OQP"@en ;
    dct:description "Derives pair:SensitiveInformation for any element annotated with a DPV personal-data kind via facet:hasPersonalDataCategory, excluding the DPV values that state the data is not personal. Makes the DPV annotation load-bearing without mirroring DPV into pair:DataCategoryScheme (Rule R3)."@en ;
    dct:source <https://w3id.org/dpv> ;
    pair:implementationPath "ontology/patterns/implementation/propagation/personal_data_category.rq" ;
    pair:producesOutputType pair:DataCategoryPropagation .

pat:ProprietaryDataBridgeOQP
    a pair:PatternImplementation ;
    rdfs:label "Proprietary data rights to content category bridge OQP"@en ;
    dct:description "Derives pair:ConfidentialInformation for data whose rights status is dataf:Proprietary, so licence-encumbered content is carried downstream by the normal content-category propagation."@en ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems (Data & Input dimension)." ;
    pair:implementationPath "ontology/patterns/implementation/propagation/proprietary_data.rq" ;
    pair:producesOutputType pair:DataCategoryPropagation .

pat:PersonalDataRightsBridgeOQP
    a pair:PatternImplementation ;
    rdfs:label "Personal data rights to content category bridge OQP"@en ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems. OECD Digital Economy Papers, No. 323. https://doi.org/10.1787/cb6d9eca-en; corroborated by DPV v2.3" ;
    pair:implementationPath "ontology/patterns/implementation/propagation/personal_data_rights.rq" ;
    pair:producesOutputType pair:DataCategoryPropagation .

