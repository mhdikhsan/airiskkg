# Agentic risk patterns 

pat:ToolMisuse_UnmediatedActionCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "A planned action reaches a tool or state change with no mediating control"@en ;
    pair:operationalizesRiskCondition asi:condition-tool-invocation-without-mediation .

pat:MemoryPoisoning_UnvalidatedWriteCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "Content is committed to agent memory without a represented validation step"@en ;
    pair:operationalizesRiskCondition asi:condition-untrusted-content-written-to-agent-memory .

pat:MemoryPoisoning_RecalledIntoGenerationCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "Recalled agent memory reaches a later generation context"@en ;
    pair:operationalizesRiskCondition asi:condition-agent-memory-reread-into-generation .

pat:ToolMisuseRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom asi:asi02-tool-misuse ;
    dct:source <https://genai.owasp.org/> ;
    rdfs:label "Tool misuse risk pattern"@en ;
    dct:description """
    Applies to a Tool-Using Agent match where the planning step's decision reaches
    a tool invocation or state change without any represented policy enforcement,
    human approval, or rate/budget control in between. 
    """@en ;
    pair:hasMotif pat:ToolUsingAgentMotif ;
    pair:hasMechanism asi:mechanism-unconstrained-tool-execution ;
    pair:hasApplicabilityCondition pat:ToolMisuse_UnmediatedActionCondition ;
    pair:mayIndicateRisk
        asi:asi02-tool-misuse ,
        owasp:llm06-excessive-agency ,
        mit:subdomain-2-2 ,
        mit:subdomain-5-2 ;
    pair:suggestedControl
        pat:Control_ToolPermissionBoundaries ,
        pat:Control_RateLimitBudgetAndLoopControl ,
        pat:Control_LoggingMonitoringAndEvals ;
    pair:implementedBy pat:ToolMisuseOQP .

pat:MemoryPoisoningRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom asi:asi06-memory-and-context-poisoning ;
    dct:source <https://genai.owasp.org/> ;
    rdfs:label "Memory and context poisoning risk pattern"@en ;
    dct:description """
    Applies to an Agent Memory Loop match where content is committed to the store
    without a represented validation step and the recalled context later reaches a
    generation step. 
    """@en ;
    pair:hasMotif pat:AgentMemoryLoopMotif ;
    pair:hasMechanism asi:mechanism-persisted-context-corruption ;
    pair:hasApplicabilityCondition
        pat:MemoryPoisoning_UnvalidatedWriteCondition ,
        pat:MemoryPoisoning_RecalledIntoGenerationCondition ;
    pair:mayIndicateRisk
        asi:asi06-memory-and-context-poisoning ,
        owasp:llm04-data-and-model-poisoning ,
        mit:subdomain-2-2 ,
        mit:subdomain-3-1 ;
    pair:suggestedControl
        pat:Control_TrustedTrainingAndIndexingData ,
        pat:Control_InputValidationAndPromptIsolation ,
        pat:Control_LoggingMonitoringAndEvals ;
    pair:implementedBy pat:MemoryPoisoningOQP .

# Agentic pattern implementations

