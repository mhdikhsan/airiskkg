    a pair:PatternImplementation ;
    rdfs:label "Tool-Using Agent Motif matching OQP"@en ;
    pair:implementsMotif pat:ToolUsingAgentMotif ;
    pair:implementationPath "ontology/patterns/implementation/match/tool_using_agent.rq" ;
    pair:producesOutputType pair:MotifMatch .

pat:AgentMemoryLoop_MatchingOQP
    a pair:PatternImplementation ;
    rdfs:label "Agent Memory Loop Motif matching OQP"@en ;
    pair:implementsMotif pat:AgentMemoryLoopMotif ;
    pair:implementationPath "ontology/patterns/implementation/match/agent_memory_loop.rq" ;
    pair:producesOutputType pair:MotifMatch .

pat:ToolMisuseOQP
    a pair:PatternImplementation ;
    rdfs:label "Tool misuse risk pattern OQP"@en ;
    pair:implementsRiskPattern pat:ToolMisuseRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/risk/tool_misuse.rq" ;
    pair:producesOutputType pair:RiskFinding .

pat:MemoryPoisoningOQP
    a pair:PatternImplementation ;
    rdfs:label "Memory and context poisoning risk pattern OQP"@en ;
    pair:implementsRiskPattern pat:MemoryPoisoningRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/risk/memory_poisoning.rq" ;
    pair:producesOutputType pair:RiskFinding .

pat:GoalHijack_UntrustedPlanningInputCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "Untrusted content reaches the step that decides the agent's next action"@en ;
    pair:operationalizesRiskCondition asi:condition-untrusted-content-reaches-planning .

pat:InsecureAgentCommunication_UnvalidatedHandoffCondition
    a pair:ApplicabilityCondition ;
    rdfs:label "An inter-agent message is acted on with no represented validation step"@en ;
    pair:operationalizesRiskCondition asi:condition-agent-handoff-without-validation .

pat:GoalHijackRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom asi:asi01-agent-goal-hijack ;
    dct:source <https://genai.owasp.org/> ;
    rdfs:label "Agent goal hijack risk pattern"@en ;
    dct:description """
    Applies to a Tool-Using Agent match whose planning step consumes content of
    untrusted provenance with nothing screening it on the way
    """@en ;
    pair:hasMotif pat:ToolUsingAgentMotif ;
    pair:hasMechanism asi:mechanism-goal-redirection-through-consumed-content ;
    pair:hasApplicabilityCondition pat:GoalHijack_UntrustedPlanningInputCondition ;
    pair:mayIndicateRisk
        asi:asi01-agent-goal-hijack ,
        owasp:llm01-prompt-injection ,
        owasp:llm06-excessive-agency ;
    pair:suggestedControl
        pat:Control_InputValidationAndPromptIsolation ,
        pat:Control_ToolPermissionBoundaries ,
        pat:Control_LoggingMonitoringAndEvals ;
    pair:implementedBy pat:GoalHijackOQP .

pat:InsecureAgentCommunicationRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom asi:asi07-insecure-inter-agent-communication ;
    dct:source <https://genai.owasp.org/> ;
    rdfs:label "Insecure inter-agent communication risk pattern"@en ;
    dct:description """
    Applies to an Agent Delegation match where the message crossing between the
    two agents passes no represented validation, guardrail, or policy step. The
    receiving agent applies its own permissions to instructions whose origin the
    architecture never establishes, so trust intended for the sending agent
    extends to anything that can write to the channel.
    """@en ;
    pair:hasMotif pat:AgentDelegationMotif ;
    pair:hasMechanism asi:mechanism-unauthenticated-agent-handoff ;
    pair:hasApplicabilityCondition pat:InsecureAgentCommunication_UnvalidatedHandoffCondition ;
    pair:mayIndicateRisk
        asi:asi07-insecure-inter-agent-communication ,
        owasp:llm02-sensitive-information-disclosure ,
        owasp:llm06-excessive-agency ;
    pair:suggestedControl
        pat:Control_InputValidationAndPromptIsolation ,
        pat:Control_ToolPermissionBoundaries ,
        pat:Control_LoggingMonitoringAndEvals ;
    pair:implementedBy pat:InsecureAgentCommunicationOQP .

pat:AgentDelegation_MatchingOQP
    a pair:PatternImplementation ;
    rdfs:label "Agent Delegation Motif matching OQP"@en ;
    pair:implementsMotif pat:AgentDelegationMotif ;
    pair:implementationPath "ontology/patterns/implementation/match/agent_delegation.rq" ;
    pair:producesOutputType pair:MotifMatch .

pat:HumanOversight_MatchingOQP
    a pair:PatternImplementation ;
    rdfs:label "Human Oversight Motif matching OQP"@en ;
    pair:implementsMotif pat:HumanOversightMotif ;
    pair:implementationPath "ontology/patterns/implementation/match/human_oversight.rq" ;
    pair:producesOutputType pair:MotifMatch .

pat:GoalHijackOQP
    a pair:PatternImplementation ;
    rdfs:label "Agent goal hijack risk pattern OQP"@en ;
    pair:implementsRiskPattern pat:GoalHijackRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/risk/goal_hijack.rq" ;
    pair:producesOutputType pair:RiskFinding .

pat:InsecureAgentCommunicationOQP
    a pair:PatternImplementation ;
    rdfs:label "Insecure inter-agent communication risk pattern OQP"@en ;
    pair:implementsRiskPattern pat:InsecureAgentCommunicationRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/risk/insecure_agent_communication.rq" ;
    pair:producesOutputType pair:RiskFinding .


#################################################################
# Sensitive information reaching a user-facing sink, by any route
#################################################################

pat:SensitiveOutputExposureRiskPattern
    a pair:RiskPattern ;
    pair:derivedFrom owasp:llm02-sensitive-information-disclosure ;
    dct:source <https://genai.owasp.org/resource/owasp-top-10-for-llm-applications-2025/> ;
    rdfs:label "Sensitive information exposure at a user-facing output risk pattern"@en ;
    dct:description """
    Applies wherever content carrying a protected category reaches an element
    exposed to a user, with no represented control on the way out.

    The library already had a sensitive-disclosure pattern, but it is scoped to
    the Vector-based Information Retrieval motif and requires the store and the
    retrieved result to be sensitive, so it only ever saw the retrieval route.
    Sensitive content arriving any other way - typed by a user, returned by a
    tool, recalled from agent memory - reached the output with nothing to
    report it, even though the propagation rules had already derived and could
    show the whole path. This pattern reads that derived fact directly, so the
    engine's own conclusion is what raises the finding.

    Deliberately motif-less, like the excessive-agency pattern: the risk is
    about where content ends up, not about which configuration carried it, and
    binding it to one motif is exactly what produced the blind spot.

    Both applicability conditions are shared with the retrieval-scoped pattern
    (glossary term 6 permits reuse where the structural gate is identical, and
    it is: sensitive content in context, exposed at an output).
    """@en ;
    pair:hasMechanism owasp:mechanism-sensitive-data-propagation ;
    pair:hasApplicabilityCondition
        pat:SensitiveInfo_SensitiveContextCondition ,
        pat:SensitiveInfo_OutputExposureCondition ;
    pair:mayIndicateRisk
        owasp:llm02-sensitive-information-disclosure ,
        atlas:exposing-personal-information ,
        mit:subdomain-2-1 ;
    pair:suggestedControl
        pat:Control_DataMinimizationAndRedaction ,
        pat:Control_OutputValidationAndSanitization ,
        pat:Control_Guardrails ;
    pair:implementedBy pat:SensitiveOutputExposureOQP .

pat:SensitiveOutputExposureOQP
    a pair:PatternImplementation ;
    rdfs:label "Sensitive output exposure risk pattern OQP"@en ;
    pair:implementsRiskPattern pat:SensitiveOutputExposureRiskPattern ;
    pair:implementationPath "ontology/patterns/implementation/risk/sensitive_output_exposure.rq" ;
    pair:producesOutputType pair:RiskFinding .
