PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX pair:   <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT {
    ?match
        a pair:MotifMatch ;
        rdfs:label "Direct LLM answering motif match"@en ;
        pair:matchesMotif pat:DirectLLMAnsweringMotif ;
        pair:hasNodeBinding ?queryBinding ,
            ?stepBinding ,
            ?modelBinding ,
            ?answerBinding .

    ?queryBinding
        a pair:NodeBinding ;
        pair:bindsPatternNode pat:DirectLLM_QueryNode ;
        pair:matchedElement ?query .

    ?stepBinding
        a pair:NodeBinding ;
        pair:bindsPatternNode pat:DirectLLM_GenerationStepNode ;
        pair:matchedElement ?step .

    ?modelBinding
        a pair:NodeBinding ;
        pair:bindsPatternNode pat:DirectLLM_ModelNode ;
        pair:matchedElement ?llm .

    ?answerBinding
        a pair:NodeBinding ;
        pair:bindsPatternNode pat:DirectLLM_AnswerNode ;
        pair:matchedElement ?answer .
}
WHERE {
    ?step
        beam:use ?query ;
        beam:use ?llm ;
        beam:produce ?answer ;
        pair:playsRole ?stepRole .
    ?stepRole pair:subRoleOf* pair:GenerationStep .

    ?query pair:playsRole ?queryRole .
    ?queryRole pair:subRoleOf* pair:UserInput .

    ?llm pair:playsRole ?modelRole .
    ?modelRole pair:subRoleOf* pair:GenerativeModel .

    ?answer pair:playsRole ?answerRole .
    ?answerRole pair:subRoleOf* pair:UserFacingOutput .

    FILTER NOT EXISTS {
        ?step beam:use ?knowledgeSource .
        ?knowledgeSource pair:playsRole/pair:subRoleOf* pair:KnowledgeSource .
    }

    FILTER NOT EXISTS {
        ?step beam:use ?retrievedContext .
        ?retrievedContext pair:playsRole/pair:subRoleOf* pair:RetrievedContext .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/motif-match/",
        ENCODE_FOR_URI(STR(?step)),
        "/direct-llm/",
        ENCODE_FOR_URI(STR(?query)),
        "/",
        ENCODE_FOR_URI(STR(?answer))
    )) AS ?match)

    BIND(IRI(CONCAT(STR(?match), "/binding/query")) AS ?queryBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/llm-step")) AS ?stepBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/llm")) AS ?modelBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/answer")) AS ?answerBinding)
}
