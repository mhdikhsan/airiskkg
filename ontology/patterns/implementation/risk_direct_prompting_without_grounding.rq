PREFIX pat:     <http://w3id.org/airiskkg/patterns#>
PREFIX pair:      <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:    <http://w3id.org/beam/core#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:     <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate Direct Prompting without grounding"@en ;
        dct:description "A Direct Prompting step produces a user-facing answer without an explicit knowledge source or retrieved grounding context represented in the architecture graph."@en ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif pat:DirectPromptingMotif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:mechanismNarrative ?mechanismNarrative ;
        pair:hasEvidence ?query ,
            ?step ,
            ?llm ,
            ?answer ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition ;
        pair:findingStatus "candidate" .
}
WHERE {
    pat:DirectPromptingWithoutGroundingRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    ?match
        a pair:MotifMatch ;
        pair:matchesMotif pat:DirectPromptingMotif ;
        pair:hasNodeBinding ?queryBinding ,
            ?stepBinding ,
            ?modelBinding ,
            ?answerBinding .

    ?queryBinding
        pair:bindsPatternNode pat:DP_QueryNode ;
        pair:matchedElement ?query .

    ?stepBinding
        pair:bindsPatternNode pat:DP_GenerationStepNode ;
        pair:matchedElement ?step .

    ?modelBinding
        pair:bindsPatternNode pat:DP_ModelNode ;
        pair:matchedElement ?llm .

    ?answerBinding
        pair:bindsPatternNode pat:DP_AnswerNode ;
        pair:matchedElement ?answer .

    FILTER NOT EXISTS {
        ?step beam:use ?knowledgeSource .
        ?knowledgeSource pair:playsRole/pair:subRoleOf* pair:KnowledgeSource .
    }

    FILTER NOT EXISTS {
        ?step beam:use ?retrievedContext .
        ?retrievedContext pair:playsRole/pair:subRoleOf* pair:RetrievedContext .
    }

    # Instance-grounded mechanism narrative (presentation only; adds no
    # filter, changes no finding count). The pattern's canonical curated
    # causal text is reused verbatim from the mechanism (single source);
    # only an instance frame naming match-stable elements is appended, so
    # exactly one narrative is produced per finding.
    OPTIONAL { ?mechanism dct:description ?mechanismText . }
    BIND(CONCAT(
        COALESCE(?mechanismText, ""),
        " Here step ", IF(CONTAINS(STR(COALESCE(?step, "")), "#"), STRAFTER(STR(COALESCE(?step, "")), "#"), STR(COALESCE(?step, ""))), " produces answer ", IF(CONTAINS(STR(COALESCE(?answer, "")), "#"), STRAFTER(STR(COALESCE(?answer, "")), "#"), STR(COALESCE(?answer, ""))), " with no represented knowledge source or retrieved grounding context."
    ) AS ?mechanismNarrative)

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/direct-prompting-without-grounding"
    )) AS ?riskFinding)
}
