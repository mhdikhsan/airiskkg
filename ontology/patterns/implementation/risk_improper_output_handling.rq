PREFIX pat:   <http://w3id.org/airiskkg/patterns#>
PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:  <http://w3id.org/beam/core#>
PREFIX beamr: <http://w3id.org/beam/risk#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate improper LLM output handling"@en ;
        dct:description "A user-facing LLM output is produced without a represented output validation, sanitization, or guardrail step."@en ;
        pair:findingStatus "candidate" ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif ?motif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:mechanismNarrative ?mechanismNarrative ;
        pair:hasEvidence ?generationStep ,
            ?llm ,
            ?userFacingOutput ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition .
}
WHERE {
    pat:ImproperOutputHandlingRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    ?match
        a pair:MotifMatch ;
        pair:matchesMotif ?motif ;
        pair:hasNodeBinding/pair:matchedElement ?generationStep .

    ?generationStep
        beam:use ?llm ;
        beam:produce ?userFacingOutput ;
        pair:playsRole ?generationRole .
    ?generationRole pair:subRoleOf* pair:GenerationStep .
    ?llm pair:playsRole/pair:subRoleOf* pair:GenerativeModel .
    ?userFacingOutput pair:playsRole/pair:subRoleOf* pair:UserFacingOutput .

    FILTER NOT EXISTS {
        ?outputControlStep
            beam:use ?userFacingOutput ;
            pair:playsRole ?outputControlRole .
        {
            ?outputControlRole pair:subRoleOf* pair:OutputValidationStep .
        }
        UNION
        {
            ?outputControlRole pair:subRoleOf* pair:OutputGuardrailStep .
        }
    }
    FILTER NOT EXISTS {
        pat:ImproperOutputHandlingRiskPattern pair:suggestedControl ?implementedControl .
        ?implementedControl beamr:associatedTo ?userFacingOutput .
    }

    # Instance-grounded mechanism narrative (presentation only; adds no
    # filter, changes no finding count). The pattern's canonical curated
    # causal text is reused verbatim from the mechanism (single source);
    # only an instance frame naming match-stable elements is appended, so
    # exactly one narrative is produced per finding.
    OPTIONAL { ?mechanism dct:description ?mechanismText . }
    BIND(CONCAT(
        COALESCE(?mechanismText, ""),
        " Here generation step ", IF(CONTAINS(STR(COALESCE(?generationStep, "")), "#"), STRAFTER(STR(COALESCE(?generationStep, "")), "#"), STR(COALESCE(?generationStep, ""))), " produces user-facing output ", IF(CONTAINS(STR(COALESCE(?userFacingOutput, "")), "#"), STRAFTER(STR(COALESCE(?userFacingOutput, "")), "#"), STR(COALESCE(?userFacingOutput, ""))), " with no represented validation step."
    ) AS ?mechanismNarrative)

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/improper-output-handling"
    )) AS ?riskFinding)
}
