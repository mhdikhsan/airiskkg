PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX rp:   <http://w3id.org/beam/risk-pattern#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT {
    ?match
        a rp:MotifMatch ;
        rdfs:label "LLM-based information retrieval motif match"@en ;
        rp:matchesMotif pat:LLMBasedInformationRetrievalMotif ;
        rp:hasNodeBinding ?queryBinding ,
            ?stepBinding ,
            ?modelBinding ,
            ?answerBinding .

    ?queryBinding
        a rp:NodeBinding ;
        rp:bindsPatternNode pat:LLMIR_QueryNode ;
        rp:matchedElement ?query ;
        rp:boundToElement ?query .

    ?stepBinding
        a rp:NodeBinding ;
        rp:bindsPatternNode pat:LLMIR_RetrievalStepNode ;
        rp:matchedElement ?step ;
        rp:boundToElement ?step .

    ?modelBinding
        a rp:NodeBinding ;
        rp:bindsPatternNode pat:LLMIR_ModelNode ;
        rp:matchedElement ?llm ;
        rp:boundToElement ?llm .

    ?answerBinding
        a rp:NodeBinding ;
        rp:bindsPatternNode pat:LLMIR_AnswerNode ;
        rp:matchedElement ?answer ;
        rp:boundToElement ?answer .
}
WHERE {
    ?step
        beam:use ?query ;
        beam:use ?llm ;
        beam:produce ?answer ;
        rp:playsRole ?stepRole .
    ?stepRole rp:subRoleOf* rp:GenerationStep .

    ?query rp:playsRole ?queryRole .
    ?queryRole rp:subRoleOf* rp:UserInput .

    ?llm rp:playsRole ?modelRole .
    ?modelRole rp:subRoleOf* rp:GenerativeModel .

    ?answer rp:playsRole ?answerRole .
    ?answerRole rp:subRoleOf* rp:UserFacingOutput .

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/motif-match/",
        ENCODE_FOR_URI(STR(?step)),
        "/llm-ir/",
        ENCODE_FOR_URI(STR(?query)),
        "/",
        ENCODE_FOR_URI(STR(?answer))
    )) AS ?match)

    BIND(IRI(CONCAT(STR(?match), "/binding/query")) AS ?queryBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/llm-step")) AS ?stepBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/llm")) AS ?modelBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/answer")) AS ?answerBinding)
}
