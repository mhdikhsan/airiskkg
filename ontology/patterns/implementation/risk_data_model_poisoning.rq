PREFIX pat:   <http://w3id.org/airiskkg/patterns#>
PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:  <http://w3id.org/beam/core#>
PREFIX beamr: <http://w3id.org/beam/risk#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate data or model poisoning exposure"@en ;
        dct:description "Untrusted content is used in an embedding, indexing, fine-tuning, or training path that can affect model or retrieval behavior."@en ;
        pair:findingStatus "candidate" ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif ?motif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:mechanismNarrative ?mechanismNarrative ;
        pair:hasEvidence ?untrustedSource ,
            ?pipelineStep ,
            ?producedArtifact ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition .
}
WHERE {
    pat:DataAndModelPoisoningRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    ?match
        a pair:MotifMatch ;
        pair:matchesMotif ?motif .
    VALUES ?motif {
        pat:EmbeddingsMotif
        pat:FineTuningMotif
        pat:TrainingToServingMotif
    }

    ?match pair:hasNodeBinding/pair:matchedElement ?untrustedSource .
    ?untrustedSource pair:containsDataCategory/pair:subDataCategoryOf* pair:UntrustedContent .

    OPTIONAL {
        ?match pair:hasNodeBinding/pair:matchedElement ?pipelineStep .
        ?pipelineStep beam:use ?untrustedSource .
        OPTIONAL {
            ?pipelineStep beam:produce ?producedArtifact .
        }
    }

    FILTER NOT EXISTS {
        pat:DataAndModelPoisoningRiskPattern pair:suggestedControl ?implementedControl .
        ?implementedControl beamr:associatedTo ?untrustedSource .
    }

    # Instance-grounded mechanism narrative (presentation only; adds no
    # filter, changes no finding count). The pattern's canonical curated
    # causal text is reused verbatim from the mechanism (single source);
    # only an instance frame naming match-stable elements is appended, so
    # exactly one narrative is produced per finding.
    OPTIONAL { ?mechanism dct:description ?mechanismText . }
    BIND(CONCAT(
        COALESCE(?mechanismText, ""),
        " Here the matched ", IF(CONTAINS(STR(COALESCE(?motif, "")), "#"), STRAFTER(STR(COALESCE(?motif, "")), "#"), STR(COALESCE(?motif, ""))), " path ingests untrusted or externally-sourced data with no represented curation control."
    ) AS ?mechanismNarrative)

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/data-model-poisoning"
    )) AS ?riskFinding)
}
