PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Bound an unbounded loop or call path (LLM10).

CONSTRUCT {
    ?controlStep
        a beam:Process ;
        rdfs:label "Rate and budget control"@en ;
        pair:playsRole pair:RateLimitControlStep ;
        beam:produce ?budget .

    ?budget
        a beam:Data ;
        rdfs:label "Remaining budget"@en ;
        pair:playsRole pair:GuardrailDecision .

    ?loopSource beam:use ?budget .

    ?system beam:hasProcess ?controlStep ;
        beam:hasResource ?budget .
}
WHERE {
    ?finding
        a pair:RiskFinding ;
        pair:generatedByRiskPattern pat:UnboundedConsumptionRiskPattern ;
        pair:hasEvidence ?loopSource .

    ?loopSource a/rdfs:subClassOf* beam:Process .

    FILTER NOT EXISTS {
        ?existing pair:playsRole/pair:subRoleOf* pair:RateLimitControlStep .
        ?existing (beam:produce/^beam:use)* ?loopSource .
    }

    OPTIONAL { ?system a beam:System . }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/mitigation/rate-limiting/",
        ENCODE_FOR_URI(STR(?loopSource))
    )) AS ?controlStep)

    BIND(IRI(CONCAT(STR(?controlStep), "/budget")) AS ?budget)
}
