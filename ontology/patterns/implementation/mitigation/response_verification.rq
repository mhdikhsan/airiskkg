PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Verify a generated response against its evidence (LLM09).

CONSTRUCT {
    ?verificationStep
        a beam:Process ;
        rdfs:label "Response verification"@en ;
        pair:playsRole pair:EvaluationStep ;
        beam:use ?response .

    ?system beam:hasProcess ?verificationStep .
}
WHERE {
    ?finding
        a pair:RiskFinding ;
        pair:generatedByRiskPattern pat:MisinformationFromWeakGroundingRiskPattern ;
        pair:hasEvidence ?response .

    ?response pair:playsRole/pair:subRoleOf* pair:LLMResponse .

    FILTER NOT EXISTS {
        ?existing beam:use ?response .
        { ?existing pair:playsRole/pair:subRoleOf* pair:EvaluationStep }
        UNION
        { ?existing pair:playsRole/pair:subRoleOf* pair:ScoringStep }
    }

    OPTIONAL { ?system a beam:System . }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/mitigation/response-verification/",
        ENCODE_FOR_URI(STR(?response))
    )) AS ?verificationStep)
}
