PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Insert an input screening step onto the path a prompt-injection finding cites.

CONSTRUCT {
    ?screeningStep
        a beam:Process ;
        rdfs:label "Input screening"@en ;
        pair:playsRole pair:InputGuardrailStep ;
        beam:use ?untrustedContent ;
        beam:inform ?generationStep .

    ?system beam:hasProcess ?screeningStep .
}
WHERE {
    ?finding
        a pair:RiskFinding ;
        pair:hasEvidence ?untrustedContent , ?generationStep .

    ?untrustedContent pair:containsDataCategory/pair:subDataCategoryOf* pair:UntrustedContent .
    ?generationStep pair:playsRole/pair:subRoleOf* pair:GenerationStep .

    {
        ?generationStep beam:use ?untrustedContent .
    }
    UNION
    {
        ?intermediateStep
            beam:use ?untrustedContent ;
            beam:produce ?derivedContext .
        ?generationStep beam:use ?derivedContext .
    }

    # Nothing screens it yet. Same test the risk query applies, so this
    # constructs a step exactly where one is missing and nowhere else.
    FILTER NOT EXISTS {
        ?existingScreen pair:playsRole/pair:subRoleOf* pair:InputGuardrailStep .
        {
            ?existingScreen beam:use ?untrustedContent ;
                beam:inform ?generationStep .
        }
        UNION
        {
            ?existingScreen beam:use ?untrustedContent ;
                beam:produce ?alreadyScreened .
            ?generationStep beam:use ?alreadyScreened .
        }
    }

    OPTIONAL {
        ?system a beam:System .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/mitigation/input-screening/",
        ENCODE_FOR_URI(STR(?untrustedContent)), "/",
        ENCODE_FOR_URI(STR(?generationStep))
    )) AS ?screeningStep)
}
