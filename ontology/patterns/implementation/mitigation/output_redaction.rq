PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Redact protected content before it reaches a user-facing sink (LLM02).

CONSTRUCT {
    ?redactionStep
        a beam:Process ;
        rdfs:label "Redaction"@en ;
        pair:playsRole pair:RedactionStep ;
        beam:use ?sink ;
        beam:produce ?redactedOutput .

    ?redactedOutput
        a beam:Data ;
        rdfs:label "Redacted output"@en ;
        pair:playsRole pair:SanitizedOutput .

    ?system beam:hasProcess ?redactionStep ;
        beam:hasResource ?redactedOutput .
}
WHERE {
    ?finding
        a pair:RiskFinding ;
        pair:generatedByRiskPattern pat:SensitiveInformationDisclosureRiskPattern ;
        pair:hasEvidence ?sink .

    ?sink pair:playsRole/pair:subRoleOf* pair:UserFacingOutput .

    FILTER NOT EXISTS {
        ?existing pair:playsRole ?existingRole .
        { ?existingRole pair:subRoleOf* pair:RedactionStep }
        UNION
        { ?existingRole pair:subRoleOf* pair:OutputValidationStep }
        UNION
        { ?existingRole pair:subRoleOf* pair:OutputGuardrailStep }
        { ?existing beam:use ?sink } UNION { ?existing beam:produce ?sink }
    }

    OPTIONAL { ?system a beam:System . }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/mitigation/output-redaction/",
        ENCODE_FOR_URI(STR(?sink))
    )) AS ?redactionStep)
    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/mitigation/output-redaction/",
        ENCODE_FOR_URI(STR(?sink)), "/redacted"
    )) AS ?redactedOutput)
}
