PREFIX pat:   <http://w3id.org/airiskkg/patterns#>
PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX beamr: <http://w3id.org/beam/risk#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate vector and embedding weakness"@en ;
        dct:description "A vector retrieval or embedding path is present and should be checked for retrieval filtering, ranking, provenance, and evaluation controls."@en ;
        pair:findingStatus "candidate" ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif ?motif ;
        pair:hasInterpretedMechanism ?mechanism ;
        pair:hasEvidenceElement ?evidenceElement ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition .
}
WHERE {
    pat:VectorAndEmbeddingWeaknessInterpretation
        pair:interpretedAsMechanism ?mechanism ;
        pair:hasInterpretationCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    VALUES ?motif {
        pat:VectorBasedInformationRetrievalMotif
        pat:RetrievalAugmentedGenerationMotif
        pat:EmbeddingsMotif
        pat:RerankerMotif
    }

    ?match
        a pair:MotifMatch ;
        pair:matchesMotif ?motif ;
        pair:hasNodeBinding/pair:matchedElement ?evidenceElement .

    FILTER NOT EXISTS {
        pat:VectorAndEmbeddingWeaknessInterpretation pair:suggestedControl ?implementedControl .
        ?implementedControl beamr:associatedTo ?evidenceElement .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/vector-embedding-weakness"
    )) AS ?riskFinding)
}
