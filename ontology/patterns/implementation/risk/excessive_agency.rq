PREFIX pat:   <http://w3id.org/airiskkg/patterns#>
PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:  <http://w3id.org/beam/core#>
PREFIX beamr: <http://w3id.org/beam/risk#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate excessive agency exposure"@en ;
        dct:description "What an LLM generation step produces can reach a tool invocation or state-changing process."@en ;
        pair:findingStatus "candidate" ;
        pair:generatedByRiskPattern pat:ExcessiveAgencyRiskPattern ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif ?motif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:hasEvidence ?generationStep ,
            ?toolOrActionStep ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition .
}
WHERE {
    {
        ?match
            a pair:MotifMatch ;
            pair:matchesMotif ?motif ;
            pair:hasNodeBinding/pair:matchedElement ?generationStep .

        ?generationStep pair:playsRole/pair:subRoleOf* pair:GenerationStep .
        ?toolOrActionStep pair:playsRole ?actionRole .
        {
            ?actionRole pair:subRoleOf* pair:ToolInvocationStep .
        }
        UNION
        {
            ?actionRole pair:subRoleOf* pair:StateChangingStep .
        }
        ?generationStep (beam:produce/^beam:use)+ ?toolOrActionStep .


        # Nothing mediates the path from generation to the action.
        FILTER NOT EXISTS {
            ?mediatingStep pair:playsRole ?mediatingRole .
            {
                ?mediatingRole pair:subRoleOf* pair:PolicyEnforcementStep .
            }
            UNION
            {
                ?mediatingRole pair:subRoleOf* pair:HumanApprovalStep .
            }
            UNION
            {
                ?mediatingRole pair:subRoleOf* pair:RateLimitControlStep .
            }
            {
                ?mediatingStep beam:produce/^beam:use ?toolOrActionStep .
            }
            UNION
            {
                ?generationStep beam:produce/^beam:use ?mediatingStep .
            }
        }
    }

    pat:ExcessiveAgencyRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/excessive-agency"
    )) AS ?riskFinding)
}
