PREFIX pat:   <http://w3id.org/airiskkg/patterns#>
PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:  <http://w3id.org/beam/core#>
PREFIX beamr: <http://w3id.org/beam/risk#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate insecure inter-agent communication"@en ;
        dct:description "A message passes from one agent to another and is acted on with no represented validation, guardrail, or policy step in between."@en ;
        pair:findingStatus "candidate" ;
        pair:generatedByRiskPattern pat:InsecureAgentCommunicationRiskPattern ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif ?motif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:hasEvidence ?delegatingStep ,
            ?message ,
            ?receivingStep ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition .
}
WHERE {
    {
        ?match
            a pair:MotifMatch ;
            pair:matchesMotif ?motif .
        # A sending step, the message, and the step that acts on it: a delegation,
        # each vote on its way to the tally, or each argument in a debate.
        {
            ?match pair:hasNodeBinding ?delegatingBinding , ?messageBinding , ?receivingBinding .
            ?delegatingBinding pair:bindsPatternNode pat:AgentDelegation_DelegatingStepNode ;
                               pair:matchedElement ?delegatingStep .
            ?messageBinding    pair:bindsPatternNode pat:AgentDelegation_MessageNode ;
                               pair:matchedElement ?message .
            ?receivingBinding  pair:bindsPatternNode pat:AgentDelegation_ReceivingStepNode ;
                               pair:matchedElement ?receivingStep .
        }
        UNION
        {
            ?match pair:hasNodeBinding ?delegatingBinding , ?messageBinding , ?receivingBinding .
            ?delegatingBinding pair:bindsPatternNode pat:Voting_FirstVoterNode ;
                               pair:matchedElement ?delegatingStep .
            ?messageBinding    pair:bindsPatternNode pat:Voting_FirstVoteNode ;
                               pair:matchedElement ?message .
            ?receivingBinding  pair:bindsPatternNode pat:Voting_AggregationStepNode ;
                               pair:matchedElement ?receivingStep .
        }
        UNION
        {
            ?match pair:hasNodeBinding ?delegatingBinding , ?messageBinding , ?receivingBinding .
            ?delegatingBinding pair:bindsPatternNode pat:Voting_SecondVoterNode ;
                               pair:matchedElement ?delegatingStep .
            ?messageBinding    pair:bindsPatternNode pat:Voting_SecondVoteNode ;
                               pair:matchedElement ?message .
            ?receivingBinding  pair:bindsPatternNode pat:Voting_AggregationStepNode ;
                               pair:matchedElement ?receivingStep .
        }
        UNION
        {
            ?match pair:hasNodeBinding ?delegatingBinding , ?messageBinding , ?receivingBinding .
            ?delegatingBinding pair:bindsPatternNode pat:Debate_FirstAgentNode ;
                               pair:matchedElement ?delegatingStep .
            ?messageBinding    pair:bindsPatternNode pat:Debate_FirstArgumentNode ;
                               pair:matchedElement ?message .
            ?receivingBinding  pair:bindsPatternNode pat:Debate_SecondAgentNode ;
                               pair:matchedElement ?receivingStep .
        }
        UNION
        {
            ?match pair:hasNodeBinding ?delegatingBinding , ?messageBinding , ?receivingBinding .
            ?delegatingBinding pair:bindsPatternNode pat:Debate_SecondAgentNode ;
                               pair:matchedElement ?delegatingStep .
            ?messageBinding    pair:bindsPatternNode pat:Debate_SecondArgumentNode ;
                               pair:matchedElement ?message .
            ?receivingBinding  pair:bindsPatternNode pat:Debate_FirstAgentNode ;
                               pair:matchedElement ?receivingStep .
        }

        FILTER NOT EXISTS {
            ?mediatingStep pair:playsRole ?mediatingRole .
            { ?mediatingRole pair:subRoleOf* pair:PolicyEnforcementStep }
            UNION
            { ?mediatingRole pair:subRoleOf* pair:GuardrailStep }
            UNION
            { ?mediatingRole pair:subRoleOf* pair:MemoryValidationStep }
            UNION
            { ?mediatingRole pair:subRoleOf* pair:OutputValidationStep }
            {
                ?mediatingStep beam:use ?message .
            }
            UNION
            {
                ?mediatingStep beam:produce/^beam:use ?receivingStep .
            }
        }

    }

    pat:InsecureAgentCommunicationRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/insecure-agent-communication"
    )) AS ?riskFinding)
}
