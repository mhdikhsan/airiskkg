PREFIX pat:   <http://w3id.org/airiskkg/patterns#>
PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:  <http://w3id.org/beam/core#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate personal data retained"@en ;
        dct:description "A log record or agent memory carries a sensitive category, so personal data is represented as kept beyond the interaction it served."@en ;
        pair:findingStatus "candidate" ;
        pair:generatedByRiskPattern pat:PersonalDataRetainedRiskPattern ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif ?motif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:hasEvidence ?writeStep ,
            ?store ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition .
}
WHERE {
    {
        ?match
            a pair:MotifMatch ;
            pair:matchesMotif ?motif .
        {
            ?match pair:hasNodeBinding ?writeBinding , ?storeBinding .
            ?writeBinding pair:bindsPatternNode pat:PredLog_LoggingStepNode ;
                          pair:matchedElement ?writeStep .
            ?storeBinding pair:bindsPatternNode pat:PredLog_LogRecordNode ;
                          pair:matchedElement ?store .
        }
        UNION
        {
            ?match pair:hasNodeBinding ?writeBinding , ?storeBinding .
            ?writeBinding pair:bindsPatternNode pat:AgentMemory_WriteStepNode ;
                          pair:matchedElement ?writeStep .
            ?storeBinding pair:bindsPatternNode pat:AgentMemory_StoreNode ;
                          pair:matchedElement ?store .
        }

        # Read off the store rather than the writer's inputs, so a writer that
        # also redacts clears it.
        ?store pair:containsDataCategory/pair:subDataCategoryOf* pair:SensitiveInformation .
    }

    pat:PersonalDataRetainedRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/", ENCODE_FOR_URI(STR(?store)),
        "/personal-data-retained"
    )) AS ?riskFinding)
}
