PREFIX pat:   <http://w3id.org/airiskkg/patterns#>
PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:  <http://w3id.org/beam/core#>
PREFIX beamr: <http://w3id.org/beam/risk#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate misinformation from weak grounding"@en ;
        dct:description "A retrieval-augmented generation step produces a response from retrieved context, but no verification, evaluation, or scoring step over the response is represented in the architecture graph."@en ;
        pair:findingStatus "candidate" ;
        pair:generatedByRiskPattern pat:MisinformationFromWeakGroundingRiskPattern ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif pat:RetrievalAugmentedGenerationMotif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:hasEvidence ?query ,
            ?retrievedCtx ,
            ?genStep ,
            ?llm ,
            ?response ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition .
}
WHERE {
    {
        ?match
            a pair:MotifMatch ;
            pair:matchesMotif pat:RetrievalAugmentedGenerationMotif ;
            pair:hasNodeBinding ?queryBinding ,
                ?retrievedCtxBinding ,
                ?genStepBinding ,
                ?llmBinding ,
                ?responseBinding .

        ?queryBinding
            pair:bindsPatternNode pat:RAG_QueryNode ;
            pair:matchedElement ?query .
        ?retrievedCtxBinding
            pair:bindsPatternNode pat:RAG_RetrievedContextNode ;
            pair:matchedElement ?retrievedCtx .
        ?genStepBinding
            pair:bindsPatternNode pat:RAG_GenerationStepNode ;
            pair:matchedElement ?genStep .
        ?llmBinding
            pair:bindsPatternNode pat:RAG_LLMNode ;
            pair:matchedElement ?llm .
        ?responseBinding
            pair:bindsPatternNode pat:RAG_ResponseNode ;
            pair:matchedElement ?response .


        FILTER NOT EXISTS {
            ?verificationStep beam:use ?response .
            { ?verificationStep pair:playsRole/pair:subRoleOf* pair:EvaluationStep }
            UNION
            { ?verificationStep pair:playsRole/pair:subRoleOf* pair:ScoringStep }
        }


        FILTER NOT EXISTS {
            pat:MisinformationFromWeakGroundingRiskPattern pair:suggestedControl ?implementedControl .
            ?implementedControl beamr:associatedTo ?genStep .
        }
    }

    pat:MisinformationFromWeakGroundingRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/misinformation-weak-grounding"
    )) AS ?riskFinding)
}
