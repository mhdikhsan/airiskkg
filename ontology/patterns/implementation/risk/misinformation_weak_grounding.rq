PREFIX pat:   <http://w3id.org/airiskkg/patterns#>
PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:  <http://w3id.org/beam/core#>
PREFIX beamr: <http://w3id.org/beam/risk#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate misinformation from weak grounding"@en ;
        dct:description "A language model produces a response, or the results a retrieval returns, and no verification, evaluation, or scoring step over what it produced is represented in the architecture graph."@en ;
        pair:findingStatus "candidate" ;
        pair:generatedByRiskPattern pat:MisinformationFromWeakGroundingRiskPattern ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif ?motif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:hasEvidence ?query ,
            ?retrievedCtx ,
            ?genStep ,
            ?llm ,
            ?response ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition .
}
WHERE {
    {
        # RAG and its iterative, recursive and adaptive variants, each read
        # through the pattern nodes its own match query binds.
        {
            ?match
                a pair:MotifMatch ;
                pair:matchesMotif pat:RetrievalAugmentedGenerationMotif ;
                pair:hasNodeBinding ?queryBinding , ?retrievedCtxBinding ,
                    ?genStepBinding , ?llmBinding , ?responseBinding .
            ?queryBinding        pair:bindsPatternNode pat:RAG_QueryNode ;            pair:matchedElement ?query .
            ?retrievedCtxBinding pair:bindsPatternNode pat:RAG_RetrievedContextNode ; pair:matchedElement ?retrievedCtx .
            ?genStepBinding      pair:bindsPatternNode pat:RAG_GenerationStepNode ;   pair:matchedElement ?genStep .
            ?llmBinding          pair:bindsPatternNode pat:RAG_LLMNode ;              pair:matchedElement ?llm .
            ?responseBinding     pair:bindsPatternNode pat:RAG_ResponseNode ;         pair:matchedElement ?response .
            BIND(pat:RetrievalAugmentedGenerationMotif AS ?motif)
        }
        UNION
        {
            ?match
                a pair:MotifMatch ;
                pair:matchesMotif pat:IterativeRAGMotif ;
                pair:hasNodeBinding ?queryBinding , ?retrievedCtxBinding ,
                    ?genStepBinding , ?llmBinding , ?responseBinding .
            ?queryBinding        pair:bindsPatternNode pat:IterRAG_QueryNode ;            pair:matchedElement ?query .
            ?retrievedCtxBinding pair:bindsPatternNode pat:IterRAG_RetrievedContextNode ; pair:matchedElement ?retrievedCtx .
            ?genStepBinding      pair:bindsPatternNode pat:IterRAG_GenerationStepNode ;   pair:matchedElement ?genStep .
            ?llmBinding          pair:bindsPatternNode pat:IterRAG_LLMNode ;              pair:matchedElement ?llm .
            ?responseBinding     pair:bindsPatternNode pat:IterRAG_AnswerNode ;           pair:matchedElement ?response .
            BIND(pat:IterativeRAGMotif AS ?motif)
        }
        UNION
        {
            ?match
                a pair:MotifMatch ;
                pair:matchesMotif pat:RecursiveRAGMotif ;
                pair:hasNodeBinding ?queryBinding , ?retrievedCtxBinding ,
                    ?genStepBinding , ?llmBinding , ?responseBinding .
            ?queryBinding        pair:bindsPatternNode pat:RecRAG_QueryNode ;            pair:matchedElement ?query .
            ?retrievedCtxBinding pair:bindsPatternNode pat:RecRAG_RetrievedContextNode ; pair:matchedElement ?retrievedCtx .
            ?genStepBinding      pair:bindsPatternNode pat:RecRAG_GenerationStepNode ;   pair:matchedElement ?genStep .
            ?llmBinding          pair:bindsPatternNode pat:RecRAG_LLMNode ;              pair:matchedElement ?llm .
            ?responseBinding     pair:bindsPatternNode pat:RecRAG_AnswerNode ;           pair:matchedElement ?response .
            BIND(pat:RecursiveRAGMotif AS ?motif)
        }
        UNION
        {
            ?match
                a pair:MotifMatch ;
                pair:matchesMotif pat:AdaptiveRAGMotif ;
                pair:hasNodeBinding ?queryBinding , ?retrievedCtxBinding ,
                    ?genStepBinding , ?llmBinding , ?responseBinding .
            ?queryBinding        pair:bindsPatternNode pat:AdaRAG_QueryNode ;            pair:matchedElement ?query .
            ?retrievedCtxBinding pair:bindsPatternNode pat:AdaRAG_RetrievedContextNode ; pair:matchedElement ?retrievedCtx .
            ?genStepBinding      pair:bindsPatternNode pat:AdaRAG_GenerationStepNode ;   pair:matchedElement ?genStep .
            ?llmBinding          pair:bindsPatternNode pat:AdaRAG_LLMNode ;              pair:matchedElement ?llm .
            ?responseBinding     pair:bindsPatternNode pat:AdaRAG_AnswerNode ;           pair:matchedElement ?response .
            BIND(pat:AdaptiveRAGMotif AS ?motif)
        }
        UNION
        {
            # LLM-based retrieval: the model produces the results it returns, so
            # what it hands on is generated rather than looked up.
            ?match
                a pair:MotifMatch ;
                pair:matchesMotif pat:LLMBasedInformationRetrievalMotif ;
                pair:hasNodeBinding ?queryBinding , ?genStepBinding , ?llmBinding , ?responseBinding .
            ?queryBinding    pair:bindsPatternNode pat:LLMIR_QueryNode ;           pair:matchedElement ?query .
            ?genStepBinding  pair:bindsPatternNode pat:LLMIR_RetrievalStepNode ;   pair:matchedElement ?genStep .
            ?llmBinding      pair:bindsPatternNode pat:LLMIR_LLMNode ;             pair:matchedElement ?llm .
            ?responseBinding pair:bindsPatternNode pat:LLMIR_RetrievedResultNode ; pair:matchedElement ?response .
            BIND(pat:LLMBasedInformationRetrievalMotif AS ?motif)
        }

        FILTER NOT EXISTS {
            ?verificationStep beam:use ?response .
            { ?verificationStep pair:playsRole/pair:subRoleOf* pair:EvaluationStep }
            UNION
            { ?verificationStep pair:playsRole/pair:subRoleOf* pair:ScoringStep }
        }

    }

    pat:MisinformationFromWeakGroundingRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/misinformation-weak-grounding"
    )) AS ?riskFinding)
}
