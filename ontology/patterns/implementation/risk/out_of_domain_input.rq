PREFIX pat:   <http://w3id.org/airiskkg/patterns#>
PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:  <http://w3id.org/beam/core#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate out-of-domain input"@en ;
        dct:description "An input reaches a prediction step with no represented step that checks whether it lies within the domain the model was built for."@en ;
        pair:findingStatus "candidate" ;
        pair:generatedByRiskPattern pat:OutOfDomainInputRiskPattern ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif ?motif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:hasEvidence ?input ,
            ?predictionStep ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition .
}
WHERE {
    {
        ?match
            a pair:MotifMatch ;
            pair:matchesMotif ?motif .
        ?match pair:hasNodeBinding ?binding .
        # The step that serves the model, as each prediction motif names it.
        {
            ?binding pair:bindsPatternNode pat:Serving_PredictionStepNode ;
                     pair:matchedElement ?predictionStep .
        }

        ?predictionStep beam:use ?input .
        ?input a beam:Data ;
               pair:playsRole ?inputRole .
        { ?inputRole pair:subRoleOf* pair:PredictionInput }
        UNION
        { ?inputRole pair:subRoleOf* pair:UserInput }

        FILTER NOT EXISTS {
            ?check pair:playsRole/pair:subRoleOf* pair:InputDomainCheckStep .
            {
                ?check beam:produce ?checked .
                ?checked (^beam:use/beam:produce)* ?input .
            }
            UNION
            {
                ?check beam:produce/^beam:use ?predictionStep .
            }
        }
    }

    pat:OutOfDomainInputRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/", ENCODE_FOR_URI(STR(?predictionStep)),
        "/out-of-domain-input"
    )) AS ?riskFinding)
}
