PREFIX pat:   <http://w3id.org/airiskkg/patterns#>
PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:  <http://w3id.org/beam/core#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate improper retraining"@en ;
        dct:description "Data downstream of the model a training step produces flows back into that training step's input, with no represented validation of it on the way."@en ;
        pair:findingStatus "candidate" ;
        pair:generatedByRiskPattern pat:ImproperRetrainingRiskPattern ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif ?motif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:hasEvidence ?trainingStep ,
            ?model ,
            ?trainingData ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition .
}
WHERE {
    {
        ?match
            a pair:MotifMatch ;
            pair:matchesMotif ?motif .
        ?match pair:hasNodeBinding ?binding .
        # The step that fits the model, as each training motif names it.
        {
            ?binding pair:bindsPatternNode pat:BatchTrain_TrainingStepNode ;
                     pair:matchedElement ?trainingStep .
        }
        UNION
        {
            ?binding pair:bindsPatternNode pat:PipeTrain_TrainingJobNode ;
                     pair:matchedElement ?trainingStep .
        }
        UNION
        {
            ?binding pair:bindsPatternNode pat:TrainServe_TrainingStepNode ;
                     pair:matchedElement ?trainingStep .
        }
        UNION
        {
            ?binding pair:bindsPatternNode pat:TrainToServe_TrainingPipelineNode ;
                     pair:matchedElement ?trainingStep .
        }
        UNION
        {
            ?binding pair:bindsPatternNode pat:FineTune_TrainingStepNode ;
                     pair:matchedElement ?trainingStep .
        }

        ?trainingStep beam:produce ?model ;
                      beam:use ?trainingData .
        ?model a beam:StatisticalModel .
        ?trainingData a beam:Data .
        ?model (^beam:use/beam:produce)+ ?trainingData .

        FILTER NOT EXISTS {
            ?check pair:playsRole ?checkRole ;
                   beam:use ?before ;
                   beam:produce ?after .
            { ?checkRole pair:subRoleOf* pair:DataValidationStep }
            UNION
            { ?checkRole pair:subRoleOf* pair:HumanApprovalStep }
            UNION
            { ?checkRole pair:subRoleOf* pair:OutputValidationStep }
            ?model (^beam:use/beam:produce)* ?before .
            ?after (^beam:use/beam:produce)* ?trainingData .
        }
    }

    pat:ImproperRetrainingRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/", ENCODE_FOR_URI(STR(?trainingData)),
        "/improper-retraining"
    )) AS ?riskFinding)
}
