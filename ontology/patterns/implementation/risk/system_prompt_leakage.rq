PREFIX pat:   <http://w3id.org/airiskkg/patterns#>
PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:  <http://w3id.org/beam/core#>
PREFIX beamr: <http://w3id.org/beam/risk#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate system prompt leakage exposure"@en ;
        dct:description "A system prompt or hidden instruction is used in an LLM generation path that produces user-facing output."@en ;
        pair:findingStatus "candidate" ;
        pair:generatedByRiskPattern pat:SystemPromptLeakageRiskPattern ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif ?motif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:hasEvidence ?systemPrompt ,
            ?generationStep ,
            ?userFacingOutput ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition .
}
WHERE {
    {
        ?systemPrompt pair:playsRole/pair:subRoleOf* pair:SystemPrompt .
        ?generationStep
            beam:use ?systemPrompt ;
            beam:produce ?userFacingOutput ;
            pair:playsRole/pair:subRoleOf* pair:GenerationStep .
        ?userFacingOutput pair:playsRole/pair:subRoleOf* pair:UserFacingOutput .

        ?match
            a pair:MotifMatch ;
            pair:matchesMotif ?motif ;
            pair:hasNodeBinding/pair:matchedElement ?matchedElement .
        FILTER(?matchedElement IN (?systemPrompt, ?generationStep, ?userFacingOutput))


        # Nothing screens the output that the system prompt fed. The control is
        # an output-side screen: the two controls this pattern suggests beyond
        # prompt secrecy itself are guardrails and output validation.
        # Closed-world over the submitted graph only (Rule R4).
        FILTER NOT EXISTS {
            ?outputControl pair:playsRole ?outputControlRole .
            {
                ?outputControlRole pair:subRoleOf* pair:OutputValidationStep .
            }
            UNION
            {
                ?outputControlRole pair:subRoleOf* pair:OutputGuardrailStep .
            }
            UNION
            {
                ?outputControlRole pair:subRoleOf* pair:RedactionStep .
            }
            {
                ?outputControl beam:use ?userFacingOutput .
            }
            UNION
            {
                ?outputControl beam:produce ?userFacingOutput .
            }
        }
    }

    pat:SystemPromptLeakageRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/system-prompt-leakage"
    )) AS ?riskFinding)
}
