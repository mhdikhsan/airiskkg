PREFIX pat:   <http://w3id.org/airiskkg/patterns#>
PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:  <http://w3id.org/beam/core#>
PREFIX beamr: <http://w3id.org/beam/risk#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate agent goal hijack"@en ;
        dct:description "Content of untrusted provenance reaches the step that decides the agent's next action, with no represented validation or guardrail on the way."@en ;
        pair:findingStatus "candidate" ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif ?motif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:hasEvidence ?untrustedContent ,
            ?planningStep ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition .
}
WHERE {
    pat:GoalHijackRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    ?match
        a pair:MotifMatch ;
        pair:matchesMotif ?motif ;
        pair:hasNodeBinding ?planningBinding .
    {
        ?planningBinding pair:bindsPatternNode pat:ToolAgent_PlanningStepNode ;
                         pair:matchedElement ?planningStep .
    }
    UNION
    {
        ?planningBinding pair:bindsPatternNode pat:AgentDelegation_DelegatingStepNode ;
                         pair:matchedElement ?planningStep .
    }

    ?planningStep beam:use ?untrustedContent .
    ?untrustedContent pair:containsDataCategory/pair:subDataCategoryOf* pair:UntrustedContent .

    # No screening between the untrusted content and the decision.
    FILTER NOT EXISTS {
        ?screeningStep pair:playsRole ?screeningRole .
        { ?screeningRole pair:subRoleOf* pair:GuardrailStep }
        UNION
        { ?screeningRole pair:subRoleOf* pair:PolicyEnforcementStep }
        {
            ?screeningStep beam:produce ?untrustedContent .
        }
        UNION
        {
            ?screeningStep beam:inform ?planningStep .
        }
    }
    FILTER NOT EXISTS {
        pat:GoalHijackRiskPattern pair:suggestedControl ?implementedControl .
        ?implementedControl beamr:associatedTo ?planningStep .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/goal-hijack"
    )) AS ?riskFinding)
}
