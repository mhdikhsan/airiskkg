PREFIX pat:   <http://w3id.org/airiskkg/patterns#>
PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:  <http://w3id.org/beam/core#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate unexpected code execution"@en ;
        dct:description "A step that runs code executes what an agent's planning step produced, with no represented execution guardrail, policy check, output validation or approval in between."@en ;
        pair:findingStatus "candidate" ;
        pair:generatedByRiskPattern pat:UnexpectedCodeExecutionRiskPattern ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif ?motif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:hasEvidence ?planningStep ,
            ?executionStep ,
            ?executionResult ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition .
}
WHERE {
    {
        ?match
            a pair:MotifMatch ;
            pair:matchesMotif ?motif .
        # The planning step and the tool step it hands to, as each motif names them.
        {
            ?match pair:hasNodeBinding ?aBinding , ?bBinding .
            ?aBinding pair:bindsPatternNode pat:ToolAgent_PlanningStepNode ;
                      pair:matchedElement ?planningStep .
            ?bBinding pair:bindsPatternNode pat:ToolAgent_ActionStepNode ;
                      pair:matchedElement ?executionStep .
        }
        UNION
        {
            ?match pair:hasNodeBinding ?aBinding , ?bBinding .
            ?aBinding pair:bindsPatternNode pat:Registry_CoordinatorNode ;
                      pair:matchedElement ?planningStep .
            ?bBinding pair:bindsPatternNode pat:Registry_ToolStepNode ;
                      pair:matchedElement ?executionStep .
        }

        ?executionStep pair:playsRole/pair:subRoleOf* pair:CodeExecutionStep ;
                       beam:produce ?executionResult .
        ?planningStep beam:produce/^beam:use ?executionStep .

        FILTER NOT EXISTS {
            ?gate pair:playsRole ?gateRole ;
                  beam:produce/^beam:use ?executionStep .
            { ?gateRole pair:subRoleOf* pair:PolicyEnforcementStep }
            UNION
            { ?gateRole pair:subRoleOf* pair:OutputValidationStep }
            UNION
            { ?gateRole pair:subRoleOf* pair:HumanApprovalStep }
        }
    }

    pat:UnexpectedCodeExecutionRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/unexpected-code-execution"
    )) AS ?riskFinding)
}
