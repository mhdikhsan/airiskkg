PREFIX pat:   <http://w3id.org/airiskkg/patterns#>
PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:  <http://w3id.org/beam/core#>
PREFIX beamr: <http://w3id.org/beam/risk#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate unbounded LLM or retrieval consumption"@en ;
        dct:description "A query rewriting, retrieval, tool, or generation loop is represented without an explicit budget, rate, or loop control."@en ;
        pair:findingStatus "candidate" ;
        pair:generatedByRiskPattern pat:UnboundedConsumptionRiskPattern ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif ?motif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:hasEvidence ?loopSource ,
            ?loopTarget ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition .
}
WHERE {
    {
        ?match
            a pair:MotifMatch ;
            pair:matchesMotif ?motif .

        {
            ?match
                pair:hasNodeBinding/pair:matchedElement ?loopSource ;
                pair:hasNodeBinding/pair:matchedElement ?loopTarget .
            VALUES ?motif {
                pat:QueryRewritingMotif
                pat:RetrievalAugmentedGenerationMotif
            }
            ?loopSource beam:inform+ ?loopTarget .
            ?loopTarget beam:inform+ ?loopSource .
            FILTER(STR(?loopSource) < STR(?loopTarget))

            FILTER NOT EXISTS {
                ?controlStep pair:playsRole/pair:subRoleOf* pair:RateLimitControlStep .
                ?controlStep beam:inform* ?loopSource .
            }
        }
        UNION
        {
            # Direct prompting has no loop, so what makes its consumption
            # unbounded is that anyone can drive it: a generation step reachable
            # from public input, with nothing bounding the rate. Without that
            # test this branch asked only "is there an LLM call and no rate
            # limiter", which is true of nearly every unmitigated GenAI system -
            # a finding that fires on everything says nothing, and noise is what
            # breaks candidate framing.
            #
            # Positive and on a bound element of the match (Rule R10): the graph
            # has to state that the input is public. Where it does not, the
            # honest reading is that no publicly reachable path is represented,
            # not that none exists (Rule R4).
            VALUES ?motif { pat:DirectPromptingMotif }
            ?match
                pair:hasNodeBinding ?stepBinding ,
                    ?queryBinding ,
                    ?answerBinding .
            ?stepBinding
                pair:bindsPatternNode pat:DP_GenerationStepNode ;
                pair:matchedElement ?loopSource .
            ?queryBinding
                pair:bindsPatternNode pat:DP_QueryNode ;
                pair:matchedElement ?publicInput .
            ?answerBinding
                pair:bindsPatternNode pat:DP_AnswerNode ;
                pair:matchedElement ?loopTarget .

            ?publicInput pair:playsRole/pair:subRoleOf* pair:PublicUserInput .

            FILTER NOT EXISTS {
                ?controlStep pair:playsRole/pair:subRoleOf* pair:RateLimitControlStep .
                ?controlStep beam:inform* ?loopSource .
            }
        }
        FILTER NOT EXISTS {
            pat:UnboundedConsumptionRiskPattern pair:suggestedControl ?implementedControl .
            ?implementedControl beamr:associatedTo ?loopSource .
        }


    }

    pat:UnboundedConsumptionRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/unbounded-consumption"
    )) AS ?riskFinding)
}
