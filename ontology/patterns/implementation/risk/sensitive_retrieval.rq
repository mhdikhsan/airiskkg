PREFIX pat:     <http://w3id.org/airiskkg/patterns#>
PREFIX pair:      <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:    <http://w3id.org/beam/core#>
PREFIX beamr:   <http://w3id.org/beam/risk#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:     <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate sensitive data retrieval exposure"@en ;
        dct:description "Sensitive retrieved context reaches an LLM generation step and user-facing output without a represented disclosure control."@en ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif pat:VectorBasedInformationRetrievalMotif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:hasEvidence ?query ,
            ?retrievalStep ,
            ?vectorStore ,
            ?retrievedResult ,
            ?generationStep ,
            ?llm ,
            ?userFacingOutput ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition ;
        pair:findingStatus "candidate" .
}
WHERE {
    {
        ?match
            a pair:MotifMatch ;
            pair:matchesMotif pat:VectorBasedInformationRetrievalMotif ;
            pair:hasNodeBinding ?queryBinding ,
                ?retrievalBinding ,
                ?vectorStoreBinding ,
                ?resultBinding .

        ?queryBinding
            pair:bindsPatternNode pat:VectorIR_QueryNode ;
            pair:matchedElement ?query .

        ?retrievalBinding
            pair:bindsPatternNode pat:VectorIR_RetrievalStepNode ;
            pair:matchedElement ?retrievalStep .

        ?vectorStoreBinding
            pair:bindsPatternNode pat:VectorIR_VectorStoreNode ;
            pair:matchedElement ?vectorStore .

        ?resultBinding
            pair:bindsPatternNode pat:VectorIR_RetrievedResultNode ;
            pair:matchedElement ?retrievedResult .

        ?vectorStore pair:containsDataCategory/pair:subDataCategoryOf* pair:SensitiveInformation .
        ?retrievedResult pair:containsDataCategory/pair:subDataCategoryOf* pair:SensitiveInformation .

        {
            ?generationStep
                beam:use ?retrievedResult ;
                beam:use ?llm ;
                beam:produce ?userFacingOutput ;
                pair:playsRole/pair:subRoleOf* pair:GenerationStep .
            ?llm pair:playsRole/pair:subRoleOf* pair:GenerativeModel .
            ?userFacingOutput pair:playsRole/pair:subRoleOf* pair:UserFacingOutput .
        }
        UNION
        {
            ?intermediateStep
                beam:use ?retrievedResult ;
                beam:produce ?enhancedContext .
            ?generationStep
                beam:use ?enhancedContext ;
                beam:use ?llm ;
                beam:produce ?userFacingOutput ;
                pair:playsRole/pair:subRoleOf* pair:GenerationStep .
            ?llm pair:playsRole/pair:subRoleOf* pair:GenerativeModel .
            ?userFacingOutput pair:playsRole/pair:subRoleOf* pair:UserFacingOutput .
        }

        FILTER NOT EXISTS {
            pat:SensitiveDataRetrievalExposureRiskPattern
                pair:suggestedControl ?implementedDisclosureControl .
            ?implementedDisclosureControl beamr:associatedTo ?controlledElement .
            FILTER(?controlledElement IN (
                ?retrievalStep,
                ?vectorStore,
                ?retrievedResult,
                ?generationStep,
                ?llm,
                ?userFacingOutput
            ))
        }
    .
    }

    pat:SensitiveDataRetrievalExposureRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/sensitive-data-retrieval-exposure"
    )) AS ?riskFinding)
}
