PREFIX pat:   <http://w3id.org/airiskkg/patterns#>
PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:  <http://w3id.org/beam/core#>
PREFIX beamr: <http://w3id.org/beam/risk#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX bpmn:  <https://sBPMN.github.io/2.0/classes#>
PREFIX bp:    <https://sBPMN.github.io/2.0/properties#>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate improper LLM output handling"@en ;
        dct:description "A user-facing LLM output is produced without a represented output validation, sanitization, or guardrail step."@en ;
        pair:findingStatus "candidate" ;
        pair:generatedByRiskPattern pat:ImproperOutputHandlingRiskPattern ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif ?motif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:hasEvidence ?generationStep ,
            ?llm ,
            ?userFacingOutput ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition .
}
WHERE {
    {
        ?match
            a pair:MotifMatch ;
            pair:matchesMotif ?motif ;
            pair:hasNodeBinding/pair:matchedElement ?generationStep .

        ?generationStep
            beam:use ?llm ;
            beam:produce ?userFacingOutput ;
            pair:playsRole ?generationRole .
        ?generationRole pair:subRoleOf* pair:GenerationStep .
        ?llm pair:playsRole/pair:subRoleOf* pair:GenerativeModel .
        ?userFacingOutput pair:playsRole/pair:subRoleOf* pair:UserFacingOutput .

        # An output is handled when a control step reads it before release, or
        # when a control step is what produced it - an interposed screen sits on
        # the path rather than beside it, so it produces the user-facing output
        # instead of consuming it. Accepting only the reading shape rewarded
        # appending an observer while the unscreened text still travelled on.
        FILTER NOT EXISTS {
            ?outputControlStep pair:playsRole ?outputControlRole .
            {
                ?outputControlRole pair:subRoleOf* pair:OutputValidationStep .
            }
            UNION
            {
                ?outputControlRole pair:subRoleOf* pair:OutputGuardrailStep .
            }
            {
                ?outputControlStep beam:use ?userFacingOutput .
            }
            UNION
            {
                ?outputControlStep beam:produce ?userFacingOutput .
            }
        }

        # The same question asked of the business process, when one is submitted.
        # A human task downstream of the activity this system refines, reading
        # what the system produced before it travels on, is an output control -
        # it just does not live in the inference pipeline, which is not where
        # organisations put approvals. Without this the finding could only be
        # cleared by inserting a control step into the architecture, and a review
        # that genuinely exists went on being reported as absent.
        #
        # Nothing is asserted into the architecture and no facet is read: this is
        # a positive structural claim over represented business structure,
        # evaluated on elements the match already bound. Admissible under R10
        # because an approval gate is a control, and graph-relative under R4 like
        # every other absence here. Inert when no process is submitted.
        FILTER NOT EXISTS {
            ?activity
                pair:refinedBy ?system ;
                pair:businessFollows ?reviewTask .
            ?system beam:hasResource ?userFacingOutput .

            ?reviewTask
                a/rdfs:subClassOf* bpmn:userTask ;
                bp:resourceRole ?performer ;
                bp:dataInputAssociation ?reviewInput .
            ?performer a/rdfs:subClassOf* bpmn:humanPerformer .

            # It must read what this activity produced. Without this any later
            # human step clears the finding - "close the ticket" is also a
            # userTask, and it reviews nothing.
            ?reviewInput bp:sourceRef ?reviewedData .
            ?producedData
                bp:sourceRef ?activity ;
                bp:targetRef ?reviewedData .
        }

    }

    pat:ImproperOutputHandlingRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/improper-output-handling"
    )) AS ?riskFinding)
}
