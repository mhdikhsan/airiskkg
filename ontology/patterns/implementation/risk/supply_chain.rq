PREFIX pat:   <http://w3id.org/airiskkg/patterns#>
PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:  <http://w3id.org/beam/core#>
PREFIX beamr: <http://w3id.org/beam/risk#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate supply chain compromise"@en ;
        dct:description "The architecture uses an external model, provider credential, package, artifact, or dependency in an LLM application path."@en ;
        pair:findingStatus "candidate" ;
        pair:generatedByRiskPattern pat:SupplyChainCompromiseRiskPattern ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif ?motif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:hasEvidence ?externalResource ,
            ?usingStep ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition .
}
WHERE {
    {
        ?match
            a pair:MotifMatch ;
            pair:matchesMotif ?motif ;
            pair:hasNodeBinding ?resourceBinding , ?stepBinding .

        # The resource each motif takes in from outside, and the step using it.
        {
            ?resourceBinding pair:bindsPatternNode pat:ExtDep_ExternalResourceNode ;
                             pair:matchedElement ?externalResource .
            ?stepBinding pair:bindsPatternNode pat:ExtDep_UsingStepNode ;
                         pair:matchedElement ?usingStep .
        }
        UNION
        {
            ?resourceBinding pair:bindsPatternNode pat:FineTune_BaseModelNode ;
                             pair:matchedElement ?externalResource .
            ?stepBinding pair:bindsPatternNode pat:FineTune_TrainingStepNode ;
                         pair:matchedElement ?usingStep .
        }
        UNION
        {
            ?resourceBinding pair:bindsPatternNode pat:ModelLoad_ModelArtifactNode ;
                             pair:matchedElement ?externalResource .
            ?stepBinding pair:bindsPatternNode pat:ModelLoad_LoadStepNode ;
                         pair:matchedElement ?usingStep .
        }

        # External by declaration, or an artifact that enters the graph rather than being built in it.
        {
            ?externalResource pair:playsRole/pair:subRoleOf* pair:ExternalDependency .
        }
        UNION
        {
            ?externalResource pair:playsRole ?artifactRole .
            FILTER NOT EXISTS { ?externalResource pair:playsRole/pair:subRoleOf* pair:ExternalDependency }
            FILTER NOT EXISTS { ?producer beam:produce ?externalResource }
        }
    }

    pat:SupplyChainCompromiseRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/supply-chain"
    )) AS ?riskFinding)
}
