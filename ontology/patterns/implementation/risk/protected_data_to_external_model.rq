PREFIX pat:   <http://w3id.org/airiskkg/patterns#>
PREFIX pair:  <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:  <http://w3id.org/beam/core#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:   <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate protected data to external model"@en ;
        dct:description "A step that uses a model marked as external reads content carrying a sensitive or confidential category, so that content is represented as leaving for a third-party provider."@en ;
        pair:findingStatus "candidate" ;
        pair:generatedByRiskPattern pat:ProtectedDataToExternalModelRiskPattern ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif ?motif ;
        pair:hasDerivedMechanism ?mechanism ;
        pair:hasEvidence ?protectedInput ,
            ?modelStep ,
            ?externalModel ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition .
}
WHERE {
    {
        ?match
            a pair:MotifMatch ;
            pair:matchesMotif ?motif .
        ?match pair:hasNodeBinding ?binding .
        {
            ?binding pair:bindsPatternNode pat:DP_GenerationStepNode ;
                     pair:matchedElement ?modelStep .
        }
        UNION
        {
            ?binding pair:bindsPatternNode pat:RAG_GenerationStepNode ;
                     pair:matchedElement ?modelStep .
        }
        UNION
        {
            ?binding pair:bindsPatternNode pat:SyncPred_PredictionStepNode ;
                     pair:matchedElement ?modelStep .
        }

        ?modelStep beam:use ?externalModel , ?protectedInput .
        ?externalModel a beam:StatisticalModel ;
                       pair:playsRole/pair:subRoleOf* pair:ExternalModel .
        ?protectedInput a beam:Data ;
                        pair:containsDataCategory ?category .
        # A redaction step upstream clears this: the category does not travel through one.
        {
            ?category pair:subDataCategoryOf* pair:SensitiveInformation .
        }
        UNION
        {
            ?category pair:subDataCategoryOf* pair:ConfidentialInformation .
        }
        # The provider's own credential is meant for the provider.
        FILTER NOT EXISTS {
            ?protectedInput pair:playsRole/pair:subRoleOf* pair:AccessCredential .
        }
    }

    pat:ProtectedDataToExternalModelRiskPattern
        pair:hasMechanism ?mechanism ;
        pair:hasApplicabilityCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/", ENCODE_FOR_URI(STR(?modelStep)),
        "/protected-data-to-external-model"
    )) AS ?riskFinding)
}
