PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT {
    ?match
        a pair:MotifMatch ;
        rdfs:label "Output screening motif match"@en ;
        pair:matchesMotif pat:OutputScreeningMotif ;
        pair:hasNodeBinding ?generationBinding , ?responseBinding , ?screeningBinding .

    ?generationBinding
        a pair:NodeBinding ;
        pair:bindsPatternNode pat:OutputScreening_GenerationStepNode ;
        pair:matchedElement ?generationStep .

    ?responseBinding
        a pair:NodeBinding ;
        pair:bindsPatternNode pat:OutputScreening_ResponseNode ;
        pair:matchedElement ?response .

    ?screeningBinding
        a pair:NodeBinding ;
        pair:bindsPatternNode pat:OutputScreening_ScreeningStepNode ;
        pair:matchedElement ?screeningStep .
}
WHERE {
    ?generationStep
        a/rdfs:subClassOf* beam:Process ;
        beam:produce ?response ;
        pair:playsRole/pair:subRoleOf* pair:GenerationStep .

    ?response a beam:Data ; pair:playsRole/pair:subRoleOf* pair:LLMResponse .

    ?screeningStep
        a/rdfs:subClassOf* beam:Process ;
        beam:use ?response ;
        pair:playsRole/pair:subRoleOf* pair:OutputGuardrailStep .

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/motif-match/output-screening/",
        ENCODE_FOR_URI(STR(?screeningStep)), "/",
        ENCODE_FOR_URI(STR(?response)), "/",
        ENCODE_FOR_URI(STR(?generationStep))
    )) AS ?match)

    BIND(IRI(CONCAT(STR(?match), "/binding/generation-step")) AS ?generationBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/response")) AS ?responseBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/screening-step")) AS ?screeningBinding)
}
