PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT {
    ?match
        a pair:MotifMatch ;
        rdfs:label "Adaptive RAG motif match"@en ;
        pair:matchesMotif pat:AdaptiveRAGMotif ;
        pair:hasNodeBinding ?queryB , ?judgeStepB , ?decisionB , ?knowledgeSourceB ,
            ?retrievalStepB , ?retrievedCtxB , ?llmB , ?genStepB , ?answerB .

    ?queryB           a pair:NodeBinding ; pair:bindsPatternNode pat:AdaRAG_QueryNode ;            pair:matchedElement ?query .
    ?judgeStepB       a pair:NodeBinding ; pair:bindsPatternNode pat:AdaRAG_JudgeStepNode ;        pair:matchedElement ?judgeStep .
    ?decisionB        a pair:NodeBinding ; pair:bindsPatternNode pat:AdaRAG_DecisionNode ;         pair:matchedElement ?decision .
    ?knowledgeSourceB a pair:NodeBinding ; pair:bindsPatternNode pat:AdaRAG_KnowledgeSourceNode ;  pair:matchedElement ?knowledgeSource .
    ?retrievalStepB   a pair:NodeBinding ; pair:bindsPatternNode pat:AdaRAG_RetrievalStepNode ;    pair:matchedElement ?retrievalStep .
    ?retrievedCtxB    a pair:NodeBinding ; pair:bindsPatternNode pat:AdaRAG_RetrievedContextNode ; pair:matchedElement ?retrievedCtx .
    ?llmB             a pair:NodeBinding ; pair:bindsPatternNode pat:AdaRAG_LLMNode ;              pair:matchedElement ?llm .
    ?genStepB         a pair:NodeBinding ; pair:bindsPatternNode pat:AdaRAG_GenerationStepNode ;   pair:matchedElement ?genStep .
    ?answerB          a pair:NodeBinding ; pair:bindsPatternNode pat:AdaRAG_AnswerNode ;           pair:matchedElement ?answer .
}
WHERE {
    # Retrieval on demand: a judge reads the query before anything is retrieved.
    ?judgeStep a/rdfs:subClassOf* beam:Process ;
               pair:playsRole/pair:subRoleOf* pair:RetrievalJudgeStep ;
               beam:use ?query ;
               beam:produce ?decision .
    ?query a beam:Data ; pair:playsRole/pair:subRoleOf* pair:UserInput .
    ?decision a beam:Data ; pair:playsRole/pair:subRoleOf* pair:RetrievalDecision .

    ?retrievalStep a/rdfs:subClassOf* beam:Process ;
                   pair:playsRole/pair:subRoleOf* pair:RetrievalStep ;
                   beam:use ?decision ;
                   beam:use ?knowledgeSource ;
                   beam:produce ?retrievedCtx .
    ?knowledgeSource a beam:Data ; pair:playsRole/pair:subRoleOf* pair:KnowledgeSource .
    ?retrievedCtx a beam:Data ; pair:playsRole/pair:subRoleOf* pair:RetrievedContext .
    ?retrievedCtx (^beam:use/beam:produce)* ?ctxForGeneration .
    ?ctxForGeneration pair:playsRole/pair:subRoleOf* pair:RetrievedContext .

    ?genStep a/rdfs:subClassOf* beam:Process ;
             pair:playsRole/pair:subRoleOf* pair:GenerationStep ;
             beam:use ?ctxForGeneration ;
             beam:use ?llm ;
             beam:produce ?answer .
    ?llm a beam:StatisticalModel ; pair:playsRole/pair:subRoleOf* pair:GenerativeModel .
    ?answer a beam:Data ; pair:playsRole/pair:subRoleOf* pair:LLMResponse .

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/motif-match/adaptive-rag/",
        ENCODE_FOR_URI(STR(?judgeStep)), "/",
        ENCODE_FOR_URI(STR(?retrievalStep)), "/",
        ENCODE_FOR_URI(STR(?genStep))
    )) AS ?match)

    BIND(IRI(CONCAT(STR(?match), "/binding/query"))             AS ?queryB)
    BIND(IRI(CONCAT(STR(?match), "/binding/judge-step"))        AS ?judgeStepB)
    BIND(IRI(CONCAT(STR(?match), "/binding/decision"))          AS ?decisionB)
    BIND(IRI(CONCAT(STR(?match), "/binding/knowledge-source"))  AS ?knowledgeSourceB)
    BIND(IRI(CONCAT(STR(?match), "/binding/retrieval-step"))    AS ?retrievalStepB)
    BIND(IRI(CONCAT(STR(?match), "/binding/retrieved-context")) AS ?retrievedCtxB)
    BIND(IRI(CONCAT(STR(?match), "/binding/llm"))               AS ?llmB)
    BIND(IRI(CONCAT(STR(?match), "/binding/generation-step"))   AS ?genStepB)
    BIND(IRI(CONCAT(STR(?match), "/binding/answer"))            AS ?answerB)
}
