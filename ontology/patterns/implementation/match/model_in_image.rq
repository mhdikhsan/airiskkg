PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Auto-derived faithful projection of pat:ModelInImageMotif (declared PatternNode/
# PatternEdge structure). Matches structure only (candidate framing): each
# declared node is bound by expectedClass + expectedRole, each declared edge
# is required. No risk semantics here - those come from a risk pattern.

CONSTRUCT {
    ?match
        a pair:MotifMatch ;
        rdfs:label "Model-in-Image Motif match"@en ;
        pair:matchesMotif pat:ModelInImageMotif ;
        pair:hasNodeBinding ?deploymentStepBinding ,
            ?imageBuildStepBinding ,
            ?modelArtifactBinding ,
            ?predictionStepBinding ,
            ?servingImageBinding ,
            ?trainingStepBinding .

    ?deploymentStepBinding a pair:NodeBinding ; pair:bindsPatternNode pat:ModelImage_DeploymentStepNode ; pair:matchedElement ?deploymentStep .
    ?imageBuildStepBinding a pair:NodeBinding ; pair:bindsPatternNode pat:ModelImage_ImageBuildStepNode ; pair:matchedElement ?imageBuildStep .
    ?modelArtifactBinding a pair:NodeBinding ; pair:bindsPatternNode pat:ModelImage_ModelArtifactNode ; pair:matchedElement ?modelArtifact .
    ?predictionStepBinding a pair:NodeBinding ; pair:bindsPatternNode pat:ModelImage_PredictionStepNode ; pair:matchedElement ?predictionStep .
    ?servingImageBinding a pair:NodeBinding ; pair:bindsPatternNode pat:ModelImage_ServingImageNode ; pair:matchedElement ?servingImage .
    ?trainingStepBinding a pair:NodeBinding ; pair:bindsPatternNode pat:ModelImage_TrainingStepNode ; pair:matchedElement ?trainingStep .
}
WHERE {
    ?deploymentStep a beam:Process ;
           pair:playsRole/pair:subRoleOf* pair:DeploymentStep .
    ?imageBuildStep a beam:Process ;
           pair:playsRole/pair:subRoleOf* pair:ImageBuildStep .
    ?modelArtifact a beam:StatisticalModel ;
           pair:playsRole/pair:subRoleOf* pair:ModelArtifact .
    ?predictionStep a beam:Infer ;
           pair:playsRole/pair:subRoleOf* pair:PredictionStep .
    ?servingImage a beam:Data ;
           pair:playsRole/pair:subRoleOf* pair:ServingImage .
    ?trainingStep a beam:Train ;
           pair:playsRole/pair:subRoleOf* pair:TrainingStep .

    ?trainingStep beam:produce ?modelArtifact .
    ?trainingStep beam:inform ?imageBuildStep .
    ?imageBuildStep beam:use ?modelArtifact .
    ?imageBuildStep beam:produce ?servingImage .
    ?deploymentStep beam:use ?servingImage .
    ?deploymentStep beam:inform ?predictionStep .
    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/motif-match/model-in-image/",
        ENCODE_FOR_URI(STR(?deploymentStep)),
        "/",
        ENCODE_FOR_URI(STR(?imageBuildStep)),
        "/",
        ENCODE_FOR_URI(STR(?modelArtifact)),
        "/",
        ENCODE_FOR_URI(STR(?predictionStep)),
        "/",
        ENCODE_FOR_URI(STR(?servingImage)),
        "/",
        ENCODE_FOR_URI(STR(?trainingStep))
    )) AS ?match)

    BIND(IRI(CONCAT(STR(?match), "/binding/deployment-step")) AS ?deploymentStepBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/image-build-step")) AS ?imageBuildStepBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/model-artifact")) AS ?modelArtifactBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/prediction-step")) AS ?predictionStepBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/serving-image")) AS ?servingImageBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/training-step")) AS ?trainingStepBinding)
}
