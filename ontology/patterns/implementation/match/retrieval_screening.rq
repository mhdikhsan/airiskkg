PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT {
    ?match
        a pair:MotifMatch ;
        rdfs:label "Retrieval screening motif match"@en ;
        pair:matchesMotif pat:RetrievalScreeningMotif ;
        pair:hasNodeBinding ?contextBinding , ?screeningBinding , ?decisionBinding , ?generationBinding .

    ?contextBinding    a pair:NodeBinding ; pair:bindsPatternNode pat:RetrievalScreening_RetrievedContextNode ; pair:matchedElement ?retrievedCtx .
    ?screeningBinding  a pair:NodeBinding ; pair:bindsPatternNode pat:RetrievalScreening_ScreeningStepNode ;    pair:matchedElement ?screeningStep .
    ?decisionBinding   a pair:NodeBinding ; pair:bindsPatternNode pat:RetrievalScreening_DecisionNode ;         pair:matchedElement ?decision .
    ?generationBinding a pair:NodeBinding ; pair:bindsPatternNode pat:RetrievalScreening_GenerationStepNode ;   pair:matchedElement ?generationStep .
}
WHERE {
    ?screeningStep
        a/rdfs:subClassOf* beam:Process ;
        beam:use ?retrievedCtx ;
        beam:produce ?decision ;
        pair:playsRole/pair:subRoleOf* pair:InputGuardrailStep .

    ?retrievedCtx a beam:Data ; pair:playsRole/pair:subRoleOf* pair:RetrievedContext .

    ?decision a beam:Data ; pair:playsRole/pair:subRoleOf* pair:GuardrailDecision .

    ?generationStep
        a/rdfs:subClassOf* beam:Process ;
        beam:use ?decision ;
        pair:playsRole/pair:subRoleOf* pair:GenerationStep .

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/motif-match/retrieval-screening/",
        ENCODE_FOR_URI(STR(?screeningStep)), "/",
        ENCODE_FOR_URI(STR(?retrievedCtx)), "/",
        ENCODE_FOR_URI(STR(?decision)), "/",
        ENCODE_FOR_URI(STR(?generationStep))
    )) AS ?match)

    BIND(IRI(CONCAT(STR(?match), "/binding/retrieved-context")) AS ?contextBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/screening-step"))    AS ?screeningBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/decision"))          AS ?decisionBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/generation-step"))   AS ?generationBinding)
}
