PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT {
    ?match
        a pair:MotifMatch ;
        rdfs:label "Tool/agent registry motif match"@en ;
        pair:matchesMotif pat:ToolAgentRegistryMotif ;
        pair:hasNodeBinding ?registryB , ?coordinatorB , ?assignmentB , ?toolB , ?resultB .

    ?registryB    a pair:NodeBinding ; pair:bindsPatternNode pat:Registry_RegistryNode ;    pair:matchedElement ?registry .
    ?coordinatorB a pair:NodeBinding ; pair:bindsPatternNode pat:Registry_CoordinatorNode ; pair:matchedElement ?coordinator .
    ?assignmentB  a pair:NodeBinding ; pair:bindsPatternNode pat:Registry_AssignmentNode ;  pair:matchedElement ?assignment .
    ?toolB        a pair:NodeBinding ; pair:bindsPatternNode pat:Registry_ToolStepNode ;    pair:matchedElement ?toolStep .
    ?resultB      a pair:NodeBinding ; pair:bindsPatternNode pat:Registry_ResultNode ;      pair:matchedElement ?result .
}
WHERE {
    ?coordinator a/rdfs:subClassOf* beam:Process ;
                 pair:playsRole/pair:subRoleOf* pair:PlanningStep ;
                 beam:use ?registry ;
                 beam:produce ?assignment .
    ?registry a beam:Data ; pair:playsRole/pair:subRoleOf* pair:ToolRegistry .
    ?assignment a beam:Data .

    ?toolStep a/rdfs:subClassOf* beam:Process ;
              pair:playsRole/pair:subRoleOf* pair:ToolInvocationStep ;
              beam:use ?assignment ;
              beam:produce ?result .
    ?result a beam:Data .

    FILTER(?coordinator != ?toolStep)
    FILTER(?assignment != ?registry)

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/motif-match/tool-agent-registry/",
        ENCODE_FOR_URI(STR(?coordinator)), "/",
        ENCODE_FOR_URI(STR(?registry)), "/",
        ENCODE_FOR_URI(STR(?toolStep)), "/",
        ENCODE_FOR_URI(STR(?assignment)), "/",
        ENCODE_FOR_URI(STR(?result))
    )) AS ?match)

    BIND(IRI(CONCAT(STR(?match), "/binding/registry"))    AS ?registryB)
    BIND(IRI(CONCAT(STR(?match), "/binding/coordinator")) AS ?coordinatorB)
    BIND(IRI(CONCAT(STR(?match), "/binding/assignment"))  AS ?assignmentB)
    BIND(IRI(CONCAT(STR(?match), "/binding/tool-step"))   AS ?toolB)
    BIND(IRI(CONCAT(STR(?match), "/binding/result"))      AS ?resultB)
}
