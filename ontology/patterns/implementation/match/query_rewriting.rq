PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT {
    ?match
        a pair:MotifMatch ;
        rdfs:label "Query rewriting motif match"@en ;
        pair:matchesMotif pat:QueryRewritingMotif ;
        pair:hasNodeBinding ?rewriteStepBinding ,
            ?llmBinding ,
            ?rewrittenQueryBinding ,
            ?retrievalStepBinding ,
            ?retrievedContextBinding .

    ?rewriteStepBinding a pair:NodeBinding ;
        pair:bindsPatternNode pat:QueryRewrite_RewriteStepNode ;
        pair:matchedElement ?rewriteStep .

    ?llmBinding a pair:NodeBinding ;
        pair:bindsPatternNode pat:QueryRewrite_LLMNode ;
        pair:matchedElement ?llm .

    ?rewrittenQueryBinding a pair:NodeBinding ;
        pair:bindsPatternNode pat:QueryRewrite_RewrittenQueryNode ;
        pair:matchedElement ?rewrittenQuery .

    ?retrievalStepBinding a pair:NodeBinding ;
        pair:bindsPatternNode pat:QueryRewrite_RetrievalStepNode ;
        pair:matchedElement ?retrievalStep .

    ?retrievedContextBinding a pair:NodeBinding ;
        pair:bindsPatternNode pat:QueryRewrite_RetrievedContextNode ;
        pair:matchedElement ?retrievedContext .
}
WHERE {
    ?rewriteStep
        beam:use ?llm ;
        beam:produce ?rewrittenQuery ;
        pair:playsRole ?rewriteRole .
    ?rewriteRole pair:subRoleOf* pair:QueryReformulationStep .

    ?llm pair:playsRole ?llmRole .
    ?llmRole pair:subRoleOf* pair:GenerativeModel .

    ?rewrittenQuery pair:playsRole ?rewrittenQueryRole .
    ?rewrittenQueryRole pair:subRoleOf* pair:UserInput .

    ?retrievalStep
        beam:use ?rewrittenQuery ;
        beam:produce ?retrievedContext ;
        pair:playsRole ?retrievalRole .
    ?retrievalRole pair:subRoleOf* pair:RetrievalStep .

    ?retrievedContext pair:playsRole ?retrievedRole .
    ?retrievedRole pair:subRoleOf* pair:RetrievedContext .

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/motif-match/",
        ENCODE_FOR_URI(STR(?rewriteStep)),
        "/query-rewriting/",
        ENCODE_FOR_URI(STR(?rewrittenQuery)),
        "/",
        ENCODE_FOR_URI(STR(?retrievedContext))
    )) AS ?match)

    BIND(IRI(CONCAT(STR(?match), "/binding/rewrite-step")) AS ?rewriteStepBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/llm")) AS ?llmBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/rewritten-query")) AS ?rewrittenQueryBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/retrieval-step")) AS ?retrievalStepBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/retrieved-context")) AS ?retrievedContextBinding)
}
