PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT {
    ?match
        a pair:MotifMatch ;
        rdfs:label "Recursive RAG motif match"@en ;
        pair:matchesMotif pat:RecursiveRAGMotif ;
        pair:hasNodeBinding ?queryB , ?knowledgeSourceB , ?retrievalStepB , ?retrievedCtxB ,
            ?llmB , ?genStepB , ?answerB , ?judgeStepB , ?decisionB ,
            ?transformB , ?subQueryB .

    ?queryB           a pair:NodeBinding ; pair:bindsPatternNode pat:RecRAG_QueryNode ;              pair:matchedElement ?query .
    ?knowledgeSourceB a pair:NodeBinding ; pair:bindsPatternNode pat:RecRAG_KnowledgeSourceNode ;    pair:matchedElement ?knowledgeSource .
    ?retrievalStepB   a pair:NodeBinding ; pair:bindsPatternNode pat:RecRAG_RetrievalStepNode ;      pair:matchedElement ?retrievalStep .
    ?retrievedCtxB    a pair:NodeBinding ; pair:bindsPatternNode pat:RecRAG_RetrievedContextNode ;   pair:matchedElement ?retrievedCtx .
    ?llmB             a pair:NodeBinding ; pair:bindsPatternNode pat:RecRAG_LLMNode ;                pair:matchedElement ?llm .
    ?genStepB         a pair:NodeBinding ; pair:bindsPatternNode pat:RecRAG_GenerationStepNode ;     pair:matchedElement ?genStep .
    ?answerB          a pair:NodeBinding ; pair:bindsPatternNode pat:RecRAG_AnswerNode ;             pair:matchedElement ?answer .
    ?judgeStepB       a pair:NodeBinding ; pair:bindsPatternNode pat:RecRAG_JudgeStepNode ;          pair:matchedElement ?judgeStep .
    ?decisionB        a pair:NodeBinding ; pair:bindsPatternNode pat:RecRAG_DecisionNode ;           pair:matchedElement ?decision .
    ?transformB       a pair:NodeBinding ; pair:bindsPatternNode pat:RecRAG_TransformationStepNode ; pair:matchedElement ?transformStep .
    ?subQueryB        a pair:NodeBinding ; pair:bindsPatternNode pat:RecRAG_SubQueryNode ;           pair:matchedElement ?subQuery .
}
WHERE {
    ?judgeStep a/rdfs:subClassOf* beam:Process ;
               pair:playsRole/pair:subRoleOf* pair:RetrievalJudgeStep ;
               beam:use ?answer ;
               beam:produce ?decision .
    ?decision a beam:Data ; pair:playsRole/pair:subRoleOf* pair:RetrievalDecision .

    # The loop: the judge's decision is decomposed into a sub-query, which the
    # retrieval step reads beside the original query.
    ?transformStep a/rdfs:subClassOf* beam:Process ;
                   pair:playsRole/pair:subRoleOf* pair:QueryReformulationStep ;
                   beam:use ?decision ;
                   beam:produce ?subQuery .
    ?subQuery a beam:Data ; pair:playsRole/pair:subRoleOf* pair:UserInput .

    ?retrievalStep a/rdfs:subClassOf* beam:Process ;
                   pair:playsRole/pair:subRoleOf* pair:RetrievalStep ;
                   beam:use ?subQuery ;
                   beam:use ?query ;
                   beam:use ?knowledgeSource ;
                   beam:produce ?retrievedCtx .
    ?query a beam:Data ; pair:playsRole/pair:subRoleOf* pair:UserInput .
    FILTER(?query != ?subQuery)
    ?knowledgeSource a beam:Data ; pair:playsRole/pair:subRoleOf* pair:KnowledgeSource .
    ?retrievedCtx a beam:Data ; pair:playsRole/pair:subRoleOf* pair:RetrievedContext .
    ?retrievedCtx (^beam:use/beam:produce)* ?ctxForGeneration .
    ?ctxForGeneration pair:playsRole/pair:subRoleOf* pair:RetrievedContext .

    ?genStep a/rdfs:subClassOf* beam:Process ;
             pair:playsRole/pair:subRoleOf* pair:GenerationStep ;
             beam:use ?ctxForGeneration ;
             beam:use ?llm ;
             beam:produce ?answer .
    ?llm a beam:StatisticalModel ; pair:playsRole/pair:subRoleOf* pair:GenerativeModel .
    ?answer a beam:Data ; pair:playsRole/pair:subRoleOf* pair:LLMResponse .

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/motif-match/recursive-rag/",
        ENCODE_FOR_URI(STR(?genStep)), "/",
        ENCODE_FOR_URI(STR(?retrievalStep)), "/",
        ENCODE_FOR_URI(STR(?transformStep))
    )) AS ?match)

    BIND(IRI(CONCAT(STR(?match), "/binding/query"))             AS ?queryB)
    BIND(IRI(CONCAT(STR(?match), "/binding/knowledge-source"))  AS ?knowledgeSourceB)
    BIND(IRI(CONCAT(STR(?match), "/binding/retrieval-step"))    AS ?retrievalStepB)
    BIND(IRI(CONCAT(STR(?match), "/binding/retrieved-context")) AS ?retrievedCtxB)
    BIND(IRI(CONCAT(STR(?match), "/binding/llm"))               AS ?llmB)
    BIND(IRI(CONCAT(STR(?match), "/binding/generation-step"))   AS ?genStepB)
    BIND(IRI(CONCAT(STR(?match), "/binding/answer"))            AS ?answerB)
    BIND(IRI(CONCAT(STR(?match), "/binding/judge-step"))        AS ?judgeStepB)
    BIND(IRI(CONCAT(STR(?match), "/binding/decision"))          AS ?decisionB)
    BIND(IRI(CONCAT(STR(?match), "/binding/transformation"))    AS ?transformB)
    BIND(IRI(CONCAT(STR(?match), "/binding/sub-query"))         AS ?subQueryB)
}
