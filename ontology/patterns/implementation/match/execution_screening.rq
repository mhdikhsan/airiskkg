PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT {
    ?match
        a pair:MotifMatch ;
        rdfs:label "Execution screening motif match"@en ;
        pair:matchesMotif pat:ExecutionScreeningMotif ;
        pair:hasNodeBinding ?policyB , ?verdictB , ?toolB , ?resultB .

    ?policyB  a pair:NodeBinding ; pair:bindsPatternNode pat:ExecScreening_PolicyStepNode ; pair:matchedElement ?policyStep .
    ?verdictB a pair:NodeBinding ; pair:bindsPatternNode pat:ExecScreening_VerdictNode ;    pair:matchedElement ?verdict .
    ?toolB    a pair:NodeBinding ; pair:bindsPatternNode pat:ExecScreening_ToolStepNode ;   pair:matchedElement ?toolStep .
    ?resultB  a pair:NodeBinding ; pair:bindsPatternNode pat:ExecScreening_ResultNode ;     pair:matchedElement ?result .
}
WHERE {
    ?policyStep a/rdfs:subClassOf* beam:Process ;
                pair:playsRole/pair:subRoleOf* pair:PolicyEnforcementStep ;
                beam:produce ?verdict .
    ?verdict a beam:Data ; pair:playsRole/pair:subRoleOf* pair:GuardrailDecision .

    ?toolStep a/rdfs:subClassOf* beam:Process ;
              pair:playsRole/pair:subRoleOf* pair:ToolInvocationStep ;
              beam:use ?verdict ;
              beam:produce ?result .
    ?result a beam:Data .

    FILTER(?policyStep != ?toolStep)

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/motif-match/execution-screening/",
        ENCODE_FOR_URI(STR(?policyStep)), "/",
        ENCODE_FOR_URI(STR(?toolStep)), "/",
        ENCODE_FOR_URI(STR(?verdict)), "/",
        ENCODE_FOR_URI(STR(?result))
    )) AS ?match)

    BIND(IRI(CONCAT(STR(?match), "/binding/policy-step")) AS ?policyB)
    BIND(IRI(CONCAT(STR(?match), "/binding/verdict"))     AS ?verdictB)
    BIND(IRI(CONCAT(STR(?match), "/binding/tool-step"))   AS ?toolB)
    BIND(IRI(CONCAT(STR(?match), "/binding/result"))      AS ?resultB)
}
