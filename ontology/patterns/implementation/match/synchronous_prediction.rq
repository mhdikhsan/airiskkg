PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Auto-derived faithful projection of pat:SynchronousPredictionMotif (declared PatternNode/
# PatternEdge structure). Matches structure only (candidate framing): each
# declared node is bound by expectedClass + expectedRole, each declared edge
# is required. No risk semantics here - those come from a risk pattern.

CONSTRUCT {
    ?match
        a pair:MotifMatch ;
        rdfs:label "Synchronous Prediction Motif match"@en ;
        pair:matchesMotif pat:SynchronousPredictionMotif ;
        pair:hasNodeBinding ?downstreamStepBinding ,
            ?modelBinding ,
            ?predictionStepBinding ,
            ?requestBinding ,
            ?resultBinding .

    ?downstreamStepBinding a pair:NodeBinding ; pair:bindsPatternNode pat:SyncPred_DownstreamStepNode ; pair:matchedElement ?downstreamStep .
    ?modelBinding a pair:NodeBinding ; pair:bindsPatternNode pat:SyncPred_ModelNode ; pair:matchedElement ?model .
    ?predictionStepBinding a pair:NodeBinding ; pair:bindsPatternNode pat:SyncPred_PredictionStepNode ; pair:matchedElement ?predictionStep .
    ?requestBinding a pair:NodeBinding ; pair:bindsPatternNode pat:SyncPred_RequestNode ; pair:matchedElement ?request .
    ?resultBinding a pair:NodeBinding ; pair:bindsPatternNode pat:SyncPred_ResultNode ; pair:matchedElement ?result .
}
WHERE {
    ?downstreamStep a beam:Process .
    ?model a beam:StatisticalModel ;
           pair:playsRole/pair:subRoleOf* pair:Model .
    ?predictionStep a beam:Infer ;
           pair:playsRole/pair:subRoleOf* pair:PredictionStep .
    ?request a beam:Data ;
           pair:playsRole/pair:subRoleOf* pair:PredictionRequest .
    ?result a beam:Data ;
           pair:playsRole/pair:subRoleOf* pair:PredictionResult .

    ?predictionStep beam:use ?request .
    ?predictionStep beam:use ?model .
    ?predictionStep beam:produce ?result .
    ?predictionStep beam:inform ?downstreamStep .
    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/motif-match/synchronous-prediction/",
        ENCODE_FOR_URI(STR(?downstreamStep)),
        "/",
        ENCODE_FOR_URI(STR(?model)),
        "/",
        ENCODE_FOR_URI(STR(?predictionStep)),
        "/",
        ENCODE_FOR_URI(STR(?request)),
        "/",
        ENCODE_FOR_URI(STR(?result))
    )) AS ?match)

    BIND(IRI(CONCAT(STR(?match), "/binding/downstream-step")) AS ?downstreamStepBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/model")) AS ?modelBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/prediction-step")) AS ?predictionStepBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/request")) AS ?requestBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/result")) AS ?resultBinding)
}
