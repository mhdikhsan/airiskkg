PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Auto-derived faithful projection of pat:GuardrailsMotif (declared PatternNode/
# PatternEdge structure). Matches structure only (candidate framing): each
# declared node is bound by expectedClass + expectedRole, each declared edge
# is required. No risk semantics here - those come from a risk pattern.

CONSTRUCT {
    ?match
        a pair:MotifMatch ;
        rdfs:label "Guardrails Motif match"@en ;
        pair:matchesMotif pat:GuardrailsMotif ;
        pair:hasNodeBinding ?generationStepBinding ,
            ?inputDecisionBinding ,
            ?inputGuardrailStepBinding ,
            ?llmBinding ,
            ?outputGuardrailStepBinding ,
            ?rawResponseBinding ,
            ?sanitizedResponseBinding ,
            ?userPromptBinding .

    ?generationStepBinding a pair:NodeBinding ; pair:bindsPatternNode pat:Guardrails_GenerationStepNode ; pair:matchedElement ?generationStep .
    ?inputDecisionBinding a pair:NodeBinding ; pair:bindsPatternNode pat:Guardrails_InputDecisionNode ; pair:matchedElement ?inputDecision .
    ?inputGuardrailStepBinding a pair:NodeBinding ; pair:bindsPatternNode pat:Guardrails_InputGuardrailStepNode ; pair:matchedElement ?inputGuardrailStep .
    ?llmBinding a pair:NodeBinding ; pair:bindsPatternNode pat:Guardrails_LLMNode ; pair:matchedElement ?llm .
    ?outputGuardrailStepBinding a pair:NodeBinding ; pair:bindsPatternNode pat:Guardrails_OutputGuardrailStepNode ; pair:matchedElement ?outputGuardrailStep .
    ?rawResponseBinding a pair:NodeBinding ; pair:bindsPatternNode pat:Guardrails_RawResponseNode ; pair:matchedElement ?rawResponse .
    ?sanitizedResponseBinding a pair:NodeBinding ; pair:bindsPatternNode pat:Guardrails_SanitizedResponseNode ; pair:matchedElement ?sanitizedResponse .
    ?userPromptBinding a pair:NodeBinding ; pair:bindsPatternNode pat:Guardrails_UserPromptNode ; pair:matchedElement ?userPrompt .
}
WHERE {
    ?generationStep a beam:Infer ;
           pair:playsRole/pair:subRoleOf* pair:GenerationStep .
    ?inputDecision a beam:Data ;
           pair:playsRole/pair:subRoleOf* pair:GuardrailDecision .
    ?inputGuardrailStep a beam:Process ;
           pair:playsRole/pair:subRoleOf* pair:InputGuardrailStep .
    ?llm a beam:StatisticalModel ;
           pair:playsRole/pair:subRoleOf* pair:FoundationLLM .
    ?outputGuardrailStep a beam:Process ;
           pair:playsRole/pair:subRoleOf* pair:OutputGuardrailStep .
    ?rawResponse a beam:Data ;
           pair:playsRole/pair:subRoleOf* pair:LLMResponse .
    ?sanitizedResponse a beam:Data ;
           pair:playsRole/pair:subRoleOf* pair:SanitizedOutput .
    ?userPrompt a beam:Data ;
           pair:playsRole/pair:subRoleOf* pair:UserInput .

    ?inputGuardrailStep beam:use ?userPrompt .
    ?inputGuardrailStep beam:produce ?inputDecision .
    ?inputGuardrailStep beam:inform ?generationStep .
    ?generationStep beam:use ?userPrompt .
    ?generationStep beam:use ?llm .
    ?generationStep beam:produce ?rawResponse .
    ?generationStep beam:inform ?outputGuardrailStep .
    ?outputGuardrailStep beam:use ?rawResponse .
    ?outputGuardrailStep beam:produce ?sanitizedResponse .
    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/motif-match/guardrails/",
        ENCODE_FOR_URI(STR(?generationStep)),
        "/",
        ENCODE_FOR_URI(STR(?inputDecision)),
        "/",
        ENCODE_FOR_URI(STR(?inputGuardrailStep)),
        "/",
        ENCODE_FOR_URI(STR(?llm)),
        "/",
        ENCODE_FOR_URI(STR(?outputGuardrailStep)),
        "/",
        ENCODE_FOR_URI(STR(?rawResponse)),
        "/",
        ENCODE_FOR_URI(STR(?sanitizedResponse)),
        "/",
        ENCODE_FOR_URI(STR(?userPrompt))
    )) AS ?match)

    BIND(IRI(CONCAT(STR(?match), "/binding/generation-step")) AS ?generationStepBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/input-decision")) AS ?inputDecisionBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/input-guardrail-step")) AS ?inputGuardrailStepBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/llm")) AS ?llmBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/output-guardrail-step")) AS ?outputGuardrailStepBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/raw-response")) AS ?rawResponseBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/sanitized-response")) AS ?sanitizedResponseBinding)
    BIND(IRI(CONCAT(STR(?match), "/binding/user-prompt")) AS ?userPromptBinding)
}
