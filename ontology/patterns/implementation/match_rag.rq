PREFIX pat:  <http://w3id.org/airiskkg/patterns#>
PREFIX pair: <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam: <http://w3id.org/beam/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>


CONSTRUCT {
    ?match
        a pair:MotifMatch ;
        rdfs:label "Retrieval Augmented Generation motif match"@en ;
        pair:matchesMotif pat:RetrievalAugmentedGenerationMotif ;
        pair:hasNodeBinding
            ?queryB , ?embedStepB , ?queryVecB , ?vectorIndexB ,
            ?retrievalStepB , ?retrievedCtxB , ?promptConstructB ,
            ?promptB , ?llmB , ?genStepB , ?responseB .

    ?queryB          a pair:NodeBinding ; pair:bindsPatternNode pat:RAG_QueryNode ;                pair:matchedElement ?query .
    ?embedStepB      a pair:NodeBinding ; pair:bindsPatternNode pat:RAG_QueryEmbeddingStepNode ;   pair:matchedElement ?embedStep .
    ?queryVecB       a pair:NodeBinding ; pair:bindsPatternNode pat:RAG_QueryVectorNode ;          pair:matchedElement ?queryVec .
    ?vectorIndexB    a pair:NodeBinding ; pair:bindsPatternNode pat:RAG_VectorIndexNode ;          pair:matchedElement ?vectorIndex .
    ?retrievalStepB  a pair:NodeBinding ; pair:bindsPatternNode pat:RAG_RetrievalStepNode ;        pair:matchedElement ?retrievalStep .
    ?retrievedCtxB   a pair:NodeBinding ; pair:bindsPatternNode pat:RAG_RetrievedContextNode ;     pair:matchedElement ?retrievedCtx .
    ?promptConstructB a pair:NodeBinding ; pair:bindsPatternNode pat:RAG_PromptConstructionStepNode ; pair:matchedElement ?promptConstruct .
    ?promptB         a pair:NodeBinding ; pair:bindsPatternNode pat:RAG_PromptNode ;               pair:matchedElement ?prompt .
    ?llmB            a pair:NodeBinding ; pair:bindsPatternNode pat:RAG_LLMNode ;                  pair:matchedElement ?llm .
    ?genStepB        a pair:NodeBinding ; pair:bindsPatternNode pat:RAG_GenerationStepNode ;       pair:matchedElement ?genStep .
    ?responseB       a pair:NodeBinding ; pair:bindsPatternNode pat:RAG_ResponseNode ;             pair:matchedElement ?response .
}
WHERE {
    ?query a beam:Data ; pair:playsRole/pair:subRoleOf* pair:UserInput .

   
    OPTIONAL {
        ?embedStep a beam:Transform ;
                   pair:playsRole/pair:subRoleOf* pair:EmbeddingStep ;
                   beam:use ?query ;
                   beam:produce ?queryVec .
        ?queryVec a beam:Data ; pair:playsRole/pair:subRoleOf* pair:EmbeddingVector .
    }

    ?retrievalStep pair:playsRole/pair:subRoleOf* pair:RetrievalStep ;
                   beam:use ?vectorIndex ;
                   beam:produce ?retrievedCtx .
    ?vectorIndex  a beam:Data ; pair:playsRole/pair:subRoleOf* pair:VectorIndex .
    ?retrievedCtx a beam:Data ; pair:playsRole/pair:subRoleOf* pair:RetrievedContext .

    ?retrievedCtx (^beam:use/beam:produce)* ?ctxForPrompt .
    ?ctxForPrompt pair:playsRole/pair:subRoleOf* pair:RetrievedContext .

    ?promptConstruct a beam:Transform ;
                     pair:playsRole/pair:subRoleOf* pair:PromptConstructionStep ;
                     beam:use ?query ;
                     beam:use ?ctxForPrompt ;
                     beam:produce ?prompt .
    ?prompt a beam:Data ; pair:playsRole/pair:subRoleOf* pair:PromptTemplate .

    ?genStep a beam:Infer ;
             pair:playsRole/pair:subRoleOf* pair:GenerationStep ;
             beam:use ?prompt ;
             beam:use ?llm ;
             beam:produce ?response .
    ?llm      a beam:StatisticalModel ; pair:playsRole/pair:subRoleOf* pair:FoundationLLM .
    ?response a beam:Data ; pair:playsRole/pair:subRoleOf* pair:LLMResponse .

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/motif-match/rag/",
        ENCODE_FOR_URI(STR(?genStep)), "/",
        ENCODE_FOR_URI(STR(?retrievalStep))
    )) AS ?match)

    BIND(IRI(CONCAT(STR(?match), "/binding/query"))             AS ?queryB)
    BIND(IRI(CONCAT(STR(?match), "/binding/embed-step"))        AS ?embedStepB)
    BIND(IRI(CONCAT(STR(?match), "/binding/query-vector"))      AS ?queryVecB)
    BIND(IRI(CONCAT(STR(?match), "/binding/vector-index"))      AS ?vectorIndexB)
    BIND(IRI(CONCAT(STR(?match), "/binding/retrieval-step"))    AS ?retrievalStepB)
    BIND(IRI(CONCAT(STR(?match), "/binding/retrieved-context")) AS ?retrievedCtxB)
    BIND(IRI(CONCAT(STR(?match), "/binding/prompt-construct"))  AS ?promptConstructB)
    BIND(IRI(CONCAT(STR(?match), "/binding/prompt"))            AS ?promptB)
    BIND(IRI(CONCAT(STR(?match), "/binding/llm"))               AS ?llmB)
    BIND(IRI(CONCAT(STR(?match), "/binding/generation-step"))   AS ?genStepB)
    BIND(IRI(CONCAT(STR(?match), "/binding/response"))          AS ?responseB)
}
