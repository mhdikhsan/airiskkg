PREFIX pat:     <http://w3id.org/airiskkg/patterns#>
PREFIX pair:      <http://w3id.org/airiskkg/pair-ai#>
PREFIX beam:    <http://w3id.org/beam/core#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:     <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a pair:RiskFinding ;
        rdfs:label "Candidate direct LLM answering without grounding"@en ;
        dct:description "An LLM-based answering step produces a user-facing answer without an explicit knowledge source or retrieved grounding context represented in the architecture graph."@en ;
        pair:generatedFromMatch ?match ;
        pair:generatedByMotif pat:DirectLLMAnsweringMotif ;
        pair:hasInterpretedMechanism ?mechanism ;
        pair:hasEvidenceElement ?query ,
            ?step ,
            ?llm ,
            ?answer ;
        pair:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        pair:hasSuggestedControl ?suggestedControl ;
        pair:hasSatisfiedCondition ?satisfiedCondition ,
            ?sourceRiskCondition ;
        pair:findingStatus "candidate" .
}
WHERE {
    pat:DirectLLMAnsweringWithoutGroundingInterpretation
        pair:interpretedAsMechanism ?mechanism ;
        pair:hasInterpretationCondition ?satisfiedCondition ;
        pair:mayIndicateRisk ?riskTaxonomyEntry ;
        pair:suggestedControl ?suggestedControl .

    OPTIONAL {
        ?satisfiedCondition pair:operationalizesRiskCondition ?sourceRiskCondition .
    }

    ?match
        a pair:MotifMatch ;
        pair:matchesMotif pat:DirectLLMAnsweringMotif ;
        pair:hasNodeBinding ?queryBinding ,
            ?stepBinding ,
            ?modelBinding ,
            ?answerBinding .

    ?queryBinding
        pair:bindsPatternNode pat:DirectLLM_QueryNode ;
        pair:matchedElement ?query .

    ?stepBinding
        pair:bindsPatternNode pat:DirectLLM_GenerationStepNode ;
        pair:matchedElement ?step .

    ?modelBinding
        pair:bindsPatternNode pat:DirectLLM_ModelNode ;
        pair:matchedElement ?llm .

    ?answerBinding
        pair:bindsPatternNode pat:DirectLLM_AnswerNode ;
        pair:matchedElement ?answer .

    FILTER NOT EXISTS {
        ?step beam:use ?knowledgeSource .
        ?knowledgeSource pair:playsRole/pair:subRoleOf* pair:KnowledgeSource .
    }

    FILTER NOT EXISTS {
        ?step beam:use ?retrievedContext .
        ?retrievedContext pair:playsRole/pair:subRoleOf* pair:RetrievedContext .
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/direct-llm-without-grounding"
    )) AS ?riskFinding)
}
