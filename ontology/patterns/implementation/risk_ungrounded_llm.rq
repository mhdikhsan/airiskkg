PREFIX pat:     <http://w3id.org/airiskkg/patterns#>
PREFIX rp:      <http://w3id.org/beam/risk-pattern#>
PREFIX beam:    <http://w3id.org/beam/core#>
PREFIX atlas:   <http://w3id.org/airiskkg/taxonomy/ibm-risk-atlas#>
PREFIX mit:     <http://w3id.org/airiskkg/taxonomy/mit-ai-risk#>
PREFIX mitctrl: <http://w3id.org/airiskkg/taxonomy/mit-ai-risk-control#>
PREFIX owasp:   <http://w3id.org/airiskkg/taxonomy/owasp-llm#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct:     <http://purl.org/dc/terms/>

CONSTRUCT {
    ?riskFinding
        a rp:RiskFinding ;
        rdfs:label "Candidate direct LLM answering without grounding"@en ;
        dct:description "An LLM-based answering step produces a user-facing answer without an explicit knowledge source or retrieved grounding context represented in the architecture graph."@en ;
        rp:generatedFromMatch ?match ;
        rp:generatedByMotif pat:LLMBasedInformationRetrievalMotif ;
        rp:hasInterpretedMechanism pat:DirectLLMAnsweringWithoutGrounding ;
        rp:hasEvidenceElement ?query ,
            ?step ,
            ?llm ,
            ?answer ;
        rp:hasCandidateRiskTaxonomyEntry ?riskTaxonomyEntry ;
        rp:hasSuggestedControl ?suggestedControl ;
        rp:findingStatus "candidate" .
}
WHERE {
    ?match
        a rp:MotifMatch ;
        rp:matchesMotif pat:LLMBasedInformationRetrievalMotif ;
        rp:hasNodeBinding ?queryBinding ,
            ?stepBinding ,
            ?modelBinding ,
            ?answerBinding .

    ?queryBinding
        rp:bindsPatternNode pat:LLMIR_QueryNode ;
        rp:matchedElement ?query .

    ?stepBinding
        rp:bindsPatternNode pat:LLMIR_RetrievalStepNode ;
        rp:matchedElement ?step .

    ?modelBinding
        rp:bindsPatternNode pat:LLMIR_ModelNode ;
        rp:matchedElement ?llm .

    ?answerBinding
        rp:bindsPatternNode pat:LLMIR_AnswerNode ;
        rp:matchedElement ?answer .

    FILTER NOT EXISTS {
        ?step beam:use ?knowledgeSource .
        ?knowledgeSource rp:playsRole/rp:subRoleOf* rp:KnowledgeSource .
    }

    FILTER NOT EXISTS {
        ?step beam:use ?retrievedContext .
        ?retrievedContext rp:playsRole/rp:subRoleOf* rp:RetrievedContext .
    }

    VALUES ?riskTaxonomyEntry {
        atlas:hallucination
        owasp:llm09-misinformation
        mit:subdomain-3-1
    }

    VALUES ?suggestedControl {
        mitctrl:retrieval-quality-evaluation
        mitctrl:input-output-filtering
        mitctrl:system-architecture-documentation
    }

    BIND(IRI(CONCAT(
        "http://w3id.org/airiskkg/generated/risk-finding/",
        ENCODE_FOR_URI(STR(?match)),
        "/direct-llm-without-grounding"
    )) AS ?riskFinding)
}
