@prefix pair:     <http://w3id.org/airiskkg/pair-ai#> .
@prefix beam:   <http://w3id.org/beam/core#> .
@prefix beamr:  <http://w3id.org/beam/risk#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# Ontology

<http://w3id.org/airiskkg/pair-ai#> a owl:Ontology ;
    dct:title "PAIR-AI Pattern Module Ontology"@en ;
    dct:description "Pattern-level vocabulary for constructing the PAIR-AI AI Risk Knowledge Graph."@en ;
    vann:preferredNamespacePrefix "pair" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/pair-ai#" ;
    owl:imports <http://w3id.org/beam/core#> ,
                <http://w3id.org/beam/risk#> .

# Classes
# Terminology follows docs/reference/PAIR-AI_glossary_v1.1.md (locked).

pair:PatternRole a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Pattern Role"@en ;
    rdfs:comment "An abstract functional role (e.g. VectorStore, RetrievalStep, GenerativeModel) assigned to a concrete architecture element via pair:playsRole; modeled as a SKOS concept. A role labels one element's function; a motif is a structure over several roles. Roles are the semantic bridge that makes motifs reusable across heterogeneous systems."@en .

pair:DataCategory a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Data Category"@en ;
    rdfs:comment "A characterization facet classifying data content (e.g. sensitive, personal, untrusted, generated content); glossary v1.1 Section A.3 classifies Data Category as one of the characterization facets alongside the schemes in ontology/facets/. It stays in the pattern module (rather than ontology/facets/) because it is the one facet with derived values (Rule R8): pair:containsDataCategory facts are both annotated by the modeler and propagated along data flow by registered propagation queries, and applicability conditions traverse the category hierarchy via pair:subDataCategoryOf. Values are SKOS concepts in pair:DataCategoryScheme, never instantiated as graph structure, and never matched by motifs (Rule R2)."@en .

pair:GraphMotif a owl:Class ;
    rdfs:label "Graph Motif"@en ;
    rdfs:comment "A reusable, descriptive graph pattern over pattern roles and flow relations that captures a recurring system configuration (e.g. vector-based retrieval, retrieval-augmented generation). A motif is risk-neutral by itself; risk semantics are added only by an AI risk pattern (pair:RiskPattern)."@en .

pair:PatternNode a owl:Class ;
    rdfs:label "Pattern Node"@en ;
    rdfs:comment "An abstract node of a graph motif, constrained by an expected BEAM class and/or an expected pattern role."@en .

pair:PatternEdge a owl:Class ;
    rdfs:label "Pattern Edge"@en ;
    rdfs:comment "An abstract edge of a graph motif connecting two pattern nodes via a BEAM flow predicate."@en .

pair:ApplicabilityCondition a owl:Class ;
    rdfs:label "Applicability Condition"@en ;
    rdfs:comment "A risk-relevant condition over a motif match: facet values, data categories, structural properties, or the absence of represented controls via closed-world query constructs (FILTER NOT EXISTS over the submitted graph only). Applicability conditions are constituents of an AI risk pattern, not external inputs. Formerly named pair:GraphCondition (\"interpretation condition\")."@en .

pair:PropertyPathCondition a owl:Class ;
    rdfs:subClassOf pair:ApplicabilityCondition ;
    rdfs:label "Property Path Condition"@en ;
    rdfs:comment "An applicability condition evaluated via a SPARQL property path (e.g. reachability of untrusted content to a generation step)."@en .

pair:RiskPattern a owl:Class ;
    rdfs:label "AI Risk Pattern"@en ;
    rdfs:comment "An architectural motif extended with risk semantics: Risk Pattern = Motif + Applicability Conditions + Mechanism + Taxonomy Links + Controls. A risk pattern is reusable knowledge, not a risk; when a motif match satisfies its applicability conditions, a candidate risk finding is emitted. Formerly named pair:MotifInterpretation."@en .

pair:RiskMechanism a owl:Class ;
    rdfs:label "Risk Mechanism"@en ;
    rdfs:comment "A curated explanation of how or why a matched configuration under the observed conditions can lead to a risk. Mechanisms are defined in the AI-RKG as parts of risk patterns and selected at assessment time, never invented during assessment."@en .

pair:PatternImplementation a owl:Class ;
    rdfs:label "Pattern Implementation"@en ;
    rdfs:comment "The executable SPARQL query that detects a motif or evaluates a risk pattern against an architecture graph (the OQP to the motif's ODP). One motif may have multiple implementations; an implementation is an implementation of the motif, not the pattern itself."@en .

pair:MotifMatch a owl:Class ;
    rdfs:label "Motif Match"@en ;
    rdfs:comment "Internal technical entity: the set of node bindings from abstract pattern nodes to concrete architecture elements produced by a motif implementation. Candidate risk findings reference matches."@en .

pair:NodeBinding a owl:Class ;
    rdfs:label "Node Binding"@en ;
    rdfs:comment "A single binding from an abstract pattern node to a concrete architecture element within a motif match."@en .

pair:RiskFinding a owl:Class ;
    rdfs:label "Candidate Risk Finding"@en ;
    rdfs:comment "A system-specific candidate risk generated when a motif match satisfies the applicability conditions of an AI risk pattern. A candidate risk is a structural disposition toward harm identified at design time; it is not a confirmed failure, an observed incident, or a prediction that harm will occur. Not a subclass of beamr:Risk; it links to the candidate risk via pair:identifiesCandidateRisk."@en .

pair:DataCategoryPropagation a owl:Class ;
    rdfs:label "Data Category Propagation"@en ;
    skos:definition "Marker output type for pattern implementations that infer pair:containsDataCategory facts (e.g. untrusted-content taint) from roles and data flow, rather than requiring every element to be hand-tagged."@en .

# Object properties

pair:playsRole a owl:ObjectProperty ;
    rdfs:label "plays role"@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range pair:PatternRole .

pair:subRoleOf a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "sub-role of"@en ;
    rdfs:domain pair:PatternRole ;
    rdfs:range pair:PatternRole .

pair:containsDataCategory a owl:ObjectProperty ;
    rdfs:label "contains data category"@en ;
    rdfs:domain beam:Data ;
    rdfs:range pair:DataCategory .

pair:subDataCategoryOf a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "sub-data-category of"@en ;
    rdfs:domain pair:DataCategory ;
    rdfs:range pair:DataCategory .

pair:hasPatternNode a owl:ObjectProperty ;
    rdfs:label "has pattern node"@en ;
    rdfs:domain pair:GraphMotif ;
    rdfs:range pair:PatternNode .

pair:hasPatternEdge a owl:ObjectProperty ;
    rdfs:label "has pattern edge"@en ;
    rdfs:domain pair:GraphMotif ;
    rdfs:range pair:PatternEdge .

pair:sourcePatternNode a owl:ObjectProperty ;
    rdfs:label "source pattern node"@en ;
    rdfs:domain pair:PatternEdge ;
    rdfs:range pair:PatternNode .

pair:targetPatternNode a owl:ObjectProperty ;
    rdfs:label "target pattern node"@en ;
    rdfs:domain pair:PatternEdge ;
    rdfs:range pair:PatternNode .

pair:patternPredicate a owl:ObjectProperty ;
    rdfs:label "pattern predicate"@en ;
    rdfs:domain pair:PatternEdge ;
    rdfs:range rdf:Property .

pair:expectedClass a owl:ObjectProperty ;
    rdfs:label "expected class"@en ;
    rdfs:domain pair:PatternNode ;
    rdfs:range rdfs:Class .

pair:expectedRole a owl:ObjectProperty ;
    rdfs:label "expected role"@en ;
    rdfs:domain pair:PatternNode ;
    rdfs:range pair:PatternRole .

pair:hasRiskPattern a owl:ObjectProperty ;
    rdfs:label "has risk pattern"@en ;
    rdfs:comment "Links a risk-neutral graph motif to an AI risk pattern that extends it with risk semantics. Formerly pair:hasInterpretation."@en ;
    rdfs:domain pair:GraphMotif ;
    rdfs:range pair:RiskPattern ;
    owl:inverseOf pair:hasMotif .

pair:hasMotif a owl:ObjectProperty ;
    rdfs:label "has motif"@en ;
    rdfs:comment "Links an AI risk pattern to the structural motif that must be present for it to apply. Formerly pair:interpretsMotif."@en ;
    rdfs:domain pair:RiskPattern ;
    rdfs:range pair:GraphMotif .

pair:hasApplicabilityCondition a owl:ObjectProperty ;
    rdfs:label "has applicability condition"@en ;
    rdfs:comment "Links an AI risk pattern to a risk-relevant applicability condition that a motif match must satisfy before a candidate risk finding is emitted. Formerly pair:hasInterpretationCondition."@en ;
    rdfs:domain pair:RiskPattern ;
    rdfs:range pair:ApplicabilityCondition .

pair:hasMechanism a owl:ObjectProperty ;
    rdfs:label "has mechanism"@en ;
    rdfs:comment "Links an AI risk pattern to its curated risk mechanism: the causal account of how or why the configuration is disposed toward harm. Formerly pair:interpretedAsMechanism."@en ;
    rdfs:domain pair:RiskPattern ;
    rdfs:range pair:RiskMechanism .

pair:mayIndicateRisk a owl:ObjectProperty ;
    rdfs:label "may indicate risk"@en ;
    rdfs:comment "Links an AI risk pattern to external taxonomy entries (IBM AI Risk Atlas, OWASP LLM Top 10, MIT AI Risk Repository) the candidate risk anchors to. 'May indicate' preserves candidate framing."@en ;
    rdfs:domain pair:RiskPattern ;
    rdfs:range skos:Concept .

pair:suggestedControl a owl:ObjectProperty ;
    rdfs:label "suggested control"@en ;
    rdfs:domain pair:RiskPattern ;
    rdfs:range beamr:RiskControl .

pair:operationalizesRiskCondition a owl:ObjectProperty ;
    rdfs:label "operationalizes risk condition"@en ;
    rdfs:comment "Links an applicability condition to the external taxonomy risk-condition entry it operationalizes."@en ;
    rdfs:domain pair:ApplicabilityCondition ;
    rdfs:range rdfs:Resource .

pair:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derived from"@en ;
    rdfs:comment "Derivation provenance for curated pattern knowledge: links a graph motif or AI risk pattern to the resource it was derived from (e.g. a Boxology elementary pattern, a taxonomy entry such as an OWASP LLM Top 10 item, or a documented design-pattern source). Complemented by dct:source annotations."@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (pair:GraphMotif pair:RiskPattern)
    ] .

pair:implementedBy a owl:ObjectProperty ;
    rdfs:label "implemented by"@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (pair:GraphMotif pair:RiskPattern)
    ] ;
    rdfs:range pair:PatternImplementation .

pair:implementsMotif a owl:ObjectProperty ;
    rdfs:label "implements motif"@en ;
    rdfs:domain pair:PatternImplementation ;
    rdfs:range pair:GraphMotif .

pair:implementsRiskPattern a owl:ObjectProperty ;
    rdfs:label "implements risk pattern"@en ;
    rdfs:comment "Links an executable SPARQL implementation to the AI risk pattern it evaluates. Formerly pair:implementsInterpretation."@en ;
    rdfs:domain pair:PatternImplementation ;
    rdfs:range pair:RiskPattern .

pair:producesOutputType a owl:ObjectProperty ;
    rdfs:label "produces output type"@en ;
    rdfs:domain pair:PatternImplementation ;
    rdfs:range rdfs:Class .

pair:matchesMotif a owl:ObjectProperty ;
    rdfs:label "matches motif"@en ;
    rdfs:domain pair:MotifMatch ;
    rdfs:range pair:GraphMotif .

pair:hasNodeBinding a owl:ObjectProperty ;
    rdfs:label "has node binding"@en ;
    rdfs:domain pair:MotifMatch ;
    rdfs:range pair:NodeBinding .

pair:bindsPatternNode a owl:ObjectProperty ;
    rdfs:label "binds pattern node"@en ;
    rdfs:domain pair:NodeBinding ;
    rdfs:range pair:PatternNode .

pair:matchedElement a owl:ObjectProperty ;
    rdfs:label "matched element"@en ;
    rdfs:domain pair:NodeBinding ;
    rdfs:range rdfs:Resource .

pair:generatedFromMatch a owl:ObjectProperty ;
    rdfs:label "generated from match"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range pair:MotifMatch .

pair:generatedByMotif a owl:ObjectProperty ;
    rdfs:label "generated by motif"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range pair:GraphMotif .

pair:hasEvidence a owl:ObjectProperty ;
    rdfs:label "has evidence"@en ;
    rdfs:comment "Attaches the evidence of a candidate risk finding: the elements of the matched subgraph that triggered the finding. Evidence is retained for durable traceability (PROV spirit). DESIGN DECISION: evidence is represented as the set of matched architecture elements (one pair:hasEvidence triple per element), matching how findings were already materialized; a named-graph representation was rejected as more disruptive. Replaces the former pair:EvidenceSubgraph class design and the pair:hasEvidenceElement property."@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range rdfs:Resource .

pair:hasDerivedMechanism a owl:ObjectProperty ;
    rdfs:label "has derived mechanism"@en ;
    rdfs:comment "Links a candidate risk finding to the risk mechanism selected from the satisfied AI risk pattern. Mechanisms are selected at assessment time, never invented. Formerly pair:hasInterpretedMechanism."@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range pair:RiskMechanism .

pair:identifiesCandidateRisk a owl:ObjectProperty ;
    rdfs:label "identifies candidate risk"@en ;
    rdfs:comment "Links a candidate risk finding to the risk it identifies as a candidate. pair:RiskFinding is deliberately not a subclass of beamr:Risk: a finding is assessment output about a possible risk, not the risk itself."@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range beamr:Risk .

pair:hasCandidateRiskTaxonomyEntry a owl:ObjectProperty ;
    rdfs:label "has candidate risk taxonomy entry"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range skos:Concept .

pair:hasSuggestedControl a owl:ObjectProperty ;
    rdfs:label "has suggested control"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range beamr:RiskControl .

pair:hasSatisfiedCondition a owl:ObjectProperty ;
    rdfs:label "has satisfied condition"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range rdfs:Resource .

pair:ProcessingStep a pair:PatternRole ;
    skos:prefLabel "Processing Step"@en ;
    skos:definition "A step in the processing or decision-making workflow of an AI system, such as data preprocessing, model training, inference, or post-processing."@en .

pair:ControlStep a pair:PatternRole ;
    skos:prefLabel "Control Step"@en ;
    skos:definition "A step in the workflow of an AI system that is specifically designed to implement a risk control or mitigation strategy, such as a fairness check, anomaly detection, or human review."@en .

pair:ResourceRole a pair:PatternRole ;
    skos:prefLabel "Resource Role"@en ;
    skos:definition "A role played by a resource that an AI system interacts with, such as a data source, external API, or knowledge graph."@en .

# Data properties

pair:implementationPath a owl:DatatypeProperty ;
    rdfs:label "implementation path"@en ;
    rdfs:domain pair:PatternImplementation ;
    rdfs:range xsd:string .

pair:findingStatus a owl:DatatypeProperty ;
    rdfs:label "finding status"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range xsd:string .

# Deprecated aliases (glossary v1.1 renames, kept for one release)

pair:MotifInterpretation a owl:Class ;
    owl:deprecated true ;
    dct:isReplacedBy pair:RiskPattern ;
    rdfs:label "Motif Interpretation (deprecated)"@en ;
    rdfs:comment "Deprecated: renamed to pair:RiskPattern (glossary v1.1)."@en .

pair:AIRiskPattern a owl:Class ;
    owl:deprecated true ;
    dct:isReplacedBy pair:RiskPattern ;
    rdfs:label "AI Risk Pattern (deprecated duplicate)"@en ;
    rdfs:comment "Deprecated: this abstract parent class duplicated the AI risk pattern concept; pair:RiskPattern is now the single class."@en .

pair:GraphCondition a owl:Class ;
    owl:deprecated true ;
    dct:isReplacedBy pair:ApplicabilityCondition ;
    rdfs:label "Graph Condition (deprecated)"@en ;
    rdfs:comment "Deprecated: renamed to pair:ApplicabilityCondition (glossary v1.1)."@en .

pair:hasInterpretation a owl:ObjectProperty ;
    owl:deprecated true ;
    dct:isReplacedBy pair:hasRiskPattern ;
    rdfs:label "has interpretation (deprecated)"@en .

pair:interpretsMotif a owl:ObjectProperty ;
    owl:deprecated true ;
    dct:isReplacedBy pair:hasMotif ;
    rdfs:label "interprets motif (deprecated)"@en .

pair:hasInterpretationCondition a owl:ObjectProperty ;
    owl:deprecated true ;
    dct:isReplacedBy pair:hasApplicabilityCondition ;
    rdfs:label "has interpretation condition (deprecated)"@en .

pair:interpretedAsMechanism a owl:ObjectProperty ;
    owl:deprecated true ;
    dct:isReplacedBy pair:hasMechanism ;
    rdfs:label "interpreted as mechanism (deprecated)"@en .

pair:implementsInterpretation a owl:ObjectProperty ;
    owl:deprecated true ;
    dct:isReplacedBy pair:implementsRiskPattern ;
    rdfs:label "implements interpretation (deprecated)"@en .

pair:hasInterpretedMechanism a owl:ObjectProperty ;
    owl:deprecated true ;
    dct:isReplacedBy pair:hasDerivedMechanism ;
    rdfs:label "has interpreted mechanism (deprecated)"@en .

pair:hasEvidenceElement a owl:ObjectProperty ;
    owl:deprecated true ;
    dct:isReplacedBy pair:hasEvidence ;
    rdfs:label "has evidence element (deprecated)"@en .

# Annotation vocabulary: roles
pair:UserInput a pair:PatternRole ;
    skos:prefLabel "User Input"@en ;
    skos:definition "Information provided directly by a user, such as through a user interface or API input."@en .

pair:PublicUserInput a pair:PatternRole ;
    skos:prefLabel "Public User Input"@en ;
    pair:subRoleOf pair:UserInput ;
    skos:definition "Information provided by users that is publicly accessible, such as social media posts or public forum contributions."@en .

pair:KnowledgeSource a pair:PatternRole ;
    skos:prefLabel "Knowledge Source"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A source of information that an AI system can access, such as a database, knowledge graph, or external API."@en .


# CONSOLIDATED ROLE VOCABULARY 

### Model roles (parent: pair:Model)
pair:Model a pair:PatternRole ;
    skos:prefLabel "Model"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A machine learning or statistical model resource."@en .

pair:GenerativeModel a pair:PatternRole ;
    skos:prefLabel "Generative Model"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model that generates content (e.g. an LLM) at inference time."@en .

pair:PretrainedModel a pair:PatternRole ;
    skos:prefLabel "Pre-trained Model"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A pre-trained foundation model prior to task-specific adaptation."@en .

pair:FoundationLLM a pair:PatternRole ;
    skos:prefLabel "Foundation LLM"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A foundation large language model used directly for generation."@en .

pair:FineTunedModel a pair:PatternRole ;
    skos:prefLabel "Fine-tuned Model"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model produced by fine-tuning a pre-trained model on task-specific data."@en .

pair:EmbeddingModel a pair:PatternRole ;
    skos:prefLabel "Embedding Model"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model that transforms data into vector embeddings."@en .

pair:JudgeModel a pair:PatternRole ;
    skos:prefLabel "Judge Model"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model used to score or evaluate the output of another model (LLM-as-judge)."@en .

pair:RerankerModel a pair:PatternRole ;
    skos:prefLabel "Reranker Model"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model (typically a cross-encoder) that scores candidate relevance for reranking."@en .

pair:GuardrailModel a pair:PatternRole ;
    skos:prefLabel "Guardrail Model"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model dedicated to screening input or output in a guardrail step."@en .

pair:LoadedModel a pair:PatternRole ;
    skos:prefLabel "Loaded Model"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model instance loaded into a serving runtime."@en .

pair:ModelArtifact a pair:PatternRole ;
    skos:prefLabel "Model Artifact"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A persisted model artifact (weights/checkpoint) produced or consumed by a workflow."@en .

### Knowledge-source roles (parent: pair:KnowledgeSource)
pair:VectorStore a pair:PatternRole ;
    skos:prefLabel "VectorStore"@en ;
    pair:subRoleOf pair:KnowledgeSource ;
    skos:definition "A vector database serving as a knowledge source for retrieval."@en .

pair:VectorIndex a pair:PatternRole ;
    skos:prefLabel "VectorIndex"@en ;
    pair:subRoleOf pair:KnowledgeSource ;
    skos:definition "An index over embedding vectors."@en .

pair:KeywordIndex a pair:PatternRole ;
    skos:prefLabel "KeywordIndex"@en ;
    pair:subRoleOf pair:KnowledgeSource ;
    skos:definition "A keyword/text index used for lexical search."@en .

### Data/resource roles (parent: pair:ResourceRole)
pair:UserFacingOutput a pair:PatternRole ;
    skos:prefLabel "UserFacingOutput"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "Data exposed to a user or downstream consumer (a sink)."@en .

pair:PublicUserFacingOutput a pair:PatternRole ;
    skos:prefLabel "Public User-Facing Output"@en ;
    pair:subRoleOf pair:UserFacingOutput ;
    skos:definition "User-facing output exposed to the public, such as a chatbot response or public-facing summary."@en .

pair:RetrievedContext a pair:PatternRole ;
    skos:prefLabel "RetrievedContext"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "Content returned by a retrieval step for use as context."@en .

pair:RetrievedResult a pair:PatternRole ;
    skos:prefLabel "RetrievedResult"@en ;
    pair:subRoleOf pair:RetrievedContext ;
    skos:definition "A result item returned by a retrieval step, used as retrieved context."@en .

pair:PromptTemplate a pair:PatternRole ;
    skos:prefLabel "PromptTemplate"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A prompt template combining instructions and inputs."@en .

pair:VectorRepresentation a pair:PatternRole ;
    skos:prefLabel "VectorRepresentation"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A numeric vector embedding of source data."@en .

pair:EmbeddingVector a pair:PatternRole ;
    skos:prefLabel "EmbeddingVector"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A stored embedding vector."@en .

pair:EvaluatedOutput a pair:PatternRole ;
    skos:prefLabel "EvaluatedOutput"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A model output that is the subject of evaluation."@en .

pair:ExpectedOutput a pair:PatternRole ;
    skos:prefLabel "ExpectedOutput"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A reference/expected output used in evaluation."@en .

pair:EvaluationResult a pair:PatternRole ;
    skos:prefLabel "EvaluationResult"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "The result produced by an evaluation step."@en .

pair:EvaluationScore a pair:PatternRole ;
    skos:prefLabel "EvaluationScore"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A numeric score produced by an evaluation step."@en .

pair:LLMResponse a pair:PatternRole ;
    skos:prefLabel "LLMResponse"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A response produced by a generative model prior to output screening."@en .

pair:GuardrailDecision a pair:PatternRole ;
    skos:prefLabel "GuardrailDecision"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A decision (allow/block) produced by a guardrail step."@en .

pair:SanitizedOutput a pair:PatternRole ;
    skos:prefLabel "SanitizedOutput"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "Output that has passed an output guardrail/sanitization step."@en .

pair:RewrittenQuery a pair:PatternRole ;
    skos:prefLabel "RewrittenQuery"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A reformulated query produced by a query rewriting step."@en .

pair:RetrievedCandidateSet a pair:PatternRole ;
    skos:prefLabel "RetrievedCandidateSet"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A set of retrieved candidate fragments prior to reranking."@en .

pair:RerankedContext a pair:PatternRole ;
    skos:prefLabel "RerankedContext"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "Reranked, selected context fragments for generation."@en .

pair:DocumentChunk a pair:PatternRole ;
    skos:prefLabel "DocumentChunk"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A chunk of a source document used for embedding/retrieval."@en .

pair:SourceDocument a pair:PatternRole ;
    skos:prefLabel "SourceDocument"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A source document ingested into a knowledge base."@en .

pair:PredictionRequest a pair:PatternRole ;
    skos:prefLabel "PredictionRequest"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "An incoming request for a prediction."@en .

pair:PredictionResult a pair:PatternRole ;
    skos:prefLabel "PredictionResult"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "The result of a prediction step."@en .

pair:PredictionQueue a pair:PatternRole ;
    skos:prefLabel "PredictionQueue"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A queue holding prediction requests."@en .

pair:PredictionLog a pair:PatternRole ;
    skos:prefLabel "PredictionLog"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A log of predictions for monitoring/audit."@en .

pair:TrainingDataset a pair:PatternRole ;
    skos:prefLabel "TrainingDataset"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A dataset used to train a model."@en .

pair:FineTuningDataset a pair:PatternRole ;
    skos:prefLabel "FineTuningDataset"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A dataset used to fine-tune a model."@en .

pair:BatchDataset a pair:PatternRole ;
    skos:prefLabel "BatchDataset"@en ;
    pair:subRoleOf pair:ResourceRole ;
