pair:EvaluationResult dct:source <https://mercari.github.io/ml-system-design-pattern/Training-patterns/Batch-training-pattern/design_en.html> .   # via pat:BatchTrainingMotif
pair:EvaluationScore dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .   # via pat:EvalsMotif
pair:ExpectedOutput dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .   # via pat:EvalsMotif
pair:ExternalDependency dct:source <https://genai.owasp.org/resource/owasp-top-10-for-llm-applications-2025/> .   # via pat:ExternalDependencyMotif
pair:FastPredictionStep dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Multiple-stage-prediction-pattern/design_en.html> .   # via pat:MultiStagePredictionMotif
pair:GuardrailDecision dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .   # via pat:GuardrailsMotif
pair:HumanApprovalStep dct:source <http://w3id.org/airiskkg/taxonomy/owasp-asi#asi02-tool-misuse> .   # via pat:ToolMisuseRiskPattern
pair:ImageBuildStep dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Model-in-image-pattern/design_en.html> .   # via pat:ModelInImageMotif
pair:InputGuardrailStep dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .   # via pat:GuardrailsMotif
pair:JobScheduler dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Batch-pattern/design_en.html> .   # via pat:BatchPredictionMotif
pair:JudgeModel dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .   # via pat:EvalsMotif
pair:LLMResponse dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .   # via pat:EvalsMotif
pair:LoadedModel dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Model-load-pattern/design_en.html> .   # via pat:ModelLoadMotif
pair:LoggingStep dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Prediction-log-pattern/design_en.html> .   # via pat:PredictionLoggingMotif
pair:MemoryReadStep dct:source <http://w3id.org/airiskkg/taxonomy/owasp-asi#asi06-memory-and-context-poisoning> .   # via pat:AgentMemoryLoopMotif
pair:MemoryValidationStep dct:source <http://w3id.org/airiskkg/taxonomy/owasp-asi#asi06-memory-and-context-poisoning> .   # via pat:MemoryPoisoningRiskPattern
pair:MemoryWriteStep dct:source <http://w3id.org/airiskkg/taxonomy/owasp-asi#asi06-memory-and-context-poisoning> .   # via pat:AgentMemoryLoopMotif
pair:ModelLoadStep dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Model-load-pattern/design_en.html> .   # via pat:ModelLoadMotif
pair:MonitoringBaseline dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Prediction-monitoring-pattern/design_en.html> .   # via pat:PredictionMonitoringMotif
pair:MonitoringStep dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Prediction-monitoring-pattern/design_en.html> .   # via pat:PredictionMonitoringMotif
pair:OutputGuardrailStep dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .   # via pat:GuardrailsMotif
pair:OutputValidationStep dct:source <http://w3id.org/airiskkg/taxonomy/owasp-llm#llm05-improper-output-handling> .   # via pat:ImproperOutputHandlingRiskPattern
