@prefix pair:   <http://w3id.org/airiskkg/pair-ai#> .
@prefix beam:   <http://w3id.org/beam/core#> .
@prefix beamr:  <http://w3id.org/beam/risk#> .
@prefix t4b:    <http://tool4boxology.org/> .
@prefix ai:     <https://w3id.org/dpv/ai#> .
@prefix dpv:    <https://w3id.org/dpv#> .
@prefix airo:   <https://w3id.org/airo#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# Ontology

<http://w3id.org/airiskkg/pair-ai#> a owl:Ontology ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:title "PAIR-AI Pattern Module Ontology"@en ;
    dct:description "Pattern-level vocabulary for constructing the PAIR-AI AI Risk Knowledge Graph."@en ;
    vann:preferredNamespacePrefix "pair" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/pair-ai#" ;
    owl:imports <http://w3id.org/beam/core#> ,
                <http://w3id.org/beam/risk#> .


pair:PatternRole a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Pattern Role"@en ;
    rdfs:comment "An abstract functional role (e.g. VectorStore, RetrievalStep, GenerativeModel) assigned to a concrete architecture element via pair:playsRole; modeled as a SKOS concept. A role labels one element's function; a motif is a structure over several roles. Roles are the semantic bridge that makes motifs reusable across heterogeneous systems."@en .

pair:DataCategory a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Data Category"@en ;
    rdfs:comment "A characterization facet classifying data content (e.g. sensitive, personal, untrusted, generated content)."@en .

pair:GraphMotif a owl:Class ;
    rdfs:label "Graph Motif"@en ;
    rdfs:comment "A reusable, descriptive graph pattern over pattern roles and flow relations that captures a recurring system configuration (e.g. vector-based retrieval, retrieval-augmented generation). A motif is risk-neutral by itself; risk semantics are added only by an AI risk pattern."@en .

pair:PatternNode a owl:Class ;
    rdfs:label "Pattern Node"@en ;
    rdfs:comment "An abstract node of a graph motif, constrained by an expected Boxology class (beam: namespace, specializing Tool4Boxology) and/or an expected pattern role."@en .

pair:PatternEdge a owl:Class ;
    rdfs:label "Pattern Edge"@en ;
    rdfs:comment "An abstract edge of a graph motif connecting two pattern nodes via a Boxology flow predicate (beam: namespace)."@en .

pair:ApplicabilityCondition a owl:Class ;
    rdfs:label "Applicability Condition"@en ;
    rdfs:comment "A risk-relevant condition over a motif match: facet values, data categories, structural properties, or the absence of represented controls via closed-world query constructs. Applicability conditions are constituents of an AI risk pattern"@en .

pair:PropertyPathCondition a owl:Class ;
    rdfs:subClassOf pair:ApplicabilityCondition ;
    rdfs:label "Property Path Condition"@en ;
    rdfs:comment "An applicability condition evaluated via a SPARQL property path (e.g. reachability of untrusted content to a generation step)."@en .

pair:RiskPattern a owl:Class ;
    rdfs:label "AI Risk Pattern"@en ;
    rdfs:comment "An architectural motif extended with risk semantics: Risk Pattern = Motif + Applicability Conditions + Mechanism + Taxonomy Links + Controls."@en .

pair:RiskMechanism a owl:Class ;
    rdfs:label "Risk Mechanism"@en ;
    rdfs:comment "The curated causal account of how or why a matched configuration under the observed conditions can lead to harm: the risk-pattern's 'why', as opposed to its applicability conditions, which are the machine-checkable 'what' (the detection gate). A mechanism is deliberately NOT part of the detection logic - it is never evaluated or filtered on during matching (encoding the causal account as a second graph condition would duplicate the applicability condition and reintroduce declarative/executable drift). It is inert, reusable text attached by reference to every finding of its pattern, guaranteeing the same explanation is reproduced (never regenerated or paraphrased) across systems and runs. Grounded in the source taxonomy (e.g. an OWASP LLM Top 10 risk's mechanism). Per-finding instance grounding - naming the concrete risk-bearing elements - is added at assessment time via pair:mechanismNarrative, which frames this canonical text against the matched elements without altering it."@en .

pair:PatternImplementation a owl:Class ;
    rdfs:label "Pattern Implementation"@en ;
    rdfs:comment "The executable SPARQL query that detects a motif or evaluates a risk pattern against an architecture graph (the OQP to the motif's ODP). One motif may have multiple implementations; an implementation is an implementation of the motif, not the pattern itself."@en .

pair:MotifMatch a owl:Class ;
    rdfs:label "Motif Match"@en ;
    rdfs:comment "Internal technical entity: the set of node bindings from abstract pattern nodes to concrete architecture elements produced by a motif implementation. Candidate risk findings reference matches."@en .

pair:NodeBinding a owl:Class ;
    rdfs:label "Node Binding"@en ;
    rdfs:comment "A single binding from an abstract pattern node to a concrete architecture element within a motif match."@en .

pair:RiskFinding a owl:Class ;
    rdfs:label "Candidate Risk Finding"@en ;
    rdfs:comment "A system-specific candidate risk generated when a motif match satisfies the applicability conditions of an AI risk pattern. A candidate risk is a structural disposition toward harm identified at design time; it is not a confirmed failure, an observed incident, or a prediction that harm will occur."@en .

pair:DataCategoryPropagation a owl:Class ;
    rdfs:label "Data Category Propagation"@en ;
    skos:definition "Marker output type for pattern implementations that infer pair:containsDataCategory facts (e.g. untrusted-content taint) from roles and data flow."@en .

# Object properties

pair:playsRole a owl:ObjectProperty ;
    rdfs:label "plays role"@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range pair:PatternRole .

pair:subRoleOf a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "sub-role of"@en ;
    rdfs:domain pair:PatternRole ;
    rdfs:range pair:PatternRole .

pair:containsDataCategory a owl:ObjectProperty ;
    rdfs:label "contains data category"@en ;
    rdfs:domain beam:Data ;
    rdfs:range pair:DataCategory .

pair:subDataCategoryOf a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "sub-data-category of"@en ;
    rdfs:domain pair:DataCategory ;
    rdfs:range pair:DataCategory .

pair:hasPatternNode a owl:ObjectProperty ;
    rdfs:label "has pattern node"@en ;
    rdfs:domain pair:GraphMotif ;
    rdfs:range pair:PatternNode .

pair:hasPatternEdge a owl:ObjectProperty ;
    rdfs:label "has pattern edge"@en ;
    rdfs:domain pair:GraphMotif ;
    rdfs:range pair:PatternEdge .

pair:sourcePatternNode a owl:ObjectProperty ;
    rdfs:label "source pattern node"@en ;
    rdfs:domain pair:PatternEdge ;
    rdfs:range pair:PatternNode .

pair:targetPatternNode a owl:ObjectProperty ;
    rdfs:label "target pattern node"@en ;
    rdfs:domain pair:PatternEdge ;
    rdfs:range pair:PatternNode .

pair:patternPredicate a owl:ObjectProperty ;
    rdfs:label "pattern predicate"@en ;
    rdfs:domain pair:PatternEdge ;
    rdfs:range rdf:Property .

pair:expectedClass a owl:ObjectProperty ;
    rdfs:label "expected class"@en ;
    rdfs:domain pair:PatternNode ;
    rdfs:range rdfs:Class .

pair:expectedRole a owl:ObjectProperty ;
    rdfs:label "expected role"@en ;
    rdfs:domain pair:PatternNode ;
    rdfs:range pair:PatternRole .

pair:hasRiskPattern a owl:ObjectProperty ;
    rdfs:label "has risk pattern"@en ;
    rdfs:comment "Links a risk-neutral graph motif to an AI risk pattern that extends it with risk semantics."@en ;
    rdfs:domain pair:GraphMotif ;
    rdfs:range pair:RiskPattern ;
    owl:inverseOf pair:hasMotif .

pair:hasMotif a owl:ObjectProperty ;
    rdfs:label "has motif"@en ;
    rdfs:comment "Links an AI risk pattern to the structural motif that must be present for it to apply."@en ;
    rdfs:domain pair:RiskPattern ;
    rdfs:range pair:GraphMotif .

pair:hasApplicabilityCondition a owl:ObjectProperty ;
    rdfs:label "has applicability condition"@en ;
    rdfs:comment "Links an AI risk pattern to a risk-relevant applicability condition that a motif match must satisfy before a candidate risk finding is emitted."@en ;
    rdfs:domain pair:RiskPattern ;
    rdfs:range pair:ApplicabilityCondition .

pair:hasMechanism a owl:ObjectProperty ;
    rdfs:label "has mechanism"@en ;
    rdfs:comment "Links an AI risk pattern to its curated risk mechanism: the causal account of how or why the configuration is disposed toward harm."@en ;
    rdfs:domain pair:RiskPattern ;
    rdfs:range pair:RiskMechanism .

pair:mayIndicateRisk a owl:ObjectProperty ;
    rdfs:label "may indicate risk"@en ;
    rdfs:comment "Links an AI risk pattern to external taxonomy entries the candidate risk anchors to."@en ;
    rdfs:domain pair:RiskPattern ;
    rdfs:range skos:Concept .

pair:suggestedControl a owl:ObjectProperty ;
    rdfs:label "suggested control"@en ;
    rdfs:domain pair:RiskPattern ;
    rdfs:range beamr:RiskControl .

# Control classification layer (PAIR-AI interpretation).
# The suggested controls span two families - PAIR-AI's own coarse controls
# (pat:Control_*) and reused MIT AI Risk Mitigation entries (mitctrl:*). Neither
# carries a technical/non-technical axis at source: the MIT top-level grouping is
# functional (governance / technical / process / transparency), not a
# technical/non-technical cut, so classifying controls that way requires a stated
# rule (see ontology/patterns/control_mitigation_layer.ttl). Read by the workbench
# to present mitigations in two tiers (Rule: candidate framing preserved - a
# control is a suggestion, its motif realization a candidate structural mitigation).

pair:controlNature a owl:ObjectProperty ;
    rdfs:label "control nature"@en ;
    rdfs:comment "Classifies a risk control as technical or non-technical by how it is realized. PAIR-AI interpretation over the reused/curated controls, not an axis asserted by the source taxonomies."@en ;
    rdfs:domain beamr:RiskControl ;
    rdfs:range skos:Concept .

pair:realizedByMotif a owl:ObjectProperty ;
    rdfs:label "realized by motif"@en ;
    rdfs:comment "Links a technical, architecturally-detectable risk control to an architectural motif that can structurally realize it: a CANDIDATE structural mitigation - inserting the motif into the architecture graph is one way to implement the control. It does not replace the control (the mitigation plan); it operationalizes it structurally, giving an insertion site rather than only a label. Example: a grounding/verification control realized by adding a retrieval-augmented-generation or vector-retrieval motif to tackle ungrounded generation. The link is an assumed mitigation relation (like the rest of the library, curated and candidate), not a proof the motif removes the risk."@en ;
    rdfs:domain beamr:RiskControl ;
    rdfs:range pair:GraphMotif .

pair:ControlNatureScheme a skos:ConceptScheme ;
    skos:prefLabel "Control Nature"@en ;
    skos:definition "Whether a risk control is realized in the technical architecture or through organisational process. PAIR-AI interpretation; the stated rule and per-control assignments live in ontology/patterns/control_mitigation_layer.ttl."@en ;
    dct:source "PAIR-AI supporting analysis: risk-to-mitigation connection reference (technical vs non-technical criterion)." .

pair:TechnicalControl a skos:Concept ;
    skos:inScheme pair:ControlNatureScheme ;
    skos:topConceptOf pair:ControlNatureScheme ;
    skos:prefLabel "Technical control"@en ;
    skos:definition "A control realized in the AI system's technical stack (model, data pipeline, infrastructure, or runtime), with an actual or possible footprint in the system architecture. A technical control may additionally be architecturally detectable, in which case a motif can realize it (pair:realizedByMotif)."@en .

pair:NonTechnicalControl a skos:Concept ;
    skos:inScheme pair:ControlNatureScheme ;
    skos:topConceptOf pair:ControlNatureScheme ;
    skos:prefLabel "Non-technical control"@en ;
    skos:definition "A control realized through organisational structure, human process, governance, documentation, or disclosure, with no direct footprint in the technical architecture. It is surfaced as a taxonomy-level recommendation, not a situated structural suggestion."@en .

pair:operationalizesRiskCondition a owl:ObjectProperty ;
    rdfs:label "operationalizes risk condition"@en ;
    rdfs:comment "Links an applicability condition to the external taxonomy risk-condition entry it operationalizes."@en ;
    rdfs:domain pair:ApplicabilityCondition ;
    rdfs:range rdfs:Resource .

pair:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derived from"@en ;
    rdfs:comment "Derivation provenance for curated pattern knowledge: links a graph motif or AI risk pattern to the resource it was derived from (e.g. a Boxology elementary pattern, a taxonomy entry such as an OWASP LLM Top 10 item, or a documented design-pattern source)."@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (pair:GraphMotif pair:RiskPattern)
    ] .

pair:maturity a owl:DatatypeProperty ;
    rdfs:label "maturity"@en ;
    rdfs:comment """Curation maturity of a graph motif or AI risk pattern, so consumers can tell
vetted library entries from work in progress. One of three values:
  "validated" - derived from a traceable source AND confirmed to match at least one
                real architecture graph in this repository;
  "draft"     - derived from a traceable source but not yet confirmed against a real
                architecture graph;
  "proposed"  - candidate entry with no traceable source yet; not fit for reporting.
Maturity describes the curation state of the library entry itself. It says nothing
about the likelihood or severity of any risk, and never affects matching."""@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (pair:GraphMotif pair:RiskPattern)
    ] ;
    rdfs:range xsd:string .

pair:implementedBy a owl:ObjectProperty ;
    rdfs:label "implemented by"@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (pair:GraphMotif pair:RiskPattern)
    ] ;
    rdfs:range pair:PatternImplementation .

pair:implementsMotif a owl:ObjectProperty ;
    rdfs:label "implements motif"@en ;
    rdfs:domain pair:PatternImplementation ;
    rdfs:range pair:GraphMotif .

pair:implementsRiskPattern a owl:ObjectProperty ;
    rdfs:label "implements risk pattern"@en ;
    rdfs:comment "Links an executable SPARQL implementation to the AI risk pattern it evaluates."@en ;
    rdfs:domain pair:PatternImplementation ;
    rdfs:range pair:RiskPattern .

pair:producesOutputType a owl:ObjectProperty ;
    rdfs:label "produces output type"@en ;
    rdfs:domain pair:PatternImplementation ;
    rdfs:range rdfs:Class .

pair:matchesMotif a owl:ObjectProperty ;
    rdfs:label "matches motif"@en ;
    rdfs:domain pair:MotifMatch ;
    rdfs:range pair:GraphMotif .

pair:hasNodeBinding a owl:ObjectProperty ;
    rdfs:label "has node binding"@en ;
    rdfs:domain pair:MotifMatch ;
    rdfs:range pair:NodeBinding .

pair:bindsPatternNode a owl:ObjectProperty ;
    rdfs:label "binds pattern node"@en ;
    rdfs:domain pair:NodeBinding ;
    rdfs:range pair:PatternNode .

pair:matchedElement a owl:ObjectProperty ;
    rdfs:label "matched element"@en ;
    rdfs:domain pair:NodeBinding ;
    rdfs:range rdfs:Resource .

pair:generatedFromMatch a owl:ObjectProperty ;
    rdfs:label "generated from match"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range pair:MotifMatch .

pair:generatedByMotif a owl:ObjectProperty ;
    rdfs:label "generated by motif"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range pair:GraphMotif .


pair:hasEvidence a owl:ObjectProperty ;
    rdfs:label "has evidence"@en ;
    rdfs:comment "Attaches the evidence of a candidate risk finding: the elements of the matched subgraph that triggered the finding. Evidence is retained for durable traceability."@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range rdfs:Resource .

pair:hasDerivedMechanism a owl:ObjectProperty ;
    rdfs:label "has derived mechanism"@en ;
    rdfs:comment "Links a candidate risk finding to the risk mechanism selected from the satisfied AI risk pattern. Mechanisms are selected at assessment time, never invented."@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range pair:RiskMechanism .

pair:identifiesCandidateRisk a owl:ObjectProperty ;
    rdfs:label "identifies candidate risk"@en ;
    rdfs:comment "Links a candidate risk finding to the risk it identifies as a candidate."@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range beamr:Risk .

pair:hasCandidateRiskTaxonomyEntry a owl:ObjectProperty ;
    rdfs:label "has candidate risk taxonomy entry"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range skos:Concept .

pair:hasSuggestedControl a owl:ObjectProperty ;
    rdfs:label "has suggested control"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range beamr:RiskControl .

pair:hasSatisfiedCondition a owl:ObjectProperty ;
    rdfs:label "has satisfied condition"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range rdfs:Resource .

# Data properties

pair:implementationPath a owl:DatatypeProperty ;
    rdfs:label "implementation path"@en ;
    rdfs:domain pair:PatternImplementation ;
    rdfs:range xsd:string .

pair:findingStatus a owl:DatatypeProperty ;
    rdfs:label "finding status"@en ;
    rdfs:comment """Review state of a candidate risk finding. Exactly one value per finding, drawn
from a closed set of five (enforced by shacl/assessment_output_contract.ttl):
  "candidate" - the structure matched and the applicability conditions held. A
                structural disposition, never a confirmed failure. THE ONLY VALUE
                THE PIPELINE EVER WRITES: every risk query emits "candidate"
                literally, by construction.
  "confirmed" - a human or runtime evidence established the risk is real here;
  "refuted"   - established the risk does not apply (e.g. a control exists that
                the submitted graph did not represent);
  "mitigated" - accepted as real and addressed by a control;
  "accepted"  - acknowledged as real and knowingly tolerated.
The four non-candidate values are an EXTENSION POINT for later human review or
runtime evidence. Nothing in the assessment pipeline writes them, and nothing in
it reads them: they exist so a verdict can be recorded without inventing new
vocabulary or breaking the candidate framing (Rule R1). Kept as xsd:string rather
than a SKOS scheme deliberately - the value set is closed and small, findings are
generated output rather than curated knowledge, and existing tests assert the
plain literal."""@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range xsd:string .

pair:mechanismNarrative a owl:DatatypeProperty ;
    rdfs:label "mechanism narrative"@en ;
    rdfs:comment "An instance-grounded rendering of a candidate risk finding's mechanism: the pattern's canonical curated causal text (pair:hasDerivedMechanism / pair:RiskMechanism) framed against the concrete architecture elements that triggered this specific finding. Materialized at assessment time by the risk query. The canonical causal wording is reused verbatim from the mechanism individual (single source, no paraphrase), with only an instance frame naming the matched elements appended - so this presentation string introduces no new curated claim and cannot drift from the mechanism. Complements pair:hasDerivedMechanism (the reusable IRI pointer, kept for traceability) rather than replacing it."@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range xsd:string .

### Top-level roles

pair:ProcessingStep a pair:PatternRole ;
    skos:prefLabel "Processing Step"@en ;
    skos:definition "A step in the workflow of an AI system, such as data preprocessing, model training, inference, or post-processing. Corresponds to the Boxology process box."@en ;
    skos:closeMatch t4b:Process ;
    dct:source "Tool4Boxology t4b:Process (Boxology process node; van Bekkum et al., 2021)" .

pair:ControlStep a pair:PatternRole ;
    skos:prefLabel "Control Step"@en ;
    skos:definition "A step in the workflow of an AI system that implements a risk control or mitigation measure, such as input/output screening, validation, or rate limiting."@en ;
    skos:relatedMatch airo:RiskControl , dpv:RiskMitigationMeasure ;
    dct:source "AIRO airo:RiskControl (ISO/IEC 31073, 3.3.33); DPV dpv:RiskMitigationMeasure (verified 2026-07-16)" .

pair:ResourceRole a pair:PatternRole ;
    skos:prefLabel "Resource Role"@en ;
    skos:definition "A role played by a non-process resource in an AI system: data, models, stores, or artifacts. Corresponds to the non-process Boxology boxes (data, symbols, models)."@en ;
    skos:relatedMatch t4b:Artifact ;
    dct:source "Tool4Boxology t4b:Artifact (Boxology node; van Bekkum et al., 2021)" .

### Input/output roles

pair:UserInput a pair:PatternRole ;
    skos:prefLabel "User Input"@en ;
    skos:definition "Information provided directly by a user, such as through a user interface or API input."@en ;
    skos:relatedMatch airo:Input , dpv:ProvidedData ;
    dct:source "AIRO airo:Input; DPV dpv:ProvidedData (verified 2026-07-16)" .

pair:PublicUserInput a pair:PatternRole ;
    skos:prefLabel "Public User Input"@en ;
    pair:subRoleOf pair:UserInput ;
    skos:definition "User input accepted from an open or public population (anonymous or self-registered users), as opposed to a closed, vetted user group. Treated as untrusted by the taint propagation query."@en ;
    dct:source "expert curation; OWASP Top 10 for LLM Applications 2025, LLM01 Prompt Injection (untrusted input scope)" .

pair:UserFacingOutput a pair:PatternRole ;
    skos:prefLabel "UserFacingOutput"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "Data exposed to a user or downstream consumer (a sink)."@en ;
    skos:relatedMatch airo:Output ;
    dct:source "AIRO airo:Output (verified 2026-07-16); https://martinfowler.com/articles/gen-ai-patterns/" .

pair:PublicUserFacingOutput a pair:PatternRole ;
    skos:prefLabel "Public User-Facing Output"@en ;
    pair:subRoleOf pair:UserFacingOutput ;
    skos:definition "User-facing output exposed to the public, such as a chatbot response or public-facing summary."@en ;
    dct:source "expert curation (public-exposure specialization of UserFacingOutput)" .

### Knowledge-source roles (parent: pair:KnowledgeSource)

pair:KnowledgeSource a pair:PatternRole ;
    skos:prefLabel "Knowledge Source"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A source of information that an AI system can access, such as a database, knowledge graph, or external API."@en ;
    skos:relatedMatch t4b:KG , t4b:DB ;
    dct:source "Tool4Boxology t4b:KG / t4b:DB (Boxology symbol nodes; van Bekkum et al., 2021)" .

pair:VectorStore a pair:PatternRole ;
    skos:prefLabel "VectorStore"@en ;
    pair:subRoleOf pair:KnowledgeSource ;
    skos:definition "A vector database serving as a knowledge source for retrieval."@en ;
    skos:relatedMatch t4b:DB ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:VectorIndex a pair:PatternRole ;
    skos:prefLabel "VectorIndex"@en ;
    pair:subRoleOf pair:KnowledgeSource ;
    skos:definition "An index over embedding vectors."@en ;
    skos:relatedMatch t4b:DB ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:KeywordIndex a pair:PatternRole ;
    skos:prefLabel "KeywordIndex"@en ;
    pair:subRoleOf pair:KnowledgeSource ;
    skos:definition "A keyword/text index used for lexical search."@en ;
    skos:relatedMatch t4b:DB ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

### Model roles 

pair:Model a pair:PatternRole ;
    skos:prefLabel "Model"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A machine learning or statistical model resource. Corresponds to the Boxology model box."@en ;
    skos:closeMatch t4b:Model ;
    skos:relatedMatch ai:Model , airo:AIModel ;
    dct:source "Tool4Boxology t4b:Model (van Bekkum et al., 2021); DPV-AI ai:Model; AIRO airo:AIModel (verified 2026-07-16)" .

pair:GenerativeModel a pair:PatternRole ;
    skos:prefLabel "Generative Model"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model that generates content (e.g. an LLM) at inference time."@en ;
    skos:relatedMatch ai:GenAI ;
    dct:source "DPV-AI ai:GenAI (verified 2026-07-16); https://martinfowler.com/articles/gen-ai-patterns/" .

pair:PretrainedModel a pair:PatternRole ;
    skos:prefLabel "Pre-trained Model"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A pre-trained model obtained before (or without) task-specific adaptation, e.g. downloaded weights from a model hub."@en ;
    skos:broadMatch ai:TrainedModel ;
    skos:relatedMatch ai:GPAIModel ;
    dct:source "DPV-AI ai:TrainedModel, ai:GPAIModel (EU AI Act; verified 2026-07-16); https://mercari.github.io/ml-system-design-pattern/Lifecycle-patterns/Train-then-serve-pattern/design_en.html" .

pair:FoundationLLM a pair:PatternRole ;
    skos:prefLabel "Foundation LLM"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A foundation large language model used directly for generation."@en ;
    skos:closeMatch ai:LLM ;
    skos:relatedMatch ai:GPAIModel ;
    dct:source "DPV-AI ai:LLM, ai:GPAIModel (EU AI Act; verified 2026-07-16); https://martinfowler.com/articles/gen-ai-patterns/" .

pair:FineTunedModel a pair:PatternRole ;
    skos:prefLabel "Fine-tuned Model"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model produced by fine-tuning a pre-trained model on task-specific data."@en ;
    skos:closeMatch ai:FineTunedModel ;
    dct:source "DPV-AI ai:FineTunedModel (verified 2026-07-16); https://martinfowler.com/articles/gen-ai-patterns/" .

pair:EmbeddingModel a pair:PatternRole ;
    skos:prefLabel "Embedding Model"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model that transforms data into vector embeddings."@en ;
    skos:relatedMatch t4b:SelfSupervisedEmbeddingModel ;
    dct:source "Tool4Boxology t4b:SelfSupervisedEmbeddingModel; https://martinfowler.com/articles/gen-ai-patterns/" .

pair:JudgeModel a pair:PatternRole ;
    skos:prefLabel "Judge Model"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model used to score or evaluate the output of another model (LLM-as-judge)."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:RerankerModel a pair:PatternRole ;
    skos:prefLabel "Reranker Model"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model (typically a cross-encoder) that scores candidate relevance for reranking."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:LoadedModel a pair:PatternRole ;
    skos:prefLabel "Loaded Model"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model instance loaded into a serving runtime."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Model-load-pattern/design_en.html> .

pair:ModelArtifact a pair:PatternRole ;
    skos:prefLabel "Model Artifact"@en ;
    pair:subRoleOf pair:Model ;
    skos:definition "A persisted model artifact (weights/checkpoint) produced or consumed by a workflow."@en ;
    skos:relatedMatch ai:TrainedModel ;
    dct:source "DPV-AI ai:TrainedModel (verified 2026-07-16); https://mercari.github.io/ml-system-design-pattern/Lifecycle-patterns/Train-then-serve-pattern/design_en.html" .

### Data/resource roles 

pair:RetrievedContext a pair:PatternRole ;
    skos:prefLabel "RetrievedContext"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "Content returned by a retrieval step for use as context."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:RetrievedResult a pair:PatternRole ;
    skos:prefLabel "RetrievedResult"@en ;
    pair:subRoleOf pair:RetrievedContext ;
    skos:definition "A result item returned by a retrieval step, used as retrieved context."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:PromptTemplate a pair:PatternRole ;
    skos:prefLabel "PromptTemplate"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A prompt template combining instructions and inputs."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:EmbeddingVector a pair:PatternRole ;
    skos:prefLabel "EmbeddingVector"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A stored embedding vector."@en ;
    skos:relatedMatch t4b:Tensor ;
    dct:source "Tool4Boxology t4b:Tensor; https://martinfowler.com/articles/gen-ai-patterns/" .

pair:ExpectedOutput a pair:PatternRole ;
    skos:prefLabel "ExpectedOutput"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A reference/expected output used in evaluation."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:EvaluationResult a pair:PatternRole ;
    skos:prefLabel "EvaluationResult"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "The result produced by an evaluation step."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Training-patterns/Batch-training-pattern/design_en.html> .

pair:EvaluationScore a pair:PatternRole ;
    skos:prefLabel "EvaluationScore"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A numeric score produced by an evaluation step."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:LLMResponse a pair:PatternRole ;
    skos:prefLabel "LLMResponse"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A response produced by a generative model prior to output screening."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:GuardrailDecision a pair:PatternRole ;
    skos:prefLabel "GuardrailDecision"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A decision (allow/block) produced by a guardrail step."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:SanitizedOutput a pair:PatternRole ;
    skos:prefLabel "SanitizedOutput"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "Output that has passed an output guardrail/sanitization step."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:RewrittenQuery a pair:PatternRole ;
    skos:prefLabel "RewrittenQuery"@en ;
    pair:subRoleOf pair:UserInput ;
    skos:definition "A reformulated query produced by a query rewriting step. A specialization of UserInput: a rewritten query is still the user's request, restated, and carries the same untrusted provenance - so it satisfies every condition written against UserInput. Previously placed directly under ResourceRole, which made the precise role inert: queries traverse pair:subRoleOf* from UserInput, so tagging an element only as RewrittenQuery silently prevented the Query Rewriting motif from matching."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:RetrievedCandidateSet a pair:PatternRole ;
    skos:prefLabel "RetrievedCandidateSet"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A set of retrieved candidate fragments prior to reranking."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:RerankedContext a pair:PatternRole ;
    skos:prefLabel "RerankedContext"@en ;
    pair:subRoleOf pair:RetrievedContext ;
    skos:definition "Reranked, selected context fragments for generation. A specialization of RetrievedContext: reranking reorders and trims retrieved fragments without changing what they are, so reranked context satisfies every condition written against RetrievedContext. Previously placed directly under ResourceRole, which made the precise role inert: tagging an element only as RerankedContext silently prevented the Reranker motif from matching."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:DocumentChunk a pair:PatternRole ;
    skos:prefLabel "DocumentChunk"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A chunk of a source document used for embedding/retrieval."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:SourceDocument a pair:PatternRole ;
    skos:prefLabel "SourceDocument"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A source document ingested into a knowledge base."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:PredictionRequest a pair:PatternRole ;
    skos:prefLabel "PredictionRequest"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "An incoming request for a prediction."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Synchronous-pattern/design_en.html> .

pair:PredictionResult a pair:PatternRole ;
    skos:prefLabel "PredictionResult"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "The result of a prediction step."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Synchronous-pattern/design_en.html> .

pair:PredictionQueue a pair:PatternRole ;
    skos:prefLabel "PredictionQueue"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A queue holding prediction requests."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Asynchronous-pattern/design_en.html> .

pair:PredictionLog a pair:PatternRole ;
    skos:prefLabel "PredictionLog"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A log of predictions for monitoring/audit."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Prediction-log-pattern/design_en.html> .

pair:TrainingDataset a pair:PatternRole ;
    skos:prefLabel "TrainingDataset"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A dataset used to train a model."@en ;
    skos:closeMatch ai:TrainingData ;
    dct:source "DPV-AI ai:TrainingData (verified 2026-07-16); https://mercari.github.io/ml-system-design-pattern/Training-patterns/Batch-training-pattern/design_en.html" .

pair:FineTuningDataset a pair:PatternRole ;
    skos:prefLabel "FineTuningDataset"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A dataset used to fine-tune a model."@en ;
    skos:relatedMatch ai:TrainingData ;
    dct:source "DPV-AI ai:TrainingData (verified 2026-07-16); https://martinfowler.com/articles/gen-ai-patterns/" .

pair:BatchDataset a pair:PatternRole ;
    skos:prefLabel "BatchDataset"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A dataset processed in batch."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Batch-pattern/design_en.html> .

pair:PreprocessedData a pair:PatternRole ;
    skos:prefLabel "PreprocessedData"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "Data produced by a preprocessing step."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Prep-pred-pattern/design_en.html> .

pair:MonitoringBaseline a pair:PatternRole ;
    skos:prefLabel "MonitoringBaseline"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A baseline used by a monitoring step."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Prediction-monitoring-pattern/design_en.html> .

pair:Alert a pair:PatternRole ;
    skos:prefLabel "Alert"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "An alert raised by a monitoring step."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Prediction-monitoring-pattern/design_en.html> .

pair:ServingImage a pair:PatternRole ;
    skos:prefLabel "ServingImage"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A container image used to serve a model."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Model-in-image-pattern/design_en.html> .

pair:ReleaseApproval a pair:PatternRole ;
    skos:prefLabel "ReleaseApproval"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "An approval artifact gating a release."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Lifecycle-patterns/Train-then-serve-pattern/design_en.html> .

### External-dependency roles 

pair:ExternalDependency a pair:PatternRole ;
    skos:prefLabel "ExternalDependency"@en ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A resource sourced from outside the modeled organization's control (model, package, credential, or service) whose provenance and integrity the submitted graph cannot vouch for."@en ;
    dct:source "OWASP Top 10 for LLM Applications 2025, LLM03 Supply Chain" .

pair:ExternalModel a pair:PatternRole ;
    skos:prefLabel "ExternalModel"@en ;
    pair:subRoleOf pair:ExternalDependency , pair:Model ;
    skos:definition "A model obtained from an external provider or model hub (API-served or downloaded weights)."@en ;
    dct:source "OWASP Top 10 for LLM Applications 2025, LLM03 Supply Chain" .

pair:ThirdPartyPackage a pair:PatternRole ;
    skos:prefLabel "ThirdPartyPackage"@en ;
    pair:subRoleOf pair:ExternalDependency ;
    skos:definition "A third-party software package, library, or plugin the system depends on."@en ;
    dct:source "OWASP Top 10 for LLM Applications 2025, LLM03 Supply Chain (third-party package vulnerabilities)" .

pair:ExternalProviderCredential a pair:PatternRole ;
    skos:prefLabel "ExternalProviderCredential"@en ;
    pair:subRoleOf pair:ExternalDependency ;
    skos:definition "A credential (API key, token) granting access to an external provider on behalf of the system."@en ;
    dct:source "OWASP Top 10 for LLM Applications 2025, LLM03 Supply Chain" .

pair:SystemPrompt a pair:PatternRole ;
    skos:prefLabel "SystemPrompt"@en ;
    pair:subRoleOf pair:PromptTemplate ;
    skos:definition "A hidden system prompt or instruction template steering model behavior, not authored by the end user."@en ;
    dct:source "OWASP Top 10 for LLM Applications 2025, LLM07 System Prompt Leakage" .

### Processing-step roles 

pair:GenerationStep a pair:PatternRole ;
    skos:prefLabel "GenerationStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that runs a generative model to produce output (Boxology infer process)."@en ;
    skos:relatedMatch t4b:Infer , ai:NaturalLanguageGeneration ;
    dct:source "Tool4Boxology t4b:Infer; DPV-AI ai:NaturalLanguageGeneration (verified 2026-07-16); https://martinfowler.com/articles/gen-ai-patterns/" .

pair:EmbeddingStep a pair:PatternRole ;
    skos:prefLabel "EmbeddingStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that produces embeddings from data (Boxology embed/transform process)."@en ;
    skos:closeMatch t4b:Embed ;
    dct:source "Tool4Boxology t4b:Embed; https://martinfowler.com/articles/gen-ai-patterns/" .

pair:RetrievalStep a pair:PatternRole ;
    skos:prefLabel "RetrievalStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that retrieves fragments from a knowledge source."@en ;
    skos:relatedMatch ai:InformationRetrieval ;
    dct:source "DPV-AI ai:InformationRetrieval (verified 2026-07-16); https://martinfowler.com/articles/gen-ai-patterns/" .

pair:RerankingStep a pair:PatternRole ;
    skos:prefLabel "RerankingStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that reranks retrieved candidates."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:QueryReformulationStep a pair:PatternRole ;
    skos:prefLabel "QueryReformulationStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that reformulates a query (Boxology transform process)."@en ;
    skos:relatedMatch t4b:Transform ;
    dct:source "Tool4Boxology t4b:Transform; https://martinfowler.com/articles/gen-ai-patterns/" .

pair:PromptConstructionStep a pair:PatternRole ;
    skos:prefLabel "PromptConstructionStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that assembles a prompt from inputs and context (Boxology transform process)."@en ;
    skos:relatedMatch t4b:Transform ;
    dct:source "Tool4Boxology t4b:Transform; https://martinfowler.com/articles/gen-ai-patterns/" .

pair:ScoringStep a pair:PatternRole ;
    skos:prefLabel "ScoringStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that scores a model output during evaluation."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:EvaluationStep a pair:PatternRole ;
    skos:prefLabel "EvaluationStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that evaluates model behavior."@en ;
    skos:relatedMatch ai:Benchmarking ;
    dct:source "DPV-AI ai:Benchmarking (verified 2026-07-16); https://martinfowler.com/articles/gen-ai-patterns/" .

pair:PredictionStep a pair:PatternRole ;
    skos:prefLabel "PredictionStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that runs model inference to produce a prediction (Boxology infer process)."@en ;
    skos:relatedMatch t4b:Infer ;
    dct:source "Tool4Boxology t4b:Infer; https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Synchronous-pattern/design_en.html" .

pair:PreprocessingStep a pair:PatternRole ;
    skos:prefLabel "PreprocessingStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that preprocesses input data (Boxology transform process)."@en ;
    skos:relatedMatch t4b:Transform , ai:DataPreparation ;
    dct:source "Tool4Boxology t4b:Transform; DPV-AI ai:DataPreparation (verified 2026-07-16); https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Prep-pred-pattern/design_en.html" .

pair:ChunkingStep a pair:PatternRole ;
    skos:prefLabel "ChunkingStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that splits documents into chunks (Boxology transform process)."@en ;
    skos:relatedMatch t4b:Transform ;
    dct:source "Tool4Boxology t4b:Transform; https://martinfowler.com/articles/gen-ai-patterns/" .

pair:VectorSearchStep a pair:PatternRole ;
    skos:prefLabel "VectorSearchStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step performing vector similarity search."@en ;
    skos:relatedMatch ai:InformationRetrieval ;
    dct:source "DPV-AI ai:InformationRetrieval (verified 2026-07-16); https://martinfowler.com/articles/gen-ai-patterns/" .

pair:KeywordSearchStep a pair:PatternRole ;
    skos:prefLabel "KeywordSearchStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step performing keyword/lexical search."@en ;
    skos:relatedMatch ai:InformationRetrieval ;
    dct:source "DPV-AI ai:InformationRetrieval (verified 2026-07-16); https://martinfowler.com/articles/gen-ai-patterns/" .

pair:AggregationStep a pair:PatternRole ;
    skos:prefLabel "AggregationStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step aggregating results from multiple searches."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:TrainingStep a pair:PatternRole ;
    skos:prefLabel "TrainingStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that trains a model (Boxology train process)."@en ;
    skos:closeMatch ai:ModelTraining ;
    skos:relatedMatch t4b:Train ;
    dct:source "Tool4Boxology t4b:Train; DPV-AI ai:ModelTraining (verified 2026-07-16); https://mercari.github.io/ml-system-design-pattern/Training-patterns/Batch-training-pattern/design_en.html" .

pair:TrainingPipeline a pair:PatternRole ;
    skos:prefLabel "TrainingPipeline"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A pipeline orchestrating model training."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Training-patterns/Pipeline-training-pattern/design_en.html> .

pair:FineTuningStep a pair:PatternRole ;
    skos:prefLabel "FineTuningStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that fine-tunes a pre-trained model."@en ;
    skos:closeMatch ai:ModelFineTuning ;
    dct:source "DPV-AI ai:ModelFineTuning (verified 2026-07-16); https://martinfowler.com/articles/gen-ai-patterns/" .

pair:DeploymentStep a pair:PatternRole ;
    skos:prefLabel "DeploymentStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that deploys a model to serving."@en ;
    skos:relatedMatch ai:DeploymentStage ;
    dct:source "DPV-AI ai:DeploymentStage (verified 2026-07-16); https://mercari.github.io/ml-system-design-pattern/Lifecycle-patterns/Train-then-serve-pattern/design_en.html" .

pair:ModelLoadStep a pair:PatternRole ;
    skos:prefLabel "ModelLoadStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that loads a model into a runtime."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Model-load-pattern/design_en.html> .

pair:ImageBuildStep a pair:PatternRole ;
    skos:prefLabel "ImageBuildStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that builds a serving image."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Model-in-image-pattern/design_en.html> .

pair:LoggingStep a pair:PatternRole ;
    skos:prefLabel "LoggingStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that logs predictions or events."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Prediction-log-pattern/design_en.html> .

pair:MonitoringStep a pair:PatternRole ;
    skos:prefLabel "MonitoringStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that monitors a deployed model."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Prediction-monitoring-pattern/design_en.html> .

pair:JobScheduler a pair:PatternRole ;
    skos:prefLabel "JobScheduler"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that schedules jobs in a workflow."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Batch-pattern/design_en.html> .

pair:ToolInvocationStep a pair:PatternRole ;
    skos:prefLabel "ToolInvocationStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that invokes an external tool, plugin, or API on behalf of the system (agentic tool use)."@en ;
    dct:source "OWASP Top 10 for LLM Applications 2025, LLM06 Excessive Agency" .

pair:StateChangingStep a pair:PatternRole ;
    skos:prefLabel "StateChangingStep"@en ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that changes external state: writes, transactions, or other actions with side effects outside the system boundary."@en ;
    dct:source "OWASP Top 10 for LLM Applications 2025, LLM06 Excessive Agency" .

### Prediction-step specializations 

pair:FastPredictionStep a pair:PatternRole ;
    skos:prefLabel "FastPredictionStep"@en ;
    pair:subRoleOf pair:PredictionStep ;
    skos:definition "A low-latency prediction step."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Multiple-stage-prediction-pattern/design_en.html> .

pair:SlowPredictionStep a pair:PatternRole ;
    skos:prefLabel "SlowPredictionStep"@en ;
    pair:subRoleOf pair:PredictionStep ;
    skos:definition "A higher-latency prediction step."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Multiple-stage-prediction-pattern/design_en.html> .

### Control-step roles 

pair:GuardrailStep a pair:PatternRole ;
    skos:prefLabel "GuardrailStep"@en ;
    pair:subRoleOf pair:ControlStep ;
    skos:definition "A guardrail step that screens input or output."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:InputGuardrailStep a pair:PatternRole ;
    skos:prefLabel "InputGuardrailStep"@en ;
    pair:subRoleOf pair:GuardrailStep ;
    skos:definition "A guardrail step screening user input before generation."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:OutputGuardrailStep a pair:PatternRole ;
    skos:prefLabel "OutputGuardrailStep"@en ;
    pair:subRoleOf pair:GuardrailStep ;
    skos:definition "A guardrail step screening model output before release."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> .

pair:OutputValidationStep a pair:PatternRole ;
    skos:prefLabel "OutputValidationStep"@en ;
    pair:subRoleOf pair:ControlStep ;
    skos:definition "A step that validates, encodes, or sanitizes model output before it is used by users, tools, or downstream systems."@en ;
    dct:source "OWASP Top 10 for LLM Applications 2025, LLM05 Improper Output Handling" .

pair:RateLimitControlStep a pair:PatternRole ;
    skos:prefLabel "RateLimitControlStep"@en ;
    pair:subRoleOf pair:ControlStep ;
    skos:definition "A step that enforces rate, budget, quota, or loop bounds on model calls, retrieval breadth, or tool use."@en ;
    dct:source "OWASP Top 10 for LLM Applications 2025, LLM10 Unbounded Consumption" .

# Data category vocabulary (the Data Category characterization facet)
#
# Curated scheme of content classification values. Assignment is an annotated
# base fact (Rule R8) via pair:containsDataCategory; untrusted-content taint
# is additionally DERIVED by propagation queries along beam:use/beam:produce.
# Hierarchy note: applicability-condition queries traverse
# pair:subDataCategoryOf* toward pair:UntrustedContent,
# pair:SensitiveInformation, and pair:PromptInstruction - adding a
# subDataCategoryOf edge INTO one of those three roots widens query results
# and needs explicit sign-off. Edges into pair:Information are neutral.

pair:DataCategoryScheme a skos:ConceptScheme ;
    skos:prefLabel "Data Category"@en ;
    skos:definition "Characterization facet classifying the content of data resources (glossary v1.1 A.3). Read by applicability conditions only; aligned to DPV data concepts where equivalents exist (Rule R3: referenced, never copied)."@en ;
    dct:source "PAIR-AI glossary v1.1, Section A.3; DPV v2.3 (https://w3id.org/dpv#, verified 2026-07-13)" .

pair:Information a pair:DataCategory ;
    skos:prefLabel "Information"@en ;
    skos:inScheme pair:DataCategoryScheme ;
    skos:topConceptOf pair:DataCategoryScheme ;
    skos:definition "Root category for content-kind classification: informational content handled by the system. Use-case graphs subclass this for domain content (e.g. connected workspace content)."@en ;
    dct:source "expert curation" .

pair:SensitiveInformation a pair:DataCategory ;
    skos:prefLabel "Sensitive Information"@en ;
    skos:inScheme pair:DataCategoryScheme ;
    pair:subDataCategoryOf pair:Information ;
    skos:definition "Content whose exposure can harm individuals or organizations (personal, medical, financial, or otherwise protection-worthy information). Root category traversed by sensitive-data applicability conditions."@en ;
    skos:relatedMatch <https://w3id.org/dpv#SensitivePersonalData> ;
    dct:source "expert curation; DPV v2.3 dpv:SensitivePersonalData (verified 2026-07-13)" .

pair:ConfidentialInformation a pair:DataCategory ;
    skos:prefLabel "Confidential Information"@en ;
    skos:inScheme pair:DataCategoryScheme ;
    pair:subDataCategoryOf pair:Information ;
    skos:definition "Content that must be kept secret for operational or business reasons (credentials, keys, internal configuration). Deliberately NOT a subcategory of SensitiveInformation: sensitive-data conditions target personal/organizational harm, not secrets management."@en ;
    skos:relatedMatch <https://w3id.org/dpv#ConfidentialData> ;
    dct:source "expert curation; DPV v2.3 dpv:ConfidentialData (verified 2026-07-13)" .

pair:ExternalUserContent a pair:DataCategory ;
    skos:prefLabel "External User Content"@en ;
    skos:inScheme pair:DataCategoryScheme ;
    pair:subDataCategoryOf pair:Information ;
    skos:definition "Content originating from a user outside the system boundary (queries, uploads, chat messages). Deliberately NOT a subcategory of UntrustedContent: untrusted-content taint is derived from roles and flow by the propagation queries, not implied by this category."@en ;
    dct:source "expert curation" .

pair:GeneratedContent a pair:DataCategory ;
    skos:prefLabel "Generated Content"@en ;
    skos:inScheme pair:DataCategoryScheme ;
    pair:subDataCategoryOf pair:Information ;
    skos:definition "Content produced by a generative model rather than authored or retrieved."@en ;
    skos:relatedMatch <https://w3id.org/dpv#GeneratedData> ;
    dct:source "expert curation; DPV v2.3 dpv:GeneratedData (verified 2026-07-13)" .

pair:PromptInstruction a pair:DataCategory ;
    skos:prefLabel "Prompt Instruction"@en ;
    skos:inScheme pair:DataCategoryScheme ;
    skos:topConceptOf pair:DataCategoryScheme ;
    skos:definition "Instructional content steering model behavior (system prompts, prompt templates, operational configuration). Root category traversed by system-prompt-leakage and embeddings-related conditions."@en ;
    dct:source "expert curation" .

pair:UntrustedContent a pair:DataCategory ;
    skos:prefLabel "Untrusted Content"@en ;
    skos:inScheme pair:DataCategoryScheme ;
    skos:topConceptOf pair:DataCategoryScheme ;
    skos:definition "Content whose integrity the system cannot vouch for within the submitted graph (public input, externally sourced documents, retrieved context). Root category traversed by prompt-injection and poisoning applicability conditions; also derived along data flow by the untrusted-content propagation query. Absence of this category means unknown, not trusted."@en ;
    dct:source "expert curation" .

pair:TrustedContent a pair:DataCategory ;
    skos:prefLabel "TrustedContent"@en ;
    skos:inScheme pair:DataCategoryScheme ;
    skos:topConceptOf pair:DataCategoryScheme ;
    skos:definition "Explicit override marking content as trusted, clearing any untrusted-content taint that would otherwise propagate to it from an upstream public-input or retrieved-context source."@en .
