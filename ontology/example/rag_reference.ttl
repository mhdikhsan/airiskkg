@prefix rw:    <http://w3id.org/airiskkg/example/realworld-langchain-rag#> .
@prefix beam:  <http://w3id.org/beam/core#> .
@prefix pair:    <http://w3id.org/airiskkg/pair-ai#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix vann:  <http://purl.org/vocab/vann/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

<http://w3id.org/airiskkg/example/realworld-langchain-rag#> a owl:Ontology ;
    dct:title "Real-world Public RAG Application Use Case"@en ;
    dct:source <https://docs.langchain.com/oss/python/langchain/rag> ;
    dct:source <https://github.com/streamlit/example-app-langchain-rag> ;
    vann:preferredNamespacePrefix "rw" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/example/realworld-langchain-rag#" ;
    owl:imports <http://w3id.org/beam/core#> ,
        <http://w3id.org/airiskkg/pair-ai#> .

rw:RealWorldRAGSystem
    a beam:System ;
    rdfs:label "Public document Q&A RAG application"@en ;
    beam:hasResource
        rw:PublicQuestion ,
        rw:VectorStore ,
        rw:RetrievedContext ,
        rw:Prompt ,
        rw:LLM ,
        rw:Answer ;
    beam:hasProcess
        rw:RetrieveContext ,
        rw:BuildPrompt ,
        rw:GenerateAnswer .

rw:PublicQuestion
    a beam:Data ;
    rdfs:label "Public question"@en ;
    pair:playsRole pair:PublicUserInput ;
    pair:containsDataCategory pair:ExternalUserContent ;
    beam:usedBy rw:RetrieveContext ,
        rw:BuildPrompt .

rw:VectorStore
    a beam:Data ;
    rdfs:label "Vector store"@en ;
    pair:playsRole pair:VectorStore ;
    pair:containsDataCategory pair:Information ;
    beam:usedBy rw:RetrieveContext .

rw:RetrievedContext
    a beam:Data ;
    rdfs:label "Retrieved context"@en ;
    pair:playsRole pair:RetrievedContext ;
    pair:containsDataCategory pair:Information ;
    beam:usedBy rw:BuildPrompt .

rw:Prompt
    a beam:Data ;
    rdfs:label "RAG prompt"@en ;
    pair:playsRole pair:PromptTemplate ;
    pair:containsDataCategory pair:PromptInstruction ;
    pair:containsDataCategory pair:ExternalUserContent ;
    beam:usedBy rw:GenerateAnswer .

rw:LLM
    a beam:StatisticalModel ;
    rdfs:label "LLM"@en ;
    pair:playsRole pair:GenerativeModel ;
    beam:usedBy rw:GenerateAnswer .

rw:Answer
    a beam:Data ;
    rdfs:label "Answer"@en ;
    pair:playsRole pair:PublicUserFacingOutput ;
    pair:containsDataCategory pair:GeneratedContent .

rw:RetrieveContext
    a beam:Infer ;
    rdfs:label "Retrieve context"@en ;
    pair:playsRole pair:RetrievalStep ;
    beam:use rw:PublicQuestion ,
        rw:VectorStore ;
    beam:produce rw:RetrievedContext ;
    beam:inform rw:BuildPrompt .

rw:BuildPrompt
    a beam:Transform ;
    rdfs:label "Build prompt"@en ;
    pair:playsRole pair:PromptConstructionStep ;
    beam:use rw:PublicQuestion ,
        rw:RetrievedContext ;
    beam:produce rw:Prompt ;
    beam:inform rw:GenerateAnswer .

rw:GenerateAnswer
    a beam:Transform ;
    rdfs:label "Generate answer"@en ;
    pair:playsRole pair:GenerationStep ;
    beam:use rw:Prompt ,
        rw:LLM ;
    beam:produce rw:Answer .
