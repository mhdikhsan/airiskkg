@prefix bpmn: <https://sBPMN.github.io/2.0/classes#> .
@prefix bp:   <https://sBPMN.github.io/2.0/properties#> .
@prefix pair: <http://w3id.org/airiskkg/pair-ai#> .
@prefix sgr:  <http://tool4boxology.org/Boxology/> .
@prefix mas:  <http://w3id.org/airiskkg/example/meter-anomaly#> .
@prefix ec:   <http://w3id.org/airiskkg/example/energy-cs#> .
@prefix dpv:  <https://w3id.org/dpv#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


ec:ServiceCollaboration a bpmn:collaboration ;
    bp:name "Customer energy service" ;
    bp:contains ec:CustomerPool , ec:RetailerPool .

ec:CustomerPool a bpmn:participant ;
    bp:name "Customer" ;
    bp:processRef ec:CustomerJourney .

ec:RetailerPool a bpmn:participant ;
    bp:name "Northwind Energy" ;
    bp:processRef ec:ServiceProcess .


ec:CustomerJourney a bpmn:process ;
    bp:name "Ask about my energy account" ;
    bp:isExecutable false ;
    bp:contains ec:AskQuestion , ec:ReadAnswer .

ec:AskQuestion a bpmn:task ;
    bp:name "Ask a question" ;
    bp:outgoing ec:CFlow1 .

ec:ReadAnswer a bpmn:task ;
    bp:name "Read the answer" ;
    bp:incoming ec:CFlow1 .

ec:CFlow1 a bpmn:sequenceFlow ;
    bp:sourceRef ec:AskQuestion ; bp:targetRef ec:ReadAnswer .



ec:ServiceProcess a bpmn:process ;
    bp:name "Answer a customer enquiry" ;
    bp:isExecutable true ;
    bp:laneSet ec:ServiceLanes ;
    bp:contains ec:ReceiveEnquiry , ec:CheckReading , ec:CustomerService , ec:ReviewReply ,
                ec:SendReply , ec:LogInteraction .

ec:ServiceLanes a bpmn:laneSet ;
    bp:contains ec:AutomatedLane , ec:SupportLane .

ec:AutomatedLane a bpmn:lane ;
    bp:name "Self-service channel" ;
    bp:flowNodeRef ec:ReceiveEnquiry , ec:CheckReading , ec:CustomerService ,
                   ec:ReviewReply , ec:SendReply .

ec:SupportLane a bpmn:lane ;
    bp:name "Support operations" ;
    bp:flowNodeRef ec:LogInteraction .

ec:ReceiveEnquiry a bpmn:receiveTask ;
    bp:name "Receive the enquiry" ;
    bp:dataInputAssociation ec:EnquiryIn ;
    bp:outgoing ec:SFlow0 .


ec:CheckReading a bpmn:subProcess ;
    bp:name "Check the meter reading for anomalies" ;
    pair:refinedBy mas:AnomalySystem ;
    bp:incoming ec:SFlow0 ;
    bp:outgoing ec:SFlow1 ;
    bp:dataInputAssociation ec:ReadingToCheck .

ec:CustomerService a bpmn:subProcess ;
    bp:name "Customer service chatbot" ;
    pair:refinedBy sgr:graphrag-example ;
    bp:incoming ec:SFlow1 ;
    bp:outgoing ec:SFlow2 ;
    bp:dataInputAssociation ec:EnquiryToService ;
    bp:dataOutputAssociation ec:DraftOut ;
    bp:contains ec:UnderstandQuestion , ec:LookUpAccount , ec:ComposeReply .


ec:UnderstandQuestion a bpmn:serviceTask ;
    bp:name "Work out what is being asked" ;
    bp:outgoing ec:IFlow1 .

ec:LookUpAccount a bpmn:serviceTask ;
    bp:name "Look up account and tariff information" ;
    bp:incoming ec:IFlow1 ;
    bp:outgoing ec:IFlow2 .

ec:ComposeReply a bpmn:serviceTask ;
    bp:name "Compose a reply" ;
    bp:incoming ec:IFlow2 .

ec:IFlow1 a bpmn:sequenceFlow ;
    bp:sourceRef ec:UnderstandQuestion ; bp:targetRef ec:LookUpAccount .
ec:IFlow2 a bpmn:sequenceFlow ;
    bp:sourceRef ec:LookUpAccount ; bp:targetRef ec:ComposeReply .

ec:ReviewReply a bpmn:userTask ;
    bp:name "Check the reply before it goes out" ;
    bp:incoming ec:SFlow2 ;
    bp:outgoing ec:SFlow2b ;
    bp:dataInputAssociation ec:DraftIn ;
    bp:resourceRole ec:SupportAgent .

ec:DraftIn a bpmn:dataInputAssociation ;
    bp:sourceRef ec:DraftRef ; bp:targetRef ec:ReviewReply .

ec:SendReply a bpmn:sendTask ;
    bp:name "Send the reply" ;
    bp:incoming ec:SFlow2b ;
    bp:outgoing ec:SFlow3 .

ec:LogInteraction a bpmn:userTask ;
    bp:name "Log the interaction for quality review" ;
    bp:incoming ec:SFlow3 ;
    bp:resourceRole ec:SupportAgent .

ec:SupportAgent a bpmn:humanPerformer ;
    bp:name "Support agent" ;
    bp:resourceRef ec:SupportRole .

ec:SupportRole a bpmn:resource ;
    bp:name "Customer support agent" .

ec:SFlow0 a bpmn:sequenceFlow ;
    bp:sourceRef ec:ReceiveEnquiry ;  bp:targetRef ec:CheckReading .
ec:SFlow1 a bpmn:sequenceFlow ;
    bp:sourceRef ec:CheckReading ;    bp:targetRef ec:CustomerService .
ec:SFlow2 a bpmn:sequenceFlow ;
    bp:sourceRef ec:CustomerService ; bp:targetRef ec:ReviewReply .
ec:SFlow2b a bpmn:sequenceFlow ;
    bp:sourceRef ec:ReviewReply ;     bp:targetRef ec:SendReply .
ec:SFlow3 a bpmn:sequenceFlow ;
    bp:sourceRef ec:SendReply ;       bp:targetRef ec:LogInteraction .


ec:EnquiryMessage a bpmn:message ;
    bp:name "Account enquiry" .

ec:ReplyMessage a bpmn:message ;
    bp:name "Answer" .

ec:MFlow1 a bpmn:messageFlow ;
    bp:name "asks" ;
    bp:messageRef ec:EnquiryMessage ;
    bp:sourceRef ec:AskQuestion ;
    bp:targetRef ec:ReceiveEnquiry .

ec:MFlow2 a bpmn:messageFlow ;
    bp:name "answers" ;
    bp:messageRef ec:ReplyMessage ;
    bp:sourceRef ec:SendReply ;
    bp:targetRef ec:ReadAnswer .



ec:EnquiryRef a bpmn:dataObjectReference ;
    bp:name "Customer enquiry" ;
    bp:dataObjectRef ec:Enquiry .

ec:Enquiry a bpmn:dataObject ;
    bp:name "Customer enquiry" ;
    bp:itemSubjectRef ec:EnquiryItem .


ec:EnquiryItem a bpmn:itemDefinition ;
    bp:structureRef dpv:PersonalData .

ec:EnquiryIn a bpmn:dataInputAssociation ;
    bp:sourceRef ec:EnquiryRef ; bp:targetRef ec:ReceiveEnquiry .

ec:EnquiryToService a bpmn:dataInputAssociation ;
    bp:sourceRef ec:EnquiryRef ; bp:targetRef ec:CustomerService .

ec:MeterReadingRef a bpmn:dataObjectReference ;
    bp:name "Smart meter reading" ;
    bp:dataObjectRef ec:MeterReading .

ec:MeterReading a bpmn:dataObject ;
    bp:name "Smart meter reading" ;
    bp:itemSubjectRef ec:MeterReadingItem .

ec:MeterReadingItem a bpmn:itemDefinition ;
    bp:structureRef dpv:PersonalData .

ec:ReadingToCheck a bpmn:dataInputAssociation ;
    bp:sourceRef ec:MeterReadingRef ; bp:targetRef ec:CheckReading .

ec:DraftRef a bpmn:dataObjectReference ;
    bp:name "Drafted reply" .

ec:DraftOut a bpmn:dataOutputAssociation ;
    bp:sourceRef ec:CustomerService ; bp:targetRef ec:DraftRef .
