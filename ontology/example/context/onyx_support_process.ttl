# A business process that uses the bundled Onyx RAG chatbot.
#
# Load it beside ontology/example/onyx_rag_chatbot.ttl - the architecture alone
# is still a complete, assessable graph, and this adds the context it sits in.
#
# Five activities, two lanes, and three things the architecture cannot express:
#   - DraftAnswer is a serviceTask refined by that architecture: one box here,
#     a whole graph when expanded.
#   - ReviewAnswer is a userTask with a human performer, standing between the
#     drafted answer and the customer. No such step exists in the pipeline, and
#     none should - organisations put approvals in the process, not in the
#     inference path.
#   - The customer question is annotated ONCE here, by whoever owns the process,
#     with a DPV personal-data concept. Nothing in the architecture says it.
#
# It lives in a subdirectory deliberately: tests/conftest.py::example_path finds
# a bundled graph by the namespace it mints elements under, over a NON-recursive
# glob of ontology/example/. This file names the onyx namespace too, so sitting
# beside the architecture would make that lookup ambiguous and break every onyx
# suite for a reason unrelated to what they test.

@prefix bpmn:  <https://sBPMN.github.io/2.0/classes#> .
@prefix bp:    <https://sBPMN.github.io/2.0/properties#> .
@prefix pair:  <http://w3id.org/airiskkg/pair-ai#> .
@prefix onyx:  <http://w3id.org/airiskkg/example/onyx-danswer#> .
@prefix proc:  <http://w3id.org/airiskkg/spike/support-process#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

### Collaboration and pool

proc:SupportCollaboration a bpmn:collaboration ;
    bp:name "Customer support" ;
    bp:contains proc:SupportDesk .

proc:SupportDesk a bpmn:participant ;
    bp:name "Support desk" ;
    bp:processRef proc:AnswerQuestion .

proc:AnswerQuestion a bpmn:process ;
    bp:name "Answer a customer support question" ;
    bp:isExecutable true ;
    bp:laneSet proc:Lanes ;
    bp:contains proc:ReceiveQuestion , proc:DraftAnswer , proc:ReviewAnswer ,
                proc:SendAnswer , proc:CloseTicket ,
                proc:CustomerQuestionRef , proc:DraftedAnswerRef .

### Lanes - who is on each side of the boundary

proc:Lanes a bpmn:laneSet ;
    bp:contains proc:CustomerLane , proc:AgentLane .

proc:CustomerLane a bpmn:lane ;
    bp:name "Customer (general public)" ;
    bp:flowNodeRef proc:ReceiveQuestion .

proc:AgentLane a bpmn:lane ;
    bp:name "Support agent" ;
    bp:flowNodeRef proc:DraftAnswer , proc:ReviewAnswer , proc:SendAnswer , proc:CloseTicket .

### Activities

proc:ReceiveQuestion a bpmn:receiveTask ;
    bp:name "Receive question" ;
    bp:dataInputAssociation proc:QuestionIn ;
    bp:outgoing proc:Flow1 .

# The AI capability, collapsed to one box in the business diagram.
proc:DraftAnswer a bpmn:serviceTask ;
    bp:name "Draft an answer" ;
    pair:refinedBy onyx:OnyxSystem ;
    bp:incoming proc:Flow1 ;
    bp:outgoing proc:Flow2 ;
    bp:dataInputAssociation proc:QuestionToDraft ;
    bp:dataOutputAssociation proc:DraftOut .

# The AI drafts an answer TO the question, so the question is its input too.
proc:QuestionToDraft a bpmn:dataInputAssociation ;
    bp:sourceRef proc:CustomerQuestionRef ;
    bp:targetRef proc:DraftAnswer .

# The control the architecture cannot see.
proc:ReviewAnswer a bpmn:userTask ;
    bp:name "Review the drafted answer" ;
    bp:incoming proc:Flow2 ;
    bp:outgoing proc:Flow3 ;
    bp:dataInputAssociation proc:DraftIn ;
    bp:resourceRole proc:AgentReviewer .

proc:AgentReviewer a bpmn:humanPerformer ;
    bp:name "Support agent" ;
    bp:resourceRef proc:SupportAgentResource .

proc:SupportAgentResource a bpmn:resource ;
    bp:name "Support agent" .

proc:SendAnswer a bpmn:sendTask ;
    bp:name "Send the answer to the customer" ;
    bp:incoming proc:Flow3 ;
    bp:outgoing proc:Flow4 .

proc:CloseTicket a bpmn:userTask ;
    bp:name "Close the ticket" ;
    bp:incoming proc:Flow4 .

### Sequence flow

proc:Flow1 a bpmn:sequenceFlow ;
    bp:sourceRef proc:ReceiveQuestion ; bp:targetRef proc:DraftAnswer .
proc:Flow2 a bpmn:sequenceFlow ;
    bp:sourceRef proc:DraftAnswer ;     bp:targetRef proc:ReviewAnswer .
proc:Flow3 a bpmn:sequenceFlow ;
    bp:sourceRef proc:ReviewAnswer ;    bp:targetRef proc:SendAnswer .
proc:Flow4 a bpmn:sequenceFlow ;
    bp:sourceRef proc:SendAnswer ;      bp:targetRef proc:CloseTicket .

### Data - annotated once, here

proc:CustomerQuestionRef a bpmn:dataObjectReference ;
    bp:name "Customer question" ;
    bp:dataObjectRef proc:CustomerQuestion .

proc:CustomerQuestion a bpmn:dataObject ;
    bp:name "Customer question" ;
    bp:itemSubjectRef proc:CustomerQuestionItem .

proc:CustomerQuestionItem a bpmn:itemDefinition ;
    # The whole point: a business analyst says this once, in their own model.
    bp:structureRef dpv:PersonalData .

proc:QuestionIn a bpmn:dataInputAssociation ;
    bp:sourceRef proc:CustomerQuestionRef ;
    bp:targetRef proc:ReceiveQuestion .

proc:DraftedAnswerRef a bpmn:dataObjectReference ;
    bp:name "Drafted answer" .

proc:DraftOut a bpmn:dataOutputAssociation ;
    bp:sourceRef proc:DraftAnswer ;
    bp:targetRef proc:DraftedAnswerRef .

proc:DraftIn a bpmn:dataInputAssociation ;
    bp:sourceRef proc:DraftedAnswerRef ;
    bp:targetRef proc:ReviewAnswer .
