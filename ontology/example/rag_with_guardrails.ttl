@prefix beam:  <http://w3id.org/beam/core#> .
@prefix pair:  <http://w3id.org/airiskkg/pair-ai#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix local: <http://w3id.org/airiskkg/local#> .

local:system a beam:System ;
    rdfs:label "RAG chatbot with guardrails" ;
    beam:hasProcess
        local:inputGuardrail ,
        local:retrieval ,
        local:promptConstruction ,
        local:generation ,
        local:outputGuardrail ;
    beam:hasResource
        local:userQuery ,
        local:guardrailDecision ,
        local:vectorStore ,
        local:retrievedContext ,
        local:prompt ,
        local:llm ,
        local:llmResponse ,
        local:sanitizedResponse .

# --- user input ------------------------------------------------------------
local:userQuery a beam:Data ;
    rdfs:label "User Query" ;
    pair:playsRole pair:UserInput .

# --- input guardrail: screens the query, gates the pipeline ----------------
local:inputGuardrail a beam:Process ;
    rdfs:label "Input Guardrail" ;
    pair:playsRole pair:InputGuardrailStep ;
    beam:use local:userQuery ;
    beam:produce local:guardrailDecision ;
    beam:inform local:generation .

local:guardrailDecision a beam:Data ;
    rdfs:label "Guardrail Decision" ;
    pair:playsRole pair:GuardrailDecision .

# --- retrieval leg (drives RAG + Vector-based IR) --------------------------
local:vectorStore a beam:Data ;
    rdfs:label "Vector Store" ;
    pair:playsRole pair:VectorStore .

local:retrieval a beam:Process ;
    rdfs:label "Retrieval Step" ;
    pair:playsRole pair:RetrievalStep ;
    beam:use local:userQuery ;
    beam:use local:vectorStore ;
    beam:use local:guardrailDecision ;
    beam:produce local:retrievedContext .

local:retrievedContext a beam:Data ;
    rdfs:label "Retrieved Context" ;
    pair:playsRole pair:RetrievedContext .

# --- prompt construction ---------------------------------------------------
local:promptConstruction a beam:Transform, beam:Process ;
    rdfs:label "Prompt Construction" ;
    pair:playsRole pair:PromptConstructionStep ;
    beam:use local:userQuery ;
    beam:use local:retrievedContext ;
    beam:produce local:prompt .

local:prompt a beam:Data ;
    rdfs:label "Prompt" ;
    pair:playsRole pair:PromptTemplate .

# --- generation ------------------------------------------------------------
local:llm a beam:StatisticalModel ;
    rdfs:label "Foundation LLM" ;
    pair:playsRole pair:FoundationLLM .

local:generation a beam:Infer, beam:Process ;
    rdfs:label "Generation Step" ;
    pair:playsRole pair:GenerationStep ;
    beam:use local:prompt ;
    beam:use local:llm ;
    beam:produce local:llmResponse ;
    beam:inform local:outputGuardrail .

local:llmResponse a beam:Data ;
    rdfs:label "LLM Response" ;
    pair:playsRole pair:LLMResponse .

# --- output guardrail: screens the response --------------------------------
local:outputGuardrail a beam:Process ;
    rdfs:label "Output Guardrail" ;
    pair:playsRole pair:OutputGuardrailStep ;
    beam:use local:llmResponse ;
    beam:produce local:sanitizedResponse .

local:sanitizedResponse a beam:Data ;
    rdfs:label "Sanitized Response" ;
    pair:playsRole pair:SanitizedOutput .
