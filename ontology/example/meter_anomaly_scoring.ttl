@prefix beam: <http://w3id.org/beam/core#> .
@prefix pair: <http://w3id.org/airiskkg/pair-ai#> .
@prefix mas:  <http://w3id.org/airiskkg/example/meter-anomaly#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

mas:AnomalySystem a beam:Element , beam:System ;
    rdfs:label "Meter Anomaly Scoring" ;
    beam:description "Scores incoming smart-meter readings for anomalies and raises a case for review." ;
    beam:hasProcess mas:Ingest , mas:Score , mas:LogScore , mas:Monitor ;
    beam:hasResource mas:Reading , mas:CleanReading , mas:Model , mas:Score_Result ,
                     mas:ScoreLog , mas:Baseline , mas:Alert .

mas:Reading a beam:Data ;
    rdfs:label "Smart meter reading" ;
    pair:playsRole pair:PredictionRequest ;
    beam:usedBy mas:Ingest .

mas:Ingest a beam:Transform , beam:Process ;
    rdfs:label "Clean and window the readings" ;
    pair:playsRole pair:PreprocessingStep ;
    beam:use mas:Reading ;
    beam:produce mas:CleanReading ;
    beam:inform mas:Score .

mas:CleanReading a beam:Data ;
    rdfs:label "Windowed reading" ;
    pair:playsRole pair:PreprocessedData , pair:PredictionRequest .

mas:Model a beam:StatisticalModel ;
    rdfs:label "Anomaly model" ;
    pair:playsRole pair:Model , pair:ExternalModel ;
    beam:usedBy mas:Score .

mas:Score a beam:Infer , beam:Process ;
    rdfs:label "Score for anomaly" ;
    pair:playsRole pair:PredictionStep ;
    beam:use mas:CleanReading , mas:Model ;
    beam:produce mas:Score_Result ;
    beam:inform mas:LogScore , mas:Monitor .

mas:Score_Result a beam:Data ;
    rdfs:label "Anomaly score" ;
    pair:playsRole pair:PredictionResult , pair:UserFacingOutput .

mas:LogScore a beam:Process ;
    rdfs:label "Log the score" ;
    pair:playsRole pair:LoggingStep ;
    beam:use mas:Score_Result ;
    beam:produce mas:ScoreLog .

mas:ScoreLog a beam:Data ;
    rdfs:label "Scoring log" ;
    pair:playsRole pair:PredictionLog .

mas:Baseline a beam:Data ;
    rdfs:label "Expected consumption baseline" ;
    pair:playsRole pair:MonitoringBaseline ;
    beam:usedBy mas:Monitor .

mas:Monitor a beam:Process ;
    rdfs:label "Watch for drift" ;
    pair:playsRole pair:MonitoringStep ;
    beam:use mas:Score_Result , mas:Baseline ;
    beam:produce mas:Alert .

mas:Alert a beam:Data ;
    rdfs:label "Drift alert" ;
    pair:playsRole pair:Alert .
