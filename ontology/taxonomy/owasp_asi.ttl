@prefix asi:   <http://w3id.org/airiskkg/taxonomy/owasp-asi#> .
@prefix owasp: <http://w3id.org/airiskkg/taxonomy/owasp-llm#> .
@prefix nexus: <http://w3id.org/airiskkg/taxonomy/nexus#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<http://w3id.org/airiskkg/taxonomy/owasp-asi#> a owl:Ontology ;
    rdfs:label "OWASP Agentic Top 10 Subset for AI Risk KG" ;
    dct:title "OWASP Agentic Top 10 Subset for AI Risk KG" ;
    dct:description """
    RDF representation of selected OWASP Top 10 for Agentic Applications 2026 (ASI)
    entries, for the agentic layer of graph-pattern-based AI risk assessment.

    All ten entries are catalogued. Nine carry mechanisms and conditions (in
    ontology/patterns/risk_mechanisms.ttl), because a
    risk pattern derives from each: their structural signature is something a
    submitted architecture graph can show. ASI10 Rogue Agents is catalogued only. It
    is defined by behavioural divergence after deployment, which has no shape in a
    represented graph; a risk pattern for it would fire on every agent, which breaks
    candidate framing rather than supporting it.

    OWASP frames ASI entries as building on the LLM Top 10. Those ASI <-> LLM links
    are NOT asserted here: IBM AI Atlas Nexus publishes a manually curated SSSOM set
    for them (owasp_asi2owasp_llm.tsv), so they live in taxonomy_mapping.ttl Section 1
    with the upstream predicates and confidences, rather than being re-derived.
    nexus:tag carries the upstream entry id for each entry.
    """ ;

    # --- Licensing -----------------------------------------------------------
    # Same posture as ontology/taxonomy/owasp_llm.ttl. This file is PAIR-AI's own
    # work under CC BY 4.0. It REFERENCES the OWASP Top 10 for Agentic Applications
    # 2026, which is published under CC BY-SA 4.0; ShareAlike binds adaptations, so
    # only entry identifiers, numbering, and links to the official material are
    # reused - facts and short names, not protected expression. Every
    # skos:definition below is written from scratch for PAIR-AI's structural model
    # and is NOT a copy or close paraphrase of OWASP's descriptions, mitigation
    # lists, or attack scenarios. The risk mechanisms and risk conditions are
    # PAIR-AI's and live in ontology/patterns/risk_mechanisms.ttl.
    #
    # Anyone extending this file must keep that discipline: reference OWASP, never
    # reproduce its prose. See /NOTICE.md.
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:rights "PAIR-AI original modelling work, CC BY 4.0. Entry identifiers and numbering are referenced from the OWASP Top 10 for Agentic Applications 2026 (OWASP GenAI Security Project - Agentic Security Initiative), which is licensed CC BY-SA 4.0 - see https://creativecommons.org/licenses/by-sa/4.0/. Changes were made: only identifiers, numbering, and links are reused; all definitions here are original."@en ;
    dct:bibliographicCitation "OWASP GenAI Security Project. (2025). OWASP Top 10 for Agentic Applications 2026 (Version 2026). https://genai.owasp.org/"@en ;

    dct:source <https://genai.owasp.org/> ;
    owl:imports <http://w3id.org/airiskkg/taxonomy/owasp-llm#> .

asi:OWASP_Agentic_Top_10_2026 a nexus:RiskTaxonomy, skos:ConceptScheme ;
    skos:prefLabel "OWASP Top 10 for Agentic Applications" ;
    rdfs:seeAlso <https://genai.owasp.org/resource/owasp-top-10-for-agentic-applications-for-2026/> ;
    dct:description "A taxonomy of security threats specific to applications where an AI agent plans, decides, and acts across multiple steps and systems." ;
    owl:versionInfo "2026" .

asi:asi01-agent-goal-hijack a nexus:Risk ;
    skos:prefLabel "ASI01:2026 Agent Goal Hijack" ;
    skos:definition "The objective an agent is pursuing is redirected by content it consumed rather than by its principal, so every step that follows is faithful execution of the wrong goal." ;
    skos:inScheme asi:OWASP_Agentic_Top_10_2026 ;
    skos:topConceptOf asi:OWASP_Agentic_Top_10_2026 ;
    nexus:isDefinedByTaxonomy asi:OWASP_Agentic_Top_10_2026 ;
    nexus:tag "asi01-agent-goal-hijack" ;
    rdfs:seeAlso <https://genai.owasp.org/resource/owasp-top-10-for-agentic-applications-for-2026/> .

asi:asi02-tool-misuse a nexus:Risk ;
    skos:prefLabel "ASI02:2026 Tool Misuse and Exploitation" ;
    skos:definition "An agent calls a tool it is allowed to call, but for the wrong purpose, too often, or with arguments nobody meant, because nothing between the decision and the call limits what the call may do." ;
    skos:inScheme asi:OWASP_Agentic_Top_10_2026 ;
    skos:topConceptOf asi:OWASP_Agentic_Top_10_2026 ;
    nexus:isDefinedByTaxonomy asi:OWASP_Agentic_Top_10_2026 ;
    nexus:tag "asi02-tool-misuse-and-exploitation" ;
    rdfs:seeAlso <https://genai.owasp.org/resource/owasp-top-10-for-agentic-applications-for-2026/> .

asi:asi06-memory-and-context-poisoning a nexus:Risk ;
    skos:prefLabel "ASI06:2026 Memory & Context Poisoning" ;
    skos:definition "Content an agent retains for later reuse is corrupted, so a single tainted write keeps steering reasoning across turns and sessions after the original source is gone." ;
    skos:inScheme asi:OWASP_Agentic_Top_10_2026 ;
    skos:topConceptOf asi:OWASP_Agentic_Top_10_2026 ;
    nexus:isDefinedByTaxonomy asi:OWASP_Agentic_Top_10_2026 ;
    nexus:tag "asi06-memory-and-context-poisoning" ;
    rdfs:seeAlso <https://genai.owasp.org/resource/owasp-top-10-for-agentic-applications-for-2026/> .

asi:asi07-insecure-inter-agent-communication a nexus:Risk ;
    skos:prefLabel "ASI07:2026 Insecure Inter-Agent Communication" ;
    skos:definition "One agent accepts work from another on the strength of the message alone, so a message that is forged, replayed, or simply wrong is acted on as though the sending agent's authority had been established." ;
    skos:inScheme asi:OWASP_Agentic_Top_10_2026 ;
    skos:topConceptOf asi:OWASP_Agentic_Top_10_2026 ;
    nexus:isDefinedByTaxonomy asi:OWASP_Agentic_Top_10_2026 ;
    nexus:tag "asi07-insecure-inter-agent-communication" ;
    rdfs:seeAlso <https://genai.owasp.org/resource/owasp-top-10-for-agentic-applications-for-2026/> .

asi:asi03-identity-and-privilege-abuse a nexus:Risk ;
    skos:prefLabel "ASI03:2026 Identity & Privilege Abuse" ;
    skos:definition "An agent acts with authority it was handed rather than authority scoped to its task, so whoever can steer the agent inherits that authority as well." ;
    skos:inScheme asi:OWASP_Agentic_Top_10_2026 ;
    skos:topConceptOf asi:OWASP_Agentic_Top_10_2026 ;
    nexus:isDefinedByTaxonomy asi:OWASP_Agentic_Top_10_2026 ;
    nexus:tag "asi03-identity-and-privilege-abuse" ;
    rdfs:seeAlso <https://genai.owasp.org/resource/owasp-top-10-for-agentic-applications-for-2026/> .

asi:asi04-agentic-supply-chain a nexus:Risk ;
    skos:prefLabel "ASI04:2026 Agentic Supply Chain Vulnerabilities" ;
    skos:definition "An agent assembles part of itself at run time from pieces others supply, so whoever can alter one of those pieces can steer the agent from inside, without passing through any input its users give it." ;
    skos:inScheme asi:OWASP_Agentic_Top_10_2026 ;
    skos:topConceptOf asi:OWASP_Agentic_Top_10_2026 ;
    nexus:isDefinedByTaxonomy asi:OWASP_Agentic_Top_10_2026 ;
    nexus:tag "asi04-agentic-supply-chain-vulnerabilities" ;
    rdfs:seeAlso <https://genai.owasp.org/resource/owasp-top-10-for-agentic-applications-for-2026/> .

asi:asi05-unexpected-code-execution a nexus:Risk ;
    skos:prefLabel "ASI05:2026 Unexpected Code Execution (RCE)" ;
    skos:definition "Text an agent produces is run as code, a command or a serialized object, so a manipulated or mistaken output becomes execution on the host." ;
    skos:inScheme asi:OWASP_Agentic_Top_10_2026 ;
    skos:topConceptOf asi:OWASP_Agentic_Top_10_2026 ;
    nexus:isDefinedByTaxonomy asi:OWASP_Agentic_Top_10_2026 ;
    nexus:tag "asi05-unexpected-code-execution" ;
    rdfs:seeAlso <https://genai.owasp.org/resource/owasp-top-10-for-agentic-applications-for-2026/> .

asi:asi08-cascading-failures a nexus:Risk ;
    skos:prefLabel "ASI08:2026 Cascading Failures" ;
    skos:definition "An error made by one agent is handed on and acted on by the next, and by the one after, so its effects multiply along the chain before any step questions it." ;
    skos:inScheme asi:OWASP_Agentic_Top_10_2026 ;
    skos:topConceptOf asi:OWASP_Agentic_Top_10_2026 ;
    nexus:isDefinedByTaxonomy asi:OWASP_Agentic_Top_10_2026 ;
    nexus:tag "asi08-cascading-failures" ;
    rdfs:seeAlso <https://genai.owasp.org/resource/owasp-top-10-for-agentic-applications-for-2026/> .

asi:asi09-human-agent-trust-exploitation a nexus:Risk ;
    skos:prefLabel "ASI09:2026 Human-Agent Trust Exploitation" ;
    skos:definition "A person approves or acts on what an agent presents because the agent presented it, so a flawed or manipulated recommendation passes through the human check meant to stop it." ;
    skos:inScheme asi:OWASP_Agentic_Top_10_2026 ;
    skos:topConceptOf asi:OWASP_Agentic_Top_10_2026 ;
    nexus:isDefinedByTaxonomy asi:OWASP_Agentic_Top_10_2026 ;
    nexus:tag "asi09-human-agent-trust-exploitation" ;
    rdfs:seeAlso <https://genai.owasp.org/resource/owasp-top-10-for-agentic-applications-for-2026/> .

asi:asi10-rogue-agents a nexus:Risk ;
    skos:prefLabel "ASI10:2026 Rogue Agents" ;
    skos:definition "An agent goes on working inside the access it was given while what it does drifts away from what it was built to do." ;
    rdfs:comment "Catalogued, not detected. The entry is defined by behavioural divergence after deployment, which a represented architecture cannot show, so no risk pattern derives from it."@en ;
    skos:inScheme asi:OWASP_Agentic_Top_10_2026 ;
    skos:topConceptOf asi:OWASP_Agentic_Top_10_2026 ;
    nexus:isDefinedByTaxonomy asi:OWASP_Agentic_Top_10_2026 ;
    nexus:tag "asi10-rogue-agents" ;
    rdfs:seeAlso <https://genai.owasp.org/resource/owasp-top-10-for-agentic-applications-for-2026/> .
