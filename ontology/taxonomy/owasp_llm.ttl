@prefix owasp: <http://w3id.org/airiskkg/taxonomy/owasp-llm#> .
@prefix nexus: <http://w3id.org/airiskkg/taxonomy/nexus#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<http://w3id.org/airiskkg/taxonomy/owasp-llm#> a owl:Ontology ;
    rdfs:label "OWASP LLM Top 10 Subset for AI Risk KG" ;
    dct:title "OWASP LLM Top 10 Subset for AI Risk KG" ;
    dct:description """
    RDF representation of selected OWASP Top 10 for Large Language Model Applications
    2025 entries for AI Risk KG. OWASP GenAI Security is used as the primary
    generative-AI/LLM application security taxonomy baseline; AI Atlas Nexus
    remains a secondary adaptation and alignment source.
    """ ;

    # --- Licensing -----------------------------------------------------------
    # This file is PAIR-AI's own work and is released under CC BY 4.0, like the
    # rest of the repository (see /LICENSE).
    #
    # It REFERENCES the OWASP Top 10 for LLM Applications 2025, which is
    # published under CC BY-SA 4.0. ShareAlike binds adaptations, so this file
    # deliberately avoids becoming one: it reuses only entry identifiers,
    # numbering, and links to the official pages - facts and short names, not
    # protected expression. Every skos:definition below is written from scratch
    # for PAIR-AI's structural model and is NOT a copy or close paraphrase of
    # OWASP's descriptions, mitigation lists, or attack scenarios. The risk
    # mechanisms and risk conditions are PAIR-AI's and live in
    # ontology/patterns/risk_mechanisms.ttl, under the same discipline.
    #
    # Anyone extending this file must keep that discipline: reference OWASP,
    # never reproduce its prose. Copying their wording would pull CC BY-SA
    # ShareAlike onto this file and conflict with the repository's CC BY 4.0.
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:rights "PAIR-AI original modelling work, CC BY 4.0. Entry identifiers and numbering are referenced from the OWASP Top 10 for LLM Applications 2025 (OWASP GenAI Security Project), which is licensed CC BY-SA 4.0 - see https://creativecommons.org/licenses/by-sa/4.0/. Changes were made: only identifiers, numbering, and links are reused; all definitions here are original. The nexus:tag values are upstream entry ids from IBM AI Atlas Nexus (Apache 2.0), reused as identifiers only."@en ;
    dct:bibliographicCitation "OWASP GenAI Security Project. (2024). OWASP Top 10 for LLM Applications 2025 (Version 2025). https://genai.owasp.org/"@en ;

    dct:source <https://github.com/owasp/www-project-top-10-for-large-language-model-applications> ;
    dct:source <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/knowledge_graph/owasp_llm_2.0_data.yaml> .

# nexus:tag values are the upstream AI Atlas Nexus entry ids; rdfs:seeAlso
# points to the official OWASP entry page.

owasp:OWASP_LLM_Top_10_2025 a nexus:RiskTaxonomy, skos:ConceptScheme ;
    skos:prefLabel "OWASP Top 10 for Large Language Model Applications" ;
    dct:description "A taxonomy of critical security vulnerabilities and risks in LLM applications." ;
    owl:versionInfo "2.0" .

owasp:llm01-prompt-injection a nexus:Risk ;
    skos:prefLabel "LLM01:2025 Prompt Injection" ;
    skos:definition "Content supplied by a user, a retrieved document, or a tool is interpreted as instruction, steering the model away from its intended task." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:topConceptOf owasp:OWASP_LLM_Top_10_2025 ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm01-prompt-injection" ;
    rdfs:seeAlso <https://genai.owasp.org/llmrisk/llm01-prompt-injection/> .

owasp:llm02-sensitive-information-disclosure a nexus:Risk ;
    skos:prefLabel "LLM02:2025 Sensitive Information Disclosure" ;
    skos:definition "Personal, confidential or security-relevant content a system handles reaches someone who should not see it, through what the model returns or what the application around it records and passes on." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:topConceptOf owasp:OWASP_LLM_Top_10_2025 ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm022025-sensitive-information-disclosure" ;
    rdfs:seeAlso <https://genai.owasp.org/llmrisk/llm022025-sensitive-information-disclosure/> .

owasp:llm03-supply-chain a nexus:Risk ;
    skos:prefLabel "LLM03:2025 Supply Chain" ;
    skos:definition "A model, dataset, library or hosting service built by someone else is taken into the system on trust, so a defect or tampering introduced upstream arrives with it." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:topConceptOf owasp:OWASP_LLM_Top_10_2025 ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm032025-supply-chain" ;
    rdfs:seeAlso <https://genai.owasp.org/llmrisk/llm032025-supply-chain/> .

owasp:llm04-data-and-model-poisoning a nexus:Risk ;
    skos:prefLabel "LLM04:2025 Data and Model Poisoning" ;
    skos:definition "Someone shapes what a model learns or retrieves by planting content in the data it is trained, tuned or indexed on, so the model later behaves as that content steers it." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:topConceptOf owasp:OWASP_LLM_Top_10_2025 ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm042025-data-and-model-poisoning" ;
    rdfs:seeAlso <https://genai.owasp.org/llmrisk/llm042025-data-and-model-poisoning/> .

owasp:llm05-improper-output-handling a nexus:Risk ;
    skos:prefLabel "LLM05:2025 Improper Output Handling" ;
    skos:definition "What a model generates is handed to a reader, a browser, a database or another program as if it were safe, although the model can be made to produce anything." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:topConceptOf owasp:OWASP_LLM_Top_10_2025 ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm052025-improper-output-handling" ;
    rdfs:seeAlso <https://genai.owasp.org/llmrisk/llm052025-improper-output-handling/> .

owasp:llm06-excessive-agency a nexus:Risk ;
    skos:prefLabel "LLM06:2025 Excessive Agency" ;
    skos:definition "A model's output can set off actions on other systems, and the reach of those actions is wider than the task needs or than anyone reviews." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:topConceptOf owasp:OWASP_LLM_Top_10_2025 ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm062025-excessive-agency" ;
    rdfs:seeAlso <https://genai.owasp.org/llmrisk/llm062025-excessive-agency/> .

owasp:llm07-system-prompt-leakage a nexus:Risk ;
    skos:prefLabel "LLM07:2025 System Prompt Leakage" ;
    skos:definition "The instructions an application gives its model out of the user's sight, and whatever they contain, can be drawn out by the people the model answers." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:topConceptOf owasp:OWASP_LLM_Top_10_2025 ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm072025-system-prompt-leakage" ;
    rdfs:seeAlso <https://genai.owasp.org/llmrisk/llm072025-system-prompt-leakage/> .

owasp:llm08-vector-and-embedding-weaknesses a nexus:Risk ;
    skos:prefLabel "LLM08:2025 Vector and Embedding Weaknesses" ;
    skos:definition "How a system embeds, indexes, partitions, or ranks vectors becomes a risk surface for the retrieval-augmented answers built on it." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:topConceptOf owasp:OWASP_LLM_Top_10_2025 ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm082025-vector-and-embedding-weaknesses" ;
    rdfs:seeAlso <https://genai.owasp.org/llmrisk/llm082025-vector-and-embedding-weaknesses/> .

owasp:llm09-misinformation a nexus:Risk ;
    skos:prefLabel "LLM09:2025 Misinformation" ;
    skos:definition "A generated answer is wrong or unsupported, yet is presented with enough fluency and confidence that a reader treats it as reliable." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:topConceptOf owasp:OWASP_LLM_Top_10_2025 ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm092025-misinformation" ;
    rdfs:seeAlso <https://genai.owasp.org/llmrisk/llm092025-misinformation/> .

owasp:llm10-unbounded-consumption a nexus:Risk ;
    skos:prefLabel "LLM10:2025 Unbounded Consumption" ;
    skos:definition "LLM applications may allow excessive or uncontrolled inference, causing cost, availability, or abuse risks." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:topConceptOf owasp:OWASP_LLM_Top_10_2025 ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm102025-unbounded-consumption" ;
    rdfs:seeAlso <https://genai.owasp.org/llmrisk/llm102025-unbounded-consumption/> .
