eticas:measurement-validity a nexus:RiskGroup ;
    skos:prefLabel "Measurement validity"@en ;
    skos:definition "For systems that produce evaluative judgements or scores, the risk that the output does not validly measure the criterion, construct, or outcome it purports to assess. Distinct from hallucination (factual fabrication) and output-inconsistency (same-input variability) — a single output may be stable, internally consistent, and factually accurate yet still fail to measure what it claims. Especially salient for assessment, scoring, grading, and ranking systems, where the output IS a measurement. Follows the standard validity framework — content, criterion, construct, external, consequential validity (Lissitz & Samuelsen, 2007); subcategories below operationalise specific validity types as audit-tractable risks."@en ;
    skos:broader eticas:reliability ;
    nexus:isPartOf eticas:reliability ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    eticasont:maturity "emerging" ;
    dct:source "Eticas (Wiselook engagement, 2026-06; restructured Usman Gohar, July 2026)" .

eticas:monitoring-evaluation-gaps a nexus:Risk ;
    skos:prefLabel "Monitoring and evaluation gaps"@en ;
    skos:altLabel "Monitoring, feedback, evaluation"@en ;
    skos:definition "Lack of ongoing monitoring that renders datasets obsolete and system outputs unreliable, including absence of feedback mechanisms and periodic evaluation."@en ;
    skos:broader eticas:governance-compliance ;
    nexus:isPartOf eticas:governance-compliance ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    eticasont:scope "ALL" ;
    eticasont:maturity "emerging" ;
    eticasont:lifecycleStage "post-processing" ;
    dct:source "HRA" ;
    skos:closeMatch dpvai:MonitoringControl ;
    skos:closeMatch aiact:article-72 .

eticas:multi-step-actions a nexus:Risk ;
    skos:prefLabel "Multi-step autonomous actions"@en ;
    skos:definition "AI systems that plan and execute sequences of actions, where errors in early steps cascade unpredictably through later steps."@en ;
    skos:broader eticas:autonomy-system-autonomy ;
    nexus:isPartOf eticas:autonomy-system-autonomy ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    eticasont:scope "LLM" ;
    eticasont:maturity "emerging" ;
    eticasont:lifecycleStage "post-processing" ;
    skos:relatedMatch mit:subdomain-7-6 .

eticas:org-preparedness a nexus:Risk ;
    skos:prefLabel "Organisational preparedness"@en ;
    skos:definition "The deploying organisation lacks the governance maturity, leadership engagement, change management capacity, staff competency, or cultural receptivity needed to absorb an AI system into its operations."@en ;
    skos:broader eticas:organisational-readiness ;
    nexus:isPartOf eticas:organisational-readiness ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    eticasont:scope "ALL" ;
    eticasont:maturity "emerging" ;
    eticasont:lifecycleStage "pre-processing" ;
    skos:closeMatch aiact:article-4 .

eticas:organisational-readiness a nexus:RiskGroup ;
    skos:prefLabel "Organisational Readiness"@en ;
    skos:altLabel "Deployment Readiness"@en ;
    skos:altLabel "Integration Readiness"@en ;
    skos:altLabel "Sociotechnical Fit"@en ;
    skos:definition "The risk that an AI system fails to deliver value not because of model performance issues but because it does not fit the organisational, technical, or human context into which it is deployed. This includes insufficient organisational capacity to absorb the technology, workflow incompatibility, interoperability failures with existing systems, and lack of sustainable maintenance capability."@en ;
    skos:topConceptOf <https://taxonomy.eticas.ai/risk/scheme> ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    eticasont:scope "ALL" ;
    eticasont:maturity "emerging" ;
    eticasont:perspective "operational viability" ;
    eticasont:lifecycleStage "post-processing" ;
    eticasont:lifecycleStage "pre-processing" ;
    skos:closeMatch aiact:article-4 .

eticas:out-of-distribution-robustness a nexus:Risk ;
    skos:prefLabel "Out-of-distribution robustness"@en ;
    skos:definition "Unpredictable behaviour or failure when the system is exposed to inputs outside the distribution of its training data."@en ;
