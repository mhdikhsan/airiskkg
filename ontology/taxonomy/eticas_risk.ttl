    eticasont:maturity "established" ;
    eticasont:lifecycleStage "post-processing" .

eticas:output-inconsistency a nexus:Risk ;
    skos:prefLabel "Output inconsistency"@en ;
    skos:definition "Inconsistent results across similar inputs and contexts, undermining reproducibility and user trust."@en ;
    skos:broader eticas:reliability-output-quality ;
    nexus:isPartOf eticas:reliability-output-quality ;
