    eticasont:lifecycleStage "pre-processing" ;
    skos:closeMatch aiact:article-11 .

eticas:privacy-collection-use a nexus:RiskGroup ;
    skos:prefLabel "Data collection & use"@en ;
    skos:definition "Risks from how personal data is collected, processed, and repurposed."@en ;
    skos:broader eticas:privacy-confidentiality ;
    nexus:isPartOf eticas:privacy-confidentiality ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
