eticas:function-calling-hallucination a nexus:Risk ;
    skos:prefLabel "Function calling hallucination"@en ;
    skos:definition "The agent generates incorrect or malformed function calls — for example, by specifying wrong parameters, calling non-existent tools, or misinterpreting tool schemas — causing downstream failures or unintended system interactions."@en ;
    skos:broader eticas:agentic-actions-tool-use ;
    nexus:isPartOf eticas:agentic-actions-tool-use ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    eticasont:scope "LLM" ;
    eticasont:maturity "established" ;
    eticasont:lifecycleStage "post-processing" .

eticas:geographic-cultural-language-skew a nexus:Risk ;
    skos:prefLabel "Geographic, cultural, or language skew"@en ;
    skos:definition "Systematic performance differences across geographies, cultures, or languages, often resulting from training data that overrepresents certain regions or linguistic traditions."@en ;
    skos:broader eticas:bias-representational-harm ;
    nexus:isPartOf eticas:bias-representational-harm ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    eticasont:scope "ALL" ;
    eticasont:maturity "established" ;
    eticasont:lifecycleStage "in-processing" ;
    eticasont:lifecycleStage "post-processing" ;
    eticasont:lifecycleStage "pre-processing" ;
    skos:closeMatch dpvai:NonRepresentativeSamplingBias .

eticas:governance a nexus:RiskGroup ;
    skos:prefLabel "Governance"@en ;
    skos:altLabel "Accountability"@en ;
    skos:altLabel "Governance & Accountability"@en ;
    skos:definition "The risk that an AI system lacks adequate structures, policies, or accountability mechanisms to oversee its design, deployment, and use. Weak governance can lead to unclear responsibilities, poor documentation, limited auditability, and failure to align with legal, ethical, or organizational standards."@en ;
    skos:topConceptOf <https://taxonomy.eticas.ai/risk/scheme> ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    eticasont:scope "ALL" ;
    eticasont:maturity "established" ;
    eticasont:perspective "governance & compliance" ;
    eticasont:lifecycleStage "in-processing" ;
    eticasont:lifecycleStage "post-processing" ;
    eticasont:lifecycleStage "pre-processing" ;
    skos:closeMatch mit:subdomain-6-5 ;
    skos:closeMatch dpvai:Governance ;
    skos:closeMatch aiact:article-17 ;
    skos:relatedMatch nist:value-chain-and-component-integration .

eticas:governance-accountability a nexus:RiskGroup ;
    skos:prefLabel "Accountability"@en ;
    skos:definition "Risks from unclear allocation of responsibility, weak human oversight, and inadequate attribution mechanisms for AI system decisions and their adverse impacts."@en ;
    skos:broader eticas:governance ;
    nexus:isPartOf eticas:governance ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> .

eticas:governance-compliance a nexus:RiskGroup ;
    skos:prefLabel "Compliance & process"@en ;
    skos:definition "Risks from gaps in organisational processes for ongoing oversight, compliance, and lifecycle management of AI systems — including regulatory compliance, change management, data governance, monitoring and evaluation, remediation of failures, and incident response."@en ;
    skos:broader eticas:governance ;
    nexus:isPartOf eticas:governance ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    skos:closeMatch dpvai:RiskManagement ;
    skos:closeMatch aiact:article-17 .

eticas:governance-documentation a nexus:RiskGroup ;
    skos:prefLabel "Documentation & auditability"@en ;
    skos:definition "Risks from incomplete, inaccessible, or absent documentation and audit trails."@en ;
    skos:broader eticas:governance ;
    nexus:isPartOf eticas:governance ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    skos:closeMatch aiact:article-11 .

eticas:graceful-degradation a nexus:Risk ;
    skos:prefLabel "Graceful degradation"@en ;
    skos:definition "Absence of defined degradation pathways that allow the system to maintain partial function when components fail, connectivity is lost, or resources are constrained."@en ;
    skos:broader eticas:reliability-resilience ;
    nexus:isPartOf eticas:reliability-resilience ;
