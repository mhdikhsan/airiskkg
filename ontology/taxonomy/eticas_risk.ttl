<https://taxonomy.eticas.ai/risk/scheme> a nexus:RiskTaxonomy, skos:ConceptScheme ;
    skos:prefLabel "Eticas AI Risk Taxonomy"@en ;
    dct:description "A unified AI risk taxonomy for use across Eticas audit methodologies, assessment frameworks, and reporting outputs."@en ;
    dct:publisher "Eticas" .

eticas:agentic-actions-tool-use a nexus:RiskGroup ;
    skos:prefLabel "Autonomous Actions and Tool Use"@en ;
    skos:definition "Risks from the agent taking real-world actions through external tools, APIs, and services, including being granted excessive permissions, executing unnecessary or out-of-scope actions, bypassing human oversight, or consuming disproportionate resources."@en ;
    skos:broader eticas:agentic-ai ;
    nexus:isPartOf eticas:agentic-ai ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> .

eticas:agentic-ai a nexus:RiskGroup ;
    skos:prefLabel "Agentic AI"@en ;
    skos:altLabel "AI Agents"@en ;
    skos:altLabel "Agentic risks"@en ;
    skos:definition "Risks arising from AI systems that autonomously plan, reason, and act across multiple steps using tools, memory, and external services, beyond single-inference interactions. These risks are distinct from standard LLM risks because the agent takes real-world actions, operates across time, and interacts with external systems and other agents."@en ;
    skos:note "Initial scope deliberately limited to primary enterprise risks of agentic deployment. Adversarial threats specific to agents (e.g., memory poisoning) are not yet included — they sit closer to security and will be revisited as the category matures. Loss of meaningful human control over agentic systems is currently covered under Autonomy & Agency / System autonomy and may be promoted or cross-referenced here in a future iteration. Some overlap with Autonomy & Agency / System autonomy is acknowledged and will be reconciled in a future minor version."@en ;
    skos:topConceptOf <https://taxonomy.eticas.ai/risk/scheme> ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    eticasont:scope "LLM" ;
    eticasont:maturity "established" ;
    eticasont:perspective "technical soundness" ;
    eticasont:lifecycleStage "post-processing" .

eticas:agentic-multi-agent-integrity a nexus:RiskGroup ;
    skos:prefLabel "Multi-agent Integrity"@en ;
    skos:definition "Risks from systems composed of multiple agents — including trust exploitation, cascading failures, goal misalignment between agents, and insufficient traceability across the pipeline."@en ;
    skos:broader eticas:agentic-ai ;
    nexus:isPartOf eticas:agentic-ai ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> .

eticas:ai-interaction-disclosure a nexus:Risk ;
    skos:prefLabel "Disclosure of AI interaction and synthetic content"@en ;
    skos:definition "Failure to disclose that a person is interacting with an AI system, or that content was generated or manipulated by AI — depriving people of the information needed to calibrate trust, detect deception, or trace content provenance."@en ;
    skos:broader eticas:transparency-communication ;
    nexus:isPartOf eticas:transparency-communication ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    eticasont:scope "ALL" ;
    eticasont:maturity "emerging" ;
    eticasont:lifecycleStage "post-processing" ;
    dct:source "HRA" ;
    skos:exactMatch aiact:article-50 .

eticas:automation-bias a nexus:Risk ;
    skos:prefLabel "Automation bias"@en ;
    skos:definition "Over-reliance on automated outputs, accepting AI recommendations without sufficient scrutiny, leading to missed errors and reduced human judgment."@en ;
    skos:broader eticas:autonomy-human-agency ;
    nexus:isPartOf eticas:autonomy-human-agency ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    eticasont:scope "ALL" ;
    eticasont:maturity "emerging" ;
    eticasont:lifecycleStage "post-processing" ;
    skos:closeMatch mit:subdomain-5-1 ;
    skos:closeMatch nist:human-ai-configuration ;
    skos:exactMatch dpvai:AutomationBias .

eticas:autonomy-agency a nexus:RiskGroup ;
    skos:prefLabel "Autonomy & Agency"@en ;
    skos:altLabel "Autonomy & Human Agency"@en ;
    skos:altLabel "Human-AI Interaction"@en ;
    skos:definition "The risk that an AI system undermines human agency or operates with insufficient human control. This includes over-reliance on AI outputs, automation bias, deskilling, and — for agentic AI systems — failure modes arising from multi-step autonomous actions, tool use, or coordination with other AI agents."@en ;
    skos:topConceptOf <https://taxonomy.eticas.ai/risk/scheme> ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    eticasont:scope "ALL" ;
    eticasont:maturity "emerging" ;
    eticasont:perspective "rights & ethics" ;
    eticasont:lifecycleStage "post-processing" ;
    skos:closeMatch mit:domain-5 ;
    skos:closeMatch nist:human-ai-configuration .

eticas:autonomy-human-agency a nexus:RiskGroup ;
    skos:prefLabel "Human agency"@en ;
    skos:definition "Risks to human decision-making capacity arising from interaction with AI systems."@en ;
    skos:broader eticas:autonomy-agency ;
    nexus:isPartOf eticas:autonomy-agency ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    skos:closeMatch mit:subdomain-5-1 ;
    skos:closeMatch mit:subdomain-5-2 ;
    skos:closeMatch nist:human-ai-configuration ;
    skos:closeMatch dpvai:AutomationBias .

eticas:autonomy-system-autonomy a nexus:RiskGroup ;
    skos:prefLabel "System autonomy"@en ;
    skos:definition "Risks from AI systems operating with a degree of autonomy beyond single-inference interactions."@en ;
    skos:broader eticas:autonomy-agency ;
    nexus:isPartOf eticas:autonomy-agency ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
