eticas:over-reliance a nexus:Risk ;
    skos:prefLabel "Over-reliance on AI"@en ;
    skos:definition "Systemic dependence on AI systems that leaves individuals or organisations unable to function when the system is unavailable or produces incorrect outputs."@en ;
    skos:broader eticas:autonomy-human-agency ;
    nexus:isPartOf eticas:autonomy-human-agency ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    eticasont:scope "ALL" ;
    eticasont:maturity "emerging" ;
    eticasont:lifecycleStage "post-processing" ;
    skos:closeMatch nist:human-ai-configuration ;
    skos:exactMatch mit:subdomain-5-1 .

eticas:oversight-of-adverse-impacts a nexus:Risk ;
    skos:prefLabel "Oversight of significant adverse impacts"@en ;
    skos:definition "Missing processes for identifying, escalating, and responding to harmful outcomes, including psychological or physical harm and threats to human life."@en ;
