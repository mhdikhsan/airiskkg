eticas:bias-dynamic-systemic-bias a nexus:RiskGroup ;
    skos:prefLabel "Dynamic & Systemic bias"@en ;
    skos:definition "Risks related to how bias is amplified or perpetuated over time through interaction between AI systems and the social systems they operate in."@en ;
    skos:broader eticas:bias-fairness ;
    nexus:isPartOf eticas:bias-fairness ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    skos:closeMatch dpvai:AutomationBias ;
    skos:closeMatch aiact:article-72 ;
    skos:closeMatch aiact:article-9 ;
    skos:relatedMatch mit:subdomain-6-5 .

eticas:bias-fairness a nexus:RiskGroup ;
    skos:prefLabel "Bias & Fairness"@en ;
    skos:altLabel "Algorithmic fairness"@en ;
    skos:altLabel "Bias & Discrimination"@en ;
    skos:altLabel "Fairness"@en ;
    skos:definition "The risk that an AI system produces outcomes that systematically advantage or disadvantage individuals or groups based on protected or sensitive attributes, leading to unequal treatment, reduced accuracy, or unjust impacts. This includes biases introduced through data, model design, or deployment context, and covers both measurable disparities and perceived unfairness in decision-making."@en ;
    skos:topConceptOf <https://taxonomy.eticas.ai/risk/scheme> ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    eticasont:scope "ALL" ;
    eticasont:maturity "established" ;
    eticasont:perspective "rights & ethics" ;
    eticasont:lifecycleStage "in-processing" ;
    eticasont:lifecycleStage "post-processing" ;
    eticasont:lifecycleStage "pre-processing" ;
    skos:closeMatch mit:domain-1 ;
    skos:closeMatch nist:harmful-bias-and-homogenization ;
    skos:closeMatch dpvai:AIBias ;
    skos:closeMatch aiact:article-10-5-annex-iii .

eticas:bias-outcome-disparities a nexus:RiskGroup ;
    skos:prefLabel "Outcome disparities"@en ;
    skos:definition "Risks related to unequal treatment, allocation, or performance outcomes across demographic and protected groups. These are observable differences in what the system does to or for different groups."@en ;
    skos:broader eticas:bias-fairness ;
    nexus:isPartOf eticas:bias-fairness ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    skos:closeMatch aiact:annex-iii ;
    skos:exactMatch mit:subdomain-1-3 .

eticas:bias-representational-harm a nexus:RiskGroup ;
    skos:prefLabel "Representational harm"@en ;
    skos:definition "Risks related to how the system represents groups in its outputs — through stereotypes, toxic content, skewed representation, or homogenization. These are harms in the form of meaning and content rather than allocation of resources or opportunities."@en ;
    skos:broader eticas:bias-fairness ;
    nexus:isPartOf eticas:bias-fairness ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    skos:closeMatch mit:subdomain-1-1 .

eticas:construct-validity a nexus:Risk ;
    skos:prefLabel "Construct validity of evaluative outputs"@en ;
    skos:definition "The risk that an evaluation does not truly measure the construct it purports to measure — that it fails to capture all and only the components the construct requires. Manifests as failure to register construct-relevant evidence present in the input (under-sensitivity), or as the score moving on signals relevant only to a different construct (contamination)."@en ;
    skos:broader eticas:measurement-validity ;
    nexus:isPartOf eticas:measurement-validity ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
    eticasont:scope "ALL" ;
    eticasont:maturity "emerging" ;
    eticasont:lifecycleStage "in-processing" ;
    eticasont:lifecycleStage "post-processing" ;
    dct:source "Eticas (Wiselook engagement, 2026-06)" .

eticas:csam-ncii-generation a nexus:Risk ;
    skos:prefLabel "CSAM and NCII generation"@en ;
    skos:definition "Generation by the AI system of child sexual abuse material (CSAM) or non-consensual intimate imagery (NCII). Previously covered only implicitly under synthetic media abuse; made explicit here as a distinct content-safety risk."@en ;
