    eticasont:scope "ALL" ;
    eticasont:maturity "emerging" ;
    eticasont:lifecycleStage "pre-processing" ;
    skos:relatedMatch mit:subdomain-6-2 .

eticas:jailbreaking a nexus:Risk ;
    skos:prefLabel "Jailbreaking"@en ;
    skos:altLabel "Jailbreakability"@en ;
