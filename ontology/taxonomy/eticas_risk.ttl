    skos:altLabel "Confabulation"@en ;
    skos:altLabel "Hallucination prevention"@en ;
    skos:definition "Generation of false, fabricated, or misleading information that appears credible, including invented facts, statistics, citations, or events."@en ;
    skos:broader eticas:reliability-output-quality ;
    nexus:isPartOf eticas:reliability-output-quality ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
