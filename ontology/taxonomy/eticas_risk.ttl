eticas:data-poisoning a nexus:Risk ;
    skos:prefLabel "Data poisoning"@en ;
    skos:altLabel "Backdoor attacks"@en ;
    skos:altLabel "Training data poisoning"@en ;
    skos:definition "Adversarial manipulation of training or fine-tuning data to introduce backdoors, bias, or systematic errors into the model. Includes both broad-spectrum poisoning (degrading overall performance) and targeted poisoning (creating exploitable triggers or specific failure modes)."@en ;
