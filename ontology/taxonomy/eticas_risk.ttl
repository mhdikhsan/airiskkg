eticas:behavioural-manipulation a nexus:Risk ;
    skos:prefLabel "Behavioural manipulation"@en ;
    skos:definition "Subliminal influence, dark patterns, or exploitation of cognitive biases to steer user behaviour without informed consent."@en ;
    skos:broader eticas:security-harmful-misuse ;
    nexus:isPartOf eticas:security-harmful-misuse ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
