    eticasont:lifecycleStage "in-processing" ;
    eticasont:lifecycleStage "post-processing" .

eticas:loss-of-human-control a nexus:Risk ;
    skos:prefLabel "Loss of meaningful human control"@en ;
    skos:definition "AI systems operating at speeds or complexity levels that make meaningful human oversight impractical, including inability to understand, interrupt, or reverse autonomous decisions."@en ;
    skos:broader eticas:autonomy-system-autonomy ;
    nexus:isPartOf eticas:autonomy-system-autonomy ;
    skos:inScheme <https://taxonomy.eticas.ai/risk/scheme> ;
    nexus:isDefinedByTaxonomy <https://taxonomy.eticas.ai/risk/scheme> ;
