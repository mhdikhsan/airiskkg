@prefix mit:   <http://w3id.org/airiskkg/taxonomy/mit-ai-risk#> .
@prefix nexus: <http://w3id.org/airiskkg/taxonomy/nexus#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<http://w3id.org/airiskkg/taxonomy/mit-ai-risk#> a owl:Ontology ;
    # Third-party provenance: derived from IBM AI Atlas Nexus (Apache License 2.0).
    # Apache 2.0 is permissive, so this file may be released under the repository
    # licence; its section 4 duties (retain notices, state changes, propagate NOTICE)
    # are met here and in /NOTICE.md.
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:rights "PAIR-AI original modelling work, CC BY 4.0. Contains material derived from IBM AI Atlas Nexus (https://github.com/IBM/ai-atlas-nexus), Copyright IBM Corporation and the AI Atlas Nexus contributors, licensed under the Apache License, Version 2.0; that material remains under Apache 2.0, and a copy of the licence is in LICENSES/Apache-2.0.txt. Changes were made: the upstream data was subset, restructured into RDF, and aligned to the PAIR-AI vocabulary. The domain taxonomy is from the MIT AI Risk Repository, MIT AI Risk Initiative, licensed CC BY 4.0 (https://airisk.mit.edu/); it is reproduced in part and aligned to the PAIR-AI vocabulary."@en ;
    dct:bibliographicCitation "Slattery, P., Saeri, A. K., Grundy, E. A. C., Graham, J., Noetel, M., Uuk, R., Dao, J., Pour, S., Casper, S., & Thompson, N. (2026). The AI risk repository: A meta-review, database, and taxonomy of risks from artificial intelligence. Patterns, Article 101517. https://doi.org/10.1016/j.patter.2026.101517"@en ;
    rdfs:label "MIT AI Risk Repository Subset for AI Risk KG" ;
    dct:title "MIT AI Risk Repository Subset for AI Risk KG" ;
    dct:description """
    A selected RDF subset of the MIT AI Risk Repository domain taxonomy,
    adapted from AI Atlas Nexus for use in graph-pattern-based AI risk assessment.
    """ ;
    dct:source <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/knowledge_graph/mit_ai_risk_repository_data.yaml> .

mit:MIT_AI_Risk_Repository_Domain_Taxonomy a nexus:RiskTaxonomy, skos:ConceptScheme ;
    skos:prefLabel "MIT AI Risk Repository: Domain Taxonomy of AI Risks" ;
    rdfs:seeAlso <https://airisk.mit.edu/> ;
    dct:description "A domain taxonomy of AI risks organized into high-level AI risk domains and subdomains." .

mit:domain-1 a nexus:RiskGroup ;
    skos:prefLabel "Discrimination & Toxicity" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/domain/1> ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:domain-2 a nexus:RiskGroup ;
    skos:prefLabel "Privacy & Security" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/domain/2> ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:domain-3 a nexus:RiskGroup ;
    skos:prefLabel "Misinformation" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/domain/3> ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:domain-4 a nexus:RiskGroup ;
    skos:prefLabel "Malicious Actors & Misuse" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/domain/4> ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:domain-5 a nexus:RiskGroup ;
    skos:prefLabel "Human-Computer Interaction" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/domain/5> ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:domain-6 a nexus:RiskGroup ;
    skos:prefLabel "Socioeconomic & Environmental" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/domain/6> ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:domain-7 a nexus:RiskGroup ;
    skos:prefLabel "AI System Safety, Failures, & Limitations" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/domain/7> ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:subdomain-1-1 a nexus:Risk ;
    skos:prefLabel "Unfair discrimination and misrepresentation" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/1-1> ;
    skos:definition "AI may treat individuals or groups unfairly or represent them in harmful ways." ;
    skos:broader mit:domain-1 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-1 .

mit:subdomain-1-2 a nexus:Risk ;
    skos:prefLabel "Exposure to toxic content" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/1-2> ;
    skos:definition "AI may expose users to harmful, abusive, unsafe, or inappropriate content." ;
    skos:broader mit:domain-1 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-1 .

mit:subdomain-1-3 a nexus:Risk ;
    skos:prefLabel "Unequal performance across groups" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/1-3> ;
    skos:definition "AI system performance may differ across demographic or social groups." ;
    skos:broader mit:domain-1 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-1 .

mit:subdomain-2-1 a nexus:Risk ;
    skos:prefLabel "Compromise of privacy by obtaining, leaking or inferring sensitive information" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/2-1> ;
    skos:definition "AI systems may leak, infer, or expose sensitive information about individuals or organizations." ;
    skos:broader mit:domain-2 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-2 .

mit:subdomain-2-2 a nexus:Risk ;
    skos:prefLabel "AI system security vulnerabilities and attacks" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/2-2> ;
    skos:definition "AI systems may contain vulnerabilities that enable unauthorized access, manipulation, or unsafe behavior." ;
    skos:broader mit:domain-2 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-2 .

mit:subdomain-3-1 a nexus:Risk ;
    skos:prefLabel "False or misleading information" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/3-1> ;
    skos:definition "AI systems may generate or spread incorrect, deceptive, or misleading information." ;
    skos:broader mit:domain-3 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-3 .

mit:subdomain-4-1 a nexus:Risk ;
    skos:prefLabel "Disinformation, surveillance, and influence at scale" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/4-1> ;
    skos:definition "AI may be used to produce misleading content, monitor people, or shape opinion across large populations." ;
    skos:broader mit:domain-4 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-4 .

mit:subdomain-4-3 a nexus:Risk ;
    skos:prefLabel "Fraud, scams, and targeted manipulation" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/4-3> ;
    skos:definition "AI systems may be used to manipulate, deceive, impersonate, or exploit people." ;
    skos:broader mit:domain-4 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-4 .

mit:subdomain-5-1 a nexus:Risk ;
    skos:prefLabel "Overreliance and unsafe use" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/5-1> ;
    skos:definition "Users may place inappropriate trust in AI systems or use them unsafely." ;
    skos:broader mit:domain-5 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-5 .

mit:subdomain-5-2 a nexus:Risk ;
    skos:prefLabel "Loss of human agency and autonomy" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/5-2> ;
    skos:definition "AI systems may reduce human control, agency, or autonomy in decision-making." ;
    skos:broader mit:domain-5 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-5 .

mit:subdomain-6-2 a nexus:Risk ;
    skos:prefLabel "Increased inequality and decline in employment quality" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/6-2> ;
    skos:definition "AI may widen economic inequality or degrade the quality and security of work." ;
    skos:broader mit:domain-6 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-6 .

mit:subdomain-6-3 a nexus:Risk ;
    skos:prefLabel "Economic and cultural devaluation of human effort" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/6-3> ;
    skos:definition "AI may reduce the economic or cultural value placed on human skill and creative work." ;
    skos:broader mit:domain-6 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-6 .

mit:subdomain-6-5 a nexus:Risk ;
    skos:prefLabel "Governance failure" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/6-5> ;
    skos:definition "Rules, oversight, or institutions may fail to keep pace with how AI systems are built and used." ;
    skos:broader mit:domain-6 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-6 .

mit:subdomain-6-6 a nexus:Risk ;
    skos:prefLabel "Environmental harm" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/6-6> ;
    skos:definition "AI development or operation may contribute to environmental harm through resource use or emissions." ;
    skos:broader mit:domain-6 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-6 .

mit:subdomain-7-1 a nexus:Risk ;
    skos:prefLabel "AI pursuing its own goals in conflict with human goals or values" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/7-1> ;
    skos:definition "AI systems may act on objectives that diverge from those of the people who deploy or are affected by them." ;
    skos:broader mit:domain-7 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-7 .

mit:subdomain-7-3 a nexus:Risk ;
    skos:prefLabel "Lack of capability or robustness" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/7-3> ;
    skos:definition "AI systems may fail to perform reliably or effectively under varying conditions." ;
    skos:broader mit:domain-7 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-7 .

mit:subdomain-7-4 a nexus:Risk ;
    skos:prefLabel "Lack of transparency or interpretability" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/7-4> ;
    skos:definition "AI systems may be difficult to understand, explain, audit, or correct." ;
    skos:broader mit:domain-7 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-7 .

mit:subdomain-7-6 a nexus:Risk ;
    skos:prefLabel "Multi-agent risks" ;
    rdfs:seeAlso <https://airisk.mit.edu/navigator#/subdomain/7-6> ;
    skos:definition "Interactions among several AI systems may produce failures or harms that no single system would cause alone." ;
    skos:broader mit:domain-7 ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-7 .
