    nexus:mitigatesRiskTaxonomyEntry owasp:llm09-misinformation ;
    nexus:mitigatesRiskTaxonomyEntry mit:subdomain-1-2 ;
    nexus:mitigatesRiskTaxonomyEntry mit:subdomain-4-3 .

