@prefix atlas:   <http://w3id.org/airiskkg/taxonomy/ibm-risk-atlas#> .
@prefix mit:     <http://w3id.org/airiskkg/taxonomy/mit-ai-risk#> .
@prefix owasp:   <http://w3id.org/airiskkg/taxonomy/owasp-llm#> .
@prefix mitctrl: <http://w3id.org/airiskkg/taxonomy/mit-ai-risk-control#> .
@prefix nexus:   <http://w3id.org/airiskkg/taxonomy/nexus#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .


<http://w3id.org/airiskkg/taxonomy/mappings#> a owl:Ontology ;
    rdfs:label "AI Risk KG Taxonomy Mappings" ;
    dct:title "AI Risk KG Taxonomy Mappings" ;
    dct:description """
    Cross-taxonomy mappings between selected IBM AI Risk Atlas, MIT AI Risk Repository,
    OWASP LLM Top 10, and MIT AI Risk Control concepts.

    Provenance tiers (2026-07-17 audit): Section 1 mappings are taken from the
    IBM AI Atlas Nexus SSSOM mapping sets, with predicates exactly as curated
    upstream (ManualMappingCuration, confidence 0.95). Section 2 mappings are
    PAIR-AI project curation (no upstream SSSOM row exists); each carries a
    stated rationale. Mappings contradicted by upstream (explicit noMatch or a
    different target) were removed in the same audit. Section 3 risk-to-control
    grounding is project curation over the MIT mitigation layer.
    """ ;
    dct:source <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/mappings/ibm2owasp.tsv> ,
               <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/mappings/mit-ai-risk-repository_ibm-risk-atlas.tsv> ,
               <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/mappings/mit_ai_risk_mitigation_mappings.tsv> .


#################################################################
# Section 1 — Upstream-verified mappings (IBM AI Atlas Nexus SSSOM)
# Predicates match the upstream rows exactly (verified 2026-07-17).
#################################################################

## Atlas <-> OWASP (source: ibm2owasp.tsv)

atlas:prompt-injection
    skos:exactMatch owasp:llm01-prompt-injection .

atlas:exposing-personal-information
    skos:broadMatch owasp:llm02-sensitive-information-disclosure .

atlas:personal-information-in-prompt
    skos:relatedMatch owasp:llm02-sensitive-information-disclosure .

atlas:personal-information-in-data
    skos:relatedMatch owasp:llm02-sensitive-information-disclosure .

atlas:confidential-data-in-prompt
    skos:relatedMatch owasp:llm02-sensitive-information-disclosure .

atlas:prompt-leaking
    skos:broadMatch owasp:llm02-sensitive-information-disclosure .

atlas:data-curation
    skos:broadMatch owasp:llm03-supply-chain .

atlas:data-poisoning
    skos:broadMatch owasp:llm04-data-and-model-poisoning .

atlas:hallucination
    skos:relatedMatch owasp:llm09-misinformation .

atlas:incomplete-advice
    skos:broadMatch owasp:llm09-misinformation .

## Atlas <-> MIT AI Risk Repository domain taxonomy
## (source: mit-ai-risk-repository_ibm-risk-atlas.tsv; upstream uses
## skos:relatedMatch uniformly, one subdomain per risk)

atlas:exposing-personal-information  skos:relatedMatch mit:subdomain-2-1 .
atlas:personal-information-in-prompt skos:relatedMatch mit:subdomain-2-1 .
atlas:personal-information-in-data   skos:relatedMatch mit:subdomain-2-1 .
atlas:confidential-data-in-prompt    skos:relatedMatch mit:subdomain-2-1 .
atlas:reidentification               skos:relatedMatch mit:subdomain-2-1 .
atlas:prompt-injection               skos:relatedMatch mit:subdomain-2-2 .
atlas:prompt-leaking                 skos:relatedMatch mit:subdomain-2-2 .
atlas:evasion-attack                 skos:relatedMatch mit:subdomain-2-2 .
atlas:data-poisoning                 skos:relatedMatch mit:subdomain-2-2 .
atlas:poor-model-accuracy            skos:relatedMatch mit:subdomain-7-3 .
atlas:data-curation                  skos:relatedMatch mit:subdomain-7-3 .
atlas:incomplete-advice              skos:relatedMatch mit:subdomain-7-3 .
atlas:data-usage-restrictions        skos:relatedMatch mit:subdomain-7-3 .
atlas:hallucination                  skos:relatedMatch mit:subdomain-3-1 .
atlas:decision-bias                  skos:relatedMatch mit:subdomain-1-1 .
atlas:impact-on-the-environment      skos:relatedMatch mit:subdomain-6-6 .


#################################################################
# Section 2 — Project-curated mappings (PAIR-AI expert curation)
# No upstream SSSOM row exists for these; rationale stated per block.
# Removed in the 2026-07-17 audit (upstream contradiction or no
# defensible basis): evasion-attack<->llm05, poor-model-accuracy<->llm08/llm09,
# impact-on-the-environment<->llm10 (upstream: "not addressed by OWASP"),
# data-curation<->llm04 (upstream maps it to llm03), prompt-injection<->
# subdomain-4-3, llm01<->subdomain-4-3, llm05<->subdomain-7-3,
# llm06<->subdomain-7-4, llm07<->subdomain-7-4, decision-bias<->subdomain-1-3,
# data-curation<->subdomain-1-3, hallucination<->subdomain-7-3,
# incomplete-advice<->subdomain-3-1/5-1 (upstream: 7-3),
# data-usage-restrictions<->subdomain-7-4/2-1 (upstream: 7-3),
# legal-accountability<->subdomain-7-4 (upstream: 6-5, not in local subset).
#################################################################

# prompt-leaking and llm07 name the same phenomenon (system prompt exposure);
# the upstream mapping predates a direct llm07 row and anchors it to llm02.
atlas:prompt-leaking
    skos:closeMatch owasp:llm07-system-prompt-leakage .

# confidential data embedded in prompts is one of the assets exposed by
# system prompt leakage (OWASP LLM07 description).
atlas:confidential-data-in-prompt
    skos:relatedMatch owasp:llm07-system-prompt-leakage .

# OWASP LLM08 explicitly covers indirect prompt injection delivered through
# compromised retrieval content.
atlas:prompt-injection
    skos:relatedMatch owasp:llm08-vector-and-embedding-weaknesses .

# Redundant agentic actions waste resources (narrower phenomenon than
# unbounded consumption) and are one form of excessive agency; the Atlas
# agentic risks postdate the upstream mapping set.
atlas:redundant-actions-agentic
    skos:relatedMatch owasp:llm06-excessive-agency .
owasp:llm10-unbounded-consumption
    skos:narrowMatch atlas:redundant-actions-agentic .

## OWASP <-> MIT domain taxonomy (no upstream OWASP<->MIT mapping set exists;
## corroboration via shared Atlas concepts noted where available)

# corroborated: atlas:prompt-injection maps to both llm01 and subdomain-2-2
owasp:llm01-prompt-injection
    skos:broadMatch mit:subdomain-2-2 .

# corroborated: the llm02-mapped Atlas privacy risks all map to subdomain-2-1
owasp:llm02-sensitive-information-disclosure
    skos:closeMatch mit:subdomain-2-1 .

# supply-chain compromise is a security-vulnerability class (2.2);
# corroborated for 7-3 via atlas:data-curation (llm03 + subdomain-7-3);
# unverifiable provenance impairs auditability (7.4).
owasp:llm03-supply-chain
    skos:broadMatch mit:subdomain-2-2 ;
    skos:relatedMatch mit:subdomain-7-3 ;
    skos:relatedMatch mit:subdomain-7-4 .

# corroborated: atlas:data-poisoning maps to both llm04 and subdomain-2-2;
# poisoning degrades reliability (7.3) and can introduce group-specific
# bias (1.3, per the OWASP LLM04 description).
owasp:llm04-data-and-model-poisoning
    skos:broadMatch mit:subdomain-2-2 ;
    skos:relatedMatch mit:subdomain-7-3 ;
    skos:relatedMatch mit:subdomain-1-3 .

# unvalidated output enables downstream exploitation (2.2) and exposes
# users to unsafe generated content (1.2).
owasp:llm05-improper-output-handling
    skos:relatedMatch mit:subdomain-2-2 ;
    skos:relatedMatch mit:subdomain-1-2 .

# excessive agency is a security/abuse concern (2.2) and reduces human
# control over consequential actions (5.2).
owasp:llm06-excessive-agency
    skos:relatedMatch mit:subdomain-2-2 ;
    skos:relatedMatch mit:subdomain-5-2 .

# corroborated: atlas:prompt-leaking maps to subdomain-2-2; leaked prompts
# expose sensitive configuration (2.1).
owasp:llm07-system-prompt-leakage
    skos:broadMatch mit:subdomain-2-1 ;
    skos:broadMatch mit:subdomain-2-2 .

# retrieval/embedding weaknesses are attack surface (2.2) and degrade
# retrieval reliability (7.3).
owasp:llm08-vector-and-embedding-weaknesses
    skos:broadMatch mit:subdomain-2-2 ;
    skos:broadMatch mit:subdomain-7-3 .

# corroborated: atlas:hallucination maps to subdomain-3-1 and
# atlas:incomplete-advice to subdomain-7-3; overreliance on ungrounded
# answers is the harm pathway (5.1).
owasp:llm09-misinformation
    skos:closeMatch mit:subdomain-3-1 ;
    skos:relatedMatch mit:subdomain-5-1 ;
    skos:relatedMatch mit:subdomain-7-3 .

# resource exhaustion is an availability/abuse concern (2.2), degrades
# service reliability (7.3), and drives energy/cost footprint (6.6).
owasp:llm10-unbounded-consumption
    skos:relatedMatch mit:subdomain-2-2 ;
    skos:relatedMatch mit:subdomain-6-6 ;
    skos:relatedMatch mit:subdomain-7-3 .


#################################################################
# Section 3 — Risk-to-control grounding (project curation over the
# MIT mitigation layer; control concepts and their MIT provenance are
# declared in mit_air_risk_control.ttl)
#################################################################

atlas:exposing-personal-information
    nexus:hasRelatedControl mitctrl:privacy-control-for-user-data ,
        mitctrl:access-management ,
        mitctrl:retrieval-source-filtering ,
        mitctrl:redaction ,
        mitctrl:input-output-filtering ,
        mitctrl:data-minimization ,
        mitctrl:data-governance .

atlas:personal-information-in-prompt
