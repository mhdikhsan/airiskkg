#################################################################
# Section 2 — Project-curated mappings (PAIR-AI expert curation)
# No upstream SSSOM row exists for these; rationale stated per block.
#################################################################

# prompt-leaking and llm07 name the same phenomenon (system prompt exposure);
# the upstream mapping predates a direct llm07 row and anchors it to llm02.
atlas:prompt-leaking
    skos:closeMatch owasp:llm07-system-prompt-leakage .

# confidential data embedded in prompts is one of the assets exposed by
# system prompt leakage (OWASP LLM07 description).
atlas:confidential-data-in-prompt
    skos:relatedMatch owasp:llm07-system-prompt-leakage .

# OWASP LLM08 explicitly covers indirect prompt injection delivered through
# compromised retrieval content.
atlas:prompt-injection
    skos:relatedMatch owasp:llm08-vector-and-embedding-weaknesses .

# Redundant agentic actions waste resources (narrower phenomenon than
# unbounded consumption) and are one form of excessive agency; the Atlas
# agentic risks postdate the upstream mapping set.
atlas:redundant-actions-agentic
    skos:relatedMatch owasp:llm06-excessive-agency .
owasp:llm10-unbounded-consumption
    skos:narrowMatch atlas:redundant-actions-agentic .

## OWASP <-> MIT domain taxonomy (no upstream OWASP<->MIT mapping set exists;
## corroboration via shared Atlas concepts noted where available)

# corroborated: atlas:prompt-injection maps to both llm01 and subdomain-2-2
owasp:llm01-prompt-injection
    skos:broadMatch mit:subdomain-2-2 .

# corroborated: the llm02-mapped Atlas privacy risks all map to subdomain-2-1
owasp:llm02-sensitive-information-disclosure
    skos:closeMatch mit:subdomain-2-1 .

# supply-chain compromise is a security-vulnerability class (2.2);
# corroborated for 7-3 via atlas:data-curation (llm03 + subdomain-7-3);
# unverifiable provenance impairs auditability (7.4), corroborated via
# atlas:inaccessible-training-data and atlas:untraceable-attribution.
owasp:llm03-supply-chain
    skos:broadMatch mit:subdomain-2-2 ;
    skos:relatedMatch mit:subdomain-7-3 ;
    skos:relatedMatch mit:subdomain-7-4 .

# corroborated: atlas:data-poisoning maps to both llm04 and subdomain-2-2;
# poisoning degrades reliability (7.3) and can introduce group-specific
# bias (1.3, per the OWASP LLM04 description).
owasp:llm04-data-and-model-poisoning
    skos:broadMatch mit:subdomain-2-2 ;
    skos:relatedMatch mit:subdomain-7-3 ;
    skos:relatedMatch mit:subdomain-1-3 .

# unvalidated output enables downstream exploitation (2.2) and exposes
# users to unsafe generated content (1.2).
owasp:llm05-improper-output-handling
    skos:relatedMatch mit:subdomain-2-2 ;
    skos:relatedMatch mit:subdomain-1-2 .

# excessive agency is a security/abuse concern (2.2) and reduces human
# control over consequential actions (5.2).
owasp:llm06-excessive-agency
    skos:relatedMatch mit:subdomain-2-2 ;
    skos:relatedMatch mit:subdomain-5-2 .

# corroborated: atlas:prompt-leaking maps to subdomain-2-2; leaked prompts
# expose sensitive configuration (2.1).
owasp:llm07-system-prompt-leakage
    skos:broadMatch mit:subdomain-2-1 ;
    skos:broadMatch mit:subdomain-2-2 .

# retrieval/embedding weaknesses are attack surface (2.2) and degrade
# retrieval reliability (7.3).
owasp:llm08-vector-and-embedding-weaknesses
    skos:broadMatch mit:subdomain-2-2 ;
    skos:broadMatch mit:subdomain-7-3 .

# corroborated: atlas:hallucination maps to subdomain-3-1 and
# atlas:incomplete-advice to subdomain-7-3; overreliance on ungrounded
# answers is the harm pathway (5.1).
owasp:llm09-misinformation
    skos:closeMatch mit:subdomain-3-1 ;
    skos:relatedMatch mit:subdomain-5-1 ;
    skos:relatedMatch mit:subdomain-7-3 .

# resource exhaustion is an availability/abuse concern (2.2), degrades
# service reliability (7.3), and drives energy/cost footprint (6.6).
owasp:llm10-unbounded-consumption
    skos:relatedMatch mit:subdomain-2-2 ;
    skos:relatedMatch mit:subdomain-6-6 ;
    skos:relatedMatch mit:subdomain-7-3 .



## OWASP Agentic Top 10 (ASI) <-> MIT domain taxonomy
## No upstream SSSOM row exists for ASI <-> MIT, so these are PAIR-AI curation.
## The ASI <-> OWASP LLM links ARE curated upstream and live in Section 1.

# Acting on external systems through tools without mediation is an attack
# surface on the AI system itself (2-2) and removes the human from decisions
# the architecture still attributes to them (5-2).
asi:asi02-tool-misuse
    skos:relatedMatch mit:subdomain-2-2 ,
        mit:subdomain-5-2 .

# Poisoned retained context is an attack on the system (2-2) whose visible
# effect downstream is false or misleading output (3-1).
asi:asi06-memory-and-context-poisoning
    skos:relatedMatch mit:subdomain-2-2 ,
        mit:subdomain-3-1 .


## OWASP Agentic Top 10 (ASI) <-> MIT, for the entries added 2026-10-09.
## Same footing as asi02 and asi06 above: no upstream set exists, so each is
## curation with its reason stated.

# Abusing an identity or privilege is an attack on the system's access model
# (2-2); upstream relates ASI03 to LLM06, which this file relates to 2-2.
asi:asi03-identity-and-privilege-abuse
    skos:relatedMatch mit:subdomain-2-2 .

# A tampered component in the agent's runtime chain is a supply-chain attack
# (2-2), as LLM03, which upstream relates ASI04 to, already is here.
asi:asi04-agentic-supply-chain
    skos:relatedMatch mit:subdomain-2-2 .

# Executing attacker-shaped code is a direct security compromise (2-2);
# corroborated by atlas:harmful-code-generation, which upstream maps to 2-2.
asi:asi05-unexpected-code-execution
    skos:relatedMatch mit:subdomain-2-2 .

# MIT 7.6 is the subdomain for harms arising from interacting AI systems,
# which is what a cascade between agents is.
asi:asi08-cascading-failures
    skos:relatedMatch mit:subdomain-7-6 .

# Trust exploitation works through over-reliance (5-1); corroborated by
# atlas:over-or-under-reliance, which upstream maps to 5-1 and relates to the
# LLM05 and LLM06 entries ASI09 is related to upstream.
asi:asi09-human-agent-trust-exploitation
    skos:relatedMatch mit:subdomain-5-1 ,
        atlas:over-or-under-reliance .

## Risks in AI/ML systems (Zhang et al., 2022) <-> IBM Atlas and MIT.
## No upstream set covers this categorisation; each link is curation.

# Shifted inputs degrade accuracy (IBM names "changes to the model's expected
# inputs" as a cause of poor accuracy); unrepresentative training data is the
# training-side face of covariate shift. Both are capability failures (7-3).
mlr:dataset-shift
    skos:relatedMatch atlas:poor-model-accuracy ,
        atlas:unrepresentative-data ,
        mit:subdomain-7-3 .

# Answers for inputs outside the trained domain are a capability failure.
mlr:out-of-domain-data
    skos:relatedMatch atlas:poor-model-accuracy ,
        mit:subdomain-7-3 .

# IBM's evasion attack is the same perturbation-at-inference attack.
mlr:adversarial-attack
    skos:closeMatch atlas:evasion-attack ;
    skos:relatedMatch mit:subdomain-2-2 .

# Model bias shows as decisions that disadvantage groups (decision bias,
# 1-1) and as unequal error rates across them (1-3); data bias is its
# main source.
mlr:model-bias
    skos:relatedMatch atlas:decision-bias ,
        atlas:data-bias ,
        mit:subdomain-1-1 ,
        mit:subdomain-1-3 .

# A misspecified model is one cause of poor accuracy, a capability failure.
mlr:model-misspecification
    skos:relatedMatch atlas:poor-model-accuracy ,
        mit:subdomain-7-3 .

# Unreported uncertainty is what lets a person over-rely on a prediction
# (5-1), and an unreliable prediction is a capability limit (7-3).
mlr:model-uncertainty
    skos:relatedMatch atlas:over-or-under-reliance ,
        mit:subdomain-5-1 ,
        mit:subdomain-7-3 .

## Eticas AI Risk Taxonomy <-> the anchors risk patterns derive from.
## Eticas publishes no links to OWASP (one bundled ASI handle aside), to
## Zhang et al., or to the Atlas entries these anchors are, so the bridge is
## curation; Eticas's own published links are in eticas_risk.ttl.

# Same phenomenon, definitions agree.
owasp:llm01-prompt-injection
    skos:closeMatch eticas:prompt-injection .

owasp:llm03-supply-chain
    skos:closeMatch eticas:supply-chain-vulnerabilities .

owasp:llm04-data-and-model-poisoning
    skos:closeMatch eticas:data-poisoning .

owasp:llm06-excessive-agency
    skos:closeMatch eticas:excessive-agency .

# Eticas covers leakage of both personal and confidential content, as LLM02.
owasp:llm02-sensitive-information-disclosure
    skos:closeMatch eticas:sensitive-information-leakage .

# Hallucination is one of the ways LLM09 misinformation arises.
owasp:llm09-misinformation
    skos:relatedMatch eticas:hallucination .

asi:asi02-tool-misuse
    skos:closeMatch eticas:unsafe-tool-calls .

asi:asi07-insecure-inter-agent-communication
    skos:closeMatch eticas:trust-exploitation-between-agents .

# Eticas describes early errors cascading through later steps of an agent's
# sequence; ASI08 is the same propagation across agents.
asi:asi08-cascading-failures
    skos:relatedMatch eticas:multi-step-actions .

asi:asi09-human-agent-trust-exploitation
    skos:relatedMatch eticas:automation-bias .

# Eticas lists drift, inconsistency and goal misalignment rather than rogue
# agents; emergent behaviour is the nearest, and the entry is catalogued only.
asi:asi10-rogue-agents
    skos:relatedMatch eticas:emergent-behaviour .

mlr:dataset-shift
    skos:relatedMatch eticas:output-drift .

mlr:out-of-domain-data
    skos:closeMatch eticas:out-of-distribution-robustness .

# Eticas's guardrail evasion includes adversarial perturbation of classifiers.
mlr:adversarial-attack
    skos:relatedMatch eticas:evasion-attacks .

mlr:model-bias
    skos:relatedMatch eticas:performance-equity ,
        eticas:disparate-impact-protected-groups .

# Eticas's fitness for purpose asks whether the system was validated for its
# task before deployment, which is what an unvalidated model fit fails.
mlr:model-misspecification
    skos:relatedMatch eticas:fitness-for-purpose .

mlr:model-uncertainty
    skos:relatedMatch eticas:automation-bias .

# Eticas's feedback loops are outputs fed back to amplify bias; improper
# retraining is the training-data route by which that happens.
atlas:improper-retraining
    skos:relatedMatch eticas:feedback-loops .

# Eticas's model-level privacy entry covers training data surfacing through
# the model, of which membership inference is the query-based form.
atlas:membership-inference-attack
    skos:relatedMatch eticas:sensitive-information-leakage .


# Section 3 - Risk-to-control grounding
#
# owasp:* -> nexus:hasRelatedControl links are the sole home of risk ->
# MIT-control-family grounding; a finding surfaces them as an evidence layer
# via its taxonomy entries (owasp/atlas/mit), not as suggested controls.
#
# LLM01-06 and LLM09 links are derived from the PAIR-AI risk-to-mitigation CSV:
# each risk's IBM-mapped mitigation actions are rolled up to their MIT
# sub-categories and mapped 1:1 to our mitctrl:* concepts. These are CANDIDATE
# associations - the underlying risk->action edges are embedding-matched
# (cosine top-3, unvalidated), so treat as a semantic baseline pending human
# review. Sub-category approximations: 2.2 Model Alignment ->
# model-safety-engineering; 4.4 Governance Disclosure -> risk-disclosure;
# 4.5 Third-Party System Access -> access-management. LLM07/08/10 are absent
# from the CSV and keep their prior curated links.
#################################################################

## OWASP risk -> control
owasp:llm01-prompt-injection
    nexus:hasRelatedControl mitctrl:data-governance ,
        mitctrl:incident-reporting ,
        mitctrl:model-safety-engineering ,
        mitctrl:risk-disclosure ,
        mitctrl:testing-auditing .

owasp:llm02-sensitive-information-disclosure
