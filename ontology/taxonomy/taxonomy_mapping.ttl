atlas:data-bias                        skos:relatedMatch mit:subdomain-1-1 .


## OWASP Agentic Top 10 (ASI) <-> OWASP LLM Top 10
## (source: owasp_asi2owasp_llm.tsv, mapping_date 2026-04-28, all rows
## semapv:ManualMappingCuration). Predicates and directions are reproduced
## exactly as curated upstream, NOT re-derived. Upstream confidences:
## asi02->llm06 0.90; asi06->llm04 0.85; asi06->llm01 0.75; asi06->llm08 0.75;
## asi01->llm01 0.85; asi01->llm06 0.80; asi07->llm02 0.75; asi07->llm06 0.75;
## asi03->llm01 0.75; asi03->llm02 0.75; asi03->llm06 0.85; asi04->llm03 0.90;
## asi05->llm01 0.80; asi05->llm05 0.85; asi08->llm01 0.75; asi08->llm04 0.75;
## asi08->llm06 0.80; asi09->llm01 0.75; asi09->llm05 0.75; asi09->llm06 0.80;
## asi09->llm09 0.85; asi10->llm02 0.75; asi10->llm09 0.75.
asi:asi01-agent-goal-hijack
    skos:broadMatch owasp:llm01-prompt-injection ;
    skos:relatedMatch owasp:llm06-excessive-agency .

asi:asi02-tool-misuse
    skos:narrowMatch owasp:llm06-excessive-agency .

asi:asi07-insecure-inter-agent-communication
    skos:relatedMatch owasp:llm02-sensitive-information-disclosure ,
        owasp:llm06-excessive-agency .

asi:asi06-memory-and-context-poisoning
    skos:broadMatch owasp:llm04-data-and-model-poisoning ;
    skos:relatedMatch owasp:llm01-prompt-injection ,
        owasp:llm08-vector-and-embedding-weaknesses .

asi:asi03-identity-and-privilege-abuse
    skos:relatedMatch owasp:llm01-prompt-injection ,
        owasp:llm02-sensitive-information-disclosure ;
    skos:narrowMatch owasp:llm06-excessive-agency .

asi:asi04-agentic-supply-chain
    skos:narrowMatch owasp:llm03-supply-chain .

asi:asi05-unexpected-code-execution
    skos:relatedMatch owasp:llm01-prompt-injection ;
    skos:narrowMatch owasp:llm05-improper-output-handling .

asi:asi08-cascading-failures
    skos:relatedMatch owasp:llm01-prompt-injection ,
        owasp:llm04-data-and-model-poisoning ,
        owasp:llm06-excessive-agency .

asi:asi09-human-agent-trust-exploitation
    skos:relatedMatch owasp:llm01-prompt-injection ,
        owasp:llm05-improper-output-handling ,
        owasp:llm06-excessive-agency ;
    skos:broadMatch owasp:llm09-misinformation .

asi:asi10-rogue-agents
    skos:relatedMatch owasp:llm02-sensitive-information-disclosure ,
        owasp:llm09-misinformation .

## IBM Atlas <-> NIST AI RMF Generative AI Profile (NIST AI 600-1)
## (source: ibm2nistgenai.tsv, mapping_date 2025-01-29, every row
## semapv:ManualMappingCuration at confidence 0.95). Predicates and directions
## reproduced exactly as curated upstream, NOT re-derived. Two modelled Atlas
## concepts have no row upstream - data-usage-restrictions and the agentic
## redundant-actions-agentic - and are deliberately left unmapped rather than
## curated here.
atlas:hallucination
    skos:exactMatch nist:confabulation .

atlas:impact-on-the-environment
    skos:exactMatch nist:environmental-impacts .

atlas:data-poisoning
    skos:broadMatch nist:information-security .

atlas:prompt-injection
    skos:broadMatch nist:information-security .

atlas:prompt-leaking
    skos:broadMatch nist:information-security .

atlas:evasion-attack
    skos:broadMatch nist:information-security .

atlas:exposing-personal-information
    skos:broadMatch nist:data-privacy .

atlas:personal-information-in-prompt
    skos:broadMatch nist:data-privacy .

atlas:personal-information-in-data
    skos:broadMatch nist:data-privacy .

atlas:reidentification
    skos:broadMatch nist:data-privacy .

atlas:decision-bias
    skos:broadMatch nist:harmful-bias-and-homogenization .

atlas:confidential-data-in-prompt
    skos:broadMatch nist:intellectual-property .

atlas:data-curation
    skos:broadMatch nist:value-chain-and-component-integration .

atlas:legal-accountability
    skos:broadMatch nist:value-chain-and-component-integration ,
        nist:data-privacy ,
        nist:intellectual-property .

atlas:incomplete-advice
    skos:broadMatch nist:information-integrity ,
        nist:value-chain-and-component-integration .

atlas:poor-model-accuracy
    skos:broadMatch nist:value-chain-and-component-integration ,
        nist:information-integrity ,
        nist:human-ai-configuration .

atlas:confidential-information-in-data
    skos:broadMatch nist:intellectual-property .

atlas:revealing-confidential-information
    skos:broadMatch nist:intellectual-property .

atlas:ip-information-in-prompt
    skos:broadMatch nist:data-privacy .

atlas:membership-inference-attack
    skos:broadMatch nist:data-privacy .

atlas:attribute-inference-attack
    skos:broadMatch nist:information-security ,
        nist:data-privacy .

atlas:prompt-priming
    skos:broadMatch nist:information-security .

atlas:jailbreaking
    skos:broadMatch nist:information-integrity .

atlas:spreading-disinformation
    skos:broadMatch nist:information-integrity .

atlas:untraceable-attribution
    skos:broadMatch nist:information-integrity .

atlas:harmful-code-generation
    skos:broadMatch nist:dangerous-violent-or-hateful-content ,
        nist:information-security .

atlas:data-contamination
    skos:broadMatch nist:value-chain-and-component-integration ,
        nist:information-security .

atlas:data-acquisition
    skos:broadMatch nist:value-chain-and-component-integration .

atlas:data-provenance
    skos:broadMatch nist:value-chain-and-component-integration .

atlas:lack-of-data-transparency
    skos:broadMatch nist:value-chain-and-component-integration .

atlas:improper-retraining
    skos:broadMatch nist:value-chain-and-component-integration .

atlas:inaccessible-training-data
    skos:broadMatch nist:value-chain-and-component-integration .

atlas:data-usage-rights
    skos:broadMatch nist:value-chain-and-component-integration ,
        nist:data-privacy ,
        nist:intellectual-property .

atlas:model-usage-rights
    skos:broadMatch nist:data-privacy ,
        nist:value-chain-and-component-integration ,
        nist:intellectual-property .

atlas:over-or-under-reliance
    skos:broadMatch nist:human-ai-configuration .

atlas:data-bias
    skos:broadMatch nist:harmful-bias-and-homogenization .

atlas:unrepresentative-data
    skos:broadMatch nist:harmful-bias-and-homogenization ;
