    rdfs:seeAlso <https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/poor-model-accuracy.html> .

atlas:redundant-actions-agentic a nexus:Risk ;
    skos:prefLabel "Redundant actions" ;
    skos:definition "Unnecessary or repeated actions may waste computation, increase cost, and reduce system efficiency." ;
    skos:broader atlas:computational-inefficiency ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:computational-inefficiency ;
    nexus:tag "redundant-actions-agentic" ;
    nexus:riskType "agentic" ;
    nexus:descriptor "specific to agentic AI" ;
    rdfs:seeAlso <https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/redundant-actions-agentic.html> .

atlas:impact-on-the-environment a nexus:Risk ;
    skos:prefLabel "Impact on the environment" ;
    skos:definition "Training or operating AI systems may increase energy use, water use, or carbon emissions." ;
    skos:broader atlas:societal-impact ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:societal-impact ;
    nexus:tag "impact-on-the-environment" ;
    nexus:riskType "non-technical" ;
    rdfs:seeAlso <https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/impact-on-the-environment.html> .

# Added 2026-10-09: the IBM risks the OWASP -> IBM -> MIT cross-walk in
# data/mappings/ names that were not yet declared, plus the two the ML risk
# patterns cite. Definitions are short PAIR-AI summaries.

atlas:attribute-inference-attack a nexus:Risk ;
    skos:prefLabel "Attribute inference attack" ;
    skos:definition "Repeated queries to a trained model may let an attacker infer sensitive attributes of people whose records were used to train it." ;
    skos:broader atlas:privacy ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:privacy ;
    nexus:tag "attribute-inference-attack" ;
    nexus:riskType "inference" ;
    nexus:descriptor "amplified by generative AI" ;
    rdfs:seeAlso <https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/attribute-inference-attack.html> .

atlas:confidential-information-in-data a nexus:Risk ;
    skos:prefLabel "Confidential information in data" ;
    skos:definition "Confidential information in training or tuning data may be retained by the model and disclosed later." ;
    skos:broader atlas:intellectual-property ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:intellectual-property ;
    nexus:tag "confidential-information-in-data" ;
    nexus:riskType "training-data" ;
    nexus:descriptor "amplified by generative AI" ;
    rdfs:seeAlso <https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/confidential-information-in-data.html> .

atlas:data-acquisition a nexus:Risk ;
    skos:prefLabel "Data acquisition restrictions" ;
    skos:definition "Laws or regulations may limit whether certain kinds of data can be collected for an AI use case." ;
    skos:broader atlas:data-laws ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:data-laws ;
    nexus:tag "data-acquisition" ;
    nexus:riskType "training-data" ;
    nexus:descriptor "amplified by generative AI" ;
    rdfs:seeAlso <https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/data-acquisition.html> .

atlas:data-contamination a nexus:Risk ;
    skos:prefLabel "Data contamination" ;
    skos:definition "Data that does not fit the model's purpose, or that was set aside for testing and evaluation, may end up being used for training." ;
    skos:broader atlas:accuracy ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:accuracy ;
    nexus:tag "data-contamination" ;
    nexus:riskType "training-data" ;
    nexus:descriptor "amplified by generative AI" ;
    rdfs:seeAlso <https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/data-contamination.html> .

atlas:data-provenance a nexus:Risk ;
    skos:prefLabel "Uncertain data provenance" ;
    skos:definition "The origin, ownership, and transformations of data may not be traceable, so its fitness and usage terms cannot be verified." ;
    skos:broader atlas:transparency ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:transparency ;
    nexus:tag "data-provenance" ;
    nexus:riskType "training-data" ;
    nexus:descriptor "amplified by generative AI" ;
    nexus:descriptor "amplified by synthetic data" ;
    rdfs:seeAlso <https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/data-provenance.html> .

atlas:data-usage-rights a nexus:Risk ;
    skos:prefLabel "Data usage rights restrictions" ;
    skos:definition "Licences, terms of service, or other intellectual-property terms may restrict using certain data to build models." ;
    skos:broader atlas:intellectual-property ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:intellectual-property ;
    nexus:tag "data-usage-rights" ;
    nexus:riskType "training-data" ;
    nexus:descriptor "amplified by generative AI" ;
    rdfs:seeAlso <https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/data-usage-rights.html> .

atlas:harmful-code-generation a nexus:Risk ;
    skos:prefLabel "Harmful code generation" ;
    skos:definition "A model may generate code that causes harm or affects other systems in unintended ways." ;
    skos:broader atlas:value-alignment ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:value-alignment ;
    nexus:tag "harmful-code-generation" ;
