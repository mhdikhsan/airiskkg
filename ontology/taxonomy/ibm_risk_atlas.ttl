atlas:data-poisoning a nexus:Risk ;
    skos:prefLabel "Data poisoning" ;
    skos:definition "An adversary or malicious insider injects intentionally corrupted, false, misleading, or incorrect samples into the training or fine-tuning datasets." ;
    skos:broader atlas:robustness ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:robustness ;
    nexus:tag "data-poisoning" ;
