    rdfs:seeAlso <https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/harmful-code-generation.html> .

atlas:improper-retraining a nexus:Risk ;
    skos:prefLabel "Improper retraining" ;
    skos:definition "Undesirable model output or user content reused for retraining may degrade or distort later model behaviour." ;
    skos:broader atlas:value-alignment ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:value-alignment ;
    nexus:tag "improper-retraining" ;
    nexus:riskType "training-data" ;
    nexus:descriptor "amplified by generative AI" ;
