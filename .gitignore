.env
.vscode/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
pytest-cache-files-*/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/
docs/

# Personal local notes (kept on disk, not shared)
CHANGELOG_data_model.md

# Keep folder structure, but avoid committing generated research outputs by default.
# assessment_runner writes each run to outputs/output_<n>/, so a top-level glob
# alone never matched them and 1.9 MB of generated Turtle ended up tracked.
outputs/*.ttl
outputs/output_*/
data/processed/**
!data/processed/
!data/processed/.gitkeep
!data/processed/outputs/
!data/processed/outputs/.gitkeep
