        <http://w3id.org/airiskkg/example/onyx-danswer#GeneratorLLM> ;
    pair:hasSatisfiedCondition pat:ImproperOutputHandling_UnvalidatedOutputCondition,
        owasp:condition-llm-output-used-without-validation ;
    pair:hasSuggestedControl pat:Control_Guardrails,
