    pair:generatedByMotif pat:DirectPromptingMotif ;
    pair:generatedFromMatch <http://w3id.org/airiskkg/generated/motif-match/direct-prompting/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fonyx-danswer%23GenerateAnswer/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fonyx-danswer%23RephrasedQuery/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fonyx-danswer%23CitedAnswer> ;
    pair:hasCandidateRiskTaxonomyEntry atlas:evasion-attack,
        mit:subdomain-1-2,
        mit:subdomain-2-2,
        mit:subdomain-7-3,
        owasp:llm05-improper-output-handling ;
    pair:hasDerivedMechanism owasp:mechanism-unsafe-output-propagation ;
    pair:hasEvidence <http://w3id.org/airiskkg/example/onyx-danswer#CitedAnswer>,
