<http://w3id.org/airiskkg/generated/risk-finding/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fgenerated%2Fmotif-match%2Fdirect-prompting%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fonyx-danswer%2523GenerateAnswer%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fonyx-danswer%2523RephrasedQuery%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fonyx-danswer%2523CitedAnswer/improper-output-handling> a pair:RiskFinding ;
    rdfs:label "Candidate improper LLM output handling"@en ;
    dct:description "A user-facing LLM output is produced without a represented output validation, sanitization, or guardrail step."@en ;
