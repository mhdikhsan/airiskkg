@prefix atlas: <http://w3id.org/airiskkg/taxonomy/ibm-risk-atlas#> .
@prefix beam: <http://w3id.org/beam/core#> .
@prefix beamr: <http://w3id.org/beam/risk#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix mit: <http://w3id.org/airiskkg/taxonomy/mit-ai-risk#> .
@prefix mitctrl: <http://w3id.org/airiskkg/taxonomy/mit-ai-risk-control#> .
@prefix nexus: <http://w3id.org/airiskkg/taxonomy/nexus#> .
@prefix owasp: <http://w3id.org/airiskkg/taxonomy/owasp-llm#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pair: <http://w3id.org/airiskkg/pair-ai#> .
@prefix pat: <http://w3id.org/airiskkg/patterns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/airiskkg/example/verba-goldenverba#> a owl:Ontology ;
    dct:description "Architecture graph for the goldenverba package in Weaviate Verba, modeled as a public document Q&A RAG workflow with ingestion, chunking, embedding, Weaviate retrieval, prompt construction, and answer generation."@en ;
    dct:source <https://github.com/weaviate/Verba/blob/main/README.md>,
        <https://github.com/weaviate/Verba/blob/main/goldenverba/components/retriever/WindowRetriever.py>,
        <https://github.com/weaviate/Verba/blob/main/goldenverba/verba_manager.py>,
        <https://github.com/weaviate/Verba/tree/main/goldenverba> ;
    dct:title "Verba Goldenverba RAG Application Use Case"@en ;
    vann:preferredNamespacePrefix "verba" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/example/verba-goldenverba#" ;
    owl:imports pair:,
        beam: .

<http://w3id.org/airiskkg/example/verba-goldenverba#VerbaSystem> a beam:System ;
    rdfs:label "Verba goldenverba public RAG chatbot"@en ;
    beam:context "Open-source RAG application that ingests user supplied documents, stores chunks and vectors in Weaviate, retrieves relevant context for a public user query, and generates an answer with a selected LLM provider."@en ;
    beam:hasProcess <http://w3id.org/airiskkg/example/verba-goldenverba#BuildRAGPrompt>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#IndexChunksInWeaviate>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ReadDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RetrieveRelevantChunks> ;
    beam:hasResource <http://w3id.org/airiskkg/example/verba-goldenverba#Answer>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkEmbeddings>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#DocumentChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#EmbeddedQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#GeneratorModel>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ParsedDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ProviderCredentials>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#PublicQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGPrompt>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RetrievedChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#WeaviateVectorStore> .

<http://w3id.org/airiskkg/facets#hasAutonomyLevel> a owl:ObjectProperty ;
    rdfs:label "has autonomy level"@en ;
    rdfs:comment "Intended values: concepts of the aut:AutonomyLevel scheme (ontology/facets/autonomy.ttl)."@en ;
    rdfs:domain beam:System ;
    rdfs:range skos:Concept .

<http://w3id.org/airiskkg/facets#hasDataDynamism> a owl:ObjectProperty ;
    rdfs:label "has data dynamism"@en ;
    rdfs:comment "Intended values: concepts of the dataf:DataDynamism scheme (ontology/facets/data_facets.ttl)."@en ;
    rdfs:domain beam:Data ;
    rdfs:range skos:Concept .

<http://w3id.org/airiskkg/facets#hasDataProvenance> a owl:ObjectProperty ;
    rdfs:label "has data provenance"@en ;
    rdfs:comment "Intended values: concepts of the dataf:DataProvenance scheme (ontology/facets/data_facets.ttl). Where a concept has a DPV counterpart (dpv:ObservedData, dpv:ProvidedData, dpv:DerivedData, dpv:SyntheticData in the DPV personal_data module) the scheme links it via skos:closeMatch (Rule R3)."@en ;
    rdfs:domain beam:Data ;
    rdfs:range skos:Concept .

<http://w3id.org/airiskkg/facets#hasDataRights> a owl:ObjectProperty ;
    rdfs:label "has data rights"@en ;
    rdfs:comment "Intended values: concepts of the dataf:DataRights scheme (ontology/facets/data_facets.ttl)."@en ;
    rdfs:domain beam:Data ;
    rdfs:range skos:Concept .

<http://w3id.org/airiskkg/facets#hasDeploymentSetting> a owl:ObjectProperty ;
    rdfs:label "has deployment setting"@en ;
    rdfs:comment "Intended values: concepts of the ctx:DeploymentSetting scheme (ontology/facets/context.ttl)."@en ;
    rdfs:domain beam:System ;
    rdfs:range skos:Concept .

<http://w3id.org/airiskkg/facets#hasDomain> a owl:ObjectProperty ;
    rdfs:label "has domain"@en ;
    rdfs:comment "Intended values: concepts of the ctx:Domain scheme (ontology/facets/context.ttl) or referenced external sector vocabularies."@en ;
    rdfs:domain beam:System ;
    rdfs:range skos:Concept .

<http://w3id.org/airiskkg/facets#hasIdentifiabilityLevel> a owl:ObjectProperty ;
    rdfs:label "has identifiability level"@en ;
    dct:source <https://w3id.org/dpv/2.3/modules/personal_data> ;
    rdfs:comment "Degree of identifiability of the data with respect to natural persons; the identifiability axis of facet:hasPersonalDataCategory. Intended values are DPV concepts reused directly (Rule R3: reference DPV URIs, never copy definitions locally), all part of the DPV personal_data module. Verified against DPV v2.3 (https://w3id.org/dpv#, 2026-07-13): dpv:IdentifyingPersonalData (explicitly identifies a person by itself), dpv:PseudonymisedData, dpv:AnonymisedData, dpv:ContextuallyAnonymisedData. Note: DPV defines no concept named 'IdentifiedData'; dpv:IdentifyingPersonalData is the closest verified equivalent."@en ;
    rdfs:domain beam:Data ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf <http://w3id.org/airiskkg/facets#hasPersonalDataCategory> .

<http://w3id.org/airiskkg/facets#hasImplementationType> a owl:ObjectProperty ;
    rdfs:label "has implementation type"@en ;
    rdfs:comment "Intended values: concepts of the impl:ImplementationType scheme (ontology/facets/implementation_type.ttl). Facet counterpart to the deliberate absence of beam:Model implementation subclasses."@en ;
    rdfs:domain beam:Model ;
    rdfs:range skos:Concept .

<http://w3id.org/airiskkg/facets#hasPurpose> a owl:ObjectProperty ;
    rdfs:label "has purpose"@en ;
    rdfs:comment "Intended values: DPV purpose concepts (dpv:Purpose and narrower; Rule R3) or concepts of the ctx:Purpose scheme (ontology/facets/context.ttl)."@en ;
    rdfs:domain beam:System ;
    rdfs:range skos:Concept .

<http://w3id.org/airiskkg/facets#hasTaskCategory> a owl:ObjectProperty ;
    rdfs:label "has task category"@en ;
    rdfs:comment "Intended values: concepts of the task:AITask scheme (ontology/facets/task.ttl). Rule R7: task is a separate axis from capability and application type."@en ;
    rdfs:domain beam:Task ;
    rdfs:range skos:Concept .

<http://w3id.org/airiskkg/facets/autonomy#HighActionAutonomy> a skos:Concept ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems." ;
    skos:altLabel "HOOTL"@en ;
    skos:definition "The system executes actions autonomously without human supervision of individual actions (human-out-of-the-loop)."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/autonomy#AutonomyLevel> ;
    skos:prefLabel "High Action Autonomy (human-out-of-the-loop)"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/autonomy#AutonomyLevel> .

<http://w3id.org/airiskkg/facets/autonomy#LowActionAutonomy> a skos:Concept ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems." ;
    skos:altLabel "HITL"@en ;
    skos:definition "The system can propose or initiate actions, but each action requires explicit human approval before it takes effect (human-in-the-loop)."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/autonomy#AutonomyLevel> ;
    skos:prefLabel "Low Action Autonomy (human-in-the-loop)"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/autonomy#AutonomyLevel> .

<http://w3id.org/airiskkg/facets/autonomy#MediumActionAutonomy> a skos:Concept ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems." ;
    skos:altLabel "HOTL"@en ;
    skos:definition "The system executes actions autonomously while a human supervises and can intervene or override in near real time (human-on-the-loop)."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/autonomy#AutonomyLevel> ;
    skos:prefLabel "Medium Action Autonomy (human-on-the-loop)"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/autonomy#AutonomyLevel> .

<http://w3id.org/airiskkg/facets/autonomy#NoActionAutonomy> a skos:Concept ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems." ;
    skos:definition "The system produces outputs (predictions, recommendations, content) but takes no actions itself; all actions are performed by humans."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/autonomy#AutonomyLevel> ;
    skos:prefLabel "No Action Autonomy"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/autonomy#AutonomyLevel> .

<http://w3id.org/airiskkg/facets/context#Domain> a skos:ConceptScheme ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems (Economic Context dimension); DPV sector extensions, https://w3id.org/dpv/sector" ;
    skos:definition "Application domain / economic sector in which the AI system operates (e.g. healthcare, finance, education). Extension point: concrete domain concepts are added per use case; prefer referencing DPV sector extensions (e.g. dpv-sector) or NACE codes rather than redefining."@en ;
    skos:prefLabel "Domain"@en .

<http://w3id.org/airiskkg/facets/context#InternalTool> a skos:Concept ;
    dct:source "expert curation" ;
    skos:definition "The system is used only inside an organization by authenticated members."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/context#DeploymentSetting> ;
    skos:prefLabel "Internal Tool"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/context#DeploymentSetting> .

<http://w3id.org/airiskkg/facets/context#PublicFacingService> a skos:Concept ;
    dct:source "expert curation" ;
    skos:definition "The system is exposed to the general public (unauthenticated or self-registered users)."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/context#DeploymentSetting> ;
    skos:prefLabel "Public-Facing Service"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/context#DeploymentSetting> .

<http://w3id.org/airiskkg/facets/context#Purpose> a skos:ConceptScheme ;
    dct:source "DPV v2.3 concept dpv:Purpose, https://w3id.org/dpv#Purpose (verified 2026-07-13)" ;
    skos:definition "Purpose for which the AI system (or a processing step) is operated. DPV defines an extensive purpose taxonomy; concrete values should reuse DPV purpose concepts directly (Rule R3: reference, never copy)."@en ;
    skos:exactMatch <https://w3id.org/dpv#Purpose> ;
    skos:prefLabel "Purpose"@en .

<http://w3id.org/airiskkg/facets/context#SafetyCriticalEnvironment> a skos:Concept ;
    dct:source "expert curation" ;
    skos:definition "System failures can directly endanger health, safety, or critical infrastructure."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/context#DeploymentSetting> ;
    skos:prefLabel "Safety-Critical Environment"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/context#DeploymentSetting> .

<http://w3id.org/airiskkg/facets/data#DerivedData> a skos:Concept ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems." ;
    skos:closeMatch <https://w3id.org/dpv#DerivedData> ;
    skos:definition "Data produced from other data by processing, aggregation, or inference (e.g. embeddings, features, profiles)."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/data#DataProvenance> ;
    skos:prefLabel "Derived Data"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/data#DataProvenance> .

<http://w3id.org/airiskkg/facets/data#ExpertInput> a skos:Concept ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems." ;
    skos:definition "Data encoding human expert knowledge (e.g. rules, labels, curated knowledge) provided by domain experts."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/data#DataProvenance> ;
    skos:prefLabel "Expert Input"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/data#DataProvenance> .

<http://w3id.org/airiskkg/facets/data#ObservedData> a skos:Concept ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems." ;
    skos:closeMatch <https://w3id.org/dpv#ObservedData> ;
    skos:definition "Data captured by observing behavior or the environment (e.g. logs, sensor readings, click streams), not deliberately provided."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/data#DataProvenance> ;
    skos:prefLabel "Observed Data"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/data#DataProvenance> .

<http://w3id.org/airiskkg/facets/data#PeriodicallyUpdated> a skos:Concept ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems." ;
    skos:definition "The data resource is refreshed at discrete intervals (e.g. nightly re-indexing, scheduled retraining data pulls)."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/data#DataDynamism> ;
    skos:prefLabel "Periodically Updated"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/data#DataDynamism> .

<http://w3id.org/airiskkg/facets/data#Personal> a skos:Concept ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems." ;
    skos:definition "Data relating to identified or identifiable natural persons, subject to data-protection law. This concept only flags the rights status; for the kind of personal data use DPV concepts directly via facet:hasPersonalDataCategory, and for the degree of identifiability via facet:hasIdentifiabilityLevel (Rule R3), not this scheme."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/data#DataRights> ;
    skos:prefLabel "Personal"@en ;
    skos:relatedMatch <https://w3id.org/dpv#PersonalData> ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/data#DataRights> .

<http://w3id.org/airiskkg/facets/data#Proprietary> a skos:Concept ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems." ;
    skos:definition "Data owned or licensed by an organization with restricted use rights."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/data#DataRights> ;
    skos:prefLabel "Proprietary"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/data#DataRights> .

<http://w3id.org/airiskkg/facets/data#ProvidedData> a skos:Concept ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems." ;
    skos:closeMatch <https://w3id.org/dpv#ProvidedData> ;
    skos:definition "Data deliberately provided by data subjects or users (e.g. form input, uploads, user prompts)."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/data#DataProvenance> ;
    skos:prefLabel "Provided Data"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/data#DataProvenance> .

<http://w3id.org/airiskkg/facets/data#Public> a skos:Concept ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems." ;
    skos:definition "Data available for public use (e.g. open data, public web content), subject to its license terms."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/data#DataRights> ;
    skos:prefLabel "Public"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/data#DataRights> .

<http://w3id.org/airiskkg/facets/data#RealTimeUpdated> a skos:Concept ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems." ;
    skos:definition "The data resource changes continuously during operation (e.g. live feeds, streaming ingestion, online learning input)."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/data#DataDynamism> ;
    skos:prefLabel "Real-Time Updated"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/data#DataDynamism> .

<http://w3id.org/airiskkg/facets/data#Static> a skos:Concept ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems." ;
    skos:definition "The data resource is fixed after creation; it does not change during operation."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/data#DataDynamism> ;
    skos:prefLabel "Static"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/data#DataDynamism> .

<http://w3id.org/airiskkg/facets/data#SyntheticData> a skos:Concept ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems." ;
    skos:closeMatch <https://w3id.org/dpv#SyntheticData> ;
    skos:definition "Artificially generated data (e.g. simulation output, generative-model output used as data)."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/data#DataProvenance> ;
    skos:prefLabel "Synthetic Data"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/data#DataProvenance> .

<http://w3id.org/airiskkg/facets/implementation-type#ImplementationType> a skos:ConceptScheme ;
    dct:source "PAIR-AI glossary v1.1, Section A.3" ;
    skos:definition "Classification of a model's implementation: architecture family, technique, or hosting form. Extension point: concrete values are added per use case or when the paper's implementation-type taxonomy is settled."@en ;
    skos:prefLabel "Implementation Type"@en .

<http://w3id.org/airiskkg/generated/risk-finding/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fgenerated%2Fmotif-match%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523EmbedChunks%2Fembeddings%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523ParsedDocument%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523WeaviateVectorStore/data-model-poisoning> a pair:RiskFinding ;
    rdfs:label "Candidate data or model poisoning exposure"@en ;
    dct:description "Untrusted content is used in an embedding, indexing, fine-tuning, or training path that can affect model or retrieval behavior."@en ;
    pair:findingStatus "candidate" ;
    pair:generatedByMotif pat:EmbeddingsMotif ;
    pair:generatedFromMatch <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore> ;
    pair:hasCandidateRiskTaxonomyEntry atlas:data-curation,
        mit:subdomain-1-3,
        mit:subdomain-2-2,
        mit:subdomain-7-3,
        owasp:llm04-data-and-model-poisoning ;
    pair:hasDerivedMechanism owasp:mechanism-data-or-model-poisoning ;
    pair:hasEvidence <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkEmbeddings>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#DocumentChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ParsedDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#WeaviateVectorStore> ;
    pair:hasSatisfiedCondition pat:Poisoning_UntrustedTrainingOrIndexingDataCondition,
        owasp:condition-untrusted-data-enters-training-finetuning-or-indexing ;
    pair:hasSuggestedControl pat:Control_LoggingMonitoringAndEvals,
        pat:Control_ModelAndDependencyProvenance,
        pat:Control_TrustedTrainingAndIndexingData,
        mitctrl:data-curation-process,
        mitctrl:data-governance,
        mitctrl:model-infrastructure-security,
        mitctrl:testing-auditing,
        mitctrl:threat-modelling .

<http://w3id.org/airiskkg/generated/risk-finding/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fgenerated%2Fmotif-match%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523EmbedChunks%2Fembeddings%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523ParsedDocument%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523WeaviateVectorStore/prompt-injection> a pair:RiskFinding ;
    rdfs:label "Candidate prompt injection exposure"@en ;
    dct:description "Untrusted user or retrieved content can enter LLM prompt or generation context."@en ;
    pair:findingStatus "candidate" ;
    pair:generatedByMotif pat:EmbeddingsMotif ;
    pair:generatedFromMatch <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore> ;
    pair:hasCandidateRiskTaxonomyEntry atlas:prompt-injection,
        mit:subdomain-2-2,
        mit:subdomain-4-3,
        owasp:llm01-prompt-injection ;
    pair:hasDerivedMechanism owasp:mechanism-instruction-override ;
    pair:hasEvidence <http://w3id.org/airiskkg/example/verba-goldenverba#Answer>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#GeneratorModel>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#WeaviateVectorStore> ;
    pair:hasSatisfiedCondition pat:PromptInjection_UntrustedPromptContextCondition,
        owasp:condition-retrieved-content-enters-generation-context,
        owasp:condition-untrusted-input-enters-prompt-context ;
    pair:hasSuggestedControl pat:Control_Guardrails,
        pat:Control_InputValidationAndPromptIsolation,
        pat:Control_LoggingMonitoringAndEvals,
        mitctrl:input-output-filtering,
        mitctrl:red-teaming,
        mitctrl:retrieval-source-filtering,
        mitctrl:threat-modelling .

<http://w3id.org/airiskkg/generated/risk-finding/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fgenerated%2Fmotif-match%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523EmbedChunks%2Fembeddings%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523ParsedDocument%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523WeaviateVectorStore/vector-embedding-weakness> a pair:RiskFinding ;
