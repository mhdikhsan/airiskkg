    rdfs:subClassOf beam:Data .

beam:contain a owl:TransitiveProperty ;
    rdfs:label "contain" ;
    rdfs:domain beam:Element ;
    rdfs:range beam:Element .

beam:context a owl:DatatypeProperty ;
    rdfs:label "context" ;
    rdfs:domain beam:System ;
    rdfs:range xsd:String .

beam:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:domain beam:System ;
    rdfs:range xsd:String .

beam:hasAgent a owl:ObjectProperty ;
    rdfs:label "has agent" ;
    rdfs:domain beam:System ;
    rdfs:range beam:Agent .

beam:hasProcess a owl:ObjectProperty ;
    rdfs:label "has process" ;
    rdfs:domain beam:System ;
    rdfs:range beam:Process .

beam:hasResource a owl:ObjectProperty ;
    rdfs:label "has resource" ;
    rdfs:domain beam:System ;
    rdfs:range beam:Resource .

beam:note a owl:ObjectProperty ;
    rdfs:label "note" ;
    rdfs:domain beam:Element ;
    rdfs:range beam:Note .

beam:participatedIn a owl:ObjectProperty ;
    rdfs:label "participated in" ;
    rdfs:domain beam:Agent ;
    rdfs:range beam:Process .

beam:performedBy a owl:ObjectProperty ;
    rdfs:label "performed by" ;
    rdfs:domain beam:Task ;
    rdfs:range beam:Element ;
    owl:inverseOf beam:perform .

beam:producedBy a owl:ObjectProperty ;
    rdfs:label "produced by" ;
    rdfs:domain beam:Resource ;
    rdfs:range beam:Process ;
    owl:inverseOf beam:produce .

beamr:associatedTo a owl:ObjectProperty ;
    rdfs:label "associated to" ;
    rdfs:domain beamr:RiskControl ;
    rdfs:range beam:Element .

beamr:hasConsequence a owl:ObjectProperty ;
    rdfs:label "has consequence" ;
    rdfs:domain beamr:Risk ;
    rdfs:range beamr:Consequence ;
    rdfs:subPropertyOf <https://w3id.org/airohasConsequence> .

beamr:hasImpact a owl:ObjectProperty ;
    rdfs:label "has impact" ;
    rdfs:domain beamr:Consequence ;
    rdfs:range beamr:Impact ;
    rdfs:subPropertyOf <https://w3id.org/airohasImpact> .

beamr:hasRisk a owl:ObjectProperty ;
    rdfs:label "has risk" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( beam:Element beam:Task ) ] ;
    rdfs:range beamr:Risk .

beamr:isRiskSourceFor a owl:ObjectProperty ;
    rdfs:label "is risk source for" ;
    rdfs:domain beamr:RiskSource ;
    rdfs:range beamr:Risk ;
    rdfs:subPropertyOf <https://w3id.org/airoisRiskSourceFor> .

beamr:modifiesRiskConcept a owl:ObjectProperty ;
    rdfs:label "modifies risk concept" ;
    rdfs:domain beamr:RiskControl ;
    rdfs:range beamr:RiskConcept ;
    rdfs:subPropertyOf <https://w3id.org/airomodifiesRiskConcept> .

beamr:originatedFrom a owl:ObjectProperty ;
    rdfs:label "originated from" ;
    rdfs:domain beamr:RiskSource ;
    rdfs:range beam:Element .

<http://w3id.org/airiskkg/example/verba-goldenverba#ProviderCredential> a pair:DataCategory ;
    rdfs:label "Provider credential"@en ;
    pair:subDataCategoryOf pair:ConfidentialInformation .

<http://w3id.org/airiskkg/facets> a owl:Ontology ;
    dct:description "Object properties attaching characterization facet values (SKOS concepts) to BEAM architecture elements. Facet assignments are annotated base facts supplied by the modeler (Rule R8); they characterize elements and are read by applicability conditions, never traversed by motifs (Rule R2). Ranges are deliberately kept at skos:Concept: the intended scheme is stated in the comment, not enforced with OWL axioms (lightweight by design)."@en ;
    dct:title "PAIR-AI Characterization Facet Attachment Properties"@en ;
    vann:preferredNamespacePrefix "facet" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/facets#" ;
    owl:imports beam: .

<http://w3id.org/airiskkg/facets#hasPersonalDataCategory> a owl:ObjectProperty ;
    rdfs:label "has personal data category"@en ;
    dct:source <https://w3id.org/dpv/2.3/modules/personal_data> ;
    rdfs:comment "Kind of (non-)personal data an element contains, expressed directly as DPV concepts (Rule R3: reference DPV URIs, never copy definitions locally). Intended values are the dpv:Data hierarchy of the DPV personal_data module, verified against DPV v2.3 (2026-07-15): dpv:PersonalData and narrower (dpv:SensitivePersonalData, dpv:SpecialCategoryPersonalData, dpv:IdentifyingPersonalData, dpv:CollectedPersonalData, dpv:DerivedPersonalData, dpv:InferredPersonalData, dpv:GeneratedPersonalData), and dpv:NonPersonalData (incl. dpv:AnonymisedData). For fine-grained categories (health, financial, etc.) use the DPV-PD extension concepts (https://w3id.org/dpv/pd#)."@en ;
    rdfs:domain beam:Data ;
    rdfs:range skos:Concept .

<http://w3id.org/airiskkg/facets/autonomy> a owl:Ontology ;
    dct:description "SKOS concept scheme classifying the action autonomy of an AI system (Rule R1: facet values are SKOS concepts, never OWL classes to instantiate). Assigned to a beam:System via facet:hasAutonomyLevel; read by applicability conditions, never matched by motifs (Rule R2)."@en ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems. OECD Digital Economy Papers, No. 323. https://doi.org/10.1787/cb6d9eca-en" ;
    dct:title "PAIR-AI Characterization Facet: Autonomy Level"@en ;
    vann:preferredNamespacePrefix "aut" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/facets/autonomy#" .

<http://w3id.org/airiskkg/facets/context> a owl:Ontology ;
    dct:description "SKOS concept schemes for situational context of an AI system (Rule R1). These are deliberately thin extension points: concrete domains, purposes, and deployment settings are added per use case or drawn from external vocabularies. Where DPV has an equivalent, the DPV URI is referenced via SKOS mapping instead of being redefined (Rule R3). Context facets enter assessment only through applicability conditions (Rule R2)."@en ;
    dct:source "DPV v2.3, https://w3id.org/dpv# (verified 2026-07-13); OECD (2022). OECD Framework for the Classification of AI Systems." ;
    dct:title "PAIR-AI Characterization Facets: Context (Domain, Purpose, Deployment Setting)"@en ;
    vann:preferredNamespacePrefix "ctx" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/facets/context#" .

<http://w3id.org/airiskkg/facets/data> a owl:Ontology ;
    dct:description "SKOS concept schemes classifying data resources of an AI system (Rule R1). Assigned to beam:Data via facet:hasDataProvenance / hasDataDynamism / hasDataRights; read by applicability conditions, never matched by motifs (Rule R2). Data identifiability is deliberately NOT defined here: DPV concepts are reused directly (Rule R3, see facet_properties.ttl). The Data Category facet (glossary A.3) is also NOT defined here: it lives in the pattern module (pair:DataCategoryScheme, assigned via pair:containsDataCategory) because its values are propagated along data flow by registered queries (Rule R8, derived facts) - see ontology/core/pair_ai_pattern.ttl."@en ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems. OECD Digital Economy Papers, No. 323. https://doi.org/10.1787/cb6d9eca-en" ;
    dct:title "PAIR-AI Characterization Facets: Data Provenance, Dynamism, Rights"@en ;
    vann:preferredNamespacePrefix "dataf" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/facets/data#" .

<http://w3id.org/airiskkg/facets/implementation-type> a owl:Ontology ;
    dct:description "SKOS concept scheme (extension point) classifying HOW a model is implemented (e.g. architecture family, hosting form). This is the facet counterpart to the deliberate absence of beam:Model subclasses beyond Semantic/Statistical (Rule R1 + Task 4 decision: implementation types are classification values, not query-traversed structure). Assigned via facet:hasImplementationType; read by applicability conditions only (Rule R2)."@en ;
    dct:source "PAIR-AI glossary v1.1, Section A.3 (Implementation Type listed as characterization facet)" ;
    dct:title "PAIR-AI Characterization Facet: Implementation Type"@en ;
    vann:preferredNamespacePrefix "impl" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/facets/implementation-type#" .

<http://w3id.org/airiskkg/facets/task> a owl:Ontology ;
    dct:description "SKOS concept scheme implementing the PAIR-AI unified task taxonomy: the functional input-to-output relation performed by a functional unit (Rule R1). Assigned via facet:hasTaskCategory. Rule R7: Task, Capability (VAIR), and Application Type (OECD) are three separate axes, SKOS-mapped, never merged. NOTE: no mapping to the TUEV AI.ST taxonomy is included; its license/citability is unverified (on hold)."@en ;
    dct:source "PAIR-AI unified task taxonomy (expert curation); OECD (2022). OECD Framework for the Classification of AI Systems (Task & Output dimension)." ;
    dct:title "PAIR-AI Characterization Facet: AI Task"@en ;
    vann:preferredNamespacePrefix "task" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/facets/task#" .

