pair:AggregationStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step aggregating results from multiple searches."@en ;
    skos:prefLabel "AggregationStep"@en .

pair:Alert a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "An alert raised by a monitoring step."@en ;
    skos:prefLabel "Alert"@en .

pair:BatchDataset a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A dataset processed in batch."@en ;
    skos:prefLabel "BatchDataset"@en .

pair:ChunkingStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that splits documents into chunks."@en ;
    skos:prefLabel "ChunkingStep"@en .

pair:ConfidentialInformation a pair:DataCategory ;
    dct:source "expert curation; DPV v2.3 dpv:ConfidentialData (verified 2026-07-13)" ;
    pair:subDataCategoryOf pair:Information ;
    skos:definition "Content that must be kept secret for operational or business reasons (credentials, keys, internal configuration). Deliberately NOT a subcategory of SensitiveInformation: sensitive-data conditions target personal/organizational harm, not secrets management."@en ;
    skos:inScheme pair:DataCategoryScheme ;
    skos:prefLabel "Confidential Information"@en ;
    skos:relatedMatch <https://w3id.org/dpv#ConfidentialData> .

pair:ControlStep a pair:PatternRole ;
    skos:definition "A step in the workflow of an AI system that is specifically designed to implement a risk control or mitigation strategy, such as a fairness check, anomaly detection, or human review."@en ;
    skos:prefLabel "Control Step"@en .

pair:DataCategoryPropagation a owl:Class ;
    rdfs:label "Data Category Propagation"@en ;
    skos:definition "Marker output type for pattern implementations that infer pair:containsDataCategory facts (e.g. untrusted-content taint) from roles and data flow, rather than requiring every element to be hand-tagged."@en .

pair:DocumentChunk a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A chunk of a source document used for embedding/retrieval."@en ;
    skos:prefLabel "DocumentChunk"@en .

pair:ExpectedOutput a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A reference/expected output used in evaluation."@en ;
    skos:prefLabel "ExpectedOutput"@en .

pair:FastPredictionStep a pair:PatternRole ;
    pair:subRoleOf pair:PredictionStep ;
    skos:definition "A low-latency prediction step."@en ;
    skos:prefLabel "FastPredictionStep"@en .

pair:FineTunedModel a pair:PatternRole ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model produced by fine-tuning a pre-trained model on task-specific data."@en ;
    skos:prefLabel "Fine-tuned Model"@en .

pair:FineTuningDataset a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A dataset used to fine-tune a model."@en ;
    skos:prefLabel "FineTuningDataset"@en .

pair:FineTuningStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that fine-tunes a pre-trained model."@en ;
    skos:prefLabel "FineTuningStep"@en .

pair:GeneratedContent a pair:DataCategory ;
    dct:source "expert curation; DPV v2.3 dpv:GeneratedData (verified 2026-07-13)" ;
    pair:subDataCategoryOf pair:Information ;
    skos:definition "Content produced by a generative model rather than authored or retrieved."@en ;
    skos:inScheme pair:DataCategoryScheme ;
    skos:prefLabel "Generated Content"@en ;
    skos:relatedMatch <https://w3id.org/dpv#GeneratedData> .

pair:GuardrailDecision a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A decision (allow/block) produced by a guardrail step."@en ;
    skos:prefLabel "GuardrailDecision"@en .

pair:ImageBuildStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that builds a serving image."@en ;
    skos:prefLabel "ImageBuildStep"@en .

pair:InputGuardrailStep a pair:PatternRole ;
    pair:subRoleOf pair:GuardrailStep ;
    skos:definition "A guardrail step screening user input before generation."@en ;
    skos:prefLabel "InputGuardrailStep"@en .

pair:JudgeModel a pair:PatternRole ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model used to score or evaluate the output of another model (LLM-as-judge)."@en ;
    skos:prefLabel "Judge Model"@en .

pair:KeywordIndex a pair:PatternRole ;
    pair:subRoleOf pair:KnowledgeSource ;
    skos:definition "A keyword/text index used for lexical search."@en ;
    skos:prefLabel "KeywordIndex"@en .

pair:KeywordSearchStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step performing keyword/lexical search."@en ;
    skos:prefLabel "KeywordSearchStep"@en .

pair:LoggingStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that logs predictions or events."@en ;
    skos:prefLabel "LoggingStep"@en .

pair:ModelLoadStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that loads a model into a runtime."@en ;
    skos:prefLabel "ModelLoadStep"@en .

pair:MonitoringBaseline a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A baseline used by a monitoring step."@en ;
    skos:prefLabel "MonitoringBaseline"@en .

pair:MonitoringStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that monitors a deployed model."@en ;
    skos:prefLabel "MonitoringStep"@en .

pair:OutputGuardrailStep a pair:PatternRole ;
    pair:subRoleOf pair:GuardrailStep ;
    skos:definition "A guardrail step screening model output before release."@en ;
    skos:prefLabel "OutputGuardrailStep"@en .

pair:PredictionQueue a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A queue holding prediction requests."@en ;
    skos:prefLabel "PredictionQueue"@en .

pair:PretrainedModel a pair:PatternRole ;
    pair:subRoleOf pair:Model ;
    skos:definition "A pre-trained foundation model prior to task-specific adaptation."@en ;
    skos:prefLabel "Pre-trained Model"@en .

pair:PropertyPathCondition a owl:Class ;
    rdfs:label "Property Path Condition"@en ;
    rdfs:comment "An applicability condition evaluated via a SPARQL property path (e.g. reachability of untrusted content to a generation step)."@en ;
    rdfs:subClassOf pair:ApplicabilityCondition .

pair:PublicUserFacingOutput a pair:PatternRole ;
    pair:subRoleOf pair:UserFacingOutput ;
    skos:definition "User-facing output exposed to the public, such as a chatbot response or public-facing summary."@en ;
    skos:prefLabel "Public User-Facing Output"@en .

pair:QueryReformulationStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that reformulates a query."@en ;
    skos:prefLabel "QueryReformulationStep"@en .

pair:ReleaseApproval a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "An approval artifact gating a release."@en ;
    skos:prefLabel "ReleaseApproval"@en .

pair:RerankedContext a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "Reranked, selected context fragments for generation."@en ;
    skos:prefLabel "RerankedContext"@en .

pair:RerankingStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that reranks retrieved candidates."@en ;
    skos:prefLabel "RerankingStep"@en .

pair:RewrittenQuery a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A reformulated query produced by a query rewriting step."@en ;
    skos:prefLabel "RewrittenQuery"@en .

pair:SanitizedOutput a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "Output that has passed an output guardrail/sanitization step."@en ;
    skos:prefLabel "SanitizedOutput"@en .

pair:ScoringStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that scores a model output during evaluation."@en ;
    skos:prefLabel "ScoringStep"@en .

pair:SensitiveInformation a pair:DataCategory ;
    dct:source "expert curation; DPV v2.3 dpv:SensitivePersonalData (verified 2026-07-13)" ;
    pair:subDataCategoryOf pair:Information ;
    skos:definition "Content whose exposure can harm individuals or organizations (personal, medical, financial, or otherwise protection-worthy information). Root category traversed by sensitive-data applicability conditions."@en ;
    skos:inScheme pair:DataCategoryScheme ;
    skos:prefLabel "Sensitive Information"@en ;
    skos:relatedMatch <https://w3id.org/dpv#SensitivePersonalData> .

pair:SlowPredictionStep a pair:PatternRole ;
    pair:subRoleOf pair:PredictionStep ;
    skos:definition "A higher-latency prediction step."@en ;
    skos:prefLabel "SlowPredictionStep"@en .

pair:SourceDocument a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A source document ingested into a knowledge base."@en ;
    skos:prefLabel "SourceDocument"@en .

pair:TrainingPipeline a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A pipeline orchestrating model training."@en ;
    skos:prefLabel "TrainingPipeline"@en .

pair:VectorSearchStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step performing vector similarity search."@en ;
    skos:prefLabel "VectorSearchStep"@en .

pair:hasApplicabilityCondition a owl:ObjectProperty ;
    rdfs:label "has applicability condition"@en ;
    rdfs:comment "Links an AI risk pattern to a risk-relevant applicability condition that a motif match must satisfy before a candidate risk finding is emitted. Formerly pair:hasInterpretationCondition."@en ;
    rdfs:domain pair:RiskPattern ;
    rdfs:range pair:ApplicabilityCondition .

pair:hasDerivedMechanism a owl:ObjectProperty ;
    rdfs:label "has derived mechanism"@en ;
    rdfs:comment "Links a candidate risk finding to the risk mechanism selected from the satisfied AI risk pattern. Mechanisms are selected at assessment time, never invented. Formerly pair:hasInterpretedMechanism."@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range pair:RiskMechanism .

pair:hasEvidence a owl:ObjectProperty ;
    rdfs:label "has evidence"@en ;
    rdfs:comment "Attaches the evidence of a candidate risk finding: the elements of the matched subgraph that triggered the finding. Evidence is retained for durable traceability (PROV spirit). DESIGN DECISION: evidence is represented as the set of matched architecture elements (one pair:hasEvidence triple per element), matching how findings were already materialized; a named-graph representation was rejected as more disruptive. Replaces the former pair:EvidenceSubgraph class design and the pair:hasEvidenceElement property."@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range rdfs:Resource .

pair:hasMechanism a owl:ObjectProperty ;
    rdfs:label "has mechanism"@en ;
    rdfs:comment "Links an AI risk pattern to its curated risk mechanism: the causal account of how or why the configuration is disposed toward harm. Formerly pair:interpretedAsMechanism."@en ;
    rdfs:domain pair:RiskPattern ;
    rdfs:range pair:RiskMechanism .

pair:hasRiskPattern a owl:ObjectProperty ;
    rdfs:label "has risk pattern"@en ;
    rdfs:comment "Links a risk-neutral graph motif to an AI risk pattern that extends it with risk semantics. Formerly pair:hasInterpretation."@en ;
    rdfs:domain pair:GraphMotif ;
    rdfs:range pair:RiskPattern ;
    owl:inverseOf pair:hasMotif .

pair:implementsRiskPattern a owl:ObjectProperty ;
    rdfs:label "implements risk pattern"@en ;
    rdfs:comment "Links an executable SPARQL implementation to the AI risk pattern it evaluates. Formerly pair:implementsInterpretation."@en ;
    rdfs:domain pair:PatternImplementation ;
    rdfs:range pair:RiskPattern .

