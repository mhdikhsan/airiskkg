atlas:accuracy a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Accuracy" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

atlas:computational-inefficiency a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Computational inefficiency" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

atlas:data-laws a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Data laws" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

atlas:fairness a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Fairness" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

atlas:governance a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Governance" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

atlas:impact-on-the-environment a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:risk-disclosure,
        mitctrl:societal-impact-assessment ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:societal-impact ;
    nexus:riskType "non-technical" ;
    nexus:tag "impact-on-the-environment" ;
    skos:broader atlas:societal-impact ;
    skos:closeMatch mit:subdomain-6-6 ;
    skos:definition "Training or operating AI systems may increase energy use, water use, or carbon emissions." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Impact on the environment" .

atlas:intellectual-property a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Intellectual property" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

atlas:prompt-leaking a nexus:Risk ;
    nexus:descriptor "specific to generative AI" ;
    nexus:hasRelatedControl mitctrl:input-output-filtering,
        mitctrl:red-teaming,
        mitctrl:system-architecture-documentation ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:robustness-prompt-attacks ;
    nexus:riskType "inference" ;
    nexus:tag "prompt-leaking" ;
    skos:broadMatch mit:subdomain-2-2 ;
    skos:broader atlas:robustness-prompt-attacks ;
    skos:closeMatch owasp:llm07-system-prompt-leakage ;
    skos:definition "An attacker may attempt to extract system prompts or hidden instructions from a model." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Prompt leaking" .

atlas:robustness-model-behavior-manipulation a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:broader atlas:robustness ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Robustness: model behavior manipulation" .

atlas:societal-impact a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Societal impact" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

mit:domain-3 a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Misinformation" ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:domain-4 a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Malicious Actors & Misuse" ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:domain-6 a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Socioeconomic & Environmental" ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:subdomain-1-2 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:content-safety-controls,
        mitctrl:input-output-filtering,
        mitctrl:red-teaming ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-1 ;
    skos:broader mit:domain-1 ;
    skos:definition "AI may expose users to harmful, abusive, unsafe, or inappropriate content." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Exposure to toxic content" .

mit:subdomain-5-2 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:access-management,
        mitctrl:human-oversight-protocol,
        mitctrl:risk-register ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-5 ;
    skos:broader mit:domain-5 ;
    skos:definition "AI systems may reduce human control, agency, or autonomy in decision-making." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Loss of human agency and autonomy" .

mitctrl:pre-deployment-risk-assessment a nexus:RiskControl ;
    nexus:controlType "governance" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment" ;
    nexus:mitigatesRiskTaxonomyEntry owasp:llm03-supply-chain ;
    skos:broader mitctrl:risk-management,
        mitctrl:staged-deployment ;
    skos:definition "Assessment of risks before deployment or before expanding system access." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Pre-deployment Risk Assessment" .

owasp:condition-externally-sourced-model-data-or-dependency a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm03-supply-chain ;
    skos:prefLabel "Externally sourced model, data, component, or provider is used"@en .

owasp:condition-generation-without-grounding-or-verification a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm09-misinformation ;
    skos:prefLabel "Generation occurs without sufficient grounding, source attribution, or verification"@en .

owasp:condition-hidden-instructions-in-prompt-context a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm07-system-prompt-leakage ;
    skos:prefLabel "Hidden instructions or system configuration are present in prompt context"@en .

owasp:condition-llm-can-trigger-tools-or-state-changes a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm06-excessive-agency ;
    skos:prefLabel "LLM can trigger tools, permissions, transactions, or state changes"@en .

owasp:condition-llm-output-used-without-validation a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm05-improper-output-handling ;
    skos:prefLabel "LLM output is used without validation or sanitization"@en .

owasp:condition-unbounded-prompt-retrieval-tool-or-model-use a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm10-unbounded-consumption ;
    skos:prefLabel "Prompt, retrieval, tool, or model use is not bounded by cost, rate, or loop controls"@en .

owasp:mechanism-excessive-agency-action-execution a pair:RiskMechanism ;
    rdfs:label "Excessive agency action execution"@en ;
    dct:description "An LLM-driven component can invoke tools, alter state, access resources, or trigger external actions beyond intended limits or oversight."@en ;
    nexus:mechanismForRisk owasp:llm06-excessive-agency .

owasp:mechanism-supply-chain-compromise a pair:RiskMechanism ;
    rdfs:label "Compromised LLM supply chain dependency"@en ;
    dct:description "A model, dataset, dependency, plugin, provider, or deployment artifact is compromised, unverifiable, or insufficiently governed."@en ;
    nexus:mechanismForRisk owasp:llm03-supply-chain .

owasp:mechanism-system-prompt-exposure a pair:RiskMechanism ;
    rdfs:label "System prompt exposure"@en ;
    dct:description "Hidden instructions, policies, tool schemas, or operational configuration become visible through output, context, logs, or adversarial interaction."@en ;
    nexus:mechanismForRisk owasp:llm07-system-prompt-leakage .

owasp:mechanism-unbounded-resource-consumption a pair:RiskMechanism ;
    rdfs:label "Unbounded resource consumption"@en ;
    dct:description "Prompt size, retrieval breadth, tool loops, model calls, or user traffic exceed intended cost, latency, rate, or availability limits."@en ;
    nexus:mechanismForRisk owasp:llm10-unbounded-consumption .

owasp:mechanism-unsafe-output-propagation a pair:RiskMechanism ;
    rdfs:label "Unsafe generated output propagation"@en ;
    dct:description "LLM output is treated as trusted content or executable instruction without adequate validation, escaping, review, or constraint."@en ;
    nexus:mechanismForRisk owasp:llm05-improper-output-handling .

beam:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:subClassOf beam:Element,
        <https://kastle-lab.org/easy-ai2/Actor> .

beam:Generate a owl:Class ;
    rdfs:label "Generate" ;
    rdfs:subClassOf beam:Process .

beam:Instance a owl:Class ;
    rdfs:label "Instance" ;
    rdfs:subClassOf beam:Resource,
        <https://kastle-lab.org/easy-ai2/Artifact> .

beamr:RiskSource a owl:Class ;
    rdfs:label "Risk Source" ;
    rdfs:subClassOf beamr:RiskConcept,
        <https://w3id.org/airoRiskSource> .

<http://w3id.org/airiskkg/example/verba-goldenverba#RAGPrompt> a beam:Data ;
    rdfs:label "RAG prompt with retrieved context"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedSensitiveKnowledgeBaseContent>,
        pair:ExternalUserContent,
        pair:PromptInstruction,
        pair:UntrustedContent ;
    pair:playsRole pair:PromptTemplate ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer> .

<http://w3id.org/airiskkg/example/verba-goldenverba#ReadDocument> a beam:Transform ;
    rdfs:label "Read uploaded document"@en ;
    beam:inform <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkDocument> ;
    beam:produce <http://w3id.org/airiskkg/example/verba-goldenverba#ParsedDocument> ;
    beam:use <http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedDocument> .

<http://w3id.org/airiskkg/facets/task#AnomalyAndEventDetection> a skos:Concept ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:definition "Detecting deviations, events, or state changes in data streams or collections."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/task#AITask> ;
    skos:narrower <http://w3id.org/airiskkg/facets/task#DriftDetection>,
        <http://w3id.org/airiskkg/facets/task#FraudDetection>,
        <http://w3id.org/airiskkg/facets/task#OutlierDetection> ;
    skos:prefLabel "Anomaly and Event Detection"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/task#AITask> .

<http://w3id.org/airiskkg/facets/task#DecisionOptimizationControl> a skos:Concept ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:definition "Selecting actions, allocating resources, or controlling processes toward goals under constraints."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/task#AITask> ;
    skos:narrower <http://w3id.org/airiskkg/facets/task#DecisionSupport>,
        <http://w3id.org/airiskkg/facets/task#ProcessControl>,
        <http://w3id.org/airiskkg/facets/task#ResourceOptimization> ;
    skos:prefLabel "Decision, Optimization, and Control"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/task#AITask> .

<http://w3id.org/airiskkg/facets/task#InteractionAndDialogue> a skos:Concept ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:definition "Conducting multi-turn interaction with users or other agents in natural language or other modalities."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/task#AITask> ;
    skos:narrower <http://w3id.org/airiskkg/facets/task#AgentToolUse>,
        <http://w3id.org/airiskkg/facets/task#ConversationalAssistance>,
        <http://w3id.org/airiskkg/facets/task#TaskOrientedDialogue> ;
    skos:prefLabel "Interaction and Dialogue"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/task#AITask> .

<http://w3id.org/airiskkg/facets/task#PersonalizationAndProfiling> a skos:Concept ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:definition "Adapting outputs to individuals or groups based on inferred characteristics, preferences, or behavior."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/task#AITask> ;
    skos:narrower <http://w3id.org/airiskkg/facets/task#ContentPersonalization>,
        <http://w3id.org/airiskkg/facets/task#Recommendation>,
        <http://w3id.org/airiskkg/facets/task#UserProfiling> ;
    skos:prefLabel "Personalization and Profiling"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/task#AITask> .

<http://w3id.org/airiskkg/facets/task#PredictionAndForecasting> a skos:Concept ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:definition "Estimating unknown values or future states from historical or contextual data."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/task#AITask> ;
    skos:narrower <http://w3id.org/airiskkg/facets/task#Classification>,
        <http://w3id.org/airiskkg/facets/task#Regression>,
        <http://w3id.org/airiskkg/facets/task#TimeSeriesForecasting> ;
    skos:prefLabel "Prediction and Forecasting"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/task#AITask> .

<http://w3id.org/airiskkg/facets/task#ReasoningOverKnowledge> a skos:Concept ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:definition "Deriving conclusions from structured knowledge (ontologies, knowledge graphs, rules) or combining knowledge with learned models."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/task#AITask> ;
    skos:narrower <http://w3id.org/airiskkg/facets/task#DeductiveReasoning>,
        <http://w3id.org/airiskkg/facets/task#KnowledgeGraphCompletion>,
        <http://w3id.org/airiskkg/facets/task#QuestionAnsweringOverKnowledge> ;
    skos:prefLabel "Reasoning over Knowledge"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/task#AITask> .

<http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore> a pair:MotifMatch ;
    rdfs:label "Embeddings motif match"@en ;
    pair:hasNodeBinding <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/chunking-step>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/document-chunk>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/embedding-step>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/embedding-vector>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/source-document>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/vector-index> ;
    pair:matchesMotif pat:EmbeddingsMotif .

<http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrieveRelevantChunks/vector-ir/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbeddedQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrievedChunks> a pair:MotifMatch ;
    rdfs:label "Vector-based information retrieval motif match"@en ;
    pair:hasNodeBinding <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrieveRelevantChunks/vector-ir/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbeddedQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrievedChunks/binding/query>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrieveRelevantChunks/vector-ir/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbeddedQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrievedChunks/binding/retrieval-step>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrieveRelevantChunks/vector-ir/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbeddedQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrievedChunks/binding/retrieved-result>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrieveRelevantChunks/vector-ir/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbeddedQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrievedChunks/binding/vector-store> ;
    pair:matchesMotif pat:VectorBasedInformationRetrievalMotif .

pair:DeploymentStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that deploys a model to serving."@en ;
    skos:prefLabel "DeploymentStep"@en .

pair:ExternalUserContent a pair:DataCategory ;
    dct:source "expert curation" ;
    pair:subDataCategoryOf pair:Information ;
    skos:definition "Content originating from a user outside the system boundary (queries, uploads, chat messages). Deliberately NOT a subcategory of UntrustedContent: untrusted-content taint is derived from roles and flow by the propagation queries, not implied by this category."@en ;
    skos:inScheme pair:DataCategoryScheme ;
    skos:prefLabel "External User Content"@en .

pair:KnowledgeSource a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A source of information that an AI system can access, such as a database, knowledge graph, or external API."@en ;
    skos:prefLabel "Knowledge Source"@en .

pair:LLMResponse a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A response produced by a generative model prior to output screening."@en ;
    skos:prefLabel "LLMResponse"@en .

pair:LoadedModel a pair:PatternRole ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model instance loaded into a serving runtime."@en ;
    skos:prefLabel "Loaded Model"@en .

pair:PreprocessedData a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "Data produced by a preprocessing step."@en ;
    skos:prefLabel "PreprocessedData"@en .

pair:PreprocessingStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that preprocesses input data."@en ;
    skos:prefLabel "PreprocessingStep"@en .

pair:PromptTemplate a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A prompt template combining instructions and inputs."@en ;
    skos:prefLabel "PromptTemplate"@en .

pair:VectorIndex a pair:PatternRole ;
    pair:subRoleOf pair:KnowledgeSource ;
    skos:definition "An index over embedding vectors."@en ;
    skos:prefLabel "VectorIndex"@en .

pat:AsyncPred_EnqueueStepNode a pair:PatternNode ;
    rdfs:label "Prediction request enqueue step node"@en ;
    pair:expectedClass beam:Process .

pat:AsyncPred_PredictionStepNode a pair:PatternNode ;
    rdfs:label "Asynchronous prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:PredictionStep .

pat:AsyncPred_QueueNode a pair:PatternNode ;
    rdfs:label "Prediction queue node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionQueue .

pat:BatchTrain_ModelArtifactNode a pair:PatternNode ;
    rdfs:label "Trained model artifact node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:ModelArtifact .

pat:BatchTrain_TrainingDataNode a pair:PatternNode ;
    rdfs:label "Prepared training data node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PreprocessedData .

pat:Control_InputValidationAndPromptIsolation a beamr:RiskControl ;
    dct:description "Validate, constrain, and isolate user, retrieved, and tool-supplied content before it enters the prompt context."@en ;
    skos:prefLabel "Input validation and prompt isolation"@en ;
    skos:relatedMatch mitctrl:input-output-filtering,
        mitctrl:prompt-context-limiting .

pat:Control_ModelAndDependencyProvenance a beamr:RiskControl ;
    dct:description "Track, verify, and govern models, datasets, plugins, dependencies, and deployment artifacts used by the LLM application."@en ;
    skos:prefLabel "Model and dependency provenance"@en ;
    skos:relatedMatch mitctrl:model-infrastructure-security,
        mitctrl:risk-register,
        mitctrl:system-architecture-documentation .

pat:Embedding_SourceDocumentNode a pair:PatternNode ;
    rdfs:label "Embedding source document node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:SourceDocument .

pat:Embedding_VectorIndexNode a pair:PatternNode ;
    rdfs:label "Vector index node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:VectorIndex .

pat:FineTune_FineTunedModelNode a pair:PatternNode ;
    rdfs:label "Fine-tuned model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:FineTunedModel .

pat:Guardrails_RawResponseNode a pair:PatternNode ;
    rdfs:label "Raw LLM response node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:LLMResponse .

pat:Guardrails_UserPromptNode a pair:PatternNode ;
    rdfs:label "Guardrails user prompt node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:Hybrid_QueryNode a pair:PatternNode ;
    rdfs:label "Hybrid retriever query node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:ModelImage_DeploymentStepNode a pair:PatternNode ;
    rdfs:label "Model-in-image deployment step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:DeploymentStep .

pat:ModelImage_ModelArtifactNode a pair:PatternNode ;
    rdfs:label "Model-in-image model artifact node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:ModelArtifact .

pat:ModelImage_ServingImageNode a pair:PatternNode ;
    rdfs:label "Serving image containing model node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:ServingImage .

pat:ModelImage_TrainingStepNode a pair:PatternNode ;
    rdfs:label "Model-in-image training step node"@en ;
    pair:expectedClass beam:Train ;
    pair:expectedRole pair:TrainingStep .

pat:ModelLoad_LoadedModelNode a pair:PatternNode ;
    rdfs:label "Loaded model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:LoadedModel .

pat:ModelLoad_PredictionStepNode a pair:PatternNode ;
    rdfs:label "Model-load prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:PredictionStep .

pat:MultiStage_RequestNode a pair:PatternNode ;
    rdfs:label "Multi-stage prediction request node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionRequest .

pat:PipeTrain_IntermediateDataNode a pair:PatternNode ;
    rdfs:label "Pipeline intermediate data node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PreprocessedData .

pat:PipeTrain_ModelArtifactNode a pair:PatternNode ;
    rdfs:label "Pipeline model artifact node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:ModelArtifact .

pat:PredLog_RequestNode a pair:PatternNode ;
    rdfs:label "Logged prediction request node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionRequest .

pat:PredLog_ResultNode a pair:PatternNode ;
    rdfs:label "Logged prediction result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PredictionResult .

pat:PrepPred_PreprocessedDataNode a pair:PatternNode ;
    rdfs:label "Preprocessed data node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PreprocessedData .

pat:PromptInjection_UntrustedPromptContextCondition a pair:ApplicabilityCondition ;
    rdfs:label "Untrusted content enters prompt context"@en ;
    pair:operationalizesRiskCondition owasp:condition-retrieved-content-enters-generation-context,
        owasp:condition-untrusted-input-enters-prompt-context .

pat:QueryRewrite_RewrittenQueryNode a pair:PatternNode ;
    rdfs:label "Rewritten query node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:RewrittenQuery .

pat:RAG_PromptNode a pair:PatternNode ;
    rdfs:label "RAG composed prompt node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PromptTemplate .

pat:RAG_QueryNode a pair:PatternNode ;
    rdfs:label "RAG query node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:RAG_QueryVectorNode a pair:PatternNode ;
    rdfs:label "RAG query vector node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:EmbeddingVector .

pat:RAG_RetrievedContextNode a pair:PatternNode ;
    rdfs:label "RAG retrieved context node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:RetrievedContext .

pat:SensitiveDataRetrievalExposureRiskPattern a pair:RiskPattern ;
    rdfs:label "Sensitive data retrieval exposure risk pattern"@en ;
    dct:source <https://genai.owasp.org/resource/owasp-top-10-for-llm-applications-2025/> ;
    pair:derivedFrom owasp:llm02-sensitive-information-disclosure ;
    pair:hasApplicabilityCondition pat:SensitiveInfo_OutputExposureCondition,
        pat:SensitiveInfo_SensitiveContextCondition,
        pat:VectorEmbeddingWeakness_RetrievalCondition ;
    pair:hasMechanism owasp:mechanism-sensitive-data-propagation ;
    pair:hasMotif pat:RetrievalAugmentedGenerationMotif ;
    pair:implementedBy pat:SensitiveDataRetrievalExposureOQP ;
    pair:mayIndicateRisk atlas:exposing-personal-information,
        mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure ;
    pair:suggestedControl pat:Control_DataMinimizationAndRedaction,
        pat:Control_Guardrails,
        pat:Control_OutputValidationAndSanitization,
        pat:Control_RetrievalAccessControl,
        mitctrl:access-management,
        mitctrl:data-governance,
        mitctrl:data-minimization,
        mitctrl:input-output-filtering,
        mitctrl:privacy-control-for-user-data,
        mitctrl:redaction,
        mitctrl:retrieval-source-filtering .

pat:SensitiveInfo_OutputExposureCondition a pair:ApplicabilityCondition ;
    rdfs:label "Generated output can expose sensitive information"@en ;
    pair:operationalizesRiskCondition owasp:condition-generated-output-exposed-to-user .

pat:SystemPromptLeakageRiskPattern a pair:RiskPattern ;
    rdfs:label "System prompt leakage risk pattern"@en ;
    dct:source <https://genai.owasp.org/resource/owasp-top-10-for-llm-applications-2025/> ;
    pair:derivedFrom owasp:llm07-system-prompt-leakage ;
    pair:hasApplicabilityCondition pat:SensitiveInfo_OutputExposureCondition,
        pat:SystemPromptLeakage_HiddenInstructionCondition ;
    pair:hasMechanism owasp:mechanism-system-prompt-exposure ;
    pair:implementedBy pat:SystemPromptLeakageOQP ;
    pair:mayIndicateRisk atlas:confidential-data-in-prompt,
        atlas:prompt-leaking,
        mit:subdomain-2-1,
        mit:subdomain-2-2,
        mit:subdomain-7-4,
        owasp:llm07-system-prompt-leakage ;
    pair:suggestedControl pat:Control_Guardrails,
        pat:Control_OutputValidationAndSanitization,
        pat:Control_SystemPromptSecrecy,
        mitctrl:input-output-filtering,
        mitctrl:privacy-control-for-user-data,
        mitctrl:prompt-context-limiting,
        mitctrl:red-teaming,
        mitctrl:system-architecture-documentation .

pat:TrainServe_ApprovalNode a pair:PatternNode ;
    rdfs:label "Release approval node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:ReleaseApproval .

pat:TrainServe_DeployedModelNode a pair:PatternNode ;
    rdfs:label "Deployed model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:LoadedModel .

pat:TrainServe_PredictionStepNode a pair:PatternNode ;
    rdfs:label "Production prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:PredictionStep .

pat:TrainServe_TrainingStepNode a pair:PatternNode ;
    rdfs:label "Train-then-serve training step node"@en ;
    pair:expectedClass beam:Train ;
    pair:expectedRole pair:TrainingStep .

pat:TrainToServe_DeployedModelNode a pair:PatternNode ;
    rdfs:label "Automatically deployed model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:LoadedModel .

pat:TrainToServe_ModelArtifactNode a pair:PatternNode ;
    rdfs:label "Automatically trained model artifact node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:ModelArtifact .

pat:TrainToServe_PredictionStepNode a pair:PatternNode ;
    rdfs:label "Training-to-serving prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:PredictionStep .

pat:TrainToServe_TrainingPipelineNode a pair:PatternNode ;
    rdfs:label "Automated training pipeline node"@en ;
    pair:expectedClass beam:Train ;
    pair:expectedRole pair:TrainingPipeline .

pat:VectorIR_QueryNode a pair:PatternNode ;
    rdfs:label "Query node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:VectorIR_RetrievedResultNode a pair:PatternNode ;
    rdfs:label "Retrieved result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:RetrievedContext .

pat:VectorIR_VectorStoreNode a pair:PatternNode ;
    rdfs:label "Vector store node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:VectorStore .

atlas:evasion-attack a nexus:Risk ;
    nexus:descriptor "traditional risk of AI" ;
    nexus:hasRelatedControl mitctrl:model-safety-engineering,
        mitctrl:red-teaming,
        mitctrl:threat-modelling ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:robustness-model-behavior-manipulation ;
    nexus:riskType "inference" ;
    nexus:tag "evasion-attack" ;
    skos:broadMatch mit:subdomain-2-2,
        mit:subdomain-7-3 ;
    skos:broader atlas:robustness-model-behavior-manipulation ;
    skos:definition "Inputs may be modified to cause a trained model to produce incorrect results." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Evasion attack" ;
    skos:relatedMatch owasp:llm05-improper-output-handling .

atlas:personal-information-in-data a nexus:Risk ;
    nexus:descriptor "traditional risk of AI" ;
    nexus:hasRelatedControl mitctrl:data-curation-process,
        mitctrl:data-governance,
        mitctrl:privacy-control-for-user-data ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:privacy ;
    nexus:riskType "training-data" ;
    nexus:tag "personal-information-in-data" ;
    skos:broadMatch mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure ;
    skos:broader atlas:privacy ;
    skos:definition "Personal or sensitive information in training, tuning, or retrieval data can increase unwanted disclosure risks." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Personal information in data" .

atlas:personal-information-in-prompt a nexus:Risk ;
    nexus:descriptor "specific to generative AI" ;
    nexus:hasRelatedControl mitctrl:input-output-filtering,
        mitctrl:privacy-control-for-user-data,
        mitctrl:prompt-context-limiting ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:privacy ;
    nexus:riskType "inference" ;
    nexus:tag "personal-information-in-prompt" ;
    skos:broadMatch mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure ;
    skos:broader atlas:privacy ;
    skos:definition "Personal or sensitive personal information may be included in prompts and become exposed through model outputs." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Personal information in prompt" .

mit:subdomain-6-6 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:post-deployment-behavior-monitoring,
        mitctrl:prompt-context-limiting,
        mitctrl:risk-disclosure,
        mitctrl:societal-impact-assessment ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-6 ;
    skos:broader mit:domain-6 ;
    skos:definition "AI development or operation may contribute to environmental harm through resource use or emissions." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Environmental harm" .

mitctrl:risk-management a nexus:RiskControlGroup ;
    nexus:controlType "governance" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "design-time",
        "development" ;
    skos:broader mitctrl:governance-oversight-controls ;
    skos:definition """\r
    Systematic methods that identify, evaluate, document, and manage AI risks.\r
    Examples include risk registers, pre-deployment risk assessments, independent\r
    risk assessments, and enterprise risk management frameworks.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Risk Management" .

mitctrl:societal-impact-assessment a nexus:RiskControlGroup ;
    nexus:controlType "governance" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "design-time" ;
    skos:broader mitctrl:governance-oversight-controls ;
    skos:definition """\r
    Processes that assess the societal effects of AI systems, including impacts on\r
    employment, power relations, rights, and affected stakeholders.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Societal Impact Assessment" .

mitctrl:technical-security-controls a nexus:RiskControlGroup ;
    nexus:controlType "technical" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:definition """\r
    Technical, physical, and engineering safeguards that secure AI systems and constrain\r
    model behavior to support safety, security, alignment, and content integrity.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Technical & Security Controls" ;
    skos:topConceptOf mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy .

nexus:RiskTaxonomy a owl:Class ;
    rdfs:label "Risk Taxonomy" ;
    rdfs:comment "A taxonomy that organizes AI risks or AI-related vulnerabilities." ;
    rdfs:subClassOf nexus:Taxonomy .

nexus:Taxonomy a owl:Class ;
    rdfs:label "Taxonomy" ;
    rdfs:comment "A structured concept scheme, such as IBM AI Risk Atlas, MIT AI Risk Repository, OWASP LLM Top 10, or MIT AI Risk Mitigation Taxonomy." ;
    rdfs:subClassOf skos:ConceptScheme .

owasp:condition-sensitive-data-in-context a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm02-sensitive-information-disclosure ;
    skos:prefLabel "Sensitive data is present in prompt or retrieval context"@en .

owasp:condition-untrusted-data-enters-training-finetuning-or-indexing a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm04-data-and-model-poisoning ;
    skos:prefLabel "Untrusted data enters training, fine-tuning, evaluation, or indexing"@en .

owasp:mechanism-data-or-model-poisoning a pair:RiskMechanism ;
    rdfs:label "Data or model poisoning"@en ;
    dct:description "Training, fine-tuning, evaluation, or retrieval/indexing data is manipulated so model behavior or retrieved context becomes attacker-influenced or unreliable."@en ;
    nexus:mechanismForRisk owasp:llm04-data-and-model-poisoning .

owasp:mechanism-sensitive-data-propagation a pair:RiskMechanism ;
    rdfs:label "Sensitive data propagation through LLM context"@en ;
    dct:description "Sensitive information enters prompt, retrieval context, model output, logs, or downstream application flows where it may be disclosed."@en ;
    nexus:mechanismForRisk owasp:llm02-sensitive-information-disclosure .

owasp:mechanism-unsupported-generation a pair:RiskMechanism ;
    rdfs:label "Unsupported or ungrounded generation"@en ;
    dct:description "The LLM produces plausible but unsupported or misleading content because grounding, verification, source quality, or task boundaries are insufficient."@en ;
    nexus:mechanismForRisk owasp:llm09-misinformation .

beam:Model a owl:Class ;
    rdfs:label "Model" ;
    rdfs:subClassOf beam:Resource,
        <https://kastle-lab.org/easy-ai2/Model> .

beamr: a owl:Ontology ;
    dct:description "  A beam extension to describe the risk components of AI systems based on existing concepts defined in the AI Risk Ontology (AIRO)."@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0> ;
    dct:modified "2025-03-05" ;
    dct:title "The BEAM Risk extension"@en ;
    vann:preferredNamespacePrefix "beamr" ;
    vann:preferredNamespaceUri "http://w3id.org/beam/risk#" ;
    owl:imports <https://w3id.org/airo>,
        <https://w3id.org/beam/core#> ;
    owl:versionInfo "0.1.0" .

beamr:Consequence a owl:Class ;
    rdfs:label "Consequence" ;
    rdfs:subClassOf beamr:RiskConcept,
        <https://w3id.org/airoConsequence> .

<http://w3id.org/airiskkg/example/verba-goldenverba#EmbedQuestion> a beam:Transform ;
    rdfs:label "Embed chat question"@en ;
    pair:playsRole pair:EmbeddingStep ;
    beam:inform <http://w3id.org/airiskkg/example/verba-goldenverba#RetrieveRelevantChunks> ;
    beam:produce <http://w3id.org/airiskkg/example/verba-goldenverba#EmbeddedQuestion> ;
    beam:use <http://w3id.org/airiskkg/example/verba-goldenverba#ProviderCredentials>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#PublicQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration> .

<http://w3id.org/airiskkg/example/verba-goldenverba#IndexChunksInWeaviate> a beam:Transform ;
    rdfs:label "Index chunks in Weaviate"@en ;
    beam:produce <http://w3id.org/airiskkg/example/verba-goldenverba#WeaviateVectorStore> ;
    beam:use <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkEmbeddings>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#DocumentChunks> .

<http://w3id.org/airiskkg/example/verba-goldenverba#ProviderCredentials> a beam:Data ;
    rdfs:label "Provider API credentials"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#ProviderCredential> ;
    pair:playsRole pair:ExternalProviderCredential ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer> .

<http://w3id.org/airiskkg/example/verba-goldenverba#PublicQuestion> a beam:Data ;
    rdfs:label "Public chat question"@en ;
    pair:containsDataCategory pair:ExternalUserContent ;
    pair:playsRole pair:PublicUserInput ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#BuildRAGPrompt>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer> .

<http://w3id.org/airiskkg/facets/task#PerceptionAndRecognition> a skos:Concept ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:definition "Recognizing patterns, objects, or structure in unstructured input signals (images, audio, text, sensor data)."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/task#AITask> ;
    skos:narrower <http://w3id.org/airiskkg/facets/task#ImageClassification>,
        <http://w3id.org/airiskkg/facets/task#NamedEntityRecognition>,
        <http://w3id.org/airiskkg/facets/task#ObjectDetection>,
        <http://w3id.org/airiskkg/facets/task#SpeechRecognition> ;
    skos:prefLabel "Perception and Recognition"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/task#AITask> .

<http://w3id.org/airiskkg/facets/task#RetrievalAndRanking> a skos:Concept ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:definition "Finding and ordering relevant items from a collection given an information need (search, retrieval, reranking)."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/task#AITask> ;
    skos:narrower <http://w3id.org/airiskkg/facets/task#DocumentRetrieval>,
        <http://w3id.org/airiskkg/facets/task#QueryReformulation>,
        <http://w3id.org/airiskkg/facets/task#Reranking>,
        <http://w3id.org/airiskkg/facets/task#VectorSimilaritySearch> ;
    skos:prefLabel "Retrieval and Ranking"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/task#AITask> .

pair: a owl:Ontology ;
    dct:description "Pattern-level vocabulary for constructing the PAIR-AI AI Risk Knowledge Graph."@en ;
    dct:title "PAIR-AI Pattern Module Ontology"@en ;
    vann:preferredNamespacePrefix "pair" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/pair-ai#" ;
    owl:imports beam:,
        beamr: .

pair:EmbeddingStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that produces embeddings from data."@en ;
    skos:prefLabel "EmbeddingStep"@en .

pair:EvaluationStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that evaluates model behavior."@en ;
    skos:prefLabel "EvaluationStep"@en .

pair:FoundationLLM a pair:PatternRole ;
    pair:subRoleOf pair:Model ;
    skos:definition "A foundation large language model used directly for generation."@en ;
    skos:prefLabel "Foundation LLM"@en .

pair:GenerationStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that runs a generative model to produce output."@en ;
    skos:prefLabel "GenerationStep"@en .

pair:RetrievalStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that retrieves fragments from a knowledge source."@en ;
    skos:prefLabel "RetrievalStep"@en .

pair:TrainingStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that trains a model."@en ;
    skos:prefLabel "TrainingStep"@en .

pat:BatchTrain_EvaluationStepNode a pair:PatternNode ;
    rdfs:label "Model evaluation step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:EvaluationStep .

pat:Control_OutputValidationAndSanitization a beamr:RiskControl ;
    dct:description "Validate, encode, sanitize, or review model output before it is used by users, tools, or downstream systems."@en ;
    skos:prefLabel "Output validation and sanitization"@en ;
    skos:relatedMatch mitctrl:content-safety-controls,
        mitctrl:input-output-filtering .

pat:DP_GenerationStepNode a pair:PatternNode ;
    rdfs:label "Direct LLM generation step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:GenerationStep .

pat:Embedding_ChunkingStepNode a pair:PatternNode ;
    rdfs:label "Document chunking step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:ChunkingStep .

pat:Embedding_DocumentChunkNode a pair:PatternNode ;
    rdfs:label "Document chunk node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:DocumentChunk .

pat:Embedding_VectorNode a pair:PatternNode ;
    rdfs:label "Embedding vector node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:EmbeddingVector .

pat:FineTune_EvaluationStepNode a pair:PatternNode ;
    rdfs:label "Fine tuning evaluation step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:EvaluationStep .

pat:Guardrails_InputGuardrailStepNode a pair:PatternNode ;
    rdfs:label "Input guardrail step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:InputGuardrailStep .

pat:Guardrails_OutputGuardrailStepNode a pair:PatternNode ;
    rdfs:label "Output guardrail step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:OutputGuardrailStep .

pat:Hybrid_AggregationNode a pair:PatternNode ;
    rdfs:label "Hybrid retriever aggregation step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:AggregationStep .

pat:Hybrid_KeywordSearchNode a pair:PatternNode ;
    rdfs:label "Keyword search step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:KeywordSearchStep .

pat:Hybrid_VectorSearchNode a pair:PatternNode ;
    rdfs:label "Vector search step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:VectorSearchStep .

pat:ImproperOutputHandlingRiskPattern a pair:RiskPattern ;
    rdfs:label "Improper output handling risk pattern"@en ;
    dct:description """
    Applies to motifs where generated LLM output reaches a user or downstream
    component without a represented validation, sanitization, review, or
    guardrail step.
    """@en ;
    dct:source <https://genai.owasp.org/resource/owasp-top-10-for-llm-applications-2025/> ;
    pair:derivedFrom owasp:llm05-improper-output-handling ;
    pair:hasApplicabilityCondition pat:ImproperOutputHandling_UnvalidatedOutputCondition ;
    pair:hasMechanism owasp:mechanism-unsafe-output-propagation ;
    pair:implementedBy pat:ImproperOutputHandlingOQP ;
    pair:mayIndicateRisk atlas:evasion-attack,
        mit:subdomain-1-2,
        mit:subdomain-2-2,
        mit:subdomain-7-3,
        owasp:llm05-improper-output-handling ;
    pair:suggestedControl pat:Control_Guardrails,
        pat:Control_OutputValidationAndSanitization,
        mitctrl:content-safety-controls,
        mitctrl:human-oversight-protocol,
        mitctrl:incident-response-plan,
        mitctrl:input-output-filtering,
        mitctrl:testing-auditing .

pat:ModelImage_ImageBuildStepNode a pair:PatternNode ;
    rdfs:label "Serving image build step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:ImageBuildStep .

pat:PipeTrain_EvaluationJobNode a pair:PatternNode ;
    rdfs:label "Pipeline evaluation job node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:EvaluationStep .

pat:PipeTrain_PreprocessJobNode a pair:PatternNode ;
    rdfs:label "Pipeline preprocessing job node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:PreprocessingStep .

pat:PredLog_PredictionStepNode a pair:PatternNode ;
    rdfs:label "Logged prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:PredictionStep .

pat:PredMon_MonitoringStepNode a pair:PatternNode ;
    rdfs:label "Prediction monitoring step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:MonitoringStep .

pat:PrepPred_PreprocessStepNode a pair:PatternNode ;
    rdfs:label "Preprocessing step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:PreprocessingStep .

pat:QueryRewrite_RetrievalStepNode a pair:PatternNode ;
    rdfs:label "Retrieval using rewritten query node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:RetrievalStep .

pat:RAG_GenerationStepNode a pair:PatternNode ;
    rdfs:label "RAG generation step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:GenerationStep .

pat:RAG_QueryEmbeddingStepNode a pair:PatternNode ;
    rdfs:label "RAG query embedding step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:EmbeddingStep .

pat:RAG_RetrievalStepNode a pair:PatternNode ;
    rdfs:label "RAG retrieval step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:RetrievalStep .

pat:TrainServe_CandidateModelNode a pair:PatternNode ;
    rdfs:label "Candidate model artifact node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:ModelArtifact .

pat:TrainServe_EvaluationStepNode a pair:PatternNode ;
    rdfs:label "Pre-release evaluation step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:EvaluationStep .

atlas:confidential-data-in-prompt a nexus:Risk ;
    nexus:descriptor "specific to generative AI" ;
    nexus:hasRelatedControl mitctrl:input-output-filtering,
        mitctrl:prompt-context-limiting,
        mitctrl:system-architecture-documentation ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:intellectual-property ;
    nexus:riskType "inference" ;
    nexus:tag "confidential-data-in-prompt" ;
    skos:broadMatch mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure ;
    skos:broader atlas:intellectual-property ;
    skos:definition "Confidential information may be included in prompts and exposed through model interaction or output." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Confidential data in prompt" ;
    skos:relatedMatch owasp:llm07-system-prompt-leakage .

atlas:incomplete-advice a nexus:Risk ;
    nexus:descriptor "specific to generative AI" ;
    nexus:hasRelatedControl mitctrl:human-oversight-protocol,
        mitctrl:retrieval-quality-evaluation,
        mitctrl:system-documentation ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:value-alignment ;
    nexus:riskType "output" ;
    nexus:tag "incomplete-advice" ;
    skos:broader atlas:value-alignment ;
    skos:definition "Generated advice or recommendation may omit important context and lead users to act on incomplete information." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Incomplete advice" ;
    skos:relatedMatch mit:subdomain-3-1,
        mit:subdomain-5-1,
        owasp:llm09-misinformation .

atlas:robustness a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Robustness" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

atlas:robustness-prompt-attacks a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:broader atlas:robustness ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Robustness: prompt attacks" .

atlas:value-alignment a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Value alignment" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

mit:domain-2 a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Privacy & Security" ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:domain-5 a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Human-Computer Interaction" ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:domain-7 a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "AI System Safety, Failures, & Limitations" ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:subdomain-5-1 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:human-oversight-protocol,
        mitctrl:risk-disclosure,
        mitctrl:system-documentation ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-5 ;
    skos:broader mit:domain-5 ;
    skos:definition "Users may place inappropriate trust in AI systems or use them unsafely." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Overreliance and unsafe use" .

mitctrl:governance-oversight-controls a nexus:RiskControlGroup ;
    nexus:controlType "governance" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:definition """\r
    Formal organizational structures and policy frameworks that establish human oversight,\r
    accountability, ethical conduct, and risk management throughout AI development and deployment.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Governance & Oversight Controls" ;
    skos:topConceptOf mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy .

mitctrl:transparency-accountability-controls a nexus:RiskControlGroup ;
    nexus:controlType "transparency-accountability" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:definition """\r
    Disclosure practices and verification mechanisms that communicate AI system information,\r
    support external scrutiny, and enable accountability to users, regulators, and the public.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Transparency & Accountability Controls" ;
    skos:topConceptOf mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy .

owasp:condition-untrusted-input-enters-prompt-context a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm01-prompt-injection ;
    skos:prefLabel "Untrusted input enters prompt context"@en .

owasp:mechanism-instruction-override a pair:RiskMechanism ;
    rdfs:label "Instruction override by untrusted context"@en ;
    dct:description "Untrusted user, retrieved, or tool-supplied content changes model behavior by overriding or conflicting with intended instructions."@en ;
    nexus:mechanismForRisk owasp:llm01-prompt-injection .

owasp:mechanism-vector-embedding-retrieval-weakness a pair:RiskMechanism ;
    rdfs:label "Vector and embedding retrieval weakness"@en ;
    dct:description "Embedding, indexing, chunking, similarity search, source filtering, or ranking causes irrelevant, malicious, stale, or unauthorized context to enter generation."@en ;
    nexus:mechanismForRisk owasp:llm08-vector-and-embedding-weaknesses .

beam:Task a owl:Class ;
    rdfs:label "Task" ;
    rdfs:subClassOf <http://www.w3id.org/agentic-ai/onto#Task> .

beamr:Risk a owl:Class ;
    rdfs:label "Risk" ;
    rdfs:subClassOf beamr:RiskConcept,
        <https://w3id.org/airoRisk> .

beamr:RiskConcept a owl:Class ;
    rdfs:label "Risk Concept" ;
    rdfs:subClassOf <https://w3id.org/airoRiskConcept> .

<http://w3id.org/airiskkg/example/verba-goldenverba#Answer> a beam:Data ;
    rdfs:label "Generated chat answer"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent>,
        pair:GeneratedContent,
        pair:UntrustedContent ;
    pair:playsRole pair:PublicUserFacingOutput .

<http://w3id.org/airiskkg/example/verba-goldenverba#BuildRAGPrompt> a beam:Transform ;
    rdfs:label "Build RAG prompt"@en ;
    pair:playsRole pair:PromptConstructionStep ;
    beam:inform <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer> ;
    beam:produce <http://w3id.org/airiskkg/example/verba-goldenverba#RAGPrompt> ;
    beam:use <http://w3id.org/airiskkg/example/verba-goldenverba#PublicQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RetrievedChunks> .

<http://w3id.org/airiskkg/example/verba-goldenverba#GeneratorModel> a beam:StatisticalModel ;
    rdfs:label "Selected generator model"@en ;
    pair:playsRole pair:ExternalModel,
        pair:GenerativeModel,
        pair:PretrainedModel ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer> .

pair:Information a pair:DataCategory ;
    dct:source "expert curation" ;
    skos:definition "Root category for content-kind classification: informational content handled by the system. Use-case graphs subclass this for domain content (e.g. connected workspace content)."@en ;
    skos:inScheme pair:DataCategoryScheme ;
    skos:prefLabel "Information"@en ;
    skos:topConceptOf pair:DataCategoryScheme .

pair:PredictionRequest a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "An incoming request for a prediction."@en ;
    skos:prefLabel "PredictionRequest"@en .

pat:BatchPred_JobNode a pair:PatternNode ;
    rdfs:label "Batch prediction job node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:PredictionStep .

pat:BatchTrain_PreprocessStepNode a pair:PatternNode ;
    rdfs:label "Batch training preprocessing step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:PreprocessingStep .

pat:BatchTrain_TrainingStepNode a pair:PatternNode ;
    rdfs:label "Batch training step node"@en ;
    pair:expectedClass beam:Train ;
    pair:expectedRole pair:TrainingStep .

pat:Control_GroundingAndVerification a beamr:RiskControl ;
    dct:description "Ground generated answers in trusted sources and verify responses against task-specific evidence or evaluation criteria."@en ;
    skos:prefLabel "Grounding and verification"@en ;
    skos:relatedMatch mitctrl:human-oversight-protocol,
        mitctrl:retrieval-quality-evaluation,
        mitctrl:testing-auditing .

pat:Control_RetrievalAccessControl a beamr:RiskControl ;
    dct:description "Constrain retrieval sources, chunks, ranking, and access permissions so only appropriate context can be supplied to the LLM."@en ;
    skos:prefLabel "Retrieval access control"@en ;
    skos:relatedMatch mitctrl:access-management,
        mitctrl:retrieval-quality-evaluation,
        mitctrl:retrieval-source-filtering .

pat:Control_TrustedTrainingAndIndexingData a beamr:RiskControl ;
    dct:description "Validate provenance and integrity of data used for training, fine-tuning, evaluation, embedding, and retrieval indexes."@en ;
    skos:prefLabel "Trusted training and indexing data"@en ;
    skos:relatedMatch mitctrl:data-curation-process,
        mitctrl:data-governance,
        mitctrl:testing-auditing .

pat:DataAndModelPoisoningRiskPattern a pair:RiskPattern ;
    rdfs:label "Data and model poisoning risk pattern"@en ;
    dct:source <https://genai.owasp.org/resource/owasp-top-10-for-llm-applications-2025/> ;
    pair:derivedFrom owasp:llm04-data-and-model-poisoning ;
    pair:hasApplicabilityCondition pat:Poisoning_UntrustedTrainingOrIndexingDataCondition ;
    pair:hasMechanism owasp:mechanism-data-or-model-poisoning ;
    pair:implementedBy pat:DataAndModelPoisoningOQP ;
    pair:mayIndicateRisk atlas:data-curation,
        mit:subdomain-1-3,
        mit:subdomain-2-2,
        mit:subdomain-7-3,
        owasp:llm04-data-and-model-poisoning ;
    pair:suggestedControl pat:Control_LoggingMonitoringAndEvals,
        pat:Control_ModelAndDependencyProvenance,
        pat:Control_TrustedTrainingAndIndexingData,
        mitctrl:data-curation-process,
        mitctrl:data-governance,
        mitctrl:model-infrastructure-security,
        mitctrl:testing-auditing,
        mitctrl:threat-modelling .

pat:DirectPromptingWithoutGroundingRiskPattern a pair:RiskPattern ;
    rdfs:label "Direct Prompting without grounding risk pattern"@en ;
    dct:description """
    Applies when a Direct Prompting motif produces a user-facing answer without
    an explicit knowledge source, retrieved context, or represented verification
    step in the architecture graph.
    """@en ;
    dct:source <https://genai.owasp.org/resource/owasp-top-10-for-llm-applications-2025/> ;
    pair:derivedFrom owasp:llm09-misinformation ;
    pair:hasApplicabilityCondition pat:Misinformation_UngroundedGenerationCondition ;
    pair:hasMechanism owasp:mechanism-unsupported-generation ;
    pair:hasMotif pat:DirectPromptingMotif ;
    pair:implementedBy pat:DirectPromptingWithoutGroundingOQP ;
    pair:mayIndicateRisk atlas:hallucination,
        atlas:incomplete-advice,
        mit:subdomain-3-1,
        mit:subdomain-5-1,
        mit:subdomain-7-3,
        owasp:llm09-misinformation ;
    pair:suggestedControl pat:Control_GroundingAndVerification,
        pat:Control_LoggingMonitoringAndEvals,
        mitctrl:human-oversight-protocol,
        mitctrl:input-output-filtering,
        mitctrl:red-teaming,
        mitctrl:retrieval-quality-evaluation ;
    skos:altLabel "Direct LLM answering without grounding risk pattern"@en .

pat:Embedding_GenerationStepNode a pair:PatternNode ;
    rdfs:label "Embedding generation step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:EmbeddingStep .

pat:EmbeddingsMotif a pair:GraphMotif ;
    rdfs:label "Embeddings Motif"@en ;
    dct:description "GenAI motif in which source documents or data blocks are chunked and transformed by an embedding model into vectors stored in a vector index."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:derivedFrom <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternEdge pat:Embedding_ChunkingProducesChunkEdge,
        pat:Embedding_ChunkingUsesSourceEdge,
        pat:Embedding_GenerationProducesVectorEdge,
        pat:Embedding_GenerationUsesChunkEdge,
        pat:Embedding_GenerationUsesModelEdge,
        pat:Embedding_VectorIndexUsesVectorEdge ;
    pair:hasPatternNode pat:Embedding_ChunkingStepNode,
        pat:Embedding_DocumentChunkNode,
        pat:Embedding_GenerationStepNode,
        pat:Embedding_ModelNode,
        pat:Embedding_SourceDocumentNode,
        pat:Embedding_VectorIndexNode,
        pat:Embedding_VectorNode ;
    pair:hasRiskPattern pat:DataAndModelPoisoningRiskPattern,
        pat:VectorAndEmbeddingWeaknessRiskPattern ;
    pair:implementedBy pat:Embeddings_MatchingOQP .

pat:FineTune_TrainingStepNode a pair:PatternNode ;
    rdfs:label "Fine tuning training step node"@en ;
    pair:expectedClass beam:Train ;
    pair:expectedRole pair:FineTuningStep .

pat:ModelLoad_LoadStepNode a pair:PatternNode ;
    rdfs:label "Model load step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:ModelLoadStep .

pat:MultiStage_FastPredictionStepNode a pair:PatternNode ;
    rdfs:label "Fast prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:FastPredictionStep .

pat:MultiStage_SlowPredictionStepNode a pair:PatternNode ;
    rdfs:label "Slow prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:SlowPredictionStep .

pat:PipeTrain_TrainingJobNode a pair:PatternNode ;
    rdfs:label "Pipeline training job node"@en ;
    pair:expectedClass beam:Train ;
    pair:expectedRole pair:TrainingStep .

pat:PredLog_LoggingStepNode a pair:PatternNode ;
    rdfs:label "Prediction logging step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:LoggingStep .

pat:PrepPred_PredictionStepNode a pair:PatternNode ;
    rdfs:label "Prep-pred prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:PredictionStep .

pat:PromptInjectionRiskPattern a pair:RiskPattern ;
    rdfs:label "Prompt injection risk pattern"@en ;
    dct:description """
    Applies to motifs where untrusted user, retrieved, or tool-supplied
    content can enter a prompt or generation context and potentially override
    or conflict with intended instructions.
    """@en ;
    dct:source <https://genai.owasp.org/resource/owasp-top-10-for-llm-applications-2025/> ;
    pair:derivedFrom owasp:llm01-prompt-injection ;
    pair:hasApplicabilityCondition pat:PromptInjection_UntrustedPromptContextCondition ;
    pair:hasMechanism owasp:mechanism-instruction-override ;
    pair:implementedBy pat:PromptInjectionOQP ;
    pair:mayIndicateRisk atlas:prompt-injection,
        mit:subdomain-2-2,
        mit:subdomain-4-3,
        owasp:llm01-prompt-injection ;
    pair:suggestedControl pat:Control_Guardrails,
        pat:Control_InputValidationAndPromptIsolation,
        pat:Control_LoggingMonitoringAndEvals,
        mitctrl:input-output-filtering,
        mitctrl:red-teaming,
        mitctrl:retrieval-source-filtering,
        mitctrl:threat-modelling .

pat:QueryRewrite_RewriteStepNode a pair:PatternNode ;
    rdfs:label "Query rewriting step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:QueryReformulationStep .

pat:RAG_PromptConstructionStepNode a pair:PatternNode ;
    rdfs:label "RAG prompt construction step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:PromptConstructionStep .

pat:Reranker_RerankingStepNode a pair:PatternNode ;
    rdfs:label "Reranking step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:RerankingStep .

pat:SyncPred_PredictionStepNode a pair:PatternNode ;
    rdfs:label "Synchronous prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:PredictionStep .

pat:TrainServe_ReleaseStepNode a pair:PatternNode ;
    rdfs:label "Manual release step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:DeploymentStep .

pat:TrainToServe_AutoDeploymentNode a pair:PatternNode ;
    rdfs:label "Automatic model deployment step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:DeploymentStep .

pat:UnboundedConsumptionRiskPattern a pair:RiskPattern ;
    rdfs:label "Unbounded consumption risk pattern"@en ;
    dct:description """
    Applies to motifs where model calls, retrieval breadth, prompt expansion,
    tool use, or feedback loops can consume cost, latency, or availability
    budget without represented rate, budget, or loop controls.
    """@en ;
    dct:source <https://genai.owasp.org/resource/owasp-top-10-for-llm-applications-2025/> ;
    pair:derivedFrom owasp:llm10-unbounded-consumption ;
    pair:hasApplicabilityCondition pat:UnboundedConsumption_UnboundedUseCondition ;
    pair:hasMechanism owasp:mechanism-unbounded-resource-consumption ;
    pair:implementedBy pat:UnboundedConsumptionOQP ;
    pair:mayIndicateRisk atlas:impact-on-the-environment,
        atlas:redundant-actions-agentic,
        mit:subdomain-2-2,
        mit:subdomain-6-6,
        mit:subdomain-7-3,
        owasp:llm10-unbounded-consumption ;
    pair:suggestedControl pat:Control_LoggingMonitoringAndEvals,
        pat:Control_RateLimitBudgetAndLoopControl,
        mitctrl:access-management,
        mitctrl:incident-response-plan,
        mitctrl:post-deployment-behavior-monitoring,
        mitctrl:prompt-context-limiting .

pat:VectorAndEmbeddingWeaknessRiskPattern a pair:RiskPattern ;
    rdfs:label "Vector and embedding weakness risk pattern"@en ;
    dct:source <https://genai.owasp.org/resource/owasp-top-10-for-llm-applications-2025/> ;
    pair:derivedFrom owasp:llm08-vector-and-embedding-weaknesses ;
    pair:hasApplicabilityCondition pat:VectorEmbeddingWeakness_RetrievalCondition ;
    pair:hasMechanism owasp:mechanism-vector-embedding-retrieval-weakness ;
    pair:implementedBy pat:VectorAndEmbeddingWeaknessOQP ;
    pair:mayIndicateRisk atlas:poor-model-accuracy,
        atlas:prompt-injection,
        mit:subdomain-2-2,
        mit:subdomain-7-3,
        owasp:llm08-vector-and-embedding-weaknesses ;
    pair:suggestedControl pat:Control_GroundingAndVerification,
        pat:Control_RetrievalAccessControl,
        pat:Control_TrustedTrainingAndIndexingData,
        mitctrl:data-governance,
        mitctrl:retrieval-quality-evaluation,
        mitctrl:retrieval-source-filtering,
        mitctrl:threat-modelling .

pat:VectorBasedInformationRetrievalMotif a pair:GraphMotif ;
    rdfs:label "Vector-based Information Retrieval Motif"@en ;
    dct:description """
    Architectural motif in which a retrieval process uses a vector store or
    knowledge source and produces a retrieved result or retrieved context.
    """@en ;
    dct:source "expert curation" ;
    pair:hasPatternEdge pat:VectorIR_RetrievalProducesResultEdge,
        pat:VectorIR_RetrievalUsesQueryEdge,
        pat:VectorIR_RetrievalUsesVectorStoreEdge ;
    pair:hasPatternNode pat:VectorIR_QueryNode,
        pat:VectorIR_RetrievalStepNode,
        pat:VectorIR_RetrievedResultNode,
        pat:VectorIR_VectorStoreNode ;
    pair:implementedBy pat:VectorIR_MatchingOQP .

pat:VectorEmbeddingWeakness_RetrievalCondition a pair:ApplicabilityCondition ;
    rdfs:label "Vector retrieval or embedding index is used for generation context"@en ;
    pair:operationalizesRiskCondition owasp:condition-retrieval-filtering-or-ranking-is-risk-relevant,
        owasp:condition-retrieved-content-enters-generation-context,
        owasp:condition-vector-store-used-for-retrieval .

pat:VectorIR_RetrievalStepNode a pair:PatternNode ;
    rdfs:label "Vector-based retrieval step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:RetrievalStep .

atlas:data-curation a nexus:Risk ;
    nexus:descriptor "traditional risk of AI" ;
    nexus:hasRelatedControl mitctrl:data-curation-process,
        mitctrl:data-governance,
        mitctrl:testing-auditing ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:value-alignment ;
    nexus:riskType "training-data" ;
    nexus:tag "data-curation" ;
    skos:broader atlas:value-alignment ;
    skos:definition "Improper collection, preparation, labeling, or generation of data may degrade model behavior." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Improper data curation" ;
    skos:relatedMatch mit:subdomain-1-3,
        mit:subdomain-7-3,
        owasp:llm04-data-and-model-poisoning .

atlas:hallucination a nexus:Risk ;
    nexus:descriptor "specific to generative AI" ;
    nexus:hasRelatedControl mitctrl:input-output-filtering,
        mitctrl:red-teaming,
        mitctrl:retrieval-quality-evaluation,
        mitctrl:system-architecture-documentation ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:robustness ;
    nexus:riskType "output" ;
    nexus:tag "hallucination" ;
    skos:broadMatch mit:subdomain-3-1,
        owasp:llm09-misinformation ;
    skos:broader atlas:robustness ;
    skos:definition "A model may produce inaccurate, unsupported, or untruthful content that appears plausible." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Hallucination" ;
    skos:relatedMatch mit:subdomain-7-3 .

atlas:poor-model-accuracy a nexus:Risk ;
    nexus:descriptor "traditional risk of AI" ;
    nexus:hasRelatedControl mitctrl:red-teaming,
        mitctrl:retrieval-quality-evaluation,
        mitctrl:testing-auditing ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:accuracy ;
    nexus:riskType "inference" ;
    nexus:tag "poor-model-accuracy" ;
    skos:broadMatch mit:subdomain-7-3 ;
    skos:broader atlas:accuracy ;
    skos:definition "A model may perform insufficiently for the intended task or context." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Poor model accuracy" ;
    skos:relatedMatch owasp:llm09-misinformation .

atlas:redundant-actions-agentic a nexus:Risk ;
    nexus:descriptor "specific to agentic AI" ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:computational-inefficiency ;
    nexus:riskType "agentic" ;
    nexus:tag "redundant-actions-agentic" ;
    skos:broader atlas:computational-inefficiency ;
    skos:definition "Unnecessary or repeated actions may waste computation, increase cost, and reduce system efficiency." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Redundant actions" .

mit:subdomain-1-3 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:data-curation-process,
        mitctrl:data-governance,
        mitctrl:testing-auditing ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-1 ;
    skos:broader mit:domain-1 ;
    skos:definition "AI system performance may differ across demographic or social groups." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Unequal performance across groups" .

mit:subdomain-4-3 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:content-safety-controls,
        mitctrl:incident-response-plan,
        mitctrl:red-teaming,
        mitctrl:threat-modelling ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-4 ;
    skos:broader mit:domain-4 ;
    skos:definition "AI systems may be used to manipulate, deceive, impersonate, or exploit people." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Fraud, scams, and targeted manipulation" .

owasp:condition-retrieval-filtering-or-ranking-is-risk-relevant a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm08-vector-and-embedding-weaknesses ;
    skos:prefLabel "Retrieval filtering, ranking, chunking, or source selection is risk-relevant"@en .

owasp:condition-vector-store-used-for-retrieval a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm08-vector-and-embedding-weaknesses ;
    skos:prefLabel "Vector store or embedding index is used for retrieval"@en .

beam:Symbol a owl:Class ;
    rdfs:label "Symbol" ;
    rdfs:subClassOf beam:Instance .

<http://w3id.org/airiskkg/example/verba-goldenverba#ChunkEmbeddings> a beam:Data ;
    rdfs:label "Chunk embeddings"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent>,
        pair:UntrustedContent ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#IndexChunksInWeaviate> .

<http://w3id.org/airiskkg/example/verba-goldenverba#ParsedDocument> a beam:Data ;
    rdfs:label "Parsed document"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedSensitiveKnowledgeBaseContent>,
        pair:UntrustedContent ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkDocument> .

<http://w3id.org/airiskkg/example/verba-goldenverba#UploadedSensitiveKnowledgeBaseContent> a pair:DataCategory ;
    rdfs:label "Uploaded sensitive knowledge base content"@en ;
    pair:subDataCategoryOf <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent>,
        pair:SensitiveInformation .

<http://w3id.org/airiskkg/facets/context#DeploymentSetting> a skos:ConceptScheme ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems (Context dimension)." ;
    skos:definition "Operational setting in which the system is deployed (e.g. internal tool, public-facing service, safety-critical environment, regulated environment). Extension point: concrete settings are added per use case."@en ;
    skos:prefLabel "Deployment Setting"@en .

<http://w3id.org/airiskkg/facets/data#DataDynamism> a skos:ConceptScheme ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems (Data & Input dimension)." ;
    skos:definition "Update behavior of a data resource: whether and how it changes after system deployment."@en ;
    skos:prefLabel "Data Dynamism"@en .

<http://w3id.org/airiskkg/facets/data#DataRights> a skos:ConceptScheme ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems (Data & Input dimension)." ;
    skos:definition "Rights and ownership status of a data resource, constraining how it may be used."@en ;
    skos:prefLabel "Data Rights"@en .

<http://w3id.org/airiskkg/facets/task#GenerationAndTransformation> a skos:Concept ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:definition "Producing new content or transforming content between forms (text, code, images, audio, translations, summaries)."@en ;
    skos:inScheme <http://w3id.org/airiskkg/facets/task#AITask> ;
    skos:narrower <http://w3id.org/airiskkg/facets/task#CodeGeneration>,
        <http://w3id.org/airiskkg/facets/task#EmbeddingComputation>,
        <http://w3id.org/airiskkg/facets/task#ImageGeneration>,
        <http://w3id.org/airiskkg/facets/task#Summarization>,
        <http://w3id.org/airiskkg/facets/task#TextGeneration>,
        <http://w3id.org/airiskkg/facets/task#Translation> ;
    skos:prefLabel "Generation and Transformation"@en ;
    skos:topConceptOf <http://w3id.org/airiskkg/facets/task#AITask> .

pair:ModelArtifact a pair:PatternRole ;
    pair:subRoleOf pair:Model ;
    skos:definition "A persisted model artifact (weights/checkpoint) produced or consumed by a workflow."@en ;
    skos:prefLabel "Model Artifact"@en .

pair:RetrievedContext a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "Content returned by a retrieval step for use as context."@en ;
    skos:prefLabel "RetrievedContext"@en .

pat:Guardrails_GenerationStepNode a pair:PatternNode ;
    rdfs:label "Guarded generation step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:GenerationStep .

pat:SupplyChainCompromiseRiskPattern a pair:RiskPattern ;
    rdfs:label "Supply chain compromise risk pattern"@en ;
    dct:source <https://genai.owasp.org/resource/owasp-top-10-for-llm-applications-2025/> ;
    pair:derivedFrom owasp:llm03-supply-chain ;
    pair:hasApplicabilityCondition pat:SupplyChain_ExternalDependencyCondition ;
    pair:hasMechanism owasp:mechanism-supply-chain-compromise ;
    pair:implementedBy pat:SupplyChainCompromiseOQP ;
    pair:mayIndicateRisk mit:subdomain-2-2,
        mit:subdomain-7-3,
        mit:subdomain-7-4,
        owasp:llm03-supply-chain ;
    pair:suggestedControl pat:Control_LoggingMonitoringAndEvals,
        pat:Control_ModelAndDependencyProvenance,
        mitctrl:data-governance,
        mitctrl:model-infrastructure-security,
        mitctrl:pre-deployment-risk-assessment,
        mitctrl:risk-register,
        mitctrl:system-architecture-documentation,
        mitctrl:threat-modelling .

mit:domain-1 a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Discrimination & Toxicity" ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:subdomain-3-1 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:human-oversight-protocol,
        mitctrl:input-output-filtering,
        mitctrl:red-teaming,
        mitctrl:retrieval-quality-evaluation ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-3 ;
    skos:broader mit:domain-3 ;
    skos:definition "AI systems may generate or spread incorrect, deceptive, or misleading information." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "False or misleading information" .

mitctrl:data-minimization a nexus:RiskControl ;
    nexus:controlType "preventive" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "design-time",
        "development" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:exposing-personal-information,
        atlas:personal-information-in-data,
        mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure ;
    skos:broader mitctrl:access-management,
        mitctrl:data-governance ;
    skos:definition "Limiting collection, storage, retrieval, prompt inclusion, and disclosure of data to what is necessary for the intended use." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Data Minimization" .

mitctrl:incident-response-plan a nexus:RiskControl ;
    nexus:controlType "corrective" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "post-deployment" ;
    nexus:mitigatesRiskTaxonomyEntry owasp:llm05-improper-output-handling,
        owasp:llm10-unbounded-consumption ;
    skos:broader mitctrl:incident-reporting,
        mitctrl:incident-response-recovery ;
    skos:definition "A plan for responding to AI safety incidents, security failures, misuse, or harmful outputs." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Incident Response Plan" .

mitctrl:redaction a nexus:RiskControl ;
    nexus:controlType "technical" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "design-time",
        "operation" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:confidential-data-in-prompt,
        atlas:exposing-personal-information,
        atlas:personal-information-in-prompt,
        mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure,
        owasp:llm07-system-prompt-leakage ;
    skos:broader mitctrl:data-governance,
        mitctrl:model-safety-engineering ;
    skos:definition "Removing, masking, or transforming sensitive information before it enters model context, generated output, logs, or downstream flows." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Redaction" .

mitctrl:risk-disclosure a nexus:RiskControlGroup ;
    nexus:controlType "transparency-accountability" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment" ;
    skos:broader mitctrl:transparency-accountability-controls ;
    skos:definition """\r
    Reporting and notification practices that communicate risk information, mitigation\r
    plans, safety evaluations, and relevant risk assessment summaries.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Risk Disclosure" .

mitctrl:system-documentation a nexus:RiskControlGroup ;
    nexus:controlType "transparency-accountability" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "design-time",
        "development" ;
    skos:broader mitctrl:transparency-accountability-controls ;
    skos:definition """\r
    Documentation protocols that record technical specifications, intended uses,\r
    limitations, system architecture, model information, and safety evaluation results.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "System Documentation" .

owasp:condition-generated-output-exposed-to-user a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm02-sensitive-information-disclosure,
        owasp:llm07-system-prompt-leakage,
        owasp:llm09-misinformation ;
    skos:prefLabel "Generated output is exposed to a user or downstream system"@en .

beam: a owl:Ontology ;
    dct:description """  An ontology to describe the core components of AI systems \r
                                                based on an extended/adapted version of boxology: \r
                                                Boxology's Extended Annotation Model (BEAM)"""@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0> ;
    dct:modified "2026-02-05" ;
    dct:title "The BEAM ontology"@en ;
    vann:preferredNamespacePrefix "beam" ;
    vann:preferredNamespaceUri "http://w3id.org/beam/core#" ;
    owl:versionInfo "0.1.0" .

beam:Train a owl:Class ;
    rdfs:label "Train" ;
    rdfs:subClassOf beam:Generate .

<http://w3id.org/airiskkg/example/verba-goldenverba#ChunkDocument> a beam:Transform ;
    rdfs:label "Chunk document"@en ;
    beam:inform <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedChunks> ;
    beam:produce <http://w3id.org/airiskkg/example/verba-goldenverba#DocumentChunks> ;
    beam:use <http://w3id.org/airiskkg/example/verba-goldenverba#ParsedDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration> .

<http://w3id.org/airiskkg/example/verba-goldenverba#DocumentChunks> a beam:Data ;
    rdfs:label "Document chunks"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedSensitiveKnowledgeBaseContent>,
        pair:UntrustedContent ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#IndexChunksInWeaviate> .

<http://w3id.org/airiskkg/example/verba-goldenverba#EmbeddedQuestion> a beam:Data ;
    rdfs:label "Embedded chat question"@en ;
    pair:containsDataCategory pair:ExternalUserContent,
        pair:UntrustedContent ;
    pair:playsRole pair:PublicUserInput ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#RetrieveRelevantChunks> .

pair:PredictionResult a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "The result of a prediction step."@en ;
    skos:prefLabel "PredictionResult"@en .

pat:Control_Guardrails a beamr:RiskControl ;
    dct:description "Use input and output guardrails to block, route, or sanitize unsafe prompts and generated responses."@en ;
    skos:prefLabel "Input and output guardrails"@en ;
    skos:relatedMatch mitctrl:content-safety-controls,
        mitctrl:input-output-filtering,
        mitctrl:model-safety-engineering .

pat:Evals_ScorerNode a pair:PatternNode ;
    rdfs:label "Evaluation scorer node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:ScoringStep .

atlas:exposing-personal-information a nexus:Risk ;
    nexus:descriptor "amplified by generative AI" ;
    nexus:hasRelatedControl mitctrl:access-management,
        mitctrl:data-governance,
        mitctrl:data-minimization,
        mitctrl:input-output-filtering,
        mitctrl:privacy-control-for-user-data,
        mitctrl:redaction,
        mitctrl:retrieval-source-filtering ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:privacy ;
    nexus:riskType "output" ;
    nexus:tag "exposing-personal-information" ;
    skos:broadMatch mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure ;
    skos:broader atlas:privacy ;
    skos:definition "Personal information used in data, prompts, or generation processes may be revealed in outputs." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Exposing personal information" .

mitctrl:content-safety-controls a nexus:RiskControlGroup ;
    nexus:controlType "technical" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "operation" ;
    nexus:mitigatesRiskTaxonomyEntry owasp:llm05-improper-output-handling ;
    skos:broader mitctrl:technical-security-controls ;
    skos:definition """\r
    Technical systems and processes that detect, filter, label, or restrict harmful,\r
    unsafe, or manipulated AI-generated content.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Content Safety Controls" .

mitctrl:operational-process-controls a nexus:RiskControlGroup ;
    nexus:controlType "operational" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:definition """\r
    Processes and management frameworks governing deployment, usage, monitoring,\r
    incident handling, and validation across the AI system lifecycle.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Operational Process Controls" ;
    skos:topConceptOf mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy .

mitctrl:risk-register a nexus:RiskControl ;
    nexus:controlType "governance" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "design-time" ;
    nexus:mitigatesRiskTaxonomyEntry owasp:llm03-supply-chain,
        owasp:llm06-excessive-agency ;
    skos:broader mitctrl:risk-management ;
    skos:definition "A structured repository of risks, their prioritization, owners, and mitigation plans." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Risk Register" .

beam:Resource a owl:Class ;
    rdfs:label "Resource" ;
    rdfs:subClassOf beam:Element .

<http://w3id.org/airiskkg/example/verba-goldenverba#EmbedChunks> a beam:Transform ;
    rdfs:label "Embed document chunks"@en ;
    pair:playsRole pair:EmbeddingStep ;
    beam:inform <http://w3id.org/airiskkg/example/verba-goldenverba#IndexChunksInWeaviate> ;
    beam:produce <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkEmbeddings> ;
    beam:use <http://w3id.org/airiskkg/example/verba-goldenverba#DocumentChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ProviderCredentials>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration> .

<http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration> a beam:Data ;
    rdfs:label "RAG configuration"@en ;
    pair:containsDataCategory pair:PromptInstruction ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#BuildRAGPrompt>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ReadDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RetrieveRelevantChunks> .

<http://w3id.org/airiskkg/example/verba-goldenverba#RetrieveRelevantChunks> a beam:Infer ;
    rdfs:label "Retrieve relevant chunks from Weaviate"@en ;
    pair:playsRole pair:RetrievalStep ;
    beam:inform <http://w3id.org/airiskkg/example/verba-goldenverba#BuildRAGPrompt> ;
    beam:produce <http://w3id.org/airiskkg/example/verba-goldenverba#RetrievedChunks> ;
    beam:use <http://w3id.org/airiskkg/example/verba-goldenverba#EmbeddedQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#WeaviateVectorStore> .

<http://w3id.org/airiskkg/example/verba-goldenverba#RetrievedChunks> a beam:Data ;
    rdfs:label "Retrieved context chunks"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedSensitiveKnowledgeBaseContent>,
        pair:UntrustedContent ;
    pair:playsRole pair:RetrievedContext ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#BuildRAGPrompt>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer> .

<http://w3id.org/airiskkg/facets/autonomy#AutonomyLevel> a skos:ConceptScheme ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems." ;
    skos:definition "Degree of action autonomy of an AI system: how much the system can act on its outputs without a human in the decision path."@en ;
    skos:prefLabel "Autonomy Level"@en .

atlas:privacy a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Privacy" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

mitctrl:data-curation-process a nexus:RiskControl ;
    nexus:controlType "operational" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "development" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:data-curation,
        owasp:llm04-data-and-model-poisoning ;
    skos:broader mitctrl:data-governance ;
    skos:definition "Processes for selecting, cleaning, filtering, documenting, and governing data used by AI systems." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Data Curation Process" .

mitctrl:model-infrastructure-security a nexus:RiskControlGroup ;
    nexus:controlType "technical" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "development",
        "operation" ;
    nexus:mitigatesRiskTaxonomyEntry owasp:llm03-supply-chain,
        owasp:llm04-data-and-model-poisoning ;
    skos:broader mitctrl:technical-security-controls ;
    skos:definition """\r
    Technical and physical safeguards that secure AI models, model weights,\r
    infrastructure, and system access against unauthorized use, theft, or tampering.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Model & Infrastructure Security" .

mitctrl:model-safety-engineering a nexus:RiskControlGroup ;
    nexus:controlType "technical" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "development" ;
    skos:broader mitctrl:technical-security-controls ;
    skos:definition """\r
    Technical methods and safeguards that constrain model behavior and protect against\r
    exploitation, unsafe outputs, or vulnerabilities.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Model Safety Engineering" .

mitctrl:post-deployment-behavior-monitoring a nexus:RiskControl ;
    nexus:controlType "detective" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "post-deployment" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:redundant-actions-agentic,
        owasp:llm06-excessive-agency,
        owasp:llm10-unbounded-consumption ;
    skos:broader mitctrl:post-deployment-monitoring ;
    skos:definition "Ongoing monitoring of AI system behavior, outputs, user interactions, failures, and misuse signals after deployment." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Post-deployment Behavior Monitoring" .

owasp:llm10-unbounded-consumption a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:access-management,
        mitctrl:incident-response-plan,
        mitctrl:post-deployment-behavior-monitoring,
        mitctrl:prompt-context-limiting ;
    nexus:hasRiskCondition owasp:condition-unbounded-prompt-retrieval-tool-or-model-use ;
    nexus:hasRiskMechanism owasp:mechanism-unbounded-resource-consumption ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm10-unbounded-consumption" ;
    skos:definition "LLM applications may allow excessive or uncontrolled inference, causing cost, availability, or abuse risks." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:narrowMatch atlas:redundant-actions-agentic ;
    skos:prefLabel "LLM10:2025 Unbounded Consumption" ;
    skos:relatedMatch atlas:impact-on-the-environment,
        mit:subdomain-2-2,
        mit:subdomain-6-6,
        mit:subdomain-7-3 .

<http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent> a pair:DataCategory ;
    rdfs:label "Uploaded knowledge base content"@en ;
    pair:subDataCategoryOf pair:Information .

pair:UntrustedContent a pair:DataCategory ;
    dct:source "expert curation" ;
    skos:definition "Content whose integrity the system cannot vouch for within the submitted graph (public input, externally sourced documents, retrieved context). Root category traversed by prompt-injection and poisoning applicability conditions; also derived along data flow by the untrusted-content propagation query. Absence of this category means unknown, not trusted (Open World Assumption, Rule R4)."@en ;
    skos:inScheme pair:DataCategoryScheme ;
    skos:prefLabel "Untrusted Content"@en ;
    skos:topConceptOf pair:DataCategoryScheme .

pair:UserInput a pair:PatternRole ;
    skos:definition "Information provided directly by a user, such as through a user interface or API input."@en ;
    skos:prefLabel "User Input"@en .

mit:subdomain-7-4 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:risk-disclosure,
        mitctrl:system-architecture-documentation,
        mitctrl:system-documentation ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-7 ;
    skos:broader mit:domain-7 ;
    skos:definition "AI systems may be difficult to understand, explain, audit, or correct." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Lack of transparency or interpretability" .

owasp:condition-retrieved-content-enters-generation-context a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm01-prompt-injection,
        owasp:llm08-vector-and-embedding-weaknesses ;
    skos:prefLabel "Retrieved content enters generation context"@en .

<http://w3id.org/airiskkg/facets/data#DataProvenance> a skos:ConceptScheme ;
    dct:source "OECD (2022). OECD Framework for the Classification of AI Systems (Data & Input dimension)." ;
    skos:definition "Origin of the data used or produced by the system: how the data came into existence relative to the system and its stakeholders."@en ;
    skos:prefLabel "Data Provenance"@en .

pat:Control_LoggingMonitoringAndEvals a beamr:RiskControl ;
    dct:description "Log relevant interactions, monitor abnormal behavior, and run evaluations for model and system behavior over time."@en ;
    skos:prefLabel "Logging, monitoring, and evals"@en ;
    skos:relatedMatch mitctrl:post-deployment-behavior-monitoring,
        mitctrl:red-teaming,
        mitctrl:testing-auditing .

mitctrl:system-architecture-documentation a nexus:RiskControl ;
    nexus:controlType "transparency-accountability" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "design-time" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:legal-accountability,
        mit:subdomain-7-4,
        owasp:llm03-supply-chain,
        owasp:llm07-system-prompt-leakage ;
    skos:broader mitctrl:system-documentation ;
    skos:definition "Documentation of the system architecture, components, data flows, model use, limitations, and intended use." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "System Architecture Documentation" .

owasp:llm03-supply-chain a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:data-governance,
        mitctrl:model-infrastructure-security,
        mitctrl:pre-deployment-risk-assessment,
        mitctrl:risk-register,
        mitctrl:system-architecture-documentation,
        mitctrl:threat-modelling ;
    nexus:hasRiskCondition owasp:condition-externally-sourced-model-data-or-dependency ;
    nexus:hasRiskMechanism owasp:mechanism-supply-chain-compromise ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm03-supply-chain" ;
    skos:broadMatch mit:subdomain-2-2 ;
    skos:definition "LLM supply chains may be vulnerable through models, data, dependencies, or deployment platforms." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM03:2025 Supply Chain" ;
    skos:relatedMatch mit:subdomain-7-3,
        mit:subdomain-7-4 .

owasp:llm05-improper-output-handling a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:content-safety-controls,
        mitctrl:human-oversight-protocol,
        mitctrl:incident-response-plan,
        mitctrl:input-output-filtering,
        mitctrl:testing-auditing ;
    nexus:hasRiskCondition owasp:condition-llm-output-used-without-validation ;
    nexus:hasRiskMechanism owasp:mechanism-unsafe-output-propagation ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm05-improper-output-handling" ;
    skos:definition "Generated outputs may be insufficiently validated, sanitized, or constrained before downstream use." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM05:2025 Improper Output Handling" ;
    skos:relatedMatch atlas:evasion-attack,
        mit:subdomain-1-2,
        mit:subdomain-2-2,
        mit:subdomain-7-3 .

owasp:llm06-excessive-agency a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:access-management,
        mitctrl:human-oversight-protocol,
        mitctrl:post-deployment-behavior-monitoring,
        mitctrl:prompt-context-limiting,
        mitctrl:risk-register,
        mitctrl:threat-modelling ;
    nexus:hasRiskCondition owasp:condition-llm-can-trigger-tools-or-state-changes ;
    nexus:hasRiskMechanism owasp:mechanism-excessive-agency-action-execution ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm06-excessive-agency" ;
    skos:definition "LLM systems may be granted excessive ability to invoke tools, act, or affect external systems." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM06:2025 Excessive Agency" ;
    skos:relatedMatch atlas:redundant-actions-agentic,
        mit:subdomain-2-2,
        mit:subdomain-5-2,
        mit:subdomain-7-4 .

beam:System a owl:Class ;
    rdfs:label "System" ;
    rdfs:subClassOf beam:Element .

<http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer> a beam:Transform ;
    rdfs:label "Generate grounded answer"@en ;
    pair:playsRole pair:GenerationStep ;
    beam:produce <http://w3id.org/airiskkg/example/verba-goldenverba#Answer> ;
    beam:use <http://w3id.org/airiskkg/example/verba-goldenverba#GeneratorModel>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ProviderCredentials>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#PublicQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGPrompt>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RetrievedChunks> .

<http://w3id.org/airiskkg/example/verba-goldenverba#WeaviateVectorStore> a beam:Data ;
    rdfs:label "Weaviate document and chunk vector store"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedSensitiveKnowledgeBaseContent>,
        pair:UntrustedContent ;
    pair:playsRole pair:VectorStore ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#RetrieveRelevantChunks> .

pair:MotifMatch a owl:Class ;
    rdfs:label "Motif Match"@en ;
    rdfs:comment "Internal technical entity: the set of node bindings from abstract pattern nodes to concrete architecture elements produced by a motif implementation. Candidate risk findings reference matches."@en .

pair:PredictionStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that runs model inference to produce a prediction."@en ;
    skos:prefLabel "PredictionStep"@en .

atlas:prompt-injection a nexus:Risk ;
    nexus:descriptor "specific to generative AI" ;
    nexus:hasRelatedControl mitctrl:input-output-filtering,
        mitctrl:model-safety-engineering,
        mitctrl:red-teaming,
        mitctrl:retrieval-source-filtering,
        mitctrl:threat-modelling ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:robustness-prompt-attacks ;
    nexus:riskType "inference" ;
    nexus:tag "prompt-injection" ;
    skos:broadMatch mit:subdomain-2-2 ;
    skos:broader atlas:robustness-prompt-attacks ;
    skos:closeMatch owasp:llm01-prompt-injection ;
    skos:definition "Manipulated instructions or content in prompts may force a generative model to produce unintended outputs." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Prompt injection attack" ;
    skos:relatedMatch mit:subdomain-4-3,
        owasp:llm08-vector-and-embedding-weaknesses .

mitctrl:privacy-control-for-user-data a nexus:RiskControl ;
    nexus:controlType "preventive" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "design-time" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:exposing-personal-information,
        atlas:personal-information-in-data,
        atlas:personal-information-in-prompt,
        mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure,
        owasp:llm07-system-prompt-leakage ;
    skos:broader mitctrl:access-management,
        mitctrl:data-governance ;
    skos:definition "Controls that reduce unauthorized access, use, retrieval, or disclosure of user or personal data." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Privacy Control for User Data" .

owasp:llm04-data-and-model-poisoning a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:data-curation-process,
        mitctrl:data-governance,
        mitctrl:model-infrastructure-security,
        mitctrl:testing-auditing,
        mitctrl:threat-modelling ;
    nexus:hasRiskCondition owasp:condition-untrusted-data-enters-training-finetuning-or-indexing ;
    nexus:hasRiskMechanism owasp:mechanism-data-or-model-poisoning ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm04-data-and-model-poisoning" ;
    skos:broadMatch mit:subdomain-2-2 ;
    skos:definition "Training, fine-tuning, or embedding data may be manipulated to compromise model behavior." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM04:2025 Data and Model Poisoning" ;
    skos:relatedMatch mit:subdomain-1-3,
        mit:subdomain-7-3 .

pair:DataCategoryScheme a skos:ConceptScheme ;
    dct:source "PAIR-AI glossary v1.1, Section A.3; DPV v2.3 (https://w3id.org/dpv#, verified 2026-07-13)" ;
    skos:definition "Characterization facet classifying the content of data resources (glossary v1.1 A.3). Read by applicability conditions only; aligned to DPV data concepts where equivalents exist (Rule R3: referenced, never copied)."@en ;
    skos:prefLabel "Data Category"@en .

pair:RiskMechanism a owl:Class ;
    rdfs:label "Risk Mechanism"@en ;
    rdfs:comment "A curated explanation of how or why a matched configuration under the observed conditions can lead to a risk. Mechanisms are defined in the AI-RKG as parts of risk patterns and selected at assessment time, never invented during assessment."@en .

mitctrl:prompt-context-limiting a nexus:RiskControl ;
    nexus:controlType "technical" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "design-time" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:confidential-data-in-prompt,
        atlas:personal-information-in-prompt,
        owasp:llm06-excessive-agency,
        owasp:llm07-system-prompt-leakage,
        owasp:llm10-unbounded-consumption ;
    skos:broader mitctrl:model-safety-engineering,
        mitctrl:operational-process-controls ;
    skos:definition "Limiting prompt size, retrieved context size, query budget, or model invocation budget to reduce cost, latency, and unbounded consumption risks." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Prompt Context Limiting" .

nexus:RiskTaxonomyEntry a owl:Class ;
    rdfs:label "Risk Taxonomy Entry" ;
    rdfs:comment """\r
    A risk concept defined by an external taxonomy. This is not a concrete\r
    system-specific risk finding. Concrete findings should be represented as\r
    beamr:Risk or pair:RiskFinding.\r
    """ ;
    rdfs:subClassOf skos:Concept .

owasp:llm01-prompt-injection a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:input-output-filtering,
        mitctrl:red-teaming,
        mitctrl:retrieval-source-filtering,
        mitctrl:threat-modelling ;
    nexus:hasRiskCondition owasp:condition-retrieved-content-enters-generation-context,
        owasp:condition-untrusted-input-enters-prompt-context ;
    nexus:hasRiskMechanism owasp:mechanism-instruction-override ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm01-prompt-injection" ;
    skos:broadMatch mit:subdomain-2-2 ;
    skos:definition "User or external inputs may alter LLM behavior or output in unintended ways." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM01:2025 Prompt Injection" ;
    skos:relatedMatch mit:subdomain-4-3 .

beam:Element a owl:Class ;
    rdfs:label "Element" .

pair:NodeBinding a owl:Class ;
    rdfs:label "Node Binding"@en ;
    rdfs:comment "A single binding from an abstract pattern node to a concrete architecture element within a motif match."@en .

mitctrl:human-oversight-protocol a nexus:RiskControl ;
    nexus:controlType "governance" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "operation" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:incomplete-advice,
        owasp:llm05-improper-output-handling,
        owasp:llm06-excessive-agency,
        owasp:llm09-misinformation ;
    skos:broader mitctrl:governance-oversight-controls,
        mitctrl:user-rights-recourse ;
    skos:definition "Defined procedures for human oversight, review, intervention, and accountability in AI system operation." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Human Oversight Protocol" .

owasp:llm07-system-prompt-leakage a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:input-output-filtering,
        mitctrl:privacy-control-for-user-data,
        mitctrl:prompt-context-limiting,
        mitctrl:red-teaming,
        mitctrl:system-architecture-documentation ;
    nexus:hasRiskCondition owasp:condition-generated-output-exposed-to-user,
        owasp:condition-hidden-instructions-in-prompt-context ;
    nexus:hasRiskMechanism owasp:mechanism-system-prompt-exposure ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm07-system-prompt-leakage" ;
    skos:broadMatch mit:subdomain-2-1,
        mit:subdomain-2-2 ;
    skos:closeMatch atlas:prompt-leaking ;
    skos:definition "System prompts or hidden instructions may be exposed to users or attackers." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM07:2025 System Prompt Leakage" ;
    skos:relatedMatch atlas:confidential-data-in-prompt,
        mit:subdomain-7-4 .

owasp:llm08-vector-and-embedding-weaknesses a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:data-governance,
        mitctrl:retrieval-quality-evaluation,
        mitctrl:retrieval-source-filtering,
        mitctrl:threat-modelling ;
    nexus:hasRiskCondition owasp:condition-retrieval-filtering-or-ranking-is-risk-relevant,
        owasp:condition-retrieved-content-enters-generation-context,
        owasp:condition-vector-store-used-for-retrieval ;
    nexus:hasRiskMechanism owasp:mechanism-vector-embedding-retrieval-weakness ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm08-vector-and-embedding-weaknesses" ;
    skos:broadMatch mit:subdomain-2-2,
        mit:subdomain-7-3 ;
    skos:definition "Weaknesses in vector generation, storage, or retrieval may affect RAG systems and downstream outputs." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM08:2025 Vector and Embedding Weaknesses" ;
    skos:relatedMatch atlas:poor-model-accuracy,
        atlas:prompt-injection .

pair:ApplicabilityCondition a owl:Class ;
    rdfs:label "Applicability Condition"@en ;
    rdfs:comment "A risk-relevant condition over a motif match: facet values, data categories, structural properties, or the absence of represented controls via closed-world query constructs (FILTER NOT EXISTS over the submitted graph only). Applicability conditions are constituents of an AI risk pattern, not external inputs. Formerly named pair:GraphCondition (\"interpretation condition\")."@en .

pair:DataCategory a owl:Class ;
    rdfs:label "Data Category"@en ;
    rdfs:comment "A characterization facet classifying data content (e.g. sensitive, personal, untrusted, generated content); glossary v1.1 Section A.3 classifies Data Category as one of the characterization facets alongside the schemes in ontology/facets/. It stays in the pattern module (rather than ontology/facets/) because it is the one facet with derived values (Rule R8): pair:containsDataCategory facts are both annotated by the modeler and propagated along data flow by registered propagation queries, and applicability conditions traverse the category hierarchy via pair:subDataCategoryOf. Values are SKOS concepts in pair:DataCategoryScheme, never instantiated as graph structure, and never matched by motifs (Rule R2)."@en ;
    rdfs:subClassOf skos:Concept .

mitctrl:retrieval-quality-evaluation a nexus:RiskControl ;
    nexus:controlType "detective" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "development" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:hallucination,
        atlas:incomplete-advice,
        mit:subdomain-3-1,
        mit:subdomain-7-3,
        owasp:llm08-vector-and-embedding-weaknesses,
        owasp:llm09-misinformation ;
    skos:broader mitctrl:data-governance,
        mitctrl:testing-auditing ;
    skos:definition "Evaluation of retrieval relevance, completeness, source quality, and grounding quality in retrieval-augmented systems." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Retrieval Quality Evaluation" .

owasp:llm09-misinformation a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:human-oversight-protocol,
        mitctrl:input-output-filtering,
        mitctrl:red-teaming,
        mitctrl:retrieval-quality-evaluation ;
    nexus:hasRiskCondition owasp:condition-generated-output-exposed-to-user,
        owasp:condition-generation-without-grounding-or-verification ;
    nexus:hasRiskMechanism owasp:mechanism-unsupported-generation ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm09-misinformation" ;
    skos:closeMatch mit:subdomain-3-1 ;
    skos:definition "LLMs may produce false or misleading information that appears credible." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM09:2025 Misinformation" ;
    skos:relatedMatch mit:subdomain-5-1,
        mit:subdomain-7-3 .

mitctrl:retrieval-source-filtering a nexus:RiskControl ;
    nexus:controlType "technical" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "design-time" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:exposing-personal-information,
        atlas:prompt-injection,
        owasp:llm01-prompt-injection,
        owasp:llm02-sensitive-information-disclosure,
        owasp:llm08-vector-and-embedding-weaknesses ;
    skos:broader mitctrl:data-governance,
        mitctrl:model-safety-engineering ;
    skos:definition "Filtering or restricting which knowledge sources, documents, or records can be retrieved and injected into model context." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Retrieval Source Filtering" .

nexus:RiskCondition a owl:Class ;
    rdfs:label "Risk Condition" ;
    rdfs:comment """\r
    A condition under which a risk taxonomy entry may become relevant. This is\r
    used for source-taxonomy knowledge bases such as OWASP LLM, where a risk\r
    category is grounded by mechanisms and observable or queryable conditions.\r
    """ ;
    rdfs:subClassOf skos:Concept .

beam:Infer a owl:Class ;
    rdfs:label "Infer" ;
    rdfs:subClassOf beam:Process .

beam:Transform a owl:Class ;
    rdfs:label "Transform" ;
    rdfs:subClassOf beam:Process .

pair:Model a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A machine learning or statistical model resource."@en ;
    skos:prefLabel "Model"@en .

mit:subdomain-2-1 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:access-management,
        mitctrl:data-governance,
        mitctrl:data-minimization,
        mitctrl:input-output-filtering,
        mitctrl:privacy-control-for-user-data,
        mitctrl:redaction,
        mitctrl:retrieval-source-filtering ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-2 ;
    skos:broader mit:domain-2 ;
    skos:definition "AI systems may leak, infer, or expose sensitive information about individuals or organizations." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Compromise of privacy by obtaining, leaking or inferring sensitive information" .

mitctrl:access-management a nexus:RiskControlGroup ;
    nexus:controlType "preventive" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "operation" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:exposing-personal-information,
        mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure,
        owasp:llm06-excessive-agency,
        owasp:llm10-unbounded-consumption ;
    skos:broader mitctrl:operational-process-controls ;
    skos:definition """\r
    Policies and verification systems that govern who can use AI systems,\r
    under which purposes, and with which restrictions.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Access Management" .

mitctrl:testing-auditing a nexus:RiskControlGroup ;
    nexus:controlType "detective" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "development" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:data-curation,
        atlas:poor-model-accuracy,
        owasp:llm04-data-and-model-poisoning,
        owasp:llm05-improper-output-handling ;
    skos:broader mitctrl:operational-process-controls ;
    skos:definition """\r
    Internal and external evaluations that assess AI systems, infrastructure, and\r
    compliance processes. Examples include red teaming, penetration testing, third-party\r
    audits, dangerous capability evaluations, and bug bounty programs.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Testing & Auditing" .

nexus:RiskControl a owl:Class ;
    rdfs:label "Risk Control" ;
    rdfs:comment """\r
    A taxonomy-level control or mitigation entry. This may be linked to concrete\r
    BEAM risk controls or used as a possible/required control for a graph risk pattern.\r
    """ ;
    rdfs:subClassOf beamr:RiskControl,
        skos:Concept .

owasp:llm02-sensitive-information-disclosure a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:access-management,
        mitctrl:data-governance,
        mitctrl:data-minimization,
        mitctrl:input-output-filtering,
        mitctrl:privacy-control-for-user-data,
        mitctrl:redaction,
        mitctrl:retrieval-source-filtering ;
    nexus:hasRiskCondition owasp:condition-generated-output-exposed-to-user,
        owasp:condition-sensitive-data-in-context ;
    nexus:hasRiskMechanism owasp:mechanism-sensitive-data-propagation ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm02-sensitive-information-disclosure" ;
    skos:closeMatch mit:subdomain-2-1 ;
    skos:definition "Sensitive information may be exposed through the LLM or its surrounding application context." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM02:2025 Sensitive Information Disclosure" .

mitctrl:threat-modelling a nexus:RiskControl ;
    nexus:controlType "detective" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "design-time" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:evasion-attack,
        atlas:prompt-injection,
        owasp:llm01-prompt-injection,
        owasp:llm03-supply-chain,
        owasp:llm04-data-and-model-poisoning,
        owasp:llm06-excessive-agency,
        owasp:llm08-vector-and-embedding-weaknesses ;
    skos:broader mitctrl:model-infrastructure-security,
        mitctrl:testing-auditing ;
    skos:definition "A process to identify threats, vulnerabilities, and possible attack paths affecting a system." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Threat Modelling" .

nexus:RiskGroup a owl:Class ;
    rdfs:label "Risk Group" ;
    rdfs:comment "A grouping concept within a risk taxonomy, such as Privacy, Fairness, Robustness, or Misinformation." ;
    rdfs:subClassOf skos:Concept .

nexus:RiskControlGroup a owl:Class ;
    rdfs:label "Risk Control Group" ;
    rdfs:comment """\r
    A grouping concept within a risk control taxonomy, such as Data Governance,\r
    Model Safety Engineering, Testing & Auditing, or Human Oversight.\r
    """ ;
    rdfs:subClassOf beamr:RiskControl,
        skos:Concept .

owasp:OWASP_LLM_Top_10_2025 a nexus:RiskTaxonomy,
        skos:ConceptScheme ;
    dct:description "A taxonomy of critical security vulnerabilities and risks in LLM applications." ;
    owl:versionInfo "2.0" ;
    skos:prefLabel "OWASP Top 10 for Large Language Model Applications" .

mit:subdomain-7-3 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:data-governance,
        mitctrl:red-teaming,
        mitctrl:retrieval-quality-evaluation,
        mitctrl:testing-auditing ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-7 ;
    skos:broader mit:domain-7 ;
    skos:definition "AI systems may fail to perform reliably or effectively under varying conditions." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Lack of capability or robustness" .

mitctrl:red-teaming a nexus:RiskControl ;
    nexus:controlType "detective" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "development" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:hallucination,
        atlas:prompt-injection,
        owasp:llm01-prompt-injection,
        owasp:llm07-system-prompt-leakage,
        owasp:llm09-misinformation ;
    skos:broader mitctrl:model-safety-engineering,
        mitctrl:testing-auditing ;
    skos:definition "Adversarial testing to identify unsafe behavior, vulnerabilities, or misuse pathways." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Red Teaming" .

pair:PatternImplementation a owl:Class ;
    rdfs:label "Pattern Implementation"@en ;
    rdfs:comment "The executable SPARQL query that detects a motif or evaluates a risk pattern against an architecture graph (the OQP to the motif's ODP). One motif may have multiple implementations; an implementation is an implementation of the motif, not the pattern itself."@en .

pair:RiskPattern a owl:Class ;
    rdfs:label "AI Risk Pattern"@en ;
    rdfs:comment "An architectural motif extended with risk semantics: Risk Pattern = Motif + Applicability Conditions + Mechanism + Taxonomy Links + Controls. A risk pattern is reusable knowledge, not a risk; when a motif match satisfies its applicability conditions, a candidate risk finding is emitted. Formerly named pair:MotifInterpretation."@en .

beamr:RiskControl a owl:Class ;
    rdfs:label "Risk Control" ;
    rdfs:subClassOf <https://w3id.org/airoRiskControl> .

pair:ProcessingStep a pair:PatternRole ;
    skos:definition "A step in the processing or decision-making workflow of an AI system, such as data preprocessing, model training, inference, or post-processing."@en ;
    skos:prefLabel "Processing Step"@en .

beam:inform a owl:TransitiveProperty ;
    rdfs:label "inform" ;
    rdfs:domain beam:Process ;
    rdfs:range beam:Process .

mit:subdomain-2-2 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:access-management,
        mitctrl:incident-response-plan,
        mitctrl:input-output-filtering,
        mitctrl:model-infrastructure-security,
        mitctrl:red-teaming,
        mitctrl:threat-modelling ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-2 ;
    skos:broader mit:domain-2 ;
    skos:definition "AI systems may contain vulnerabilities that enable unauthorized access, manipulation, or unsafe behavior." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "AI system security vulnerabilities and attacks" .

pair:RiskFinding a owl:Class ;
    rdfs:label "Candidate Risk Finding"@en ;
    rdfs:comment "A system-specific candidate risk generated when a motif match satisfies the applicability conditions of an AI risk pattern. A candidate risk is a structural disposition toward harm identified at design time; it is not a confirmed failure, an observed incident, or a prediction that harm will occur. Not a subclass of beamr:Risk; it links to the candidate risk via pair:identifiesCandidateRisk."@en .

beam:StatisticalModel a owl:Class ;
    rdfs:label "Statistical Model" ;
    rdfs:subClassOf beam:Model .

mitctrl:input-output-filtering a nexus:RiskControl ;
    nexus:controlType "technical" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "operation" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:hallucination,
        atlas:prompt-injection,
        owasp:llm01-prompt-injection,
        owasp:llm02-sensitive-information-disclosure,
        owasp:llm05-improper-output-handling,
        owasp:llm07-system-prompt-leakage,
        owasp:llm09-misinformation ;
    skos:broader mitctrl:content-safety-controls,
        mitctrl:model-safety-engineering ;
    skos:definition "Filtering or constraining inputs and outputs to reduce unsafe, sensitive, harmful, or policy-violating content." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Input/Output Filtering" .

mitctrl:data-governance a nexus:RiskControlGroup ;
    nexus:controlType "operational" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "design-time",
        "development" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:data-curation,
        atlas:data-usage-restrictions,
        atlas:personal-information-in-data,
        mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure,
        owasp:llm03-supply-chain,
        owasp:llm04-data-and-model-poisoning,
        owasp:llm08-vector-and-embedding-weaknesses ;
    skos:broader mitctrl:operational-process-controls ;
    skos:definition """\r
    Policies and procedures that govern responsible data acquisition, curation, usage,\r
    privacy, quality, and compliance.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Data Governance" .

pair:GraphMotif a owl:Class ;
    rdfs:label "Graph Motif"@en ;
    rdfs:comment "A reusable, descriptive graph pattern over pattern roles and flow relations that captures a recurring system configuration (e.g. vector-based retrieval, retrieval-augmented generation). A motif is risk-neutral by itself; risk semantics are added only by an AI risk pattern (pair:RiskPattern)."@en .

pair:ResourceRole a pair:PatternRole ;
    skos:definition "A role played by a resource that an AI system interacts with, such as a data source, external API, or knowledge graph."@en ;
    skos:prefLabel "Resource Role"@en .

beam:Process a owl:Class ;
    rdfs:label "Process" ;
    rdfs:subClassOf beam:Element,
        <https://kastle-lab.org/easy-ai2/Process> .

nexus:Risk a owl:Class ;
    rdfs:label "Risk" ;
    rdfs:comment "A taxonomy-level AI risk entry adapted from AI Atlas Nexus." ;
    rdfs:subClassOf nexus:RiskTaxonomyEntry .

beam:produce a owl:ObjectProperty ;
    rdfs:label "produce" ;
    rdfs:domain beam:Process ;
    rdfs:range beam:Resource .

mit:MIT_AI_Risk_Repository_Domain_Taxonomy a nexus:RiskTaxonomy,
        skos:ConceptScheme ;
    dct:description "A domain taxonomy of AI risks organized into high-level AI risk domains and subdomains." ;
    skos:prefLabel "MIT AI Risk Repository: Domain Taxonomy of AI Risks" .

<http://w3id.org/airiskkg/facets/task#AITask> a skos:ConceptScheme ;
    dct:source "PAIR-AI unified task taxonomy (expert curation)." ;
    skos:definition "Unified taxonomy of AI tasks: the functional input-to-output relation of a functional unit within the system (compositional; distinct from capability and application type, Rule R7)."@en ;
    skos:prefLabel "AI Task"@en .

atlas:IBM_AI_Risk_Atlas a nexus:RiskTaxonomy,
        skos:ConceptScheme ;
    dct:description "A taxonomy of risks associated with AI systems, including traditional AI, generative AI, synthetic data, and agentic AI risks." ;
    skos:prefLabel "IBM AI Risk Atlas" .

beam:use a owl:ObjectProperty ;
    rdfs:label "use" ;
    rdfs:domain beam:Process ;
    rdfs:range beam:Resource ;
    owl:inverseOf beam:usedBy .

mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy a nexus:RiskControlTaxonomy,
        skos:ConceptScheme ;
    dct:description """\r
    A taxonomy of AI risk mitigations organized into governance and oversight controls,\r
    technical and security controls, operational process controls, and transparency\r
    and accountability controls.\r
    """ ;
    owl:versionInfo "1" ;
    skos:prefLabel "MIT Draft AI Risk Mitigation Taxonomy" .

pair:PatternRole a owl:Class ;
    rdfs:label "Pattern Role"@en ;
    rdfs:comment "An abstract functional role (e.g. VectorStore, RetrievalStep, GenerativeModel) assigned to a concrete architecture element via pair:playsRole; modeled as a SKOS concept. A role labels one element's function; a motif is a structure over several roles. Roles are the semantic bridge that makes motifs reusable across heterogeneous systems."@en ;
    rdfs:subClassOf skos:Concept .

beam:Data a owl:Class ;
    rdfs:label "Data" ;
    rdfs:subClassOf beam:Instance .

pair:PatternEdge a owl:Class ;
    rdfs:label "Pattern Edge"@en ;
    rdfs:comment "An abstract edge of a graph motif connecting two pattern nodes via a BEAM flow predicate."@en .

pair:PatternNode a owl:Class ;
    rdfs:label "Pattern Node"@en ;
    rdfs:comment "An abstract node of a graph motif, constrained by an expected BEAM class and/or an expected pattern role."@en .

