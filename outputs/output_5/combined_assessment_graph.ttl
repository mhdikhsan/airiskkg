pat:TrainToServe_PredictionUsesModelEdge a pair:PatternEdge ;
    rdfs:label "prediction uses automatically deployed model"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:TrainToServe_PredictionStepNode ;
    pair:targetPatternNode pat:TrainToServe_DeployedModelNode .

pat:TrainToServe_TrainingInformsDeploymentEdge a pair:PatternEdge ;
    rdfs:label "training pipeline informs deployment"@en ;
    pair:patternPredicate beam:inform ;
    pair:sourcePatternNode pat:TrainToServe_TrainingPipelineNode ;
    pair:targetPatternNode pat:TrainToServe_AutoDeploymentNode .

pat:TrainToServe_TrainingProducesModelEdge a pair:PatternEdge ;
