pat:RetrievalAugmentedGenerationMotif a pair:GraphMotif ;
    rdfs:label "Retrieval Augmented Generation (RAG) Motif"@en ;
    dct:description "GenAI motif in which a user query is embedded, used to retrieve relevant context from a vector index, combined with a prompt template, and sent to an LLM to produce an answer."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:derivedFrom <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternEdge pat:RAG_GenerationProducesResponseEdge,
        pat:RAG_GenerationUsesLLMEdge,
        pat:RAG_GenerationUsesPromptEdge,
        pat:RAG_PromptConstructionProducesPromptEdge,
        pat:RAG_PromptConstructionUsesContextEdge,
        pat:RAG_PromptConstructionUsesQueryEdge,
        pat:RAG_PromptConstructionUsesTemplateEdge,
        pat:RAG_QueryEmbeddingProducesVectorEdge,
        pat:RAG_QueryEmbeddingUsesModelEdge,
        pat:RAG_QueryEmbeddingUsesQueryEdge,
        pat:RAG_RetrievalProducesContextEdge,
        pat:RAG_RetrievalUsesQueryVectorEdge,
        pat:RAG_RetrievalUsesVectorIndexEdge ;
    pair:hasPatternNode pat:RAG_EmbeddingModelNode,
        pat:RAG_GenerationStepNode,
        pat:RAG_LLMNode,
        pat:RAG_PromptConstructionStepNode,
        pat:RAG_PromptNode,
        pat:RAG_PromptTemplateNode,
        pat:RAG_QueryEmbeddingStepNode,
        pat:RAG_QueryNode,
        pat:RAG_QueryVectorNode,
        pat:RAG_ResponseNode,
        pat:RAG_RetrievalStepNode,
        pat:RAG_RetrievedContextNode,
        pat:RAG_VectorIndexNode ;
    pair:hasRiskPattern pat:MisinformationFromWeakGroundingRiskPattern,
        pat:PromptInjectionRiskPattern,
        pat:SensitiveDataRetrievalExposureRiskPattern,
        pat:UnboundedConsumptionRiskPattern,
        pat:VectorAndEmbeddingWeaknessRiskPattern ;
    pair:implementedBy pat:RAG_MatchingOQP .

