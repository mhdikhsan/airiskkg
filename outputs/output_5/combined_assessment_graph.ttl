pat:RAG_PromptConstructionUsesQueryEdge a pair:PatternEdge ;
    rdfs:label "RAG prompt construction uses query"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:RAG_PromptConstructionStepNode ;
    pair:targetPatternNode pat:RAG_QueryNode .

pat:RAG_PromptConstructionUsesTemplateEdge a pair:PatternEdge ;
    rdfs:label "RAG prompt construction uses template"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:RAG_PromptConstructionStepNode ;
    pair:targetPatternNode pat:RAG_PromptTemplateNode .

pat:RAG_QueryEmbeddingProducesVectorEdge a pair:PatternEdge ;
    rdfs:label "RAG query embedding produces vector"@en ;
    pair:patternPredicate beam:produce ;
    pair:sourcePatternNode pat:RAG_QueryEmbeddingStepNode ;
    pair:targetPatternNode pat:RAG_QueryVectorNode .

pat:RAG_QueryEmbeddingUsesModelEdge a pair:PatternEdge ;
    rdfs:label "RAG query embedding uses model"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:RAG_QueryEmbeddingStepNode ;
    pair:targetPatternNode pat:RAG_EmbeddingModelNode .

pat:RAG_QueryEmbeddingUsesQueryEdge a pair:PatternEdge ;
    rdfs:label "RAG query embedding uses query"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:RAG_QueryEmbeddingStepNode ;
    pair:targetPatternNode pat:RAG_QueryNode .

pat:RAG_RetrievalProducesContextEdge a pair:PatternEdge ;
    rdfs:label "RAG retrieval produces context"@en ;
    pair:patternPredicate beam:produce ;
    pair:sourcePatternNode pat:RAG_RetrievalStepNode ;
    pair:targetPatternNode pat:RAG_RetrievedContextNode .

pat:RAG_RetrievalUsesQueryVectorEdge a pair:PatternEdge ;
    rdfs:label "RAG retrieval uses query vector"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:RAG_RetrievalStepNode ;
    pair:targetPatternNode pat:RAG_QueryVectorNode .

pat:RAG_RetrievalUsesVectorIndexEdge a pair:PatternEdge ;
    rdfs:label "RAG retrieval uses vector index"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:RAG_RetrievalStepNode ;
    pair:targetPatternNode pat:RAG_VectorIndexNode .

pat:RerankerMotif a pair:GraphMotif ;
    rdfs:label "Reranker Motif"@en ;
    dct:description "GenAI motif in which a candidate set of retrieved fragments is ranked against the input query so that the most useful context is passed to the LLM."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:derivedFrom <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternEdge pat:Reranker_RerankingProducesContextEdge,
        pat:Reranker_RerankingUsesCandidateSetEdge,
        pat:Reranker_RerankingUsesModelEdge,
        pat:Reranker_RerankingUsesQueryEdge ;
    pair:hasPatternNode pat:Reranker_CandidateSetNode,
        pat:Reranker_ModelNode,
        pat:Reranker_QueryNode,
        pat:Reranker_RankedContextNode,
        pat:Reranker_RerankingStepNode ;
    pair:hasRiskPattern pat:VectorAndEmbeddingWeaknessRiskPattern ;
    pair:implementedBy pat:Reranker_MatchingOQP .

pat:Reranker_MatchingOQP a pair:PatternImplementation ;
    rdfs:label "Reranker motif matching OQP"@en ;
    pair:implementationPath "ontology/patterns/implementation/match_reranker.rq" ;
    pair:implementsMotif pat:RerankerMotif ;
    pair:producesOutputType pair:MotifMatch .

pat:Reranker_RerankingProducesContextEdge a pair:PatternEdge ;
    rdfs:label "reranking produces selected context"@en ;
    pair:patternPredicate beam:produce ;
    pair:sourcePatternNode pat:Reranker_RerankingStepNode ;
    pair:targetPatternNode pat:Reranker_RankedContextNode .

pat:Reranker_RerankingUsesCandidateSetEdge a pair:PatternEdge ;
    rdfs:label "reranking uses candidate set"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:Reranker_RerankingStepNode ;
    pair:targetPatternNode pat:Reranker_CandidateSetNode .

pat:Reranker_RerankingUsesModelEdge a pair:PatternEdge ;
    rdfs:label "reranking uses reranker model"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:Reranker_RerankingStepNode ;
    pair:targetPatternNode pat:Reranker_ModelNode .

pat:Reranker_RerankingUsesQueryEdge a pair:PatternEdge ;
    rdfs:label "reranking uses query"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:Reranker_RerankingStepNode ;
    pair:targetPatternNode pat:Reranker_QueryNode .

pat:SensitiveDataRetrievalExposureOQP a pair:PatternImplementation ;
    rdfs:label "Sensitive data retrieval exposure risk pattern OQP"@en ;
    pair:implementationPath "ontology/patterns/implementation/risk_sensitive_retrieval.rq" ;
    pair:implementsRiskPattern pat:SensitiveDataRetrievalExposureRiskPattern ;
    pair:producesOutputType pair:RiskFinding .

pat:SupplyChainCompromiseOQP a pair:PatternImplementation ;
    rdfs:label "Supply chain compromise risk pattern OQP"@en ;
    pair:implementationPath "ontology/patterns/implementation/risk_supply_chain.rq" ;
    pair:implementsRiskPattern pat:SupplyChainCompromiseRiskPattern ;
    pair:producesOutputType pair:RiskFinding .

pat:SupplyChain_ExternalDependencyCondition a pair:ApplicabilityCondition ;
    rdfs:label "External model, data, dependency, provider, or artifact is used"@en ;
    pair:operationalizesRiskCondition owasp:condition-externally-sourced-model-data-or-dependency .

pat:SyncPred_PredictionInformsDownstreamEdge a pair:PatternEdge ;
    rdfs:label "synchronous prediction informs downstream step"@en ;
    pair:patternPredicate beam:inform ;
    pair:sourcePatternNode pat:SyncPred_PredictionStepNode ;
    pair:targetPatternNode pat:SyncPred_DownstreamStepNode .

pat:SyncPred_PredictionProducesResultEdge a pair:PatternEdge ;
    rdfs:label "synchronous prediction produces result"@en ;
    pair:patternPredicate beam:produce ;
    pair:sourcePatternNode pat:SyncPred_PredictionStepNode ;
    pair:targetPatternNode pat:SyncPred_ResultNode .

pat:SyncPred_PredictionUsesModelEdge a pair:PatternEdge ;
    rdfs:label "synchronous prediction uses model"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:SyncPred_PredictionStepNode ;
    pair:targetPatternNode pat:SyncPred_ModelNode .

pat:SyncPred_PredictionUsesRequestEdge a pair:PatternEdge ;
    rdfs:label "synchronous prediction uses request"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:SyncPred_PredictionStepNode ;
    pair:targetPatternNode pat:SyncPred_RequestNode .

pat:SystemPromptLeakageOQP a pair:PatternImplementation ;
    rdfs:label "System prompt leakage risk pattern OQP"@en ;
    pair:implementationPath "ontology/patterns/implementation/risk_system_prompt_leakage.rq" ;
    pair:implementsRiskPattern pat:SystemPromptLeakageRiskPattern ;
    pair:producesOutputType pair:RiskFinding .

pat:SystemPromptLeakage_HiddenInstructionCondition a pair:ApplicabilityCondition ;
    rdfs:label "Hidden instructions or system configuration are present in prompt context"@en ;
    pair:operationalizesRiskCondition owasp:condition-hidden-instructions-in-prompt-context .

pat:TrainServe_EvaluationProducesApprovalEdge a pair:PatternEdge ;
    rdfs:label "evaluation produces release approval"@en ;
    pair:patternPredicate beam:produce ;
    pair:sourcePatternNode pat:TrainServe_EvaluationStepNode ;
    pair:targetPatternNode pat:TrainServe_ApprovalNode .

pat:TrainServe_EvaluationUsesCandidateEdge a pair:PatternEdge ;
    rdfs:label "evaluation uses candidate model"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:TrainServe_EvaluationStepNode ;
    pair:targetPatternNode pat:TrainServe_CandidateModelNode .

pat:TrainServe_PredictionUsesModelEdge a pair:PatternEdge ;
    rdfs:label "production prediction uses deployed model"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:TrainServe_PredictionStepNode ;
    pair:targetPatternNode pat:TrainServe_DeployedModelNode .

pat:TrainServe_ReleaseInformsPredictionEdge a pair:PatternEdge ;
    rdfs:label "release informs production prediction"@en ;
    pair:patternPredicate beam:inform ;
    pair:sourcePatternNode pat:TrainServe_ReleaseStepNode ;
    pair:targetPatternNode pat:TrainServe_PredictionStepNode .

pat:TrainServe_ReleaseProducesDeployedModelEdge a pair:PatternEdge ;
    rdfs:label "release produces deployed model"@en ;
    pair:patternPredicate beam:produce ;
    pair:sourcePatternNode pat:TrainServe_ReleaseStepNode ;
    pair:targetPatternNode pat:TrainServe_DeployedModelNode .

pat:TrainServe_ReleaseUsesApprovalEdge a pair:PatternEdge ;
    rdfs:label "release uses approval"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:TrainServe_ReleaseStepNode ;
    pair:targetPatternNode pat:TrainServe_ApprovalNode .

pat:TrainServe_ReleaseUsesCandidateEdge a pair:PatternEdge ;
    rdfs:label "release uses candidate model"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:TrainServe_ReleaseStepNode ;
    pair:targetPatternNode pat:TrainServe_CandidateModelNode .

pat:TrainServe_TrainingInformsEvaluationEdge a pair:PatternEdge ;
    rdfs:label "training informs evaluation"@en ;
    pair:patternPredicate beam:inform ;
    pair:sourcePatternNode pat:TrainServe_TrainingStepNode ;
    pair:targetPatternNode pat:TrainServe_EvaluationStepNode .

pat:TrainServe_TrainingProducesCandidateEdge a pair:PatternEdge ;
    rdfs:label "training produces candidate model"@en ;
    pair:patternPredicate beam:produce ;
    pair:sourcePatternNode pat:TrainServe_TrainingStepNode ;
    pair:targetPatternNode pat:TrainServe_CandidateModelNode .

pat:TrainToServe_DeploymentInformsPredictionEdge a pair:PatternEdge ;
    rdfs:label "automatic deployment informs prediction"@en ;
    pair:patternPredicate beam:inform ;
    pair:sourcePatternNode pat:TrainToServe_AutoDeploymentNode ;
    pair:targetPatternNode pat:TrainToServe_PredictionStepNode .

pat:TrainToServe_DeploymentProducesDeployedModelEdge a pair:PatternEdge ;
    rdfs:label "automatic deployment produces deployed model"@en ;
