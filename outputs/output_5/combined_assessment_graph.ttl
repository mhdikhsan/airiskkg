    pair:sourcePatternNode pat:VectorIR_RetrievalStepNode ;
    pair:targetPatternNode pat:VectorIR_VectorStoreNode .

<http://w3id.org/airiskkg/patterns/motif-library#> a owl:Ontology ;
    dct:description """
    Reusable architecture motifs for PAIR-AI assessment.
    """@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/>,
        <https://mercari.github.io/ml-system-design-pattern/> ;
    dct:title "Architecture Motif Library"@en ;
    owl:imports pair:,
        beam: .

atlas: a owl:Ontology ;
    rdfs:label "IBM AI Risk Atlas Subset for AI Risk KG" ;
    dct:description """\r
    A selected RDF subset of IBM AI Risk Atlas concepts adapted from AI Atlas Nexus.\r
    This subset contains only the groups and risk entries needed for the current\r
    graph-pattern-based AI risk assessment examples.\r
    """ ;
    dct:source <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/knowledge_graph/risk_atlas_data.yaml> ;
    dct:title "IBM AI Risk Atlas Subset for AI Risk KG" .

atlas:data-usage-restrictions a nexus:Risk ;
    nexus:descriptor "traditional risk of AI" ;
    nexus:hasRelatedControl mitctrl:data-governance,
        mitctrl:risk-disclosure,
        mitctrl:system-documentation ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:data-laws ;
    nexus:riskType "training-data" ;
    nexus:tag "data-usage-restrictions" ;
    skos:broader atlas:data-laws ;
    skos:definition "Legal or policy restrictions may limit whether certain data can be used for an AI use case." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Data usage restrictions" ;
    skos:relatedMatch mit:subdomain-2-1,
        mit:subdomain-7-4 .

atlas:legal-accountability a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:risk-disclosure,
        mitctrl:risk-management,
        mitctrl:risk-register,
        mitctrl:system-documentation ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:governance ;
    nexus:riskType "non-technical" ;
    nexus:tag "legal-accountability" ;
    skos:broader atlas:governance ;
    skos:definition "Weak documentation or governance may make responsibility for AI system outcomes unclear." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Legal accountability" ;
    skos:relatedMatch mit:subdomain-7-4 .

<http://w3id.org/airiskkg/taxonomy/mappings#> a owl:Ontology ;
    rdfs:label "AI Risk KG Taxonomy Mappings" ;
    dct:description """
    Cross-taxonomy mappings between selected IBM AI Risk Atlas, MIT AI Risk Repository,
    OWASP LLM Top 10, and MIT AI Risk Control concepts.
    """ ;
    dct:title "AI Risk KG Taxonomy Mappings" .

mit: a owl:Ontology ;
    rdfs:label "MIT AI Risk Repository Subset for AI Risk KG" ;
    dct:description """\r
    A selected RDF subset of the MIT AI Risk Repository domain taxonomy,\r
    adapted from AI Atlas Nexus for use in graph-pattern-based AI risk assessment.\r
    """ ;
    dct:source <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/knowledge_graph/mit_ai_risk_repository_data.yaml> ;
    dct:title "MIT AI Risk Repository Subset for AI Risk KG" .

mit:subdomain-1-1 a nexus:Risk ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-1 ;
    skos:broader mit:domain-1 ;
    skos:definition "AI may treat individuals or groups unfairly or represent them in harmful ways." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Unfair discrimination and misrepresentation" .

mitctrl: a owl:Ontology ;
    rdfs:label "MIT AI Risk Control Subset for AI Risk KG" ;
    dct:description """\r
    A selected RDF subset of the MIT Draft AI Risk Mitigation Taxonomy and related\r
    risk controls, adapted from AI Atlas Nexus. This file provides a control\r
    grounding layer for graph-pattern-based AI risk assessment.\r
    """ ;
    dct:source <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/knowledge_graph/mit_ai_risk_mitigation_data.yaml>,
        <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/knowledge_graph/mit_ai_risk_repository_data_controls.yaml> ;
    dct:title "MIT AI Risk Control Subset for AI Risk KG" .

mitctrl:incident-reporting a nexus:RiskControlGroup ;
    nexus:controlType "transparency-accountability" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "post-deployment" ;
    skos:broader mitctrl:transparency-accountability-controls ;
    skos:definition """\r
    Processes that document and share AI safety incidents, security breaches, failures,\r
    near-misses, and other relevant risk events with appropriate stakeholders.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Incident Reporting" .

mitctrl:incident-response-recovery a nexus:RiskControlGroup ;
    nexus:controlType "corrective" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "operation",
        "post-deployment" ;
    skos:broader mitctrl:operational-process-controls ;
    skos:definition """\r
    Protocols and technical systems that respond to security incidents, safety failures,\r
    model misuse, or harmful system behavior.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Incident Response & Recovery" .

mitctrl:post-deployment-monitoring a nexus:RiskControlGroup ;
    nexus:controlType "detective" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "post-deployment" ;
    skos:broader mitctrl:operational-process-controls ;
    skos:definition """\r
    Ongoing monitoring processes that track AI behavior, user interactions, misuse,\r
    performance degradation, and societal impacts after deployment.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Post-deployment Monitoring" .

mitctrl:staged-deployment a nexus:RiskControlGroup ;
    nexus:controlType "operational" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment" ;
    skos:broader mitctrl:operational-process-controls ;
    skos:definition """\r
    Deployment protocols that release AI systems in stages and require validation\r
    before expanding access or capability.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Staged Deployment" .

mitctrl:user-rights-recourse a nexus:RiskControlGroup ;
    nexus:controlType "transparency-accountability" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "post-deployment" ;
    skos:broader mitctrl:transparency-accountability-controls ;
    skos:definition """\r
    Frameworks and procedures that enable users to identify AI system interactions,\r
    request explanations, report issues, appeal decisions, or seek remediation.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "User Rights & Recourse" .

nexus: a owl:Ontology ;
    rdfs:label "AI Risk KG Taxonomy Core" ;
    dct:description """\r
    A lightweight RDF adaptation of the AI Atlas Nexus taxonomy structure.\r
    This vocabulary is used to represent external AI risk taxonomies,\r
    risk groups, risk taxonomy entries, risk control taxonomies, and\r
    control groups in a way that can be linked to BEAM risk findings\r
    and graph risk patterns.\r
    """ ;
    dct:source <https://github.com/IBM/ai-atlas-nexus/tree/main/src/ai_atlas_nexus/data/knowledge_graph> ;
    dct:title "AI Risk KG Taxonomy Core" .

nexus:RiskControlTaxonomy a owl:Class ;
    rdfs:label "Risk Control Taxonomy" ;
    rdfs:comment "A taxonomy that organizes AI risk controls, mitigations, actions, or control groups." ;
    rdfs:subClassOf nexus:Taxonomy .

owasp: a owl:Ontology ;
    rdfs:label "OWASP LLM Top 10 Subset for AI Risk KG" ;
    dct:description """
    RDF representation of selected OWASP Top 10 for Large Language Model Applications
    2025 entries for AI Risk KG. OWASP GenAI Security is used as the primary
    generative-AI/LLM application security taxonomy baseline; AI Atlas Nexus
    remains a secondary adaptation and alignment source.
    """ ;
    dct:source <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/knowledge_graph/owasp_llm_2.0_data.yaml>,
        <https://github.com/owasp/www-project-top-10-for-large-language-model-applications> ;
    dct:title "OWASP LLM Top 10 Subset for AI Risk KG" .

beam:Note a owl:Class ;
    rdfs:label "Note" ;
    rdfs:comment """A class to hold information about custom annotation to \r
                    System, Container, and various elements of AI systems as part of BEAM notation""" .

beam:perform a owl:ObjectProperty ;
    rdfs:label "perform" ;
    rdfs:domain beam:Element ;
    rdfs:range beam:Task .

beam:usedBy a owl:ObjectProperty ;
    rdfs:label "used by" ;
    rdfs:domain beam:Resource ;
    rdfs:range beam:Process .

beamr:Impact a owl:Class ;
    rdfs:label "Impact" ;
    rdfs:subClassOf beamr:Consequence,
        <https://w3id.org/airoImpact> .

<http://w3id.org/airiskkg/example/verba-goldenverba#UploadedDocument> a beam:Data ;
    rdfs:label "Uploaded document"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedSensitiveKnowledgeBaseContent>,
        pair:UntrustedContent ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#ReadDocument> .

pair:EmbeddingModel a pair:PatternRole ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model that transforms data into vector embeddings."@en ;
    skos:prefLabel "Embedding Model"@en .

pair:EmbeddingVector a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A stored embedding vector."@en ;
    skos:prefLabel "EmbeddingVector"@en .

pair:EvaluationResult a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "The result produced by an evaluation step."@en ;
    skos:prefLabel "EvaluationResult"@en .

pair:EvaluationScore a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A numeric score produced by an evaluation step."@en ;
    skos:prefLabel "EvaluationScore"@en .

pair:GenerativeModel a pair:PatternRole ;
    pair:subRoleOf pair:Model ;
    skos:definition "A model that generates content (e.g. an LLM) at inference time."@en ;
    skos:prefLabel "Generative Model"@en .

pair:GuardrailStep a pair:PatternRole ;
    pair:subRoleOf pair:ControlStep ;
    skos:definition "A guardrail step that screens input or output."@en ;
    skos:prefLabel "GuardrailStep"@en .

pair:JobScheduler a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that schedules jobs in a workflow."@en ;
    skos:prefLabel "JobScheduler"@en .

pair:PredictionLog a pair:PatternRole ;
    pair:subRoleOf pair:ResourceRole ;
    skos:definition "A log of predictions for monitoring/audit."@en ;
    skos:prefLabel "PredictionLog"@en .

pair:PromptConstructionStep a pair:PatternRole ;
    pair:subRoleOf pair:ProcessingStep ;
    skos:definition "A step that assembles a prompt from inputs and context."@en ;
    skos:prefLabel "PromptConstructionStep"@en .

pair:PromptInstruction a pair:DataCategory ;
    dct:source "expert curation" ;
    skos:definition "Instructional content steering model behavior (system prompts, prompt templates, operational configuration). Root category traversed by system-prompt-leakage and embeddings-related conditions."@en ;
    skos:inScheme pair:DataCategoryScheme ;
    skos:prefLabel "Prompt Instruction"@en ;
    skos:topConceptOf pair:DataCategoryScheme .

pair:PublicUserInput a pair:PatternRole ;
    pair:subRoleOf pair:UserInput ;
