pat:SystemPromptLeakageInterpretation a pair:MotifInterpretation ;
    rdfs:label "System prompt leakage interpretation"@en ;
    pair:hasInterpretationCondition pat:SensitiveInfo_OutputExposureCondition,
        pat:SystemPromptLeakage_HiddenInstructionCondition ;
    pair:implementedBy pat:SystemPromptLeakageOQP ;
    pair:interpretedAsMechanism owasp:mechanism-system-prompt-exposure ;
    pair:mayIndicateRisk atlas:confidential-data-in-prompt,
        atlas:prompt-leaking,
        mit:subdomain-2-1,
        mit:subdomain-2-2,
        mit:subdomain-7-4,
        owasp:llm07-system-prompt-leakage ;
    pair:suggestedControl pat:Control_Guardrails,
        pat:Control_OutputValidationAndSanitization,
        pat:Control_SystemPromptSecrecy,
        mitctrl:input-output-filtering,
        mitctrl:privacy-control-for-user-data,
        mitctrl:prompt-context-limiting,
        mitctrl:red-teaming,
        mitctrl:system-architecture-documentation .

atlas:accuracy a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Accuracy" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

atlas:computational-inefficiency a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Computational inefficiency" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

atlas:data-laws a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Data laws" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

atlas:fairness a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Fairness" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

atlas:governance a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Governance" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

atlas:impact-on-the-environment a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:risk-disclosure,
        mitctrl:societal-impact-assessment ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:societal-impact ;
    nexus:riskType "non-technical" ;
    nexus:tag "impact-on-the-environment" ;
    skos:broader atlas:societal-impact ;
    skos:closeMatch mit:subdomain-6-6 ;
    skos:definition "Training or operating AI systems may increase energy use, water use, or carbon emissions." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Impact on the environment" .

atlas:intellectual-property a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Intellectual property" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

atlas:prompt-leaking a nexus:Risk ;
    nexus:descriptor "specific to generative AI" ;
    nexus:hasRelatedControl mitctrl:input-output-filtering,
        mitctrl:red-teaming,
        mitctrl:system-architecture-documentation ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:robustness-prompt-attacks ;
    nexus:riskType "inference" ;
    nexus:tag "prompt-leaking" ;
    skos:broadMatch mit:subdomain-2-2 ;
    skos:broader atlas:robustness-prompt-attacks ;
    skos:closeMatch owasp:llm07-system-prompt-leakage ;
    skos:definition "An attacker may attempt to extract system prompts or hidden instructions from a model." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Prompt leaking" .

atlas:robustness-model-behavior-manipulation a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:broader atlas:robustness ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Robustness: model behavior manipulation" .

atlas:societal-impact a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Societal impact" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

mit:domain-3 a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Misinformation" ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:domain-4 a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Malicious Actors & Misuse" ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:domain-6 a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Socioeconomic & Environmental" ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:subdomain-5-2 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:access-management,
        mitctrl:human-oversight-protocol,
        mitctrl:risk-register ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-5 ;
    skos:broader mit:domain-5 ;
    skos:definition "AI systems may reduce human control, agency, or autonomy in decision-making." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Loss of human agency and autonomy" .

owasp:condition-generation-without-grounding-or-verification a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm09-misinformation ;
    skos:prefLabel "Generation occurs without sufficient grounding, source attribution, or verification"@en .

owasp:condition-hidden-instructions-in-prompt-context a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm07-system-prompt-leakage ;
    skos:prefLabel "Hidden instructions or system configuration are present in prompt context"@en .

owasp:condition-llm-can-trigger-tools-or-state-changes a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm06-excessive-agency ;
    skos:prefLabel "LLM can trigger tools, permissions, transactions, or state changes"@en .

owasp:condition-unbounded-prompt-retrieval-tool-or-model-use a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm10-unbounded-consumption ;
    skos:prefLabel "Prompt, retrieval, tool, or model use is not bounded by cost, rate, or loop controls"@en .

owasp:mechanism-excessive-agency-action-execution a pair:RiskMechanism ;
    rdfs:label "Excessive agency action execution"@en ;
    dct:description "An LLM-driven component can invoke tools, alter state, access resources, or trigger external actions beyond intended limits or oversight."@en ;
    nexus:mechanismForRisk owasp:llm06-excessive-agency .

owasp:mechanism-system-prompt-exposure a pair:RiskMechanism ;
    rdfs:label "System prompt exposure"@en ;
    dct:description "Hidden instructions, policies, tool schemas, or operational configuration become visible through output, context, logs, or adversarial interaction."@en ;
    nexus:mechanismForRisk owasp:llm07-system-prompt-leakage .

owasp:mechanism-unbounded-resource-consumption a pair:RiskMechanism ;
    rdfs:label "Unbounded resource consumption"@en ;
    dct:description "Prompt size, retrieval breadth, tool loops, model calls, or user traffic exceed intended cost, latency, rate, or availability limits."@en ;
    nexus:mechanismForRisk owasp:llm10-unbounded-consumption .

beam:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:subClassOf beam:Element,
        <https://kastle-lab.org/easy-ai2/Actor> .

beam:Generate a owl:Class ;
    rdfs:label "Generate" ;
    rdfs:subClassOf beam:Process .

beam:Instance a owl:Class ;
    rdfs:label "Instance" ;
    rdfs:subClassOf beam:Resource,
        <https://kastle-lab.org/easy-ai2/Artifact> .

beam:Model a owl:Class ;
    rdfs:label "Model" ;
    rdfs:subClassOf beam:Resource,
        <https://kastle-lab.org/easy-ai2/Model> .

beamr:RiskSource a owl:Class ;
    rdfs:label "Risk Source" ;
    rdfs:subClassOf beamr:RiskConcept,
        <https://w3id.org/airoRiskSource> .

<http://w3id.org/airiskkg/example/verba-goldenverba#ReadDocument> a beam:Transform ;
    rdfs:label "Read uploaded document"@en ;
    beam:inform <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkDocument> ;
    beam:produce <http://w3id.org/airiskkg/example/verba-goldenverba#ParsedDocument> ;
    beam:use <http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedDocument> .

<http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore> a pair:MotifMatch ;
    rdfs:label "Embeddings motif match"@en ;
    pair:hasNodeBinding <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/chunking-step>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/document-chunk>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/embedding-step>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/embedding-vector>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/source-document>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/vector-index> ;
    pair:matchesMotif pat:EmbeddingsMotif .

<http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrieveRelevantChunks/vector-ir/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbeddedQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrievedChunks> a pair:MotifMatch ;
    rdfs:label "Vector-based information retrieval motif match"@en ;
    pair:hasNodeBinding <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrieveRelevantChunks/vector-ir/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbeddedQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrievedChunks/binding/query>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrieveRelevantChunks/vector-ir/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbeddedQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrievedChunks/binding/retrieval-step>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrieveRelevantChunks/vector-ir/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbeddedQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrievedChunks/binding/retrieved-result>,
