    pair:expectedRole pat:VectorIndexRole .

pat:FineTune_FineTunedModelNode a pair:PatternNode ;
    rdfs:label "Fine-tuned model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pat:FineTunedModelRole .

pat:Guardrails_RawResponseNode a pair:PatternNode ;
    rdfs:label "Raw LLM response node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:LLMResponseRole .

pat:Guardrails_UserPromptNode a pair:PatternNode ;
    rdfs:label "Guardrails user prompt node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:Hybrid_QueryNode a pair:PatternNode ;
    rdfs:label "Hybrid retriever query node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:ImproperOutputHandlingInterpretation a pair:MotifInterpretation ;
    rdfs:label "Improper output handling interpretation"@en ;
    pair:hasInterpretationCondition pat:ImproperOutputHandling_UnvalidatedOutputCondition ;
    pair:implementedBy pat:ImproperOutputHandlingOQP ;
    pair:interpretedAsMechanism owasp:mechanism-unsafe-output-propagation ;
    pair:mayIndicateRisk atlas:evasion-attack,
        mit:subdomain-1-2,
        mit:subdomain-2-2,
        mit:subdomain-7-3,
        owasp:llm05-improper-output-handling ;
    pair:suggestedControl pat:Control_Guardrails,
        pat:Control_OutputValidationAndSanitization,
        mitctrl:content-safety-controls,
        mitctrl:human-oversight-protocol,
        mitctrl:incident-response-plan,
        mitctrl:input-output-filtering,
        mitctrl:testing-auditing .

pat:LLMResponseRole a pair:PatternRole ;
    pair:subRoleOf pair:UserFacingOutput ;
    skos:prefLabel "LLM Response"@en .

pat:LoadedModelRole a pair:PatternRole ;
    pair:subRoleOf pair:Model ;
    skos:prefLabel "Loaded Model"@en .

pat:ModelImage_DeploymentStepNode a pair:PatternNode ;
    rdfs:label "Model-in-image deployment step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pat:DeploymentStepRole .

pat:ModelImage_ModelArtifactNode a pair:PatternNode ;
    rdfs:label "Model-in-image model artifact node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pat:ModelArtifactRole .

pat:ModelImage_ServingImageNode a pair:PatternNode ;
    rdfs:label "Serving image containing model node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:ServingImageRole .

pat:ModelImage_TrainingStepNode a pair:PatternNode ;
    rdfs:label "Model-in-image training step node"@en ;
    pair:expectedClass beam:Train ;
    pair:expectedRole pat:TrainingStepRole .

pat:ModelLoad_LoadedModelNode a pair:PatternNode ;
    rdfs:label "Loaded model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pat:LoadedModelRole .

pat:ModelLoad_PredictionStepNode a pair:PatternNode ;
    rdfs:label "Model-load prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pat:PredictionStepRole .

pat:MultiStage_RequestNode a pair:PatternNode ;
    rdfs:label "Multi-stage prediction request node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PredictionRequestRole .

pat:PipeTrain_IntermediateDataNode a pair:PatternNode ;
    rdfs:label "Pipeline intermediate data node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PreprocessedDataRole .

pat:PipeTrain_ModelArtifactNode a pair:PatternNode ;
    rdfs:label "Pipeline model artifact node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pat:ModelArtifactRole .

pat:PredLog_RequestNode a pair:PatternNode ;
    rdfs:label "Logged prediction request node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PredictionRequestRole .

pat:PredLog_ResultNode a pair:PatternNode ;
    rdfs:label "Logged prediction result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PredictionResultRole .

pat:PrepPred_PreprocessedDataNode a pair:PatternNode ;
    rdfs:label "Preprocessed data node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PreprocessedDataRole .

pat:PreprocessedDataRole a pair:PatternRole ;
    skos:prefLabel "Preprocessed Data"@en .

pat:PreprocessingStepRole a pair:PatternRole ;
    skos:prefLabel "Preprocessing Step"@en .

pat:QueryRewrite_RewrittenQueryNode a pair:PatternNode ;
    rdfs:label "Rewritten query node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:RewrittenQueryRole .

pat:RAG_LLMNode a pair:PatternNode ;
    rdfs:label "RAG foundation LLM node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pat:FoundationLLMRole .

pat:RAG_PromptTemplateNode a pair:PatternNode ;
    rdfs:label "RAG prompt template node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:PromptTemplate .

pat:RAG_ResponseNode a pair:PatternNode ;
    rdfs:label "RAG response node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:LLMResponseRole .

pat:RAG_VectorIndexNode a pair:PatternNode ;
    rdfs:label "RAG vector index node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:VectorIndexRole .

pat:SensitiveDataRetrievalExposureInterpretation a pair:MotifInterpretation ;
    rdfs:label "Sensitive data retrieval exposure interpretation"@en ;
    pair:hasInterpretationCondition pat:SensitiveInfo_OutputExposureCondition,
        pat:SensitiveInfo_SensitiveContextCondition,
        pat:VectorEmbeddingWeakness_RetrievalCondition ;
    pair:implementedBy pat:SensitiveDataRetrievalExposureOQP ;
    pair:interpretedAsMechanism owasp:mechanism-sensitive-data-propagation ;
    pair:interpretsMotif pat:VectorBasedInformationRetrievalMotif ;
    pair:mayIndicateRisk atlas:exposing-personal-information,
        mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure ;
    pair:suggestedControl pat:Control_DataMinimizationAndRedaction,
        pat:Control_Guardrails,
        pat:Control_OutputValidationAndSanitization,
        pat:Control_RetrievalAccessControl,
        mitctrl:access-management,
        mitctrl:data-governance,
        mitctrl:data-minimization,
        mitctrl:input-output-filtering,
        mitctrl:privacy-control-for-user-data,
        mitctrl:redaction,
        mitctrl:retrieval-source-filtering .

pat:SensitiveInfo_OutputExposureCondition a pair:GraphCondition ;
    rdfs:label "Generated output can expose sensitive information"@en ;
    pair:operationalizesRiskCondition owasp:condition-generated-output-exposed-to-user .

pat:TrainServe_ApprovalNode a pair:PatternNode ;
    rdfs:label "Release approval node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:ReleaseApprovalRole .

pat:TrainServe_DeployedModelNode a pair:PatternNode ;
    rdfs:label "Deployed model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pat:LoadedModelRole .

pat:TrainServe_PredictionStepNode a pair:PatternNode ;
    rdfs:label "Production prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pat:PredictionStepRole .

pat:TrainServe_TrainingStepNode a pair:PatternNode ;
    rdfs:label "Train-then-serve training step node"@en ;
    pair:expectedClass beam:Train ;
    pair:expectedRole pat:TrainingStepRole .

pat:TrainToServe_DeployedModelNode a pair:PatternNode ;
    rdfs:label "Automatically deployed model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pat:LoadedModelRole .

pat:TrainToServe_ModelArtifactNode a pair:PatternNode ;
    rdfs:label "Automatically trained model artifact node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pat:ModelArtifactRole .

pat:TrainToServe_PredictionStepNode a pair:PatternNode ;
    rdfs:label "Training-to-serving prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pat:PredictionStepRole .

pat:TrainToServe_TrainingPipelineNode a pair:PatternNode ;
    rdfs:label "Automated training pipeline node"@en ;
    pair:expectedClass beam:Train ;
    pair:expectedRole pat:TrainingPipelineRole .

pat:TrainingDatasetRole a pair:PatternRole ;
    skos:prefLabel "Training Dataset"@en .

pat:VectorIR_QueryNode a pair:PatternNode ;
    rdfs:label "Query node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:VectorIR_RetrievedResultNode a pair:PatternNode ;
    rdfs:label "Retrieved result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:RetrievedContext .

pat:VectorIR_VectorStoreNode a pair:PatternNode ;
    rdfs:label "Vector store node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:VectorStore .

pat:VectorIndexRole a pair:PatternRole ;
    pair:subRoleOf pair:VectorStore ;
    skos:prefLabel "Vector Index"@en .

atlas:personal-information-in-data a nexus:Risk ;
    nexus:descriptor "traditional risk of AI" ;
    nexus:hasRelatedControl mitctrl:data-curation-process,
        mitctrl:data-governance,
        mitctrl:privacy-control-for-user-data ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:privacy ;
    nexus:riskType "training-data" ;
    nexus:tag "personal-information-in-data" ;
    skos:broadMatch mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure ;
    skos:broader atlas:privacy ;
    skos:definition "Personal or sensitive information in training, tuning, or retrieval data can increase unwanted disclosure risks." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Personal information in data" .

atlas:personal-information-in-prompt a nexus:Risk ;
    nexus:descriptor "specific to generative AI" ;
    nexus:hasRelatedControl mitctrl:input-output-filtering,
        mitctrl:privacy-control-for-user-data,
        mitctrl:prompt-context-limiting ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:privacy ;
    nexus:riskType "inference" ;
    nexus:tag "personal-information-in-prompt" ;
    skos:broadMatch mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure ;
    skos:broader atlas:privacy ;
    skos:definition "Personal or sensitive personal information may be included in prompts and become exposed through model outputs." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Personal information in prompt" .

mit:subdomain-1-2 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:content-safety-controls,
        mitctrl:input-output-filtering,
        mitctrl:red-teaming ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-1 ;
    skos:broader mit:domain-1 ;
    skos:definition "AI may expose users to harmful, abusive, unsafe, or inappropriate content." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Exposure to toxic content" .

mit:subdomain-6-6 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:post-deployment-behavior-monitoring,
        mitctrl:prompt-context-limiting,
        mitctrl:risk-disclosure,
        mitctrl:societal-impact-assessment ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-6 ;
    skos:broader mit:domain-6 ;
    skos:definition "AI development or operation may contribute to environmental harm through resource use or emissions." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Environmental harm" .

mitctrl:pre-deployment-risk-assessment a nexus:RiskControl ;
    nexus:controlType "governance" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment" ;
    nexus:mitigatesRiskTaxonomyEntry owasp:llm03-supply-chain ;
    skos:broader mitctrl:risk-management,
        mitctrl:staged-deployment ;
    skos:definition "Assessment of risks before deployment or before expanding system access." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Pre-deployment Risk Assessment" .

mitctrl:risk-management a nexus:RiskControlGroup ;
    nexus:controlType "governance" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "design-time",
        "development" ;
    skos:broader mitctrl:governance-oversight-controls ;
    skos:definition """\r
    Systematic methods that identify, evaluate, document, and manage AI risks.\r
    Examples include risk registers, pre-deployment risk assessments, independent\r
    risk assessments, and enterprise risk management frameworks.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Risk Management" .

mitctrl:societal-impact-assessment a nexus:RiskControlGroup ;
    nexus:controlType "governance" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "design-time" ;
    skos:broader mitctrl:governance-oversight-controls ;
    skos:definition """\r
    Processes that assess the societal effects of AI systems, including impacts on\r
    employment, power relations, rights, and affected stakeholders.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Societal Impact Assessment" .

mitctrl:technical-security-controls a nexus:RiskControlGroup ;
    nexus:controlType "technical" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:definition """\r
    Technical, physical, and engineering safeguards that secure AI systems and constrain\r
    model behavior to support safety, security, alignment, and content integrity.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Technical & Security Controls" ;
    skos:topConceptOf mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy .

nexus:RiskTaxonomy a owl:Class ;
    rdfs:label "Risk Taxonomy" ;
    rdfs:comment "A taxonomy that organizes AI risks or AI-related vulnerabilities." ;
    rdfs:subClassOf nexus:Taxonomy .

nexus:Taxonomy a owl:Class ;
    rdfs:label "Taxonomy" ;
    rdfs:comment "A structured concept scheme, such as IBM AI Risk Atlas, MIT AI Risk Repository, OWASP LLM Top 10, or MIT AI Risk Mitigation Taxonomy." ;
    rdfs:subClassOf skos:ConceptScheme .

owasp:condition-externally-sourced-model-data-or-dependency a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm03-supply-chain ;
    skos:prefLabel "Externally sourced model, data, component, or provider is used"@en .

owasp:condition-llm-output-used-without-validation a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm05-improper-output-handling ;
    skos:prefLabel "LLM output is used without validation or sanitization"@en .

owasp:condition-sensitive-data-in-context a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm02-sensitive-information-disclosure ;
    skos:prefLabel "Sensitive data is present in prompt or retrieval context"@en .

owasp:condition-untrusted-data-enters-training-finetuning-or-indexing a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm04-data-and-model-poisoning ;
    skos:prefLabel "Untrusted data enters training, fine-tuning, evaluation, or indexing"@en .

owasp:mechanism-data-or-model-poisoning a pair:RiskMechanism ;
    rdfs:label "Data or model poisoning"@en ;
    dct:description "Training, fine-tuning, evaluation, or retrieval/indexing data is manipulated so model behavior or retrieved context becomes attacker-influenced or unreliable."@en ;
    nexus:mechanismForRisk owasp:llm04-data-and-model-poisoning .

owasp:mechanism-sensitive-data-propagation a pair:RiskMechanism ;
    rdfs:label "Sensitive data propagation through LLM context"@en ;
    dct:description "Sensitive information enters prompt, retrieval context, model output, logs, or downstream application flows where it may be disclosed."@en ;
    nexus:mechanismForRisk owasp:llm02-sensitive-information-disclosure .

owasp:mechanism-supply-chain-compromise a pair:RiskMechanism ;
    rdfs:label "Compromised LLM supply chain dependency"@en ;
    dct:description "A model, dataset, dependency, plugin, provider, or deployment artifact is compromised, unverifiable, or insufficiently governed."@en ;
    nexus:mechanismForRisk owasp:llm03-supply-chain .

owasp:mechanism-unsafe-output-propagation a pair:RiskMechanism ;
    rdfs:label "Unsafe generated output propagation"@en ;
    dct:description "LLM output is treated as trusted content or executable instruction without adequate validation, escaping, review, or constraint."@en ;
    nexus:mechanismForRisk owasp:llm05-improper-output-handling .

owasp:mechanism-unsupported-generation a pair:RiskMechanism ;
    rdfs:label "Unsupported or ungrounded generation"@en ;
    dct:description "The LLM produces plausible but unsupported or misleading content because grounding, verification, source quality, or task boundaries are insufficient."@en ;
    nexus:mechanismForRisk owasp:llm09-misinformation .

beam:Task a owl:Class ;
    rdfs:label "Task" ;
    rdfs:subClassOf <http://www.w3id.org/agentic-ai/onto#Task> .

beamr: a owl:Ontology ;
    dct:description "  A beam extension to describe the risk components of AI systems based on existing concepts defined in the AI Risk Ontology (AIRO)."@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0> ;
    dct:modified "2025-03-05" ;
    dct:title "The BEAM Risk extension"@en ;
    vann:preferredNamespacePrefix "beamr" ;
    vann:preferredNamespaceUri "http://w3id.org/beam/risk#" ;
    owl:imports <https://w3id.org/airo>,
        <https://w3id.org/beam/core#> ;
    owl:versionInfo "0.1.0" .

beamr:Consequence a owl:Class ;
    rdfs:label "Consequence" ;
    rdfs:subClassOf beamr:RiskConcept,
        <https://w3id.org/airoConsequence> .

<http://w3id.org/airiskkg/example/verba-goldenverba#IndexChunksInWeaviate> a beam:Transform ;
    rdfs:label "Index chunks in Weaviate"@en ;
    beam:produce <http://w3id.org/airiskkg/example/verba-goldenverba#WeaviateVectorStore> ;
    beam:use <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkEmbeddings>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#DocumentChunks> .

<http://w3id.org/airiskkg/example/verba-goldenverba#ProviderCredentials> a beam:Data ;
    rdfs:label "Provider API credentials"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#ProviderCredential> ;
    pair:playsRole pair:ExternalProviderCredential ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer> .

<http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer> a pair:MotifMatch ;
    rdfs:label "Retrieval augmented generation motif match"@en ;
    pair:hasNodeBinding <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/answer>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/generation-step>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/llm>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/prompt>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/prompt-construction-step>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/prompt-template>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/query>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/query-embedding-step>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/query-vector>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/retrieval-step>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/retrieved-context>,
        <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/vector-index> ;
    pair:matchesMotif pat:RetrievalAugmentedGenerationMotif .

pair: a owl:Ontology ;
    dct:description "Pattern-level vocabulary for constructing the PAIR-AI AI Risk Knowledge Graph. The PAIR-AI assessment method consumes this module; the method workflow itself is represented outside this ontology."@en ;
    dct:title "PAIR-AI Pattern Module Ontology"@en ;
    vann:preferredNamespacePrefix "pair" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/pair-ai#" ;
    owl:imports beam:,
        beamr: .

pair:EmbeddingStep a pair:PatternRole ;
    skos:prefLabel "Embedding Step"@en .

pair:GenerationStep a pair:PatternRole ;
    skos:prefLabel "Generation Step"@en .

pair:KnowledgeSource a pair:PatternRole ;
    skos:prefLabel "Knowledge Source"@en .

pair:PromptTemplate a pair:PatternRole ;
    skos:prefLabel "Prompt Template"@en .

pair:UserFacingOutput a pair:PatternRole ;
    skos:prefLabel "User-facing Output"@en .

pat:BatchTrain_EvaluationStepNode a pair:PatternNode ;
    rdfs:label "Model evaluation step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pat:EvaluationStepRole .

pat:Control_InputValidationAndPromptIsolation a beamr:RiskControl ;
    dct:description "Validate, constrain, and isolate user, retrieved, and tool-supplied content before it enters the prompt context."@en ;
    skos:prefLabel "Input validation and prompt isolation"@en ;
    skos:relatedMatch mitctrl:input-output-filtering,
        mitctrl:prompt-context-limiting .

pat:Control_ModelAndDependencyProvenance a beamr:RiskControl ;
    dct:description "Track, verify, and govern models, datasets, plugins, dependencies, and deployment artifacts used by the LLM application."@en ;
    skos:prefLabel "Model and dependency provenance"@en ;
    skos:relatedMatch mitctrl:model-infrastructure-security,
        mitctrl:risk-register,
        mitctrl:system-architecture-documentation .

pat:DataAndModelPoisoningInterpretation a pair:MotifInterpretation ;
    rdfs:label "Data and model poisoning interpretation"@en ;
    pair:hasInterpretationCondition pat:Poisoning_UntrustedTrainingOrIndexingDataCondition ;
    pair:implementedBy pat:DataAndModelPoisoningOQP ;
    pair:interpretedAsMechanism owasp:mechanism-data-or-model-poisoning ;
    pair:mayIndicateRisk atlas:data-curation,
        mit:subdomain-1-3,
        mit:subdomain-2-2,
        mit:subdomain-7-3,
        owasp:llm04-data-and-model-poisoning ;
    pair:suggestedControl pat:Control_LoggingMonitoringAndEvals,
        pat:Control_ModelAndDependencyProvenance,
        pat:Control_TrustedTrainingAndIndexingData,
        mitctrl:data-curation-process,
        mitctrl:data-governance,
        mitctrl:model-infrastructure-security,
        mitctrl:testing-auditing,
        mitctrl:threat-modelling .

pat:DirectLLM_GenerationStepNode a pair:PatternNode ;
