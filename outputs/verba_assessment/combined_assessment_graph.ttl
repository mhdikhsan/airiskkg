    pair:sourcePatternNode pat:SyncPred_PredictionStepNode ;
    pair:targetPatternNode pat:SyncPred_DownstreamStepNode .

pat:SyncPred_PredictionProducesResultEdge a pair:PatternEdge ;
    rdfs:label "synchronous prediction produces result"@en ;
    pair:patternPredicate beam:produce ;
    pair:sourcePatternNode pat:SyncPred_PredictionStepNode ;
    pair:targetPatternNode pat:SyncPred_ResultNode .

pat:SyncPred_PredictionUsesModelEdge a pair:PatternEdge ;
    rdfs:label "synchronous prediction uses model"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:SyncPred_PredictionStepNode ;
    pair:targetPatternNode pat:SyncPred_ModelNode .

pat:SyncPred_PredictionUsesRequestEdge a pair:PatternEdge ;
    rdfs:label "synchronous prediction uses request"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:SyncPred_PredictionStepNode ;
    pair:targetPatternNode pat:SyncPred_RequestNode .

pat:SystemPromptLeakageOQP a pair:PatternImplementation ;
    rdfs:label "System prompt leakage interpretation OQP"@en ;
    pair:implementationPath "ontology/patterns/implementation/risk_system_prompt_leakage.rq" ;
    pair:implementsInterpretation pat:SystemPromptLeakageInterpretation ;
    pair:producesOutputType pair:RiskFinding .

pat:SystemPromptLeakage_HiddenInstructionCondition a pair:GraphCondition ;
    rdfs:label "Hidden instructions or system configuration are present in prompt context"@en ;
    pair:operationalizesRiskCondition owasp:condition-hidden-instructions-in-prompt-context .

pat:TrainServe_EvaluationProducesApprovalEdge a pair:PatternEdge ;
    rdfs:label "evaluation produces release approval"@en ;
    pair:patternPredicate beam:produce ;
    pair:sourcePatternNode pat:TrainServe_EvaluationStepNode ;
    pair:targetPatternNode pat:TrainServe_ApprovalNode .

pat:TrainServe_EvaluationUsesCandidateEdge a pair:PatternEdge ;
    rdfs:label "evaluation uses candidate model"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:TrainServe_EvaluationStepNode ;
    pair:targetPatternNode pat:TrainServe_CandidateModelNode .

pat:TrainServe_PredictionUsesModelEdge a pair:PatternEdge ;
    rdfs:label "production prediction uses deployed model"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:TrainServe_PredictionStepNode ;
    pair:targetPatternNode pat:TrainServe_DeployedModelNode .

pat:TrainServe_ReleaseInformsPredictionEdge a pair:PatternEdge ;
    rdfs:label "release informs production prediction"@en ;
    pair:patternPredicate beam:inform ;
    pair:sourcePatternNode pat:TrainServe_ReleaseStepNode ;
    pair:targetPatternNode pat:TrainServe_PredictionStepNode .

pat:TrainServe_ReleaseProducesDeployedModelEdge a pair:PatternEdge ;
    rdfs:label "release produces deployed model"@en ;
    pair:patternPredicate beam:produce ;
    pair:sourcePatternNode pat:TrainServe_ReleaseStepNode ;
    pair:targetPatternNode pat:TrainServe_DeployedModelNode .

pat:TrainServe_ReleaseUsesApprovalEdge a pair:PatternEdge ;
    rdfs:label "release uses approval"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:TrainServe_ReleaseStepNode ;
    pair:targetPatternNode pat:TrainServe_ApprovalNode .

pat:TrainServe_ReleaseUsesCandidateEdge a pair:PatternEdge ;
    rdfs:label "release uses candidate model"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:TrainServe_ReleaseStepNode ;
    pair:targetPatternNode pat:TrainServe_CandidateModelNode .

pat:TrainServe_TrainingInformsEvaluationEdge a pair:PatternEdge ;
    rdfs:label "training informs evaluation"@en ;
    pair:patternPredicate beam:inform ;
    pair:sourcePatternNode pat:TrainServe_TrainingStepNode ;
    pair:targetPatternNode pat:TrainServe_EvaluationStepNode .

pat:TrainServe_TrainingProducesCandidateEdge a pair:PatternEdge ;
    rdfs:label "training produces candidate model"@en ;
    pair:patternPredicate beam:produce ;
    pair:sourcePatternNode pat:TrainServe_TrainingStepNode ;
    pair:targetPatternNode pat:TrainServe_CandidateModelNode .

pat:TrainToServe_DeploymentInformsPredictionEdge a pair:PatternEdge ;
    rdfs:label "automatic deployment informs prediction"@en ;
    pair:patternPredicate beam:inform ;
    pair:sourcePatternNode pat:TrainToServe_AutoDeploymentNode ;
    pair:targetPatternNode pat:TrainToServe_PredictionStepNode .

pat:TrainToServe_DeploymentProducesDeployedModelEdge a pair:PatternEdge ;
    rdfs:label "automatic deployment produces deployed model"@en ;
    pair:patternPredicate beam:produce ;
    pair:sourcePatternNode pat:TrainToServe_AutoDeploymentNode ;
    pair:targetPatternNode pat:TrainToServe_DeployedModelNode .

pat:TrainToServe_DeploymentUsesModelEdge a pair:PatternEdge ;
    rdfs:label "automatic deployment uses model"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:TrainToServe_AutoDeploymentNode ;
    pair:targetPatternNode pat:TrainToServe_ModelArtifactNode .

pat:TrainToServe_PredictionUsesModelEdge a pair:PatternEdge ;
    rdfs:label "prediction uses automatically deployed model"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:TrainToServe_PredictionStepNode ;
    pair:targetPatternNode pat:TrainToServe_DeployedModelNode .

pat:TrainToServe_TrainingInformsDeploymentEdge a pair:PatternEdge ;
    rdfs:label "training pipeline informs deployment"@en ;
    pair:patternPredicate beam:inform ;
    pair:sourcePatternNode pat:TrainToServe_TrainingPipelineNode ;
    pair:targetPatternNode pat:TrainToServe_AutoDeploymentNode .

pat:TrainToServe_TrainingProducesModelEdge a pair:PatternEdge ;
    rdfs:label "training pipeline produces model"@en ;
    pair:patternPredicate beam:produce ;
    pair:sourcePatternNode pat:TrainToServe_TrainingPipelineNode ;
    pair:targetPatternNode pat:TrainToServe_ModelArtifactNode .

pat:TrainingPipelineRole a pair:PatternRole ;
    skos:prefLabel "Training Pipeline"@en .

pat:UnboundedConsumptionOQP a pair:PatternImplementation ;
    rdfs:label "Unbounded consumption interpretation OQP"@en ;
    pair:implementationPath "ontology/patterns/implementation/risk_unbounded_consumption.rq" ;
    pair:implementsInterpretation pat:UnboundedConsumptionInterpretation ;
    pair:producesOutputType pair:RiskFinding .

pat:UnboundedConsumption_UnboundedUseCondition a pair:GraphCondition ;
    rdfs:label "Prompt, retrieval, tool, or model use is not bounded"@en ;
    pair:operationalizesRiskCondition owasp:condition-unbounded-prompt-retrieval-tool-or-model-use .

pat:VectorAndEmbeddingWeaknessOQP a pair:PatternImplementation ;
    rdfs:label "Vector and embedding weakness interpretation OQP"@en ;
    pair:implementationPath "ontology/patterns/implementation/risk_vector_embedding_weakness.rq" ;
    pair:implementsInterpretation pat:VectorAndEmbeddingWeaknessInterpretation ;
    pair:producesOutputType pair:RiskFinding .

pat:VectorIR_MatchingOQP a pair:PatternImplementation ;
    rdfs:label "Vector information retrieval motif matching OQP"@en ;
    pair:implementationPath "ontology/patterns/implementation/match_vector_ir.rq" ;
    pair:implementsMotif pat:VectorBasedInformationRetrievalMotif ;
    pair:producesOutputType pair:MotifMatch .

pat:VectorIR_RetrievalProducesResultEdge a pair:PatternEdge ;
    rdfs:label "retrieval produces retrieved result"@en ;
    pair:patternPredicate beam:produce ;
    pair:sourcePatternNode pat:VectorIR_RetrievalStepNode ;
    pair:targetPatternNode pat:VectorIR_RetrievedResultNode .

pat:VectorIR_RetrievalUsesQueryEdge a pair:PatternEdge ;
    rdfs:label "retrieval uses query"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:VectorIR_RetrievalStepNode ;
    pair:targetPatternNode pat:VectorIR_QueryNode .

pat:VectorIR_RetrievalUsesVectorStoreEdge a pair:PatternEdge ;
    rdfs:label "retrieval uses vector store"@en ;
    pair:patternPredicate beam:use ;
    pair:sourcePatternNode pat:VectorIR_RetrievalStepNode ;
    pair:targetPatternNode pat:VectorIR_VectorStoreNode .

pat:VectorSearchStepRole a pair:PatternRole ;
    pair:subRoleOf pair:RetrievalStep ;
    skos:prefLabel "Vector Search Step"@en .

<http://w3id.org/airiskkg/patterns/motif-library#> a owl:Ontology ;
    dct:description """
    Reusable architecture motifs for PAIR-AI assessment of LLM-based
    applications. The library combines method-specific motifs with selected
    GenAI and ML system design patterns used to describe LLM application
    architecture and lifecycle.
    """@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/>,
        <https://mercari.github.io/ml-system-design-pattern/> ;
    dct:title "LLM Application Motif Library"@en ;
    owl:imports pair:,
        beam: .

atlas: a owl:Ontology ;
    rdfs:label "IBM AI Risk Atlas Subset for AI Risk KG" ;
    dct:description """\r
    A selected RDF subset of IBM AI Risk Atlas concepts adapted from AI Atlas Nexus.\r
    This subset contains only the groups and risk entries needed for the current\r
    graph-pattern-based AI risk assessment examples.\r
    """ ;
    dct:source <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/knowledge_graph/risk_atlas_data.yaml> ;
    dct:title "IBM AI Risk Atlas Subset for AI Risk KG" .

atlas:data-usage-restrictions a nexus:Risk ;
    nexus:descriptor "traditional risk of AI" ;
    nexus:hasRelatedControl mitctrl:data-governance,
        mitctrl:risk-disclosure,
        mitctrl:system-documentation ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:data-laws ;
    nexus:riskType "training-data" ;
    nexus:tag "data-usage-restrictions" ;
    skos:broader atlas:data-laws ;
    skos:definition "Legal or policy restrictions may limit whether certain data can be used for an AI use case." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Data usage restrictions" ;
    skos:relatedMatch mit:subdomain-2-1,
        mit:subdomain-7-4 .

atlas:legal-accountability a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:risk-disclosure,
        mitctrl:risk-management,
        mitctrl:risk-register,
        mitctrl:system-documentation ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:governance ;
    nexus:riskType "non-technical" ;
    nexus:tag "legal-accountability" ;
    skos:broader atlas:governance ;
    skos:definition "Weak documentation or governance may make responsibility for AI system outcomes unclear." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Legal accountability" ;
    skos:relatedMatch mit:subdomain-7-4 .

<http://w3id.org/airiskkg/taxonomy/mappings#> a owl:Ontology ;
    rdfs:label "AI Risk KG Taxonomy Mappings" ;
    dct:description """
    Cross-taxonomy mappings between selected IBM AI Risk Atlas, MIT AI Risk Repository,
    OWASP LLM Top 10, and MIT AI Risk Control concepts.
    """ ;
    dct:title "AI Risk KG Taxonomy Mappings" .

mit: a owl:Ontology ;
    rdfs:label "MIT AI Risk Repository Subset for AI Risk KG" ;
    dct:description """\r
    A selected RDF subset of the MIT AI Risk Repository domain taxonomy,\r
    adapted from AI Atlas Nexus for use in graph-pattern-based AI risk assessment.\r
    """ ;
    dct:source <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/knowledge_graph/mit_ai_risk_repository_data.yaml> ;
    dct:title "MIT AI Risk Repository Subset for AI Risk KG" .

mit:subdomain-1-1 a nexus:Risk ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-1 ;
    skos:broader mit:domain-1 ;
    skos:definition "AI may treat individuals or groups unfairly or represent them in harmful ways." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Unfair discrimination and misrepresentation" .

mitctrl: a owl:Ontology ;
    rdfs:label "MIT AI Risk Control Subset for AI Risk KG" ;
    dct:description """\r
    A selected RDF subset of the MIT Draft AI Risk Mitigation Taxonomy and related\r
    risk controls, adapted from AI Atlas Nexus. This file provides a control\r
    grounding layer for graph-pattern-based AI risk assessment.\r
    """ ;
    dct:source <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/knowledge_graph/mit_ai_risk_mitigation_data.yaml>,
        <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/knowledge_graph/mit_ai_risk_repository_data_controls.yaml> ;
    dct:title "MIT AI Risk Control Subset for AI Risk KG" .

mitctrl:incident-reporting a nexus:RiskControlGroup ;
    nexus:controlType "transparency-accountability" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "post-deployment" ;
    skos:broader mitctrl:transparency-accountability-controls ;
    skos:definition """\r
    Processes that document and share AI safety incidents, security breaches, failures,\r
    near-misses, and other relevant risk events with appropriate stakeholders.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Incident Reporting" .

mitctrl:incident-response-recovery a nexus:RiskControlGroup ;
    nexus:controlType "corrective" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "operation",
        "post-deployment" ;
    skos:broader mitctrl:operational-process-controls ;
    skos:definition """\r
    Protocols and technical systems that respond to security incidents, safety failures,\r
    model misuse, or harmful system behavior.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Incident Response & Recovery" .

mitctrl:post-deployment-monitoring a nexus:RiskControlGroup ;
    nexus:controlType "detective" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "post-deployment" ;
    skos:broader mitctrl:operational-process-controls ;
    skos:definition """\r
    Ongoing monitoring processes that track AI behavior, user interactions, misuse,\r
    performance degradation, and societal impacts after deployment.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Post-deployment Monitoring" .

mitctrl:staged-deployment a nexus:RiskControlGroup ;
    nexus:controlType "operational" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment" ;
    skos:broader mitctrl:operational-process-controls ;
    skos:definition """\r
    Deployment protocols that release AI systems in stages and require validation\r
    before expanding access or capability.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Staged Deployment" .

mitctrl:user-rights-recourse a nexus:RiskControlGroup ;
    nexus:controlType "transparency-accountability" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "post-deployment" ;
    skos:broader mitctrl:transparency-accountability-controls ;
    skos:definition """\r
    Frameworks and procedures that enable users to identify AI system interactions,\r
    request explanations, report issues, appeal decisions, or seek remediation.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "User Rights & Recourse" .

nexus: a owl:Ontology ;
    rdfs:label "AI Risk KG Taxonomy Core" ;
    dct:description """\r
    A lightweight RDF adaptation of the AI Atlas Nexus taxonomy structure.\r
    This vocabulary is used to represent external AI risk taxonomies,\r
    risk groups, risk taxonomy entries, risk control taxonomies, and\r
    control groups in a way that can be linked to BEAM risk findings\r
    and graph risk patterns.\r
    """ ;
    dct:source <https://github.com/IBM/ai-atlas-nexus/tree/main/src/ai_atlas_nexus/data/knowledge_graph> ;
    dct:title "AI Risk KG Taxonomy Core" .

nexus:RiskControlTaxonomy a owl:Class ;
    rdfs:label "Risk Control Taxonomy" ;
    rdfs:comment "A taxonomy that organizes AI risk controls, mitigations, actions, or control groups." ;
    rdfs:subClassOf nexus:Taxonomy .

owasp: a owl:Ontology ;
    rdfs:label "OWASP LLM Top 10 Subset for AI Risk KG" ;
    dct:description """
    RDF representation of selected OWASP Top 10 for Large Language Model Applications
    2025 entries for AI Risk KG. OWASP GenAI Security is used as the primary
    generative-AI/LLM application security taxonomy baseline; AI Atlas Nexus
    remains a secondary adaptation and alignment source.
    """ ;
    dct:source <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/knowledge_graph/owasp_llm_2.0_data.yaml>,
        <https://github.com/owasp/www-project-top-10-for-large-language-model-applications> ;
    dct:title "OWASP LLM Top 10 Subset for AI Risk KG" .

beam:Note a owl:Class ;
    rdfs:label "Note" ;
    rdfs:comment """A class to hold information about custom annotation to \r
                    System, Container, and various elements of AI systems as part of BEAM notation""" .

beam:perform a owl:ObjectProperty ;
    rdfs:label "perform" ;
    rdfs:domain beam:Element ;
    rdfs:range beam:Task .

beam:usedBy a owl:ObjectProperty ;
    rdfs:label "used by" ;
    rdfs:domain beam:Resource ;
    rdfs:range beam:Process .

beamr:Impact a owl:Class ;
    rdfs:label "Impact" ;
    rdfs:subClassOf beamr:Consequence,
        <https://w3id.org/airoImpact> .

<http://w3id.org/airiskkg/example/verba-goldenverba#UploadedDocument> a beam:Data ;
    rdfs:label "Uploaded document"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedSensitiveKnowledgeBaseContent>,
        pair:UntrustedContent ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#ReadDocument> .

pair:ExternalDependency a pair:PatternRole ;
    pair:subRoleOf pair:ExternalResource ;
    skos:prefLabel "External Dependency"@en .

pair:PromptConstructionStep a pair:PatternRole ;
    skos:prefLabel "Prompt Construction Step"@en .

pair:PromptInstruction a pair:DataCategory ;
    pair:subDataCategoryOf pair:Information ;
    skos:prefLabel "Prompt Instruction"@en .

pair:PublicUserInput a pair:PatternRole ;
    pair:subRoleOf pair:UserInput ;
    skos:prefLabel "Public User Input"@en .

pair:SensitiveInformation a pair:DataCategory ;
    pair:subDataCategoryOf pair:Information ;
    skos:prefLabel "Sensitive Information"@en .

pat:AsyncPred_RequestNode a pair:PatternNode ;
    rdfs:label "Asynchronous prediction request node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PredictionRequestRole .

pat:AsyncPred_ResultNode a pair:PatternNode ;
    rdfs:label "Asynchronous prediction result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PredictionResultRole .

pat:BatchPred_DatasetNode a pair:PatternNode ;
    rdfs:label "Batch prediction dataset node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:BatchDatasetRole .

pat:BatchPred_ModelNode a pair:PatternNode ;
    rdfs:label "Batch prediction model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:Model .

pat:BatchPred_ResultNode a pair:PatternNode ;
    rdfs:label "Batch prediction result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:PredictionResultRole .

pat:BatchPred_SchedulerNode a pair:PatternNode ;
    rdfs:label "Batch prediction scheduler node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pat:JobSchedulerRole .

pat:BatchTrain_DatasetNode a pair:PatternNode ;
    rdfs:label "Batch training dataset node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:TrainingDatasetRole .

pat:BatchTrain_EvaluationResultNode a pair:PatternNode ;
    rdfs:label "Model evaluation result node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:EvaluationResultRole .

pat:BatchTrain_SchedulerNode a pair:PatternNode ;
    rdfs:label "Batch training scheduler node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pat:JobSchedulerRole .

pat:Control_DataMinimizationAndRedaction a beamr:RiskControl ;
    dct:description "Limit, mask, or remove sensitive information before it enters prompts, retrieval context, logs, or generated output."@en ;
    skos:prefLabel "Data minimization and redaction"@en ;
    skos:relatedMatch mitctrl:data-minimization,
        mitctrl:privacy-control-for-user-data,
        mitctrl:redaction .

pat:Control_RateLimitBudgetAndLoopControl a beamr:RiskControl ;
    dct:description "Bound prompt size, retrieval breadth, model calls, tool loops, rate, cost, latency, and resource use."@en ;
    skos:prefLabel "Rate, budget, and loop control"@en ;
    skos:relatedMatch mitctrl:access-management,
        mitctrl:post-deployment-behavior-monitoring,
        mitctrl:prompt-context-limiting .

pat:DirectLLMAnsweringMotif a pair:GraphMotif ;
    rdfs:label "Direct LLM Answering Motif"@en ;
    dct:description """
    Architectural motif in which a user query is handled directly by a
    generative model step and produces a user-facing answer. 
    """@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasInterpretation pat:DirectLLMAnsweringWithoutGroundingInterpretation,
        pat:ImproperOutputHandlingInterpretation,
        pat:PromptInjectionInterpretation,
        pat:UnboundedConsumptionInterpretation ;
    pair:hasPatternEdge pat:DirectLLM_GenerationProducesAnswerEdge,
        pat:DirectLLM_GenerationUsesModelEdge,
        pat:DirectLLM_GenerationUsesQueryEdge ;
    pair:hasPatternNode pat:DirectLLM_AnswerNode,
        pat:DirectLLM_GenerationStepNode,
        pat:DirectLLM_ModelNode,
        pat:DirectLLM_QueryNode ;
    pair:implementedBy pat:DirectLLM_MatchingOQP ;
    skos:altLabel "Direct Prompting Motif"@en .

pat:DirectLLMAnsweringWithoutGroundingInterpretation a pair:MotifInterpretation ;
    rdfs:label "Direct LLM answering without grounding interpretation"@en ;
    pair:hasInterpretationCondition pat:Misinformation_UngroundedGenerationCondition ;
    pair:implementedBy pat:DirectLLMAnsweringWithoutGroundingOQP ;
    pair:interpretedAsMechanism owasp:mechanism-unsupported-generation ;
    pair:interpretsMotif pat:DirectLLMAnsweringMotif ;
    pair:mayIndicateRisk atlas:hallucination,
        atlas:incomplete-advice,
        mit:subdomain-3-1,
        mit:subdomain-5-1,
        mit:subdomain-7-3,
        owasp:llm09-misinformation ;
    pair:suggestedControl pat:Control_GroundingAndVerification,
        pat:Control_LoggingMonitoringAndEvals,
        mitctrl:human-oversight-protocol,
        mitctrl:input-output-filtering,
        mitctrl:red-teaming,
        mitctrl:retrieval-quality-evaluation .

pat:DirectLLM_AnswerNode a pair:PatternNode ;
    rdfs:label "Answer node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserFacingOutput .

pat:DirectLLM_ModelNode a pair:PatternNode ;
    rdfs:label "LLM node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pair:GenerativeModel .

pat:DirectLLM_QueryNode a pair:PatternNode ;
    rdfs:label "Query node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:EmbeddingModelRole a pair:PatternRole ;
    pair:subRoleOf pair:Model ;
    skos:prefLabel "Embedding Model"@en .

pat:EmbeddingVectorRole a pair:PatternRole ;
    skos:prefLabel "Embedding Vector"@en .

pat:Embedding_ModelNode a pair:PatternNode ;
    rdfs:label "Embedding model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pat:EmbeddingModelRole .

pat:Evals_ContextNode a pair:PatternNode ;
    rdfs:label "Evaluation retrieval context node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:RetrievedContext .

pat:Evals_ExpectedOutputNode a pair:PatternNode ;
    rdfs:label "Expected output node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:ExpectedOutputRole .

pat:Evals_InputNode a pair:PatternNode ;
    rdfs:label "Evaluation input node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pair:UserInput .

pat:Evals_JudgeModelNode a pair:PatternNode ;
    rdfs:label "Judge model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pat:JudgeModelRole .

pat:Evals_ModelOutputNode a pair:PatternNode ;
    rdfs:label "Evaluation model output node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:LLMResponseRole .

pat:Evals_ScoreNode a pair:PatternNode ;
    rdfs:label "Evaluation score node"@en ;
    pair:expectedClass beam:Data ;
    pair:expectedRole pat:EvaluationScoreRole .

pat:EvaluationResultRole a pair:PatternRole ;
    skos:prefLabel "Evaluation Result"@en .

pat:EvaluationScoreRole a pair:PatternRole ;
    skos:prefLabel "Evaluation Score"@en .

pat:FineTune_BaseModelNode a pair:PatternNode ;
    rdfs:label "Fine tuning base model node"@en ;
    pair:expectedClass beam:StatisticalModel ;
    pair:expectedRole pat:FoundationLLMRole .

pat:FineTune_DatasetNode a pair:PatternNode ;
    rdfs:label "Fine tuning dataset node"@en ;
    pair:expectedClass beam:Data ;
