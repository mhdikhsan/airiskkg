<http://w3id.org/airiskkg/example/verba-goldenverba#> a owl:Ontology ;
    dct:description "Architecture graph for the goldenverba package in Weaviate Verba, modeled as a public document Q&A RAG workflow with ingestion, chunking, embedding, Weaviate retrieval, prompt construction, and answer generation."@en ;
    dct:source <https://github.com/weaviate/Verba/blob/main/README.md>,
        <https://github.com/weaviate/Verba/blob/main/goldenverba/components/retriever/WindowRetriever.py>,
        <https://github.com/weaviate/Verba/blob/main/goldenverba/verba_manager.py>,
        <https://github.com/weaviate/Verba/tree/main/goldenverba> ;
    dct:title "Verba Goldenverba RAG Application Use Case"@en ;
    vann:preferredNamespacePrefix "verba" ;
    vann:preferredNamespaceUri "http://w3id.org/airiskkg/example/verba-goldenverba#" ;
    owl:imports pair:,
        beam: .

<http://w3id.org/airiskkg/example/verba-goldenverba#VerbaSystem> a beam:System ;
    rdfs:label "Verba goldenverba public RAG chatbot"@en ;
    beam:context "Open-source RAG application that ingests user supplied documents, stores chunks and vectors in Weaviate, retrieves relevant context for a public user query, and generates an answer with a selected LLM provider."@en ;
    beam:hasProcess <http://w3id.org/airiskkg/example/verba-goldenverba#BuildRAGPrompt>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#IndexChunksInWeaviate>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ReadDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RetrieveRelevantChunks> ;
    beam:hasResource <http://w3id.org/airiskkg/example/verba-goldenverba#Answer>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkEmbeddings>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#DocumentChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#EmbeddedQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#GeneratorModel>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ParsedDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ProviderCredentials>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#PublicQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGPrompt>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RetrievedChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#WeaviateVectorStore> .

<http://w3id.org/airiskkg/generated/risk-finding/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fgenerated%2Fmotif-match%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523EmbedChunks%2Fembeddings%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523ParsedDocument%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523WeaviateVectorStore/data-model-poisoning> a pair:RiskFinding ;
    rdfs:label "Candidate data or model poisoning exposure"@en ;
    dct:description "Untrusted content is used in an embedding, indexing, fine-tuning, or training path that can affect model or retrieval behavior."@en ;
    pair:findingStatus "candidate" ;
    pair:generatedByMotif pat:EmbeddingsMotif ;
    pair:generatedFromMatch <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore> ;
    pair:hasCandidateRiskTaxonomyEntry atlas:data-curation,
        mit:subdomain-1-3,
        mit:subdomain-2-2,
        mit:subdomain-7-3,
        owasp:llm04-data-and-model-poisoning ;
    pair:hasEvidenceElement <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkEmbeddings>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#DocumentChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ParsedDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#WeaviateVectorStore> ;
    pair:hasInterpretedMechanism owasp:mechanism-data-or-model-poisoning ;
    pair:hasSatisfiedCondition pat:Poisoning_UntrustedTrainingOrIndexingDataCondition,
        owasp:condition-untrusted-data-enters-training-finetuning-or-indexing ;
    pair:hasSuggestedControl pat:Control_LoggingMonitoringAndEvals,
        pat:Control_ModelAndDependencyProvenance,
        pat:Control_TrustedTrainingAndIndexingData,
        mitctrl:data-curation-process,
        mitctrl:data-governance,
        mitctrl:model-infrastructure-security,
        mitctrl:testing-auditing,
        mitctrl:threat-modelling .

