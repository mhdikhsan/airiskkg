atlas:confidential-data-in-prompt a nexus:Risk ;
    nexus:descriptor "specific to generative AI" ;
    nexus:hasRelatedControl mitctrl:input-output-filtering,
        mitctrl:prompt-context-limiting,
        mitctrl:system-architecture-documentation ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:intellectual-property ;
    nexus:riskType "inference" ;
    nexus:tag "confidential-data-in-prompt" ;
    skos:broadMatch mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure ;
    skos:broader atlas:intellectual-property ;
    skos:definition "Confidential information may be included in prompts and exposed through model interaction or output." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Confidential data in prompt" ;
    skos:relatedMatch owasp:llm07-system-prompt-leakage .

atlas:evasion-attack a nexus:Risk ;
    nexus:descriptor "traditional risk of AI" ;
    nexus:hasRelatedControl mitctrl:model-safety-engineering,
        mitctrl:red-teaming,
        mitctrl:threat-modelling ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:robustness-model-behavior-manipulation ;
    nexus:riskType "inference" ;
    nexus:tag "evasion-attack" ;
    skos:broadMatch mit:subdomain-2-2,
        mit:subdomain-7-3 ;
    skos:broader atlas:robustness-model-behavior-manipulation ;
    skos:definition "Inputs may be modified to cause a trained model to produce incorrect results." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Evasion attack" ;
    skos:relatedMatch owasp:llm05-improper-output-handling .

atlas:incomplete-advice a nexus:Risk ;
    nexus:descriptor "specific to generative AI" ;
    nexus:hasRelatedControl mitctrl:human-oversight-protocol,
        mitctrl:retrieval-quality-evaluation,
        mitctrl:system-documentation ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:value-alignment ;
    nexus:riskType "output" ;
    nexus:tag "incomplete-advice" ;
    skos:broader atlas:value-alignment ;
    skos:definition "Generated advice or recommendation may omit important context and lead users to act on incomplete information." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Incomplete advice" ;
    skos:relatedMatch mit:subdomain-3-1,
        mit:subdomain-5-1,
        owasp:llm09-misinformation .

atlas:robustness a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Robustness" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

atlas:robustness-prompt-attacks a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:broader atlas:robustness ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Robustness: prompt attacks" .

atlas:value-alignment a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Value alignment" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

mit:domain-2 a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Privacy & Security" ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:domain-5 a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Human-Computer Interaction" ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:domain-7 a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "AI System Safety, Failures, & Limitations" ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:subdomain-5-1 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:human-oversight-protocol,
        mitctrl:risk-disclosure,
        mitctrl:system-documentation ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-5 ;
    skos:broader mit:domain-5 ;
    skos:definition "Users may place inappropriate trust in AI systems or use them unsafely." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Overreliance and unsafe use" .

mitctrl:governance-oversight-controls a nexus:RiskControlGroup ;
    nexus:controlType "governance" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:definition """\r
    Formal organizational structures and policy frameworks that establish human oversight,\r
    accountability, ethical conduct, and risk management throughout AI development and deployment.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Governance & Oversight Controls" ;
    skos:topConceptOf mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy .

mitctrl:transparency-accountability-controls a nexus:RiskControlGroup ;
    nexus:controlType "transparency-accountability" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:definition """\r
    Disclosure practices and verification mechanisms that communicate AI system information,\r
    support external scrutiny, and enable accountability to users, regulators, and the public.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Transparency & Accountability Controls" ;
    skos:topConceptOf mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy .

beamr:Risk a owl:Class ;
    rdfs:label "Risk" ;
    rdfs:subClassOf beamr:RiskConcept,
        <https://w3id.org/airoRisk> .

beamr:RiskConcept a owl:Class ;
    rdfs:label "Risk Concept" ;
    rdfs:subClassOf <https://w3id.org/airoRiskConcept> .

pair:GenerativeModel a pair:PatternRole ;
    pair:subRoleOf pair:Model ;
    skos:prefLabel "Generative Model"@en .

pat:BatchPred_JobNode a pair:PatternNode ;
    rdfs:label "Batch prediction job node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pat:PredictionStepRole .

pat:BatchTrain_PreprocessStepNode a pair:PatternNode ;
    rdfs:label "Batch training preprocessing step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pat:PreprocessingStepRole .

pat:BatchTrain_TrainingStepNode a pair:PatternNode ;
    rdfs:label "Batch training step node"@en ;
    pair:expectedClass beam:Train ;
    pair:expectedRole pat:TrainingStepRole .

pat:Control_OutputValidationAndSanitization a beamr:RiskControl ;
    dct:description "Validate, encode, sanitize, or review model output before it is used by users, tools, or downstream systems."@en ;
    skos:prefLabel "Output validation and sanitization"@en ;
    skos:relatedMatch mitctrl:content-safety-controls,
        mitctrl:input-output-filtering .

pat:Embedding_GenerationStepNode a pair:PatternNode ;
    rdfs:label "Embedding generation step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:EmbeddingStep .

pat:EmbeddingsMotif a pair:GraphMotif ;
    rdfs:label "Embeddings Motif"@en ;
    dct:description "GenAI motif in which source documents or data blocks are chunked and transformed by an embedding model into vectors stored in a vector index."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasInterpretation pat:DataAndModelPoisoningInterpretation,
        pat:VectorAndEmbeddingWeaknessInterpretation ;
    pair:hasPatternEdge pat:Embedding_ChunkingProducesChunkEdge,
        pat:Embedding_ChunkingUsesSourceEdge,
        pat:Embedding_GenerationProducesVectorEdge,
        pat:Embedding_GenerationUsesChunkEdge,
        pat:Embedding_GenerationUsesModelEdge,
        pat:Embedding_VectorIndexUsesVectorEdge ;
    pair:hasPatternNode pat:Embedding_ChunkingStepNode,
        pat:Embedding_DocumentChunkNode,
        pat:Embedding_GenerationStepNode,
        pat:Embedding_ModelNode,
        pat:Embedding_SourceDocumentNode,
        pat:Embedding_VectorIndexNode,
        pat:Embedding_VectorNode ;
    pair:implementedBy pat:Embeddings_MatchingOQP .

pat:FineTune_TrainingStepNode a pair:PatternNode ;
    rdfs:label "Fine tuning training step node"@en ;
    pair:expectedClass beam:Train ;
    pair:expectedRole pat:FineTuningStepRole .

pat:ModelLoad_LoadStepNode a pair:PatternNode ;
    rdfs:label "Model load step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pat:ModelLoadStepRole .

pat:MultiStage_FastPredictionStepNode a pair:PatternNode ;
    rdfs:label "Fast prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pat:FastPredictionStepRole .

pat:MultiStage_SlowPredictionStepNode a pair:PatternNode ;
    rdfs:label "Slow prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pat:SlowPredictionStepRole .

pat:PipeTrain_TrainingJobNode a pair:PatternNode ;
    rdfs:label "Pipeline training job node"@en ;
    pair:expectedClass beam:Train ;
    pair:expectedRole pat:TrainingStepRole .

pat:PredLog_LoggingStepNode a pair:PatternNode ;
    rdfs:label "Prediction logging step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pat:LoggingStepRole .

pat:PredictionRequestRole a pair:PatternRole ;
    skos:prefLabel "Prediction Request"@en .

pat:PrepPred_PredictionStepNode a pair:PatternNode ;
    rdfs:label "Prep-pred prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pat:PredictionStepRole .

pat:PromptInjectionInterpretation a pair:MotifInterpretation ;
    rdfs:label "Prompt injection interpretation"@en ;
    pair:hasInterpretationCondition pat:PromptInjection_UntrustedPromptContextCondition ;
    pair:implementedBy pat:PromptInjectionOQP ;
    pair:interpretedAsMechanism owasp:mechanism-instruction-override ;
    pair:mayIndicateRisk atlas:prompt-injection,
        mit:subdomain-2-2,
        mit:subdomain-4-3,
        owasp:llm01-prompt-injection ;
    pair:suggestedControl pat:Control_Guardrails,
        pat:Control_InputValidationAndPromptIsolation,
        pat:Control_LoggingMonitoringAndEvals,
        mitctrl:input-output-filtering,
        mitctrl:red-teaming,
        mitctrl:retrieval-source-filtering,
        mitctrl:threat-modelling .

pat:QueryRewrite_RewriteStepNode a pair:PatternNode ;
    rdfs:label "Query rewriting step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:QueryReformulationStep .

pat:RAG_GenerationStepNode a pair:PatternNode ;
    rdfs:label "RAG generation step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:GenerationStep .

pat:RAG_QueryEmbeddingStepNode a pair:PatternNode ;
    rdfs:label "RAG query embedding step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:EmbeddingStep .

pat:RAG_RetrievalStepNode a pair:PatternNode ;
    rdfs:label "RAG retrieval step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:RetrievalStep .

pat:Reranker_RerankingStepNode a pair:PatternNode ;
    rdfs:label "Reranking step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:RerankingStep .

pat:SupplyChainCompromiseInterpretation a pair:MotifInterpretation ;
    rdfs:label "Supply chain compromise interpretation"@en ;
    pair:hasInterpretationCondition pat:SupplyChain_ExternalDependencyCondition ;
    pair:implementedBy pat:SupplyChainCompromiseOQP ;
    pair:interpretedAsMechanism owasp:mechanism-supply-chain-compromise ;
    pair:mayIndicateRisk mit:subdomain-2-2,
        mit:subdomain-7-3,
        mit:subdomain-7-4,
        owasp:llm03-supply-chain ;
    pair:suggestedControl pat:Control_LoggingMonitoringAndEvals,
        pat:Control_ModelAndDependencyProvenance,
        mitctrl:data-governance,
        mitctrl:model-infrastructure-security,
        mitctrl:pre-deployment-risk-assessment,
        mitctrl:risk-register,
        mitctrl:system-architecture-documentation,
        mitctrl:threat-modelling .

pat:SyncPred_PredictionStepNode a pair:PatternNode ;
    rdfs:label "Synchronous prediction step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pat:PredictionStepRole .

pat:TrainServe_ReleaseStepNode a pair:PatternNode ;
    rdfs:label "Manual release step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pat:DeploymentStepRole .

pat:TrainToServe_AutoDeploymentNode a pair:PatternNode ;
    rdfs:label "Automatic model deployment step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pat:DeploymentStepRole .

pat:TrainingStepRole a pair:PatternRole ;
    skos:prefLabel "Training Step"@en .

pat:UnboundedConsumptionInterpretation a pair:MotifInterpretation ;
    rdfs:label "Unbounded consumption interpretation"@en ;
    pair:hasInterpretationCondition pat:UnboundedConsumption_UnboundedUseCondition ;
    pair:implementedBy pat:UnboundedConsumptionOQP ;
    pair:interpretedAsMechanism owasp:mechanism-unbounded-resource-consumption ;
    pair:mayIndicateRisk atlas:impact-on-the-environment,
        atlas:redundant-actions-agentic,
        mit:subdomain-2-2,
        mit:subdomain-6-6,
        mit:subdomain-7-3,
        owasp:llm10-unbounded-consumption ;
    pair:suggestedControl pat:Control_LoggingMonitoringAndEvals,
        pat:Control_RateLimitBudgetAndLoopControl,
        mitctrl:access-management,
        mitctrl:incident-response-plan,
        mitctrl:post-deployment-behavior-monitoring,
        mitctrl:prompt-context-limiting .

pat:VectorAndEmbeddingWeaknessInterpretation a pair:MotifInterpretation ;
    rdfs:label "Vector and embedding weakness interpretation"@en ;
    pair:hasInterpretationCondition pat:VectorEmbeddingWeakness_RetrievalCondition ;
    pair:implementedBy pat:VectorAndEmbeddingWeaknessOQP ;
    pair:interpretedAsMechanism owasp:mechanism-vector-embedding-retrieval-weakness ;
    pair:mayIndicateRisk atlas:poor-model-accuracy,
        atlas:prompt-injection,
        mit:subdomain-2-2,
        mit:subdomain-7-3,
        owasp:llm08-vector-and-embedding-weaknesses ;
    pair:suggestedControl pat:Control_GroundingAndVerification,
        pat:Control_RetrievalAccessControl,
        pat:Control_TrustedTrainingAndIndexingData,
        mitctrl:data-governance,
        mitctrl:retrieval-quality-evaluation,
        mitctrl:retrieval-source-filtering,
        mitctrl:threat-modelling .

pat:VectorIR_RetrievalStepNode a pair:PatternNode ;
    rdfs:label "Vector-based retrieval step node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pair:RetrievalStep .

atlas:data-curation a nexus:Risk ;
    nexus:descriptor "traditional risk of AI" ;
    nexus:hasRelatedControl mitctrl:data-curation-process,
        mitctrl:data-governance,
        mitctrl:testing-auditing ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:value-alignment ;
    nexus:riskType "training-data" ;
    nexus:tag "data-curation" ;
    skos:broader atlas:value-alignment ;
    skos:definition "Improper collection, preparation, labeling, or generation of data may degrade model behavior." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Improper data curation" ;
    skos:relatedMatch mit:subdomain-1-3,
        mit:subdomain-7-3,
        owasp:llm04-data-and-model-poisoning .

atlas:hallucination a nexus:Risk ;
    nexus:descriptor "specific to generative AI" ;
    nexus:hasRelatedControl mitctrl:input-output-filtering,
        mitctrl:red-teaming,
        mitctrl:retrieval-quality-evaluation,
        mitctrl:system-architecture-documentation ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:robustness ;
    nexus:riskType "output" ;
    nexus:tag "hallucination" ;
    skos:broadMatch mit:subdomain-3-1,
        owasp:llm09-misinformation ;
    skos:broader atlas:robustness ;
    skos:definition "A model may produce inaccurate, unsupported, or untruthful content that appears plausible." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Hallucination" ;
    skos:relatedMatch mit:subdomain-7-3 .

atlas:redundant-actions-agentic a nexus:Risk ;
    nexus:descriptor "specific to agentic AI" ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:computational-inefficiency ;
    nexus:riskType "agentic" ;
    nexus:tag "redundant-actions-agentic" ;
    skos:broader atlas:computational-inefficiency ;
    skos:definition "Unnecessary or repeated actions may waste computation, increase cost, and reduce system efficiency." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Redundant actions" .

mit:subdomain-1-3 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:data-curation-process,
        mitctrl:data-governance,
        mitctrl:testing-auditing ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-1 ;
    skos:broader mit:domain-1 ;
    skos:definition "AI system performance may differ across demographic or social groups." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Unequal performance across groups" .

owasp:condition-untrusted-input-enters-prompt-context a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm01-prompt-injection ;
    skos:prefLabel "Untrusted input enters prompt context"@en .

owasp:mechanism-instruction-override a pair:RiskMechanism ;
    rdfs:label "Instruction override by untrusted context"@en ;
    dct:description "Untrusted user, retrieved, or tool-supplied content changes model behavior by overriding or conflicting with intended instructions."@en ;
    nexus:mechanismForRisk owasp:llm01-prompt-injection .

owasp:mechanism-vector-embedding-retrieval-weakness a pair:RiskMechanism ;
    rdfs:label "Vector and embedding retrieval weakness"@en ;
    dct:description "Embedding, indexing, chunking, similarity search, source filtering, or ranking causes irrelevant, malicious, stale, or unauthorized context to enter generation."@en ;
    nexus:mechanismForRisk owasp:llm08-vector-and-embedding-weaknesses .

beam: a owl:Ontology ;
    dct:description """  An ontology to describe the core components of AI systems \r
                                                based on an extended/adapted version of boxology: \r
                                                Boxology's Extended Annotation Model (BEAM)"""@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0> ;
    dct:modified "2026-02-05" ;
    dct:title "The BEAM ontology"@en ;
    vann:preferredNamespacePrefix "beam" ;
    vann:preferredNamespaceUri "http://w3id.org/beam/core#" ;
    owl:versionInfo "0.1.0" .

<http://w3id.org/airiskkg/example/verba-goldenverba#ChunkEmbeddings> a beam:Data ;
    rdfs:label "Chunk embeddings"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent> ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#IndexChunksInWeaviate> .

<http://w3id.org/airiskkg/example/verba-goldenverba#EmbedQuestion> a beam:Transform ;
    rdfs:label "Embed chat question"@en ;
    pair:playsRole pair:EmbeddingStep ;
    beam:inform <http://w3id.org/airiskkg/example/verba-goldenverba#RetrieveRelevantChunks> ;
    beam:produce <http://w3id.org/airiskkg/example/verba-goldenverba#EmbeddedQuestion> ;
    beam:use <http://w3id.org/airiskkg/example/verba-goldenverba#ProviderCredentials>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#PublicQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration> .

<http://w3id.org/airiskkg/example/verba-goldenverba#ParsedDocument> a beam:Data ;
    rdfs:label "Parsed document"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedSensitiveKnowledgeBaseContent>,
        pair:UntrustedContent ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkDocument> .

<http://w3id.org/airiskkg/example/verba-goldenverba#UploadedSensitiveKnowledgeBaseContent> a pair:DataCategory ;
    rdfs:label "Uploaded sensitive knowledge base content"@en ;
    pair:subDataCategoryOf <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent>,
        pair:SensitiveInformation .

pair:Information a pair:DataCategory ;
    skos:prefLabel "Information"@en .

pair:RetrievalStep a pair:PatternRole ;
    skos:prefLabel "Retrieval Step"@en .

pat:Control_GroundingAndVerification a beamr:RiskControl ;
    dct:description "Ground generated answers in trusted sources and verify responses against task-specific evidence or evaluation criteria."@en ;
    skos:prefLabel "Grounding and verification"@en ;
    skos:relatedMatch mitctrl:human-oversight-protocol,
        mitctrl:retrieval-quality-evaluation,
        mitctrl:testing-auditing .

pat:Control_RetrievalAccessControl a beamr:RiskControl ;
    dct:description "Constrain retrieval sources, chunks, ranking, and access permissions so only appropriate context can be supplied to the LLM."@en ;
    skos:prefLabel "Retrieval access control"@en ;
    skos:relatedMatch mitctrl:access-management,
        mitctrl:retrieval-quality-evaluation,
        mitctrl:retrieval-source-filtering .

pat:Control_TrustedTrainingAndIndexingData a beamr:RiskControl ;
    dct:description "Validate provenance and integrity of data used for training, fine-tuning, evaluation, embedding, and retrieval indexes."@en ;
    skos:prefLabel "Trusted training and indexing data"@en ;
    skos:relatedMatch mitctrl:data-curation-process,
        mitctrl:data-governance,
        mitctrl:testing-auditing .

pat:Guardrails_GenerationStepNode a pair:PatternNode ;
    rdfs:label "Guarded generation step node"@en ;
    pair:expectedClass beam:Infer ;
    pair:expectedRole pair:GenerationStep .

pat:ModelArtifactRole a pair:PatternRole ;
    pair:subRoleOf pair:Model ;
    skos:prefLabel "Model Artifact"@en .

pat:RAG_PromptConstructionStepNode a pair:PatternNode ;
    rdfs:label "RAG prompt construction step node"@en ;
    pair:expectedClass beam:Transform ;
    pair:expectedRole pair:PromptConstructionStep .

pat:RetrievalAugmentedGenerationMotif a pair:GraphMotif ;
    rdfs:label "Retrieval Augmented Generation (RAG) Motif"@en ;
    dct:description "GenAI motif in which a user query is embedded, used to retrieve relevant context from a vector index, combined with a prompt template, and sent to an LLM to produce an answer."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasInterpretation pat:MisinformationFromWeakGroundingInterpretation,
        pat:PromptInjectionInterpretation,
        pat:SensitiveDataRetrievalExposureInterpretation,
        pat:UnboundedConsumptionInterpretation,
        pat:VectorAndEmbeddingWeaknessInterpretation ;
    pair:hasPatternEdge pat:RAG_GenerationProducesResponseEdge,
        pat:RAG_GenerationUsesLLMEdge,
        pat:RAG_GenerationUsesPromptEdge,
        pat:RAG_PromptConstructionProducesPromptEdge,
        pat:RAG_PromptConstructionUsesContextEdge,
        pat:RAG_PromptConstructionUsesQueryEdge,
        pat:RAG_PromptConstructionUsesTemplateEdge,
        pat:RAG_QueryEmbeddingProducesVectorEdge,
        pat:RAG_QueryEmbeddingUsesModelEdge,
        pat:RAG_QueryEmbeddingUsesQueryEdge,
        pat:RAG_RetrievalProducesContextEdge,
        pat:RAG_RetrievalUsesQueryVectorEdge,
        pat:RAG_RetrievalUsesVectorIndexEdge ;
    pair:hasPatternNode pat:RAG_EmbeddingModelNode,
        pat:RAG_GenerationStepNode,
        pat:RAG_LLMNode,
        pat:RAG_PromptConstructionStepNode,
        pat:RAG_PromptNode,
        pat:RAG_PromptTemplateNode,
        pat:RAG_QueryEmbeddingStepNode,
        pat:RAG_QueryNode,
        pat:RAG_QueryVectorNode,
        pat:RAG_ResponseNode,
        pat:RAG_RetrievalStepNode,
        pat:RAG_RetrievedContextNode,
        pat:RAG_VectorIndexNode ;
    pair:implementedBy pat:RAG_MatchingOQP .

pat:VectorBasedInformationRetrievalMotif a pair:GraphMotif ;
    rdfs:label "Vector-based Information Retrieval Motif"@en ;
    dct:description """
    Architectural motif in which a retrieval process uses a vector store or
    knowledge source and produces a retrieved result or retrieved context.
    """@en ;
    pair:hasInterpretation pat:PromptInjectionInterpretation,
        pat:SensitiveDataRetrievalExposureInterpretation,
        pat:UnboundedConsumptionInterpretation,
        pat:VectorAndEmbeddingWeaknessInterpretation ;
    pair:hasPatternEdge pat:VectorIR_RetrievalProducesResultEdge,
        pat:VectorIR_RetrievalUsesQueryEdge,
        pat:VectorIR_RetrievalUsesVectorStoreEdge ;
    pair:hasPatternNode pat:VectorIR_QueryNode,
        pat:VectorIR_RetrievalStepNode,
        pat:VectorIR_RetrievedResultNode,
        pat:VectorIR_VectorStoreNode ;
    pair:implementedBy pat:VectorIR_MatchingOQP .

pat:VectorEmbeddingWeakness_RetrievalCondition a pair:GraphCondition ;
    rdfs:label "Vector retrieval or embedding index is used for generation context"@en ;
    pair:operationalizesRiskCondition owasp:condition-retrieval-filtering-or-ranking-is-risk-relevant,
        owasp:condition-retrieved-content-enters-generation-context,
        owasp:condition-vector-store-used-for-retrieval .

atlas:poor-model-accuracy a nexus:Risk ;
    nexus:descriptor "traditional risk of AI" ;
    nexus:hasRelatedControl mitctrl:red-teaming,
        mitctrl:retrieval-quality-evaluation,
        mitctrl:testing-auditing ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:accuracy ;
    nexus:riskType "inference" ;
    nexus:tag "poor-model-accuracy" ;
    skos:broadMatch mit:subdomain-7-3 ;
    skos:broader atlas:accuracy ;
    skos:definition "A model may perform insufficiently for the intended task or context." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Poor model accuracy" ;
    skos:relatedMatch owasp:llm09-misinformation .

mit:domain-1 a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Discrimination & Toxicity" ;
    skos:topConceptOf mit:MIT_AI_Risk_Repository_Domain_Taxonomy .

mit:subdomain-3-1 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:human-oversight-protocol,
        mitctrl:input-output-filtering,
        mitctrl:red-teaming,
        mitctrl:retrieval-quality-evaluation ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-3 ;
    skos:broader mit:domain-3 ;
    skos:definition "AI systems may generate or spread incorrect, deceptive, or misleading information." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "False or misleading information" .

mit:subdomain-4-3 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:content-safety-controls,
        mitctrl:incident-response-plan,
        mitctrl:red-teaming,
        mitctrl:threat-modelling ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-4 ;
    skos:broader mit:domain-4 ;
    skos:definition "AI systems may be used to manipulate, deceive, impersonate, or exploit people." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Fraud, scams, and targeted manipulation" .

mitctrl:data-minimization a nexus:RiskControl ;
    nexus:controlType "preventive" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "design-time",
        "development" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:exposing-personal-information,
        atlas:personal-information-in-data,
        mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure ;
    skos:broader mitctrl:access-management,
        mitctrl:data-governance ;
    skos:definition "Limiting collection, storage, retrieval, prompt inclusion, and disclosure of data to what is necessary for the intended use." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Data Minimization" .

mitctrl:redaction a nexus:RiskControl ;
    nexus:controlType "technical" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "design-time",
        "operation" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:confidential-data-in-prompt,
        atlas:exposing-personal-information,
        atlas:personal-information-in-prompt,
        mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure,
        owasp:llm07-system-prompt-leakage ;
    skos:broader mitctrl:data-governance,
        mitctrl:model-safety-engineering ;
    skos:definition "Removing, masking, or transforming sensitive information before it enters model context, generated output, logs, or downstream flows." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Redaction" .

mitctrl:risk-disclosure a nexus:RiskControlGroup ;
    nexus:controlType "transparency-accountability" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment" ;
    skos:broader mitctrl:transparency-accountability-controls ;
    skos:definition """\r
    Reporting and notification practices that communicate risk information, mitigation\r
    plans, safety evaluations, and relevant risk assessment summaries.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Risk Disclosure" .

mitctrl:system-documentation a nexus:RiskControlGroup ;
    nexus:controlType "transparency-accountability" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "design-time",
        "development" ;
    skos:broader mitctrl:transparency-accountability-controls ;
    skos:definition """\r
    Documentation protocols that record technical specifications, intended uses,\r
    limitations, system architecture, model information, and safety evaluation results.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "System Documentation" .

owasp:condition-generated-output-exposed-to-user a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm02-sensitive-information-disclosure,
        owasp:llm07-system-prompt-leakage,
        owasp:llm09-misinformation ;
    skos:prefLabel "Generated output is exposed to a user or downstream system"@en .

owasp:condition-retrieval-filtering-or-ranking-is-risk-relevant a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm08-vector-and-embedding-weaknesses ;
    skos:prefLabel "Retrieval filtering, ranking, chunking, or source selection is risk-relevant"@en .

owasp:condition-vector-store-used-for-retrieval a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm08-vector-and-embedding-weaknesses ;
    skos:prefLabel "Vector store or embedding index is used for retrieval"@en .

beam:System a owl:Class ;
    rdfs:label "System" ;
    rdfs:subClassOf beam:Element .

beam:Train a owl:Class ;
    rdfs:label "Train" ;
    rdfs:subClassOf beam:Generate .

<http://w3id.org/airiskkg/example/verba-goldenverba#BuildRAGPrompt> a beam:Transform ;
    rdfs:label "Build RAG prompt"@en ;
    pair:playsRole pair:PromptConstructionStep ;
    beam:inform <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer> ;
    beam:produce <http://w3id.org/airiskkg/example/verba-goldenverba#RAGPrompt> ;
    beam:use <http://w3id.org/airiskkg/example/verba-goldenverba#PublicQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RetrievedChunks> .

<http://w3id.org/airiskkg/example/verba-goldenverba#ChunkDocument> a beam:Transform ;
    rdfs:label "Chunk document"@en ;
    beam:inform <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedChunks> ;
    beam:produce <http://w3id.org/airiskkg/example/verba-goldenverba#DocumentChunks> ;
    beam:use <http://w3id.org/airiskkg/example/verba-goldenverba#ParsedDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration> .

<http://w3id.org/airiskkg/example/verba-goldenverba#DocumentChunks> a beam:Data ;
    rdfs:label "Document chunks"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedSensitiveKnowledgeBaseContent>,
        pair:UntrustedContent ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#IndexChunksInWeaviate> .

<http://w3id.org/airiskkg/example/verba-goldenverba#PublicQuestion> a beam:Data ;
    rdfs:label "Public chat question"@en ;
    pair:containsDataCategory pair:ExternalUserContent ;
    pair:playsRole pair:PublicUserInput ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#BuildRAGPrompt>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer> .

<http://w3id.org/airiskkg/example/verba-goldenverba#RAGPrompt> a beam:Data ;
    rdfs:label "RAG prompt with retrieved context"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedSensitiveKnowledgeBaseContent>,
        pair:ExternalUserContent,
        pair:PromptInstruction,
        pair:UntrustedContent ;
    pair:playsRole pair:PromptTemplate ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer> .

pair:UntrustedContent a pair:DataCategory ;
    pair:subDataCategoryOf pair:Information ;
    skos:prefLabel "Untrusted Content"@en .

pat:Evals_ScorerNode a pair:PatternNode ;
    rdfs:label "Evaluation scorer node"@en ;
    pair:expectedClass beam:Process ;
    pair:expectedRole pat:ScoringStepRole .

pat:PredictionResultRole a pair:PatternRole ;
    skos:prefLabel "Prediction Result"@en .

atlas:exposing-personal-information a nexus:Risk ;
    nexus:descriptor "amplified by generative AI" ;
    nexus:hasRelatedControl mitctrl:access-management,
        mitctrl:data-governance,
        mitctrl:data-minimization,
        mitctrl:input-output-filtering,
        mitctrl:privacy-control-for-user-data,
        mitctrl:redaction,
        mitctrl:retrieval-source-filtering ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:privacy ;
    nexus:riskType "output" ;
    nexus:tag "exposing-personal-information" ;
    skos:broadMatch mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure ;
    skos:broader atlas:privacy ;
    skos:definition "Personal information used in data, prompts, or generation processes may be revealed in outputs." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Exposing personal information" .

mitctrl:incident-response-plan a nexus:RiskControl ;
    nexus:controlType "corrective" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "post-deployment" ;
    nexus:mitigatesRiskTaxonomyEntry owasp:llm05-improper-output-handling,
        owasp:llm10-unbounded-consumption ;
    skos:broader mitctrl:incident-reporting,
        mitctrl:incident-response-recovery ;
    skos:definition "A plan for responding to AI safety incidents, security failures, misuse, or harmful outputs." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Incident Response Plan" .

mitctrl:operational-process-controls a nexus:RiskControlGroup ;
    nexus:controlType "operational" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:definition """\r
    Processes and management frameworks governing deployment, usage, monitoring,\r
    incident handling, and validation across the AI system lifecycle.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Operational Process Controls" ;
    skos:topConceptOf mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy .

owasp:llm10-unbounded-consumption a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:access-management,
        mitctrl:incident-response-plan,
        mitctrl:post-deployment-behavior-monitoring,
        mitctrl:prompt-context-limiting ;
    nexus:hasRiskCondition owasp:condition-unbounded-prompt-retrieval-tool-or-model-use ;
    nexus:hasRiskMechanism owasp:mechanism-unbounded-resource-consumption ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm10-unbounded-consumption" ;
    skos:definition "LLM applications may allow excessive or uncontrolled inference, causing cost, availability, or abuse risks." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:narrowMatch atlas:redundant-actions-agentic ;
    skos:prefLabel "LLM10:2025 Unbounded Consumption" ;
    skos:relatedMatch atlas:impact-on-the-environment,
        mit:subdomain-2-2,
        mit:subdomain-6-6,
        mit:subdomain-7-3 .

beam:Resource a owl:Class ;
    rdfs:label "Resource" ;
    rdfs:subClassOf beam:Element .

<http://w3id.org/airiskkg/example/verba-goldenverba#EmbedChunks> a beam:Transform ;
    rdfs:label "Embed document chunks"@en ;
    pair:playsRole pair:EmbeddingStep ;
    beam:inform <http://w3id.org/airiskkg/example/verba-goldenverba#IndexChunksInWeaviate> ;
    beam:produce <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkEmbeddings> ;
    beam:use <http://w3id.org/airiskkg/example/verba-goldenverba#DocumentChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ProviderCredentials>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration> .

<http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration> a beam:Data ;
    rdfs:label "RAG configuration"@en ;
    pair:containsDataCategory pair:PromptInstruction ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#BuildRAGPrompt>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ReadDocument>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RetrieveRelevantChunks> .

pair:RetrievedContext a pair:PatternRole ;
    skos:prefLabel "Retrieved Context"@en .

atlas:privacy a nexus:RiskGroup ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Privacy" ;
    skos:topConceptOf atlas:IBM_AI_Risk_Atlas .

mitctrl:content-safety-controls a nexus:RiskControlGroup ;
    nexus:controlType "technical" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "operation" ;
    nexus:mitigatesRiskTaxonomyEntry owasp:llm05-improper-output-handling ;
    skos:broader mitctrl:technical-security-controls ;
    skos:definition """\r
    Technical systems and processes that detect, filter, label, or restrict harmful,\r
    unsafe, or manipulated AI-generated content.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Content Safety Controls" .

mitctrl:data-curation-process a nexus:RiskControl ;
    nexus:controlType "operational" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "development" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:data-curation,
        owasp:llm04-data-and-model-poisoning ;
    skos:broader mitctrl:data-governance ;
    skos:definition "Processes for selecting, cleaning, filtering, documenting, and governing data used by AI systems." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Data Curation Process" .

mitctrl:model-safety-engineering a nexus:RiskControlGroup ;
    nexus:controlType "technical" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "development" ;
    skos:broader mitctrl:technical-security-controls ;
    skos:definition """\r
    Technical methods and safeguards that constrain model behavior and protect against\r
    exploitation, unsafe outputs, or vulnerabilities.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Model Safety Engineering" .

mitctrl:post-deployment-behavior-monitoring a nexus:RiskControl ;
    nexus:controlType "detective" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "post-deployment" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:redundant-actions-agentic,
        owasp:llm06-excessive-agency,
        owasp:llm10-unbounded-consumption ;
    skos:broader mitctrl:post-deployment-monitoring ;
    skos:definition "Ongoing monitoring of AI system behavior, outputs, user interactions, failures, and misuse signals after deployment." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Post-deployment Behavior Monitoring" .

mitctrl:risk-register a nexus:RiskControl ;
    nexus:controlType "governance" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "design-time" ;
    nexus:mitigatesRiskTaxonomyEntry owasp:llm03-supply-chain,
        owasp:llm06-excessive-agency ;
    skos:broader mitctrl:risk-management ;
    skos:definition "A structured repository of risks, their prioritization, owners, and mitigation plans." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Risk Register" .

<http://w3id.org/airiskkg/example/verba-goldenverba#Answer> a beam:Data ;
    rdfs:label "Generated chat answer"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent>,
        pair:GeneratedContent ;
    pair:playsRole pair:PublicUserFacingOutput .

<http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent> a pair:DataCategory ;
    rdfs:label "Uploaded knowledge base content"@en ;
    pair:subDataCategoryOf pair:Information .

pat:Control_Guardrails a beamr:RiskControl ;
    dct:description "Use input and output guardrails to block, route, or sanitize unsafe prompts and generated responses."@en ;
    skos:prefLabel "Input and output guardrails"@en ;
    skos:relatedMatch mitctrl:content-safety-controls,
        mitctrl:input-output-filtering,
        mitctrl:model-safety-engineering .

mitctrl:model-infrastructure-security a nexus:RiskControlGroup ;
    nexus:controlType "technical" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "development",
        "operation" ;
    nexus:mitigatesRiskTaxonomyEntry owasp:llm03-supply-chain,
        owasp:llm04-data-and-model-poisoning ;
    skos:broader mitctrl:technical-security-controls ;
    skos:definition """\r
    Technical and physical safeguards that secure AI models, model weights,\r
    infrastructure, and system access against unauthorized use, theft, or tampering.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Model & Infrastructure Security" .

owasp:llm06-excessive-agency a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:access-management,
        mitctrl:human-oversight-protocol,
        mitctrl:post-deployment-behavior-monitoring,
        mitctrl:prompt-context-limiting,
        mitctrl:risk-register,
        mitctrl:threat-modelling ;
    nexus:hasRiskCondition owasp:condition-llm-can-trigger-tools-or-state-changes ;
    nexus:hasRiskMechanism owasp:mechanism-excessive-agency-action-execution ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm06-excessive-agency" ;
    skos:definition "LLM systems may be granted excessive ability to invoke tools, act, or affect external systems." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM06:2025 Excessive Agency" ;
    skos:relatedMatch atlas:redundant-actions-agentic,
        mit:subdomain-2-2,
        mit:subdomain-5-2,
        mit:subdomain-7-4 .

<http://w3id.org/airiskkg/example/verba-goldenverba#EmbeddedQuestion> a beam:Data ;
    rdfs:label "Embedded chat question"@en ;
    pair:containsDataCategory pair:ExternalUserContent ;
    pair:playsRole pair:PublicUserInput ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#RetrieveRelevantChunks> .

<http://w3id.org/airiskkg/example/verba-goldenverba#GeneratorModel> a beam:StatisticalModel ;
    rdfs:label "Selected generator model"@en ;
    pair:playsRole pair:ExternalModel,
        pair:GenerativeModel,
        pair:PretrainedModel ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer> .

<http://w3id.org/airiskkg/example/verba-goldenverba#RetrieveRelevantChunks> a beam:Infer ;
    rdfs:label "Retrieve relevant chunks from Weaviate"@en ;
    pair:playsRole pair:RetrievalStep ;
    beam:inform <http://w3id.org/airiskkg/example/verba-goldenverba#BuildRAGPrompt> ;
    beam:produce <http://w3id.org/airiskkg/example/verba-goldenverba#RetrievedChunks> ;
    beam:use <http://w3id.org/airiskkg/example/verba-goldenverba#EmbeddedQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#WeaviateVectorStore> .

pair:UserInput a pair:PatternRole ;
    skos:prefLabel "User Input"@en .

mit:subdomain-7-4 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:risk-disclosure,
        mitctrl:system-architecture-documentation,
        mitctrl:system-documentation ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-7 ;
    skos:broader mit:domain-7 ;
    skos:definition "AI systems may be difficult to understand, explain, audit, or correct." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Lack of transparency or interpretability" .

owasp:llm03-supply-chain a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:data-governance,
        mitctrl:model-infrastructure-security,
        mitctrl:pre-deployment-risk-assessment,
        mitctrl:risk-register,
        mitctrl:system-architecture-documentation,
        mitctrl:threat-modelling ;
    nexus:hasRiskCondition owasp:condition-externally-sourced-model-data-or-dependency ;
    nexus:hasRiskMechanism owasp:mechanism-supply-chain-compromise ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm03-supply-chain" ;
    skos:broadMatch mit:subdomain-2-2 ;
    skos:definition "LLM supply chains may be vulnerable through models, data, dependencies, or deployment platforms." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM03:2025 Supply Chain" ;
    skos:relatedMatch mit:subdomain-7-3,
        mit:subdomain-7-4 .

owasp:llm04-data-and-model-poisoning a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:data-curation-process,
        mitctrl:data-governance,
        mitctrl:model-infrastructure-security,
        mitctrl:testing-auditing,
        mitctrl:threat-modelling ;
    nexus:hasRiskCondition owasp:condition-untrusted-data-enters-training-finetuning-or-indexing ;
    nexus:hasRiskMechanism owasp:mechanism-data-or-model-poisoning ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm04-data-and-model-poisoning" ;
    skos:broadMatch mit:subdomain-2-2 ;
    skos:definition "Training, fine-tuning, or embedding data may be manipulated to compromise model behavior." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM04:2025 Data and Model Poisoning" ;
    skos:relatedMatch mit:subdomain-1-3,
        mit:subdomain-7-3 .

owasp:llm05-improper-output-handling a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:content-safety-controls,
        mitctrl:human-oversight-protocol,
        mitctrl:incident-response-plan,
        mitctrl:input-output-filtering,
        mitctrl:testing-auditing ;
    nexus:hasRiskCondition owasp:condition-llm-output-used-without-validation ;
    nexus:hasRiskMechanism owasp:mechanism-unsafe-output-propagation ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm05-improper-output-handling" ;
    skos:definition "Generated outputs may be insufficiently validated, sanitized, or constrained before downstream use." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM05:2025 Improper Output Handling" ;
    skos:relatedMatch atlas:evasion-attack,
        mit:subdomain-1-2,
        mit:subdomain-2-2,
        mit:subdomain-7-3 .

<http://w3id.org/airiskkg/example/verba-goldenverba#RetrievedChunks> a beam:Data ;
    rdfs:label "Retrieved context chunks"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedSensitiveKnowledgeBaseContent>,
        pair:UntrustedContent ;
    pair:playsRole pair:RetrievedContext ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#BuildRAGPrompt>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer> .

pat:PredictionStepRole a pair:PatternRole ;
    skos:prefLabel "Prediction Step"@en .

mitctrl:privacy-control-for-user-data a nexus:RiskControl ;
    nexus:controlType "preventive" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "design-time" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:exposing-personal-information,
        atlas:personal-information-in-data,
        atlas:personal-information-in-prompt,
        mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure,
        owasp:llm07-system-prompt-leakage ;
    skos:broader mitctrl:access-management,
        mitctrl:data-governance ;
    skos:definition "Controls that reduce unauthorized access, use, retrieval, or disclosure of user or personal data." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Privacy Control for User Data" .

mitctrl:system-architecture-documentation a nexus:RiskControl ;
    nexus:controlType "transparency-accountability" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "design-time" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:legal-accountability,
        mit:subdomain-7-4,
        owasp:llm03-supply-chain,
        owasp:llm07-system-prompt-leakage ;
    skos:broader mitctrl:system-documentation ;
    skos:definition "Documentation of the system architecture, components, data flows, model use, limitations, and intended use." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "System Architecture Documentation" .

owasp:condition-retrieved-content-enters-generation-context a nexus:RiskCondition ;
    nexus:conditionForRisk owasp:llm01-prompt-injection,
        owasp:llm08-vector-and-embedding-weaknesses ;
    skos:prefLabel "Retrieved content enters generation context"@en .

pair:Model a pair:PatternRole ;
    skos:prefLabel "Model"@en .

pair:MotifMatch a owl:Class ;
    rdfs:label "Motif Match"@en .

pair:RiskMechanism a owl:Class ;
    rdfs:label "Risk Mechanism"@en .

pat:Control_LoggingMonitoringAndEvals a beamr:RiskControl ;
    dct:description "Log relevant interactions, monitor abnormal behavior, and run evaluations for model and system behavior over time."@en ;
    skos:prefLabel "Logging, monitoring, and evals"@en ;
    skos:relatedMatch mitctrl:post-deployment-behavior-monitoring,
        mitctrl:red-teaming,
        mitctrl:testing-auditing .

mitctrl:prompt-context-limiting a nexus:RiskControl ;
    nexus:controlType "technical" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "design-time" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:confidential-data-in-prompt,
        atlas:personal-information-in-prompt,
        owasp:llm06-excessive-agency,
        owasp:llm07-system-prompt-leakage,
        owasp:llm10-unbounded-consumption ;
    skos:broader mitctrl:model-safety-engineering,
        mitctrl:operational-process-controls ;
    skos:definition "Limiting prompt size, retrieved context size, query budget, or model invocation budget to reduce cost, latency, and unbounded consumption risks." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Prompt Context Limiting" .

nexus:RiskTaxonomyEntry a owl:Class ;
    rdfs:label "Risk Taxonomy Entry" ;
    rdfs:comment """\r
    A risk concept defined by an external taxonomy. This is not a concrete\r
    system-specific risk finding. Concrete findings should be represented as\r
    beamr:Risk or pair:RiskFinding.\r
    """ ;
    rdfs:subClassOf skos:Concept .

owasp:llm01-prompt-injection a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:input-output-filtering,
        mitctrl:red-teaming,
        mitctrl:retrieval-source-filtering,
        mitctrl:threat-modelling ;
    nexus:hasRiskCondition owasp:condition-retrieved-content-enters-generation-context,
        owasp:condition-untrusted-input-enters-prompt-context ;
    nexus:hasRiskMechanism owasp:mechanism-instruction-override ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm01-prompt-injection" ;
    skos:broadMatch mit:subdomain-2-2 ;
    skos:definition "User or external inputs may alter LLM behavior or output in unintended ways." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM01:2025 Prompt Injection" ;
    skos:relatedMatch mit:subdomain-4-3 .

owasp:llm07-system-prompt-leakage a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:input-output-filtering,
        mitctrl:privacy-control-for-user-data,
        mitctrl:prompt-context-limiting,
        mitctrl:red-teaming,
        mitctrl:system-architecture-documentation ;
    nexus:hasRiskCondition owasp:condition-generated-output-exposed-to-user,
        owasp:condition-hidden-instructions-in-prompt-context ;
    nexus:hasRiskMechanism owasp:mechanism-system-prompt-exposure ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm07-system-prompt-leakage" ;
    skos:broadMatch mit:subdomain-2-1,
        mit:subdomain-2-2 ;
    skos:closeMatch atlas:prompt-leaking ;
    skos:definition "System prompts or hidden instructions may be exposed to users or attackers." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM07:2025 System Prompt Leakage" ;
    skos:relatedMatch atlas:confidential-data-in-prompt,
        mit:subdomain-7-4 .

owasp:llm09-misinformation a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:human-oversight-protocol,
        mitctrl:input-output-filtering,
        mitctrl:red-teaming,
        mitctrl:retrieval-quality-evaluation ;
    nexus:hasRiskCondition owasp:condition-generated-output-exposed-to-user,
        owasp:condition-generation-without-grounding-or-verification ;
    nexus:hasRiskMechanism owasp:mechanism-unsupported-generation ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm09-misinformation" ;
    skos:closeMatch mit:subdomain-3-1 ;
    skos:definition "LLMs may produce false or misleading information that appears credible." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM09:2025 Misinformation" ;
    skos:relatedMatch mit:subdomain-5-1,
        mit:subdomain-7-3 .

beam:Element a owl:Class ;
    rdfs:label "Element" .

pair:GraphCondition a owl:Class ;
    rdfs:label "Graph Condition"@en .

atlas:prompt-injection a nexus:Risk ;
    nexus:descriptor "specific to generative AI" ;
    nexus:hasRelatedControl mitctrl:input-output-filtering,
        mitctrl:model-safety-engineering,
        mitctrl:red-teaming,
        mitctrl:retrieval-source-filtering,
        mitctrl:threat-modelling ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:robustness-prompt-attacks ;
    nexus:riskType "inference" ;
    nexus:tag "prompt-injection" ;
    skos:broadMatch mit:subdomain-2-2 ;
    skos:broader atlas:robustness-prompt-attacks ;
    skos:closeMatch owasp:llm01-prompt-injection ;
    skos:definition "Manipulated instructions or content in prompts may force a generative model to produce unintended outputs." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Prompt injection attack" ;
    skos:relatedMatch mit:subdomain-4-3,
        owasp:llm08-vector-and-embedding-weaknesses .

owasp:llm08-vector-and-embedding-weaknesses a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:data-governance,
        mitctrl:retrieval-quality-evaluation,
        mitctrl:retrieval-source-filtering,
        mitctrl:threat-modelling ;
    nexus:hasRiskCondition owasp:condition-retrieval-filtering-or-ranking-is-risk-relevant,
        owasp:condition-retrieved-content-enters-generation-context,
        owasp:condition-vector-store-used-for-retrieval ;
    nexus:hasRiskMechanism owasp:mechanism-vector-embedding-retrieval-weakness ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm08-vector-and-embedding-weaknesses" ;
    skos:broadMatch mit:subdomain-2-2,
        mit:subdomain-7-3 ;
    skos:definition "Weaknesses in vector generation, storage, or retrieval may affect RAG systems and downstream outputs." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM08:2025 Vector and Embedding Weaknesses" ;
    skos:relatedMatch atlas:poor-model-accuracy,
        atlas:prompt-injection .

<http://w3id.org/airiskkg/example/verba-goldenverba#WeaviateVectorStore> a beam:Data ;
    rdfs:label "Weaviate document and chunk vector store"@en ;
    pair:containsDataCategory <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedKnowledgeBaseContent>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#UploadedSensitiveKnowledgeBaseContent>,
        pair:UntrustedContent ;
    pair:playsRole pair:VectorStore ;
    beam:usedBy <http://w3id.org/airiskkg/example/verba-goldenverba#RetrieveRelevantChunks> .

pair:DataCategory a owl:Class ;
    rdfs:label "Data Category"@en ;
    rdfs:subClassOf skos:Concept .

mitctrl:human-oversight-protocol a nexus:RiskControl ;
    nexus:controlType "governance" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "operation" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:incomplete-advice,
        owasp:llm05-improper-output-handling,
        owasp:llm06-excessive-agency,
        owasp:llm09-misinformation ;
    skos:broader mitctrl:governance-oversight-controls,
        mitctrl:user-rights-recourse ;
    skos:definition "Defined procedures for human oversight, review, intervention, and accountability in AI system operation." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Human Oversight Protocol" .

beam:Infer a owl:Class ;
    rdfs:label "Infer" ;
    rdfs:subClassOf beam:Process .

mitctrl:retrieval-quality-evaluation a nexus:RiskControl ;
    nexus:controlType "detective" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "development" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:hallucination,
        atlas:incomplete-advice,
        mit:subdomain-3-1,
        mit:subdomain-7-3,
        owasp:llm08-vector-and-embedding-weaknesses,
        owasp:llm09-misinformation ;
    skos:broader mitctrl:data-governance,
        mitctrl:testing-auditing ;
    skos:definition "Evaluation of retrieval relevance, completeness, source quality, and grounding quality in retrieval-augmented systems." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Retrieval Quality Evaluation" .

nexus:RiskCondition a owl:Class ;
    rdfs:label "Risk Condition" ;
    rdfs:comment """\r
    A condition under which a risk taxonomy entry may become relevant. This is\r
    used for source-taxonomy knowledge bases such as OWASP LLM, where a risk\r
    category is grounded by mechanisms and observable or queryable conditions.\r
    """ ;
    rdfs:subClassOf skos:Concept .

beam:Transform a owl:Class ;
    rdfs:label "Transform" ;
    rdfs:subClassOf beam:Process .

<http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer> a beam:Transform ;
    rdfs:label "Generate grounded answer"@en ;
    pair:playsRole pair:GenerationStep ;
    beam:produce <http://w3id.org/airiskkg/example/verba-goldenverba#Answer> ;
    beam:use <http://w3id.org/airiskkg/example/verba-goldenverba#GeneratorModel>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#ProviderCredentials>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#PublicQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGConfiguration>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RAGPrompt>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RetrievedChunks> .

mit:subdomain-2-1 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:access-management,
        mitctrl:data-governance,
        mitctrl:data-minimization,
        mitctrl:input-output-filtering,
        mitctrl:privacy-control-for-user-data,
        mitctrl:redaction,
        mitctrl:retrieval-source-filtering ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-2 ;
    skos:broader mit:domain-2 ;
    skos:definition "AI systems may leak, infer, or expose sensitive information about individuals or organizations." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Compromise of privacy by obtaining, leaking or inferring sensitive information" .

mitctrl:access-management a nexus:RiskControlGroup ;
    nexus:controlType "preventive" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "operation" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:exposing-personal-information,
        mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure,
        owasp:llm06-excessive-agency,
        owasp:llm10-unbounded-consumption ;
    skos:broader mitctrl:operational-process-controls ;
    skos:definition """\r
    Policies and verification systems that govern who can use AI systems,\r
    under which purposes, and with which restrictions.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Access Management" .

nexus:RiskControl a owl:Class ;
    rdfs:label "Risk Control" ;
    rdfs:comment """\r
    A taxonomy-level control or mitigation entry. This may be linked to concrete\r
    BEAM risk controls or used as a possible/required control for a graph risk pattern.\r
    """ ;
    rdfs:subClassOf beamr:RiskControl,
        skos:Concept .

owasp:llm02-sensitive-information-disclosure a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:access-management,
        mitctrl:data-governance,
        mitctrl:data-minimization,
        mitctrl:input-output-filtering,
        mitctrl:privacy-control-for-user-data,
        mitctrl:redaction,
        mitctrl:retrieval-source-filtering ;
    nexus:hasRiskCondition owasp:condition-generated-output-exposed-to-user,
        owasp:condition-sensitive-data-in-context ;
    nexus:hasRiskMechanism owasp:mechanism-sensitive-data-propagation ;
    nexus:isDefinedByTaxonomy owasp:OWASP_LLM_Top_10_2025 ;
    nexus:tag "llm02-sensitive-information-disclosure" ;
    skos:closeMatch mit:subdomain-2-1 ;
    skos:definition "Sensitive information may be exposed through the LLM or its surrounding application context." ;
    skos:inScheme owasp:OWASP_LLM_Top_10_2025 ;
    skos:prefLabel "LLM02:2025 Sensitive Information Disclosure" .

mitctrl:retrieval-source-filtering a nexus:RiskControl ;
    nexus:controlType "technical" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "design-time" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:exposing-personal-information,
        atlas:prompt-injection,
        owasp:llm01-prompt-injection,
        owasp:llm02-sensitive-information-disclosure,
        owasp:llm08-vector-and-embedding-weaknesses ;
    skos:broader mitctrl:data-governance,
        mitctrl:model-safety-engineering ;
    skos:definition "Filtering or restricting which knowledge sources, documents, or records can be retrieved and injected into model context." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Retrieval Source Filtering" .

mitctrl:testing-auditing a nexus:RiskControlGroup ;
    nexus:controlType "detective" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "development" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:data-curation,
        atlas:poor-model-accuracy,
        owasp:llm04-data-and-model-poisoning,
        owasp:llm05-improper-output-handling ;
    skos:broader mitctrl:operational-process-controls ;
    skos:definition """\r
    Internal and external evaluations that assess AI systems, infrastructure, and\r
    compliance processes. Examples include red teaming, penetration testing, third-party\r
    audits, dangerous capability evaluations, and bug bounty programs.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Testing & Auditing" .

pair:MotifInterpretation a owl:Class ;
    rdfs:label "Motif Interpretation"@en ;
    rdfs:subClassOf pair:AIRiskPattern .

nexus:RiskGroup a owl:Class ;
    rdfs:label "Risk Group" ;
    rdfs:comment "A grouping concept within a risk taxonomy, such as Privacy, Fairness, Robustness, or Misinformation." ;
    rdfs:subClassOf skos:Concept .

nexus:RiskControlGroup a owl:Class ;
    rdfs:label "Risk Control Group" ;
    rdfs:comment """\r
    A grouping concept within a risk control taxonomy, such as Data Governance,\r
    Model Safety Engineering, Testing & Auditing, or Human Oversight.\r
    """ ;
    rdfs:subClassOf beamr:RiskControl,
        skos:Concept .

owasp:OWASP_LLM_Top_10_2025 a nexus:RiskTaxonomy,
        skos:ConceptScheme ;
    dct:description "A taxonomy of critical security vulnerabilities and risks in LLM applications." ;
    owl:versionInfo "2.0" ;
    skos:prefLabel "OWASP Top 10 for Large Language Model Applications" .

pair:PatternImplementation a owl:Class ;
    rdfs:label "Pattern Implementation"@en .

mitctrl:red-teaming a nexus:RiskControl ;
    nexus:controlType "detective" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "development" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:hallucination,
        atlas:prompt-injection,
        owasp:llm01-prompt-injection,
        owasp:llm07-system-prompt-leakage,
        owasp:llm09-misinformation ;
    skos:broader mitctrl:model-safety-engineering,
        mitctrl:testing-auditing ;
    skos:definition "Adversarial testing to identify unsafe behavior, vulnerabilities, or misuse pathways." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Red Teaming" .

mitctrl:threat-modelling a nexus:RiskControl ;
    nexus:controlType "detective" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "design-time" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:evasion-attack,
        atlas:prompt-injection,
        owasp:llm01-prompt-injection,
        owasp:llm03-supply-chain,
        owasp:llm04-data-and-model-poisoning,
        owasp:llm06-excessive-agency,
        owasp:llm08-vector-and-embedding-weaknesses ;
    skos:broader mitctrl:model-infrastructure-security,
        mitctrl:testing-auditing ;
    skos:definition "A process to identify threats, vulnerabilities, and possible attack paths affecting a system." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Threat Modelling" .

beamr:RiskControl a owl:Class ;
    rdfs:label "Risk Control" ;
    rdfs:subClassOf <https://w3id.org/airoRiskControl> .

beam:inform a owl:TransitiveProperty ;
    rdfs:label "inform" ;
    rdfs:domain beam:Process ;
    rdfs:range beam:Process .

mit:subdomain-7-3 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:data-governance,
        mitctrl:red-teaming,
        mitctrl:retrieval-quality-evaluation,
        mitctrl:testing-auditing ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-7 ;
    skos:broader mit:domain-7 ;
    skos:definition "AI systems may fail to perform reliably or effectively under varying conditions." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "Lack of capability or robustness" .

pair:NodeBinding a owl:Class ;
    rdfs:label "Node Binding"@en .

beam:StatisticalModel a owl:Class ;
    rdfs:label "Statistical Model" ;
    rdfs:subClassOf beam:Model .

pair:RiskFinding a owl:Class ;
    rdfs:label "Risk Finding"@en ;
    rdfs:subClassOf beamr:Risk .

mit:subdomain-2-2 a nexus:Risk ;
    nexus:hasRelatedControl mitctrl:access-management,
        mitctrl:incident-response-plan,
        mitctrl:input-output-filtering,
        mitctrl:model-infrastructure-security,
        mitctrl:red-teaming,
        mitctrl:threat-modelling ;
    nexus:isDefinedByTaxonomy mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    nexus:isPartOf mit:domain-2 ;
    skos:broader mit:domain-2 ;
    skos:definition "AI systems may contain vulnerabilities that enable unauthorized access, manipulation, or unsafe behavior." ;
    skos:inScheme mit:MIT_AI_Risk_Repository_Domain_Taxonomy ;
    skos:prefLabel "AI system security vulnerabilities and attacks" .

mitctrl:input-output-filtering a nexus:RiskControl ;
    nexus:controlType "technical" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment",
        "operation" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:hallucination,
        atlas:prompt-injection,
        owasp:llm01-prompt-injection,
        owasp:llm02-sensitive-information-disclosure,
        owasp:llm05-improper-output-handling,
        owasp:llm07-system-prompt-leakage,
        owasp:llm09-misinformation ;
    skos:broader mitctrl:content-safety-controls,
        mitctrl:model-safety-engineering ;
    skos:definition "Filtering or constraining inputs and outputs to reduce unsafe, sensitive, harmful, or policy-violating content." ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Input/Output Filtering" .

mitctrl:data-governance a nexus:RiskControlGroup ;
    nexus:controlType "operational" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "design-time",
        "development" ;
    nexus:mitigatesRiskTaxonomyEntry atlas:data-curation,
        atlas:data-usage-restrictions,
        atlas:personal-information-in-data,
        mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure,
        owasp:llm03-supply-chain,
        owasp:llm04-data-and-model-poisoning,
        owasp:llm08-vector-and-embedding-weaknesses ;
    skos:broader mitctrl:operational-process-controls ;
    skos:definition """\r
    Policies and procedures that govern responsible data acquisition, curation, usage,\r
    privacy, quality, and compliance.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Data Governance" .

pair:GraphMotif a owl:Class ;
    rdfs:label "Graph Motif"@en .

beam:Process a owl:Class ;
    rdfs:label "Process" ;
    rdfs:subClassOf beam:Element,
        <https://kastle-lab.org/easy-ai2/Process> .

nexus:Risk a owl:Class ;
    rdfs:label "Risk" ;
    rdfs:comment "A taxonomy-level AI risk entry adapted from AI Atlas Nexus." ;
    rdfs:subClassOf nexus:RiskTaxonomyEntry .

beam:produce a owl:ObjectProperty ;
    rdfs:label "produce" ;
    rdfs:domain beam:Process ;
    rdfs:range beam:Resource .

mit:MIT_AI_Risk_Repository_Domain_Taxonomy a nexus:RiskTaxonomy,
        skos:ConceptScheme ;
    dct:description "A domain taxonomy of AI risks organized into high-level AI risk domains and subdomains." ;
    skos:prefLabel "MIT AI Risk Repository: Domain Taxonomy of AI Risks" .

atlas:IBM_AI_Risk_Atlas a nexus:RiskTaxonomy,
        skos:ConceptScheme ;
    dct:description "A taxonomy of risks associated with AI systems, including traditional AI, generative AI, synthetic data, and agentic AI risks." ;
    skos:prefLabel "IBM AI Risk Atlas" .

beam:use a owl:ObjectProperty ;
    rdfs:label "use" ;
    rdfs:domain beam:Process ;
    rdfs:range beam:Resource ;
    owl:inverseOf beam:usedBy .

mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy a nexus:RiskControlTaxonomy,
        skos:ConceptScheme ;
    dct:description """\r
    A taxonomy of AI risk mitigations organized into governance and oversight controls,\r
    technical and security controls, operational process controls, and transparency\r
    and accountability controls.\r
    """ ;
    owl:versionInfo "1" ;
    skos:prefLabel "MIT Draft AI Risk Mitigation Taxonomy" .

beam:Data a owl:Class ;
    rdfs:label "Data" ;
    rdfs:subClassOf beam:Instance .

pair:PatternRole a owl:Class ;
    rdfs:label "Pattern Role"@en ;
    rdfs:subClassOf skos:Concept .

pair:PatternEdge a owl:Class ;
    rdfs:label "Pattern Edge"@en .

pair:PatternNode a owl:Class ;
    rdfs:label "Pattern Node"@en .

