        <http://w3id.org/airiskkg/example/verba-goldenverba#RetrievedChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#WeaviateVectorStore> ;
    pair:hasInterpretedMechanism owasp:mechanism-instruction-override ;
    pair:hasSatisfiedCondition pat:PromptInjection_UntrustedPromptContextCondition,
        owasp:condition-retrieved-content-enters-generation-context,
        owasp:condition-untrusted-input-enters-prompt-context ;
    pair:hasSuggestedControl pat:Control_Guardrails,
        pat:Control_InputValidationAndPromptIsolation,
        pat:Control_LoggingMonitoringAndEvals,
        mitctrl:input-output-filtering,
        mitctrl:red-teaming,
        mitctrl:retrieval-source-filtering,
        mitctrl:threat-modelling .

<http://w3id.org/airiskkg/generated/risk-finding/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fgenerated%2Fmotif-match%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523RetrieveRelevantChunks%2Fvector-ir%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523EmbeddedQuestion%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523RetrievedChunks/sensitive-data-retrieval-exposure> a pair:RiskFinding ;
    rdfs:label "Candidate sensitive data retrieval exposure"@en ;
    dct:description "Sensitive retrieved context reaches an LLM generation step and user-facing output without a represented disclosure control."@en ;
    pair:findingStatus "candidate" ;
    pair:generatedByMotif pat:VectorBasedInformationRetrievalMotif ;
    pair:generatedFromMatch <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrieveRelevantChunks/vector-ir/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbeddedQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrievedChunks> ;
    pair:hasCandidateRiskTaxonomyEntry atlas:exposing-personal-information,
        mit:subdomain-2-1,
        owasp:llm02-sensitive-information-disclosure ;
    pair:hasEvidenceElement <http://w3id.org/airiskkg/example/verba-goldenverba#Answer>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#EmbeddedQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#GeneratorModel>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RetrieveRelevantChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RetrievedChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#WeaviateVectorStore> ;
    pair:hasInterpretedMechanism owasp:mechanism-sensitive-data-propagation ;
    pair:hasSatisfiedCondition pat:SensitiveInfo_OutputExposureCondition,
        pat:SensitiveInfo_SensitiveContextCondition,
        pat:VectorEmbeddingWeakness_RetrievalCondition,
        owasp:condition-generated-output-exposed-to-user,
        owasp:condition-retrieval-filtering-or-ranking-is-risk-relevant,
        owasp:condition-retrieved-content-enters-generation-context,
        owasp:condition-sensitive-data-in-context,
        owasp:condition-vector-store-used-for-retrieval ;
    pair:hasSuggestedControl pat:Control_DataMinimizationAndRedaction,
        pat:Control_Guardrails,
        pat:Control_OutputValidationAndSanitization,
        pat:Control_RetrievalAccessControl,
        mitctrl:access-management,
        mitctrl:data-governance,
        mitctrl:data-minimization,
        mitctrl:input-output-filtering,
        mitctrl:privacy-control-for-user-data,
        mitctrl:redaction,
        mitctrl:retrieval-source-filtering .

<http://w3id.org/airiskkg/generated/risk-finding/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fgenerated%2Fmotif-match%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523RetrieveRelevantChunks%2Fvector-ir%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523EmbeddedQuestion%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Fverba-goldenverba%2523RetrievedChunks/vector-embedding-weakness> a pair:RiskFinding ;
    rdfs:label "Candidate vector and embedding weakness"@en ;
    dct:description "A vector retrieval or embedding path is present and should be checked for retrieval filtering, ranking, provenance, and evaluation controls."@en ;
    pair:findingStatus "candidate" ;
    pair:generatedByMotif pat:VectorBasedInformationRetrievalMotif ;
    pair:generatedFromMatch <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrieveRelevantChunks/vector-ir/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbeddedQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23RetrievedChunks> ;
    pair:hasCandidateRiskTaxonomyEntry atlas:poor-model-accuracy,
        atlas:prompt-injection,
        mit:subdomain-2-2,
        mit:subdomain-7-3,
        owasp:llm08-vector-and-embedding-weaknesses ;
    pair:hasEvidenceElement <http://w3id.org/airiskkg/example/verba-goldenverba#EmbeddedQuestion>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RetrieveRelevantChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#RetrievedChunks>,
        <http://w3id.org/airiskkg/example/verba-goldenverba#WeaviateVectorStore> ;
    pair:hasInterpretedMechanism owasp:mechanism-vector-embedding-retrieval-weakness ;
    pair:hasSatisfiedCondition pat:VectorEmbeddingWeakness_RetrievalCondition,
        owasp:condition-retrieval-filtering-or-ranking-is-risk-relevant,
        owasp:condition-retrieved-content-enters-generation-context,
        owasp:condition-vector-store-used-for-retrieval ;
    pair:hasSuggestedControl pat:Control_GroundingAndVerification,
        pat:Control_RetrievalAccessControl,
        pat:Control_TrustedTrainingAndIndexingData,
        mitctrl:data-governance,
        mitctrl:retrieval-quality-evaluation,
        mitctrl:retrieval-source-filtering,
        mitctrl:threat-modelling .

<http://w3id.org/airiskkg/imports> a owl:Ontology ;
    rdfs:label "AI Risk KG Ontology Imports" ;
    dct:description """
    Aggregator ontology for loading the BEAM core ontology, BEAM risk extension,
    and the PAIR-AI pattern module ontology together.
    """ ;
    dct:title "AI Risk KG Ontology Imports" ;
    owl:imports pair:,
        beam:,
        beamr: .

pair:OutputValidationStep a pair:PatternRole ;
    pair:subRoleOf pair:ValidationStep ;
    skos:prefLabel "Output Validation Step"@en .

pair:ProductInformation a pair:DataCategory ;
    pair:subDataCategoryOf pair:Information ;
    skos:prefLabel "Product Information"@en .

pair:RateLimitControlStep a pair:PatternRole ;
    skos:prefLabel "Rate Limit Control Step"@en .

pair:RetrievedResult a pair:PatternRole ;
    pair:subRoleOf pair:RetrievedContext ;
    skos:prefLabel "Retrieved Result"@en .

pair:StateChangingStep a pair:PatternRole ;
    skos:prefLabel "State-changing Step"@en .

pair:SystemPrompt a pair:PatternRole ;
    pair:subRoleOf pair:PromptTemplate ;
    skos:prefLabel "System Prompt"@en .

pair:ThirdPartyPackage a pair:PatternRole ;
    pair:subRoleOf pair:ExternalDependency ;
    skos:prefLabel "Third-party Package"@en .

pair:Tool a pair:PatternRole ;
    skos:prefLabel "Tool"@en .

pair:ToolInvocationStep a pair:PatternRole ;
    skos:prefLabel "Tool Invocation Step"@en .

pair:bindsPatternNode a owl:ObjectProperty ;
    rdfs:label "binds pattern node"@en ;
    rdfs:domain pair:NodeBinding ;
    rdfs:range pair:PatternNode .

pair:containsDataCategory a owl:ObjectProperty ;
    rdfs:label "contains data category"@en ;
    rdfs:domain beam:Data ;
    rdfs:range pair:DataCategory .

pair:expectedClass a owl:ObjectProperty ;
    rdfs:label "expected class"@en ;
    rdfs:domain pair:PatternNode ;
    rdfs:range rdfs:Class .

pair:expectedRole a owl:ObjectProperty ;
    rdfs:label "expected role"@en ;
    rdfs:domain pair:PatternNode ;
    rdfs:range pair:PatternRole .

pair:findingStatus a owl:DatatypeProperty ;
    rdfs:label "finding status"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range xsd:string .

pair:generatedByMotif a owl:ObjectProperty ;
    rdfs:label "generated by motif"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range pair:GraphMotif .

pair:generatedFromMatch a owl:ObjectProperty ;
    rdfs:label "generated from match"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range pair:MotifMatch .

pair:hasCandidateRiskTaxonomyEntry a owl:ObjectProperty ;
    rdfs:label "has candidate risk taxonomy entry"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range skos:Concept .

pair:hasEvidenceElement a owl:ObjectProperty ;
    rdfs:label "has evidence element"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range rdfs:Resource .

pair:hasInterpretation a owl:ObjectProperty ;
    rdfs:label "has interpretation"@en ;
    rdfs:domain pair:GraphMotif ;
    rdfs:range pair:MotifInterpretation .

pair:hasInterpretationCondition a owl:ObjectProperty ;
    rdfs:label "has interpretation condition"@en ;
    rdfs:domain pair:MotifInterpretation ;
    rdfs:range pair:GraphCondition .

pair:hasInterpretedMechanism a owl:ObjectProperty ;
    rdfs:label "has interpreted mechanism"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range pair:RiskMechanism .

pair:hasNodeBinding a owl:ObjectProperty ;
    rdfs:label "has node binding"@en ;
    rdfs:domain pair:MotifMatch ;
    rdfs:range pair:NodeBinding .

pair:hasPatternEdge a owl:ObjectProperty ;
    rdfs:label "has pattern edge"@en ;
    rdfs:domain pair:GraphMotif ;
    rdfs:range pair:PatternEdge .

pair:hasPatternNode a owl:ObjectProperty ;
    rdfs:label "has pattern node"@en ;
    rdfs:domain pair:GraphMotif ;
    rdfs:range pair:PatternNode .

pair:hasSatisfiedCondition a owl:ObjectProperty ;
    rdfs:label "has satisfied condition"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range rdfs:Resource .

pair:hasSuggestedControl a owl:ObjectProperty ;
    rdfs:label "has suggested control"@en ;
    rdfs:domain pair:RiskFinding ;
    rdfs:range beamr:RiskControl .

pair:implementationPath a owl:DatatypeProperty ;
    rdfs:label "implementation path"@en ;
    rdfs:domain pair:PatternImplementation ;
    rdfs:range xsd:string .

pair:implementedBy a owl:ObjectProperty ;
    rdfs:label "implemented by"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( pair:GraphMotif pair:MotifInterpretation ) ] ;
    rdfs:range pair:PatternImplementation .

pair:implementsInterpretation a owl:ObjectProperty ;
    rdfs:label "implements interpretation"@en ;
    rdfs:domain pair:PatternImplementation ;
    rdfs:range pair:MotifInterpretation .

pair:implementsMotif a owl:ObjectProperty ;
    rdfs:label "implements motif"@en ;
    rdfs:domain pair:PatternImplementation ;
    rdfs:range pair:GraphMotif .

pair:interpretedAsMechanism a owl:ObjectProperty ;
    rdfs:label "interpreted as mechanism"@en ;
    rdfs:domain pair:MotifInterpretation ;
    rdfs:range pair:RiskMechanism .

pair:interpretsMotif a owl:ObjectProperty ;
    rdfs:label "interprets motif"@en ;
    rdfs:domain pair:MotifInterpretation ;
    rdfs:range pair:GraphMotif .

pair:matchedElement a owl:ObjectProperty ;
    rdfs:label "matched element"@en ;
    rdfs:domain pair:NodeBinding ;
    rdfs:range rdfs:Resource .

pair:matchesMotif a owl:ObjectProperty ;
    rdfs:label "matches motif"@en ;
    rdfs:domain pair:MotifMatch ;
    rdfs:range pair:GraphMotif .

pair:mayIndicateRisk a owl:ObjectProperty ;
    rdfs:label "may indicate risk"@en ;
    rdfs:domain pair:MotifInterpretation ;
    rdfs:range skos:Concept .

pair:operationalizesRiskCondition a owl:ObjectProperty ;
    rdfs:label "operationalizes risk condition"@en ;
    rdfs:domain pair:GraphCondition ;
    rdfs:range rdfs:Resource .

pair:patternPredicate a owl:ObjectProperty ;
    rdfs:label "pattern predicate"@en ;
    rdfs:domain pair:PatternEdge ;
    rdfs:range rdf:Property .

pair:playsRole a owl:ObjectProperty ;
    rdfs:label "plays role"@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range pair:PatternRole .

pair:producesOutputType a owl:ObjectProperty ;
    rdfs:label "produces output type"@en ;
    rdfs:domain pair:PatternImplementation ;
    rdfs:range rdfs:Class .

pair:sourcePatternNode a owl:ObjectProperty ;
    rdfs:label "source pattern node"@en ;
    rdfs:domain pair:PatternEdge ;
    rdfs:range pair:PatternNode .

pair:subDataCategoryOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "sub-data-category of"@en ;
    rdfs:domain pair:DataCategory ;
    rdfs:range pair:DataCategory .

pair:subRoleOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "sub-role of"@en ;
    rdfs:domain pair:PatternRole ;
    rdfs:range pair:PatternRole .

pair:suggestedControl a owl:ObjectProperty ;
    rdfs:label "suggested control"@en ;
    rdfs:domain pair:MotifInterpretation ;
    rdfs:range beamr:RiskControl .

pair:targetPatternNode a owl:ObjectProperty ;
    rdfs:label "target pattern node"@en ;
    rdfs:domain pair:PatternEdge ;
    rdfs:range pair:PatternNode .

pat:AsynchronousPredictionMotif a pair:GraphMotif ;
    rdfs:label "Asynchronous Prediction Motif"@en ;
    dct:description "Architectural motif in which prediction requests are decoupled from prediction execution through a queue, cache, or similar intermediary resource."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Asynchronous-pattern/design_en.html> ;
    pair:hasPatternEdge pat:AsyncPred_EnqueueProducesQueueEdge,
        pat:AsyncPred_EnqueueUsesRequestEdge,
        pat:AsyncPred_PredictionProducesResultEdge,
        pat:AsyncPred_PredictionUsesQueueEdge ;
    pair:hasPatternNode pat:AsyncPred_EnqueueStepNode,
        pat:AsyncPred_PredictionStepNode,
        pat:AsyncPred_QueueNode,
        pat:AsyncPred_RequestNode,
        pat:AsyncPred_ResultNode .

pat:BatchPredictionMotif a pair:GraphMotif ;
    rdfs:label "Batch Prediction Motif"@en ;
    dct:description "Architectural motif in which a scheduled job runs prediction over a batch dataset and stores batch prediction results."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Batch-pattern/design_en.html> ;
    pair:hasPatternEdge pat:BatchPred_JobProducesResultEdge,
        pat:BatchPred_JobUsesDatasetEdge,
        pat:BatchPred_JobUsesModelEdge,
        pat:BatchPred_SchedulerInformsJobEdge ;
    pair:hasPatternNode pat:BatchPred_DatasetNode,
        pat:BatchPred_JobNode,
        pat:BatchPred_ModelNode,
        pat:BatchPred_ResultNode,
        pat:BatchPred_SchedulerNode .

pat:BatchTrainingMotif a pair:GraphMotif ;
    rdfs:label "Batch Training Motif"@en ;
    dct:description "Architectural motif in which a scheduled training job prepares data, trains a model, evaluates it, and records the resulting model artifact and evaluation result."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Training-patterns/Batch-training-pattern/design_en.html> ;
    pair:hasPatternEdge pat:BatchTrain_EvaluationProducesResultEdge,
        pat:BatchTrain_EvaluationUsesModelEdge,
        pat:BatchTrain_PreprocessInformsTrainingEdge,
        pat:BatchTrain_PreprocessProducesTrainingDataEdge,
        pat:BatchTrain_PreprocessUsesDatasetEdge,
        pat:BatchTrain_SchedulerInformsPreprocessEdge,
        pat:BatchTrain_TrainingInformsEvaluationEdge,
        pat:BatchTrain_TrainingProducesModelEdge,
        pat:BatchTrain_TrainingUsesDataEdge ;
    pair:hasPatternNode pat:BatchTrain_DatasetNode,
        pat:BatchTrain_EvaluationResultNode,
        pat:BatchTrain_EvaluationStepNode,
        pat:BatchTrain_ModelArtifactNode,
        pat:BatchTrain_PreprocessStepNode,
        pat:BatchTrain_SchedulerNode,
        pat:BatchTrain_TrainingDataNode,
        pat:BatchTrain_TrainingStepNode .

pat:EvalDatasetRole a pair:PatternRole ;
    skos:prefLabel "Evaluation Dataset"@en .

pat:EvalsMotif a pair:GraphMotif ;
    rdfs:label "Evals Motif"@en ;
    dct:description "GenAI motif in which model input, generated output, expected output, and optional retrieval context are scored or judged to produce evaluation results for a task."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternEdge pat:Evals_ScorerProducesScoreEdge,
        pat:Evals_ScorerUsesContextEdge,
        pat:Evals_ScorerUsesExpectedOutputEdge,
        pat:Evals_ScorerUsesInputEdge,
        pat:Evals_ScorerUsesJudgeModelEdge,
        pat:Evals_ScorerUsesModelOutputEdge ;
    pair:hasPatternNode pat:Evals_ContextNode,
        pat:Evals_ExpectedOutputNode,
        pat:Evals_InputNode,
        pat:Evals_JudgeModelNode,
        pat:Evals_ModelOutputNode,
        pat:Evals_ScoreNode,
        pat:Evals_ScorerNode .

pat:FineTuningMotif a pair:GraphMotif ;
    rdfs:label "Fine Tuning Motif"@en ;
    dct:description "GenAI motif in which a pre-trained LLM is further trained with a task- or domain-specific dataset to produce a fine-tuned model."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasInterpretation pat:DataAndModelPoisoningInterpretation,
        pat:SupplyChainCompromiseInterpretation ;
    pair:hasPatternEdge pat:FineTune_EvaluationProducesScoreEdge,
        pat:FineTune_EvaluationUsesModelEdge,
        pat:FineTune_TrainingInformsEvaluationEdge,
        pat:FineTune_TrainingProducesModelEdge,
        pat:FineTune_TrainingUsesBaseModelEdge,
        pat:FineTune_TrainingUsesDatasetEdge ;
    pair:hasPatternNode pat:FineTune_BaseModelNode,
        pat:FineTune_DatasetNode,
        pat:FineTune_EvaluationScoreNode,
        pat:FineTune_EvaluationStepNode,
        pat:FineTune_FineTunedModelNode,
        pat:FineTune_TrainingStepNode .

pat:GuardrailsMotif a pair:GraphMotif ;
    rdfs:label "Guardrails Motif"@en ;
    dct:description "GenAI motif in which input and output guardrail steps screen or sanitize user prompts and generated responses around the primary LLM generation step."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasInterpretation pat:ImproperOutputHandlingInterpretation,
        pat:SystemPromptLeakageInterpretation ;
    pair:hasPatternEdge pat:Guardrails_GenerationInformsOutputGuardrailEdge,
        pat:Guardrails_GenerationProducesRawResponseEdge,
        pat:Guardrails_GenerationUsesLLMEdge,
        pat:Guardrails_GenerationUsesPromptEdge,
        pat:Guardrails_InputGuardrailInformsGenerationEdge,
        pat:Guardrails_InputGuardrailProducesDecisionEdge,
        pat:Guardrails_InputGuardrailUsesPromptEdge,
        pat:Guardrails_OutputGuardrailProducesSanitizedResponseEdge,
        pat:Guardrails_OutputGuardrailUsesRawResponseEdge ;
    pair:hasPatternNode pat:Guardrails_GenerationStepNode,
        pat:Guardrails_InputDecisionNode,
        pat:Guardrails_InputGuardrailStepNode,
        pat:Guardrails_LLMNode,
        pat:Guardrails_OutputGuardrailStepNode,
        pat:Guardrails_RawResponseNode,
        pat:Guardrails_SanitizedResponseNode,
        pat:Guardrails_UserPromptNode .

pat:HybridRetrieverMotif a pair:GraphMotif ;
    rdfs:label "Hybrid Retriever Motif"@en ;
    dct:description "GenAI motif in which vector search and keyword or structured search are combined and aggregated to produce a candidate context set."@en ;
    dct:source <https://martinfowler.com/articles/gen-ai-patterns/> ;
    pair:hasPatternEdge pat:Hybrid_AggregationProducesCandidateSetEdge,
        pat:Hybrid_KeywordSearchInformsAggregationEdge,
        pat:Hybrid_KeywordSearchUsesIndexEdge,
        pat:Hybrid_KeywordSearchUsesQueryEdge,
        pat:Hybrid_VectorSearchInformsAggregationEdge,
        pat:Hybrid_VectorSearchUsesIndexEdge,
        pat:Hybrid_VectorSearchUsesQueryEdge ;
    pair:hasPatternNode pat:Hybrid_AggregationNode,
        pat:Hybrid_CandidateSetNode,
        pat:Hybrid_KeywordIndexNode,
        pat:Hybrid_KeywordSearchNode,
        pat:Hybrid_QueryNode,
        pat:Hybrid_VectorIndexNode,
        pat:Hybrid_VectorSearchNode .

pat:ModelInImageMotif a pair:GraphMotif ;
    rdfs:label "Model-in-Image Motif"@en ;
    dct:description "Operational motif in which a trained model artifact is packaged into a serving image that is deployed as the prediction service runtime."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Model-in-image-pattern/design_en.html> ;
    pair:hasInterpretation pat:SupplyChainCompromiseInterpretation ;
    pair:hasPatternEdge pat:ModelImage_DeploymentInformsPredictionEdge,
        pat:ModelImage_DeploymentUsesImageEdge,
        pat:ModelImage_ImageBuildProducesImageEdge,
        pat:ModelImage_ImageBuildUsesModelEdge,
        pat:ModelImage_TrainingInformsImageBuildEdge,
        pat:ModelImage_TrainingProducesModelEdge ;
    pair:hasPatternNode pat:ModelImage_DeploymentStepNode,
        pat:ModelImage_ImageBuildStepNode,
        pat:ModelImage_ModelArtifactNode,
        pat:ModelImage_PredictionStepNode,
        pat:ModelImage_ServingImageNode,
        pat:ModelImage_TrainingStepNode .

pat:ModelLoadMotif a pair:GraphMotif ;
    rdfs:label "Model Load Motif"@en ;
    dct:description "Operational motif in which a prediction server image and model artifact are managed separately, and the model is loaded by the server before prediction."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Model-load-pattern/design_en.html> ;
    pair:hasInterpretation pat:SupplyChainCompromiseInterpretation ;
    pair:hasPatternEdge pat:ModelLoad_LoadInformsPredictionEdge,
        pat:ModelLoad_LoadProducesLoadedModelEdge,
        pat:ModelLoad_LoadUsesImageEdge,
        pat:ModelLoad_LoadUsesModelArtifactEdge,
        pat:ModelLoad_PredictionUsesLoadedModelEdge ;
    pair:hasPatternNode pat:ModelLoad_LoadStepNode,
        pat:ModelLoad_LoadedModelNode,
        pat:ModelLoad_ModelArtifactNode,
        pat:ModelLoad_PredictionStepNode,
        pat:ModelLoad_ServerImageNode .

pat:ModelRegistryRole a pair:PatternRole ;
    skos:prefLabel "Model Registry"@en .

pat:MultiStagePredictionMotif a pair:GraphMotif ;
    rdfs:label "Multi-stage Prediction Motif"@en ;
    dct:description "Architectural motif in which one prediction path returns a quick result while another prediction path produces a slower or richer result."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Multiple-stage-prediction-pattern/design_en.html> ;
    pair:hasPatternEdge pat:MultiStage_FastInformsSlowEdge,
        pat:MultiStage_FastProducesResultEdge,
        pat:MultiStage_FastUsesModelEdge,
        pat:MultiStage_FastUsesRequestEdge,
        pat:MultiStage_SlowProducesResultEdge,
        pat:MultiStage_SlowUsesModelEdge,
        pat:MultiStage_SlowUsesRequestEdge ;
    pair:hasPatternNode pat:MultiStage_FastModelNode,
        pat:MultiStage_FastPredictionStepNode,
        pat:MultiStage_ImprovedResultNode,
        pat:MultiStage_QuickResultNode,
        pat:MultiStage_RequestNode,
        pat:MultiStage_SlowModelNode,
        pat:MultiStage_SlowPredictionStepNode .

pat:PipelineTrainingMotif a pair:GraphMotif ;
    rdfs:label "Pipeline Training Motif"@en ;
    dct:description "Architectural motif in which training is decomposed into independently executable pipeline jobs connected by intermediate data and workflow dependencies."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Training-patterns/Pipeline-training-pattern/design_en.html> ;
    pair:hasPatternEdge pat:PipeTrain_EvaluationProducesResultEdge,
        pat:PipeTrain_EvaluationUsesModelEdge,
        pat:PipeTrain_PreprocessInformsTrainingEdge,
        pat:PipeTrain_PreprocessProducesIntermediateEdge,
        pat:PipeTrain_PreprocessUsesSourceEdge,
        pat:PipeTrain_TrainingInformsEvaluationEdge,
        pat:PipeTrain_TrainingProducesModelEdge,
        pat:PipeTrain_TrainingUsesIntermediateEdge ;
    pair:hasPatternNode pat:PipeTrain_EvaluationJobNode,
        pat:PipeTrain_EvaluationResultNode,
        pat:PipeTrain_IntermediateDataNode,
        pat:PipeTrain_ModelArtifactNode,
        pat:PipeTrain_PreprocessJobNode,
        pat:PipeTrain_SourceDataNode,
        pat:PipeTrain_TrainingJobNode .

pat:PredictionLoggingMotif a pair:GraphMotif ;
    rdfs:label "Prediction Logging Motif"@en ;
    dct:description "Operational motif in which prediction inputs, results, latency, or related events are collected into prediction logs for analysis and service improvement."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Prediction-log-pattern/design_en.html> ;
    pair:hasPatternEdge pat:PredLog_LoggingProducesLogEdge,
        pat:PredLog_LoggingUsesRequestEdge,
        pat:PredLog_LoggingUsesResultEdge,
        pat:PredLog_PredictionInformsLoggingEdge,
        pat:PredLog_PredictionProducesResultEdge,
        pat:PredLog_PredictionUsesRequestEdge ;
    pair:hasPatternNode pat:PredLog_LogRecordNode,
        pat:PredLog_LoggingStepNode,
        pat:PredLog_PredictionStepNode,
        pat:PredLog_RequestNode,
        pat:PredLog_ResultNode .

pat:PredictionMonitoringMotif a pair:GraphMotif ;
    rdfs:label "Prediction Monitoring Motif"@en ;
    dct:description "Operational motif in which prediction logs or prediction result trends are monitored against expected behavior and may produce alerts."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Operation-patterns/Prediction-monitoring-pattern/design_en.html> ;
    pair:hasPatternEdge pat:PredMon_MonitoringProducesAlertEdge,
        pat:PredMon_MonitoringUsesBaselineEdge,
        pat:PredMon_MonitoringUsesLogEdge ;
    pair:hasPatternNode pat:PredMon_AlertNode,
        pat:PredMon_BaselineNode,
        pat:PredMon_LogNode,
        pat:PredMon_MonitoringStepNode .

pat:PreprocessPredictionMotif a pair:GraphMotif ;
    rdfs:label "Prep-Pred / Preprocess-Prediction Motif"@en ;
    dct:description "Architectural motif in which preprocessing and prediction are represented as separate steps connected by preprocessed data."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Prep-pred-pattern/design_en.html> ;
    pair:hasPatternEdge pat:PrepPred_PredictionProducesResultEdge,
        pat:PrepPred_PredictionUsesDataEdge,
        pat:PrepPred_PredictionUsesModelEdge,
        pat:PrepPred_PreprocessInformsPredictionEdge,
        pat:PrepPred_PreprocessProducesDataEdge,
        pat:PrepPred_PreprocessUsesInputEdge ;
    pair:hasPatternNode pat:PrepPred_InputNode,
        pat:PrepPred_ModelNode,
        pat:PrepPred_PredictionStepNode,
        pat:PrepPred_PreprocessStepNode,
        pat:PrepPred_PreprocessedDataNode,
        pat:PrepPred_ResultNode .

pat:SynchronousPredictionMotif a pair:GraphMotif ;
    rdfs:label "Synchronous Prediction Motif"@en ;
    dct:description "Architectural motif in which a prediction step runs inline with a request workflow and produces a result before the workflow proceeds."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Serving-patterns/Synchronous-pattern/design_en.html> ;
    pair:hasPatternEdge pat:SyncPred_PredictionInformsDownstreamEdge,
        pat:SyncPred_PredictionProducesResultEdge,
        pat:SyncPred_PredictionUsesModelEdge,
        pat:SyncPred_PredictionUsesRequestEdge ;
    pair:hasPatternNode pat:SyncPred_DownstreamStepNode,
        pat:SyncPred_ModelNode,
        pat:SyncPred_PredictionStepNode,
        pat:SyncPred_RequestNode,
        pat:SyncPred_ResultNode .

pat:TrainThenServeMotif a pair:GraphMotif ;
    rdfs:label "Train-Then-Serve Motif"@en ;
    dct:description "Lifecycle motif in which training and serving are separated by evaluation, approval, and a release step before the model is used for production prediction."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Lifecycle-patterns/Train-then-serve-pattern/design_en.html> ;
    pair:hasPatternEdge pat:TrainServe_EvaluationProducesApprovalEdge,
        pat:TrainServe_EvaluationUsesCandidateEdge,
        pat:TrainServe_PredictionUsesModelEdge,
        pat:TrainServe_ReleaseInformsPredictionEdge,
        pat:TrainServe_ReleaseProducesDeployedModelEdge,
        pat:TrainServe_ReleaseUsesApprovalEdge,
        pat:TrainServe_ReleaseUsesCandidateEdge,
        pat:TrainServe_TrainingInformsEvaluationEdge,
        pat:TrainServe_TrainingProducesCandidateEdge ;
    pair:hasPatternNode pat:TrainServe_ApprovalNode,
        pat:TrainServe_CandidateModelNode,
        pat:TrainServe_DeployedModelNode,
        pat:TrainServe_EvaluationStepNode,
        pat:TrainServe_PredictionStepNode,
        pat:TrainServe_ReleaseStepNode,
        pat:TrainServe_TrainingStepNode .

pat:TrainingToServingMotif a pair:GraphMotif ;
    rdfs:label "Training-to-Serving Motif"@en ;
    dct:description "Lifecycle motif in which a training pipeline automatically produces a model artifact that is built or deployed into a serving prediction path."@en ;
    dct:source <https://mercari.github.io/ml-system-design-pattern/Lifecycle-patterns/Training-to-serving-pattern/design_en.html> ;
    pair:hasInterpretation pat:DataAndModelPoisoningInterpretation,
        pat:SupplyChainCompromiseInterpretation ;
    pair:hasPatternEdge pat:TrainToServe_DeploymentInformsPredictionEdge,
        pat:TrainToServe_DeploymentProducesDeployedModelEdge,
        pat:TrainToServe_DeploymentUsesModelEdge,
        pat:TrainToServe_PredictionUsesModelEdge,
        pat:TrainToServe_TrainingInformsDeploymentEdge,
        pat:TrainToServe_TrainingProducesModelEdge ;
    pair:hasPatternNode pat:TrainToServe_AutoDeploymentNode,
        pat:TrainToServe_DeployedModelNode,
        pat:TrainToServe_ModelArtifactNode,
        pat:TrainToServe_PredictionStepNode,
        pat:TrainToServe_TrainingPipelineNode .

<http://w3id.org/airiskkg/patterns/risk-pattern-library#> a owl:Ontology ;
    dct:description """
    Curated PAIR-AI risk pattern library for LLM-based applications. OWASP
    LLM Top 10 entries are used as the primary risk anchors, while MIT AI Risk
    Repository, IBM AI Risk Atlas, and MIT AI Risk Control entries provide
    broader taxonomy and control grounding through the Nexus model.
    """@en ;
    dct:source <https://genai.owasp.org/resource/owasp-top-10-for-llm-applications-2025/>,
        <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/knowledge_graph/mit_ai_risk_mitigation_data.yaml>,
        <https://github.com/IBM/ai-atlas-nexus/blob/main/src/ai_atlas_nexus/data/knowledge_graph/mit_ai_risk_repository_data.yaml>,
        <https://github.com/IBM/ai-atlas-nexus/tree/main/src/ai_atlas_nexus/data/knowledge_graph>,
        <https://owasp.org/www-project-top-10-for-large-language-model-applications/assets/PDF/OWASP-Top-10-for-LLMs-v2025.pdf> ;
    dct:title "OWASP-Aligned LLM Risk Pattern Library"@en ;
    owl:imports pair:,
        <http://w3id.org/airiskkg/patterns/motif-library#>,
        atlas:,
        <http://w3id.org/airiskkg/taxonomy/mappings#>,
        mit:,
        mitctrl:,
        nexus:,
        owasp:,
        beam:,
        beamr: .

atlas:decision-bias a nexus:Risk ;
    nexus:descriptor "traditional risk of AI" ;
    nexus:hasRelatedControl mitctrl:data-curation-process,
        mitctrl:data-governance,
        mitctrl:societal-impact-assessment,
        mitctrl:testing-auditing ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:fairness ;
    nexus:riskType "output" ;
    nexus:tag "decision-bias" ;
    skos:broader atlas:fairness ;
    skos:closeMatch mit:subdomain-1-1 ;
    skos:definition "Model decisions may systematically advantage one group over another." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Decision bias" ;
    skos:relatedMatch mit:subdomain-1-3 .

atlas:reidentification a nexus:Risk ;
    nexus:descriptor "amplified by synthetic data",
        "traditional risk of AI" ;
    nexus:hasRelatedControl mitctrl:data-governance,
        mitctrl:privacy-control-for-user-data ;
    nexus:isDefinedByTaxonomy atlas:IBM_AI_Risk_Atlas ;
    nexus:isPartOf atlas:privacy ;
    nexus:riskType "training-data" ;
    nexus:tag "reidentification" ;
    skos:broadMatch mit:subdomain-2-1 ;
    skos:broader atlas:privacy ;
    skos:definition "Individuals may be identified from data that was intended to be anonymized or de-identified." ;
    skos:inScheme atlas:IBM_AI_Risk_Atlas ;
    skos:prefLabel "Reidentification" .

mitctrl:safety-decision-frameworks a nexus:RiskControlGroup ;
    nexus:controlType "governance" ;
    nexus:isDefinedByTaxonomy mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    nexus:lifecyclePhase "deployment" ;
    skos:broader mitctrl:governance-oversight-controls ;
    skos:definition """\r
    Protocols and commitments that constrain decision-making about model development,\r
    deployment, and capability scaling.\r
    """ ;
    skos:inScheme mitctrl:MIT_Draft_AI_Risk_Mitigation_Taxonomy ;
    skos:prefLabel "Safety Decision Frameworks" .

nexus:concern a owl:DatatypeProperty ;
    rdfs:label "concern" ;
    rdfs:comment "Short explanation of the concern represented by the risk entry." ;
    rdfs:domain nexus:RiskTaxonomyEntry ;
    rdfs:range xsd:string .

nexus:conditionForRisk a owl:ObjectProperty ;
    rdfs:label "condition for risk" ;
    rdfs:comment "Reverse link from a risk condition to the taxonomy entry it supports." ;
    rdfs:domain nexus:RiskCondition ;
    rdfs:range nexus:RiskTaxonomyEntry .

nexus:controlType a owl:DatatypeProperty ;
    rdfs:label "control type" ;
    rdfs:comment """\r
    Indicates whether the control is preventive, detective, corrective, governance,\r
    technical, operational, or transparency-oriented.\r
    """ ;
    rdfs:domain beamr:RiskControl ;
    rdfs:range xsd:string .

nexus:descriptor a owl:DatatypeProperty ;
    rdfs:label "descriptor" ;
    rdfs:comment """\r
    Descriptor used by a source taxonomy, for example traditional AI risk,\r
    specific to generative AI, amplified by generative AI, or specific to agentic AI.\r
    """ ;
    rdfs:domain nexus:RiskTaxonomyEntry ;
    rdfs:range xsd:string .

nexus:hasRelatedControl a owl:ObjectProperty ;
    rdfs:label "has related control" ;
    rdfs:comment "Links a risk taxonomy entry to a related control or mitigation concept." ;
    rdfs:domain nexus:RiskTaxonomyEntry ;
    rdfs:range beamr:RiskControl .

nexus:hasRelatedRisk a owl:ObjectProperty ;
    rdfs:label "has related risk" ;
    rdfs:comment "Links a control, action, or concept to a related risk taxonomy entry." ;
    rdfs:domain skos:Concept ;
    rdfs:range nexus:RiskTaxonomyEntry .

nexus:hasRiskCondition a owl:ObjectProperty ;
    rdfs:label "has risk condition" ;
    rdfs:comment "Links a risk taxonomy entry to a condition that can make the risk applicable." ;
    rdfs:domain nexus:RiskTaxonomyEntry ;
    rdfs:range nexus:RiskCondition .

nexus:hasRiskMechanism a owl:ObjectProperty ;
    rdfs:label "has risk mechanism" ;
    rdfs:comment """\r
    Links a risk taxonomy entry to a mechanism explaining how the risk can\r
    arise. The mechanism may be represented using the risk-pattern ontology.\r
    """ ;
    rdfs:domain nexus:RiskTaxonomyEntry ;
    rdfs:range rdfs:Resource .

nexus:isDefinedByTaxonomy a owl:ObjectProperty ;
    rdfs:label "is defined by taxonomy" ;
    rdfs:comment "Links a risk, risk group, control, or control group to the taxonomy that defines it." ;
    rdfs:domain skos:Concept ;
    rdfs:range nexus:Taxonomy .

nexus:isPartOf a owl:ObjectProperty ;
    rdfs:label "is part of" ;
    rdfs:comment "Links a taxonomy entry to the group it belongs to." ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept .

nexus:lifecyclePhase a owl:DatatypeProperty ;
    rdfs:label "lifecycle phase" ;
    rdfs:comment """\r
    Lifecycle phase where the control is mainly relevant, such as design-time,\r
    development, deployment, operation, monitoring, or post-deployment.\r
    """ ;
    rdfs:domain beamr:RiskControl ;
    rdfs:range xsd:string .

nexus:mechanismForRisk a owl:ObjectProperty ;
    rdfs:label "mechanism for risk" ;
    rdfs:comment "Reverse link from a risk mechanism to the taxonomy entry it explains." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range nexus:RiskTaxonomyEntry .

nexus:mitigatesRiskTaxonomyEntry a owl:ObjectProperty ;
    rdfs:label "mitigates risk taxonomy entry" ;
    rdfs:comment """\r
    Links a risk control or control group to a risk taxonomy entry that it may mitigate.\r
    This relation is used for general control-to-risk grounding, not as proof that\r
    a specific system has implemented the control.\r
    """ ;
    rdfs:domain beamr:RiskControl ;
    rdfs:range nexus:RiskTaxonomyEntry .

nexus:phase a owl:DatatypeProperty ;
    rdfs:label "phase" ;
    rdfs:comment "Lifecycle or development phase associated with a risk entry, if provided by the source taxonomy." ;
    rdfs:domain nexus:RiskTaxonomyEntry ;
    rdfs:range xsd:string .

nexus:riskType a owl:DatatypeProperty ;
    rdfs:label "risk type" ;
    rdfs:comment """\r
    Indicates where the risk mainly arises, for example input, training-data,\r
    inference, output, agentic, or non-technical.\r
    """ ;
    rdfs:domain nexus:RiskTaxonomyEntry ;
    rdfs:range xsd:string .

nexus:tag a owl:DatatypeProperty ;
    rdfs:label "tag" ;
    rdfs:comment "A compact machine-readable tag for a taxonomy entry." ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:string .

beam:Engineer a owl:Class ;
    rdfs:label "Engineer" ;
    rdfs:subClassOf beam:Generate .

beam:SemanticModel a owl:Class ;
    rdfs:label "Semantic Model" ;
    rdfs:subClassOf beam:Model .

beam:Symbol a owl:Class ;
    rdfs:label "Symbol" ;
    rdfs:subClassOf beam:Instance .

beam:contain a owl:TransitiveProperty ;
    rdfs:label "contain" ;
    rdfs:domain beam:Element ;
    rdfs:range beam:Element .

beam:context a owl:DatatypeProperty ;
    rdfs:label "context" ;
    rdfs:domain beam:System ;
    rdfs:range xsd:String .

beam:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:domain beam:System ;
    rdfs:range xsd:String .

beam:hasAgent a owl:ObjectProperty ;
    rdfs:label "has agent" ;
    rdfs:domain beam:System ;
    rdfs:range beam:Agent .

beam:hasProcess a owl:ObjectProperty ;
    rdfs:label "has process" ;
    rdfs:domain beam:System ;
    rdfs:range beam:Process .

beam:hasResource a owl:ObjectProperty ;
    rdfs:label "has resource" ;
    rdfs:domain beam:System ;
    rdfs:range beam:Resource .

beam:note a owl:ObjectProperty ;
    rdfs:label "note" ;
    rdfs:domain beam:Element ;
    rdfs:range beam:Note .

beam:participatedIn a owl:ObjectProperty ;
    rdfs:label "participated in" ;
    rdfs:domain beam:Agent ;
    rdfs:range beam:Process .

beam:performedBy a owl:ObjectProperty ;
    rdfs:label "performed by" ;
    rdfs:domain beam:Task ;
    rdfs:range beam:Element ;
    owl:inverseOf beam:perform .

beam:producedBy a owl:ObjectProperty ;
    rdfs:label "produced by" ;
    rdfs:domain beam:Resource ;
    rdfs:range beam:Process ;
    owl:inverseOf beam:produce .

beamr:associatedTo a owl:ObjectProperty ;
    rdfs:label "associated to" ;
    rdfs:domain beamr:RiskControl ;
    rdfs:range beam:Element .

beamr:hasConsequence a owl:ObjectProperty ;
    rdfs:label "has consequence" ;
    rdfs:domain beamr:Risk ;
    rdfs:range beamr:Consequence ;
    rdfs:subPropertyOf <https://w3id.org/airohasConsequence> .

beamr:hasImpact a owl:ObjectProperty ;
    rdfs:label "has impact" ;
    rdfs:domain beamr:Consequence ;
    rdfs:range beamr:Impact ;
    rdfs:subPropertyOf <https://w3id.org/airohasImpact> .

beamr:hasRisk a owl:ObjectProperty ;
    rdfs:label "has risk" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( beam:Element beam:Task ) ] ;
    rdfs:range beamr:Risk .

beamr:isRiskSourceFor a owl:ObjectProperty ;
    rdfs:label "is risk source for" ;
    rdfs:domain beamr:RiskSource ;
    rdfs:range beamr:Risk ;
    rdfs:subPropertyOf <https://w3id.org/airoisRiskSourceFor> .

beamr:modifiesRiskConcept a owl:ObjectProperty ;
    rdfs:label "modifies risk concept" ;
    rdfs:domain beamr:RiskControl ;
    rdfs:range beamr:RiskConcept ;
    rdfs:subPropertyOf <https://w3id.org/airomodifiesRiskConcept> .

beamr:originatedFrom a owl:ObjectProperty ;
    rdfs:label "originated from" ;
    rdfs:domain beamr:RiskSource ;
    rdfs:range beam:Element .

<http://w3id.org/airiskkg/example/verba-goldenverba#ProviderCredential> a pair:DataCategory ;
    rdfs:label "Provider credential"@en ;
    pair:subDataCategoryOf pair:ConfidentialInformation .

<http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/chunking-step> a pair:NodeBinding ;
    pair:bindsPatternNode pat:Embedding_ChunkingStepNode ;
    pair:matchedElement <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkDocument> .

<http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/document-chunk> a pair:NodeBinding ;
    pair:bindsPatternNode pat:Embedding_DocumentChunkNode ;
    pair:matchedElement <http://w3id.org/airiskkg/example/verba-goldenverba#DocumentChunks> .

<http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/embedding-step> a pair:NodeBinding ;
    pair:bindsPatternNode pat:Embedding_GenerationStepNode ;
    pair:matchedElement <http://w3id.org/airiskkg/example/verba-goldenverba#EmbedChunks> .

<http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/embedding-vector> a pair:NodeBinding ;
    pair:bindsPatternNode pat:Embedding_VectorNode ;
    pair:matchedElement <http://w3id.org/airiskkg/example/verba-goldenverba#ChunkEmbeddings> .

<http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/source-document> a pair:NodeBinding ;
    pair:bindsPatternNode pat:Embedding_SourceDocumentNode ;
    pair:matchedElement <http://w3id.org/airiskkg/example/verba-goldenverba#ParsedDocument> .

<http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23EmbedChunks/embeddings/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23ParsedDocument/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23WeaviateVectorStore/binding/vector-index> a pair:NodeBinding ;
    pair:bindsPatternNode pat:Embedding_VectorIndexNode ;
    pair:matchedElement <http://w3id.org/airiskkg/example/verba-goldenverba#WeaviateVectorStore> .

<http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/answer> a pair:NodeBinding ;
    pair:bindsPatternNode pat:RAG_ResponseNode ;
    pair:matchedElement <http://w3id.org/airiskkg/example/verba-goldenverba#Answer> .

<http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/generation-step> a pair:NodeBinding ;
    pair:bindsPatternNode pat:RAG_GenerationStepNode ;
    pair:matchedElement <http://w3id.org/airiskkg/example/verba-goldenverba#GenerateAnswer> .

<http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/llm> a pair:NodeBinding ;
    pair:bindsPatternNode pat:RAG_LLMNode ;
    pair:matchedElement <http://w3id.org/airiskkg/example/verba-goldenverba#GeneratorModel> .

<http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/prompt> a pair:NodeBinding ;
    pair:bindsPatternNode pat:RAG_PromptNode ;
    pair:matchedElement <http://w3id.org/airiskkg/example/verba-goldenverba#RAGPrompt> .

<http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/prompt-construction-step> a pair:NodeBinding ;
    pair:bindsPatternNode pat:RAG_PromptConstructionStepNode ;
    pair:matchedElement <http://w3id.org/airiskkg/example/verba-goldenverba#BuildRAGPrompt> .

<http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23GenerateAnswer/rag/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Fverba-goldenverba%23Answer/binding/prompt-template> a pair:NodeBinding ;
    pair:bindsPatternNode pat:RAG_PromptTemplateNode ;
    pair:matchedElement <http://w3id.org/airiskkg/example/verba-goldenverba#RAGPrompt> .

