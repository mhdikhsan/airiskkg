<http://w3id.org/airiskkg/generated/risk-finding/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fgenerated%2Fmotif-match%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Frealworld-langchain-rag%2523RetrieveContext%2Fvector-ir%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Frealworld-langchain-rag%2523PublicQuestion%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Frealworld-langchain-rag%2523RetrievedContext/prompt-injection> a pair:RiskFinding ;
    rdfs:label "Candidate prompt injection exposure"@en ;
    dct:description "Untrusted user or retrieved content can enter LLM prompt or generation context."@en ;
    pair:findingStatus "candidate" ;
    pair:generatedByMotif pat:VectorBasedInformationRetrievalMotif ;
    pair:generatedFromMatch <http://w3id.org/airiskkg/generated/motif-match/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Frealworld-langchain-rag%23RetrieveContext/vector-ir/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Frealworld-langchain-rag%23PublicQuestion/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fexample%2Frealworld-langchain-rag%23RetrievedContext> ;
    pair:hasCandidateRiskTaxonomyEntry atlas:prompt-injection,
        mit:subdomain-2-2,
        mit:subdomain-4-3,
        owasp:llm01-prompt-injection ;
    pair:hasEvidenceElement <http://w3id.org/airiskkg/example/realworld-langchain-rag#Answer>,
        <http://w3id.org/airiskkg/example/realworld-langchain-rag#GenerateAnswer>,
