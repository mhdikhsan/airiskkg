        <http://w3id.org/airiskkg/example/realworld-langchain-rag#PublicQuestion> ;
    pair:hasInterpretedMechanism owasp:mechanism-instruction-override ;
    pair:hasSatisfiedCondition pat:PromptInjection_UntrustedPromptContextCondition,
        owasp:condition-retrieved-content-enters-generation-context,
        owasp:condition-untrusted-input-enters-prompt-context ;
    pair:hasSuggestedControl pat:Control_Guardrails,
        pat:Control_InputValidationAndPromptIsolation,
        pat:Control_LoggingMonitoringAndEvals,
        mitctrl:input-output-filtering,
        mitctrl:red-teaming,
        mitctrl:retrieval-source-filtering,
        mitctrl:threat-modelling .

<http://w3id.org/airiskkg/generated/risk-finding/http%3A%2F%2Fw3id.org%2Fairiskkg%2Fgenerated%2Fmotif-match%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Frealworld-langchain-rag%2523RetrieveContext%2Fvector-ir%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Frealworld-langchain-rag%2523PublicQuestion%2Fhttp%253A%252F%252Fw3id.org%252Fairiskkg%252Fexample%252Frealworld-langchain-rag%2523RetrievedContext/vector-embedding-weakness> a pair:RiskFinding ;
    rdfs:label "Candidate vector and embedding weakness"@en ;
