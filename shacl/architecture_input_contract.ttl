@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix beam: <http://w3id.org/beam/core#> .
@prefix pair: <http://w3id.org/airiskkg/pair-ai#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix aic:  <http://w3id.org/airiskkg/shacl/architecture-input-contract#> .

<http://w3id.org/airiskkg/shacl/architecture-input-contract>
    a owl:Ontology ;
    dct:title "PAIR-AI Architecture Graph Input Contract"@en .

aic:GraphHasSystemShape
    a sh:NodeShape ;
    sh:targetNode aic:ArchitectureGraphContract ;
    sh:severity sh:Violation ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Architecture graph must contain at least one beam:System." ;
        sh:prefixes <http://w3id.org/airiskkg/shacl/architecture-input-contract> ;
        sh:select """
            PREFIX beam: <http://w3id.org/beam/core#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS { ?system a beam:System . }
            }
        """ ;
    ] .

# 2. Every beam:Process must have at least one beam:use or beam:produce.

aic:ProcessFlowShape
    a sh:NodeShape ;
    sh:targetClass beam:Process ;
    sh:severity sh:Violation ;
    sh:message "Every beam:Process must use or produce at least one resource (beam:use or beam:produce)." ;
    sh:or (
        [ sh:path beam:use ;     sh:minCount 1 ]
        [ sh:path beam:produce ; sh:minCount 1 ]
    ) .


aic:ResourceLeafTypeShape
    a sh:NodeShape ;
    sh:targetClass beam:Resource ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Resource should be typed to a leaf class (a subtype of beam:Data, beam:Symbol, or beam:Model), not only to a top-level resource class." ;
        sh:prefixes <http://w3id.org/airiskkg/shacl/architecture-input-contract> ;
        sh:select """
            PREFIX beam: <http://w3id.org/beam/core#>
            PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this rdf:type ?leaf .
                    ?leaf rdfs:subClassOf+ ?top .
                    FILTER(?top IN (beam:Data, beam:Symbol, beam:Model))
                }
            }
        """ ;
    ] .
aic:ProcessRoleShape
    a sh:NodeShape ;
    sh:targetClass beam:Process ;
    sh:severity sh:Warning ;
    sh:property [
        sh:path pair:playsRole ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Process has no pair:playsRole; motifs match on roles, so this element cannot participate in motif matching." ;
    ] .

aic:ResourceRoleShape
    a sh:NodeShape ;
    sh:targetClass beam:Resource ;
    sh:severity sh:Warning ;
    sh:property [
        sh:path pair:playsRole ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Resource has no pair:playsRole; motifs match on roles, so this element cannot participate in motif matching." ;
    ] .

# Flow edges join a process to a resource, never two of a kind. BEAM declares a
# domain and range for each, but no reasoner runs, so a data-to-data edge parses
# cleanly and only a shape rejects it.

aic:UseSubjectShape
    a sh:NodeShape ;
    sh:targetSubjectsOf beam:use ;
    sh:severity sh:Violation ;
    sh:class beam:Process ;
    sh:message "Only a beam:Process may beam:use something. Two resources never connect directly; flow between them passes through a process." .

aic:UseObjectShape
    a sh:NodeShape ;
    sh:targetObjectsOf beam:use ;
    sh:severity sh:Violation ;
    sh:class beam:Resource ;
    sh:message "beam:use must point at a beam:Resource. An agent is reached with beam:participatedIn." .

aic:ProduceSubjectShape
    a sh:NodeShape ;
    sh:targetSubjectsOf beam:produce ;
    sh:severity sh:Violation ;
    sh:class beam:Process ;
    sh:message "Only a beam:Process may beam:produce something. A resource does not produce another resource." .

aic:ProduceObjectShape
    a sh:NodeShape ;
    sh:targetObjectsOf beam:produce ;
    sh:severity sh:Violation ;
    sh:class beam:Resource ;
    sh:message "beam:produce must point at a beam:Resource." .

aic:NoProcessToProcessEdgeShape
    a sh:NodeShape ;
    sh:targetSubjectsOf beam:inform ;
    sh:severity sh:Violation ;
    sh:message "A process never reaches a process directly, exactly as data never reaches data: the two are joined by the resource one produces and the other uses. beam:inform is no longer part of BEAM." ;
    sh:not [ sh:path beam:inform ; sh:minCount 1 ] .

aic:UsedBySubjectShape
    a sh:NodeShape ;
    sh:targetSubjectsOf beam:usedBy ;
    sh:severity sh:Violation ;
    sh:class beam:Resource ;
    sh:message "beam:usedBy reads from a beam:Resource. A process declares its own inputs with beam:use." .

aic:UsedByObjectShape
    a sh:NodeShape ;
    sh:targetObjectsOf beam:usedBy ;
    sh:severity sh:Violation ;
    sh:class beam:Process ;
    sh:message "beam:usedBy must point at a beam:Process." .

aic:ProducedBySubjectShape
    a sh:NodeShape ;
    sh:targetSubjectsOf beam:producedBy ;
    sh:severity sh:Violation ;
    sh:class beam:Resource ;
    sh:message "beam:producedBy reads from a beam:Resource." .

aic:ProducedByObjectShape
    a sh:NodeShape ;
    sh:targetObjectsOf beam:producedBy ;
    sh:severity sh:Violation ;
    sh:class beam:Process ;
    sh:message "beam:producedBy must point at a beam:Process." .

aic:ParticipatedInSubjectShape
    a sh:NodeShape ;
    sh:targetSubjectsOf beam:participatedIn ;
    sh:severity sh:Violation ;
    sh:class beam:Agent ;
    sh:message "Only a beam:Agent may beam:participatedIn a process." .

aic:ParticipatedInObjectShape
    a sh:NodeShape ;
    sh:targetObjectsOf beam:participatedIn ;
    sh:severity sh:Violation ;
    sh:class beam:Process ;
    sh:message "beam:participatedIn must point at a beam:Process." .

# An agent and a system are siblings of beam:Resource, not kinds of it, so
# neither can stand at the resource end of a flow edge.

aic:ElementIsOneKindShape
    a sh:NodeShape ;
    sh:targetClass beam:Element ;
    sh:severity sh:Violation ;
    sh:not [ sh:and ( [ sh:class beam:Process ] [ sh:class beam:Resource ] ) ] ;
    sh:message "An element is a process or a resource, not both: the two carry different edges." .

# Shared prefix declarations for the SPARQL constraints above.

<http://w3id.org/airiskkg/shacl/architecture-input-contract>
    sh:declare [ sh:prefix "beam" ; sh:namespace "http://w3id.org/beam/core#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "rdf"  ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] .
